#define TEST(ThingToTest, ExpectedResult, OptionalFailMessage) try{assert(ThingToTest==ExpectedResult)return TestResult{#ThingToTest,false,##OptionalFailMessage};}catch(...){return TestResult{#ThingToTest,false,"Exception thrown"};}
#define RegisterTest(FunctionBody) static int test_function_##= [](){auto body = [](){FunctionBodyreturn TestResult{"no Test Performed",false,"No test performed"}; }test_functions.push_back(body);return 1;}();
