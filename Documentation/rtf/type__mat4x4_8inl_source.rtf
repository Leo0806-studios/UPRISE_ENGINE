535     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
536     GLM_FUNC_QUALIFIER GLM_CONSTEXPR {\cf17 typename} mat<4, 4, T, Q>::col_type {\cf17 operator}*\par
537     (\par
538         mat<4, 4, T, Q> {\cf17 const}& m,\par
539         {\cf17 typename} mat<4, 4, T, Q>::row_type {\cf17 const}& v\par
540     )\par
541     \{\par
542 {\cf20 /*}\par
543 {\cf20         __m128 v0 = _mm_shuffle_ps(v.data, v.data, _MM_SHUFFLE(0, 0, 0, 0));}\par
544 {\cf20         __m128 v1 = _mm_shuffle_ps(v.data, v.data, _MM_SHUFFLE(1, 1, 1, 1));}\par
545 {\cf20         __m128 v2 = _mm_shuffle_ps(v.data, v.data, _MM_SHUFFLE(2, 2, 2, 2));}\par
546 {\cf20         __m128 v3 = _mm_shuffle_ps(v.data, v.data, _MM_SHUFFLE(3, 3, 3, 3));}\par
547 {\cf20 }\par
548 {\cf20         __m128 m0 = _mm_mul_ps(m[0].data, v0);}\par
549 {\cf20         __m128 m1 = _mm_mul_ps(m[1].data, v1);}\par
550 {\cf20         __m128 a0 = _mm_add_ps(m0, m1);}\par
551 {\cf20 }\par
552 {\cf20         __m128 m2 = _mm_mul_ps(m[2].data, v2);}\par
553 {\cf20         __m128 m3 = _mm_mul_ps(m[3].data, v3);}\par
554 {\cf20         __m128 a1 = _mm_add_ps(m2, m3);}\par
555 {\cf20 }\par
556 {\cf20         __m128 a2 = _mm_add_ps(a0, a1);}\par
557 {\cf20 }\par
558 {\cf20         return typename mat<4, 4, T, Q>::col_type(a2);}\par
559 {\cf20 */}\par
560 \par
561         {\cf17 typename} mat<4, 4, T, Q>::col_type {\cf17 const} Mov0(v[0]);\par
562         {\cf17 typename} mat<4, 4, T, Q>::col_type {\cf17 const} Mov1(v[1]);\par
563         {\cf17 typename} mat<4, 4, T, Q>::col_type {\cf17 const} Mul0 = m[0] * Mov0;\par
564         {\cf17 typename} mat<4, 4, T, Q>::col_type {\cf17 const} Mul1 = m[1] * Mov1;\par
565         {\cf17 typename} mat<4, 4, T, Q>::col_type {\cf17 const} Add0 = Mul0 + Mul1;\par
566         {\cf17 typename} mat<4, 4, T, Q>::col_type {\cf17 const} Mov2(v[2]);\par
567         {\cf17 typename} mat<4, 4, T, Q>::col_type {\cf17 const} Mov3(v[3]);\par
568         {\cf17 typename} mat<4, 4, T, Q>::col_type {\cf17 const} Mul2 = m[2] * Mov2;\par
569         {\cf17 typename} mat<4, 4, T, Q>::col_type {\cf17 const} Mul3 = m[3] * Mov3;\par
570         {\cf17 typename} mat<4, 4, T, Q>::col_type {\cf17 const} Add1 = Mul2 + Mul3;\par
571         {\cf17 typename} mat<4, 4, T, Q>::col_type {\cf17 const} Add2 = Add0 + Add1;\par
572         {\cf19 return} Add2;\par
573 \par
574 {\cf20 /*}\par
575 {\cf20         return typename mat<4, 4, T, Q>::col_type(}\par
576 {\cf20             m[0][0] * v[0] + m[1][0] * v[1] + m[2][0] * v[2] + m[3][0] * v[3],}\par
577 {\cf20             m[0][1] * v[0] + m[1][1] * v[1] + m[2][1] * v[2] + m[3][1] * v[3],}\par
578 {\cf20             m[0][2] * v[0] + m[1][2] * v[1] + m[2][2] * v[2] + m[3][2] * v[3],}\par
579 {\cf20             m[0][3] * v[0] + m[1][3] * v[1] + m[2][3] * v[2] + m[3][3] * v[3]);}\par
580 {\cf20 */}\par
581     \}\par
582 \par
