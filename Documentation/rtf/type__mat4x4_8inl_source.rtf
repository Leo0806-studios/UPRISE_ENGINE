629     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
630     GLM_FUNC_QUALIFIER GLM_CONSTEXPR mat<4, 4, T, Q> operator*(mat<4, 4, T, Q> {\cf17 const}& m1, mat<4, 4, T, Q> {\cf17 const}& m2)\par
631     \{\par
632         {\cf17 typename} mat<4, 4, T, Q>::col_type {\cf17 const} SrcA0 = m1[0];\par
633         {\cf17 typename} mat<4, 4, T, Q>::col_type {\cf17 const} SrcA1 = m1[1];\par
634         {\cf17 typename} mat<4, 4, T, Q>::col_type {\cf17 const} SrcA2 = m1[2];\par
635         {\cf17 typename} mat<4, 4, T, Q>::col_type {\cf17 const} SrcA3 = m1[3];\par
636 \par
637         {\cf17 typename} mat<4, 4, T, Q>::col_type {\cf17 const} SrcB0 = m2[0];\par
638         {\cf17 typename} mat<4, 4, T, Q>::col_type {\cf17 const} SrcB1 = m2[1];\par
639         {\cf17 typename} mat<4, 4, T, Q>::col_type {\cf17 const} SrcB2 = m2[2];\par
640         {\cf17 typename} mat<4, 4, T, Q>::col_type {\cf17 const} SrcB3 = m2[3];\par
641 \par
642         mat<4, 4, T, Q> Result;\par
643         Result[0] = SrcA0 * SrcB0[0] + SrcA1 * SrcB0[1] + SrcA2 * SrcB0[2] + SrcA3 * SrcB0[3];\par
644         Result[1] = SrcA0 * SrcB1[0] + SrcA1 * SrcB1[1] + SrcA2 * SrcB1[2] + SrcA3 * SrcB1[3];\par
645         Result[2] = SrcA0 * SrcB2[0] + SrcA1 * SrcB2[1] + SrcA2 * SrcB2[2] + SrcA3 * SrcB2[3];\par
646         Result[3] = SrcA0 * SrcB3[0] + SrcA1 * SrcB3[1] + SrcA2 * SrcB3[2] + SrcA3 * SrcB3[3];\par
647         {\cf19 return} Result;\par
648     \}\par
