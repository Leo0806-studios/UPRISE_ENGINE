50     \{\par
51         T {\cf17 const} a = angle;\par
52         T {\cf17 const} c = cos(a);\par
53         T {\cf17 const} s = sin(a);\par
54         mat<4, 4, T, Q> Result;\par
55 \par
56         vec<3, T, Q> axis = normalize(v);\par
57 \par
58         Result[0][0] = c + ({\cf17 static_cast<}T{\cf17 >}(1) - c)      * axis.x     * axis.x;\par
59         Result[0][1] = ({\cf17 static_cast<}T{\cf17 >}(1) - c) * axis.x * axis.y + s * axis.z;\par
60         Result[0][2] = ({\cf17 static_cast<}T{\cf17 >}(1) - c) * axis.x * axis.z - s * axis.y;\par
61         Result[0][3] = {\cf17 static_cast<}T{\cf17 >}(0);\par
62 \par
63         Result[1][0] = ({\cf17 static_cast<}T{\cf17 >}(1) - c) * axis.y * axis.x - s * axis.z;\par
64         Result[1][1] = c + ({\cf17 static_cast<}T{\cf17 >}(1) - c) * axis.y * axis.y;\par
65         Result[1][2] = ({\cf17 static_cast<}T{\cf17 >}(1) - c) * axis.y * axis.z + s * axis.x;\par
66         Result[1][3] = {\cf17 static_cast<}T{\cf17 >}(0);\par
67 \par
68         Result[2][0] = ({\cf17 static_cast<}T{\cf17 >}(1) - c) * axis.z * axis.x + s * axis.y;\par
69         Result[2][1] = ({\cf17 static_cast<}T{\cf17 >}(1) - c) * axis.z * axis.y - s * axis.x;\par
70         Result[2][2] = c + ({\cf17 static_cast<}T{\cf17 >}(1) - c) * axis.z * axis.z;\par
71         Result[2][3] = {\cf17 static_cast<}T{\cf17 >}(0);\par
72 \par
73         Result[3] = vec<4, T, Q>(0, 0, 0, 1);\par
74         {\cf19 return} m * Result;\par
75     \}\par
76 \par
77     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
78     GLM_FUNC_QUALIFIER mat<4, 4, T, Q> scale(mat<4, 4, T, Q> {\cf17 const}& m, vec<3, T, Q> {\cf17 const}& v)\par
79     \{\par
80         mat<4, 4, T, Q> Result;\par
81         Result[0] = m[0] * v[0];\par
82         Result[1] = m[1] * v[1];\par
83         Result[2] = m[2] * v[2];\par
84         Result[3] = m[3];\par
85         {\cf19 return} Result;\par
86     \}\par
87 \par
88     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
89     GLM_FUNC_QUALIFIER mat<4, 4, T, Q> scale_slow(mat<4, 4, T, Q> {\cf17 const}& m, vec<3, T, Q> {\cf17 const}& v)\par
90     \{\par
91         mat<4, 4, T, Q> Result(T(1));\par
92         Result[0][0] = v.x;\par
93         Result[1][1] = v.y;\par
94         Result[2][2] = v.z;\par
95         {\cf19 return} m * Result;\par
96     \}\par
97 \par
98     {\cf17 template} <{\cf17 typename} T, qualifier Q>\par
99     GLM_FUNC_QUALIFIER mat<4, 4, T, Q> shear(mat<4, 4, T, Q> {\cf17 const} &m, vec<3, T, Q> {\cf17 const}& p, vec<2, T, Q> {\cf17 const} &l_x, vec<2, T, Q> {\cf17 const} &l_y, vec<2, T, Q> {\cf17 const} &l_z)\par
100     \{\par
101         T {\cf17 const} lambda_xy = l_x[0];\par
102         T {\cf17 const} lambda_xz = l_x[1];\par
103         T {\cf17 const} lambda_yx = l_y[0];\par
104         T {\cf17 const} lambda_yz = l_y[1];\par
105         T {\cf17 const} lambda_zx = l_z[0];\par
106         T {\cf17 const} lambda_zy = l_z[1];\par
107 \par
108         vec<3, T, Q> point_lambda = vec<3, T, Q>(\par
109             (lambda_xy + lambda_xz), (lambda_yx + lambda_yz), (lambda_zx + lambda_zy)\par
110         );\par
111 \par
112         mat<4, 4, T, Q> Shear = mat<4, 4, T, Q>(\par
113             1                      , lambda_yx              , lambda_zx              , 0,\par
114             lambda_xy              , 1                      , lambda_zy              , 0,\par
115             lambda_xz              , lambda_yz              , 1                      , 0,\par
116             -point_lambda[0] * p[0], -point_lambda[1] * p[1], -point_lambda[2] * p[2], 1\par
117         );\par
118 \par
119         mat<4, 4, T, Q> Result;\par
120         Result[0] = m[0] * Shear[0][0] + m[1] * Shear[0][1] + m[2] * Shear[0][2] + m[3] * Shear[0][3];\par
121         Result[1] = m[0] * Shear[1][0] + m[1] * Shear[1][1] + m[2] * Shear[1][2] + m[3] * Shear[1][3];\par
122         Result[2] = m[0] * Shear[2][0] + m[1] * Shear[2][1] + m[2] * Shear[2][2] + m[3] * Shear[2][3];\par
123         Result[3] = m[0] * Shear[3][0] + m[1] * Shear[3][1] + m[2] * Shear[3][2] + m[3] * Shear[3][3];\par
124         {\cf19 return} Result;\par
125     \}\par
126 \par
127     {\cf17 template} <{\cf17 typename} T, qualifier Q>\par
128     GLM_FUNC_QUALIFIER mat<4, 4, T, Q> shear_slow(mat<4, 4, T, Q> {\cf17 const} &m, vec<3, T, Q> {\cf17 const}& p, vec<2, T, Q> {\cf17 const} &l_x, vec<2, T, Q> {\cf17 const} &l_y, vec<2, T, Q> {\cf17 const} &l_z)\par
129     \{\par
130         T {\cf17 const} lambda_xy = {\cf17 static_cast<}T{\cf17 >}(l_x[0]);\par
131         T {\cf17 const} lambda_xz = {\cf17 static_cast<}T{\cf17 >}(l_x[1]);\par
132         T {\cf17 const} lambda_yx = {\cf17 static_cast<}T{\cf17 >}(l_y[0]);\par
133         T {\cf17 const} lambda_yz = {\cf17 static_cast<}T{\cf17 >}(l_y[1]);\par
134         T {\cf17 const} lambda_zx = {\cf17 static_cast<}T{\cf17 >}(l_z[0]);\par
135         T {\cf17 const} lambda_zy = {\cf17 static_cast<}T{\cf17 >}(l_z[1]);\par
136 \par
137         vec<3, T, Q> point_lambda = vec<3, T, Q>(\par
138             {\cf17 static_cast<}T{\cf17 >}(lambda_xy + lambda_xz),\par
139             {\cf17 static_cast<}T{\cf17 >}(lambda_yx + lambda_yz),\par
140             {\cf17 static_cast<}T{\cf17 >}(lambda_zx + lambda_zy)\par
141         );\par
142 \par
143         mat<4, 4, T, Q> Shear = mat<4, 4, T, Q>(\par
144             1                      , lambda_yx              , lambda_zx              , 0,\par
145             lambda_xy              , 1                      , lambda_zy              , 0,\par
146             lambda_xz              , lambda_yz              , 1                      , 0,\par
147             -point_lambda[0] * p[0], -point_lambda[1] * p[1], -point_lambda[2] * p[2], 1\par
148         );\par
149         {\cf19 return} m * Shear;\par
150     \}\par
151 \par
152     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
153     GLM_FUNC_QUALIFIER mat<4, 4, T, Q> lookAtRH(vec<3, T, Q> {\cf17 const}& eye, vec<3, T, Q> {\cf17 const}& center, vec<3, T, Q> {\cf17 const}& up)\par
154     \{\par
155         vec<3, T, Q> {\cf17 const} f(normalize(center - eye));\par
156         vec<3, T, Q> {\cf17 const} s(normalize(cross(f, up)));\par
157         vec<3, T, Q> {\cf17 const} u(cross(s, f));\par
158 \par
159         mat<4, 4, T, Q> Result(1);\par
160         Result[0][0] = s.x;\par
161         Result[1][0] = s.y;\par
162         Result[2][0] = s.z;\par
163         Result[0][1] = u.x;\par
164         Result[1][1] = u.y;\par
165         Result[2][1] = u.z;\par
166         Result[0][2] =-f.x;\par
167         Result[1][2] =-f.y;\par
168         Result[2][2] =-f.z;\par
169         Result[3][0] =-dot(s, eye);\par
170         Result[3][1] =-dot(u, eye);\par
171         Result[3][2] = dot(f, eye);\par
172         {\cf19 return} Result;\par
173     \}\par
174 \par
175     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
176     GLM_FUNC_QUALIFIER mat<4, 4, T, Q> lookAtLH(vec<3, T, Q> {\cf17 const}& eye, vec<3, T, Q> {\cf17 const}& center, vec<3, T, Q> {\cf17 const}& up)\par
177     \{\par
178         vec<3, T, Q> {\cf17 const} f(normalize(center - eye));\par
179         vec<3, T, Q> {\cf17 const} s(normalize(cross(up, f)));\par
180         vec<3, T, Q> {\cf17 const} u(cross(f, s));\par
181 \par
182         mat<4, 4, T, Q> Result(1);\par
183         Result[0][0] = s.x;\par
184         Result[1][0] = s.y;\par
185         Result[2][0] = s.z;\par
186         Result[0][1] = u.x;\par
187         Result[1][1] = u.y;\par
188         Result[2][1] = u.z;\par
189         Result[0][2] = f.x;\par
190         Result[1][2] = f.y;\par
191         Result[2][2] = f.z;\par
192         Result[3][0] = -dot(s, eye);\par
193         Result[3][1] = -dot(u, eye);\par
194         Result[3][2] = -dot(f, eye);\par
195         {\cf19 return} Result;\par
196     \}\par
197 \par
198     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
199     GLM_FUNC_QUALIFIER mat<4, 4, T, Q> lookAt(vec<3, T, Q> {\cf17 const}& eye, vec<3, T, Q> {\cf17 const}& center, vec<3, T, Q> {\cf17 const}& up)\par
200     \{\par
201 {\cf21 #       if (GLM_CONFIG_CLIP_CONTROL & GLM_CLIP_CONTROL_LH_BIT)}\par
202             {\cf19 return} lookAtLH(eye, center, up);\par
203 {\cf21 #       else}\par
204             {\cf19 return} lookAtRH(eye, center, up);\par
205 {\cf21 #       endif}\par
206     \}\par
