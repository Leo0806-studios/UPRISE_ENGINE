\pard\plain \s40\li0\widctlpar\adjustright \shading1000\cbpat8 \f2\fs16\cgrid 00001 \par
00002 {\cf21 #include "pch.h"}\par
00003 {\cf21 #include "RENDER_SHADER_UTILLS.h"}\par
00004 {\cf20 //#include "RENDERSETUP.h"}\par
00005 \par
00006 {\cf17 namespace }PAIN \{\par
00007 \par
00008 \par
00009 \par
00010     Shader::Shader({\cf17 const} {\cf18 char}* vertexPath, {\cf17 const} {\cf18 char}* fragmentPath)\par
00011     \{\par
00012         {\cf20 //glfwMakeContextCurrent(PAIN::RenderStup::Windowvar);}\par
00013 \par
00014         {\cf20 // 1. retrieve the vertex/fragment source code from filePath}\par
00015         std::string vertexCode;\par
00016         std::string fragmentCode;\par
00017         std::ifstream vShaderFile;\par
00018         std::ifstream fShaderFile;\par
00019         {\cf20 // ensure ifstream objects can throw exceptions:}\par
00020         vShaderFile.exceptions(std::ifstream::failbit | std::ifstream::badbit);\par
00021         fShaderFile.exceptions(std::ifstream::failbit | std::ifstream::badbit);\par
00022         {\cf19 try}\par
00023         \{\par
00024             {\cf20 // open files}\par
00025             vShaderFile.open(vertexPath);\par
00026             fShaderFile.open(fragmentPath);\par
00027             std::stringstream vShaderStream, fShaderStream;\par
00028             {\cf20 // read file's buffer contents into streams}\par
00029             vShaderStream << vShaderFile.rdbuf();\par
00030             fShaderStream << fShaderFile.rdbuf();\par
00031             {\cf20 // close file handlers}\par
00032             vShaderFile.close();\par
00033             fShaderFile.close();\par
00034             {\cf20 // convert stream into string}\par
00035             vertexCode = vShaderStream.str();\par
00036             fragmentCode = fShaderStream.str();\par
00037         \}\par
00038         {\cf19 catch} (std::ifstream::failure& e)\par
00039         \{\par
00040             std::cout << {\cf22 "ERROR::SHADER::FILE_NOT_SUCCESSFULLY_READ: "} << e.what() << std::endl;\par
00041         \}\par
00042         {\cf17 const} {\cf18 char}* vShaderCode = vertexCode.c_str();\par
00043         {\cf17 const} {\cf18 char}* fShaderCode = fragmentCode.c_str();\par
00044         {\cf20 // 2. compile shaders}\par
00045         {\cf18 unsigned} {\cf18 int} vertex, fragment;\par
00046         {\cf20 // vertex shader}\par
00047         vertex = glCreateShader(GL_VERTEX_SHADER);\par
00048         glShaderSource(vertex, 1, &vShaderCode, NULL);\par
00049         glCompileShader(vertex);\par
00050         checkCompileErrors(vertex, {\cf22 "VERTEX"});\par
00051         {\cf20 // fragment Shader}\par
00052         fragment = glCreateShader(GL_FRAGMENT_SHADER);\par
00053         glShaderSource(fragment, 1, &fShaderCode, NULL);\par
00054         glCompileShader(fragment);\par
00055         checkCompileErrors(fragment, {\cf22 "FRAGMENT"});\par
00056         {\cf20 // shader Program}\par
00057         ID = glCreateProgram();\par
00058         glAttachShader(ID, vertex);\par
00059         glAttachShader(ID, fragment);\par
00060         glLinkProgram(ID);\par
00061         checkCompileErrors(ID, {\cf22 "PROGRAM"});\par
00062         {\cf20 // delete the shaders as they're linked into our program now and no longer necessary}\par
