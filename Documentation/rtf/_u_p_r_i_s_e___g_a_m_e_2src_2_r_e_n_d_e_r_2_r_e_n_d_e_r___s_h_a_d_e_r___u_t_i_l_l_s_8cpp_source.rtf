00224     {\cf18 void} Shader::checkCompileErrors(GLuint shader, std::string type)\par
00225     \{\par
00226         GLint success;\par
00227         GLchar infoLog[1024];\par
00228         {\cf19 if} (type != {\cf22 "PROGRAM"})\par
00229         \{\par
00230             glGetShaderiv(shader, GL_COMPILE_STATUS, &success);\par
00231             {\cf19 if} (!success)\par
00232             \{\par
00233                 glGetShaderInfoLog(shader, 1024, NULL, infoLog);\par
00234                 std::cout << {\cf22 "ERROR::SHADER_COMPILATION_ERROR of type: "} << type << {\cf22 "\\n"} << infoLog << {\cf22 "\\n -- --------------------------------------------------- -- "} << std::endl;\par
00235             \}\par
00236         \}\par
00237         {\cf19 else}\par
00238         \{\par
00239             glGetProgramiv(shader, GL_LINK_STATUS, &success);\par
00240             {\cf19 if} (!success)\par
00241             \{\par
00242                 glGetProgramInfoLog(shader, 1024, NULL, infoLog);\par
00243                 std::cout << {\cf22 "ERROR::PROGRAM_LINKING_ERROR of type: "} << type << {\cf22 "\\n"} << infoLog << {\cf22 "\\n -- --------------------------------------------------- -- "} << std::endl;\par
00244             \}\par
00245         \}\par
00246     \}\par
