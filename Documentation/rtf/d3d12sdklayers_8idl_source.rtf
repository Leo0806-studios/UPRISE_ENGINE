1527 {\cf20 //=============================================================================}\par
1528 {\cf20 // ID3D12InfoQueue}\par
1529 {\cf20 //}\par
1530 {\cf20 // Logs D3D12 Messages.}\par
1531 {\cf20 // This interface can be queried from ID3D12Device, as long as the device}\par
1532 {\cf20 // was created with the debug layer.}\par
1533 {\cf20 //}\par
1534 {\cf20 //}\par
1535 cpp_quote({\cf22 "#define D3D12_INFO_QUEUE_DEFAULT_MESSAGE_COUNT_LIMIT 1024"})\par
1536 [uuid(0742a90b-c387-483f-b946-30a7e4e61458), object, local, pointer_default(unique)]\par
1537 {\cf17 interface }ID3D12InfoQueue\par
1538     : IUnknown\par
1539 \{\par
1540     {\cf20 //=========================================================================}\par
1541     {\cf20 // Methods for configuring how much data is stored in the queue.}\par
1542 \par
1543     {\cf20 // SetMessageCountLimit()}\par
1544     {\cf20 // This sets how many messages are stored.  When the queue is full,}\par
1545     {\cf20 // new messages coming in push old messages out.}\par
1546     {\cf20 // Passing -1 to SetMessageCountLimit means the queue has}\par
1547     {\cf20 // unlimited size (go until out of memory or ClearStoredMessages()).}\par
1548     {\cf20 // The default message count size is}\par
1549     {\cf20 // D3D12_INFO_QUEUE_DEFAULT_MESSAGE_COUNT_LIMIT}\par
1550     {\cf20 // Returns S_OK or E_INVALIDARG.}\par
1551     HRESULT SetMessageCountLimit([annotation({\cf22 "_In_"})]  UINT64 MessageCountLimit);\par
1552 \par
1553     {\cf20 // ClearStoredMessages}\par
1554     {\cf18 void}    ClearStoredMessages();\par
1555 \par
1556     {\cf20 //=========================================================================}\par
1557     {\cf20 // Methods for retrieving data or statistics from the queue.}\par
1558 \par
1559     {\cf20 // GetMessage()}\par
1560     {\cf20 // Retrieves messages, one at a time, from the queue which pass any}\par
1561     {\cf20 // retrieval filter currently defined.  If there is no retrieval filter,}\par
1562     {\cf20 // all messages can be retrieved.}\par
1563     {\cf20 // The MessageIndex parameter is a 0 based index into the results passing}\par
1564     {\cf20 // the filter.  The number of results is returned by}\par
1565     {\cf20 // GetNumStoredMessagesAllowedByRetrievalFilter().}\par
1566     {\cf20 //}\par
1567     {\cf20 // Note this does not remove the message from the queue.}\par
1568     {\cf20 //}\par
1569     {\cf20 // pMessageByteLength inputs the size of the buffer passed in via}\par
1570     {\cf20 // pMessage, and outputs the size of the message.  pMessage can be NULL}\par
1571     {\cf20 // when the size of the required buffer is being queried (return S_FALSE).}\par
1572     {\cf20 //}\par
1573     {\cf20 // NOTE: The returned buffer pMessage is NOT just the size of D3D12_MESSAGE,}\par
1574     {\cf20 // it includes extra memory after the D3D12_MESSAGE for storing the string}\par
1575     {\cf20 // description, which is pointed to from within D3D12_MESSAGE.  Therefore}\par
1576     {\cf20 // applications should check the size needed for pMessage as described above.}\par
1577     {\cf20 //}\par
1578     {\cf20 // Watch out for thread safety when making consecutive calls first to}\par
1579     {\cf20 // determine the buffer size required and then to pass in the buffer and}\par
1580     {\cf20 // retrieve the message, and also between calling}\par
1581     {\cf20 // GetNumStoredMessagesAllowedByRetrievalFilter() and enumerating through}\par
1582     {\cf20 // the results via GetMessagE().}\par
1583     {\cf20 //}\par
1584     {\cf20 // Returns: S_OK, S_FALSE, E_INVALIDARG or E_OUTOFMEMORY.}\par
1585     HRESULT GetMessage(\par
1586         [annotation({\cf22 "_In_"})]    UINT64  MessageIndex,\par
1587         [annotation({\cf22 "_Out_writes_bytes_opt_(*pMessageByteLength)"})] D3D12_MESSAGE* pMessage,\par
1588         [annotation({\cf22 "_Inout_"})] SIZE_T*  pMessageByteLength);\par
1589 \par
1590     {\cf20 // GetNumMessagesAllowedByStorageFilter()}\par
1591     {\cf20 // Returns how many messages sent to the queue passed}\par
1592     {\cf20 // whatever storage filter was active upon receipt of}\par
1593     {\cf20 // the message.}\par
1594     {\cf20 // This can be a larger value than the message count limit,}\par
1595     {\cf20 // returned by GetMessageCountLimit(), since old messages are discarded}\par
1596     {\cf20 // when the queue is full to prevent overflow.}\par
1597     UINT64  GetNumMessagesAllowedByStorageFilter();\par
1598 \par
1599     {\cf20 // GetNumMessagesDeniedByStorageFilter()}\par
1600     UINT64  GetNumMessagesDeniedByStorageFilter();\par
1601 \par
1602     {\cf20 // GetNumStoredMessages()}\par
1603     {\cf20 // Returns how many messages are currently stored in the queue.}\par
1604     UINT64  GetNumStoredMessages();\par
1605 \par
1606     {\cf20 // GetNumStoredMessagesAllowedByRetrievalFilter()}\par
1607     {\cf20 // Returns how many messages that are currently in the queue}\par
1608     {\cf20 // pass any retrieval filter that is currently set.}\par
1609     {\cf20 // The MessageIndex parameter to GetMessage() indexes}\par
1610     {\cf20 // an array of this many results.}\par
1611     UINT64  GetNumStoredMessagesAllowedByRetrievalFilter();\par
1612 \par
1613     {\cf20 // GetNumMessagesDiscardedByMessageCountLimit()}\par
1614     UINT64  GetNumMessagesDiscardedByMessageCountLimit();\par
1615 \par
1616     {\cf20 // GetMessageCountLimit}\par
1617     {\cf20 // This is how many messages can be stored in the queue.}\par
1618     {\cf20 // When the queue is full, new messages coming in push old messages out.}\par
1619     {\cf20 // -1 means there is no limit.}\par
1620     UINT64  GetMessageCountLimit();\par
1621 \par
1622     {\cf20 //=========================================================================}\par
1623     {\cf20 // Methods for filtering what gets stored in the queue}\par
1624 \par
1625     {\cf20 // AddStorageFilterEntries()}\par
1626     {\cf20 // Adds to the existing entries at top of stack}\par
1627     {\cf20 // Returns: S_OK, E_INVALIDARG or E_OUTOFMEMORY.}\par
1628     HRESULT AddStorageFilterEntries(\par
1629         [annotation({\cf22 "_In_"})]   D3D12_INFO_QUEUE_FILTER* pFilter);\par
1630 \par
1631     {\cf20 // GetStorageFilter()}\par
1632     {\cf20 // Gets all entries at top of stack.}\par
1633     {\cf20 // The application must allocate the output buffer.  The size required can be}\par
1634     {\cf20 // queried by passing null for pFilter and looking at the returned}\par
1635     {\cf20 // pFilterByteLength (HRESULT is S_FALSE). Note that D3D12_INFO_QUEUE_FILTER contains}\par
1636     {\cf20 // pointers - these will point to locations within the same}\par
1637     {\cf20 // contiguous buffer - *pFilterByteLength is the total storage needed for all}\par
1638     {\cf20 // data.  So the application needs to only allocate/free the memory for pFilter.}\par
1639     {\cf20 // Returns S_OK, S_FALSE, E_INVALIDARG or E_OUTOFMEMORY}\par
1640     HRESULT GetStorageFilter(\par
1641         [annotation({\cf22 "_Out_writes_bytes_opt_(*pFilterByteLength)"})] D3D12_INFO_QUEUE_FILTER* pFilter,\par
