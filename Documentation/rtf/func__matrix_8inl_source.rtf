294                 {\cf22 "'determinant' only accept floating-point inputs, include <glm/ext/matrix_integer.hpp> to discard this restriction."});\par
295             {\cf19 return} detail::compute_determinant<C, R, T, Q, detail::is_aligned<Q>::value>::call(m);\par
