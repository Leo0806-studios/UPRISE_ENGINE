302     {\cf17 template}<{\cf17 typename} T, qualifier Q, {\cf18 bool} Aligned>\par
303     {\cf17 struct }compute_inverse<2, 2, T, Q, Aligned>\par
304     \{\par
305         GLM_FUNC_QUALIFIER {\cf17 static} mat<2, 2, T, Q> call(mat<2, 2, T, Q> {\cf17 const}& m)\par
306         \{\par
307             T OneOverDeterminant = {\cf17 static_cast<}T{\cf17 >}(1) / (\par
308                 + m[0][0] * m[1][1]\par
309                 - m[1][0] * m[0][1]);\par
310 \par
311             mat<2, 2, T, Q> Inverse(\par
312                 + m[1][1] * OneOverDeterminant,\par
313                 - m[0][1] * OneOverDeterminant,\par
314                 - m[1][0] * OneOverDeterminant,\par
315                 + m[0][0] * OneOverDeterminant);\par
316 \par
317             {\cf19 return} Inverse;\par
318         \}\par
319     \};\par
320 \par
321     {\cf17 template}<{\cf17 typename} T, qualifier Q, {\cf18 bool} Aligned>\par
322     {\cf17 struct }compute_inverse<3, 3, T, Q, Aligned>\par
323     \{\par
324         GLM_FUNC_QUALIFIER {\cf17 static} mat<3, 3, T, Q> call(mat<3, 3, T, Q> {\cf17 const}& m)\par
325         \{\par
326             T OneOverDeterminant = {\cf17 static_cast<}T{\cf17 >}(1) / (\par
327                 + m[0][0] * (m[1][1] * m[2][2] - m[2][1] * m[1][2])\par
328                 - m[1][0] * (m[0][1] * m[2][2] - m[2][1] * m[0][2])\par
329                 + m[2][0] * (m[0][1] * m[1][2] - m[1][1] * m[0][2]));\par
330 \par
331             mat<3, 3, T, Q> Inverse;\par
332             Inverse[0][0] = + (m[1][1] * m[2][2] - m[2][1] * m[1][2]) * OneOverDeterminant;\par
333             Inverse[1][0] = - (m[1][0] * m[2][2] - m[2][0] * m[1][2]) * OneOverDeterminant;\par
334             Inverse[2][0] = + (m[1][0] * m[2][1] - m[2][0] * m[1][1]) * OneOverDeterminant;\par
335             Inverse[0][1] = - (m[0][1] * m[2][2] - m[2][1] * m[0][2]) * OneOverDeterminant;\par
336             Inverse[1][1] = + (m[0][0] * m[2][2] - m[2][0] * m[0][2]) * OneOverDeterminant;\par
337             Inverse[2][1] = - (m[0][0] * m[2][1] - m[2][0] * m[0][1]) * OneOverDeterminant;\par
338             Inverse[0][2] = + (m[0][1] * m[1][2] - m[1][1] * m[0][2]) * OneOverDeterminant;\par
339             Inverse[1][2] = - (m[0][0] * m[1][2] - m[1][0] * m[0][2]) * OneOverDeterminant;\par
340             Inverse[2][2] = + (m[0][0] * m[1][1] - m[1][0] * m[0][1]) * OneOverDeterminant;\par
341 \par
342             {\cf19 return} Inverse;\par
343         \}\par
344     \};\par
345 \par
346     {\cf17 template}<{\cf17 typename} T, qualifier Q, {\cf18 bool} Aligned>\par
347     {\cf17 struct }compute_inverse<4, 4, T, Q, Aligned>\par
348     \{\par
349         GLM_FUNC_QUALIFIER {\cf17 static} mat<4, 4, T, Q> call(mat<4, 4, T, Q> {\cf17 const}& m)\par
350         \{\par
351             T Coef00 = m[2][2] * m[3][3] - m[3][2] * m[2][3];\par
352             T Coef02 = m[1][2] * m[3][3] - m[3][2] * m[1][3];\par
353             T Coef03 = m[1][2] * m[2][3] - m[2][2] * m[1][3];\par
354 \par
355             T Coef04 = m[2][1] * m[3][3] - m[3][1] * m[2][3];\par
356             T Coef06 = m[1][1] * m[3][3] - m[3][1] * m[1][3];\par
357             T Coef07 = m[1][1] * m[2][3] - m[2][1] * m[1][3];\par
358 \par
359             T Coef08 = m[2][1] * m[3][2] - m[3][1] * m[2][2];\par
360             T Coef10 = m[1][1] * m[3][2] - m[3][1] * m[1][2];\par
361             T Coef11 = m[1][1] * m[2][2] - m[2][1] * m[1][2];\par
362 \par
363             T Coef12 = m[2][0] * m[3][3] - m[3][0] * m[2][3];\par
364             T Coef14 = m[1][0] * m[3][3] - m[3][0] * m[1][3];\par
365             T Coef15 = m[1][0] * m[2][3] - m[2][0] * m[1][3];\par
366 \par
367             T Coef16 = m[2][0] * m[3][2] - m[3][0] * m[2][2];\par
368             T Coef18 = m[1][0] * m[3][2] - m[3][0] * m[1][2];\par
369             T Coef19 = m[1][0] * m[2][2] - m[2][0] * m[1][2];\par
370 \par
371             T Coef20 = m[2][0] * m[3][1] - m[3][0] * m[2][1];\par
372             T Coef22 = m[1][0] * m[3][1] - m[3][0] * m[1][1];\par
373             T Coef23 = m[1][0] * m[2][1] - m[2][0] * m[1][1];\par
374 \par
375             vec<4, T, Q> Fac0(Coef00, Coef00, Coef02, Coef03);\par
376             vec<4, T, Q> Fac1(Coef04, Coef04, Coef06, Coef07);\par
377             vec<4, T, Q> Fac2(Coef08, Coef08, Coef10, Coef11);\par
378             vec<4, T, Q> Fac3(Coef12, Coef12, Coef14, Coef15);\par
379             vec<4, T, Q> Fac4(Coef16, Coef16, Coef18, Coef19);\par
380             vec<4, T, Q> Fac5(Coef20, Coef20, Coef22, Coef23);\par
381 \par
382             vec<4, T, Q> Vec0(m[1][0], m[0][0], m[0][0], m[0][0]);\par
383             vec<4, T, Q> Vec1(m[1][1], m[0][1], m[0][1], m[0][1]);\par
384             vec<4, T, Q> Vec2(m[1][2], m[0][2], m[0][2], m[0][2]);\par
385             vec<4, T, Q> Vec3(m[1][3], m[0][3], m[0][3], m[0][3]);\par
386 \par
387             vec<4, T, Q> Inv0(Vec1 * Fac0 - Vec2 * Fac1 + Vec3 * Fac2);\par
388             vec<4, T, Q> Inv1(Vec0 * Fac0 - Vec2 * Fac3 + Vec3 * Fac4);\par
389             vec<4, T, Q> Inv2(Vec0 * Fac1 - Vec1 * Fac3 + Vec3 * Fac5);\par
390             vec<4, T, Q> Inv3(Vec0 * Fac2 - Vec1 * Fac4 + Vec2 * Fac5);\par
391 \par
392             vec<4, T, Q> SignA(+1, -1, +1, -1);\par
393             vec<4, T, Q> SignB(-1, +1, -1, +1);\par
394             mat<4, 4, T, Q> Inverse(Inv0 * SignA, Inv1 * SignB, Inv2 * SignA, Inv3 * SignB);\par
395 \par
396             vec<4, T, Q> Row0(Inverse[0][0], Inverse[1][0], Inverse[2][0], Inverse[3][0]);\par
397 \par
398             vec<4, T, Q> Dot0(m[0] * Row0);\par
399             T Dot1 = (Dot0.x + Dot0.y) + (Dot0.z + Dot0.w);\par
400 \par
401             T OneOverDeterminant = {\cf17 static_cast<}T{\cf17 >}(1) / Dot1;\par
402 \par
403             {\cf19 return} Inverse * OneOverDeterminant;\par
404         \}\par
405     \};\par
406 \}{\cf20 //namespace detail}\par
