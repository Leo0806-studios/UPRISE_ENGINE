243     {\cf17 template}<{\cf17 typename} T, qualifier Q, {\cf18 bool} Aligned>\par
244     {\cf17 struct }compute_determinant<2, 2, T, Q, Aligned>\par
245     \{\par
246         GLM_FUNC_QUALIFIER {\cf17 static} T call(mat<2, 2, T, Q> {\cf17 const}& m)\par
247         \{\par
248             {\cf19 return} m[0][0] * m[1][1] - m[1][0] * m[0][1];\par
249         \}\par
250     \};\par
251 \par
252     {\cf17 template}<{\cf17 typename} T, qualifier Q, {\cf18 bool} Aligned>\par
253     {\cf17 struct }compute_determinant<3, 3, T, Q, Aligned>\par
254     \{\par
255         GLM_FUNC_QUALIFIER {\cf17 static} T call(mat<3, 3, T, Q> {\cf17 const}& m)\par
256         \{\par
257             {\cf19 return}\par
258                 + m[0][0] * (m[1][1] * m[2][2] - m[2][1] * m[1][2])\par
259                 - m[1][0] * (m[0][1] * m[2][2] - m[2][1] * m[0][2])\par
260                 + m[2][0] * (m[0][1] * m[1][2] - m[1][1] * m[0][2]);\par
261         \}\par
262     \};\par
263 \par
264     {\cf17 template}<{\cf17 typename} T, qualifier Q, {\cf18 bool} Aligned>\par
265     {\cf17 struct }compute_determinant<4, 4, T, Q, Aligned>\par
266     \{\par
267         GLM_FUNC_QUALIFIER {\cf17 static} T call(mat<4, 4, T, Q> {\cf17 const}& m)\par
268         \{\par
269             T SubFactor00 = m[2][2] * m[3][3] - m[3][2] * m[2][3];\par
270             T SubFactor01 = m[2][1] * m[3][3] - m[3][1] * m[2][3];\par
271             T SubFactor02 = m[2][1] * m[3][2] - m[3][1] * m[2][2];\par
272             T SubFactor03 = m[2][0] * m[3][3] - m[3][0] * m[2][3];\par
273             T SubFactor04 = m[2][0] * m[3][2] - m[3][0] * m[2][2];\par
274             T SubFactor05 = m[2][0] * m[3][1] - m[3][0] * m[2][1];\par
275 \par
276             vec<4, T, Q> DetCof(\par
277                 + (m[1][1] * SubFactor00 - m[1][2] * SubFactor01 + m[1][3] * SubFactor02),\par
278                 - (m[1][0] * SubFactor00 - m[1][2] * SubFactor03 + m[1][3] * SubFactor04),\par
279                 + (m[1][0] * SubFactor01 - m[1][1] * SubFactor03 + m[1][3] * SubFactor05),\par
280                 - (m[1][0] * SubFactor02 - m[1][1] * SubFactor04 + m[1][2] * SubFactor05));\par
281 \par
282             {\cf19 return}\par
283                 m[0][0] * DetCof[0] + m[0][1] * DetCof[1] +\par
284                 m[0][2] * DetCof[2] + m[0][3] * DetCof[3];\par
285         \}\par
286     \};\par
