00104 {\cf20 // ---------------------------------------------------------------------------}\par
00105 {\cf20 // Constructs a quaternion from a rotation matrix}\par
00106 {\cf17 template}<{\cf17 typename} TReal>\par
00107 {\cf17 inline} aiQuaterniont<TReal>::aiQuaterniont( {\cf17 const} aiMatrix3x3t<TReal> &pRotMatrix)\par
00108 \{\par
00109     TReal t = pRotMatrix.a1 + pRotMatrix.b2 + pRotMatrix.c3;\par
00110 \par
00111     {\cf20 // large enough}\par
00112     {\cf19 if}( t > {\cf17 static_cast<}TReal{\cf17 >}(0))\par
00113     \{\par
00114         TReal s = std::sqrt(1 + t) * {\cf17 static_cast<}TReal{\cf17 >}(2.0);\par
00115         x = (pRotMatrix.c2 - pRotMatrix.b3) / s;\par
00116         y = (pRotMatrix.a3 - pRotMatrix.c1) / s;\par
00117         z = (pRotMatrix.b1 - pRotMatrix.a2) / s;\par
00118         w = {\cf17 static_cast<}TReal{\cf17 >}(0.25) * s;\par
00119     \} {\cf20 // else we have to check several cases}\par
00120     {\cf19 else} {\cf19 if}( pRotMatrix.a1 > pRotMatrix.b2 && pRotMatrix.a1 > pRotMatrix.c3 )\par
00121     \{\par
00122         {\cf20 // Column 0:}\par
00123         TReal s = std::sqrt( {\cf17 static_cast<}TReal{\cf17 >}(1.0) + pRotMatrix.a1 - pRotMatrix.b2 - pRotMatrix.c3) * {\cf17 static_cast<}TReal{\cf17 >}(2.0);\par
00124         x = {\cf17 static_cast<}TReal{\cf17 >}(0.25) * s;\par
00125         y = (pRotMatrix.b1 + pRotMatrix.a2) / s;\par
00126         z = (pRotMatrix.a3 + pRotMatrix.c1) / s;\par
00127         w = (pRotMatrix.c2 - pRotMatrix.b3) / s;\par
00128     \}\par
00129     {\cf19 else} {\cf19 if}( pRotMatrix.b2 > pRotMatrix.c3)\par
00130     \{\par
00131         {\cf20 // Column 1:}\par
00132         TReal s = std::sqrt( {\cf17 static_cast<}TReal{\cf17 >}(1.0) + pRotMatrix.b2 - pRotMatrix.a1 - pRotMatrix.c3) * {\cf17 static_cast<}TReal{\cf17 >}(2.0);\par
00133         x = (pRotMatrix.b1 + pRotMatrix.a2) / s;\par
00134         y = {\cf17 static_cast<}TReal{\cf17 >}(0.25) * s;\par
00135         z = (pRotMatrix.c2 + pRotMatrix.b3) / s;\par
00136         w = (pRotMatrix.a3 - pRotMatrix.c1) / s;\par
00137     \} {\cf19 else}\par
00138     \{\par
00139         {\cf20 // Column 2:}\par
00140         TReal s = std::sqrt( {\cf17 static_cast<}TReal{\cf17 >}(1.0) + pRotMatrix.c3 - pRotMatrix.a1 - pRotMatrix.b2) * {\cf17 static_cast<}TReal{\cf17 >}(2.0);\par
00141         x = (pRotMatrix.a3 + pRotMatrix.c1) / s;\par
00142         y = (pRotMatrix.c2 + pRotMatrix.b3) / s;\par
00143         z = {\cf17 static_cast<}TReal{\cf17 >}(0.25) * s;\par
00144         w = (pRotMatrix.b1 - pRotMatrix.a2) / s;\par
00145     \}\par
00146 \}\par
00147 \par
00148 {\cf20 // ---------------------------------------------------------------------------}\par
00149 {\cf20 // Construction from euler angles}\par
00150 {\cf17 template}<{\cf17 typename} TReal>\par
00151 {\cf17 inline} aiQuaterniont<TReal>::aiQuaterniont( TReal fPitch, TReal fYaw, TReal fRoll )\par
00152 \{\par
00153     {\cf17 const} TReal fSinPitch(std::sin(fPitch*{\cf17 static_cast<}TReal{\cf17 >}(0.5)));\par
00154     {\cf17 const} TReal fCosPitch(std::cos(fPitch*{\cf17 static_cast<}TReal{\cf17 >}(0.5)));\par
00155     {\cf17 const} TReal fSinYaw(std::sin(fYaw*{\cf17 static_cast<}TReal{\cf17 >}(0.5)));\par
00156     {\cf17 const} TReal fCosYaw(std::cos(fYaw*{\cf17 static_cast<}TReal{\cf17 >}(0.5)));\par
00157     {\cf17 const} TReal fSinRoll(std::sin(fRoll*{\cf17 static_cast<}TReal{\cf17 >}(0.5)));\par
00158     {\cf17 const} TReal fCosRoll(std::cos(fRoll*{\cf17 static_cast<}TReal{\cf17 >}(0.5)));\par
00159     {\cf17 const} TReal fCosPitchCosYaw(fCosPitch*fCosYaw);\par
00160     {\cf17 const} TReal fSinPitchSinYaw(fSinPitch*fSinYaw);\par
00161     x = fSinRoll * fCosPitchCosYaw     - fCosRoll * fSinPitchSinYaw;\par
00162     y = fCosRoll * fSinPitch * fCosYaw + fSinRoll * fCosPitch * fSinYaw;\par
00163     z = fCosRoll * fCosPitch * fSinYaw - fSinRoll * fSinPitch * fCosYaw;\par
00164     w = fCosRoll * fCosPitchCosYaw     + fSinRoll * fSinPitchSinYaw;\par
00165 \}\par
00166 \par
00167 {\cf20 // ---------------------------------------------------------------------------}\par
00168 {\cf20 // Returns a matrix representation of the quaternion}\par
00169 {\cf17 template}<{\cf17 typename} TReal>\par
00170 {\cf17 inline} aiMatrix3x3t<TReal> aiQuaterniont<TReal>::GetMatrix(){\cf17  const}\par
00171 {\cf17 }\{\par
00172     aiMatrix3x3t<TReal> resMatrix;\par
00173     resMatrix.a1 = {\cf17 static_cast<}TReal{\cf17 >}(1.0) - {\cf17 static_cast<}TReal{\cf17 >}(2.0) * (y * y + z * z);\par
00174     resMatrix.a2 = {\cf17 static_cast<}TReal{\cf17 >}(2.0) * (x * y - z * w);\par
00175     resMatrix.a3 = {\cf17 static_cast<}TReal{\cf17 >}(2.0) * (x * z + y * w);\par
00176     resMatrix.b1 = {\cf17 static_cast<}TReal{\cf17 >}(2.0) * (x * y + z * w);\par
00177     resMatrix.b2 = {\cf17 static_cast<}TReal{\cf17 >}(1.0) - {\cf17 static_cast<}TReal{\cf17 >}(2.0) * (x * x + z * z);\par
00178     resMatrix.b3 = {\cf17 static_cast<}TReal{\cf17 >}(2.0) * (y * z - x * w);\par
00179     resMatrix.c1 = {\cf17 static_cast<}TReal{\cf17 >}(2.0) * (x * z - y * w);\par
00180     resMatrix.c2 = {\cf17 static_cast<}TReal{\cf17 >}(2.0) * (y * z + x * w);\par
00181     resMatrix.c3 = {\cf17 static_cast<}TReal{\cf17 >}(1.0) - {\cf17 static_cast<}TReal{\cf17 >}(2.0) * (x * x + y * y);\par
00182 \par
00183     {\cf19 return} resMatrix;\par
00184 \}\par
00185 \par
00186 {\cf20 // ---------------------------------------------------------------------------}\par
00187 {\cf20 // Construction from an axis-angle pair}\par
00188 {\cf17 template}<{\cf17 typename} TReal>\par
00189 {\cf17 inline} aiQuaterniont<TReal>::aiQuaterniont( aiVector3t<TReal> axis, TReal angle)\par
00190 \{\par
00191     axis.Normalize();\par
00192 \par
00193     {\cf17 const} TReal sin_a = std::sin( angle / 2 );\par
00194     {\cf17 const} TReal cos_a = std::cos( angle / 2 );\par
00195     x    = axis.x * sin_a;\par
00196     y    = axis.y * sin_a;\par
00197     z    = axis.z * sin_a;\par
00198     w    = cos_a;\par
00199 \}\par
00200 {\cf20 // ---------------------------------------------------------------------------}\par
00201 {\cf20 // Construction from am existing, normalized quaternion}\par
00202 {\cf17 template}<{\cf17 typename} TReal>\par
00203 {\cf17 inline} aiQuaterniont<TReal>::aiQuaterniont( aiVector3t<TReal> normalized)\par
00204 \{\par
00205     x = normalized.x;\par
00206     y = normalized.y;\par
00207     z = normalized.z;\par
00208 \par
00209     {\cf17 const} TReal t = {\cf17 static_cast<}TReal{\cf17 >}(1.0) - (x*x) - (y*y) - (z*z);\par
00210 \par
00211     {\cf19 if} (t < {\cf17 static_cast<}TReal{\cf17 >}(0.0)) \{\par
00212         w = {\cf17 static_cast<}TReal{\cf17 >}(0.0);\par
00213     \}\par
00214     {\cf19 else} w = std::sqrt (t);\par
00215 \}\par
00216 \par
00217 {\cf20 // ---------------------------------------------------------------------------}\par
00218 {\cf20 // Performs a spherical interpolation between two quaternions}\par
00219 {\cf20 // Implementation adopted from the gmtl project. All others I found on the net fail in some cases.}\par
00220 {\cf20 // Congrats, gmtl!}\par
00221 {\cf17 template}<{\cf17 typename} TReal>\par
00222 {\cf17 inline} {\cf18 void} aiQuaterniont<TReal>::Interpolate( aiQuaterniont& pOut, {\cf17 const} aiQuaterniont& pStart, {\cf17 const} aiQuaterniont& pEnd, TReal pFactor)\par
00223 \{\par
00224     {\cf20 // calc cosine theta}\par
00225     TReal cosom = pStart.x * pEnd.x + pStart.y * pEnd.y + pStart.z * pEnd.z + pStart.w * pEnd.w;\par
00226 \par
00227     {\cf20 // adjust signs (if necessary)}\par
00228     aiQuaterniont end = pEnd;\par
00229     {\cf19 if}( cosom < {\cf17 static_cast<}TReal{\cf17 >}(0.0))\par
00230     \{\par
00231         cosom = -cosom;\par
00232         end.x = -end.x;   {\cf20 // Reverse all signs}\par
00233         end.y = -end.y;\par
00234         end.z = -end.z;\par
00235         end.w = -end.w;\par
00236     \}\par
00237 \par
00238     {\cf20 // Calculate coefficients}\par
00239     TReal sclp, sclq;\par
00240     {\cf19 if}( ({\cf17 static_cast<}TReal{\cf17 >}(1.0) - cosom) > {\cf17 static_cast<}TReal{\cf17 >}(0.0001)) {\cf20 // 0.0001 -> some epsillon}\par
00241     \{\par
00242         {\cf20 // Standard case (slerp)}\par
00243         TReal omega, sinom;\par
00244         omega = std::acos( cosom); {\cf20 // extract theta from dot product's cos theta}\par
00245         sinom = std::sin( omega);\par
00246         sclp  = std::sin( ({\cf17 static_cast<}TReal{\cf17 >}(1.0) - pFactor) * omega) / sinom;\par
00247         sclq  = std::sin( pFactor * omega) / sinom;\par
00248     \} {\cf19 else}\par
00249     \{\par
00250         {\cf20 // Very close, do linear interp (because it's faster)}\par
00251         sclp = {\cf17 static_cast<}TReal{\cf17 >}(1.0) - pFactor;\par
00252         sclq = pFactor;\par
00253     \}\par
00254 \par
00255     pOut.x = sclp * pStart.x + sclq * end.x;\par
00256     pOut.y = sclp * pStart.y + sclq * end.y;\par
00257     pOut.z = sclp * pStart.z + sclq * end.z;\par
00258     pOut.w = sclp * pStart.w + sclq * end.w;\par
00259 \}\par
00260 \par
00261 {\cf20 // ---------------------------------------------------------------------------}\par
00262 {\cf17 template}<{\cf17 typename} TReal>\par
00263 {\cf17 inline} aiQuaterniont<TReal>& aiQuaterniont<TReal>::Normalize()\par
00264 \{\par
00265     {\cf20 // compute the magnitude and divide through it}\par
00266     {\cf17 const} TReal mag = std::sqrt(x*x + y*y + z*z + w*w);\par
00267     {\cf19 if} (mag)\par
00268     \{\par
00269         {\cf17 const} TReal invMag = {\cf17 static_cast<}TReal{\cf17 >}(1.0)/mag;\par
00270         x *= invMag;\par
00271         y *= invMag;\par
00272         z *= invMag;\par
00273         w *= invMag;\par
00274     \}\par
00275     {\cf19 return} *{\cf17 this};\par
00276 \}\par
00277 \par
00278 {\cf20 // ---------------------------------------------------------------------------}\par
00279 {\cf17 template}<{\cf17 typename} TReal>\par
00280 {\cf17 inline} aiQuaterniont<TReal> aiQuaterniont<TReal>::operator* ({\cf17 const} aiQuaterniont& t){\cf17  const}\par
00281 {\cf17 }\{\par
00282     {\cf19 return} aiQuaterniont(w*t.w - x*t.x - y*t.y - z*t.z,\par
00283         w*t.x + x*t.w + y*t.z - z*t.y,\par
00284         w*t.y + y*t.w + z*t.x - x*t.z,\par
00285         w*t.z + z*t.w + x*t.y - y*t.x);\par
00286 \}\par
00287 \par
00288 {\cf20 // ---------------------------------------------------------------------------}\par
00289 {\cf17 template}<{\cf17 typename} TReal>\par
00290 {\cf17 inline} aiQuaterniont<TReal>& aiQuaterniont<TReal>::Conjugate ()\par
00291 \{\par
00292     x = -x;\par
00293     y = -y;\par
00294     z = -z;\par
00295     {\cf19 return} *{\cf17 this};\par
00296 \}\par
00297 \par
00298 {\cf20 // ---------------------------------------------------------------------------}\par
00299 {\cf17 template}<{\cf17 typename} TReal>\par
00300 {\cf17 inline} aiVector3t<TReal> aiQuaterniont<TReal>::Rotate ({\cf17 const} aiVector3t<TReal>& v){\cf17  const}\par
00301 {\cf17 }\{\par
00302     aiQuaterniont q2(0.f,v.x,v.y,v.z), q = *{\cf17 this}, qinv = q;\par
00303     qinv.Conjugate();\par
00304 \par
00305     q = q*q2*qinv;\par
00306     {\cf19 return} aiVector3t<TReal>(q.x,q.y,q.z);\par
00307 \}\par
