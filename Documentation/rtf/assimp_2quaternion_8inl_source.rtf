00095 {\cf17 template}<{\cf17 typename} TReal>\par
00096 {\cf17 inline} {\cf18 bool} aiQuaterniont<TReal>::Equal({\cf17 const} aiQuaterniont& o, TReal epsilon){\cf17  const }\{\par
00097     {\cf19 return}\par
00098         std::abs(x - o.x) <= epsilon &&\par
00099         std::abs(y - o.y) <= epsilon &&\par
