00067     res.y = pMatrix.b1 * pQuaternion.x + pMatrix.b2 * pQuaternion.y + pMatrix.b3 * pQuaternion.z + pMatrix.b4 * pQuaternion.w;\par
00068     res.z = pMatrix.c1 * pQuaternion.x + pMatrix.c2 * pQuaternion.y + pMatrix.c3 * pQuaternion.z + pMatrix.c4 * pQuaternion.w;\par
00069     res.w = pMatrix.d1 * pQuaternion.x + pMatrix.d2 * pQuaternion.y + pMatrix.d3 * pQuaternion.z + pMatrix.d4 * pQuaternion.w;\par
00070     {\cf19 return} res;\par
00071 \}\par
00072 {\cf20 // ---------------------------------------------------------------------------}\par
00073 {\cf17 template}<{\cf17 typename} TReal>\par
00074 {\cf18 bool} aiQuaterniont<TReal>::operator== ({\cf17 const} aiQuaterniont& o){\cf17  const}\par
00075 {\cf17 }\{\par
00076     {\cf19 return} x == o.x && y == o.y && z == o.z && w == o.w;\par
00077 \}\par
00078 \par
00079 {\cf20 // ---------------------------------------------------------------------------}\par
00080 {\cf17 template}<{\cf17 typename} TReal>\par
00081 {\cf18 bool} aiQuaterniont<TReal>::operator!= ({\cf17 const} aiQuaterniont& o){\cf17  const}\par
