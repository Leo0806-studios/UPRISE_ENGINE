6     GLM_FUNC_QUALIFIER {\cf18 int} pow({\cf18 int} x, uint y)\par
7     \{\par
8         {\cf19 if}(y == 0)\par
9             {\cf19 return} x >= 0 ? 1 : -1;\par
10 \par
11         {\cf18 int} result = x;\par
12         {\cf19 for}(uint i = 1; i < y; ++i)\par
