83     GLM_FUNC_QUALIFIER vec<2, T, Q> factorial(\par
84         vec<2, T, Q> {\cf17 const}& x)\par
85     \{\par
86         {\cf19 return} vec<2, T, Q>(\par
87             factorial(x.x),\par
88             factorial(x.y));\par
89     \}\par
