19     \{\par
20         {\cf19 if}(x <= 1) {\cf19 return} x;\par
21 \par
22         {\cf18 int} NextTrial = x >> 1;\par
23         {\cf18 int} CurrentAnswer;\par
24 \par
25         {\cf19 do}\par
26         \{\par
27             CurrentAnswer = NextTrial;\par
28             NextTrial = (NextTrial + x / NextTrial) >> 1;\par
29         \} {\cf19 while}(NextTrial < CurrentAnswer);\par
30 \par
31         {\cf19 return} CurrentAnswer;\par
32     \}\par
