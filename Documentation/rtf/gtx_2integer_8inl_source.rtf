153 {\cf20     // Hackers Delight: http://www.hackersdelight.org/HDcode/nlz.c.txt}\par
154 {\cf20     GLM_FUNC_QUALIFIER unsigned int nlz(unsigned int x)}\par
155 {\cf20     \{}\par
156 {\cf20         int y, m, n;}\par
157 {\cf20 }\par
158 {\cf20         y = -int(x >> 16);      // If left half of x is 0,}\par
159 {\cf20         m = (y >> 16) & 16;  // set n = 16.  If left half}\par
160 {\cf20         n = 16 - m;          // is nonzero, set n = 0 and}\par
161 {\cf20         x = x >> m;          // shift x right 16.}\par
162 {\cf20                             // Now x is of the form 0000xxxx.}\par
163 {\cf20         y = x - 0x100;       // If positions 8-15 are 0,}\par
164 {\cf20         m = (y >> 16) & 8;   // add 8 to n and shift x left 8.}\par
165 {\cf20         n = n + m;}\par
166 {\cf20         x = x << m;}\par
167 {\cf20 }\par
168 {\cf20         y = x - 0x1000;      // If positions 12-15 are 0,}\par
169 {\cf20         m = (y >> 16) & 4;   // add 4 to n and shift x left 4.}\par
170 {\cf20         n = n + m;}\par
171 {\cf20         x = x << m;}\par
172 {\cf20 }\par
173 {\cf20         y = x - 0x4000;      // If positions 14-15 are 0,}\par
174 {\cf20         m = (y >> 16) & 2;   // add 2 to n and shift x left 2.}\par
175 {\cf20         n = n + m;}\par
176 {\cf20         x = x << m;}\par
177 {\cf20 }\par
178 {\cf20         y = x >> 14;         // Set y = 0, 1, 2, or 3.}\par
179 {\cf20         m = y & ~(y >> 1);   // Set m = 0, 1, 2, or 2 resp.}\par
180 {\cf20         return unsigned(n + 2 - m);}\par
