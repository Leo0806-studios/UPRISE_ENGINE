112     GLM_FUNC_QUALIFIER uint pow(uint x, uint y)\par
113     \{\par
114         {\cf19 if} (y == 0)\par
115             {\cf19 return} 1u;\par
116 \par
117         uint result = x;\par
118         {\cf19 for}(uint i = 1; i < y; ++i)\par
119             result *= x;\par
120         {\cf19 return} result;\par
121     \}\par
122 \par
123     GLM_FUNC_QUALIFIER uint sqrt(uint x)\par
124     \{\par
125         {\cf19 if}(x <= 1) {\cf19 return} x;\par
126 \par
127         uint NextTrial = x >> 1;\par
128         uint CurrentAnswer;\par
129 \par
130         {\cf19 do}\par
131         \{\par
132             CurrentAnswer = NextTrial;\par
133             NextTrial = (NextTrial + x / NextTrial) >> 1;\par
134         \} {\cf19 while}(NextTrial < CurrentAnswer);\par
135 \par
136         {\cf19 return} CurrentAnswer;\par
137     \}\par
138 \par
139     GLM_FUNC_QUALIFIER uint mod(uint x, uint y)\par
140     \{\par
141         {\cf19 return} x - y * (x / y);\par
142     \}\par
