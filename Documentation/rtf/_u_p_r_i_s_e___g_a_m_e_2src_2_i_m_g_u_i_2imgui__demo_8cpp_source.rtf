09344 {\cf20 // [SECTION] Example App: Manipulating Window Titles / ShowExampleAppWindowTitles()}\par
09345 {\cf20 //-----------------------------------------------------------------------------}\par
09346 \par
09347 {\cf20 // Demonstrate the use of "##" and "###" in identifiers to manipulate ID generation.}\par
09348 {\cf20 // This applies to all regular items as well.}\par
09349 {\cf20 // Read FAQ section "How can I have multiple widgets with the same label?" for details.}\par
09350 {\cf17 static} {\cf18 void} ShowExampleAppWindowTitles({\cf18 bool}*)\par
09351 \{\par
09352     {\cf17 const} ImGuiViewport* viewport = ImGui::GetMainViewport();\par
09353     {\cf17 const} ImVec2 base_pos = viewport->Pos;\par
09354 \par
09355     {\cf20 // By default, Windows are uniquely identified by their title.}\par
09356     {\cf20 // You can use the "##" and "###" markers to manipulate the display/ID.}\par
09357 \par
09358     {\cf20 // Using "##" to display same title but have unique identifier.}\par
09359     ImGui::SetNextWindowPos(ImVec2(base_pos.x + 100, base_pos.y + 100), ImGuiCond_FirstUseEver);\par
09360     ImGui::Begin({\cf22 "Same title as another window##1"});\par
09361     IMGUI_DEMO_MARKER({\cf22 "Examples/Manipulating window titles"});\par
09362     ImGui::Text({\cf22 "This is window 1.\\nMy title is the same as window 2, but my identifier is unique."});\par
09363     ImGui::End();\par
09364 \par
09365     ImGui::SetNextWindowPos(ImVec2(base_pos.x + 100, base_pos.y + 200), ImGuiCond_FirstUseEver);\par
09366     ImGui::Begin({\cf22 "Same title as another window##2"});\par
09367     ImGui::Text({\cf22 "This is window 2.\\nMy title is the same as window 1, but my identifier is unique."});\par
09368     ImGui::End();\par
09369 \par
09370     {\cf20 // Using "###" to display a changing title but keep a static identifier "AnimatedTitle"}\par
09371     {\cf18 char} buf[128];\par
09372     sprintf(buf, {\cf22 "Animated title %c %d###AnimatedTitle"}, {\cf22 "|/-\\\\"}[({\cf18 int})(ImGui::GetTime() / 0.25f) & 3], ImGui::GetFrameCount());\par
09373     ImGui::SetNextWindowPos(ImVec2(base_pos.x + 100, base_pos.y + 300), ImGuiCond_FirstUseEver);\par
09374     ImGui::Begin(buf);\par
09375     ImGui::Text({\cf22 "This window has a changing title."});\par
09376     ImGui::End();\par
09377 \}\par
