05081 {\cf20 // Dummy data structure that we use for the Table demo.}\par
05082 {\cf20 // (pre-C++11 doesn't allow us to instantiate ImVector<MyItem> template if this structure is defined inside the demo function)}\par
05083 {\cf17 namespace}\par
05084 \{\par
05085 {\cf20 // We are passing our own identifier to TableSetupColumn() to facilitate identifying columns in the sorting code.}\par
05086 {\cf20 // This identifier will be passed down into ImGuiTableSortSpec::ColumnUserID.}\par
05087 {\cf20 // But it is possible to omit the user id parameter of TableSetupColumn() and just use the column index instead! (ImGuiTableSortSpec::ColumnIndex)}\par
05088 {\cf20 // If you don't use sorting, you will generally never care about giving column an ID!}\par
05089 {\cf17 enum} MyItemColumnID\par
05090 \{\par
05091     MyItemColumnID_ID,\par
05092     MyItemColumnID_Name,\par
05093     MyItemColumnID_Action,\par
05094     MyItemColumnID_Quantity,\par
05095     MyItemColumnID_Description\par
05096 \};\par
05097 \par
05098 {\cf17 struct }MyItem\par
05099 \{\par
05100     {\cf18 int}         ID;\par
05101     {\cf17 const} {\cf18 char}* Name;\par
05102     {\cf18 int}         Quantity;\par
05103 \par
05104     {\cf20 // We have a problem which is affecting _only this demo_ and should not affect your code:}\par
05105     {\cf20 // As we don't rely on std:: or other third-party library to compile dear imgui, we only have reliable access to qsort(),}\par
05106     {\cf20 // however qsort doesn't allow passing user data to comparing function.}\par
05107     {\cf20 // As a workaround, we are storing the sort specs in a static/global for the comparing function to access.}\par
05108     {\cf20 // In your own use case you would probably pass the sort specs to your sorting/comparing functions directly and not use a global.}\par
05109     {\cf20 // We could technically call ImGui::TableGetSortSpecs() in CompareWithSortSpecs(), but considering that this function is called}\par
05110     {\cf20 // very often by the sorting algorithm it would be a little wasteful.}\par
05111     {\cf17 static} {\cf17 const} ImGuiTableSortSpecs* s_current_sort_specs;\par
05112 \par
05113     {\cf17 static} {\cf18 void} SortWithSortSpecs(ImGuiTableSortSpecs* sort_specs, MyItem* items, {\cf18 int} items_count)\par
05114     \{\par
05115         s_current_sort_specs = sort_specs; {\cf20 // Store in variable accessible by the sort function.}\par
05116         {\cf19 if} (items_count > 1)\par
05117             qsort(items, ({\cf18 size_t})items_count, {\cf17 sizeof}(items[0]), MyItem::CompareWithSortSpecs);\par
05118         s_current_sort_specs = NULL;\par
05119     \}\par
05120 \par
05121     {\cf20 // Compare function to be used by qsort()}\par
05122     {\cf17 static} {\cf18 int} IMGUI_CDECL CompareWithSortSpecs({\cf17 const} {\cf18 void}* lhs, {\cf17 const} {\cf18 void}* rhs)\par
05123     \{\par
05124         {\cf17 const} MyItem* a = ({\cf17 const} MyItem*)lhs;\par
05125         {\cf17 const} MyItem* b = ({\cf17 const} MyItem*)rhs;\par
05126         {\cf19 for} ({\cf18 int} n = 0; n < s_current_sort_specs->SpecsCount; n++)\par
05127         \{\par
05128             {\cf20 // Here we identify columns using the ColumnUserID value that we ourselves passed to TableSetupColumn()}\par
05129             {\cf20 // We could also choose to identify columns based on their index (sort_spec->ColumnIndex), which is simpler!}\par
05130             {\cf17 const} ImGuiTableColumnSortSpecs* sort_spec = &s_current_sort_specs->Specs[n];\par
05131             {\cf18 int} delta = 0;\par
05132             {\cf19 switch} (sort_spec->ColumnUserID)\par
05133             \{\par
05134             {\cf19 case} MyItemColumnID_ID:             delta = (a->ID - b->ID);                {\cf19 break};\par
05135             {\cf19 case} MyItemColumnID_Name:           delta = (strcmp(a->Name, b->Name));     {\cf19 break};\par
05136             {\cf19 case} MyItemColumnID_Quantity:       delta = (a->Quantity - b->Quantity);    {\cf19 break};\par
05137             {\cf19 case} MyItemColumnID_Description:    delta = (strcmp(a->Name, b->Name));     {\cf19 break};\par
05138             {\cf19 default}: IM_ASSERT(0); {\cf19 break};\par
05139             \}\par
05140             {\cf19 if} (delta > 0)\par
05141                 {\cf19 return} (sort_spec->SortDirection == ImGuiSortDirection_Ascending) ? +1 : -1;\par
05142             {\cf19 if} (delta < 0)\par
05143                 {\cf19 return} (sort_spec->SortDirection == ImGuiSortDirection_Ascending) ? -1 : +1;\par
05144         \}\par
05145 \par
05146         {\cf20 // qsort() is instable so always return a way to differenciate items.}\par
05147         {\cf20 // Your own compare function may want to avoid fallback on implicit sort specs.}\par
05148         {\cf20 // e.g. a Name compare if it wasn't already part of the sort specs.}\par
05149         {\cf19 return} (a->ID - b->ID);\par
05150     \}\par
05151 \};\par
05152 {\cf17 const} ImGuiTableSortSpecs* MyItem::s_current_sort_specs = NULL;\par
05153 \}\par
