08531     {\cf18 void}    ExecCommand({\cf17 const} {\cf18 char}* command_line)\par
08532     \{\par
08533         AddLog({\cf22 "# %s\\n"}, command_line);\par
08534 \par
08535         {\cf20 // Insert into history. First find match and delete it so it can be pushed to the back.}\par
08536         {\cf20 // This isn't trying to be smart or optimal.}\par
08537         HistoryPos = -1;\par
08538         {\cf19 for} ({\cf18 int} i = History.Size - 1; i >= 0; i--)\par
08539             {\cf19 if} (Stricmp(History[i], command_line) == 0)\par
08540             \{\par
08541                 ImGui::MemFree(History[i]);\par
08542                 History.erase(History.begin() + i);\par
08543                 {\cf19 break};\par
08544             \}\par
08545         History.push_back(Strdup(command_line));\par
08546 \par
08547         {\cf20 // Process command}\par
08548         {\cf19 if} (Stricmp(command_line, {\cf22 "CLEAR"}) == 0)\par
08549         \{\par
08550             ClearLog();\par
08551         \}\par
08552         {\cf19 else} {\cf19 if} (Stricmp(command_line, {\cf22 "HELP"}) == 0)\par
08553         \{\par
08554             AddLog({\cf22 "Commands:"});\par
08555             {\cf19 for} ({\cf18 int} i = 0; i < Commands.Size; i++)\par
08556                 AddLog({\cf22 "- %s"}, Commands[i]);\par
08557         \}\par
08558         {\cf19 else} {\cf19 if} (Stricmp(command_line, {\cf22 "HISTORY"}) == 0)\par
08559         \{\par
08560             {\cf18 int} first = History.Size - 10;\par
08561             {\cf19 for} ({\cf18 int} i = first > 0 ? first : 0; i < History.Size; i++)\par
08562                 AddLog({\cf22 "%3d: %s\\n"}, i, History[i]);\par
08563         \}\par
08564         {\cf19 else}\par
08565         \{\par
08566             AddLog({\cf22 "Unknown command: '%s'\\n"}, command_line);\par
08567         \}\par
08568 \par
08569         {\cf20 // On command input, we scroll to bottom even if AutoScroll==false}\par
08570         ScrollToBottom = {\cf17 true};\par
08571     \}\par
