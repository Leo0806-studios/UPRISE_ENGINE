09533         \}\par
09534 \par
09535         {\cf19 if} (ImGui::BeginTabItem({\cf22 "Canvas"}))\par
09536         \{\par
09537             {\cf17 static} ImVector<ImVec2> points;\par
09538             {\cf17 static} ImVec2 scrolling(0.0f, 0.0f);\par
09539             {\cf17 static} {\cf18 bool} opt_enable_grid = {\cf17 true};\par
09540             {\cf17 static} {\cf18 bool} opt_enable_context_menu = {\cf17 true};\par
09541             {\cf17 static} {\cf18 bool} adding_line = {\cf17 false};\par
09542 \par
09543             ImGui::Checkbox({\cf22 "Enable grid"}, &opt_enable_grid);\par
09544             ImGui::Checkbox({\cf22 "Enable context menu"}, &opt_enable_context_menu);\par
09545             ImGui::Text({\cf22 "Mouse Left: drag to add lines,\\nMouse Right: drag to scroll, click for context menu."});\par
09546 \par
09547             {\cf20 // Typically you would use a BeginChild()/EndChild() pair to benefit from a clipping region + own scrolling.}\par
09548             {\cf20 // Here we demonstrate that this can be replaced by simple offsetting + custom drawing + PushClipRect/PopClipRect() calls.}\par
09549             {\cf20 // To use a child window instead we could use, e.g:}\par
09550             {\cf20 //      ImGui::PushStyleVar(ImGuiStyleVar_WindowPadding, ImVec2(0, 0));      // Disable padding}\par
09551             {\cf20 //      ImGui::PushStyleColor(ImGuiCol_ChildBg, IM_COL32(50, 50, 50, 255));  // Set a background color}\par
09552             {\cf20 //      ImGui::BeginChild("canvas", ImVec2(0.0f, 0.0f), ImGuiChildFlags_Border, ImGuiWindowFlags_NoMove);}\par
09553             {\cf20 //      ImGui::PopStyleColor();}\par
09554             {\cf20 //      ImGui::PopStyleVar();}\par
09555             {\cf20 //      [...]}\par
09556             {\cf20 //      ImGui::EndChild();}\par
09557 \par
09558             {\cf20 // Using InvisibleButton() as a convenience 1) it will advance the layout cursor and 2) allows us to use IsItemHovered()/IsItemActive()}\par
09559             ImVec2 canvas_p0 = ImGui::GetCursorScreenPos();      {\cf20 // ImDrawList API uses screen coordinates!}\par
09560             ImVec2 canvas_sz = ImGui::GetContentRegionAvail();   {\cf20 // Resize canvas to what's available}\par
09561             {\cf19 if} (canvas_sz.x < 50.0f) canvas_sz.x = 50.0f;\par
09562             {\cf19 if} (canvas_sz.y < 50.0f) canvas_sz.y = 50.0f;\par
09563             ImVec2 canvas_p1 = ImVec2(canvas_p0.x + canvas_sz.x, canvas_p0.y + canvas_sz.y);\par
09564 \par
09565             {\cf20 // Draw border and background color}\par
09566             ImGuiIO& io = ImGui::GetIO();\par
09567             ImDrawList* draw_list = ImGui::GetWindowDrawList();\par
09568             draw_list->AddRectFilled(canvas_p0, canvas_p1, IM_COL32(50, 50, 50, 255));\par
09569             draw_list->AddRect(canvas_p0, canvas_p1, IM_COL32(255, 255, 255, 255));\par
09570 \par
09571             {\cf20 // This will catch our interactions}\par
09572             ImGui::InvisibleButton({\cf22 "canvas"}, canvas_sz, ImGuiButtonFlags_MouseButtonLeft | ImGuiButtonFlags_MouseButtonRight);\par
09573             {\cf17 const} {\cf18 bool} is_hovered = ImGui::IsItemHovered(); {\cf20 // Hovered}\par
09574             {\cf17 const} {\cf18 bool} is_active = ImGui::IsItemActive();   {\cf20 // Held}\par
09575             {\cf17 const} ImVec2 origin(canvas_p0.x + scrolling.x, canvas_p0.y + scrolling.y); {\cf20 // Lock scrolled origin}\par
09576             {\cf17 const} ImVec2 mouse_pos_in_canvas(io.MousePos.x - origin.x, io.MousePos.y - origin.y);\par
09577 \par
09578             {\cf20 // Add first and second point}\par
09579             {\cf19 if} (is_hovered && !adding_line && ImGui::IsMouseClicked(ImGuiMouseButton_Left))\par
09580             \{\par
09581                 points.push_back(mouse_pos_in_canvas);\par
09582                 points.push_back(mouse_pos_in_canvas);\par
09583                 adding_line = {\cf17 true};\par
09584             \}\par
09585             {\cf19 if} (adding_line)\par
09586             \{\par
09587                 points.back() = mouse_pos_in_canvas;\par
09588                 {\cf19 if} (!ImGui::IsMouseDown(ImGuiMouseButton_Left))\par
09589                     adding_line = {\cf17 false};\par
09590             \}\par
09591 \par
09592             {\cf20 // Pan (we use a zero mouse threshold when there's no context menu)}\par
09593             {\cf20 // You may decide to make that threshold dynamic based on whether the mouse is hovering something etc.}\par
09594             {\cf17 const} {\cf18 float} mouse_threshold_for_pan = opt_enable_context_menu ? -1.0f : 0.0f;\par
09595             {\cf19 if} (is_active && ImGui::IsMouseDragging(ImGuiMouseButton_Right, mouse_threshold_for_pan))\par
09596             \{\par
09597                 scrolling.x += io.MouseDelta.x;\par
09598                 scrolling.y += io.MouseDelta.y;\par
09599             \}\par
09600 \par
09601             {\cf20 // Context menu (under default mouse threshold)}\par
09602             ImVec2 drag_delta = ImGui::GetMouseDragDelta(ImGuiMouseButton_Right);\par
09603             {\cf19 if} (opt_enable_context_menu && drag_delta.x == 0.0f && drag_delta.y == 0.0f)\par
09604                 ImGui::OpenPopupOnItemClick({\cf22 "context"}, ImGuiPopupFlags_MouseButtonRight);\par
09605             {\cf19 if} (ImGui::BeginPopup({\cf22 "context"}))\par
09606             \{\par
09607                 {\cf19 if} (adding_line)\par
09608                     points.resize(points.size() - 2);\par
09609                 adding_line = {\cf17 false};\par
09610                 {\cf19 if} (ImGui::MenuItem({\cf22 "Remove one"}, NULL, {\cf17 false}, points.Size > 0)) \{ points.resize(points.size() - 2); \}\par
09611                 {\cf19 if} (ImGui::MenuItem({\cf22 "Remove all"}, NULL, {\cf17 false}, points.Size > 0)) \{ points.clear(); \}\par
09612                 ImGui::EndPopup();\par
09613             \}\par
09614 \par
09615             {\cf20 // Draw grid + all lines in the canvas}\par
09616             draw_list->PushClipRect(canvas_p0, canvas_p1, {\cf17 true});\par
09617             {\cf19 if} (opt_enable_grid)\par
09618             \{\par
09619                 {\cf17 const} {\cf18 float} GRID_STEP = 64.0f;\par
09620                 {\cf19 for} ({\cf18 float} x = fmodf(scrolling.x, GRID_STEP); x < canvas_sz.x; x += GRID_STEP)\par
09621                     draw_list->AddLine(ImVec2(canvas_p0.x + x, canvas_p0.y), ImVec2(canvas_p0.x + x, canvas_p1.y), IM_COL32(200, 200, 200, 40));\par
09622                 {\cf19 for} ({\cf18 float} y = fmodf(scrolling.y, GRID_STEP); y < canvas_sz.y; y += GRID_STEP)\par
09623                     draw_list->AddLine(ImVec2(canvas_p0.x, canvas_p0.y + y), ImVec2(canvas_p1.x, canvas_p0.y + y), IM_COL32(200, 200, 200, 40));\par
09624             \}\par
09625             {\cf19 for} ({\cf18 int} n = 0; n < points.Size; n += 2)\par
09626                 draw_list->AddLine(ImVec2(origin.x + points[n].x, origin.y + points[n].y), ImVec2(origin.x + points[n + 1].x, origin.y + points[n + 1].y), IM_COL32(255, 255, 0, 255), 2.0f);\par
09627             draw_list->PopClipRect();\par
09628 \par
09629             ImGui::EndTabItem();\par
09630         \}\par
09631 \par
09632         {\cf19 if} (ImGui::BeginTabItem({\cf22 "BG/FG draw lists"}))\par
09633         \{\par
09634             {\cf17 static} {\cf18 bool} draw_bg = {\cf17 true};\par
09635             {\cf17 static} {\cf18 bool} draw_fg = {\cf17 true};\par
09636             ImGui::Checkbox({\cf22 "Draw in Background draw list"}, &draw_bg);\par
09637             ImGui::SameLine(); HelpMarker({\cf22 "The Background draw list will be rendered below every Dear ImGui windows."});\par
09638             ImGui::Checkbox({\cf22 "Draw in Foreground draw list"}, &draw_fg);\par
09639             ImGui::SameLine(); HelpMarker({\cf22 "The Foreground draw list will be rendered over every Dear ImGui windows."});\par
09640             ImVec2 window_pos = ImGui::GetWindowPos();\par
09641             ImVec2 window_size = ImGui::GetWindowSize();\par
09642             ImVec2 window_center = ImVec2(window_pos.x + window_size.x * 0.5f, window_pos.y + window_size.y * 0.5f);\par
09643             {\cf19 if} (draw_bg)\par
09644                 ImGui::GetBackgroundDrawList()->AddCircle(window_center, window_size.x * 0.6f, IM_COL32(255, 0, 0, 200), 0, 10 + 4);\par
09645             {\cf19 if} (draw_fg)\par
09646                 ImGui::GetForegroundDrawList()->AddCircle(window_center, window_size.y * 0.6f, IM_COL32(0, 255, 0, 200), 0, 10);\par
09647             ImGui::EndTabItem();\par
09648         \}\par
09649 \par
09650         {\cf20 // Demonstrate out-of-order rendering via channels splitting}\par
09651         {\cf20 // We use functions in ImDrawList as each draw list contains a convenience splitter,}\par
09652         {\cf20 // but you can also instantiate your own ImDrawListSplitter if you need to nest them.}\par
09653         {\cf19 if} (ImGui::BeginTabItem({\cf22 "Draw Channels"}))\par
09654         \{\par
09655             ImDrawList* draw_list = ImGui::GetWindowDrawList();\par
09656             \{\par
09657                 ImGui::Text({\cf22 "Blue shape is drawn first: appears in back"});\par
09658                 ImGui::Text({\cf22 "Red shape is drawn after: appears in front"});\par
09659                 ImVec2 p0 = ImGui::GetCursorScreenPos();\par
09660                 draw_list->AddRectFilled(ImVec2(p0.x, p0.y), ImVec2(p0.x + 50, p0.y + 50), IM_COL32(0, 0, 255, 255)); {\cf20 // Blue}\par
09661                 draw_list->AddRectFilled(ImVec2(p0.x + 25, p0.y + 25), ImVec2(p0.x + 75, p0.y + 75), IM_COL32(255, 0, 0, 255)); {\cf20 // Red}\par
09662                 ImGui::Dummy(ImVec2(75, 75));\par
09663             \}\par
09664             ImGui::Separator();\par
09665             \{\par
09666                 ImGui::Text({\cf22 "Blue shape is drawn first, into channel 1: appears in front"});\par
09667                 ImGui::Text({\cf22 "Red shape is drawn after, into channel 0: appears in back"});\par
09668                 ImVec2 p1 = ImGui::GetCursorScreenPos();\par
09669 \par
09670                 {\cf20 // Create 2 channels and draw a Blue shape THEN a Red shape.}\par
09671                 {\cf20 // You can create any number of channels. Tables API use 1 channel per column in order to better batch draw calls.}\par
09672                 draw_list->ChannelsSplit(2);\par
09673                 draw_list->ChannelsSetCurrent(1);\par
09674                 draw_list->AddRectFilled(ImVec2(p1.x, p1.y), ImVec2(p1.x + 50, p1.y + 50), IM_COL32(0, 0, 255, 255)); {\cf20 // Blue}\par
09675                 draw_list->ChannelsSetCurrent(0);\par
09676                 draw_list->AddRectFilled(ImVec2(p1.x + 25, p1.y + 25), ImVec2(p1.x + 75, p1.y + 75), IM_COL32(255, 0, 0, 255)); {\cf20 // Red}\par
09677 \par
09678                 {\cf20 // Flatten/reorder channels. Red shape is in channel 0 and it appears below the Blue shape in channel 1.}\par
09679                 {\cf20 // This works by copying draw indices only (vertices are not copied).}\par
09680                 draw_list->ChannelsMerge();\par
09681                 ImGui::Dummy(ImVec2(75, 75));\par
09682                 ImGui::Text({\cf22 "After reordering, contents of channel 0 appears below channel 1."});\par
09683             \}\par
09684             ImGui::EndTabItem();\par
09685         \}\par
09686 \par
09687         ImGui::EndTabBar();\par
09688     \}\par
