10301     {\cf20 // Logic would be written in the main code BeginChild() and outputing to local variables.}\par
10302     {\cf20 // We extracted it into a function so we can call it easily from multiple places.}\par
10303     {\cf18 void} UpdateLayoutSizes({\cf18 float} avail_width)\par
10304     \{\par
10305         {\cf20 // Layout: when not stretching: allow extending into right-most spacing.}\par
10306         LayoutItemSpacing = (float)IconSpacing;\par
10307         {\cf19 if} (StretchSpacing == {\cf17 false})\par
10308             avail_width += floorf(LayoutItemSpacing * 0.5f);\par
10309 \par
10310         {\cf20 // Layout: calculate number of icon per line and number of lines}\par
10311         LayoutItemSize = ImVec2(floorf(IconSize), floorf(IconSize));\par
10312         LayoutColumnCount = IM_MAX(({\cf18 int})(avail_width / (LayoutItemSize.x + LayoutItemSpacing)), 1);\par
10313         LayoutLineCount = (Items.Size + LayoutColumnCount - 1) / LayoutColumnCount;\par
10314 \par
10315         {\cf20 // Layout: when stretching: allocate remaining space to more spacing. Round before division, so item_spacing may be non-integer.}\par
10316         {\cf19 if} (StretchSpacing && LayoutColumnCount > 1)\par
10317             LayoutItemSpacing = floorf(avail_width - LayoutItemSize.x * LayoutColumnCount) / LayoutColumnCount;\par
10318 \par
10319         LayoutItemStep = ImVec2(LayoutItemSize.x + LayoutItemSpacing, LayoutItemSize.y + LayoutItemSpacing);\par
10320         LayoutSelectableSpacing = IM_MAX(floorf(LayoutItemSpacing) - IconHitSpacing, 0.0f);\par
10321         LayoutOuterPadding = floorf(LayoutItemSpacing * 0.5f);\par
10322     \}\par
