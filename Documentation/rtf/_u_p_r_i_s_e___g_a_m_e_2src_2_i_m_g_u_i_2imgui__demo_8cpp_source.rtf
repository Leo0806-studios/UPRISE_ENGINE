09292         {\cf19 if} (ImGui::BeginPopupContextWindow())\par
09293         \{\par
09294             {\cf19 if} (ImGui::MenuItem({\cf22 "Custom"},       NULL, location == -1)) location = -1;\par
09295             {\cf19 if} (ImGui::MenuItem({\cf22 "Center"},       NULL, location == -2)) location = -2;\par
09296             {\cf19 if} (ImGui::MenuItem({\cf22 "Top-left"},     NULL, location == 0)) location = 0;\par
09297             {\cf19 if} (ImGui::MenuItem({\cf22 "Top-right"},    NULL, location == 1)) location = 1;\par
09298             {\cf19 if} (ImGui::MenuItem({\cf22 "Bottom-left"},  NULL, location == 2)) location = 2;\par
09299             {\cf19 if} (ImGui::MenuItem({\cf22 "Bottom-right"}, NULL, location == 3)) location = 3;\par
09300             {\cf19 if} (p_open && ImGui::MenuItem({\cf22 "Close"})) *p_open = {\cf17 false};\par
09301             ImGui::EndPopup();\par
09302         \}\par
09303     \}\par
09304     ImGui::End();\par
