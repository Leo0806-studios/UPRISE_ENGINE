00308 {\cf17 static} ExampleTreeNode* ExampleTree_CreateNode({\cf17 const} {\cf18 char}* name, {\cf18 int} uid, ExampleTreeNode* parent)\par
00309 \{\par
00310     ExampleTreeNode* node = IM_NEW(ExampleTreeNode);\par
00311     snprintf(node->Name, IM_ARRAYSIZE(node->Name), {\cf22 "%s"}, name);\par
00312     node->UID = uid;\par
00313     node->Parent = parent;\par
00314     node->IndexInParent = parent ? ({\cf18 unsigned} short)parent->Childs.Size : 0;\par
00315     {\cf19 if} (parent)\par
00316         parent->Childs.push_back(node);\par
00317     {\cf19 return} node;\par
00318 \}\par
