08573     {\cf20 // In C++11 you'd be better off using lambdas for this sort of forwarding callbacks}\par
08574     {\cf17 static} {\cf18 int} TextEditCallbackStub(ImGuiInputTextCallbackData* data)\par
08575     \{\par
08576         ExampleAppConsole* console = (ExampleAppConsole*)data->UserData;\par
08577         {\cf19 return} console->TextEditCallback(data);\par
