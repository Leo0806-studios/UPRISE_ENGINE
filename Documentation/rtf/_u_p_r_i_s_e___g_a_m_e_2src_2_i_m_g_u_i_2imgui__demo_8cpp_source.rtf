09023         {\cf19 if} (node->Childs.Size == 0)\par
09024             tree_flags |= ImGuiTreeNodeFlags_Leaf | ImGuiTreeNodeFlags_Bullet;\par
09025         {\cf19 if} (node->DataMyBool == {\cf17 false})\par
09026             ImGui::PushStyleColor(ImGuiCol_Text, ImGui::GetStyle().Colors[ImGuiCol_TextDisabled]);\par
09027         {\cf18 bool} node_open = ImGui::TreeNodeEx({\cf22 ""}, tree_flags, {\cf22 "%s"}, node->Name);\par
09028         {\cf19 if} (node->DataMyBool == {\cf17 false})\par
09029             ImGui::PopStyleColor();\par
09030         {\cf19 if} (ImGui::IsItemFocused())\par
09031             VisibleNode = node;\par
09032         {\cf19 if} (node_open)\par
09033         \{\par
09034             {\cf19 for} (ExampleTreeNode* child : node->Childs)\par
09035                 DrawTreeNode(child);\par
09036             ImGui::TreePop();\par
09037         \}\par
09038         ImGui::PopID();\par
09039     \}\par
09040 \};\par
