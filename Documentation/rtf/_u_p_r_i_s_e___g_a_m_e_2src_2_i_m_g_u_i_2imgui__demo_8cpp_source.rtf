09694 {\cf20 // [SECTION] Example App: Docking, DockSpace / ShowExampleAppDockSpace()}\par
09695 {\cf20 //-----------------------------------------------------------------------------}\par
09696 \par
09697 {\cf20 // Demonstrate using DockSpace() to create an explicit docking node within an existing window.}\par
09698 {\cf20 // Note: You can use most Docking facilities without calling any API. You DO NOT need to call DockSpace() to use Docking!}\par
09699 {\cf20 // - Drag from window title bar or their tab to dock/undock. Hold SHIFT to disable docking.}\par
09700 {\cf20 // - Drag from window menu button (upper-left button) to undock an entire node (all windows).}\par
09701 {\cf20 // - When io.ConfigDockingWithShift == true, you instead need to hold SHIFT to enable docking.}\par
09702 {\cf20 // About dockspaces:}\par
09703 {\cf20 // - Use DockSpace() to create an explicit dock node _within_ an existing window.}\par
09704 {\cf20 // - Use DockSpaceOverViewport() to create an explicit dock node covering the screen or a specific viewport.}\par
09705 {\cf20 //   This is often used with ImGuiDockNodeFlags_PassthruCentralNode.}\par
09706 {\cf20 // - Important: Dockspaces need to be submitted _before_ any window they can host. Submit it early in your frame! (*)}\par
09707 {\cf20 // - Important: Dockspaces need to be kept alive if hidden, otherwise windows docked into it will be undocked.}\par
09708 {\cf20 //   e.g. if you have multiple tabs with a dockspace inside each tab: submit the non-visible dockspaces with ImGuiDockNodeFlags_KeepAliveOnly.}\par
09709 {\cf20 // (*) because of this constraint, the implicit \\"Debug\\" window can not be docked into an explicit DockSpace() node,}\par
09710 {\cf20 // because that window is submitted as part of the part of the NewFrame() call. An easy workaround is that you can create}\par
09711 {\cf20 // your own implicit "Debug##2" window after calling DockSpace() and leave it in the window stack for anyone to use.}\par
09712 {\cf18 void} ShowExampleAppDockSpace({\cf18 bool}* p_open)\par
09713 \{\par
09714     {\cf20 // READ THIS !!!}\par
09715     {\cf20 // TL;DR; this demo is more complicated than what most users you would normally use.}\par
09716     {\cf20 // If we remove all options we are showcasing, this demo would become:}\par
09717     {\cf20 //     void ShowExampleAppDockSpace()}\par
09718     {\cf20 //     \{}\par
09719     {\cf20 //         ImGui::DockSpaceOverViewport(0, ImGui::GetMainViewport());}\par
09720     {\cf20 //     \}}\par
09721     {\cf20 // In most cases you should be able to just call DockSpaceOverViewport() and ignore all the code below!}\par
09722     {\cf20 // In this specific demo, we are not using DockSpaceOverViewport() because:}\par
09723     {\cf20 // - (1) we allow the host window to be floating/moveable instead of filling the viewport (when opt_fullscreen == false)}\par
09724     {\cf20 // - (2) we allow the host window to have padding (when opt_padding == true)}\par
09725     {\cf20 // - (3) we expose many flags and need a way to have them visible.}\par
09726     {\cf20 // - (4) we have a local menu bar in the host window (vs. you could use BeginMainMenuBar() + DockSpaceOverViewport()}\par
09727     {\cf20 //      in your code, but we don't here because we allow the window to be floating)}\par
09728 \par
09729     {\cf17 static} {\cf18 bool} opt_fullscreen = {\cf17 true};\par
09730     {\cf17 static} {\cf18 bool} opt_padding = {\cf17 false};\par
09731     {\cf17 static} ImGuiDockNodeFlags dockspace_flags = ImGuiDockNodeFlags_None;\par
09732 \par
09733     {\cf20 // We are using the ImGuiWindowFlags_NoDocking flag to make the parent window not dockable into,}\par
09734     {\cf20 // because it would be confusing to have two docking targets within each others.}\par
09735     ImGuiWindowFlags window_flags = ImGuiWindowFlags_MenuBar | ImGuiWindowFlags_NoDocking;\par
09736     {\cf19 if} (opt_fullscreen)\par
09737     \{\par
09738         {\cf17 const} ImGuiViewport* viewport = ImGui::GetMainViewport();\par
09739         ImGui::SetNextWindowPos(viewport->WorkPos);\par
09740         ImGui::SetNextWindowSize(viewport->WorkSize);\par
09741         ImGui::SetNextWindowViewport(viewport->ID);\par
09742         ImGui::PushStyleVar(ImGuiStyleVar_WindowRounding, 0.0f);\par
09743         ImGui::PushStyleVar(ImGuiStyleVar_WindowBorderSize, 0.0f);\par
09744         window_flags |= ImGuiWindowFlags_NoTitleBar | ImGuiWindowFlags_NoCollapse | ImGuiWindowFlags_NoResize | ImGuiWindowFlags_NoMove;\par
09745         window_flags |= ImGuiWindowFlags_NoBringToFrontOnFocus | ImGuiWindowFlags_NoNavFocus;\par
09746     \}\par
09747     {\cf19 else}\par
09748     \{\par
09749         dockspace_flags &= ~ImGuiDockNodeFlags_PassthruCentralNode;\par
09750     \}\par
09751 \par
09752     {\cf20 // When using ImGuiDockNodeFlags_PassthruCentralNode, DockSpace() will render our background}\par
09753     {\cf20 // and handle the pass-thru hole, so we ask Begin() to not render a background.}\par
09754     {\cf19 if} (dockspace_flags & ImGuiDockNodeFlags_PassthruCentralNode)\par
09755         window_flags |= ImGuiWindowFlags_NoBackground;\par
09756 \par
09757     {\cf20 // Important: note that we proceed even if Begin() returns false (aka window is collapsed).}\par
09758     {\cf20 // This is because we want to keep our DockSpace() active. If a DockSpace() is inactive,}\par
09759     {\cf20 // all active windows docked into it will lose their parent and become undocked.}\par
09760     {\cf20 // We cannot preserve the docking relationship between an active window and an inactive docking, otherwise}\par
09761     {\cf20 // any change of dockspace/settings would lead to windows being stuck in limbo and never being visible.}\par
09762     {\cf19 if} (!opt_padding)\par
09763         ImGui::PushStyleVar(ImGuiStyleVar_WindowPadding, ImVec2(0.0f, 0.0f));\par
09764     ImGui::Begin({\cf22 "DockSpace Demo"}, p_open, window_flags);\par
09765     {\cf19 if} (!opt_padding)\par
09766         ImGui::PopStyleVar();\par
09767 \par
09768     {\cf19 if} (opt_fullscreen)\par
09769         ImGui::PopStyleVar(2);\par
09770 \par
09771     {\cf20 // Submit the DockSpace}\par
09772     ImGuiIO& io = ImGui::GetIO();\par
09773     {\cf19 if} (io.ConfigFlags & ImGuiConfigFlags_DockingEnable)\par
09774     \{\par
09775         ImGuiID dockspace_id = ImGui::GetID({\cf22 "MyDockSpace"});\par
09776         ImGui::DockSpace(dockspace_id, ImVec2(0.0f, 0.0f), dockspace_flags);\par
09777     \}\par
09778     {\cf19 else}\par
09779     \{\par
09780         ShowDockingDisabledMessage();\par
09781     \}\par
09782 \par
09783     {\cf19 if} (ImGui::BeginMenuBar())\par
09784     \{\par
09785         {\cf19 if} (ImGui::BeginMenu({\cf22 "Options"}))\par
09786         \{\par
09787             {\cf20 // Disabling fullscreen would allow the window to be moved to the front of other windows,}\par
09788             {\cf20 // which we can't undo at the moment without finer window depth/z control.}\par
09789             ImGui::MenuItem({\cf22 "Fullscreen"}, NULL, &opt_fullscreen);\par
09790             ImGui::MenuItem({\cf22 "Padding"}, NULL, &opt_padding);\par
09791             ImGui::Separator();\par
09792 \par
09793             {\cf19 if} (ImGui::MenuItem({\cf22 "Flag: NoDockingOverCentralNode"}, {\cf22 ""}, (dockspace_flags & ImGuiDockNodeFlags_NoDockingOverCentralNode) != 0)) \{ dockspace_flags ^= ImGuiDockNodeFlags_NoDockingOverCentralNode; \}\par
09794             {\cf19 if} (ImGui::MenuItem({\cf22 "Flag: NoDockingSplit"},         {\cf22 ""}, (dockspace_flags & ImGuiDockNodeFlags_NoDockingSplit) != 0))             \{ dockspace_flags ^= ImGuiDockNodeFlags_NoDockingSplit; \}\par
09795             {\cf19 if} (ImGui::MenuItem({\cf22 "Flag: NoUndocking"},            {\cf22 ""}, (dockspace_flags & ImGuiDockNodeFlags_NoUndocking) != 0))                \{ dockspace_flags ^= ImGuiDockNodeFlags_NoUndocking; \}\par
09796             {\cf19 if} (ImGui::MenuItem({\cf22 "Flag: NoResize"},               {\cf22 ""}, (dockspace_flags & ImGuiDockNodeFlags_NoResize) != 0))                   \{ dockspace_flags ^= ImGuiDockNodeFlags_NoResize; \}\par
09797             {\cf19 if} (ImGui::MenuItem({\cf22 "Flag: AutoHideTabBar"},         {\cf22 ""}, (dockspace_flags & ImGuiDockNodeFlags_AutoHideTabBar) != 0))             \{ dockspace_flags ^= ImGuiDockNodeFlags_AutoHideTabBar; \}\par
09798             {\cf19 if} (ImGui::MenuItem({\cf22 "Flag: PassthruCentralNode"},    {\cf22 ""}, (dockspace_flags & ImGuiDockNodeFlags_PassthruCentralNode) != 0, opt_fullscreen)) \{ dockspace_flags ^= ImGuiDockNodeFlags_PassthruCentralNode; \}\par
09799             ImGui::Separator();\par
09800 \par
09801             {\cf19 if} (ImGui::MenuItem({\cf22 "Close"}, NULL, {\cf17 false}, p_open != NULL))\par
09802                 *p_open = {\cf17 false};\par
09803             ImGui::EndMenu();\par
09804         \}\par
09805         HelpMarker(\par
09806             {\cf22 "When docking is enabled, you can ALWAYS dock MOST window into another! Try it now!"} {\cf22 "\\n"}\par
09807             {\cf22 "- Drag from window title bar or their tab to dock/undock."} {\cf22 "\\n"}\par
09808             {\cf22 "- Drag from window menu button (upper-left button) to undock an entire node (all windows)."} {\cf22 "\\n"}\par
09809             {\cf22 "- Hold SHIFT to disable docking (if io.ConfigDockingWithShift == false, default)"} {\cf22 "\\n"}\par
09810             {\cf22 "- Hold SHIFT to enable docking (if io.ConfigDockingWithShift == true)"} {\cf22 "\\n"}\par
09811             {\cf22 "This demo app has nothing to do with enabling docking!"} {\cf22 "\\n\\n"}\par
09812             {\cf22 "This demo app only demonstrate the use of ImGui::DockSpace() which allows you to manually create a docking node _within_ another window."} {\cf22 "\\n\\n"}\par
09813             {\cf22 "Read comments in ShowExampleAppDockSpace() for more details."});\par
09814 \par
09815         ImGui::EndMenuBar();\par
09816     \}\par
09817 \par
09818     ImGui::End();\par
09819 \}\par
09820 \par
