10212 {\cf17 struct }ExampleAsset\par
10213 \{\par
10214     ImGuiID ID;\par
10215     {\cf18 int}     Type;\par
10216 \par
10217     ExampleAsset(ImGuiID {\cf18 id}, {\cf18 int} type) \{ ID = id; Type = type; \}\par
10218 \par
10219     {\cf17 static} {\cf17 const} ImGuiTableSortSpecs* s_current_sort_specs;\par
10220 \par
10221     {\cf17 static} {\cf18 void} SortWithSortSpecs(ImGuiTableSortSpecs* sort_specs, ExampleAsset* items, {\cf18 int} items_count)\par
10222     \{\par
10223         s_current_sort_specs = sort_specs; {\cf20 // Store in variable accessible by the sort function.}\par
10224         {\cf19 if} (items_count > 1)\par
10225             qsort(items, ({\cf18 size_t})items_count, {\cf17 sizeof}(items[0]), ExampleAsset::CompareWithSortSpecs);\par
10226         s_current_sort_specs = NULL;\par
10227     \}\par
10228 \par
10229     {\cf20 // Compare function to be used by qsort()}\par
10230     {\cf17 static} {\cf18 int} IMGUI_CDECL CompareWithSortSpecs({\cf17 const} {\cf18 void}* lhs, {\cf17 const} {\cf18 void}* rhs)\par
10231     \{\par
10232         {\cf17 const} ExampleAsset* a = ({\cf17 const} ExampleAsset*)lhs;\par
10233         {\cf17 const} ExampleAsset* b = ({\cf17 const} ExampleAsset*)rhs;\par
10234         {\cf19 for} ({\cf18 int} n = 0; n < s_current_sort_specs->SpecsCount; n++)\par
10235         \{\par
10236             {\cf17 const} ImGuiTableColumnSortSpecs* sort_spec = &s_current_sort_specs->Specs[n];\par
10237             {\cf18 int} delta = 0;\par
10238             {\cf19 if} (sort_spec->ColumnIndex == 0)\par
10239                 delta = ((int)a->ID - ({\cf18 int})b->ID);\par
10240             {\cf19 else} {\cf19 if} (sort_spec->ColumnIndex == 1)\par
10241                 delta = (a->Type - b->Type);\par
10242             {\cf19 if} (delta > 0)\par
10243                 {\cf19 return} (sort_spec->SortDirection == ImGuiSortDirection_Ascending) ? +1 : -1;\par
10244             {\cf19 if} (delta < 0)\par
10245                 {\cf19 return} (sort_spec->SortDirection == ImGuiSortDirection_Ascending) ? -1 : +1;\par
10246         \}\par
10247         {\cf19 return} (({\cf18 int})a->ID - (int)b->ID);\par
10248     \}\par
10249 \};\par
10250 {\cf17 const} ImGuiTableSortSpecs* ExampleAsset::s_current_sort_specs = NULL;\par
