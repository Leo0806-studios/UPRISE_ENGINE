10420             {\cf19 if} (AllowDragUnselected)\par
10421                 ms_flags |= ImGuiMultiSelectFlags_SelectOnClickRelease;\par
10422 \par
10423             {\cf20 // - Enable keyboard wrapping on X axis}\par
10424             {\cf20 // (FIXME-MULTISELECT: We haven't designed/exposed a general nav wrapping api yet, so this flag is provided as a courtesy to avoid doing:}\par
10425             {\cf20 //    ImGui::NavMoveRequestTryWrapping(ImGui::GetCurrentWindow(), ImGuiNavMoveFlags_WrapX);}\par
10426             {\cf20 // When we finish implementing a more general API for this, we will obsolete this flag in favor of the new system)}\par
10427             ms_flags |= ImGuiMultiSelectFlags_NavWrapX;\par
10428 \par
10429             ImGuiMultiSelectIO* ms_io = ImGui::BeginMultiSelect(ms_flags, Selection.Size, Items.Size);\par
10430 \par
10431             {\cf20 // Use custom selection adapter: store ID in selection (recommended)}\par
10432             Selection.UserData = {\cf17 this};\par
10433             Selection.AdapterIndexToStorageId = [](ImGuiSelectionBasicStorage* self_, {\cf18 int} idx) \{ ExampleAssetsBrowser* self = (ExampleAssetsBrowser*)self_->UserData; {\cf19 return} self->Items[idx].ID; \};\par
10434             Selection.ApplyRequests(ms_io);\par
10435 \par
10436             {\cf17 const} {\cf18 bool} want_delete = (ImGui::Shortcut(ImGuiKey_Delete, ImGuiInputFlags_Repeat) && (Selection.Size > 0)) || RequestDelete;\par
10437             {\cf17 const} {\cf18 int} item_curr_idx_to_focus = want_delete ? Selection.ApplyDeletionPreLoop(ms_io, Items.Size) : -1;\par
10438             RequestDelete = {\cf17 false};\par
10439 \par
10440             {\cf20 // Push LayoutSelectableSpacing (which is LayoutItemSpacing minus hit-spacing, if we decide to have hit gaps between items)}\par
10441             {\cf20 // Altering style ItemSpacing may seem unnecessary as we position every items using SetCursorScreenPos()...}\par
10442             {\cf20 // But it is necessary for two reasons:}\par
10443             {\cf20 // - Selectables uses it by default to visually fill the space between two items.}\par
10444             {\cf20 // - The vertical spacing would be measured by Clipper to calculate line height if we didn't provide it explicitly (here we do).}\par
10445             ImGui::PushStyleVar(ImGuiStyleVar_ItemSpacing, ImVec2(LayoutSelectableSpacing, LayoutSelectableSpacing));\par
10446 \par
10447             {\cf20 // Rendering parameters}\par
10448             {\cf17 const} ImU32 icon_type_overlay_colors[3] = \{ 0, IM_COL32(200, 70, 70, 255), IM_COL32(70, 170, 70, 255) \};\par
10449             {\cf17 const} ImU32 icon_bg_color = ImGui::GetColorU32(ImGuiCol_MenuBarBg);\par
10450             {\cf17 const} ImVec2 icon_type_overlay_size = ImVec2(4.0f, 4.0f);\par
10451             {\cf17 const} {\cf18 bool} display_label = (LayoutItemSize.x >= ImGui::CalcTextSize({\cf22 "999"}).x);\par
10452 \par
10453             {\cf17 const} {\cf18 int} column_count = LayoutColumnCount;\par
10454             ImGuiListClipper clipper;\par
10455             clipper.Begin(LayoutLineCount, LayoutItemStep.y);\par
10456             {\cf19 if} (item_curr_idx_to_focus != -1)\par
10457                 clipper.IncludeItemByIndex(item_curr_idx_to_focus / column_count); {\cf20 // Ensure focused item line is not clipped.}\par
10458             {\cf19 if} (ms_io->RangeSrcItem != -1)\par
10459                 clipper.IncludeItemByIndex(({\cf18 int})ms_io->RangeSrcItem / column_count); {\cf20 // Ensure RangeSrc item line is not clipped.}\par
10460             {\cf19 while} (clipper.Step())\par
10461             \{\par
10462                 {\cf19 for} ({\cf18 int} line_idx = clipper.DisplayStart; line_idx < clipper.DisplayEnd; line_idx++)\par
10463                 \{\par
10464                     {\cf17 const} {\cf18 int} item_min_idx_for_current_line = line_idx * column_count;\par
10465                     {\cf17 const} {\cf18 int} item_max_idx_for_current_line = IM_MIN((line_idx + 1) * column_count, Items.Size);\par
10466                     {\cf19 for} ({\cf18 int} item_idx = item_min_idx_for_current_line; item_idx < item_max_idx_for_current_line; ++item_idx)\par
10467                     \{\par
10468                         ExampleAsset* item_data = &Items[item_idx];\par
10469                         ImGui::PushID(({\cf18 int})item_data->ID);\par
10470 \par
10471                         {\cf20 // Position item}\par
10472                         ImVec2 pos = ImVec2(start_pos.x + (item_idx % column_count) * LayoutItemStep.x, start_pos.y + line_idx * LayoutItemStep.y);\par
10473                         ImGui::SetCursorScreenPos(pos);\par
10474 \par
10475                         ImGui::SetNextItemSelectionUserData(item_idx);\par
10476                         {\cf18 bool} item_is_selected = Selection.Contains((ImGuiID)item_data->ID);\par
10477                         {\cf18 bool} item_is_visible = ImGui::IsRectVisible(LayoutItemSize);\par
10478                         ImGui::Selectable({\cf22 ""}, item_is_selected, ImGuiSelectableFlags_None, LayoutItemSize);\par
10479 \par
10480                         {\cf20 // Update our selection state immediately (without waiting for EndMultiSelect() requests)}\par
10481                         {\cf20 // because we use this to alter the color of our text/icon.}\par
10482                         {\cf19 if} (ImGui::IsItemToggledSelection())\par
10483                             item_is_selected = !item_is_selected;\par
10484 \par
10485                         {\cf20 // Focus (for after deletion)}\par
10486                         {\cf19 if} (item_curr_idx_to_focus == item_idx)\par
10487                             ImGui::SetKeyboardFocusHere(-1);\par
10488 \par
10489                         {\cf20 // Drag and drop}\par
10490                         {\cf19 if} (ImGui::BeginDragDropSource())\par
10491                         \{\par
10492                             {\cf20 // Create payload with full selection OR single unselected item.}\par
10493                             {\cf20 // (the later is only possible when using ImGuiMultiSelectFlags_SelectOnClickRelease)}\par
10494                             {\cf19 if} (ImGui::GetDragDropPayload() == NULL)\par
10495                             \{\par
10496                                 ImVector<ImGuiID> payload_items;\par
10497                                 {\cf18 void}* it = NULL;\par
10498                                 ImGuiID {\cf18 id} = 0;\par
10499                                 {\cf19 if} (!item_is_selected)\par
10500                                     payload_items.push_back(item_data->ID);\par
10501                                 {\cf19 else}\par
10502                                     {\cf19 while} (Selection.GetNextSelectedItem(&it, &{\cf18 id}))\par
10503                                         payload_items.push_back({\cf18 id});\par
10504                                 ImGui::SetDragDropPayload({\cf22 "ASSETS_BROWSER_ITEMS"}, payload_items.Data, ({\cf18 size_t})payload_items.size_in_bytes());\par
10505                             \}\par
10506 \par
10507                             {\cf20 // Display payload content in tooltip, by extracting it from the payload data}\par
10508                             {\cf20 // (we could read from selection, but it is more correct and reusable to read from payload)}\par
10509                             {\cf17 const} ImGuiPayload* payload = ImGui::GetDragDropPayload();\par
10510                             {\cf17 const} {\cf18 int} payload_count = (int)payload->DataSize / ({\cf18 int}){\cf17 sizeof}(ImGuiID);\par
10511                             ImGui::Text({\cf22 "%d assets"}, payload_count);\par
10512 \par
10513                             ImGui::EndDragDropSource();\par
10514                         \}\par
10515 \par
10516                         {\cf20 // Render icon (a real app would likely display an image/thumbnail here)}\par
10517                         {\cf20 // Because we use ImGuiMultiSelectFlags_BoxSelect2d, clipping vertical may occasionally be larger, so we coarse-clip our rendering as well.}\par
10518                         {\cf19 if} (item_is_visible)\par
10519                         \{\par
10520                             ImVec2 box_min(pos.x - 1, pos.y - 1);\par
10521                             ImVec2 box_max(box_min.x + LayoutItemSize.x + 2, box_min.y + LayoutItemSize.y + 2); {\cf20 // Dubious}\par
10522                             draw_list->AddRectFilled(box_min, box_max, icon_bg_color); {\cf20 // Background color}\par
10523                             {\cf19 if} (ShowTypeOverlay && item_data->Type != 0)\par
10524                             \{\par
10525                                 ImU32 type_col = icon_type_overlay_colors[item_data->Type % IM_ARRAYSIZE(icon_type_overlay_colors)];\par
10526                                 draw_list->AddRectFilled(ImVec2(box_max.x - 2 - icon_type_overlay_size.x, box_min.y + 2), ImVec2(box_max.x - 2, box_min.y + 2 + icon_type_overlay_size.y), type_col);\par
10527                             \}\par
10528                             {\cf19 if} (display_label)\par
10529                             \{\par
10530                                 ImU32 label_col = ImGui::GetColorU32(item_is_selected ? ImGuiCol_Text : ImGuiCol_TextDisabled);\par
10531                                 {\cf18 char} label[32];\par
10532                                 sprintf(label, {\cf22 "%d"}, item_data->ID);\par
10533                                 draw_list->AddText(ImVec2(box_min.x, box_max.y - ImGui::GetFontSize()), label_col, label);\par
10534                             \}\par
10535                         \}\par
10536 \par
10537                         ImGui::PopID();\par
10538                     \}\par
10539                 \}\par
10540             \}\par
10541             clipper.End();\par
10542             ImGui::PopStyleVar(); {\cf20 // ImGuiStyleVar_ItemSpacing}\par
10543 \par
10544             {\cf20 // Context menu}\par
10545             {\cf19 if} (ImGui::BeginPopupContextWindow())\par
10546             \{\par
10547                 ImGui::Text({\cf22 "Selection: %d items"}, Selection.Size);\par
10548                 ImGui::Separator();\par
10549                 {\cf19 if} (ImGui::MenuItem({\cf22 "Delete"}, {\cf22 "Del"}, {\cf17 false}, Selection.Size > 0))\par
10550                     RequestDelete = {\cf17 true};\par
10551                 ImGui::EndPopup();\par
10552             \}\par
10553 \par
10554             ms_io = ImGui::EndMultiSelect();\par
10555             Selection.ApplyRequests(ms_io);\par
10556             {\cf19 if} (want_delete)\par
10557                 Selection.ApplyDeletionPostLoop(ms_io, Items, item_curr_idx_to_focus);\par
10558 \par
10559             {\cf20 // Zooming with CTRL+Wheel}\par
10560             {\cf19 if} (ImGui::IsWindowAppearing())\par
10561                 ZoomWheelAccum = 0.0f;\par
10562             {\cf19 if} (ImGui::IsWindowHovered() && io.MouseWheel != 0.0f && ImGui::IsKeyDown(ImGuiMod_Ctrl) && ImGui::IsAnyItemActive() == {\cf17 false})\par
10563             \{\par
10564                 ZoomWheelAccum += io.MouseWheel;\par
10565                 {\cf19 if} (fabsf(ZoomWheelAccum) >= 1.0f)\par
10566                 \{\par
10567                     {\cf20 // Calculate hovered item index from mouse location}\par
10568                     {\cf20 // FIXME: Locking aiming on 'hovered_item_idx' (with a cool-down timer) would ensure zoom keeps on it.}\par
10569                     {\cf17 const} {\cf18 float} hovered_item_nx = (io.MousePos.x - start_pos.x + LayoutItemSpacing * 0.5f) / LayoutItemStep.x;\par
10570                     {\cf17 const} {\cf18 float} hovered_item_ny = (io.MousePos.y - start_pos.y + LayoutItemSpacing * 0.5f) / LayoutItemStep.y;\par
10571                     {\cf17 const} {\cf18 int} hovered_item_idx = ((int)hovered_item_ny * LayoutColumnCount) + (int)hovered_item_nx;\par
10572                     {\cf20 //ImGui::SetTooltip("%f,%f -> item %d", hovered_item_nx, hovered_item_ny, hovered_item_idx); // Move those 4 lines in block above for easy debugging}\par
10573 \par
10574                     {\cf20 // Zoom}\par
10575                     IconSize *= powf(1.1f, ({\cf18 float})({\cf18 int})ZoomWheelAccum);\par
10576                     IconSize = IM_CLAMP(IconSize, 16.0f, 128.0f);\par
10577                     ZoomWheelAccum -= (int)ZoomWheelAccum;\par
10578                     UpdateLayoutSizes(avail_width);\par
10579 \par
10580                     {\cf20 // Manipulate scroll to that we will land at the same Y location of currently hovered item.}\par
10581                     {\cf20 // - Calculate next frame position of item under mouse}\par
10582                     {\cf20 // - Set new scroll position to be used in next ImGui::BeginChild() call.}\par
10583                     {\cf18 float} hovered_item_rel_pos_y = ((float)(hovered_item_idx / LayoutColumnCount) + fmodf(hovered_item_ny, 1.0f)) * LayoutItemStep.y;\par
10584                     hovered_item_rel_pos_y += ImGui::GetStyle().WindowPadding.y;\par
10585                     {\cf18 float} mouse_local_y = io.MousePos.y - ImGui::GetWindowPos().y;\par
10586                     ImGui::SetScrollY(hovered_item_rel_pos_y - mouse_local_y);\par
10587                 \}\par
10588             \}\par
10589         \}\par
10590         ImGui::EndChild();\par
10591 \par
10592         ImGui::Text({\cf22 "Selected: %d/%d items"}, Selection.Size, Items.Size);\par
10593         ImGui::End();\par
10594     \}\par
