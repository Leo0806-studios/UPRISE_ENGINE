09013     {\cf18 void} DrawTreeNode(ExampleTreeNode* node)\par
09014     \{\par
09015         ImGui::TableNextRow();\par
09016         ImGui::TableNextColumn();\par
09017         ImGui::PushID(node->UID);\par
09018         ImGuiTreeNodeFlags tree_flags = ImGuiTreeNodeFlags_None;\par
09019         tree_flags |= ImGuiTreeNodeFlags_OpenOnArrow | ImGuiTreeNodeFlags_OpenOnDoubleClick;    {\cf20 // Standard opening mode as we are likely to want to add selection afterwards}\par
09020         tree_flags |= ImGuiTreeNodeFlags_NavLeftJumpsBackHere;                                  {\cf20 // Left arrow support}\par
09021         {\cf19 if} (node == VisibleNode)\par
