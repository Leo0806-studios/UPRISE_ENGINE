08367     {\cf17 static} {\cf18 int}   Strnicmp({\cf17 const} {\cf18 char}* s1, {\cf17 const} {\cf18 char}* s2, {\cf18 int} n) \{ {\cf18 int} d = 0; {\cf19 while} (n > 0 && (d = toupper(*s2) - toupper(*s1)) == 0 && *s1) \{ s1++; s2++; n--; \} {\cf19 return} d; \}\par
