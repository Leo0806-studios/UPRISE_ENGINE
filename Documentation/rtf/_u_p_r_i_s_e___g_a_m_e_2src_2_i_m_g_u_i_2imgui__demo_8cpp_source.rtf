08833         {\cf17 const} {\cf18 char}* categories[3] = \{ {\cf22 "info"}, {\cf22 "warn"}, {\cf22 "error"} \};\par
08834         {\cf17 const} {\cf18 char}* words[] = \{ {\cf22 "Bumfuzzled"}, {\cf22 "Cattywampus"}, {\cf22 "Snickersnee"}, {\cf22 "Abibliophobia"}, {\cf22 "Absquatulate"}, {\cf22 "Nincompoop"}, {\cf22 "Pauciloquent"} \};\par
08835         {\cf19 for} ({\cf18 int} n = 0; n < 5; n++)\par
08836         \{\par
