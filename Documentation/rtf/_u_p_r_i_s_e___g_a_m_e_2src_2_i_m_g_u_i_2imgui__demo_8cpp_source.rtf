02956 {\cf20 // Extra functions to add deletion support to ImGuiSelectionBasicStorage}\par
02957 {\cf17 struct }ExampleSelectionWithDeletion : ImGuiSelectionBasicStorage\par
02958 \{\par
02959     {\cf20 // Find which item should be Focused after deletion.}\par
02960     {\cf20 // Call _before_ item submission. Retunr an index in the before-deletion item list, your item loop should call SetKeyboardFocusHere() on it.}\par
02961     {\cf20 // The subsequent ApplyDeletionPostLoop() code will use it to apply Selection.}\par
02962     {\cf20 // - We cannot provide this logic in core Dear ImGui because we don't have access to selection data.}\par
02963     {\cf20 // - We don't actually manipulate the ImVector<> here, only in ApplyDeletionPostLoop(), but using similar API for consistency and flexibility.}\par
02964     {\cf20 // - Important: Deletion only works if the underlying ImGuiID for your items are stable: aka not depend on their index, but on e.g. item id/ptr.}\par
02965     {\cf20 // FIXME-MULTISELECT: Doesn't take account of the possibility focus target will be moved during deletion. Need refocus or scroll offset.}\par
02966     {\cf18 int} ApplyDeletionPreLoop(ImGuiMultiSelectIO* ms_io, {\cf18 int} items_count)\par
02967     \{\par
02968         {\cf19 if} (Size == 0)\par
02969             {\cf19 return} -1;\par
02970 \par
02971         {\cf20 // If focused item is not selected...}\par
02972         {\cf17 const} {\cf18 int} focused_idx = (int)ms_io->NavIdItem;  {\cf20 // Index of currently focused item}\par
02973         {\cf19 if} (ms_io->NavIdSelected == {\cf17 false})  {\cf20 // This is merely a shortcut, == Contains(adapter->IndexToStorage(items, focused_idx))}\par
02974         \{\par
02975             ms_io->RangeSrcReset = {\cf17 true};    {\cf20 // Request to recover RangeSrc from NavId next frame. Would be ok to reset even when NavIdSelected==true, but it would take an extra frame to recover RangeSrc when deleting a selected item.}\par
02976             {\cf19 return} focused_idx;             {\cf20 // Request to focus same item after deletion.}\par
02977         \}\par
02978 \par
02979         {\cf20 // If focused item is selected: land on first unselected item after focused item.}\par
02980         {\cf19 for} ({\cf18 int} idx = focused_idx + 1; idx < items_count; idx++)\par
02981             {\cf19 if} (!Contains(GetStorageIdFromIndex(idx)))\par
02982                 {\cf19 return} idx;\par
02983 \par
02984         {\cf20 // If focused item is selected: otherwise return last unselected item before focused item.}\par
02985         {\cf19 for} ({\cf18 int} idx = IM_MIN(focused_idx, items_count) - 1; idx >= 0; idx--)\par
02986             {\cf19 if} (!Contains(GetStorageIdFromIndex(idx)))\par
02987                 {\cf19 return} idx;\par
02988 \par
02989         {\cf19 return} -1;\par
02990     \}\par
02991 \par
02992     {\cf20 // Rewrite item list (delete items) + update selection.}\par
02993     {\cf20 // - Call after EndMultiSelect()}\par
02994     {\cf20 // - We cannot provide this logic in core Dear ImGui because we don't have access to your items, nor to selection data.}\par
02995     {\cf17 template}<{\cf17 typename} ITEM_TYPE>\par
02996     {\cf18 void} ApplyDeletionPostLoop(ImGuiMultiSelectIO* ms_io, ImVector<ITEM_TYPE>& items, {\cf18 int} item_curr_idx_to_select)\par
02997     \{\par
02998         {\cf20 // Rewrite item list (delete items) + convert old selection index (before deletion) to new selection index (after selection).}\par
02999         {\cf20 // If NavId was not part of selection, we will stay on same item.}\par
03000         ImVector<ITEM_TYPE> new_items;\par
03001         new_items.reserve(items.Size - Size);\par
03002         {\cf18 int} item_next_idx_to_select = -1;\par
03003         {\cf19 for} ({\cf18 int} idx = 0; idx < items.Size; idx++)\par
03004         \{\par
03005             {\cf19 if} (!Contains(GetStorageIdFromIndex(idx)))\par
03006                 new_items.push_back(items[idx]);\par
03007             {\cf19 if} (item_curr_idx_to_select == idx)\par
03008                 item_next_idx_to_select = new_items.Size - 1;\par
03009         \}\par
03010         items.swap(new_items);\par
03011 \par
03012         {\cf20 // Update selection}\par
03013         Clear();\par
03014         {\cf19 if} (item_next_idx_to_select != -1 && ms_io->NavIdSelected)\par
03015             SetItemSelected(GetStorageIdFromIndex(item_next_idx_to_select), {\cf17 true});\par
03016     \}\par
03017 \};\par
