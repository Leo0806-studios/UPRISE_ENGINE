07842 {\cf20 // Demo helper function to select among loaded fonts.}\par
07843 {\cf20 // Here we use the regular BeginCombo()/EndCombo() api which is the more flexible one.}\par
07844 {\cf18 void} ImGui::ShowFontSelector({\cf17 const} {\cf18 char}* label)\par
07845 \{\par
07846     ImGuiIO& io = ImGui::GetIO();\par
07847     ImFont* font_current = ImGui::GetFont();\par
07848     {\cf19 if} (ImGui::BeginCombo(label, font_current->GetDebugName()))\par
07849     \{\par
07850         {\cf19 for} (ImFont* font : io.Fonts->Fonts)\par
07851         \{\par
07852             ImGui::PushID(({\cf18 void}*)font);\par
07853             {\cf19 if} (ImGui::Selectable(font->GetDebugName(), font == font_current))\par
07854                 io.FontDefault = font;\par
07855             ImGui::PopID();\par
07856         \}\par
07857         ImGui::EndCombo();\par
07858     \}\par
07859     ImGui::SameLine();\par
07860     HelpMarker(\par
07861         {\cf22 "- Load additional fonts with io.Fonts->AddFontFromFileTTF().\\n"}\par
07862         {\cf22 "- The font atlas is built when calling io.Fonts->GetTexDataAsXXXX() or io.Fonts->Build().\\n"}\par
07863         {\cf22 "- Read FAQ and docs/FONTS.md for more details.\\n"}\par
07864         {\cf22 "- If you need to add/remove fonts at runtime (e.g. for DPI change), do it before calling NewFrame()."});\par
07865 \}\par
