08689 {\cf20 // [SECTION] Example App: Debug Log / ShowExampleAppLog()}\par
08690 {\cf20 //-----------------------------------------------------------------------------}\par
08691 \par
08692 {\cf20 // Usage:}\par
08693 {\cf20 //  static ExampleAppLog my_log;}\par
08694 {\cf20 //  my_log.AddLog("Hello %d world\\n", 123);}\par
08695 {\cf20 //  my_log.Draw("title");}\par
08696 {\cf17 struct }ExampleAppLog\par
08697 \{\par
08698     ImGuiTextBuffer     Buf;\par
08699     ImGuiTextFilter     Filter;\par
08700     ImVector<int>       LineOffsets; {\cf20 // Index to lines offset. We maintain this with AddLog() calls.}\par
08701     {\cf18 bool}                AutoScroll;  {\cf20 // Keep scrolling if already at the bottom.}\par
08702 \par
08703     ExampleAppLog()\par
08704     \{\par
08705         AutoScroll = {\cf17 true};\par
08706         Clear();\par
08707     \}\par
08708 \par
08709     {\cf18 void}    Clear()\par
08710     \{\par
08711         Buf.clear();\par
08712         LineOffsets.clear();\par
08713         LineOffsets.push_back(0);\par
08714     \}\par
08715 \par
08716     {\cf18 void}    AddLog({\cf17 const} {\cf18 char}* fmt, ...) IM_FMTARGS(2)\par
08717     \{\par
08718         {\cf18 int} old_size = Buf.size();\par
08719         va_list args;\par
08720         va_start(args, fmt);\par
08721         Buf.appendfv(fmt, args);\par
08722         va_end(args);\par
08723         {\cf19 for} ({\cf18 int} new_size = Buf.size(); old_size < new_size; old_size++)\par
08724             {\cf19 if} (Buf[old_size] == {\cf23 '\\n'})\par
08725                 LineOffsets.push_back(old_size + 1);\par
08726     \}\par
08727 \par
08728     {\cf18 void}    Draw({\cf17 const} {\cf18 char}* title, {\cf18 bool}* p_open = NULL)\par
08729     \{\par
08730         {\cf19 if} (!ImGui::Begin(title, p_open))\par
08731         \{\par
08732             ImGui::End();\par
08733             {\cf19 return};\par
08734         \}\par
08735 \par
08736         {\cf20 // Options menu}\par
08737         {\cf19 if} (ImGui::BeginPopup({\cf22 "Options"}))\par
08738         \{\par
08739             ImGui::Checkbox({\cf22 "Auto-scroll"}, &AutoScroll);\par
08740             ImGui::EndPopup();\par
08741         \}\par
08742 \par
08743         {\cf20 // Main window}\par
08744         {\cf19 if} (ImGui::Button({\cf22 "Options"}))\par
08745             ImGui::OpenPopup({\cf22 "Options"});\par
08746         ImGui::SameLine();\par
08747         {\cf18 bool} clear = ImGui::Button({\cf22 "Clear"});\par
08748         ImGui::SameLine();\par
08749         {\cf18 bool} copy = ImGui::Button({\cf22 "Copy"});\par
08750         ImGui::SameLine();\par
08751         Filter.Draw({\cf22 "Filter"}, -100.0f);\par
08752 \par
08753         ImGui::Separator();\par
08754 \par
08755         {\cf19 if} (ImGui::BeginChild({\cf22 "scrolling"}, ImVec2(0, 0), ImGuiChildFlags_None, ImGuiWindowFlags_HorizontalScrollbar))\par
08756         \{\par
08757             {\cf19 if} (clear)\par
08758                 Clear();\par
08759             {\cf19 if} (copy)\par
08760                 ImGui::LogToClipboard();\par
08761 \par
08762             ImGui::PushStyleVar(ImGuiStyleVar_ItemSpacing, ImVec2(0, 0));\par
08763             {\cf17 const} {\cf18 char}* buf = Buf.begin();\par
08764             {\cf17 const} {\cf18 char}* buf_end = Buf.end();\par
08765             {\cf19 if} (Filter.IsActive())\par
08766             \{\par
08767                 {\cf20 // In this example we don't use the clipper when Filter is enabled.}\par
08768                 {\cf20 // This is because we don't have random access to the result of our filter.}\par
08769                 {\cf20 // A real application processing logs with ten of thousands of entries may want to store the result of}\par
08770                 {\cf20 // search/filter.. especially if the filtering function is not trivial (e.g. reg-exp).}\par
08771                 {\cf19 for} ({\cf18 int} line_no = 0; line_no < LineOffsets.Size; line_no++)\par
08772                 \{\par
08773                     {\cf17 const} {\cf18 char}* line_start = buf + LineOffsets[line_no];\par
08774                     {\cf17 const} {\cf18 char}* line_end = (line_no + 1 < LineOffsets.Size) ? (buf + LineOffsets[line_no + 1] - 1) : buf_end;\par
08775                     {\cf19 if} (Filter.PassFilter(line_start, line_end))\par
08776                         ImGui::TextUnformatted(line_start, line_end);\par
08777                 \}\par
08778             \}\par
08779             {\cf19 else}\par
08780             \{\par
08781                 {\cf20 // The simplest and easy way to display the entire buffer:}\par
08782                 {\cf20 //   ImGui::TextUnformatted(buf_begin, buf_end);}\par
08783                 {\cf20 // And it'll just work. TextUnformatted() has specialization for large blob of text and will fast-forward}\par
08784                 {\cf20 // to skip non-visible lines. Here we instead demonstrate using the clipper to only process lines that are}\par
08785                 {\cf20 // within the visible area.}\par
08786                 {\cf20 // If you have tens of thousands of items and their processing cost is non-negligible, coarse clipping them}\par
08787                 {\cf20 // on your side is recommended. Using ImGuiListClipper requires}\par
08788                 {\cf20 // - A) random access into your data}\par
08789                 {\cf20 // - B) items all being the  same height,}\par
08790                 {\cf20 // both of which we can handle since we have an array pointing to the beginning of each line of text.}\par
08791                 {\cf20 // When using the filter (in the block of code above) we don't have random access into the data to display}\par
08792                 {\cf20 // anymore, which is why we don't use the clipper. Storing or skimming through the search result would make}\par
08793                 {\cf20 // it possible (and would be recommended if you want to search through tens of thousands of entries).}\par
08794                 ImGuiListClipper clipper;\par
08795                 clipper.Begin(LineOffsets.Size);\par
08796                 {\cf19 while} (clipper.Step())\par
08797                 \{\par
08798                     {\cf19 for} ({\cf18 int} line_no = clipper.DisplayStart; line_no < clipper.DisplayEnd; line_no++)\par
08799                     \{\par
08800                         {\cf17 const} {\cf18 char}* line_start = buf + LineOffsets[line_no];\par
08801                         {\cf17 const} {\cf18 char}* line_end = (line_no + 1 < LineOffsets.Size) ? (buf + LineOffsets[line_no + 1] - 1) : buf_end;\par
08802                         ImGui::TextUnformatted(line_start, line_end);\par
08803                     \}\par
08804                 \}\par
08805                 clipper.End();\par
08806             \}\par
08807             ImGui::PopStyleVar();\par
08808 \par
08809             {\cf20 // Keep up at the bottom of the scroll region if we were already at the bottom at the beginning of the frame.}\par
08810             {\cf20 // Using a scrollbar or mouse-wheel will take away from the bottom edge.}\par
08811             {\cf19 if} (AutoScroll && ImGui::GetScrollY() >= ImGui::GetScrollMaxY())\par
08812                 ImGui::SetScrollHereY(1.0f);\par
08813         \}\par
08814         ImGui::EndChild();\par
08815         ImGui::End();\par
08816     \}\par
08817 \};\par
