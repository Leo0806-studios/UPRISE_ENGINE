03019 {\cf20 // Example: Implement dual list box storage and interface}\par
03020 {\cf17 struct }ExampleDualListBox\par
03021 \{\par
03022     ImVector<ImGuiID>           Items[2];               {\cf20 // ID is index into ExampleName[]}\par
03023     ImGuiSelectionBasicStorage  Selections[2];          {\cf20 // Store ExampleItemId into selection}\par
03024     {\cf18 bool}                        OptKeepSorted = {\cf17 true};\par
03025 \par
03026     {\cf18 void} MoveAll({\cf18 int} src, {\cf18 int} dst)\par
03027     \{\par
03028         IM_ASSERT((src == 0 && dst == 1) || (src == 1 && dst == 0));\par
03029         {\cf19 for} (ImGuiID item_id : Items[src])\par
03030             Items[dst].push_back(item_id);\par
03031         Items[src].clear();\par
03032         SortItems(dst);\par
03033         Selections[src].Swap(Selections[dst]);\par
03034         Selections[src].Clear();\par
03035     \}\par
03036     {\cf18 void} MoveSelected({\cf18 int} src, {\cf18 int} dst)\par
03037     \{\par
03038         {\cf19 for} ({\cf18 int} src_n = 0; src_n < Items[src].Size; src_n++)\par
