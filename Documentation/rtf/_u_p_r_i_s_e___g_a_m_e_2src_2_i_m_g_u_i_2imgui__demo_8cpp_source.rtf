09268         window_pos.x = (location & 1) ? (work_pos.x + work_size.x - PAD) : (work_pos.x + PAD);\par
09269         window_pos.y = (location & 2) ? (work_pos.y + work_size.y - PAD) : (work_pos.y + PAD);\par
09270         window_pos_pivot.x = (location & 1) ? 1.0f : 0.0f;\par
09271         window_pos_pivot.y = (location & 2) ? 1.0f : 0.0f;\par
