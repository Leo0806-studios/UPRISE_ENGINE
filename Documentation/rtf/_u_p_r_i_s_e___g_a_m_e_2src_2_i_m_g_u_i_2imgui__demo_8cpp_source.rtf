10286     {\cf18 void} AddItems({\cf18 int} count)\par
10287     \{\par
10288         {\cf19 if} (Items.Size == 0)\par
10289             NextItemId = 0;\par
10290         Items.reserve(Items.Size + count);\par
10291         {\cf19 for} ({\cf18 int} n = 0; n < count; n++, NextItemId++)\par
10292             Items.push_back(ExampleAsset(NextItemId, (NextItemId % 20) < 15 ? 0 : (NextItemId % 20) < 18 ? 1 : 2));\par
10293         RequestSort = {\cf17 true};\par
10294     \}\par
