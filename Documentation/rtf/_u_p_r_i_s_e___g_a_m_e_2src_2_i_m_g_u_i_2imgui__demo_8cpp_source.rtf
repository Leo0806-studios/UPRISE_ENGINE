10406 \par
10407             {\cf20 // Calculate and store start position.}\par
10408             ImVec2 start_pos = ImGui::GetCursorScreenPos();\par
10409             start_pos = ImVec2(start_pos.x + LayoutOuterPadding, start_pos.y + LayoutOuterPadding);\par
10410             ImGui::SetCursorScreenPos(start_pos);\par
10411 \par
10412             {\cf20 // Multi-select}\par
10413             ImGuiMultiSelectFlags ms_flags = ImGuiMultiSelectFlags_ClearOnEscape | ImGuiMultiSelectFlags_ClearOnClickVoid;\par
10414 \par
10415             {\cf20 // - Enable box-select (in 2D mode, so that changing box-select rectangle X1/X2 boundaries will affect clipped items)}\par
