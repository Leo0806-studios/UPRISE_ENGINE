09150 {\cf20 // [SECTION] Example App: Constrained Resize / ShowExampleAppConstrainedResize()}\par
09151 {\cf20 //-----------------------------------------------------------------------------}\par
09152 \par
09153 {\cf20 // Demonstrate creating a window with custom resize constraints.}\par
09154 {\cf20 // Note that size constraints currently don't work on a docked window (when in 'docking' branch)}\par
09155 {\cf17 static} {\cf18 void} ShowExampleAppConstrainedResize({\cf18 bool}* p_open)\par
09156 \{\par
09157     {\cf17 struct }CustomConstraints\par
09158     \{\par
09159         {\cf20 // Helper functions to demonstrate programmatic constraints}\par
09160         {\cf20 // FIXME: This doesn't take account of decoration size (e.g. title bar), library should make this easier.}\par
09161         {\cf20 // FIXME: None of the three demos works consistently when resizing from borders.}\par
09162         {\cf17 static} {\cf18 void} AspectRatio(ImGuiSizeCallbackData* data)\par
09163         \{\par
09164             {\cf18 float} aspect_ratio = *({\cf18 float}*)data->UserData;\par
09165             data->DesiredSize.y = (float)({\cf18 int})(data->DesiredSize.x / aspect_ratio);\par
09166         \}\par
09167         {\cf17 static} {\cf18 void} Square(ImGuiSizeCallbackData* data)\par
09168         \{\par
09169             data->DesiredSize.x = data->DesiredSize.y = IM_MAX(data->DesiredSize.x, data->DesiredSize.y);\par
09170         \}\par
09171         {\cf17 static} {\cf18 void} Step(ImGuiSizeCallbackData* data)\par
09172         \{\par
09173             {\cf18 float} step = *({\cf18 float}*)data->UserData;\par
09174             data->DesiredSize = ImVec2(({\cf18 int})(data->DesiredSize.x / step + 0.5f) * step, ({\cf18 int})(data->DesiredSize.y / step + 0.5f) * step);\par
09175         \}\par
09176     \};\par
09177 \par
09178     {\cf17 const} {\cf18 char}* test_desc[] =\par
09179     \{\par
09180         {\cf22 "Between 100x100 and 500x500"},\par
09181         {\cf22 "At least 100x100"},\par
09182         {\cf22 "Resize vertical + lock current width"},\par
09183         {\cf22 "Resize horizontal + lock current height"},\par
09184         {\cf22 "Width Between 400 and 500"},\par
09185         {\cf22 "Height at least 400"},\par
09186         {\cf22 "Custom: Aspect Ratio 16:9"},\par
09187         {\cf22 "Custom: Always Square"},\par
09188         {\cf22 "Custom: Fixed Steps (100)"},\par
09189     \};\par
09190 \par
09191     {\cf20 // Options}\par
09192     {\cf17 static} {\cf18 bool} auto_resize = {\cf17 false};\par
09193     {\cf17 static} {\cf18 bool} window_padding = {\cf17 true};\par
09194     {\cf17 static} {\cf18 int} type = 6; {\cf20 // Aspect Ratio}\par
09195     {\cf17 static} {\cf18 int} display_lines = 10;\par
09196 \par
09197     {\cf20 // Submit constraint}\par
09198     {\cf18 float} aspect_ratio = 16.0f / 9.0f;\par
09199     {\cf18 float} fixed_step = 100.0f;\par
09200     {\cf19 if} (type == 0) ImGui::SetNextWindowSizeConstraints(ImVec2(100, 100), ImVec2(500, 500));         {\cf20 // Between 100x100 and 500x500}\par
09201     {\cf19 if} (type == 1) ImGui::SetNextWindowSizeConstraints(ImVec2(100, 100), ImVec2(FLT_MAX, FLT_MAX)); {\cf20 // Width > 100, Height > 100}\par
09202     {\cf19 if} (type == 2) ImGui::SetNextWindowSizeConstraints(ImVec2(-1, 0),    ImVec2(-1, FLT_MAX));      {\cf20 // Resize vertical + lock current width}\par
09203     {\cf19 if} (type == 3) ImGui::SetNextWindowSizeConstraints(ImVec2(0, -1),    ImVec2(FLT_MAX, -1));      {\cf20 // Resize horizontal + lock current height}\par
09204     {\cf19 if} (type == 4) ImGui::SetNextWindowSizeConstraints(ImVec2(400, -1),  ImVec2(500, -1));          {\cf20 // Width Between and 400 and 500}\par
09205     {\cf19 if} (type == 5) ImGui::SetNextWindowSizeConstraints(ImVec2(-1, 400),  ImVec2(-1, FLT_MAX));      {\cf20 // Height at least 400}\par
09206     {\cf19 if} (type == 6) ImGui::SetNextWindowSizeConstraints(ImVec2(0, 0),     ImVec2(FLT_MAX, FLT_MAX), CustomConstraints::AspectRatio, ({\cf18 void}*)&aspect_ratio);   {\cf20 // Aspect ratio}\par
