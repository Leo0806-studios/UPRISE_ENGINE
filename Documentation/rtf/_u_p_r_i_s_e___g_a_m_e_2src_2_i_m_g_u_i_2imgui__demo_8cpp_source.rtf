05313         {\cf20 // [Method 2] Using TableNextColumn() called multiple times, instead of using a for loop + TableSetColumnIndex().}\par
05314         {\cf20 // This is generally more convenient when you have code manually submitting the contents of each column.}\par
05315         HelpMarker({\cf22 "Using TableNextRow() + calling TableNextColumn() _before_ each cell, manually."});\par
05316         {\cf19 if} (ImGui::BeginTable({\cf22 "table2"}, 3))\par
05317         \{\par
