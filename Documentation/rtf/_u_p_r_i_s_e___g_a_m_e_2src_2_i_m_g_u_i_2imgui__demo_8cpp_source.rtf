08579 \par
08580     {\cf18 int}     TextEditCallback(ImGuiInputTextCallbackData* data)\par
08581     \{\par
08582         {\cf20 //AddLog("cursor: %d, selection: %d-%d", data->CursorPos, data->SelectionStart, data->SelectionEnd);}\par
08583         {\cf19 switch} (data->EventFlag)\par
08584         \{\par
08585         {\cf19 case} ImGuiInputTextFlags_CallbackCompletion:\par
08586             \{\par
08587                 {\cf20 // Example of TEXT COMPLETION}\par
08588 \par
08589                 {\cf20 // Locate beginning of current word}\par
08590                 {\cf17 const} {\cf18 char}* word_end = data->Buf + data->CursorPos;\par
08591                 {\cf17 const} {\cf18 char}* word_start = word_end;\par
08592                 {\cf19 while} (word_start > data->Buf)\par
08593                 \{\par
08594                     {\cf17 const} {\cf18 char} c = word_start[-1];\par
08595                     {\cf19 if} (c == {\cf23 ' '} || c == {\cf23 '\\t'} || c == {\cf23 ','} || c == {\cf23 ';'})\par
08596                         {\cf19 break};\par
08597                     word_start--;\par
08598                 \}\par
08599 \par
08600                 {\cf20 // Build a list of candidates}\par
08601                 ImVector<const char*> candidates;\par
08602                 {\cf19 for} ({\cf18 int} i = 0; i < Commands.Size; i++)\par
08603                     {\cf19 if} (Strnicmp(Commands[i], word_start, ({\cf18 int})(word_end - word_start)) == 0)\par
08604                         candidates.push_back(Commands[i]);\par
08605 \par
08606                 {\cf19 if} (candidates.Size == 0)\par
08607                 \{\par
08608                     {\cf20 // No match}\par
08609                     AddLog({\cf22 "No match for \\"%.*s\\"!\\n"}, ({\cf18 int})(word_end - word_start), word_start);\par
08610                 \}\par
08611                 {\cf19 else} {\cf19 if} (candidates.Size == 1)\par
08612                 \{\par
08613                     {\cf20 // Single match. Delete the beginning of the word and replace it entirely so we've got nice casing.}\par
08614                     data->DeleteChars(({\cf18 int})(word_start - data->Buf), ({\cf18 int})(word_end - word_start));\par
08615                     data->InsertChars(data->CursorPos, candidates[0]);\par
08616                     data->InsertChars(data->CursorPos, {\cf22 " "});\par
08617                 \}\par
08618                 {\cf19 else}\par
08619                 \{\par
08620                     {\cf20 // Multiple matches. Complete as much as we can..}\par
08621                     {\cf20 // So inputing "C"+Tab will complete to "CL" then display "CLEAR" and "CLASSIFY" as matches.}\par
08622                     {\cf18 int} match_len = (int)(word_end - word_start);\par
08623                     {\cf19 for} (;;)\par
08624                     \{\par
08625                         {\cf18 int} c = 0;\par
08626                         {\cf18 bool} all_candidates_matches = {\cf17 true};\par
08627                         {\cf19 for} ({\cf18 int} i = 0; i < candidates.Size && all_candidates_matches; i++)\par
08628                             {\cf19 if} (i == 0)\par
08629                                 c = toupper(candidates[i][match_len]);\par
08630                             {\cf19 else} {\cf19 if} (c == 0 || c != toupper(candidates[i][match_len]))\par
08631                                 all_candidates_matches = {\cf17 false};\par
08632                         {\cf19 if} (!all_candidates_matches)\par
08633                             {\cf19 break};\par
08634                         match_len++;\par
08635                     \}\par
08636 \par
08637                     {\cf19 if} (match_len > 0)\par
08638                     \{\par
08639                         data->DeleteChars(({\cf18 int})(word_start - data->Buf), ({\cf18 int})(word_end - word_start));\par
08640                         data->InsertChars(data->CursorPos, candidates[0], candidates[0] + match_len);\par
08641                     \}\par
08642 \par
08643                     {\cf20 // List matches}\par
08644                     AddLog({\cf22 "Possible matches:\\n"});\par
08645                     {\cf19 for} ({\cf18 int} i = 0; i < candidates.Size; i++)\par
08646                         AddLog({\cf22 "- %s\\n"}, candidates[i]);\par
08647                 \}\par
08648 \par
08649                 {\cf19 break};\par
08650             \}\par
08651         {\cf19 case} ImGuiInputTextFlags_CallbackHistory:\par
08652             \{\par
08653                 {\cf20 // Example of HISTORY}\par
08654                 {\cf17 const} {\cf18 int} prev_history_pos = HistoryPos;\par
08655                 {\cf19 if} (data->EventKey == ImGuiKey_UpArrow)\par
08656                 \{\par
08657                     {\cf19 if} (HistoryPos == -1)\par
08658                         HistoryPos = History.Size - 1;\par
08659                     {\cf19 else} {\cf19 if} (HistoryPos > 0)\par
08660                         HistoryPos--;\par
08661                 \}\par
08662                 {\cf19 else} {\cf19 if} (data->EventKey == ImGuiKey_DownArrow)\par
08663                 \{\par
08664                     {\cf19 if} (HistoryPos != -1)\par
08665                         {\cf19 if} (++HistoryPos >= History.Size)\par
08666                             HistoryPos = -1;\par
08667                 \}\par
08668 \par
08669                 {\cf20 // A better implementation would preserve the data on the current input line along with cursor position.}\par
08670                 {\cf19 if} (prev_history_pos != HistoryPos)\par
08671                 \{\par
08672                     {\cf17 const} {\cf18 char}* history_str = (HistoryPos >= 0) ? History[HistoryPos] : {\cf22 ""};\par
08673                     data->DeleteChars(0, data->BufTextLen);\par
08674                     data->InsertChars(0, history_str);\par
08675                 \}\par
08676             \}\par
08677         \}\par
08678         {\cf19 return} 0;\par
08679     \}\par
08680 \};\par
