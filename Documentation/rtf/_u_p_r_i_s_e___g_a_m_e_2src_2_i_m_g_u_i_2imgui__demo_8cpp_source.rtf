08920 {\cf20 // Some of the interactions are a bit lack-luster:}\par
08921 {\cf20 // - We would want pressing validating or leaving the filter to somehow restore focus.}\par
08922 {\cf20 // - We may want more advanced filtering (child nodes) and clipper support: both will need extra work.}\par
08923 {\cf20 // - We would want to customize some keyboard interactions to easily keyboard navigate between the tree and the properties.}\par
08924 {\cf20 //-----------------------------------------------------------------------------}\par
08925 \par
08926 {\cf17 struct }ExampleAppPropertyEditor\par
08927 \{\par
08928     ImGuiTextFilter     Filter;\par
08929     ExampleTreeNode*    VisibleNode = NULL;\par
08930 \par
08931     {\cf18 void} Draw(ExampleTreeNode* root_node)\par
08932     \{\par
08933         {\cf20 // Left side: draw tree}\par
08934         {\cf20 // - Currently using a table to benefit from RowBg feature}\par
08935         {\cf19 if} (ImGui::BeginChild({\cf22 "##tree"}, ImVec2(300, 0), ImGuiChildFlags_ResizeX | ImGuiChildFlags_Border | ImGuiChildFlags_NavFlattened))\par
08936         \{\par
08937             ImGui::SetNextItemWidth(-FLT_MIN);\par
08938             ImGui::SetNextItemShortcut(ImGuiMod_Ctrl | ImGuiKey_F, ImGuiInputFlags_Tooltip);\par
08939             ImGui::PushItemFlag(ImGuiItemFlags_NoNavDefaultFocus, {\cf17 true});\par
08940             {\cf19 if} (ImGui::InputTextWithHint({\cf22 "##Filter"}, {\cf22 "incl,-excl"}, Filter.InputBuf, IM_ARRAYSIZE(Filter.InputBuf), ImGuiInputTextFlags_EscapeClearsAll))\par
08941                 Filter.Build();\par
08942             ImGui::PopItemFlag();\par
08943 \par
08944             {\cf19 if} (ImGui::BeginTable({\cf22 "##bg"}, 1, ImGuiTableFlags_RowBg))\par
08945             \{\par
08946                 {\cf19 for} (ExampleTreeNode* node : root_node->Childs)\par
08947                     {\cf19 if} (Filter.PassFilter(node->Name)) {\cf20 // Filter root node}\par
08948                         DrawTreeNode(node);\par
08949                 ImGui::EndTable();\par
08950             \}\par
08951         \}\par
08952         ImGui::EndChild();\par
08953 \par
08954         {\cf20 // Right side: draw properties}\par
08955         ImGui::SameLine();\par
08956 \par
08957         ImGui::BeginGroup(); {\cf20 // Lock X position}\par
08958         {\cf19 if} (ExampleTreeNode* node = VisibleNode)\par
08959         \{\par
08960             ImGui::Text({\cf22 "%s"}, node->Name);\par
08961             ImGui::TextDisabled({\cf22 "UID: 0x%08X"}, node->UID);\par
08962             ImGui::Separator();\par
08963             {\cf19 if} (ImGui::BeginTable({\cf22 "##properties"}, 2, ImGuiTableFlags_Resizable | ImGuiTableFlags_ScrollY))\par
08964             \{\par
08965                 ImGui::TableSetupColumn({\cf22 ""}, ImGuiTableColumnFlags_WidthFixed);\par
08966                 ImGui::TableSetupColumn({\cf22 ""}, ImGuiTableColumnFlags_WidthStretch, 2.0f); {\cf20 // Default twice larger}\par
08967                 {\cf19 if} (node->HasData)\par
08968                 \{\par
08969                     {\cf20 // In a typical application, the structure description would be derived from a data-driven system.}\par
08970                     {\cf20 // - We try to mimic this with our ExampleMemberInfo structure and the ExampleTreeNodeMemberInfos[] array.}\par
08971                     {\cf20 // - Limits and some details are hard-coded to simplify the demo.}\par
08972                     {\cf19 for} ({\cf17 const} ExampleMemberInfo& field_desc : ExampleTreeNodeMemberInfos)\par
08973                     \{\par
08974                         ImGui::TableNextRow();\par
08975                         ImGui::PushID(field_desc.Name);\par
08976                         ImGui::TableNextColumn();\par
08977                         ImGui::AlignTextToFramePadding();\par
08978                         ImGui::TextUnformatted(field_desc.Name);\par
08979                         ImGui::TableNextColumn();\par
08980                         {\cf18 void}* field_ptr = ({\cf18 void}*)((({\cf18 unsigned} {\cf18 char}*)node) + field_desc.Offset);\par
08981                         {\cf19 switch} (field_desc.DataType)\par
08982                         \{\par
08983                         {\cf19 case} ImGuiDataType_Bool:\par
08984                         \{\par
08985                             IM_ASSERT(field_desc.DataCount == 1);\par
08986                             ImGui::Checkbox({\cf22 "##Editor"}, ({\cf18 bool}*)field_ptr);\par
08987                             {\cf19 break};\par
08988                         \}\par
08989                         {\cf19 case} ImGuiDataType_S32:\par
08990                         \{\par
08991                             {\cf18 int} v_min = INT_MIN, v_max = INT_MAX;\par
08992                             ImGui::SetNextItemWidth(-FLT_MIN);\par
08993                             ImGui::DragScalarN({\cf22 "##Editor"}, field_desc.DataType, field_ptr, field_desc.DataCount, 1.0f, &v_min, &v_max);\par
08994                             {\cf19 break};\par
08995                         \}\par
08996                         {\cf19 case} ImGuiDataType_Float:\par
08997                         \{\par
08998                             {\cf18 float} v_min = 0.0f, v_max = 1.0f;\par
08999                             ImGui::SetNextItemWidth(-FLT_MIN);\par
09000                             ImGui::SliderScalarN({\cf22 "##Editor"}, field_desc.DataType, field_ptr, field_desc.DataCount, &v_min, &v_max);\par
09001                             {\cf19 break};\par
09002                         \}\par
09003                         \}\par
09004                         ImGui::PopID();\par
09005                     \}\par
09006                 \}\par
09007                 ImGui::EndTable();\par
09008             \}\par
09009         \}\par
09010         ImGui::EndGroup();\par
09011     \}\par
