09854 \par
09855     ExampleAppDocuments()\par
09856     \{\par
09857         Documents.push_back(MyDocument(0, {\cf22 "Lettuce"},             {\cf17 true},  ImVec4(0.4f, 0.8f, 0.4f, 1.0f)));\par
09858         Documents.push_back(MyDocument(1, {\cf22 "Eggplant"},            {\cf17 true},  ImVec4(0.8f, 0.5f, 1.0f, 1.0f)));\par
