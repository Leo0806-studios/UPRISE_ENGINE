09382 \par
09383 {\cf20 // Add a |_| looking shape}\par
09384 {\cf17 static} {\cf18 void} PathConcaveShape(ImDrawList* draw_list, {\cf18 float} x, {\cf18 float} y, {\cf18 float} sz)\par
09385 \{\par
09386     {\cf17 const} ImVec2 pos_norms[] = \{ \{ 0.0f, 0.0f \}, \{ 0.3f, 0.0f \}, \{ 0.3f, 0.7f \}, \{ 0.7f, 0.7f \}, \{ 0.7f, 0.0f \}, \{ 1.0f, 0.0f \}, \{ 1.0f, 1.0f \}, \{ 0.0f, 1.0f \} \};\par
09387     {\cf19 for} ({\cf17 const} ImVec2& p : pos_norms)\par
09388         draw_list->PathLineTo(ImVec2(x + 0.5f + (int)(sz * p.x), y + 0.5f + (int)(sz * p.y)));\par
09389 \}\par
09390 \par
09391 {\cf20 // Demonstrate using the low-level ImDrawList to draw custom shapes.}\par
09392 {\cf17 static} {\cf18 void} ShowExampleAppCustomRendering({\cf18 bool}* p_open)\par
09393 \{\par
09394     {\cf19 if} (!ImGui::Begin({\cf22 "Example: Custom rendering"}, p_open))\par
09395     \{\par
09396         ImGui::End();\par
09397         {\cf19 return};\par
09398     \}\par
09399     IMGUI_DEMO_MARKER({\cf22 "Examples/Custom Rendering"});\par
09400 \par
09401     {\cf20 // Tip: If you do a lot of custom rendering, you probably want to use your own geometrical types and benefit of}\par
09402     {\cf20 // overloaded operators, etc. Define IM_VEC2_CLASS_EXTRA in imconfig.h to create implicit conversions between your}\par
09403     {\cf20 // types and ImVec2/ImVec4. Dear ImGui defines overloaded operators but they are internal to imgui.cpp and not}\par
09404     {\cf20 // exposed outside (to avoid messing with your types) In this example we are not using the maths operators!}\par
09405 \par
09406     {\cf19 if} (ImGui::BeginTabBar({\cf22 "##TabBar"}))\par
09407     \{\par
09408         {\cf19 if} (ImGui::BeginTabItem({\cf22 "Primitives"}))\par
09409         \{\par
09410             ImGui::PushItemWidth(-ImGui::GetFontSize() * 15);\par
09411             ImDrawList* draw_list = ImGui::GetWindowDrawList();\par
09412 \par
09413             {\cf20 // Draw gradients}\par
09414             {\cf20 // (note that those are currently exacerbating our sRGB/Linear issues)}\par
09415             {\cf20 // Calling ImGui::GetColorU32() multiplies the given colors by the current Style Alpha, but you may pass the IM_COL32() directly as well..}\par
09416             ImGui::Text({\cf22 "Gradients"});\par
09417             ImVec2 gradient_size = ImVec2(ImGui::CalcItemWidth(), ImGui::GetFrameHeight());\par
09418             \{\par
09419                 ImVec2 p0 = ImGui::GetCursorScreenPos();\par
09420                 ImVec2 p1 = ImVec2(p0.x + gradient_size.x, p0.y + gradient_size.y);\par
09421                 ImU32 col_a = ImGui::GetColorU32(IM_COL32(0, 0, 0, 255));\par
09422                 ImU32 col_b = ImGui::GetColorU32(IM_COL32(255, 255, 255, 255));\par
09423                 draw_list->AddRectFilledMultiColor(p0, p1, col_a, col_b, col_b, col_a);\par
09424                 ImGui::InvisibleButton({\cf22 "##gradient1"}, gradient_size);\par
09425             \}\par
09426             \{\par
09427                 ImVec2 p0 = ImGui::GetCursorScreenPos();\par
09428                 ImVec2 p1 = ImVec2(p0.x + gradient_size.x, p0.y + gradient_size.y);\par
09429                 ImU32 col_a = ImGui::GetColorU32(IM_COL32(0, 255, 0, 255));\par
09430                 ImU32 col_b = ImGui::GetColorU32(IM_COL32(255, 0, 0, 255));\par
09431                 draw_list->AddRectFilledMultiColor(p0, p1, col_a, col_b, col_b, col_a);\par
09432                 ImGui::InvisibleButton({\cf22 "##gradient2"}, gradient_size);\par
09433             \}\par
09434 \par
09435             {\cf20 // Draw a bunch of primitives}\par
09436             ImGui::Text({\cf22 "All primitives"});\par
09437             {\cf17 static} {\cf18 float} sz = 36.0f;\par
09438             {\cf17 static} {\cf18 float} thickness = 3.0f;\par
09439             {\cf17 static} {\cf18 int} ngon_sides = 6;\par
09440             {\cf17 static} {\cf18 bool} circle_segments_override = {\cf17 false};\par
09441             {\cf17 static} {\cf18 int} circle_segments_override_v = 12;\par
09442             {\cf17 static} {\cf18 bool} curve_segments_override = {\cf17 false};\par
09443             {\cf17 static} {\cf18 int} curve_segments_override_v = 8;\par
09444             {\cf17 static} ImVec4 colf = ImVec4(1.0f, 1.0f, 0.4f, 1.0f);\par
09445             ImGui::DragFloat({\cf22 "Size"}, &sz, 0.2f, 2.0f, 100.0f, {\cf22 "%.0f"});\par
09446             ImGui::DragFloat({\cf22 "Thickness"}, &thickness, 0.05f, 1.0f, 8.0f, {\cf22 "%.02f"});\par
09447             ImGui::SliderInt({\cf22 "N-gon sides"}, &ngon_sides, 3, 12);\par
09448             ImGui::Checkbox({\cf22 "##circlesegmentoverride"}, &circle_segments_override);\par
09449             ImGui::SameLine(0.0f, ImGui::GetStyle().ItemInnerSpacing.x);\par
09450             circle_segments_override |= ImGui::SliderInt({\cf22 "Circle segments override"}, &circle_segments_override_v, 3, 40);\par
09451             ImGui::Checkbox({\cf22 "##curvessegmentoverride"}, &curve_segments_override);\par
09452             ImGui::SameLine(0.0f, ImGui::GetStyle().ItemInnerSpacing.x);\par
09453             curve_segments_override |= ImGui::SliderInt({\cf22 "Curves segments override"}, &curve_segments_override_v, 3, 40);\par
09454             ImGui::ColorEdit4({\cf22 "Color"}, &colf.x);\par
09455 \par
09456             {\cf17 const} ImVec2 p = ImGui::GetCursorScreenPos();\par
09457             {\cf17 const} ImU32 col = ImColor(colf);\par
09458             {\cf17 const} {\cf18 float} spacing = 10.0f;\par
09459             {\cf17 const} ImDrawFlags corners_tl_br = ImDrawFlags_RoundCornersTopLeft | ImDrawFlags_RoundCornersBottomRight;\par
09460             {\cf17 const} {\cf18 float} rounding = sz / 5.0f;\par
09461             {\cf17 const} {\cf18 int} circle_segments = circle_segments_override ? circle_segments_override_v : 0;\par
09462             {\cf17 const} {\cf18 int} curve_segments = curve_segments_override ? curve_segments_override_v : 0;\par
09463             {\cf17 const} ImVec2 cp3[3] = \{ ImVec2(0.0f, sz * 0.6f), ImVec2(sz * 0.5f, -sz * 0.4f), ImVec2(sz, sz) \}; {\cf20 // Control points for curves}\par
09464             {\cf17 const} ImVec2 cp4[4] = \{ ImVec2(0.0f, 0.0f), ImVec2(sz * 1.3f, sz * 0.3f), ImVec2(sz - sz * 1.3f, sz - sz * 0.3f), ImVec2(sz, sz) \};\par
09465 \par
09466             {\cf18 float} x = p.x + 4.0f;\par
09467             {\cf18 float} y = p.y + 4.0f;\par
09468             {\cf19 for} ({\cf18 int} n = 0; n < 2; n++)\par
09469             \{\par
09470                 {\cf20 // First line uses a thickness of 1.0f, second line uses the configurable thickness}\par
09471                 {\cf18 float} th = (n == 0) ? 1.0f : thickness;\par
09472                 draw_list->AddNgon(ImVec2(x + sz*0.5f, y + sz*0.5f), sz*0.5f, col, ngon_sides, th);                 x += sz + spacing;  {\cf20 // N-gon}\par
09473                 draw_list->AddCircle(ImVec2(x + sz*0.5f, y + sz*0.5f), sz*0.5f, col, circle_segments, th);          x += sz + spacing;  {\cf20 // Circle}\par
09474                 draw_list->AddEllipse(ImVec2(x + sz*0.5f, y + sz*0.5f), ImVec2(sz*0.5f, sz*0.3f), col, -0.3f, circle_segments, th); x += sz + spacing;  {\cf20 // Ellipse}\par
09475                 draw_list->AddRect(ImVec2(x, y), ImVec2(x + sz, y + sz), col, 0.0f, ImDrawFlags_None, th);          x += sz + spacing;  {\cf20 // Square}\par
09476                 draw_list->AddRect(ImVec2(x, y), ImVec2(x + sz, y + sz), col, rounding, ImDrawFlags_None, th);      x += sz + spacing;  {\cf20 // Square with all rounded corners}\par
09477                 draw_list->AddRect(ImVec2(x, y), ImVec2(x + sz, y + sz), col, rounding, corners_tl_br, th);         x += sz + spacing;  {\cf20 // Square with two rounded corners}\par
09478                 draw_list->AddTriangle(ImVec2(x+sz*0.5f,y), ImVec2(x+sz, y+sz-0.5f), ImVec2(x, y+sz-0.5f), col, th);x += sz + spacing;  {\cf20 // Triangle}\par
09479                 {\cf20 //draw_list->AddTriangle(ImVec2(x+sz*0.2f,y), ImVec2(x, y+sz-0.5f), ImVec2(x+sz*0.4f, y+sz-0.5f), col, th);x+= sz*0.4f + spacing; // Thin triangle}\par
09480                 PathConcaveShape(draw_list, x, y, sz); draw_list->PathStroke(col, ImDrawFlags_Closed, th);          x += sz + spacing;  {\cf20 // Concave Shape}\par
09481                 {\cf20 //draw_list->AddPolyline(concave_shape, IM_ARRAYSIZE(concave_shape), col, ImDrawFlags_Closed, th);}\par
09482                 draw_list->AddLine(ImVec2(x, y), ImVec2(x + sz, y), col, th);                                       x += sz + spacing;  {\cf20 // Horizontal line (note: drawing a filled rectangle will be faster!)}\par
09483                 draw_list->AddLine(ImVec2(x, y), ImVec2(x, y + sz), col, th);                                       x += spacing;       {\cf20 // Vertical line (note: drawing a filled rectangle will be faster!)}\par
09484                 draw_list->AddLine(ImVec2(x, y), ImVec2(x + sz, y + sz), col, th);                                  x += sz + spacing;  {\cf20 // Diagonal line}\par
09485 \par
09486                 {\cf20 // Path}\par
09487                 draw_list->PathArcTo(ImVec2(x + sz*0.5f, y + sz*0.5f), sz*0.5f, 3.141592f, 3.141592f * -0.5f);\par
09488                 draw_list->PathStroke(col, ImDrawFlags_None, th);\par
09489                 x += sz + spacing;\par
09490 \par
09491                 {\cf20 // Quadratic Bezier Curve (3 control points)}\par
09492                 draw_list->AddBezierQuadratic(ImVec2(x + cp3[0].x, y + cp3[0].y), ImVec2(x + cp3[1].x, y + cp3[1].y), ImVec2(x + cp3[2].x, y + cp3[2].y), col, th, curve_segments);\par
09493                 x += sz + spacing;\par
09494 \par
09495                 {\cf20 // Cubic Bezier Curve (4 control points)}\par
09496                 draw_list->AddBezierCubic(ImVec2(x + cp4[0].x, y + cp4[0].y), ImVec2(x + cp4[1].x, y + cp4[1].y), ImVec2(x + cp4[2].x, y + cp4[2].y), ImVec2(x + cp4[3].x, y + cp4[3].y), col, th, curve_segments);\par
09497 \par
09498                 x = p.x + 4;\par
09499                 y += sz + spacing;\par
09500             \}\par
09501 \par
09502             {\cf20 // Filled shapes}\par
09503             draw_list->AddNgonFilled(ImVec2(x + sz * 0.5f, y + sz * 0.5f), sz * 0.5f, col, ngon_sides);             x += sz + spacing;  {\cf20 // N-gon}\par
09504             draw_list->AddCircleFilled(ImVec2(x + sz * 0.5f, y + sz * 0.5f), sz * 0.5f, col, circle_segments);      x += sz + spacing;  {\cf20 // Circle}\par
09505             draw_list->AddEllipseFilled(ImVec2(x + sz * 0.5f, y + sz * 0.5f), ImVec2(sz * 0.5f, sz * 0.3f), col, -0.3f, circle_segments); x += sz + spacing;{\cf20 // Ellipse}\par
09506             draw_list->AddRectFilled(ImVec2(x, y), ImVec2(x + sz, y + sz), col);                                    x += sz + spacing;  {\cf20 // Square}\par
09507             draw_list->AddRectFilled(ImVec2(x, y), ImVec2(x + sz, y + sz), col, 10.0f);                             x += sz + spacing;  {\cf20 // Square with all rounded corners}\par
09508             draw_list->AddRectFilled(ImVec2(x, y), ImVec2(x + sz, y + sz), col, 10.0f, corners_tl_br);              x += sz + spacing;  {\cf20 // Square with two rounded corners}\par
09509             draw_list->AddTriangleFilled(ImVec2(x+sz*0.5f,y), ImVec2(x+sz, y+sz-0.5f), ImVec2(x, y+sz-0.5f), col);  x += sz + spacing;  {\cf20 // Triangle}\par
09510             {\cf20 //draw_list->AddTriangleFilled(ImVec2(x+sz*0.2f,y), ImVec2(x, y+sz-0.5f), ImVec2(x+sz*0.4f, y+sz-0.5f), col); x += sz*0.4f + spacing; // Thin triangle}\par
09511             PathConcaveShape(draw_list, x, y, sz); draw_list->PathFillConcave(col);                                 x += sz + spacing;  {\cf20 // Concave shape}\par
09512             draw_list->AddRectFilled(ImVec2(x, y), ImVec2(x + sz, y + thickness), col);                             x += sz + spacing;  {\cf20 // Horizontal line (faster than AddLine, but only handle integer thickness)}\par
09513             draw_list->AddRectFilled(ImVec2(x, y), ImVec2(x + thickness, y + sz), col);                             x += spacing * 2.0f;{\cf20 // Vertical line (faster than AddLine, but only handle integer thickness)}\par
09514             draw_list->AddRectFilled(ImVec2(x, y), ImVec2(x + 1, y + 1), col);                                      x += sz;            {\cf20 // Pixel (faster than AddLine)}\par
09515 \par
09516             {\cf20 // Path}\par
09517             draw_list->PathArcTo(ImVec2(x + sz * 0.5f, y + sz * 0.5f), sz * 0.5f, 3.141592f * -0.5f, 3.141592f);\par
09518             draw_list->PathFillConvex(col);\par
09519             x += sz + spacing;\par
09520 \par
