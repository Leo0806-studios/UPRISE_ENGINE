03545             {\cf17 struct }ExampleTreeFuncs\par
03546             \{\par
03547                 {\cf17 static} {\cf18 void} DrawNode(ExampleTreeNode* node, ImGuiSelectionBasicStorage* selection)\par
03548                 \{\par
03549                     ImGuiTreeNodeFlags tree_node_flags = ImGuiTreeNodeFlags_SpanAvailWidth | ImGuiTreeNodeFlags_OpenOnArrow | ImGuiTreeNodeFlags_OpenOnDoubleClick;\par
03550                     tree_node_flags |= ImGuiTreeNodeFlags_NavLeftJumpsBackHere; {\cf20 // Enable pressing left to jump to parent}\par
03551                     {\cf19 if} (node->Childs.Size == 0)\par
03552                         tree_node_flags |= ImGuiTreeNodeFlags_Bullet | ImGuiTreeNodeFlags_Leaf;\par
03553                     {\cf19 if} (selection->Contains((ImGuiID)node->UID))\par
03554                         tree_node_flags |= ImGuiTreeNodeFlags_Selected;\par
03555 \par
03556                     {\cf20 // Using SetNextItemStorageID() to specify storage id, so we can easily peek into}\par
03557                     {\cf20 // the storage holding open/close stage, using our TreeNodeGetOpen/TreeNodeSetOpen() functions.}\par
03558                     ImGui::SetNextItemSelectionUserData((ImGuiSelectionUserData)(intptr_t)node);\par
03559                     ImGui::SetNextItemStorageID((ImGuiID)node->UID);\par
03560                     {\cf19 if} (ImGui::TreeNodeEx(node->Name, tree_node_flags))\par
03561                     \{\par
03562                         {\cf19 for} (ExampleTreeNode* child : node->Childs)\par
03563                             DrawNode(child, selection);\par
03564                         ImGui::TreePop();\par
03565                     \}\par
03566                     {\cf19 else} {\cf19 if} (ImGui::IsItemToggledOpen())\par
03567                     \{\par
03568                         TreeCloseAndUnselectChildNodes(node, selection);\par
03569                     \}\par
03570                 \}\par
03571 \par
03572                 {\cf17 static} {\cf18 bool} TreeNodeGetOpen(ExampleTreeNode* node)\par
03573                 \{\par
03574                     {\cf19 return} ImGui::GetStateStorage()->GetBool((ImGuiID)node->UID);\par
03575                 \}\par
03576 \par
03577                 {\cf17 static} {\cf18 void} TreeNodeSetOpen(ExampleTreeNode* node, {\cf18 bool} open)\par
03578                 \{\par
03579                     ImGui::GetStateStorage()->SetBool((ImGuiID)node->UID, open);\par
03580                 \}\par
03581 \par
03582                 {\cf20 // When closing a node: 1) close and unselect all child nodes, 2) select parent if any child was selected.}\par
03583                 {\cf20 // FIXME: This is currently handled by user logic but I'm hoping to eventually provide tree node}\par
03584                 {\cf20 // features to do this automatically, e.g. a ImGuiTreeNodeFlags_AutoCloseChildNodes etc.}\par
03585                 {\cf17 static} {\cf18 int} TreeCloseAndUnselectChildNodes(ExampleTreeNode* node, ImGuiSelectionBasicStorage* selection, {\cf18 int} depth = 0)\par
03586                 \{\par
03587                     {\cf20 // Recursive close (the test for depth == 0 is because we call this on a node that was just closed!)}\par
03588                     {\cf18 int} unselected_count = selection->Contains((ImGuiID)node->UID) ? 1 : 0;\par
03589                     {\cf19 if} (depth == 0 || TreeNodeGetOpen(node))\par
03590                     \{\par
03591                         {\cf19 for} (ExampleTreeNode* child : node->Childs)\par
03592                             unselected_count += TreeCloseAndUnselectChildNodes(child, selection, depth + 1);\par
03593                         TreeNodeSetOpen(node, {\cf17 false});\par
03594                     \}\par
03595 \par
03596                     {\cf20 // Select root node if any of its child was selected, otherwise unselect}\par
03597                     selection->SetItemSelected((ImGuiID)node->UID, (depth == 0 && unselected_count > 0));\par
03598                     {\cf19 return} unselected_count;\par
03599                 \}\par
03600 \par
03601                 {\cf20 // Apply multi-selection requests}\par
03602                 {\cf17 static} {\cf18 void} ApplySelectionRequests(ImGuiMultiSelectIO* ms_io, ExampleTreeNode* tree, ImGuiSelectionBasicStorage* selection)\par
03603                 \{\par
03604                     {\cf19 for} (ImGuiSelectionRequest& req : ms_io->Requests)\par
03605                     \{\par
03606                         {\cf19 if} (req.Type == ImGuiSelectionRequestType_SetAll)\par
03607                         \{\par
03608                             {\cf19 if} (req.Selected)\par
03609                                 TreeSetAllInOpenNodes(tree, selection, req.Selected);\par
03610                             {\cf19 else}\par
03611                                 selection->Clear();\par
03612                         \}\par
03613                         {\cf19 else} {\cf19 if} (req.Type == ImGuiSelectionRequestType_SetRange)\par
03614                         \{\par
03615                             ExampleTreeNode* first_node = (ExampleTreeNode*)(intptr_t)req.RangeFirstItem;\par
03616                             ExampleTreeNode* last_node = (ExampleTreeNode*)(intptr_t)req.RangeLastItem;\par
03617                             {\cf19 for} (ExampleTreeNode* node = first_node; node != NULL; node = TreeGetNextNodeInVisibleOrder(node, last_node))\par
03618                                 selection->SetItemSelected((ImGuiID)node->UID, req.Selected);\par
03619                         \}\par
03620                     \}\par
03621                 \}\par
03622 \par
03623                 {\cf17 static} {\cf18 void} TreeSetAllInOpenNodes(ExampleTreeNode* node, ImGuiSelectionBasicStorage* selection, {\cf18 bool} selected)\par
03624                 \{\par
03625                     {\cf19 if} (node->Parent != NULL) {\cf20 // Root node isn't visible nor selectable in our scheme}\par
03626                         selection->SetItemSelected((ImGuiID)node->UID, selected);\par
03627                     {\cf19 if} (node->Parent == NULL || TreeNodeGetOpen(node))\par
03628                         {\cf19 for} (ExampleTreeNode* child : node->Childs)\par
03629                             TreeSetAllInOpenNodes(child, selection, selected);\par
03630                 \}\par
03631 \par
03632                 {\cf20 // Interpolate in *user-visible order* AND only *over opened nodes*.}\par
03633                 {\cf20 // If you have a sequential mapping tables (e.g. generated after a filter/search pass) this would be simpler.}\par
03634                 {\cf20 // Here the tricks are that:}\par
03635                 {\cf20 // - we store/maintain ExampleTreeNode::IndexInParent which allows implementing a linear iterator easily, without searches, without recursion.}\par
03636                 {\cf20 //   this could be replaced by a search in parent, aka 'int index_in_parent = curr_node->Parent->Childs.find_index(curr_node)'}\par
03637                 {\cf20 //   which would only be called when crossing from child to a parent, aka not too much.}\par
03638                 {\cf20 // - we call SetNextItemStorageID() before our TreeNode() calls with an ID which doesn't relate to UI stack,}\par
03639                 {\cf20 //   making it easier to call TreeNodeGetOpen()/TreeNodeSetOpen() from any location.}\par
03640                 {\cf17 static} ExampleTreeNode* TreeGetNextNodeInVisibleOrder(ExampleTreeNode* curr_node, ExampleTreeNode* last_node)\par
03641                 \{\par
03642                     {\cf20 // Reached last node}\par
03643                     {\cf19 if} (curr_node == last_node)\par
03644                         {\cf19 return} NULL;\par
03645 \par
03646                     {\cf20 // Recurse into childs. Query storage to tell if the node is open.}\par
03647                     {\cf19 if} (curr_node->Childs.Size > 0 && TreeNodeGetOpen(curr_node))\par
03648                         {\cf19 return} curr_node->Childs[0];\par
03649 \par
03650                     {\cf20 // Next sibling, then into our own parent}\par
03651                     {\cf19 while} (curr_node->Parent != NULL)\par
03652                     \{\par
03653                         {\cf19 if} (curr_node->IndexInParent + 1 < curr_node->Parent->Childs.Size)\par
03654                             {\cf19 return} curr_node->Parent->Childs[curr_node->IndexInParent + 1];\par
03655                         curr_node = curr_node->Parent;\par
03656                     \}\par
03657                     {\cf19 return} NULL;\par
03658                 \}\par
03659 \par
