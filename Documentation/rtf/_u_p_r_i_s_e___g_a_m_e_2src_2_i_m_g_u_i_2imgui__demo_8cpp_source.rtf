09825 {\cf20 // Simplified structure to mimic a Document model}\par
09826 {\cf17 struct }MyDocument\par
09827 \{\par
09828     {\cf18 char}        Name[32];   {\cf20 // Document title}\par
09829     {\cf18 int}         UID;        {\cf20 // Unique ID (necessary as we can change title)}\par
09830     {\cf18 bool}        Open;       {\cf20 // Set when open (we keep an array of all available documents to simplify demo code!)}\par
09831     {\cf18 bool}        OpenPrev;   {\cf20 // Copy of Open from last update.}\par
09832     {\cf18 bool}        Dirty;      {\cf20 // Set when the document has been modified}\par
09833     ImVec4      Color;      {\cf20 // An arbitrary variable associated to the document}\par
09834 \par
09835     MyDocument({\cf18 int} uid, {\cf17 const} {\cf18 char}* name, {\cf18 bool} open = {\cf17 true}, {\cf17 const} ImVec4& color = ImVec4(1.0f, 1.0f, 1.0f, 1.0f))\par
09836     \{\par
09837         UID = uid;\par
09838         snprintf(Name, {\cf17 sizeof}(Name), {\cf22 "%s"}, name);\par
09839         Open = OpenPrev = open;\par
09840         Dirty = {\cf17 false};\par
09841         Color = color;\par
09842     \}\par
09843     {\cf18 void} DoOpen()       \{ Open = {\cf17 true}; \}\par
09844     {\cf18 void} DoForceClose() \{ Open = {\cf17 false}; Dirty = {\cf17 false}; \}\par
09845     {\cf18 void} DoSave()       \{ Dirty = {\cf17 false}; \}\par
09846 \};\par
09847 \par
09848 {\cf17 struct }ExampleAppDocuments\par
09849 \{\par
09850     ImVector<MyDocument>    Documents;\par
09851     ImVector<MyDocument*>   CloseQueue;\par
