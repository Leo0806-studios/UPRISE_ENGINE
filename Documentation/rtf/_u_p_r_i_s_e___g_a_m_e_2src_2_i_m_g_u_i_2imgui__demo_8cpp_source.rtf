09996     {\cf20 // [Debug] List documents with one checkbox for each}\par
09997     {\cf19 for} ({\cf18 int} doc_n = 0; doc_n < app.Documents.Size; doc_n++)\par
09998     \{\par
09999         MyDocument& doc = app.Documents[doc_n];\par
10000         {\cf19 if} (doc_n > 0)\par
10001             ImGui::SameLine();\par
10002         ImGui::PushID(&doc);\par
10003         {\cf19 if} (ImGui::Checkbox(doc.Name, &doc.Open))\par
