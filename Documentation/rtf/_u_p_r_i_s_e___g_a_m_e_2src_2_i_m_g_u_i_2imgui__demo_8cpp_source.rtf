10397 \par
10398         ImGuiIO& io = ImGui::GetIO();\par
10399         ImGui::SetNextWindowContentSize(ImVec2(0.0f, LayoutOuterPadding + LayoutLineCount * (LayoutItemSize.x + LayoutItemSpacing)));\par
10400         {\cf19 if} (ImGui::BeginChild({\cf22 "Assets"}, ImVec2(0.0f, -ImGui::GetTextLineHeightWithSpacing()), ImGuiChildFlags_Border, ImGuiWindowFlags_NoMove))\par
10401         \{\par
10402             ImDrawList* draw_list = ImGui::GetWindowDrawList();\par
10403 \par
10404             {\cf17 const} {\cf18 float} avail_width = ImGui::GetContentRegionAvail().x;\par
