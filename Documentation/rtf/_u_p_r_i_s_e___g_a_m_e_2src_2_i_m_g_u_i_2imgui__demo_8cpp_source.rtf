10261     {\cf18 int}             IconHitSpacing = 4;         {\cf20 // Increase hit-spacing if you want to make it possible to clear or box-select from gaps. Some spacing is required to able to amend with Shift+box-select. Value is small in Explorer.}\par
10262     {\cf18 bool}            StretchSpacing = {\cf17 true};\par
