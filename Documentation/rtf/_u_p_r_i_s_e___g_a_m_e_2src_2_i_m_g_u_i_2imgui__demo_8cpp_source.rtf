00320 {\cf20 // Create example tree data}\par
00321 {\cf20 // (this allocates _many_ more times than most other code in either Dear ImGui or others demo)}\par
00322 {\cf17 static} ExampleTreeNode* ExampleTree_CreateDemoTree()\par
00323 \{\par
00324     {\cf17 static} {\cf17 const} {\cf18 char}* root_names[] = \{ {\cf22 "Apple"}, {\cf22 "Banana"}, {\cf22 "Cherry"}, {\cf22 "Kiwi"}, {\cf22 "Mango"}, {\cf22 "Orange"}, {\cf22 "Pear"}, {\cf22 "Pineapple"}, {\cf22 "Strawberry"}, {\cf22 "Watermelon"} \};\par
00325     {\cf18 char} name_buf[32];\par
00326     {\cf18 int} uid = 0;\par
00327     ExampleTreeNode* node_L0 = ExampleTree_CreateNode({\cf22 "<ROOT>"}, ++uid, NULL);\par
00328     {\cf17 const} {\cf18 int} root_items_multiplier = 2;\par
00329     {\cf19 for} ({\cf18 int} idx_L0 = 0; idx_L0 < IM_ARRAYSIZE(root_names) * root_items_multiplier; idx_L0++)\par
00330     \{\par
00331         snprintf(name_buf, 32, {\cf22 "%s %d"}, root_names[idx_L0 / root_items_multiplier], idx_L0 % root_items_multiplier);\par
00332         ExampleTreeNode* node_L1 = ExampleTree_CreateNode(name_buf, ++uid, node_L0);\par
00333         {\cf17 const} {\cf18 int} number_of_childs = (int)strlen(node_L1->Name);\par
00334         {\cf19 for} ({\cf18 int} idx_L1 = 0; idx_L1 < number_of_childs; idx_L1++)\par
00335         \{\par
00336             snprintf(name_buf, 32, {\cf22 "Child %d"}, idx_L1);\par
00337             ExampleTreeNode* node_L2 = ExampleTree_CreateNode(name_buf, ++uid, node_L1);\par
00338             node_L2->HasData = {\cf17 true};\par
00339             {\cf19 if} (idx_L1 == 0)\par
00340             \{\par
00341                 snprintf(name_buf, 32, {\cf22 "Sub-child %d"}, 0);\par
00342                 ExampleTreeNode* node_L3 = ExampleTree_CreateNode(name_buf, ++uid, node_L2);\par
00343                 node_L3->HasData = {\cf17 true};\par
00344             \}\par
00345         \}\par
00346     \}\par
00347     {\cf19 return} node_L0;\par
00348 \}\par
