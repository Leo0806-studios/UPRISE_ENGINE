10091 \par
10092                 {\cf20 // Cancel attempt to close when unsaved add to save queue so we can display a popup.}\par
10093                 {\cf19 if} (!doc->Open && doc->Dirty)\par
10094                 \{\par
10095                     doc->Open = {\cf17 true};\par
