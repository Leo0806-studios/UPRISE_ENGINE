00152 {\cf18 void} ImGui::TextEx({\cf17 const} {\cf18 char}* text, {\cf17 const} {\cf18 char}* text_end, ImGuiTextFlags flags)\par
00153 \{\par
00154     ImGuiWindow* window = GetCurrentWindow();\par
00155     {\cf19 if} (window->SkipItems)\par
00156         {\cf19 return};\par
00157     ImGuiContext& g = *GImGui;\par
00158 \par
00159     {\cf20 // Accept null ranges}\par
00160     {\cf19 if} (text == text_end)\par
00161         text = text_end = {\cf22 ""};\par
00162 \par
00163     {\cf20 // Calculate length}\par
00164     {\cf17 const} {\cf18 char}* text_begin = text;\par
00165     {\cf19 if} (text_end == NULL)\par
00166         text_end = text + strlen(text); {\cf20 // FIXME-OPT}\par
00167 \par
00168     {\cf17 const} ImVec2 text_pos(window->DC.CursorPos.x, window->DC.CursorPos.y + window->DC.CurrLineTextBaseOffset);\par
00169     {\cf17 const} {\cf18 float} wrap_pos_x = window->DC.TextWrapPos;\par
00170     {\cf17 const} {\cf18 bool} wrap_enabled = (wrap_pos_x >= 0.0f);\par
00171     {\cf19 if} (text_end - text <= 2000 || wrap_enabled)\par
00172     \{\par
00173         {\cf20 // Common case}\par
00174         {\cf17 const} {\cf18 float} wrap_width = wrap_enabled ? CalcWrapWidthForPos(window->DC.CursorPos, wrap_pos_x) : 0.0f;\par
00175         {\cf17 const} ImVec2 text_size = CalcTextSize(text_begin, text_end, {\cf17 false}, wrap_width);\par
00176 \par
00177         ImRect bb(text_pos, text_pos + text_size);\par
00178         ItemSize(text_size, 0.0f);\par
00179         {\cf19 if} (!ItemAdd(bb, 0))\par
00180             {\cf19 return};\par
00181 \par
00182         {\cf20 // Render (we don't hide text after ## in this end-user function)}\par
00183         RenderTextWrapped(bb.Min, text_begin, text_end, wrap_width);\par
00184     \}\par
00185     {\cf19 else}\par
00186     \{\par
00187         {\cf20 // Long text!}\par
00188         {\cf20 // Perform manual coarse clipping to optimize for long multi-line text}\par
00189         {\cf20 // - From this point we will only compute the width of lines that are visible. Optimization only available when word-wrapping is disabled.}\par
00190         {\cf20 // - We also don't vertically center the text within the line full height, which is unlikely to matter because we are likely the biggest and only item on the line.}\par
00191         {\cf20 // - We use memchr(), pay attention that well optimized versions of those str/mem functions are much faster than a casually written loop.}\par
00192         {\cf17 const} {\cf18 char}* line = text;\par
00193         {\cf17 const} {\cf18 float} line_height = GetTextLineHeight();\par
00194         ImVec2 text_size(0, 0);\par
00195 \par
00196         {\cf20 // Lines to skip (can't skip when logging text)}\par
00197         ImVec2 pos = text_pos;\par
00198         {\cf19 if} (!g.LogEnabled)\par
00199         \{\par
00200             {\cf18 int} lines_skippable = (int)((window->ClipRect.Min.y - text_pos.y) / line_height);\par
00201             {\cf19 if} (lines_skippable > 0)\par
00202             \{\par
00203                 {\cf18 int} lines_skipped = 0;\par
00204                 {\cf19 while} (line < text_end && lines_skipped < lines_skippable)\par
00205                 \{\par
00206                     {\cf17 const} {\cf18 char}* line_end = ({\cf17 const} {\cf18 char}*)memchr(line, {\cf23 '\\n'}, text_end - line);\par
00207                     {\cf19 if} (!line_end)\par
00208                         line_end = text_end;\par
00209                     {\cf19 if} ((flags & ImGuiTextFlags_NoWidthForLargeClippedText) == 0)\par
00210                         text_size.x = ImMax(text_size.x, CalcTextSize(line, line_end).x);\par
00211                     line = line_end + 1;\par
00212                     lines_skipped++;\par
00213                 \}\par
00214                 pos.y += lines_skipped * line_height;\par
00215             \}\par
00216         \}\par
00217 \par
00218         {\cf20 // Lines to render}\par
00219         {\cf19 if} (line < text_end)\par
00220         \{\par
00221             ImRect line_rect(pos, pos + ImVec2(FLT_MAX, line_height));\par
00222             {\cf19 while} (line < text_end)\par
00223             \{\par
00224                 {\cf19 if} (IsClippedEx(line_rect, 0))\par
00225                     {\cf19 break};\par
00226 \par
00227                 {\cf17 const} {\cf18 char}* line_end = ({\cf17 const} {\cf18 char}*)memchr(line, {\cf23 '\\n'}, text_end - line);\par
00228                 {\cf19 if} (!line_end)\par
00229                     line_end = text_end;\par
00230                 text_size.x = ImMax(text_size.x, CalcTextSize(line, line_end).x);\par
00231                 RenderText(pos, line, line_end, {\cf17 false});\par
00232                 line = line_end + 1;\par
00233                 line_rect.Min.y += line_height;\par
00234                 line_rect.Max.y += line_height;\par
00235                 pos.y += line_height;\par
00236             \}\par
00237 \par
00238             {\cf20 // Count remaining lines}\par
00239             {\cf18 int} lines_skipped = 0;\par
00240             {\cf19 while} (line < text_end)\par
00241             \{\par
00242                 {\cf17 const} {\cf18 char}* line_end = ({\cf17 const} {\cf18 char}*)memchr(line, {\cf23 '\\n'}, text_end - line);\par
00243                 {\cf19 if} (!line_end)\par
00244                     line_end = text_end;\par
00245                 {\cf19 if} ((flags & ImGuiTextFlags_NoWidthForLargeClippedText) == 0)\par
00246                     text_size.x = ImMax(text_size.x, CalcTextSize(line, line_end).x);\par
00247                 line = line_end + 1;\par
00248                 lines_skipped++;\par
00249             \}\par
00250             pos.y += lines_skipped * line_height;\par
00251         \}\par
00252         text_size.y = (pos - text_pos).y;\par
00253 \par
00254         ImRect bb(text_pos, text_pos + text_size);\par
00255         ItemSize(text_size, 0.0f);\par
00256         ItemAdd(bb, 0);\par
00257     \}\par
00258 \}\par
