00355     {\cf17 const} ImVec2 value_size = CalcTextSize(value_text_begin, value_text_end, {\cf17 false});\par
00356     {\cf17 const} ImVec2 label_size = CalcTextSize(label, NULL, {\cf17 true});\par
00357 \par
00358     {\cf17 const} ImVec2 pos = window->DC.CursorPos;\par
00359     {\cf17 const} ImRect value_bb(pos, pos + ImVec2(w, value_size.y + style.FramePadding.y * 2));\par
00360     {\cf17 const} ImRect total_bb(pos, pos + ImVec2(w + (label_size.x > 0.0f ? style.ItemInnerSpacing.x + label_size.x : 0.0f), ImMax(value_size.y, label_size.y) + style.FramePadding.y * 2));\par
00361     ItemSize(total_bb, style.FramePadding.y);\par
00362     {\cf19 if} (!ItemAdd(total_bb, 0))\par
00363         {\cf19 return};\par
00364 \par
00365     {\cf20 // Render}\par
00366     RenderTextClipped(value_bb.Min + style.FramePadding, value_bb.Max, value_text_begin, value_text_end, &value_size, ImVec2(0.0f, 0.0f));\par
00367     {\cf19 if} (label_size.x > 0.0f)\par
00368         RenderText(ImVec2(value_bb.Max.x + style.ItemInnerSpacing.x, value_bb.Min.y + style.FramePadding.y), label);\par
