09557 {\cf17 static} {\cf18 float} ImGui::TabBarScrollClamp(ImGuiTabBar* tab_bar, {\cf18 float} scrolling)\par
09558 \{\par
09559     scrolling = ImMin(scrolling, tab_bar->WidthAllTabs - tab_bar->BarRect.GetWidth());\par
09560     {\cf19 return} ImMax(scrolling, 0.0f);\par
09561 \}\par
09562 \par
09563 {\cf20 // Note: we may scroll to tab that are not selected! e.g. using keyboard arrow keys}\par
09564 {\cf17 static} {\cf18 void} ImGui::TabBarScrollToTab(ImGuiTabBar* tab_bar, ImGuiID tab_id, ImGuiTabBarSection* sections)\par
09565 \{\par
09566     ImGuiTabItem* tab = TabBarFindTabByID(tab_bar, tab_id);\par
09567     {\cf19 if} (tab == NULL)\par
09568         {\cf19 return};\par
09569     {\cf19 if} (tab->Flags & ImGuiTabItemFlags_SectionMask_)\par
09570         {\cf19 return};\par
09571 \par
09572     ImGuiContext& g = *GImGui;\par
09573     {\cf18 float} margin = g.FontSize * 1.0f; {\cf20 // When to scroll to make Tab N+1 visible always make a bit of N visible to suggest more scrolling area (since we don't have a scrollbar)}\par
09574     {\cf18 int} order = TabBarGetTabOrder(tab_bar, tab);\par
09575 \par
09576     {\cf20 // Scrolling happens only in the central section (leading/trailing sections are not scrolling)}\par
09577     {\cf18 float} scrollable_width = TabBarCalcScrollableWidth(tab_bar, sections);\par
09578 \par
09579     {\cf20 // We make all tabs positions all relative Sections[0].Width to make code simpler}\par
09580     {\cf18 float} tab_x1 = tab->Offset - sections[0].Width + (order > sections[0].TabCount - 1 ? -margin : 0.0f);\par
09581     {\cf18 float} tab_x2 = tab->Offset - sections[0].Width + tab->Width + (order + 1 < tab_bar->Tabs.Size - sections[2].TabCount ? margin : 1.0f);\par
09582     tab_bar->ScrollingTargetDistToVisibility = 0.0f;\par
09583     {\cf19 if} (tab_bar->ScrollingTarget > tab_x1 || (tab_x2 - tab_x1 >= scrollable_width))\par
09584     \{\par
09585         {\cf20 // Scroll to the left}\par
09586         tab_bar->ScrollingTargetDistToVisibility = ImMax(tab_bar->ScrollingAnim - tab_x2, 0.0f);\par
09587         tab_bar->ScrollingTarget = tab_x1;\par
09588     \}\par
09589     {\cf19 else} {\cf19 if} (tab_bar->ScrollingTarget < tab_x2 - scrollable_width)\par
09590     \{\par
09591         {\cf20 // Scroll to the right}\par
09592         tab_bar->ScrollingTargetDistToVisibility = ImMax((tab_x1 - scrollable_width) - tab_bar->ScrollingAnim, 0.0f);\par
09593         tab_bar->ScrollingTarget = tab_x2 - scrollable_width;\par
09594     \}\par
09595 \}\par
