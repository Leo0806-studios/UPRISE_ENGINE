05561     \}\par
05562 \par
05563     {\cf20 // When picker is being actively used, use its active id so IsItemActive() will function on ColorEdit4().}\par
05564     {\cf19 if} (picker_active_window && g.ActiveId != 0 && g.ActiveIdWindow == picker_active_window)\par
