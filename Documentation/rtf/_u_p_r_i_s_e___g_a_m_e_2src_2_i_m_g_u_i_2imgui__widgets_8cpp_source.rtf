02892 {\cf20 // Convert a parametric position on a slider into a value v in the output space (the logical opposite of ScaleRatioFromValueT)}\par
02893 {\cf17 template}<{\cf17 typename} TYPE, {\cf17 typename} SIGNEDTYPE, {\cf17 typename} FLOATTYPE>\par
02894 TYPE ImGui::ScaleValueFromRatioT(ImGuiDataType data_type, {\cf18 float} t, TYPE v_min, TYPE v_max, {\cf18 bool} is_logarithmic, {\cf18 float} logarithmic_zero_epsilon, {\cf18 float} zero_deadzone_halfsize)\par
02895 \{\par
02896     {\cf20 // We special-case the extents because otherwise our logarithmic fudging can lead to "mathematically correct"}\par
02897     {\cf20 // but non-intuitive behaviors like a fully-left slider not actually reaching the minimum value. Also generally simpler.}\par
02898     {\cf19 if} (t <= 0.0f || v_min == v_max)\par
02899         {\cf19 return} v_min;\par
02900     {\cf19 if} (t >= 1.0f)\par
02901         {\cf19 return} v_max;\par
02902 \par
02903     TYPE result = (TYPE)0;\par
02904     {\cf19 if} (is_logarithmic)\par
02905     \{\par
02906         {\cf20 // Fudge min/max to avoid getting silly results close to zero}\par
02907         FLOATTYPE v_min_fudged = (ImAbs((FLOATTYPE)v_min) < logarithmic_zero_epsilon) ? ((v_min < 0.0f) ? -logarithmic_zero_epsilon : logarithmic_zero_epsilon) : (FLOATTYPE)v_min;\par
02908         FLOATTYPE v_max_fudged = (ImAbs((FLOATTYPE)v_max) < logarithmic_zero_epsilon) ? ((v_max < 0.0f) ? -logarithmic_zero_epsilon : logarithmic_zero_epsilon) : (FLOATTYPE)v_max;\par
02909 \par
02910         {\cf17 const} {\cf18 bool} flipped = v_max < v_min; {\cf20 // Check if range is "backwards"}\par
02911         {\cf19 if} (flipped)\par
02912             ImSwap(v_min_fudged, v_max_fudged);\par
02913 \par
02914         {\cf20 // Awkward special case - we need ranges of the form (-100 .. 0) to convert to (-100 .. -epsilon), not (-100 .. epsilon)}\par
02915         {\cf19 if} ((v_max == 0.0f) && (v_min < 0.0f))\par
02916             v_max_fudged = -logarithmic_zero_epsilon;\par
02917 \par
02918         {\cf18 float} t_with_flip = flipped ? (1.0f - t) : t; {\cf20 // t, but flipped if necessary to account for us flipping the range}\par
02919 \par
02920         {\cf19 if} ((v_min * v_max) < 0.0f) {\cf20 // Range crosses zero, so we have to do this in two parts}\par
02921         \{\par
02922             {\cf18 float} zero_point_center = (-(float)ImMin(v_min, v_max)) / ImAbs(({\cf18 float})v_max - (float)v_min); {\cf20 // The zero point in parametric space}\par
02923             {\cf18 float} zero_point_snap_L = zero_point_center - zero_deadzone_halfsize;\par
02924             {\cf18 float} zero_point_snap_R = zero_point_center + zero_deadzone_halfsize;\par
02925             {\cf19 if} (t_with_flip >= zero_point_snap_L && t_with_flip <= zero_point_snap_R)\par
02926                 result = (TYPE)0.0f; {\cf20 // Special case to make getting exactly zero possible (the epsilon prevents it otherwise)}\par
02927             {\cf19 else} {\cf19 if} (t_with_flip < zero_point_center)\par
02928                 result = (TYPE)-(logarithmic_zero_epsilon * ImPow(-v_min_fudged / logarithmic_zero_epsilon, (FLOATTYPE)(1.0f - (t_with_flip / zero_point_snap_L))));\par
02929             {\cf19 else}\par
02930                 result = (TYPE)(logarithmic_zero_epsilon * ImPow(v_max_fudged / logarithmic_zero_epsilon, (FLOATTYPE)((t_with_flip - zero_point_snap_R) / (1.0f - zero_point_snap_R))));\par
02931         \}\par
02932         {\cf19 else} {\cf19 if} ((v_min < 0.0f) || (v_max < 0.0f)) {\cf20 // Entirely negative slider}\par
02933             result = (TYPE)-(-v_max_fudged * ImPow(-v_min_fudged / -v_max_fudged, (FLOATTYPE)(1.0f - t_with_flip)));\par
02934         {\cf19 else}\par
02935             result = (TYPE)(v_min_fudged * ImPow(v_max_fudged / v_min_fudged, (FLOATTYPE)t_with_flip));\par
02936     \}\par
02937     {\cf19 else}\par
02938     \{\par
02939         {\cf20 // Linear slider}\par
02940         {\cf17 const} {\cf18 bool} is_floating_point = (data_type == ImGuiDataType_Float) || (data_type == ImGuiDataType_Double);\par
02941         {\cf19 if} (is_floating_point)\par
02942         \{\par
02943             result = ImLerp(v_min, v_max, t);\par
02944         \}\par
02945         {\cf19 else} {\cf19 if} (t < 1.0)\par
02946         \{\par
02947             {\cf20 // - For integer values we want the clicking position to match the grab box so we round above}\par
02948             {\cf20 //   This code is carefully tuned to work with large values (e.g. high ranges of U64) while preserving this property..}\par
02949             {\cf20 // - Not doing a *1.0 multiply at the end of a range as it tends to be lossy. While absolute aiming at a large s64/u64}\par
02950             {\cf20 //   range is going to be imprecise anyway, with this check we at least make the edge values matches expected limits.}\par
02951             FLOATTYPE v_new_off_f = (SIGNEDTYPE)(v_max - v_min) * t;\par
02952             result = (TYPE)((SIGNEDTYPE)v_min + (SIGNEDTYPE)(v_new_off_f + (FLOATTYPE)(v_min > v_max ? -0.5 : 0.5)));\par
02953         \}\par
02954     \}\par
02955 \par
02956     {\cf19 return} result;\par
02957 \}\par
