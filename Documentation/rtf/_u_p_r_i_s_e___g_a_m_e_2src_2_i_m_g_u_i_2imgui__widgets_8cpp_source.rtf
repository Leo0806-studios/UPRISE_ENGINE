00343 {\cf18 void} ImGui::LabelTextV({\cf17 const} {\cf18 char}* label, {\cf17 const} {\cf18 char}* fmt, va_list args)\par
00344 \{\par
00345     ImGuiWindow* window = GetCurrentWindow();\par
00346     {\cf19 if} (window->SkipItems)\par
