07935 {\cf20 // GetNextSelectedItem() is an abstraction allowing us to change our underlying actual storage system without impacting user.}\par
07936 {\cf20 // (e.g. store unselected vs compact down, compact down on demand, use raw ImVector<ImGuiID> instead of ImGuiStorage...)}\par
07937 {\cf18 bool} ImGuiSelectionBasicStorage::GetNextSelectedItem({\cf18 void}** opaque_it, ImGuiID* out_id)\par
07938 \{\par
07939     ImGuiStoragePair* it = (ImGuiStoragePair*)*opaque_it;\par
07940     ImGuiStoragePair* it_end = _Storage.Data.Data + _Storage.Data.Size;\par
07941     {\cf19 if} (PreserveOrder && it == NULL && it_end != NULL)\par
07942         ImQsort(_Storage.Data.Data, ({\cf18 size_t})_Storage.Data.Size, {\cf17 sizeof}(ImGuiStoragePair), PairComparerByValueInt); {\cf20 // ~ImGuiStorage::BuildSortByValueInt()}\par
07943     {\cf19 if} (it == NULL)\par
07944         it = _Storage.Data.Data;\par
07945     IM_ASSERT(it >= _Storage.Data.Data && it <= it_end);\par
07946     {\cf19 if} (it != it_end)\par
07947         {\cf19 while} (it->val_i == 0 && it < it_end)\par
07948             it++;\par
07949     {\cf17 const} {\cf18 bool} has_more = (it != it_end);\par
07950     *opaque_it = has_more ? ({\cf18 void}**)(it + 1) : (void**)(it);\par
07951     *out_id = has_more ? it->key : 0;\par
07952     {\cf19 if} (PreserveOrder && !has_more)\par
07953         _Storage.BuildSortByKey();\par
07954     {\cf19 return} has_more;\par
07955 \}\par
