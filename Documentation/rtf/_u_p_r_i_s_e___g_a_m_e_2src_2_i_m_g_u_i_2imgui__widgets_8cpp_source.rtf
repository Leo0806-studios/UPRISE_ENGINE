08416 {\cf20 // Helpers for internal use}\par
08417 {\cf18 void} ImGuiMenuColumns::Update({\cf18 float} spacing, {\cf18 bool} window_reappearing)\par
08418 \{\par
08419     {\cf19 if} (window_reappearing)\par
08420         memset(Widths, 0, {\cf17 sizeof}(Widths));\par
08421     Spacing = (ImU16)spacing;\par
08422     CalcNextTotalWidth({\cf17 true});\par
08423     memset(Widths, 0, {\cf17 sizeof}(Widths));\par
08424     TotalWidth = NextTotalWidth;\par
08425     NextTotalWidth = 0;\par
08426 \}\par
