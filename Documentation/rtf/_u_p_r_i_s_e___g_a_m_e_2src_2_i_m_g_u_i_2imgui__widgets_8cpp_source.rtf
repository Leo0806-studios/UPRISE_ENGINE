02238             {\cf19 return};\par
02239         {\cf19 case} ImGuiDataType_Float:\par
02240             {\cf19 if} (op == {\cf23 '+'}) \{ *({\cf18 float}*)output = *({\cf17 const} {\cf18 float}*)arg1 + *({\cf17 const} {\cf18 float}*)arg2; \}\par
02241             {\cf19 if} (op == {\cf23 '-'}) \{ *({\cf18 float}*)output = *({\cf17 const} {\cf18 float}*)arg1 - *({\cf17 const} {\cf18 float}*)arg2; \}\par
02242             {\cf19 return};\par
02243         {\cf19 case} ImGuiDataType_Double:\par
02244             {\cf19 if} (op == {\cf23 '+'}) \{ *({\cf18 double}*)output = *({\cf17 const} {\cf18 double}*)arg1 + *({\cf17 const} {\cf18 double}*)arg2; \}\par
02245             {\cf19 if} (op == {\cf23 '-'}) \{ *({\cf18 double}*)output = *({\cf17 const} {\cf18 double}*)arg1 - *({\cf17 const} {\cf18 double}*)arg2; \}\par
02246             {\cf19 return};\par
02247         {\cf19 case} ImGuiDataType_COUNT: {\cf19 break};\par
02248     \}\par
02249     IM_ASSERT(0);\par
02250 \}\par
