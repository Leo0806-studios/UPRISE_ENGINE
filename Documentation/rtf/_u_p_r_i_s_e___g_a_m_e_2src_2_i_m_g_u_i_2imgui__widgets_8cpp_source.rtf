07583 {\cf20 // - Applying SetRange for submitted items and record end points.}\par
07584 {\cf20 // - Altering button behavior flags to facilitate use with drag and drop.}\par
07585 {\cf18 void} ImGui::MultiSelectItemHeader(ImGuiID {\cf18 id}, {\cf18 bool}* p_selected, ImGuiButtonFlags* p_button_flags)\par
