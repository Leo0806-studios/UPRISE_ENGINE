01748 {\cf17 static} {\cf18 int} IMGUI_CDECL ShrinkWidthItemComparer({\cf17 const} {\cf18 void}* lhs, {\cf17 const} {\cf18 void}* rhs)\par
01749 \{\par
01750     {\cf17 const} ImGuiShrinkWidthItem* a = ({\cf17 const} ImGuiShrinkWidthItem*)lhs;\par
01751     {\cf17 const} ImGuiShrinkWidthItem* b = ({\cf17 const} ImGuiShrinkWidthItem*)rhs;\par
01752     {\cf19 if} ({\cf18 int} d = ({\cf18 int})(b->Width - a->Width))\par
01753         {\cf19 return} d;\par
01754     {\cf19 return} (b->Index - a->Index);\par
01755 \}\par
