04099 {\cf20 // Return false to discard a character.}\par
04100 {\cf17 static} {\cf18 bool} InputTextFilterCharacter(ImGuiContext* ctx, {\cf18 unsigned} {\cf18 int}* p_char, ImGuiInputTextFlags flags, ImGuiInputTextCallback callback, {\cf18 void}* user_data, {\cf18 bool} input_source_is_clipboard)\par
04101 \{\par
04102     {\cf18 unsigned} {\cf18 int} c = *p_char;\par
04103 \par
04104     {\cf20 // Filter non-printable (NB: isprint is unreliable! see #2467)}\par
04105     {\cf18 bool} apply_named_filters = {\cf17 true};\par
04106     {\cf19 if} (c < 0x20)\par
04107     \{\par
04108         {\cf18 bool} pass = {\cf17 false};\par
04109         pass |= (c == {\cf23 '\\n'}) && (flags & ImGuiInputTextFlags_Multiline) != 0; {\cf20 // Note that an Enter KEY will emit \\r and be ignored (we poll for KEY in InputText() code)}\par
04110         pass |= (c == {\cf23 '\\t'}) && (flags & ImGuiInputTextFlags_AllowTabInput) != 0;\par
04111         {\cf19 if} (!pass)\par
04112             {\cf19 return} {\cf17 false};\par
04113         apply_named_filters = {\cf17 false}; {\cf20 // Override named filters below so newline and tabs can still be inserted.}\par
04114     \}\par
04115 \par
04116     {\cf19 if} (input_source_is_clipboard == {\cf17 false})\par
04117     \{\par
04118         {\cf20 // We ignore Ascii representation of delete (emitted from Backspace on OSX, see #2578, #2817)}\par
04119         {\cf19 if} (c == 127)\par
04120             {\cf19 return} {\cf17 false};\par
04121 \par
04122         {\cf20 // Filter private Unicode range. GLFW on OSX seems to send private characters for special keys like arrow keys (FIXME)}\par
04123         {\cf19 if} (c >= 0xE000 && c <= 0xF8FF)\par
04124             {\cf19 return} {\cf17 false};\par
04125     \}\par
04126 \par
04127     {\cf20 // Filter Unicode ranges we are not handling in this build}\par
04128     {\cf19 if} (c > IM_UNICODE_CODEPOINT_MAX)\par
04129         {\cf19 return} {\cf17 false};\par
04130 \par
04131     {\cf20 // Generic named filters}\par
04132     {\cf19 if} (apply_named_filters && (flags & (ImGuiInputTextFlags_CharsDecimal | ImGuiInputTextFlags_CharsHexadecimal | ImGuiInputTextFlags_CharsUppercase | ImGuiInputTextFlags_CharsNoBlank | ImGuiInputTextFlags_CharsScientific | (ImGuiInputTextFlags)ImGuiInputTextFlags_LocalizeDecimalPoint)))\par
04133     \{\par
04134         {\cf20 // The libc allows overriding locale, with e.g. 'setlocale(LC_NUMERIC, "de_DE.UTF-8");' which affect the output/input of printf/scanf to use e.g. ',' instead of '.'.}\par
04135         {\cf20 // The standard mandate that programs starts in the "C" locale where the decimal point is '.'.}\par
04136         {\cf20 // We don't really intend to provide widespread support for it, but out of empathy for people stuck with using odd API, we support the bare minimum aka overriding the decimal point.}\par
04137         {\cf20 // Change the default decimal_point with:}\par
04138         {\cf20 //   ImGui::GetIO()->PlatformLocaleDecimalPoint = *localeconv()->decimal_point;}\par
04139         {\cf20 // Users of non-default decimal point (in particular ',') may be affected by word-selection logic (is_word_boundary_from_right/is_word_boundary_from_left) functions.}\par
04140         ImGuiContext& g = *ctx;\par
04141         {\cf17 const} {\cf18 unsigned} c_decimal_point = ({\cf18 unsigned} int)g.IO.PlatformLocaleDecimalPoint;\par
04142         {\cf19 if} (flags & (ImGuiInputTextFlags_CharsDecimal | ImGuiInputTextFlags_CharsScientific | (ImGuiInputTextFlags)ImGuiInputTextFlags_LocalizeDecimalPoint))\par
04143             {\cf19 if} (c == {\cf23 '.'} || c == {\cf23 ','})\par
04144                 c = c_decimal_point;\par
04145 \par
04146         {\cf20 // Full-width -> half-width conversion for numeric fields (https://en.wikipedia.org/wiki/Halfwidth_and_Fullwidth_Forms_(Unicode_block)}\par
04147         {\cf20 // While this is mostly convenient, this has the side-effect for uninformed users accidentally inputting full-width characters that they may}\par
04148         {\cf20 // scratch their head as to why it works in numerical fields vs in generic text fields it would require support in the font.}\par
04149         {\cf19 if} (flags & (ImGuiInputTextFlags_CharsDecimal | ImGuiInputTextFlags_CharsScientific | ImGuiInputTextFlags_CharsHexadecimal))\par
04150             {\cf19 if} (c >= 0xFF01 && c <= 0xFF5E)\par
04151                 c = c - 0xFF01 + 0x21;\par
04152 \par
04153         {\cf20 // Allow 0-9 . - + * /}\par
04154         {\cf19 if} (flags & ImGuiInputTextFlags_CharsDecimal)\par
04155             {\cf19 if} (!(c >= {\cf23 '0'} && c <= {\cf23 '9'}) && (c != c_decimal_point) && (c != {\cf23 '-'}) && (c != {\cf23 '+'}) && (c != {\cf23 '*'}) && (c != {\cf23 '/'}))\par
04156                 {\cf19 return} {\cf17 false};\par
04157 \par
04158         {\cf20 // Allow 0-9 . - + * / e E}\par
04159         {\cf19 if} (flags & ImGuiInputTextFlags_CharsScientific)\par
04160             {\cf19 if} (!(c >= {\cf23 '0'} && c <= {\cf23 '9'}) && (c != c_decimal_point) && (c != {\cf23 '-'}) && (c != {\cf23 '+'}) && (c != {\cf23 '*'}) && (c != {\cf23 '/'}) && (c != {\cf23 'e'}) && (c != {\cf23 'E'}))\par
04161                 {\cf19 return} {\cf17 false};\par
04162 \par
04163         {\cf20 // Allow 0-9 a-F A-F}\par
04164         {\cf19 if} (flags & ImGuiInputTextFlags_CharsHexadecimal)\par
04165             {\cf19 if} (!(c >= {\cf23 '0'} && c <= {\cf23 '9'}) && !(c >= {\cf23 'a'} && c <= {\cf23 'f'}) && !(c >= {\cf23 'A'} && c <= {\cf23 'F'}))\par
04166                 {\cf19 return} {\cf17 false};\par
04167 \par
04168         {\cf20 // Turn a-z into A-Z}\par
04169         {\cf19 if} (flags & ImGuiInputTextFlags_CharsUppercase)\par
04170             {\cf19 if} (c >= {\cf23 'a'} && c <= {\cf23 'z'})\par
