00534             \}\par
00535         \}\par
00536 \par
00537     {\cf19 if} (flatten_hovered_children)\par
00538         g.HoveredWindow = backup_hovered_window;\par
00539 \par
00540     {\cf20 // Mouse handling}\par
00541     {\cf17 const} ImGuiID test_owner_id = (flags & ImGuiButtonFlags_NoTestKeyOwner) ? ImGuiKeyOwner_Any : id;\par
00542     {\cf19 if} (hovered)\par
00543     \{\par
00544         IM_ASSERT({\cf18 id} != 0); {\cf20 // Lazily check inside rare path.}\par
00545 \par
00546         {\cf20 // Poll mouse buttons}\par
00547         {\cf20 // - 'mouse_button_clicked' is generally carried into ActiveIdMouseButton when setting ActiveId.}\par
00548         {\cf20 // - Technically we only need some values in one code path, but since this is gated by hovered test this is fine.}\par
00549         {\cf18 int} mouse_button_clicked = -1;\par
00550         {\cf18 int} mouse_button_released = -1;\par
00551         {\cf19 for} ({\cf18 int} button = 0; button < 3; button++)\par
00552             {\cf19 if} (flags & (ImGuiButtonFlags_MouseButtonLeft << button)) {\cf20 // Handle ImGuiButtonFlags_MouseButtonRight and ImGuiButtonFlags_MouseButtonMiddle here.}\par
00553             \{\par
00554                 {\cf19 if} (IsMouseClicked(button, ImGuiInputFlags_None, test_owner_id) && mouse_button_clicked == -1) \{ mouse_button_clicked = button; \}\par
00555                 {\cf19 if} (IsMouseReleased(button, test_owner_id) && mouse_button_released == -1) \{ mouse_button_released = button; \}\par
00556             \}\par
00557 \par
00558         {\cf20 // Process initial action}\par
00559         {\cf19 if} (!(flags & ImGuiButtonFlags_NoKeyModifiers) || (!g.IO.KeyCtrl && !g.IO.KeyShift && !g.IO.KeyAlt))\par
00560         \{\par
00561             {\cf19 if} (mouse_button_clicked != -1 && g.ActiveId != {\cf18 id})\par
00562             \{\par
00563                 {\cf19 if} (!(flags & ImGuiButtonFlags_NoSetKeyOwner))\par
00564                     SetKeyOwner(MouseButtonToKey(mouse_button_clicked), {\cf18 id});\par
00565                 {\cf19 if} (flags & (ImGuiButtonFlags_PressedOnClickRelease | ImGuiButtonFlags_PressedOnClickReleaseAnywhere))\par
00566                 \{\par
00567                     SetActiveID({\cf18 id}, window);\par
00568                     g.ActiveIdMouseButton = mouse_button_clicked;\par
00569                     {\cf19 if} (!(flags & ImGuiButtonFlags_NoNavFocus))\par
00570                     \{\par
00571                         SetFocusID({\cf18 id}, window);\par
