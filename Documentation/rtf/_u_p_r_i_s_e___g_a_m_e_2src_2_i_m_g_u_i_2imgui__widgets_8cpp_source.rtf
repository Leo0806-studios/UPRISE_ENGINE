06984 ImGuiTypingSelectRequest* ImGui::GetTypingSelectRequest(ImGuiTypingSelectFlags flags)\par
06985 \{\par
06986     ImGuiContext& g = *GImGui;\par
06987     ImGuiTypingSelectState* data = &g.TypingSelectState;\par
06988     ImGuiTypingSelectRequest* out_request = &data->Request;\par
06989 \par
06990     {\cf20 // Clear buffer}\par
06991     {\cf17 const} {\cf18 float} TYPING_SELECT_RESET_TIMER = 1.80f;          {\cf20 // FIXME: Potentially move to IO config.}\par
06992     {\cf17 const} {\cf18 int} TYPING_SELECT_SINGLE_CHAR_COUNT_FOR_LOCK = 4; {\cf20 // Lock single char matching when repeating same char 4 times}\par
06993     {\cf19 if} (data->SearchBuffer[0] != 0)\par
06994     \{\par
