06826         {\cf17 const} {\cf18 float} backup_clip_rect_min_x = window->ClipRect.Min.x;\par
06827         {\cf17 const} {\cf18 float} backup_clip_rect_max_x = window->ClipRect.Max.x;\par
06828         window->ClipRect.Min.x = window->ParentWorkRect.Min.x;\par
06829         window->ClipRect.Max.x = window->ParentWorkRect.Max.x;\par
06830         is_visible = ItemAdd(bb, {\cf18 id}, NULL, extra_item_flags);\par
06831         window->ClipRect.Min.x = backup_clip_rect_min_x;\par
06832         window->ClipRect.Max.x = backup_clip_rect_max_x;\par
06833     \}\par
06834     {\cf19 else}\par
06835     \{\par
06836         is_visible = ItemAdd(bb, {\cf18 id}, NULL, extra_item_flags);\par
06837     \}\par
06838 \par
06839     {\cf17 const} {\cf18 bool} is_multi_select = (g.LastItemData.InFlags & ImGuiItemFlags_IsMultiSelect) != 0;\par
06840     {\cf19 if} (!is_visible)\par
06841         {\cf19 if} (!is_multi_select || !g.BoxSelectState.UnclipMode || !g.BoxSelectState.UnclipRect.Overlaps(bb)) {\cf20 // Extra layer of "no logic clip" for box-select support (would be more overhead to add to ItemAdd)}\par
06842             {\cf19 return} {\cf17 false};\par
06843 \par
06844     {\cf17 const} {\cf18 bool} disabled_global = (g.CurrentItemFlags & ImGuiItemFlags_Disabled) != 0;\par
06845     {\cf19 if} (disabled_item && !disabled_global) {\cf20 // Only testing this as an optimization}\par
06846         BeginDisabled();\par
06847 \par
06848     {\cf20 // FIXME: We can standardize the behavior of those two, we could also keep the fast path of override ClipRect + full push on render only,}\par
06849     {\cf20 // which would be advantageous since most selectable are not selected.}\par
06850     {\cf19 if} (span_all_columns)\par
06851     \{\par
06852         {\cf19 if} (g.CurrentTable)\par
06853             TablePushBackgroundChannel();\par
06854         {\cf19 else} {\cf19 if} (window->DC.CurrentColumns)\par
06855             PushColumnsBackground();\par
06856         g.LastItemData.StatusFlags |= ImGuiItemStatusFlags_HasClipRect;\par
06857         g.LastItemData.ClipRect = window->ClipRect;\par
06858     \}\par
06859 \par
06860     {\cf20 // We use NoHoldingActiveID on menus so user can click and _hold_ on a menu then drag to browse child entries}\par
06861     ImGuiButtonFlags button_flags = 0;\par
06862     {\cf19 if} (flags & ImGuiSelectableFlags_NoHoldingActiveID) \{ button_flags |= ImGuiButtonFlags_NoHoldingActiveId; \}\par
06863     {\cf19 if} (flags & ImGuiSelectableFlags_NoSetKeyOwner)     \{ button_flags |= ImGuiButtonFlags_NoSetKeyOwner; \}\par
06864     {\cf19 if} (flags & ImGuiSelectableFlags_SelectOnClick)     \{ button_flags |= ImGuiButtonFlags_PressedOnClick; \}\par
06865     {\cf19 if} (flags & ImGuiSelectableFlags_SelectOnRelease)   \{ button_flags |= ImGuiButtonFlags_PressedOnRelease; \}\par
06866     {\cf19 if} (flags & ImGuiSelectableFlags_AllowDoubleClick)  \{ button_flags |= ImGuiButtonFlags_PressedOnClickRelease | ImGuiButtonFlags_PressedOnDoubleClick; \}\par
06867     {\cf19 if} ((flags & ImGuiSelectableFlags_AllowOverlap) || (g.LastItemData.InFlags & ImGuiItemFlags_AllowOverlap)) \{ button_flags |= ImGuiButtonFlags_AllowOverlap; \}\par
06868 \par
06869     {\cf20 // Multi-selection support (header)}\par
06870     {\cf17 const} {\cf18 bool} was_selected = selected;\par
06871     {\cf19 if} (is_multi_select)\par
06872     \{\par
06873         {\cf20 // Handle multi-select + alter button flags for it}\par
06874         MultiSelectItemHeader({\cf18 id}, &selected, &button_flags);\par
06875     \}\par
06876 \par
06877     {\cf18 bool} hovered, held;\par
06878     {\cf18 bool} pressed = ButtonBehavior(bb, {\cf18 id}, &hovered, &held, button_flags);\par
06879 \par
06880     {\cf20 // Multi-selection support (footer)}\par
06881     {\cf19 if} (is_multi_select)\par
06882     \{\par
06883         MultiSelectItemFooter({\cf18 id}, &selected, &pressed);\par
06884     \}\par
06885     {\cf19 else}\par
06886     \{\par
06887         {\cf20 // Auto-select when moved into}\par
06888         {\cf20 // - This will be more fully fleshed in the range-select branch}\par
06889         {\cf20 // - This is not exposed as it won't nicely work with some user side handling of shift/control}\par
06890         {\cf20 // - We cannot do 'if (g.NavJustMovedToId != id) \{ selected = false; pressed = was_selected; \}' for two reasons}\par
06891         {\cf20 //   - (1) it would require focus scope to be set, need exposing PushFocusScope() or equivalent (e.g. BeginSelection() calling PushFocusScope())}\par
06892         {\cf20 //   - (2) usage will fail with clipped items}\par
06893         {\cf20 //   The multi-select API aim to fix those issues, e.g. may be replaced with a BeginSelection() API.}\par
06894         {\cf19 if} ((flags & ImGuiSelectableFlags_SelectOnNav) && g.NavJustMovedToId != 0 && g.NavJustMovedToFocusScopeId == g.CurrentFocusScopeId)\par
06895             {\cf19 if} (g.NavJustMovedToId == {\cf18 id})\par
06896                 selected = pressed = {\cf17 true};\par
06897     \}\par
06898 \par
06899     {\cf20 // Update NavId when clicking or when Hovering (this doesn't happen on most widgets), so navigation can be resumed with gamepad/keyboard}\par
06900     {\cf19 if} (pressed || (hovered && (flags & ImGuiSelectableFlags_SetNavIdOnHover)))\par
06901     \{\par
06902         {\cf19 if} (!g.NavDisableMouseHover && g.NavWindow == window && g.NavLayer == window->DC.NavLayerCurrent)\par
06903         \{\par
06904             SetNavID({\cf18 id}, window->DC.NavLayerCurrent, g.CurrentFocusScopeId, WindowRectAbsToRel(window, bb)); {\cf20 // (bb == NavRect)}\par
06905             g.NavDisableHighlight = {\cf17 true};\par
06906         \}\par
06907     \}\par
06908     {\cf19 if} (pressed)\par
06909         MarkItemEdited({\cf18 id});\par
06910 \par
06911     {\cf19 if} (selected != was_selected)\par
06912         g.LastItemData.StatusFlags |= ImGuiItemStatusFlags_ToggledSelection;\par
06913 \par
06914     {\cf20 // Render}\par
06915     {\cf19 if} (is_visible)\par
06916     \{\par
06917         {\cf17 const} {\cf18 bool} highlighted = hovered || (flags & ImGuiSelectableFlags_Highlight);\par
06918         {\cf19 if} (highlighted || selected)\par
