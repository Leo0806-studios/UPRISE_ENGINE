03924         {\cf19 return} 0;\par
03925 \par
03926     {\cf18 bool} prev_white = ImCharIsBlankW(obj->TextW[idx]);\par
03927     {\cf18 bool} prev_separ = is_separator(obj->TextW[idx]);\par
03928     {\cf18 bool} curr_white = ImCharIsBlankW(obj->TextW[idx - 1]);\par
03929     {\cf18 bool} curr_separ = is_separator(obj->TextW[idx - 1]);\par
03930     {\cf19 return} ((prev_white) && !(curr_separ || curr_white)) || (curr_separ && !prev_separ);\par
