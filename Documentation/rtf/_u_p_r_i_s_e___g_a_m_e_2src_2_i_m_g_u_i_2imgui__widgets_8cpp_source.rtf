04012 {\cf17 static} {\cf18 void} stb_textedit_replace(ImGuiInputTextState* str, STB_TexteditState* state, {\cf17 const} IMSTB_TEXTEDIT_CHARTYPE* text, {\cf18 int} text_len)\par
