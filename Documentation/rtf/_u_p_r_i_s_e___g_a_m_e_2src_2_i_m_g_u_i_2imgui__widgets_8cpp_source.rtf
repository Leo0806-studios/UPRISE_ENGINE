07560 {\cf18 void} ImGui::SetNextItemSelectionUserData(ImGuiSelectionUserData selection_user_data)\par
07561 \{\par
07562     {\cf20 // Note that flags will be cleared by ItemAdd(), so it's only useful for Navigation code!}\par
