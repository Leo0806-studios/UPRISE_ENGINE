09527     {\cf19 if} (tab_bar->VisibleTabId == tab_id)      \{ tab_bar->VisibleTabId = 0; \}\par
09528     {\cf19 if} (tab_bar->SelectedTabId == tab_id)     \{ tab_bar->SelectedTabId = 0; \}\par
09529     {\cf19 if} (tab_bar->NextSelectedTabId == tab_id) \{ tab_bar->NextSelectedTabId = 0; \}\par
09530 \}\par
