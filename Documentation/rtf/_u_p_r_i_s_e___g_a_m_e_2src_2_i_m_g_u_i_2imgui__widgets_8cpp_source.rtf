09610 {\cf18 void} ImGui::TabBarQueueReorderFromMousePos(ImGuiTabBar* tab_bar, ImGuiTabItem* src_tab, ImVec2 mouse_pos)\par
09611 \{\par
09612     ImGuiContext& g = *GImGui;\par
09613     IM_ASSERT(tab_bar->ReorderRequestTabId == 0);\par
09614     {\cf19 if} ((tab_bar->Flags & ImGuiTabBarFlags_Reorderable) == 0)\par
09615         {\cf19 return};\par
09616 \par
09617     {\cf17 const} {\cf18 bool} is_central_section = (src_tab->Flags & ImGuiTabItemFlags_SectionMask_) == 0;\par
09618     {\cf17 const} {\cf18 float} bar_offset = tab_bar->BarRect.Min.x - (is_central_section ? tab_bar->ScrollingTarget : 0);\par
09619 \par
09620     {\cf20 // Count number of contiguous tabs we are crossing over}\par
09621     {\cf17 const} {\cf18 int} dir = (bar_offset + src_tab->Offset) > mouse_pos.x ? -1 : +1;\par
09622     {\cf17 const} {\cf18 int} src_idx = tab_bar->Tabs.index_from_ptr(src_tab);\par
09623     {\cf18 int} dst_idx = src_idx;\par
09624     {\cf19 for} ({\cf18 int} i = src_idx; i >= 0 && i < tab_bar->Tabs.Size; i += dir)\par
09625     \{\par
09626         {\cf20 // Reordered tabs must share the same section}\par
09627         {\cf17 const} ImGuiTabItem* dst_tab = &tab_bar->Tabs[i];\par
09628         {\cf19 if} (dst_tab->Flags & ImGuiTabItemFlags_NoReorder)\par
09629             {\cf19 break};\par
09630         {\cf19 if} ((dst_tab->Flags & ImGuiTabItemFlags_SectionMask_) != (src_tab->Flags & ImGuiTabItemFlags_SectionMask_))\par
09631             {\cf19 break};\par
09632         dst_idx = i;\par
09633 \par
09634         {\cf20 // Include spacing after tab, so when mouse cursor is between tabs we would not continue checking further tabs that are not hovered.}\par
09635         {\cf17 const} {\cf18 float} x1 = bar_offset + dst_tab->Offset - g.Style.ItemInnerSpacing.x;\par
09636         {\cf17 const} {\cf18 float} x2 = bar_offset + dst_tab->Offset + dst_tab->Width + g.Style.ItemInnerSpacing.x;\par
09637         {\cf20 //GetForegroundDrawList()->AddRect(ImVec2(x1, tab_bar->BarRect.Min.y), ImVec2(x2, tab_bar->BarRect.Max.y), IM_COL32(255, 0, 0, 255));}\par
09638         {\cf19 if} ((dir < 0 && mouse_pos.x > x1) || (dir > 0 && mouse_pos.x < x2))\par
09639             {\cf19 break};\par
09640     \}\par
09641 \par
09642     {\cf19 if} (dst_idx != src_idx)\par
09643         TabBarQueueReorder(tab_bar, src_tab, dst_idx - src_idx);\par
09644 \}\par
