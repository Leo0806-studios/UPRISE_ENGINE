05902 \par
05903         {\cf20 // Render SV triangle (rotated according to hue)}\par
05904         ImVec2 tra = wheel_center + ImRotate(triangle_pa, cos_hue_angle, sin_hue_angle);\par
05905         ImVec2 trb = wheel_center + ImRotate(triangle_pb, cos_hue_angle, sin_hue_angle);\par
05906         ImVec2 trc = wheel_center + ImRotate(triangle_pc, cos_hue_angle, sin_hue_angle);\par
05907         ImVec2 uv_white = GetFontTexUvWhitePixel();\par
05908         draw_list->PrimReserve(3, 3);\par
05909         draw_list->PrimVtx(tra, uv_white, hue_color32);\par
05910         draw_list->PrimVtx(trb, uv_white, col_black);\par
05911         draw_list->PrimVtx(trc, uv_white, col_white);\par
05912         draw_list->AddTriangle(tra, trb, trc, col_midgrey, 1.5f);\par
05913         sv_cursor_pos = ImLerp(ImLerp(trc, tra, ImSaturate(S)), trb, ImSaturate(1 - V));\par
05914     \}\par
05915     {\cf19 else} {\cf19 if} (flags & ImGuiColorEditFlags_PickerHueBar)\par
05916     \{\par
05917         {\cf20 // Render SV Square}\par
05918         draw_list->AddRectFilledMultiColor(picker_pos, picker_pos + ImVec2(sv_picker_size, sv_picker_size), col_white, hue_color32, hue_color32, col_white);\par
05919         draw_list->AddRectFilledMultiColor(picker_pos, picker_pos + ImVec2(sv_picker_size, sv_picker_size), 0, 0, col_black, col_black);\par
05920         RenderFrameBorder(picker_pos, picker_pos + ImVec2(sv_picker_size, sv_picker_size), 0.0f);\par
05921         sv_cursor_pos.x = ImClamp(IM_ROUND(picker_pos.x + ImSaturate(S)     * sv_picker_size), picker_pos.x + 2, picker_pos.x + sv_picker_size - 2); {\cf20 // Sneakily prevent the circle to stick out too much}\par
05922         sv_cursor_pos.y = ImClamp(IM_ROUND(picker_pos.y + ImSaturate(1 - V) * sv_picker_size), picker_pos.y + 2, picker_pos.y + sv_picker_size - 2);\par
05923 \par
05924         {\cf20 // Render Hue Bar}\par
05925         {\cf19 for} ({\cf18 int} i = 0; i < 6; ++i)\par
05926             draw_list->AddRectFilledMultiColor(ImVec2(bar0_pos_x, picker_pos.y + i * (sv_picker_size / 6)), ImVec2(bar0_pos_x + bars_width, picker_pos.y + (i + 1) * (sv_picker_size / 6)), col_hues[i], col_hues[i], col_hues[i + 1], col_hues[i + 1]);\par
05927         {\cf18 float} bar0_line_y = IM_ROUND(picker_pos.y + H * sv_picker_size);\par
05928         RenderFrameBorder(ImVec2(bar0_pos_x, picker_pos.y), ImVec2(bar0_pos_x + bars_width, picker_pos.y + sv_picker_size), 0.0f);\par
05929         RenderArrowsForVerticalBar(draw_list, ImVec2(bar0_pos_x - 1, bar0_line_y), ImVec2(bars_triangles_half_sz + 1, bars_triangles_half_sz), bars_width + 2.0f, style.Alpha);\par
05930     \}\par
05931 \par
05932     {\cf20 // Render cursor/preview circle (clamp S/V within 0..1 range because floating points colors may lead HSV values to be out of range)}\par
05933     {\cf18 float} sv_cursor_rad = value_changed_sv ? wheel_thickness * 0.55f : wheel_thickness * 0.40f;\par
05934     {\cf18 int} sv_cursor_segments = draw_list->_CalcCircleAutoSegmentCount(sv_cursor_rad); {\cf20 // Lock segment count so the +1 one matches others.}\par
05935     draw_list->AddCircleFilled(sv_cursor_pos, sv_cursor_rad, user_col32_striped_of_alpha, sv_cursor_segments);\par
05936     draw_list->AddCircle(sv_cursor_pos, sv_cursor_rad + 1, col_midgrey, sv_cursor_segments);\par
05937     draw_list->AddCircle(sv_cursor_pos, sv_cursor_rad, col_white, sv_cursor_segments);\par
05938 \par
05939     {\cf20 // Render alpha bar}\par
05940     {\cf19 if} (alpha_bar)\par
05941     \{\par
05942         {\cf18 float} alpha = ImSaturate(col[3]);\par
05943         ImRect bar1_bb(bar1_pos_x, picker_pos.y, bar1_pos_x + bars_width, picker_pos.y + sv_picker_size);\par
05944         RenderColorRectWithAlphaCheckerboard(draw_list, bar1_bb.Min, bar1_bb.Max, 0, bar1_bb.GetWidth() / 2.0f, ImVec2(0.0f, 0.0f));\par
05945         draw_list->AddRectFilledMultiColor(bar1_bb.Min, bar1_bb.Max, user_col32_striped_of_alpha, user_col32_striped_of_alpha, user_col32_striped_of_alpha & ~IM_COL32_A_MASK, user_col32_striped_of_alpha & ~IM_COL32_A_MASK);\par
05946         {\cf18 float} bar1_line_y = IM_ROUND(picker_pos.y + (1.0f - alpha) * sv_picker_size);\par
05947         RenderFrameBorder(bar1_bb.Min, bar1_bb.Max, 0.0f);\par
05948         RenderArrowsForVerticalBar(draw_list, ImVec2(bar1_pos_x - 1, bar1_line_y), ImVec2(bars_triangles_half_sz + 1, bars_triangles_half_sz), bars_width + 2.0f, style.Alpha);\par
05949     \}\par
05950 \par
05951     EndGroup();\par
05952 \par
05953     {\cf19 if} (value_changed && memcmp(backup_initial_col, col, components * {\cf17 sizeof}({\cf18 float})) == 0)\par
05954         value_changed = {\cf17 false};\par
05955     {\cf19 if} (value_changed && g.LastItemData.ID != 0) {\cf20 // In case of ID collision, the second EndGroup() won't catch g.ActiveId}\par
05956         MarkItemEdited(g.LastItemData.ID);\par
05957 \par
05958     {\cf19 if} (set_current_color_edit_id)\par
05959         g.ColorEditCurrentID = 0;\par
05960     PopID();\par
05961 \par
05962     {\cf19 return} value_changed;\par
05963 \}\par
