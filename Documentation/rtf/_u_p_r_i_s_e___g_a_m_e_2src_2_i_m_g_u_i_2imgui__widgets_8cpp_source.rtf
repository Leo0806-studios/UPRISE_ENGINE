02360 {\cf17 static} {\cf18 float} GetMinimumStepAtDecimalPrecision({\cf18 int} decimal_precision)\par
02361 \{\par
02362     {\cf17 static} {\cf17 const} {\cf18 float} min_steps[10] = \{ 1.0f, 0.1f, 0.01f, 0.001f, 0.0001f, 0.00001f, 0.000001f, 0.0000001f, 0.00000001f, 0.000000001f \};\par
02363     {\cf19 if} (decimal_precision < 0)\par
02364         {\cf19 return} FLT_MIN;\par
02365     {\cf19 return} (decimal_precision < IM_ARRAYSIZE(min_steps)) ? min_steps[decimal_precision] : ImPow(10.0f, ({\cf18 float})-decimal_precision);\par
02366 \}\par
