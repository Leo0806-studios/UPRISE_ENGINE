06770 \par
06771 {\cf20 // Tip: pass a non-visible label (e.g. "##hello") then you can use the space to draw other text or image.}\par
06772 {\cf20 // But you need to make sure the ID is unique, e.g. enclose calls in PushID/PopID or use ##unique_id.}\par
06773 {\cf20 // With this scheme, ImGuiSelectableFlags_SpanAllColumns and ImGuiSelectableFlags_AllowOverlap are also frequently used flags.}\par
06774 {\cf20 // FIXME: Selectable() with (size.x == 0.0f) and (SelectableTextAlign.x > 0.0f) followed by SameLine() is currently not supported.}\par
06775 {\cf18 bool} ImGui::Selectable({\cf17 const} {\cf18 char}* label, {\cf18 bool} selected, ImGuiSelectableFlags flags, {\cf17 const} ImVec2& size_arg)\par
06776 \{\par
06777     ImGuiWindow* window = GetCurrentWindow();\par
06778     {\cf19 if} (window->SkipItems)\par
06779         {\cf19 return} {\cf17 false};\par
06780 \par
06781     ImGuiContext& g = *GImGui;\par
06782     {\cf17 const} ImGuiStyle& style = g.Style;\par
06783 \par
06784     {\cf20 // Submit label or explicit size to ItemSize(), whereas ItemAdd() will submit a larger/spanning rectangle.}\par
06785     ImGuiID {\cf18 id} = window->GetID(label);\par
06786     ImVec2 label_size = CalcTextSize(label, NULL, {\cf17 true});\par
06787     ImVec2 size(size_arg.x != 0.0f ? size_arg.x : label_size.x, size_arg.y != 0.0f ? size_arg.y : label_size.y);\par
06788     ImVec2 pos = window->DC.CursorPos;\par
06789     pos.y += window->DC.CurrLineTextBaseOffset;\par
06790     ItemSize(size, 0.0f);\par
06791 \par
06792     {\cf20 // Fill horizontal space}\par
06793     {\cf20 // We don't support (size < 0.0f) in Selectable() because the ItemSpacing extension would make explicitly right-aligned sizes not visibly match other widgets.}\par
06794     {\cf17 const} {\cf18 bool} span_all_columns = (flags & ImGuiSelectableFlags_SpanAllColumns) != 0;\par
06795     {\cf17 const} {\cf18 float} min_x = span_all_columns ? window->ParentWorkRect.Min.x : pos.x;\par
06796     {\cf17 const} {\cf18 float} max_x = span_all_columns ? window->ParentWorkRect.Max.x : window->WorkRect.Max.x;\par
06797     {\cf19 if} (size_arg.x == 0.0f || (flags & ImGuiSelectableFlags_SpanAvailWidth))\par
06798         size.x = ImMax(label_size.x, max_x - min_x);\par
06799 \par
06800     {\cf20 // Text stays at the submission position, but bounding box may be extended on both sides}\par
06801     {\cf17 const} ImVec2 text_min = pos;\par
06802     {\cf17 const} ImVec2 text_max(min_x + size.x, pos.y + size.y);\par
06803 \par
06804     {\cf20 // Selectables are meant to be tightly packed together with no click-gap, so we extend their box to cover spacing between selectable.}\par
06805     {\cf20 // FIXME: Not part of layout so not included in clipper calculation, but ItemSize currently doesn't allow offsetting CursorPos.}\par
06806     ImRect bb(min_x, pos.y, text_max.x, text_max.y);\par
06807     {\cf19 if} ((flags & ImGuiSelectableFlags_NoPadWithHalfSpacing) == 0)\par
06808     \{\par
06809         {\cf17 const} {\cf18 float} spacing_x = span_all_columns ? 0.0f : style.ItemSpacing.x;\par
06810         {\cf17 const} {\cf18 float} spacing_y = style.ItemSpacing.y;\par
06811         {\cf17 const} {\cf18 float} spacing_L = IM_TRUNC(spacing_x * 0.50f);\par
06812         {\cf17 const} {\cf18 float} spacing_U = IM_TRUNC(spacing_y * 0.50f);\par
06813         bb.Min.x -= spacing_L;\par
06814         bb.Min.y -= spacing_U;\par
06815         bb.Max.x += (spacing_x - spacing_L);\par
06816         bb.Max.y += (spacing_y - spacing_U);\par
06817     \}\par
06818     {\cf20 //if (g.IO.KeyCtrl) \{ GetForegroundDrawList()->AddRect(bb.Min, bb.Max, IM_COL32(0, 255, 0, 255)); \}}\par
06819 \par
06820     {\cf17 const} {\cf18 bool} disabled_item = (flags & ImGuiSelectableFlags_Disabled) != 0;\par
06821     {\cf17 const} ImGuiItemFlags extra_item_flags = disabled_item ? (ImGuiItemFlags)ImGuiItemFlags_Disabled : ImGuiItemFlags_None;\par
