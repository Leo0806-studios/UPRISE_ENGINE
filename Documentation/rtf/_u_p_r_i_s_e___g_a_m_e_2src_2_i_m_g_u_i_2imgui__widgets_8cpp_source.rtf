08616 {\cf17 static} {\cf18 bool} IsRootOfOpenMenuSet()\par
08617 \{\par
08618     ImGuiContext& g = *GImGui;\par
08619     ImGuiWindow* window = g.CurrentWindow;\par
08620     {\cf19 if} ((g.OpenPopupStack.Size <= g.BeginPopupStack.Size) || (window->Flags & ImGuiWindowFlags_ChildMenu))\par
08621         {\cf19 return} {\cf17 false};\par
08622 \par
08623     {\cf20 // Initially we used 'upper_popup->OpenParentId == window->IDStack.back()' to differentiate multiple menu sets from each others}\par
08624     {\cf20 // (e.g. inside menu bar vs loose menu items) based on parent ID.}\par
08625     {\cf20 // This would however prevent the use of e.g. PushID() user code submitting menus.}\par
08626     {\cf20 // Previously this worked between popup and a first child menu because the first child menu always had the _ChildWindow flag,}\par
08627     {\cf20 // making hovering on parent popup possible while first child menu was focused - but this was generally a bug with other side effects.}\par
08628     {\cf20 // Instead we don't treat Popup specifically (in order to consistently support menu features in them), maybe the first child menu of a Popup}\par
08629     {\cf20 // doesn't have the _ChildWindow flag, and we rely on this IsRootOfOpenMenuSet() check to allow hovering between root window/popup and first child menu.}\par
08630     {\cf20 // In the end, lack of ID check made it so we could no longer differentiate between separate menu sets. To compensate for that, we at least check parent window nav layer.}\par
08631     {\cf20 // This fixes the most common case of menu opening on hover when moving between window content and menu bar. Multiple different menu sets in same nav layer would still}\par
08632     {\cf20 // open on hover, but that should be a lesser problem, because if such menus are close in proximity in window content then it won't feel weird and if they are far apart}\par
08633     {\cf20 // it likely won't be a problem anyone runs into.}\par
08634     {\cf17 const} ImGuiPopupData* upper_popup = &g.OpenPopupStack[g.BeginPopupStack.Size];\par
08635     {\cf19 if} (window->DC.NavLayerCurrent != upper_popup->ParentNavLayer)\par
08636         {\cf19 return} {\cf17 false};\par
08637     {\cf19 return} upper_popup->Window && (upper_popup->Window->Flags & ImGuiWindowFlags_ChildMenu) && ImGui::IsWindowChildOf(upper_popup->Window, window, {\cf17 true}, {\cf17 false});\par
08638 \}\par
