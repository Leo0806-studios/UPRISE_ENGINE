05552         \{\par
05553             memcpy(({\cf18 float}*)col, payload->Data, {\cf17 sizeof}({\cf18 float}) * components);\par
05554             value_changed = accepted_drag_drop = {\cf17 true};\par
05555         \}\par
05556 \par
05557         {\cf20 // Drag-drop payloads are always RGB}\par
05558         {\cf19 if} (accepted_drag_drop && (flags & ImGuiColorEditFlags_InputHSV))\par
