00613             {\cf19 if} (g.ActiveId == {\cf18 id} && (item_flags & ImGuiItemFlags_ButtonRepeat))\par
00614                 {\cf19 if} (g.IO.MouseDownDuration[g.ActiveIdMouseButton] > 0.0f && IsMouseClicked(g.ActiveIdMouseButton, ImGuiInputFlags_Repeat, test_owner_id))\par
00615                     pressed = {\cf17 true};\par
00616         \}\par
00617 \par
00618         {\cf19 if} (pressed)\par
00619             g.NavDisableHighlight = {\cf17 true};\par
00620     \}\par
00621 \par
00622     {\cf20 // Gamepad/Keyboard handling}\par
