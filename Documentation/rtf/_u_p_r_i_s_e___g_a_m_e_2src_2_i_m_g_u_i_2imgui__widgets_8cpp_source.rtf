09728                     tab_to_scroll_to = (target_order < 0 || target_order >= tab_bar->Tabs.Size) ? tab_to_scroll_to : NULL;\par
09729                 \}\par
09730             \}\par
09731         \}\par
09732     window->DC.CursorPos = backup_cursor_pos;\par
09733     tab_bar->BarRect.Max.x -= scrolling_buttons_width + 1.0f;\par
09734 \par
09735     {\cf19 return} tab_to_scroll_to;\par
09736 \}\par
