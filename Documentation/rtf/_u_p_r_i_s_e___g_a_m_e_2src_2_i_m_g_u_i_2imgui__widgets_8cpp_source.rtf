07719             {\cf17 const} {\cf18 bool} rect_overlap_curr = bs->BoxSelectRectCurr.Overlaps(g.LastItemData.Rect);\par
07720             {\cf17 const} {\cf18 bool} rect_overlap_prev = bs->BoxSelectRectPrev.Overlaps(g.LastItemData.Rect);\par
07721             {\cf19 if} ((rect_overlap_curr && !rect_overlap_prev && !selected) || (rect_overlap_prev && !rect_overlap_curr))\par
