07176 \par
07177 {\cf20 // Call on the initial click.}\par
07178 {\cf17 static} {\cf18 void} BoxSelectPreStartDrag(ImGuiID {\cf18 id}, ImGuiSelectionUserData clicked_item)\par
07179 \{\par
07180     ImGuiContext& g = *GImGui;\par
07181     ImGuiBoxSelectState* bs = &g.BoxSelectState;\par
07182     bs->ID = id;\par
07183     bs->IsStarting = {\cf17 true}; {\cf20 // Consider starting box-select.}\par
07184     bs->IsStartedFromVoid = (clicked_item == ImGuiSelectionUserData_Invalid);\par
07185     bs->IsStartedSetNavIdOnce = bs->IsStartedFromVoid;\par
07186     bs->KeyMods = g.IO.KeyMods;\par
07187     bs->StartPosRel = bs->EndPosRel = ImGui::WindowPosAbsToRel(g.CurrentWindow, g.IO.MousePos);\par
07188     bs->ScrollAccum = ImVec2(0.0f, 0.0f);\par
07189 \}\par
07190 \par
07191 {\cf17 static} {\cf18 void} BoxSelectActivateDrag(ImGuiBoxSelectState* bs, ImGuiWindow* window)\par
07192 \{\par
07193     ImGuiContext& g = *GImGui;\par
07194     IMGUI_DEBUG_LOG_SELECTION({\cf22 "[selection] BeginBoxSelect() 0X%08X: Activate\\n"}, bs->ID);\par
07195     bs->IsActive = {\cf17 true};\par
07196     bs->Window = window;\par
07197     bs->IsStarting = {\cf17 false};\par
07198     ImGui::SetActiveID(bs->ID, window);\par
07199     ImGui::SetActiveIdUsingAllKeyboardKeys();\par
07200     {\cf19 if} (bs->IsStartedFromVoid && (bs->KeyMods & (ImGuiMod_Ctrl | ImGuiMod_Shift)) == 0)\par
07201         bs->RequestClear = {\cf17 true};\par
07202 \}\par
07203 \par
07204 {\cf17 static} {\cf18 void} BoxSelectDeactivateDrag(ImGuiBoxSelectState* bs)\par
07205 \{\par
07206     ImGuiContext& g = *GImGui;\par
07207     bs->IsActive = bs->IsStarting = {\cf17 false};\par
07208     {\cf19 if} (g.ActiveId == bs->ID)\par
07209     \{\par
07210         IMGUI_DEBUG_LOG_SELECTION({\cf22 "[selection] BeginBoxSelect() 0X%08X: Deactivate\\n"}, bs->ID);\par
07211         ImGui::ClearActiveID();\par
07212     \}\par
07213     bs->ID = 0;\par
07214 \}\par
07215 \par
07216 {\cf17 static} {\cf18 void} BoxSelectScrollWithMouseDrag(ImGuiBoxSelectState* bs, ImGuiWindow* window, {\cf17 const} ImRect& inner_r)\par
07217 \{\par
07218     ImGuiContext& g = *GImGui;\par
07219     IM_ASSERT(bs->Window == window);\par
07220     {\cf19 for} ({\cf18 int} n = 0; n < 2; n++) {\cf20 // each axis}\par
07221     \{\par
07222         {\cf17 const} {\cf18 float} mouse_pos = g.IO.MousePos[n];\par
07223         {\cf17 const} {\cf18 float} dist = (mouse_pos > inner_r.Max[n]) ? mouse_pos - inner_r.Max[n] : (mouse_pos < inner_r.Min[n]) ? mouse_pos - inner_r.Min[n] : 0.0f;\par
07224         {\cf17 const} {\cf18 float} scroll_curr = window->Scroll[n];\par
07225         {\cf19 if} (dist == 0.0f || (dist < 0.0f && scroll_curr < 0.0f) || (dist > 0.0f && scroll_curr >= window->ScrollMax[n]))\par
07226             {\cf19 continue};\par
07227 \par
07228         {\cf17 const} {\cf18 float} speed_multiplier = ImLinearRemapClamp(g.FontSize, g.FontSize * 5.0f, 1.0f, 4.0f, ImAbs(dist)); {\cf20 // x1 to x4 depending on distance}\par
07229         {\cf17 const} {\cf18 float} scroll_step = g.FontSize * 35.0f * speed_multiplier * ImSign(dist) * g.IO.DeltaTime;\par
07230         bs->ScrollAccum[n] += scroll_step;\par
07231 \par
07232         {\cf20 // Accumulate into a stored value so we can handle high-framerate}\par
07233         {\cf17 const} {\cf18 float} scroll_step_i = ImFloor(bs->ScrollAccum[n]);\par
07234         {\cf19 if} (scroll_step_i == 0.0f)\par
07235             {\cf19 continue};\par
07236         {\cf19 if} (n == 0)\par
07237             ImGui::SetScrollX(window, scroll_curr + scroll_step_i);\par
07238         {\cf19 else}\par
07239             ImGui::SetScrollY(window, scroll_curr + scroll_step_i);\par
07240         bs->ScrollAccum[n] -= scroll_step_i;\par
07241     \}\par
07242 \}\par
07243 \par
07244 {\cf18 bool} ImGui::BeginBoxSelect({\cf17 const} ImRect& scope_rect, ImGuiWindow* window, ImGuiID box_select_id, ImGuiMultiSelectFlags ms_flags)\par
07245 \{\par
07246     ImGuiContext& g = *GImGui;\par
07247     ImGuiBoxSelectState* bs = &g.BoxSelectState;\par
07248     KeepAliveID(box_select_id);\par
07249     {\cf19 if} (bs->ID != box_select_id)\par
07250         {\cf19 return} {\cf17 false};\par
07251 \par
07252     {\cf20 // IsStarting is set by MultiSelectItemFooter() when considering a possible box-select. We validate it here and lock geometry.}\par
07253     bs->UnclipMode = {\cf17 false};\par
07254     bs->RequestClear = {\cf17 false};\par
07255     {\cf19 if} (bs->IsStarting && IsMouseDragPastThreshold(0))\par
07256         BoxSelectActivateDrag(bs, window);\par
07257     {\cf19 else} {\cf19 if} ((bs->IsStarting || bs->IsActive) && g.IO.MouseDown[0] == {\cf17 false})\par
07258         BoxSelectDeactivateDrag(bs);\par
07259     {\cf19 if} (!bs->IsActive)\par
07260         {\cf19 return} {\cf17 false};\par
07261 \par
07262     {\cf20 // Current frame absolute prev/current rectangles are used to toggle selection.}\par
07263     {\cf20 // They are derived from positions relative to scrolling space.}\par
07264     ImVec2 start_pos_abs = WindowPosRelToAbs(window, bs->StartPosRel);\par
07265     ImVec2 prev_end_pos_abs = WindowPosRelToAbs(window, bs->EndPosRel); {\cf20 // Clamped already}\par
07266     ImVec2 curr_end_pos_abs = g.IO.MousePos;\par
07267     {\cf19 if} (ms_flags & ImGuiMultiSelectFlags_ScopeWindow) {\cf20 // Box-select scrolling only happens with ScopeWindow}\par
07268         curr_end_pos_abs = ImClamp(curr_end_pos_abs, scope_rect.Min, scope_rect.Max);\par
07269     bs->BoxSelectRectPrev.Min = ImMin(start_pos_abs, prev_end_pos_abs);\par
07270     bs->BoxSelectRectPrev.Max = ImMax(start_pos_abs, prev_end_pos_abs);\par
07271     bs->BoxSelectRectCurr.Min = ImMin(start_pos_abs, curr_end_pos_abs);\par
07272     bs->BoxSelectRectCurr.Max = ImMax(start_pos_abs, curr_end_pos_abs);\par
07273 \par
07274     {\cf20 // Box-select 2D mode detects horizontal changes (vertical ones are already picked by Clipper)}\par
07275     {\cf20 // Storing an extra rect used by widgets supporting box-select.}\par
07276     {\cf19 if} (ms_flags & ImGuiMultiSelectFlags_BoxSelect2d)\par
07277         {\cf19 if} (bs->BoxSelectRectPrev.Min.x != bs->BoxSelectRectCurr.Min.x || bs->BoxSelectRectPrev.Max.x != bs->BoxSelectRectCurr.Max.x)\par
07278         \{\par
07279             bs->UnclipMode = {\cf17 true};\par
07280             bs->UnclipRect = bs->BoxSelectRectPrev; {\cf20 // FIXME-OPT: UnclipRect x coordinates could be intersection of Prev and Curr rect on X axis.}\par
07281             bs->UnclipRect.Add(bs->BoxSelectRectCurr);\par
07282         \}\par
07283 \par
07284     {\cf20 //GetForegroundDrawList()->AddRect(bs->UnclipRect.Min, bs->UnclipRect.Max, IM_COL32(255,0,0,200), 0.0f, 0, 3.0f);}\par
07285     {\cf20 //GetForegroundDrawList()->AddRect(bs->BoxSelectRectPrev.Min, bs->BoxSelectRectPrev.Max, IM_COL32(255,0,0,200), 0.0f, 0, 3.0f);}\par
07286     {\cf20 //GetForegroundDrawList()->AddRect(bs->BoxSelectRectCurr.Min, bs->BoxSelectRectCurr.Max, IM_COL32(0,255,0,200), 0.0f, 0, 1.0f);}\par
07287     {\cf19 return} {\cf17 true};\par
07288 \}\par
07289 \par
07290 {\cf18 void} ImGui::EndBoxSelect({\cf17 const} ImRect& scope_rect, ImGuiMultiSelectFlags ms_flags)\par
07291 \{\par
07292     ImGuiContext& g = *GImGui;\par
07293     ImGuiWindow* window = g.CurrentWindow;\par
07294     ImGuiBoxSelectState* bs = &g.BoxSelectState;\par
07295     IM_ASSERT(bs->IsActive);\par
07296     bs->UnclipMode = {\cf17 false};\par
07297 \par
07298     {\cf20 // Render selection rectangle}\par
07299     bs->EndPosRel = WindowPosAbsToRel(window, ImClamp(g.IO.MousePos, scope_rect.Min, scope_rect.Max)); {\cf20 // Clamp stored position according to current scrolling view}\par
07300     ImRect box_select_r = bs->BoxSelectRectCurr;\par
07301     box_select_r.ClipWith(scope_rect);\par
07302     window->DrawList->AddRectFilled(box_select_r.Min, box_select_r.Max, GetColorU32(ImGuiCol_SeparatorHovered, 0.30f)); {\cf20 // FIXME-MULTISELECT: Styling}\par
07303     window->DrawList->AddRect(box_select_r.Min, box_select_r.Max, GetColorU32(ImGuiCol_NavHighlight)); {\cf20 // FIXME-MULTISELECT: Styling}\par
07304 \par
07305     {\cf20 // Scroll}\par
07306     {\cf17 const} {\cf18 bool} enable_scroll = (ms_flags & ImGuiMultiSelectFlags_ScopeWindow) && (ms_flags & ImGuiMultiSelectFlags_BoxSelectNoScroll) == 0;\par
07307     {\cf19 if} (enable_scroll)\par
07308     \{\par
07309         ImRect scroll_r = scope_rect;\par
07310         scroll_r.Expand(-g.FontSize);\par
07311         {\cf20 //GetForegroundDrawList()->AddRect(scroll_r.Min, scroll_r.Max, IM_COL32(0, 255, 0, 255));}\par
07312         {\cf19 if} (!scroll_r.Contains(g.IO.MousePos))\par
07313             BoxSelectScrollWithMouseDrag(bs, window, scroll_r);\par
07314     \}\par
07315 \}\par
