03522 {\cf17 template}<{\cf17 typename} TYPE>\par
03523 {\cf17 static} {\cf17 const} {\cf18 char}* ImAtoi({\cf17 const} {\cf18 char}* src, TYPE* output)\par
03524 \{\par
03525     {\cf18 int} negative = 0;\par
03526     {\cf19 if} (*src == {\cf23 '-'}) \{ negative = 1; src++; \}\par
03527     {\cf19 if} (*src == {\cf23 '+'}) \{ src++; \}\par
03528     TYPE v = 0;\par
03529     {\cf19 while} (*src >= {\cf23 '0'} && *src <= {\cf23 '9'})\par
03530         v = (v * 10) + (*src++ - {\cf23 '0'});\par
03531     *output = negative ? -v : v;\par
03532     {\cf19 return} src;\par
03533 \}\par
