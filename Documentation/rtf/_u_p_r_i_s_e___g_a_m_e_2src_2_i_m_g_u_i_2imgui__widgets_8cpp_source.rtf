09848 {\cf18 bool}    ImGui::TabItemEx(ImGuiTabBar* tab_bar, {\cf17 const} {\cf18 char}* label, {\cf18 bool}* p_open, ImGuiTabItemFlags flags, ImGuiWindow* docked_window)\par
09849 \{\par
09850     {\cf20 // Layout whole tab bar if not already done}\par
09851     ImGuiContext& g = *GImGui;\par
09852     {\cf19 if} (tab_bar->WantLayout)\par
09853     \{\par
09854         ImGuiNextItemData backup_next_item_data = g.NextItemData;\par
09855         TabBarLayout(tab_bar);\par
09856         g.NextItemData = backup_next_item_data;\par
09857     \}\par
09858     ImGuiWindow* window = g.CurrentWindow;\par
09859     {\cf19 if} (window->SkipItems)\par
09860         {\cf19 return} {\cf17 false};\par
09861 \par
09862     {\cf17 const} ImGuiStyle& style = g.Style;\par
09863     {\cf17 const} ImGuiID {\cf18 id} = TabBarCalcTabID(tab_bar, label, docked_window);\par
09864 \par
09865     {\cf20 // If the user called us with *p_open == false, we early out and don't render.}\par
09866     {\cf20 // We make a call to ItemAdd() so that attempts to use a contextual popup menu with an implicit ID won't use an older ID.}\par
09867     IMGUI_TEST_ENGINE_ITEM_INFO({\cf18 id}, label, g.LastItemData.StatusFlags);\par
09868     {\cf19 if} (p_open && !*p_open)\par
09869     \{\par
09870         ItemAdd(ImRect(), {\cf18 id}, NULL, ImGuiItemFlags_NoNav);\par
09871         {\cf19 return} {\cf17 false};\par
09872     \}\par
09873 \par
09874     IM_ASSERT(!p_open || !(flags & ImGuiTabItemFlags_Button));\par
09875     IM_ASSERT((flags & (ImGuiTabItemFlags_Leading | ImGuiTabItemFlags_Trailing)) != (ImGuiTabItemFlags_Leading | ImGuiTabItemFlags_Trailing)); {\cf20 // Can't use both Leading and Trailing}\par
09876 \par
09877     {\cf20 // Store into ImGuiTabItemFlags_NoCloseButton, also honor ImGuiTabItemFlags_NoCloseButton passed by user (although not documented)}\par
09878     {\cf19 if} (flags & ImGuiTabItemFlags_NoCloseButton)\par
09879         p_open = NULL;\par
09880     {\cf19 else} {\cf19 if} (p_open == NULL)\par
09881         flags |= ImGuiTabItemFlags_NoCloseButton;\par
09882 \par
09883     {\cf20 // Acquire tab data}\par
09884     ImGuiTabItem* tab = TabBarFindTabByID(tab_bar, {\cf18 id});\par
09885     {\cf18 bool} tab_is_new = {\cf17 false};\par
09886     {\cf19 if} (tab == NULL)\par
09887     \{\par
09888         tab_bar->Tabs.push_back(ImGuiTabItem());\par
09889         tab = &tab_bar->Tabs.back();\par
09890         tab->ID = id;\par
09891         tab_bar->TabsAddedNew = tab_is_new = {\cf17 true};\par
09892     \}\par
09893     tab_bar->LastTabItemIdx = (ImS16)tab_bar->Tabs.index_from_ptr(tab);\par
09894 \par
09895     {\cf20 // Calculate tab contents size}\par
09896     ImVec2 size = TabItemCalcSize(label, (p_open != NULL) || (flags & ImGuiTabItemFlags_UnsavedDocument));\par
09897     tab->RequestedWidth = -1.0f;\par
09898     {\cf19 if} (g.NextItemData.Flags & ImGuiNextItemDataFlags_HasWidth)\par
09899         size.x = tab->RequestedWidth = g.NextItemData.Width;\par
09900     {\cf19 if} (tab_is_new)\par
09901         tab->Width = ImMax(1.0f, size.x);\par
09902     tab->ContentWidth = size.x;\par
09903     tab->BeginOrder = tab_bar->TabsActiveCount++;\par
09904 \par
09905     {\cf17 const} {\cf18 bool} tab_bar_appearing = (tab_bar->PrevFrameVisible + 1 < g.FrameCount);\par
09906     {\cf17 const} {\cf18 bool} tab_bar_focused = (tab_bar->Flags & ImGuiTabBarFlags_IsFocused) != 0;\par
09907     {\cf17 const} {\cf18 bool} tab_appearing = (tab->LastFrameVisible + 1 < g.FrameCount);\par
09908     {\cf17 const} {\cf18 bool} tab_just_unsaved = (flags & ImGuiTabItemFlags_UnsavedDocument) && !(tab->Flags & ImGuiTabItemFlags_UnsavedDocument);\par
09909     {\cf17 const} {\cf18 bool} is_tab_button = (flags & ImGuiTabItemFlags_Button) != 0;\par
09910     tab->LastFrameVisible = g.FrameCount;\par
09911     tab->Flags = flags;\par
09912     tab->Window = docked_window;\par
09913 \par
09914     {\cf20 // Append name _WITH_ the zero-terminator}\par
09915     {\cf20 // (regular tabs are permitted in a DockNode tab bar, but window tabs not permitted in a non-DockNode tab bar)}\par
09916     {\cf19 if} (docked_window != NULL)\par
09917     \{\par
09918         IM_ASSERT(tab_bar->Flags & ImGuiTabBarFlags_DockNode);\par
09919         tab->NameOffset = -1;\par
09920     \}\par
09921     {\cf19 else}\par
09922     \{\par
09923         tab->NameOffset = (ImS32)tab_bar->TabsNames.size();\par
09924         tab_bar->TabsNames.append(label, label + strlen(label) + 1);\par
09925     \}\par
09926 \par
09927     {\cf20 // Update selected tab}\par
09928     {\cf19 if} (!is_tab_button)\par
09929     \{\par
09930         {\cf19 if} (tab_appearing && (tab_bar->Flags & ImGuiTabBarFlags_AutoSelectNewTabs) && tab_bar->NextSelectedTabId == 0)\par
09931             {\cf19 if} (!tab_bar_appearing || tab_bar->SelectedTabId == 0)\par
09932                 TabBarQueueFocus(tab_bar, tab); {\cf20 // New tabs gets activated}\par
09933         {\cf19 if} ((flags & ImGuiTabItemFlags_SetSelected) && (tab_bar->SelectedTabId != {\cf18 id})) {\cf20 // _SetSelected can only be passed on explicit tab bar}\par
09934             TabBarQueueFocus(tab_bar, tab);\par
09935     \}\par
09936 \par
09937     {\cf20 // Lock visibility}\par
09938     {\cf20 // (Note: tab_contents_visible != tab_selected... because CTRL+TAB operations may preview some tabs without selecting them!)}\par
09939     {\cf18 bool} tab_contents_visible = (tab_bar->VisibleTabId == id);\par
09940     {\cf19 if} (tab_contents_visible)\par
09941         tab_bar->VisibleTabWasSubmitted = {\cf17 true};\par
09942 \par
09943     {\cf20 // On the very first frame of a tab bar we let first tab contents be visible to minimize appearing glitches}\par
09944     {\cf19 if} (!tab_contents_visible && tab_bar->SelectedTabId == 0 && tab_bar_appearing && docked_window == NULL)\par
09945         {\cf19 if} (tab_bar->Tabs.Size == 1 && !(tab_bar->Flags & ImGuiTabBarFlags_AutoSelectNewTabs))\par
09946             tab_contents_visible = {\cf17 true};\par
09947 \par
09948     {\cf20 // Note that tab_is_new is not necessarily the same as tab_appearing! When a tab bar stops being submitted}\par
09949     {\cf20 // and then gets submitted again, the tabs will have 'tab_appearing=true' but 'tab_is_new=false'.}\par
09950     {\cf19 if} (tab_appearing && (!tab_bar_appearing || tab_is_new))\par
09951     \{\par
09952         ItemAdd(ImRect(), {\cf18 id}, NULL, ImGuiItemFlags_NoNav);\par
09953         {\cf19 if} (is_tab_button)\par
09954             {\cf19 return} {\cf17 false};\par
09955         {\cf19 return} tab_contents_visible;\par
09956     \}\par
09957 \par
09958     {\cf19 if} (tab_bar->SelectedTabId == {\cf18 id})\par
09959         tab->LastFrameSelected = g.FrameCount;\par
09960 \par
09961     {\cf20 // Backup current layout position}\par
09962     {\cf17 const} ImVec2 backup_main_cursor_pos = window->DC.CursorPos;\par
