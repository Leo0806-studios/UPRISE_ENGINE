07867             {\cf19 return};\par
07868         \}\par
07869     \}\par
07870 \par
07871     ImGuiSelectionRequest req = \{ ImGuiSelectionRequestType_SetRange, selected, (ImS8)range_dir, (range_dir > 0) ? first_item : last_item, (range_dir > 0) ? last_item : first_item \};\par
07872     ms->IO.Requests.push_back(req); {\cf20 // Add new request}\par
