04063 {\cf18 void} ImGuiInputTextCallbackData::InsertChars({\cf18 int} pos, {\cf17 const} {\cf18 char}* new_text, {\cf17 const} {\cf18 char}* new_text_end)\par
04064 \{\par
04065     {\cf20 // Accept null ranges}\par
04066     {\cf19 if} (new_text == new_text_end)\par
04067         {\cf19 return};\par
04068 \par
04069     {\cf17 const} {\cf18 bool} is_resizable = (Flags & ImGuiInputTextFlags_CallbackResize) != 0;\par
04070     {\cf17 const} {\cf18 int} new_text_len = new_text_end ? (int)(new_text_end - new_text) : (int)strlen(new_text);\par
04071     {\cf19 if} (new_text_len + BufTextLen >= BufSize)\par
04072     \{\par
04073         {\cf19 if} (!is_resizable)\par
04074             {\cf19 return};\par
04075 \par
04076         {\cf20 // Contrary to STB_TEXTEDIT_INSERTCHARS() this is working in the UTF8 buffer, hence the mildly similar code (until we remove the U16 buffer altogether!)}\par
04077         ImGuiContext& g = *Ctx;\par
04078         ImGuiInputTextState* edit_state = &g.InputTextState;\par
04079         IM_ASSERT(edit_state->ID != 0 && g.ActiveId == edit_state->ID);\par
04080         IM_ASSERT(Buf == edit_state->TextA.Data);\par
04081         {\cf18 int} new_buf_size = BufTextLen + ImClamp(new_text_len * 4, 32, ImMax(256, new_text_len)) + 1;\par
04082         edit_state->TextA.reserve(new_buf_size + 1);\par
04083         Buf = edit_state->TextA.Data;\par
04084         BufSize = edit_state->BufCapacityA = new_buf_size;\par
04085     \}\par
04086 \par
04087     {\cf19 if} (BufTextLen != pos)\par
04088         memmove(Buf + pos + new_text_len, Buf + pos, ({\cf18 size_t})(BufTextLen - pos));\par
04089     memcpy(Buf + pos, new_text, ({\cf18 size_t})new_text_len * {\cf17 sizeof}({\cf18 char}));\par
04090     Buf[BufTextLen + new_text_len] = {\cf23 '\\0'};\par
04091 \par
04092     {\cf19 if} (CursorPos >= pos)\par
04093         CursorPos += new_text_len;\par
04094     SelectionStart = SelectionEnd = CursorPos;\par
04095     BufDirty = {\cf17 true};\par
04096     BufTextLen += new_text_len;\par
04097 \}\par
