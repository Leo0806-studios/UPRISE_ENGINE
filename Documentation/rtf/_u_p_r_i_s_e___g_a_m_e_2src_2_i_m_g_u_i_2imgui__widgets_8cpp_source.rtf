03955 {\cf17 static} {\cf18 bool} STB_TEXTEDIT_INSERTCHARS(ImGuiInputTextState* obj, {\cf18 int} pos, {\cf17 const} ImWchar* new_text, {\cf18 int} new_text_len)\par
03956 \{\par
03957     {\cf17 const} {\cf18 bool} is_resizable = (obj->Flags & ImGuiInputTextFlags_CallbackResize) != 0;\par
03958     {\cf17 const} {\cf18 int} text_len = obj->CurLenW;\par
03959     IM_ASSERT(pos <= text_len);\par
03960 \par
03961     {\cf17 const} {\cf18 int} new_text_len_utf8 = ImTextCountUtf8BytesFromStr(new_text, new_text + new_text_len);\par
03962     {\cf19 if} (!is_resizable && (new_text_len_utf8 + obj->CurLenA + 1 > obj->BufCapacityA))\par
03963         {\cf19 return} {\cf17 false};\par
03964 \par
03965     {\cf20 // Grow internal buffer if needed}\par
03966     {\cf19 if} (new_text_len + text_len + 1 > obj->TextW.Size)\par
03967     \{\par
03968         {\cf19 if} (!is_resizable)\par
03969             {\cf19 return} {\cf17 false};\par
03970         IM_ASSERT(text_len < obj->TextW.Size);\par
03971         obj->TextW.resize(text_len + ImClamp(new_text_len * 4, 32, ImMax(256, new_text_len)) + 1);\par
03972     \}\par
03973 \par
03974     ImWchar* text = obj->TextW.Data;\par
03975     {\cf19 if} (pos != text_len)\par
03976         memmove(text + pos + new_text_len, text + pos, ({\cf18 size_t})(text_len - pos) * {\cf17 sizeof}(ImWchar));\par
03977     memcpy(text + pos, new_text, ({\cf18 size_t})new_text_len * {\cf17 sizeof}(ImWchar));\par
03978 \par
03979     obj->Edited = {\cf17 true};\par
03980     obj->CurLenW += new_text_len;\par
03981     obj->CurLenA += new_text_len_utf8;\par
03982     obj->TextW[obj->CurLenW] = {\cf23 '\\0'};\par
03983 \par
03984     {\cf19 return} {\cf17 true};\par
03985 \}\par
