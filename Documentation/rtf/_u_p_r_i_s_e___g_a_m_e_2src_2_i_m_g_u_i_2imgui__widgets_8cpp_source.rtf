09677 {\cf17 static} ImGuiTabItem* ImGui::TabBarScrollingButtons(ImGuiTabBar* tab_bar)\par
09678 \{\par
09679     ImGuiContext& g = *GImGui;\par
09680     ImGuiWindow* window = g.CurrentWindow;\par
09681 \par
09682     {\cf17 const} ImVec2 arrow_button_size(g.FontSize - 2.0f, g.FontSize + g.Style.FramePadding.y * 2.0f);\par
09683     {\cf17 const} {\cf18 float} scrolling_buttons_width = arrow_button_size.x * 2.0f;\par
09684 \par
09685     {\cf17 const} ImVec2 backup_cursor_pos = window->DC.CursorPos;\par
09686     {\cf20 //window->DrawList->AddRect(ImVec2(tab_bar->BarRect.Max.x - scrolling_buttons_width, tab_bar->BarRect.Min.y), ImVec2(tab_bar->BarRect.Max.x, tab_bar->BarRect.Max.y), IM_COL32(255,0,0,255));}\par
09687 \par
09688     {\cf18 int} select_dir = 0;\par
09689     ImVec4 arrow_col = g.Style.Colors[ImGuiCol_Text];\par
09690     arrow_col.w *= 0.5f;\par
09691 \par
09692     PushStyleColor(ImGuiCol_Text, arrow_col);\par
09693     PushStyleColor(ImGuiCol_Button, ImVec4(0, 0, 0, 0));\par
09694     {\cf17 const} {\cf18 float} backup_repeat_delay = g.IO.KeyRepeatDelay;\par
09695     {\cf17 const} {\cf18 float} backup_repeat_rate = g.IO.KeyRepeatRate;\par
09696     g.IO.KeyRepeatDelay = 0.250f;\par
09697     g.IO.KeyRepeatRate = 0.200f;\par
09698     {\cf18 float} x = ImMax(tab_bar->BarRect.Min.x, tab_bar->BarRect.Max.x - scrolling_buttons_width);\par
09699     window->DC.CursorPos = ImVec2(x, tab_bar->BarRect.Min.y);\par
09700     {\cf19 if} (ArrowButtonEx({\cf22 "##<"}, ImGuiDir_Left, arrow_button_size, ImGuiButtonFlags_PressedOnClick | ImGuiButtonFlags_Repeat))\par
09701         select_dir = -1;\par
09702     window->DC.CursorPos = ImVec2(x + arrow_button_size.x, tab_bar->BarRect.Min.y);\par
09703     {\cf19 if} (ArrowButtonEx({\cf22 "##>"}, ImGuiDir_Right, arrow_button_size, ImGuiButtonFlags_PressedOnClick | ImGuiButtonFlags_Repeat))\par
09704         select_dir = +1;\par
09705     PopStyleColor(2);\par
09706     g.IO.KeyRepeatRate = backup_repeat_rate;\par
09707     g.IO.KeyRepeatDelay = backup_repeat_delay;\par
09708 \par
09709     ImGuiTabItem* tab_to_scroll_to = NULL;\par
09710     {\cf19 if} (select_dir != 0)\par
09711         {\cf19 if} (ImGuiTabItem* tab_item = TabBarFindTabByID(tab_bar, tab_bar->SelectedTabId))\par
09712         \{\par
09713             {\cf18 int} selected_order = TabBarGetTabOrder(tab_bar, tab_item);\par
09714             {\cf18 int} target_order = selected_order + select_dir;\par
09715 \par
09716             {\cf20 // Skip tab item buttons until another tab item is found or end is reached}\par
09717             {\cf19 while} (tab_to_scroll_to == NULL)\par
09718             \{\par
09719                 {\cf20 // If we are at the end of the list, still scroll to make our tab visible}\par
09720                 tab_to_scroll_to = &tab_bar->Tabs[(target_order >= 0 && target_order < tab_bar->Tabs.Size) ? target_order : selected_order];\par
09721 \par
09722                 {\cf20 // Cross through buttons}\par
09723                 {\cf20 // (even if first/last item is a button, return it so we can update the scroll)}\par
09724                 {\cf19 if} (tab_to_scroll_to->Flags & ImGuiTabItemFlags_Button)\par
