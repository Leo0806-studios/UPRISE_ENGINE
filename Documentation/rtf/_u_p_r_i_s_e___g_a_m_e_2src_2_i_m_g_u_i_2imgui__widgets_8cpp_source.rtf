06934         \}\par
06935     \}\par
06936 \par
06937     {\cf19 if} (span_all_columns)\par
06938     \{\par
06939         {\cf19 if} (g.CurrentTable)\par
06940             TablePopBackgroundChannel();\par
06941         {\cf19 else} {\cf19 if} (window->DC.CurrentColumns)\par
06942             PopColumnsBackground();\par
06943     \}\par
06944 \par
06945     {\cf19 if} (is_visible)\par
