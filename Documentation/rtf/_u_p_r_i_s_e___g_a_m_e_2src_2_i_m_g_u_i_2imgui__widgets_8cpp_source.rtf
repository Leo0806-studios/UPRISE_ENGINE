06996         clear_buffer |= (g.NavFocusScopeId != data->FocusScope);\par
06997         clear_buffer |= (data->LastRequestTime + TYPING_SELECT_RESET_TIMER < g.Time);\par
06998         clear_buffer |= g.NavAnyRequest;\par
06999         clear_buffer |= g.ActiveId != 0 && g.NavActivateId == 0; {\cf20 // Allow temporary SPACE activation to not interfere}\par
07000         clear_buffer |= IsKeyPressed(ImGuiKey_Escape) || IsKeyPressed(ImGuiKey_Enter);\par
07001         clear_buffer |= IsKeyPressed(ImGuiKey_Backspace) && (flags & ImGuiTypingSelectFlags_AllowBackspace) == 0;\par
07002         {\cf20 //if (clear_buffer) \{ IMGUI_DEBUG_LOG("GetTypingSelectRequest(): Clear SearchBuffer.\\n"); \}}\par
07003         {\cf19 if} (clear_buffer)\par
07004             data->Clear();\par
07005     \}\par
07006 \par
07007     {\cf20 // Append to buffer}\par
07008     {\cf17 const} {\cf18 int} buffer_max_len = IM_ARRAYSIZE(data->SearchBuffer) - 1;\par
07009     {\cf18 int} buffer_len = (int)strlen(data->SearchBuffer);\par
07010     {\cf18 bool} select_request = {\cf17 false};\par
07011     {\cf19 for} (ImWchar w : g.IO.InputQueueCharacters)\par
07012     \{\par
07013         {\cf17 const} {\cf18 int} w_len = ImTextCountUtf8BytesFromStr(&w, &w + 1);\par
07014         {\cf19 if} (w < 32 || (buffer_len == 0 && ImCharIsBlankW(w)) || (buffer_len + w_len > buffer_max_len)) {\cf20 // Ignore leading blanks}\par
07015             {\cf19 continue};\par
07016         {\cf18 char} w_buf[5];\par
07017         ImTextCharToUtf8(w_buf, ({\cf18 unsigned} {\cf18 int})w);\par
07018         {\cf19 if} (data->SingleCharModeLock && w_len == out_request->SingleCharSize && memcmp(w_buf, data->SearchBuffer, w_len) == 0)\par
07019         \{\par
07020             select_request = {\cf17 true}; {\cf20 // Same character: don't need to append to buffer.}\par
07021             {\cf19 continue};\par
07022         \}\par
07023         {\cf19 if} (data->SingleCharModeLock)\par
07024         \{\par
07025             data->Clear(); {\cf20 // Different character: clear}\par
07026             buffer_len = 0;\par
07027         \}\par
07028         memcpy(data->SearchBuffer + buffer_len, w_buf, w_len + 1); {\cf20 // Append}\par
07029         buffer_len += w_len;\par
07030         select_request = {\cf17 true};\par
07031     \}\par
07032     g.IO.InputQueueCharacters.resize(0);\par
07033 \par
07034     {\cf20 // Handle backspace}\par
07035     {\cf19 if} ((flags & ImGuiTypingSelectFlags_AllowBackspace) && IsKeyPressed(ImGuiKey_Backspace, ImGuiInputFlags_Repeat))\par
07036     \{\par
07037         {\cf18 char}* p = ({\cf18 char}*)({\cf18 void}*)ImTextFindPreviousUtf8Codepoint(data->SearchBuffer, data->SearchBuffer + buffer_len);\par
07038         *p = 0;\par
07039         buffer_len = (int)(p - data->SearchBuffer);\par
07040     \}\par
07041 \par
07042     {\cf20 // Return request if any}\par
07043     {\cf19 if} (buffer_len == 0)\par
07044         {\cf19 return} NULL;\par
07045     {\cf19 if} (select_request)\par
07046     \{\par
07047         data->FocusScope = g.NavFocusScopeId;\par
07048         data->LastRequestFrame = g.FrameCount;\par
07049         data->LastRequestTime = (float)g.Time;\par
07050     \}\par
07051     out_request->Flags = flags;\par
07052     out_request->SearchBufferLen = buffer_len;\par
07053     out_request->SearchBuffer = data->SearchBuffer;\par
07054     out_request->SelectRequest = (data->LastRequestFrame == g.FrameCount);\par
07055     out_request->SingleCharMode = {\cf17 false};\par
07056     out_request->SingleCharSize = 0;\par
07057 \par
07058     {\cf20 // Calculate if buffer contains the same character repeated.}\par
07059     {\cf20 // - This can be used to implement a special search mode on first character.}\par
07060     {\cf20 // - Performed on UTF-8 codepoint for correctness.}\par
07061     {\cf20 // - SingleCharMode is always set for first input character, because it usually leads to a "next".}\par
07062     {\cf19 if} (flags & ImGuiTypingSelectFlags_AllowSingleCharMode)\par
07063     \{\par
07064         {\cf17 const} {\cf18 char}* buf_begin = out_request->SearchBuffer;\par
07065         {\cf17 const} {\cf18 char}* buf_end = out_request->SearchBuffer + out_request->SearchBufferLen;\par
07066         {\cf17 const} {\cf18 int} c0_len = ImTextCountUtf8BytesFromChar(buf_begin, buf_end);\par
07067         {\cf17 const} {\cf18 char}* p = buf_begin + c0_len;\par
07068         {\cf19 for} (; p < buf_end; p += c0_len)\par
07069             {\cf19 if} (memcmp(buf_begin, p, ({\cf18 size_t})c0_len) != 0)\par
07070                 {\cf19 break};\par
07071         {\cf17 const} {\cf18 int} single_char_count = (p == buf_end) ? (out_request->SearchBufferLen / c0_len) : 0;\par
07072         out_request->SingleCharMode = (single_char_count > 0 || data->SingleCharModeLock);\par
07073         out_request->SingleCharSize = (ImS8)c0_len;\par
07074         data->SingleCharModeLock |= (single_char_count >= TYPING_SELECT_SINGLE_CHAR_COUNT_FOR_LOCK); {\cf20 // From now on we stop search matching to lock to single char mode.}\par
07075     \}\par
07076 \par
07077     {\cf19 return} out_request;\par
07078 \}\par
07079 \par
07080 {\cf17 static} {\cf18 int} ImStrimatchlen({\cf17 const} {\cf18 char}* s1, {\cf17 const} {\cf18 char}* s1_end, {\cf17 const} {\cf18 char}* s2)\par
07081 \{\par
07082     {\cf18 int} match_len = 0;\par
07083     {\cf19 while} (s1 < s1_end && ImToUpper(*s1++) == ImToUpper(*s2++))\par
07084         match_len++;\par
07085     {\cf19 return} match_len;\par
07086 \}\par
07087 \par
07088 {\cf20 // Default handler for finding a result for typing-select. You may implement your own.}\par
07089 {\cf20 // You might want to display a tooltip to visualize the current request SearchBuffer}\par
07090 {\cf20 // When SingleCharMode is set:}\par
07091 {\cf20 // - it is better to NOT display a tooltip of other on-screen display indicator.}\par
07092 {\cf20 // - the index of the currently focused item is required.}\par
07093 {\cf20 //   if your SetNextItemSelectionUserData() values are indices, you can obtain it from ImGuiMultiSelectIO::NavIdItem, otherwise from g.NavLastValidSelectionUserData.}\par
07094 {\cf18 int} ImGui::TypingSelectFindMatch(ImGuiTypingSelectRequest* req, {\cf18 int} items_count, {\cf17 const} {\cf18 char}* (*get_item_name_func)({\cf18 void}*, {\cf18 int}), {\cf18 void}* user_data, {\cf18 int} nav_item_idx)\par
07095 \{\par
07096     {\cf19 if} (req == NULL || req->SelectRequest == {\cf17 false}) {\cf20 // Support NULL parameter so both calls can be done from same spot.}\par
07097         {\cf19 return} -1;\par
07098     {\cf18 int} idx = -1;\par
07099     {\cf19 if} (req->SingleCharMode && (req->Flags & ImGuiTypingSelectFlags_AllowSingleCharMode))\par
07100         idx = TypingSelectFindNextSingleCharMatch(req, items_count, get_item_name_func, user_data, nav_item_idx);\par
07101     {\cf19 else}\par
07102         idx = TypingSelectFindBestLeadingMatch(req, items_count, get_item_name_func, user_data);\par
07103     {\cf19 if} (idx != -1)\par
07104         NavRestoreHighlightAfterMove();\par
07105     {\cf19 return} idx;\par
07106 \}\par
07107 \par
07108 {\cf20 // Special handling when a single character is repeated: perform search on a single letter and goes to next.}\par
07109 {\cf18 int} ImGui::TypingSelectFindNextSingleCharMatch(ImGuiTypingSelectRequest* req, {\cf18 int} items_count, {\cf17 const} {\cf18 char}* (*get_item_name_func)({\cf18 void}*, {\cf18 int}), {\cf18 void}* user_data, {\cf18 int} nav_item_idx)\par
07110 \{\par
07111     {\cf20 // FIXME: Assume selection user data is index. Would be extremely practical.}\par
07112     {\cf20 //if (nav_item_idx == -1)}\par
07113     {\cf20 //    nav_item_idx = (int)g.NavLastValidSelectionUserData;}\par
07114 \par
07115     {\cf18 int} first_match_idx = -1;\par
07116     {\cf18 bool} return_next_match = {\cf17 false};\par
07117     {\cf19 for} ({\cf18 int} idx = 0; idx < items_count; idx++)\par
07118     \{\par
07119         {\cf17 const} {\cf18 char}* item_name = get_item_name_func(user_data, idx);\par
07120         {\cf19 if} (ImStrimatchlen(req->SearchBuffer, req->SearchBuffer + req->SingleCharSize, item_name) < req->SingleCharSize)\par
07121             {\cf19 continue};\par
07122         {\cf19 if} (return_next_match)                           {\cf20 // Return next matching item after current item.}\par
07123             {\cf19 return} idx;\par
07124         {\cf19 if} (first_match_idx == -1 && nav_item_idx == -1) {\cf20 // Return first match immediately if we don't have a nav_item_idx value.}\par
07125             {\cf19 return} idx;\par
07126         {\cf19 if} (first_match_idx == -1)                       {\cf20 // Record first match for wrapping.}\par
07127             first_match_idx = idx;\par
07128         {\cf19 if} (nav_item_idx == idx)                         {\cf20 // Record that we encountering nav_item so we can return next match.}\par
07129             return_next_match = {\cf17 true};\par
07130     \}\par
07131     {\cf19 return} first_match_idx; {\cf20 // First result}\par
07132 \}\par
07133 \par
07134 {\cf18 int} ImGui::TypingSelectFindBestLeadingMatch(ImGuiTypingSelectRequest* req, {\cf18 int} items_count, {\cf17 const} {\cf18 char}* (*get_item_name_func)({\cf18 void}*, {\cf18 int}), {\cf18 void}* user_data)\par
07135 \{\par
07136     {\cf18 int} longest_match_idx = -1;\par
07137     {\cf18 int} longest_match_len = 0;\par
07138     {\cf19 for} ({\cf18 int} idx = 0; idx < items_count; idx++)\par
07139     \{\par
07140         {\cf17 const} {\cf18 char}* item_name = get_item_name_func(user_data, idx);\par
07141         {\cf17 const} {\cf18 int} match_len = ImStrimatchlen(req->SearchBuffer, req->SearchBuffer + req->SearchBufferLen, item_name);\par
07142         {\cf19 if} (match_len <= longest_match_len)\par
07143             {\cf19 continue};\par
07144         longest_match_idx = idx;\par
07145         longest_match_len = match_len;\par
07146         {\cf19 if} (match_len == req->SearchBufferLen)\par
07147             {\cf19 break};\par
07148     \}\par
07149     {\cf19 return} longest_match_idx;\par
07150 \}\par
