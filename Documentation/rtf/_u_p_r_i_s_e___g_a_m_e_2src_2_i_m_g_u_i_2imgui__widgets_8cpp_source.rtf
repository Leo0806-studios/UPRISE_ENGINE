07340 {\cf17 static} ImRect CalcScopeRect(ImGuiMultiSelectTempData* ms, ImGuiWindow* window)\par
07341 \{\par
07342     {\cf19 if} (ms->Flags & ImGuiMultiSelectFlags_ScopeRect)\par
07343     \{\par
07344         {\cf20 // Warning: this depends on CursorMaxPos so it means to be called by EndMultiSelect() only}\par
07345         {\cf19 return} ImRect(ms->ScopeRectMin, ImMax(window->DC.CursorMaxPos, ms->ScopeRectMin));\par
07346     \}\par
07347     {\cf19 else}\par
07348     \{\par
07349         {\cf20 // Add inner table decoration (#7821) // FIXME: Why not baking in InnerClipRect?}\par
07350         ImRect scope_rect = window->InnerClipRect;\par
07351         scope_rect.Min = ImMin(scope_rect.Min + ImVec2(window->DecoInnerSizeX1, window->DecoInnerSizeY1), scope_rect.Max);\par
07352         {\cf19 return} scope_rect;\par
07353     \}\par
07354 \}\par
07355 \par
07356 {\cf20 // Return ImGuiMultiSelectIO structure.}\par
07357 {\cf20 // Lifetime: don't hold on ImGuiMultiSelectIO* pointers over multiple frames or past any subsequent call to BeginMultiSelect() or EndMultiSelect().}\par
07358 {\cf20 // Passing 'selection_size' and 'items_count' parameters is currently optional.}\par
07359 {\cf20 // - 'selection_size' is useful to disable some shortcut routing: e.g. ImGuiMultiSelectFlags_ClearOnEscape won't claim Escape key when selection_size 0,}\par
07360 {\cf20 //    allowing a first press to clear selection THEN the second press to leave child window and return to parent.}\par
07361 {\cf20 // - 'items_count' is stored in ImGuiMultiSelectIO which makes it a convenient way to pass the information to your ApplyRequest() handler (but you may pass it differently).}\par
