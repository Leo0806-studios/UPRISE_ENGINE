07929 \{\par
07930     {\cf18 int} lhs_v = (({\cf17 const} ImGuiStoragePair*)lhs)->val_i;\par
07931     {\cf18 int} rhs_v = (({\cf17 const} ImGuiStoragePair*)rhs)->val_i;\par
