00507         item_flags |= ImGuiItemFlags_ButtonRepeat;\par
00508 \par
00509     ImGuiWindow* backup_hovered_window = g.HoveredWindow;\par
00510     {\cf17 const} {\cf18 bool} flatten_hovered_children = (flags & ImGuiButtonFlags_FlattenChildren) && g.HoveredWindow && g.HoveredWindow->RootWindowDockTree == window->RootWindowDockTree;\par
00511     {\cf19 if} (flatten_hovered_children)\par
00512         g.HoveredWindow = window;\par
00513 \par
00514 {\cf21 #ifdef IMGUI_ENABLE_TEST_ENGINE}\par
00515     {\cf20 // Alternate registration spot, for when caller didn't use ItemAdd()}\par
00516     {\cf19 if} (g.LastItemData.ID != {\cf18 id})\par
00517         IMGUI_TEST_ENGINE_ITEM_ADD({\cf18 id}, bb, NULL);\par
00518 {\cf21 #endif}\par
00519 \par
00520     {\cf18 bool} pressed = {\cf17 false};\par
00521     {\cf18 bool} hovered = ItemHoverable(bb, {\cf18 id}, item_flags);\par
00522 \par
00523     {\cf20 // Special mode for Drag and Drop where holding button pressed for a long time while dragging another item triggers the button}\par
