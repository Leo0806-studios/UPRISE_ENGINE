01326 {\cf20 // size_arg (for each axis) < 0.0f: align to end, 0.0f: auto, > 0.0f: specified size}\par
01327 {\cf18 void} ImGui::ProgressBar({\cf18 float} fraction, {\cf17 const} ImVec2& size_arg, {\cf17 const} {\cf18 char}* overlay)\par
01328 \{\par
01329     ImGuiWindow* window = GetCurrentWindow();\par
01330     {\cf19 if} (window->SkipItems)\par
01331         {\cf19 return};\par
01332 \par
01333     ImGuiContext& g = *GImGui;\par
01334     {\cf17 const} ImGuiStyle& style = g.Style;\par
01335 \par
01336     ImVec2 pos = window->DC.CursorPos;\par
01337     ImVec2 size = CalcItemSize(size_arg, CalcItemWidth(), g.FontSize + style.FramePadding.y * 2.0f);\par
01338     ImRect bb(pos, pos + size);\par
01339     ItemSize(size, style.FramePadding.y);\par
01340     {\cf19 if} (!ItemAdd(bb, 0))\par
01341         {\cf19 return};\par
01342 \par
01343     {\cf20 // Fraction < 0.0f will display an indeterminate progress bar animation}\par
01344     {\cf20 // The value must be animated along with time, so e.g. passing '-1.0f * ImGui::GetTime()' as fraction works.}\par
01345     {\cf17 const} {\cf18 bool} is_indeterminate = (fraction < 0.0f);\par
01346     {\cf19 if} (!is_indeterminate)\par
01347         fraction = ImSaturate(fraction);\par
01348 \par
01349     {\cf20 // Out of courtesy we accept a NaN fraction without crashing}\par
01350     {\cf18 float} fill_n0 = 0.0f;\par
01351     {\cf18 float} fill_n1 = (fraction == fraction) ? fraction : 0.0f;\par
01352 \par
01353     {\cf19 if} (is_indeterminate)\par
01354     \{\par
01355         {\cf17 const} {\cf18 float} fill_width_n = 0.2f;\par
01356         fill_n0 = ImFmod(-fraction, 1.0f) * (1.0f + fill_width_n) - fill_width_n;\par
01357         fill_n1 = ImSaturate(fill_n0 + fill_width_n);\par
01358         fill_n0 = ImSaturate(fill_n0);\par
01359     \}\par
01360 \par
01361     {\cf20 // Render}\par
01362     RenderFrame(bb.Min, bb.Max, GetColorU32(ImGuiCol_FrameBg), {\cf17 true}, style.FrameRounding);\par
01363     bb.Expand(ImVec2(-style.FrameBorderSize, -style.FrameBorderSize));\par
01364     RenderRectFilledRangeH(window->DrawList, bb, GetColorU32(ImGuiCol_PlotHistogram), fill_n0, fill_n1, style.FrameRounding);\par
01365 \par
01366     {\cf20 // Default displaying the fraction as percentage string, but user can override it}\par
01367     {\cf20 // Don't display text for indeterminate bars by default}\par
01368     {\cf18 char} overlay_buf[32];\par
01369     {\cf19 if} (!is_indeterminate || overlay != NULL)\par
01370     \{\par
01371         {\cf19 if} (!overlay)\par
01372         \{\par
01373             ImFormatString(overlay_buf, IM_ARRAYSIZE(overlay_buf), {\cf22 "%.0f%%"}, fraction * 100 + 0.01f);\par
01374             overlay = overlay_buf;\par
01375         \}\par
01376 \par
01377         ImVec2 overlay_size = CalcTextSize(overlay, NULL);\par
01378         {\cf19 if} (overlay_size.x > 0.0f)\par
01379         \{\par
01380             {\cf18 float} text_x = is_indeterminate ? (bb.Min.x + bb.Max.x - overlay_size.x) * 0.5f : ImLerp(bb.Min.x, bb.Max.x, fill_n1) + style.ItemSpacing.x;\par
01381             RenderTextClipped(ImVec2(ImClamp(text_x, bb.Min.x, bb.Max.x - overlay_size.x - style.ItemInnerSpacing.x), bb.Min.y), bb.Max, overlay, NULL, &overlay_size, ImVec2(0.0f, 0.5f), &bb);\par
01382         \}\par
01383     \}\par
01384 \}\par
