02252 {\cf20 // User can input math operators (e.g. +100) to edit a numerical values.}\par
02253 {\cf20 // NB: This is _not_ a full expression evaluator. We should probably add one and replace this dumb mess..}\par
02254 {\cf18 bool} ImGui::DataTypeApplyFromText({\cf17 const} {\cf18 char}* buf, ImGuiDataType data_type, {\cf18 void}* p_data, {\cf17 const} {\cf18 char}* format, {\cf18 void}* p_data_when_empty)\par
02255 \{\par
02256     {\cf20 // Copy the value in an opaque buffer so we can compare at the end of the function if it changed at all.}\par
02257     {\cf17 const} ImGuiDataTypeInfo* type_info = DataTypeGetInfo(data_type);\par
02258     ImGuiDataTypeStorage data_backup;\par
02259     memcpy(&data_backup, p_data, type_info->Size);\par
02260 \par
02261     {\cf19 while} (ImCharIsBlankA(*buf))\par
02262         buf++;\par
02263     {\cf19 if} (!buf[0])\par
02264     \{\par
02265         {\cf19 if} (p_data_when_empty != NULL)\par
02266         \{\par
02267             memcpy(p_data, p_data_when_empty, type_info->Size);\par
02268             {\cf19 return} memcmp(&data_backup, p_data, type_info->Size) != 0;\par
02269         \}\par
02270         {\cf19 return} {\cf17 false};\par
02271     \}\par
02272 \par
02273     {\cf20 // Sanitize format}\par
02274     {\cf20 // - For float/double we have to ignore format with precision (e.g. "%.2f") because sscanf doesn't take them in, so force them into %f and %lf}\par
02275     {\cf20 // - In theory could treat empty format as using default, but this would only cover rare/bizarre case of using InputScalar() + integer + format string without %.}\par
02276     {\cf18 char} format_sanitized[32];\par
02277     {\cf19 if} (data_type == ImGuiDataType_Float || data_type == ImGuiDataType_Double)\par
02278         format = type_info->ScanFmt;\par
02279     {\cf19 else}\par
02280         format = ImParseFormatSanitizeForScanning(format, format_sanitized, IM_ARRAYSIZE(format_sanitized));\par
02281 \par
02282     {\cf20 // Small types need a 32-bit buffer to receive the result from scanf()}\par
02283     {\cf18 int} v32 = 0;\par
02284     {\cf19 if} (sscanf(buf, format, type_info->Size >= 4 ? p_data : &v32) < 1)\par
02285         return false;\par
02286     {\cf19 if} (type_info->Size < 4)\par
02287     \{\par
02288         {\cf19 if} (data_type == ImGuiDataType_S8)\par
02289             *(ImS8*)p_data = (ImS8)ImClamp(v32, ({\cf18 int})IM_S8_MIN, ({\cf18 int})IM_S8_MAX);\par
02290         {\cf19 else} {\cf19 if} (data_type == ImGuiDataType_U8)\par
02291             *(ImU8*)p_data = (ImU8)ImClamp(v32, ({\cf18 int})IM_U8_MIN, ({\cf18 int})IM_U8_MAX);\par
02292         {\cf19 else} {\cf19 if} (data_type == ImGuiDataType_S16)\par
02293             *(ImS16*)p_data = (ImS16)ImClamp(v32, ({\cf18 int})IM_S16_MIN, ({\cf18 int})IM_S16_MAX);\par
02294         {\cf19 else} {\cf19 if} (data_type == ImGuiDataType_U16)\par
02295             *(ImU16*)p_data = (ImU16)ImClamp(v32, ({\cf18 int})IM_U16_MIN, ({\cf18 int})IM_U16_MAX);\par
02296         {\cf19 else}\par
02297             IM_ASSERT(0);\par
02298     \}\par
02299 \par
02300     {\cf19 return} memcmp(&data_backup, p_data, type_info->Size) != 0;\par
02301 \}\par
