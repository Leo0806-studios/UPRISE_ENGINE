07759         {\cf20 // Box-select}\par
07760         ImGuiInputSource input_source = (g.NavJustMovedToId == {\cf18 id} || g.NavActivateId == id) ? g.NavInputSource : ImGuiInputSource_Mouse;\par
07761         {\cf19 if} (flags & (ImGuiMultiSelectFlags_BoxSelect1d | ImGuiMultiSelectFlags_BoxSelect2d))\par
07762             {\cf19 if} (selected == {\cf17 false} && !g.BoxSelectState.IsActive && !g.BoxSelectState.IsStarting && input_source == ImGuiInputSource_Mouse && g.IO.MouseClickedCount[0] == 1)\par
07763                 BoxSelectPreStartDrag(ms->BoxSelectId, item_data);\par
07764 \par
07765         {\cf20 //----------------------------------------------------------------------------------------}\par
07766         {\cf20 // ACTION                      | Begin  | Pressed/Activated  | End}\par
07767         {\cf20 //----------------------------------------------------------------------------------------}\par
07768         {\cf20 // Keys Navigated:             | Clear  | Src=item, Sel=1               SetRange 1}\par
07769         {\cf20 // Keys Navigated: Ctrl        | n/a    | n/a}\par
07770         {\cf20 // Keys Navigated:      Shift  | n/a    | Dst=item, Sel=1,   => Clear + SetRange 1}\par
07771         {\cf20 // Keys Navigated: Ctrl+Shift  | n/a    | Dst=item, Sel=Src  => Clear + SetRange Src-Dst}\par
07772         {\cf20 // Keys Activated:             | n/a    | Src=item, Sel=1    => Clear + SetRange 1}\par
07773         {\cf20 // Keys Activated: Ctrl        | n/a    | Src=item, Sel=!Sel =>         SetSange 1}\par
07774         {\cf20 // Keys Activated:      Shift  | n/a    | Dst=item, Sel=1    => Clear + SetSange 1}\par
07775         {\cf20 //----------------------------------------------------------------------------------------}\par
07776         {\cf20 // Mouse Pressed:              | n/a    | Src=item, Sel=1,   => Clear + SetRange 1}\par
07777         {\cf20 // Mouse Pressed:  Ctrl        | n/a    | Src=item, Sel=!Sel =>         SetRange 1}\par
07778         {\cf20 // Mouse Pressed:       Shift  | n/a    | Dst=item, Sel=1,   => Clear + SetRange 1}\par
07779         {\cf20 // Mouse Pressed:  Ctrl+Shift  | n/a    | Dst=item, Sel=!Sel =>         SetRange Src-Dst}\par
07780         {\cf20 //----------------------------------------------------------------------------------------}\par
07781 \par
07782         {\cf19 if} ((flags & ImGuiMultiSelectFlags_NoAutoClear) == 0)\par
07783         \{\par
07784             {\cf18 bool} request_clear = {\cf17 false};\par
07785             {\cf19 if} (is_singleselect)\par
07786                 request_clear = {\cf17 true};\par
07787             {\cf19 else} {\cf19 if} ((input_source == ImGuiInputSource_Mouse || g.NavActivateId == {\cf18 id}) && !is_ctrl)\par
07788                 request_clear = (flags & ImGuiMultiSelectFlags_NoAutoClearOnReselect) ? !selected : true;\par
07789             {\cf19 else} {\cf19 if} ((input_source == ImGuiInputSource_Keyboard || input_source == ImGuiInputSource_Gamepad) && is_shift && !is_ctrl)\par
07790                 request_clear = {\cf17 true}; {\cf20 // With is_shift==false the RequestClear was done in BeginIO, not necessary to do again.}\par
07791             {\cf19 if} (request_clear)\par
07792                 MultiSelectAddSetAll(ms, {\cf17 false});\par
07793         \}\par
07794 \par
07795         {\cf18 int} range_direction;\par
07796         {\cf18 bool} range_selected;\par
07797         {\cf19 if} (is_shift && !is_singleselect)\par
07798         \{\par
07799             {\cf20 //IM_ASSERT(storage->HasRangeSrc && storage->HasRangeValue);}\par
07800             {\cf19 if} (storage->RangeSrcItem == ImGuiSelectionUserData_Invalid)\par
07801                 storage->RangeSrcItem = item_data;\par
07802             {\cf19 if} ((flags & ImGuiMultiSelectFlags_NoAutoSelect) == 0)\par
07803             \{\par
07804                 {\cf20 // Shift+Arrow always select}\par
07805                 {\cf20 // Ctrl+Shift+Arrow copy source selection state (already stored by BeginMultiSelect() in storage->RangeSelected)}\par
07806                 range_selected = (is_ctrl && storage->RangeSelected != -1) ? (storage->RangeSelected != 0) : {\cf17 true};\par
07807             \}\par
07808             {\cf19 else}\par
07809             \{\par
07810                 {\cf20 // Shift+Arrow copy source selection state}\par
07811                 {\cf20 // Shift+Click always copy from target selection state}\par
07812                 {\cf19 if} (ms->IsKeyboardSetRange)\par
07813                     range_selected = (storage->RangeSelected != -1) ? (storage->RangeSelected != 0) : {\cf17 true};\par
07814                 {\cf19 else}\par
07815                     range_selected = !selected;\par
07816             \}\par
07817             range_direction = ms->RangeSrcPassedBy ? +1 : -1;\par
07818         \}\par
07819         {\cf19 else}\par
07820         \{\par
07821             {\cf20 // Ctrl inverts selection, otherwise always select}\par
07822             {\cf19 if} ((flags & ImGuiMultiSelectFlags_NoAutoSelect) == 0)\par
07823                 selected = is_ctrl ? !selected : true;\par
07824             {\cf19 else}\par
07825                 selected = !selected;\par
07826             storage->RangeSrcItem = item_data;\par
07827             range_selected = selected;\par
07828             range_direction = +1;\par
07829         \}\par
07830         MultiSelectAddSetRange(ms, range_selected, range_direction, storage->RangeSrcItem, item_data);\par
07831     \}\par
07832 \par
07833     {\cf20 // Update/store the selection state of the Source item (used by CTRL+SHIFT, when Source is unselected we perform a range unselect)}\par
07834     {\cf19 if} (storage->RangeSrcItem == item_data)\par
07835         storage->RangeSelected = selected ? 1 : 0;\par
07836 \par
07837     {\cf20 // Update/store the selection state of focused item}\par
07838     {\cf19 if} (g.NavId == {\cf18 id})\par
07839     \{\par
07840         storage->NavIdItem = item_data;\par
07841         storage->NavIdSelected = selected ? 1 : 0;\par
07842     \}\par
07843     {\cf19 if} (storage->NavIdItem == item_data)\par
07844         ms->NavIdPassedBy = {\cf17 true};\par
07845     ms->LastSubmittedItem = item_data;\par
07846 \par
07847     *p_selected = selected;\par
07848     *p_pressed = pressed;\par
07849 \}\par
