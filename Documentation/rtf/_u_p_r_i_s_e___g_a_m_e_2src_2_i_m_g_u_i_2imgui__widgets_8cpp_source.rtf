00573                     \}\par
00574                     {\cf19 else}\par
00575                     \{\par
00576                         FocusWindow(window, ImGuiFocusRequestFlags_RestoreFocusedChild); {\cf20 // Still need to focus and bring to front, but try to avoid losing NavId when navigating a child}\par
00577                     \}\par
00578                 \}\par
00579                 {\cf19 if} ((flags & ImGuiButtonFlags_PressedOnClick) || ((flags & ImGuiButtonFlags_PressedOnDoubleClick) && g.IO.MouseClickedCount[mouse_button_clicked] == 2))\par
00580                 \{\par
00581                     pressed = {\cf17 true};\par
00582                     {\cf19 if} (flags & ImGuiButtonFlags_NoHoldingActiveId)\par
00583                         ClearActiveID();\par
00584                     {\cf19 else}\par
00585                         SetActiveID({\cf18 id}, window); {\cf20 // Hold on ID}\par
00586                     g.ActiveIdMouseButton = mouse_button_clicked;\par
00587                     {\cf19 if} (!(flags & ImGuiButtonFlags_NoNavFocus))\par
00588                     \{\par
00589                         SetFocusID({\cf18 id}, window);\par
00590                         FocusWindow(window);\par
00591                     \}\par
00592                     {\cf19 else}\par
00593                     \{\par
00594                         FocusWindow(window, ImGuiFocusRequestFlags_RestoreFocusedChild); {\cf20 // Still need to focus and bring to front, but try to avoid losing NavId when navigating a child}\par
00595                     \}\par
00596                 \}\par
00597             \}\par
00598             {\cf19 if} (flags & ImGuiButtonFlags_PressedOnRelease)\par
00599             \{\par
00600                 {\cf19 if} (mouse_button_released != -1)\par
00601                 \{\par
00602                     {\cf17 const} {\cf18 bool} has_repeated_at_least_once = (item_flags & ImGuiItemFlags_ButtonRepeat) && g.IO.MouseDownDurationPrev[mouse_button_released] >= g.IO.KeyRepeatDelay; {\cf20 // Repeat mode trumps on release behavior}\par
00603                     {\cf19 if} (!has_repeated_at_least_once)\par
