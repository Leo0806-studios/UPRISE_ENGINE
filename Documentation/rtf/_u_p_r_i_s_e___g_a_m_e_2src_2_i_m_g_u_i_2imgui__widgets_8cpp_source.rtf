07164 {\cf20 // [SECTION] Widgets: Box-Select support}\par
07165 {\cf20 // This has been extracted away from Multi-Select logic in the hope that it could eventually be used elsewhere, but hasn't been yet.}\par
07166 {\cf20 //-------------------------------------------------------------------------}\par
07167 {\cf20 // Extra logic in MultiSelectItemFooter() and ImGuiListClipper::Step()}\par
07168 {\cf20 //-------------------------------------------------------------------------}\par
07169 {\cf20 // - BoxSelectPreStartDrag() [Internal]}\par
07170 {\cf20 // - BoxSelectActivateDrag() [Internal]}\par
07171 {\cf20 // - BoxSelectDeactivateDrag() [Internal]}\par
07172 {\cf20 // - BoxSelectScrollWithMouseDrag() [Internal]}\par
07173 {\cf20 // - BeginBoxSelect() [Internal]}\par
