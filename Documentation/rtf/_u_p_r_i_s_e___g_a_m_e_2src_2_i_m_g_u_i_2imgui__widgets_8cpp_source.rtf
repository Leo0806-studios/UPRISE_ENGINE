03535 {\cf20 // Parse display precision back from the display format string}\par
03536 {\cf20 // FIXME: This is still used by some navigation code path to infer a minimum tweak step, but we should aim to rework widgets so it isn't needed.}\par
03537 {\cf18 int} ImParseFormatPrecision({\cf17 const} {\cf18 char}* fmt, {\cf18 int} default_precision)\par
03538 \{\par
03539     fmt = ImParseFormatFindStart(fmt);\par
03540     {\cf19 if} (fmt[0] != {\cf23 '%'})\par
03541         {\cf19 return} default_precision;\par
03542     fmt++;\par
03543     {\cf19 while} (*fmt >= {\cf23 '0'} && *fmt <= {\cf23 '9'})\par
03544         fmt++;\par
03545     {\cf18 int} precision = INT_MAX;\par
03546     {\cf19 if} (*fmt == {\cf23 '.'})\par
03547     \{\par
03548         fmt = ImAtoi<int>(fmt + 1, &precision);\par
03549         {\cf19 if} (precision < 0 || precision > 99)\par
03550             precision = default_precision;\par
03551     \}\par
03552     {\cf19 if} (*fmt == {\cf23 'e'} || *fmt == {\cf23 'E'}) {\cf20 // Maximum precision with scientific notation}\par
03553         precision = -1;\par
03554     {\cf19 if} ((*fmt == {\cf23 'g'} || *fmt == {\cf23 'G'}) && precision == INT_MAX)\par
03555         precision = -1;\par
03556     {\cf19 return} (precision == INT_MAX) ? default_precision : precision;\par
03557 \}\par
