03166         {\cf19 return} SliderBehaviorT<double, double, double>(bb, {\cf18 id}, data_type, ({\cf18 double}*)p_v, *({\cf17 const} {\cf18 double}*)p_min, *({\cf17 const} {\cf18 double}*)p_max, format, flags, out_grab_bb);\par
