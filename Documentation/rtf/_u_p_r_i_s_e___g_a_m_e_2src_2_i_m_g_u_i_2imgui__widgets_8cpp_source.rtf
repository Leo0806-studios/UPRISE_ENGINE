07336         {\cf19 if} (req.Type == ImGuiSelectionRequestType_SetRange)  IMGUI_DEBUG_LOG_SELECTION({\cf22 "[selection] %s: Request: SetRange %"} IM_PRId64 {\cf22 "..%"} IM_PRId64 {\cf22 " (0x%"} IM_PRIX64 {\cf22 "..0x%"} IM_PRIX64 {\cf22 ") = %d (dir %d)\\n"}, function, req.RangeFirstItem, req.RangeLastItem, req.RangeFirstItem, req.RangeLastItem, req.Selected, req.RangeDirection);\par
07337     \}\par
