06920             {\cf20 // FIXME-MULTISELECT: Styling: Color for 'selected' elements? ImGuiCol_HeaderSelected}\par
06921             ImU32 col;\par
06922             {\cf19 if} (selected && !highlighted)\par
06923                 col = GetColorU32(ImLerp(GetStyleColorVec4(ImGuiCol_Header), GetStyleColorVec4(ImGuiCol_HeaderHovered), 0.5f));\par
