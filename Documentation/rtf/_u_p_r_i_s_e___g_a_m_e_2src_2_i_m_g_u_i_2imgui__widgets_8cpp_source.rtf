00829 {\cf20 // Button to close a window}\par
00830 {\cf18 bool} ImGui::CloseButton(ImGuiID {\cf18 id}, {\cf17 const} ImVec2& pos)\par
00831 \{\par
00832     ImGuiContext& g = *GImGui;\par
00833     ImGuiWindow* window = g.CurrentWindow;\par
00834 \par
00835     {\cf20 // Tweak 1: Shrink hit-testing area if button covers an abnormally large proportion of the visible region. That's in order to facilitate moving the window away. (#3825)}\par
00836     {\cf20 // This may better be applied as a general hit-rect reduction mechanism for all widgets to ensure the area to move window is always accessible?}\par
00837     {\cf17 const} ImRect bb(pos, pos + ImVec2(g.FontSize, g.FontSize));\par
00838     ImRect bb_interact = bb;\par
00839     {\cf17 const} {\cf18 float} area_to_visible_ratio = window->OuterRectClipped.GetArea() / bb.GetArea();\par
00840     {\cf19 if} (area_to_visible_ratio < 1.5f)\par
00841         bb_interact.Expand(ImTrunc(bb_interact.GetSize() * -0.25f));\par
00842 \par
00843     {\cf20 // Tweak 2: We intentionally allow interaction when clipped so that a mechanical Alt,Right,Activate sequence can always close a window.}\par
00844     {\cf20 // (this isn't the common behavior of buttons, but it doesn't affect the user because navigation tends to keep items visible in scrolling layer).}\par
00845     {\cf18 bool} is_clipped = !ItemAdd(bb_interact, {\cf18 id});\par
00846 \par
00847     {\cf18 bool} hovered, held;\par
00848     {\cf18 bool} pressed = ButtonBehavior(bb_interact, {\cf18 id}, &hovered, &held);\par
00849     {\cf19 if} (is_clipped)\par
00850         {\cf19 return} pressed;\par
00851 \par
00852     {\cf20 // Render}\par
00853     ImU32 bg_col = GetColorU32(held ? ImGuiCol_ButtonActive : ImGuiCol_ButtonHovered);\par
00854     {\cf19 if} (hovered)\par
00855         window->DrawList->AddRectFilled(bb.Min, bb.Max, bg_col);\par
00856     RenderNavHighlight(bb, {\cf18 id}, ImGuiNavHighlightFlags_Compact);\par
00857     ImU32 cross_col = GetColorU32(ImGuiCol_Text);\par
00858     ImVec2 cross_center = bb.GetCenter() - ImVec2(0.5f, 0.5f);\par
00859     {\cf18 float} cross_extent = g.FontSize * 0.5f * 0.7071f - 1.0f;\par
00860     window->DrawList->AddLine(cross_center + ImVec2(+cross_extent, +cross_extent), cross_center + ImVec2(-cross_extent, -cross_extent), cross_col, 1.0f);\par
00861     window->DrawList->AddLine(cross_center + ImVec2(+cross_extent, -cross_extent), cross_center + ImVec2(-cross_extent, +cross_extent), cross_col, 1.0f);\par
00862 \par
00863     {\cf19 return} pressed;\par
00864 \}\par
