07979 {\cf17 static} {\cf18 void} ImGuiSelectionBasicStorage_BatchFinish(ImGuiSelectionBasicStorage* selection, {\cf18 bool} selected, {\cf18 int} size_before_amends)\par
07980 \{\par
07981     ImGuiStorage* storage = &selection->_Storage;\par
07982     {\cf19 if} (selected && selection->Size != size_before_amends)\par
07983         storage->BuildSortByKey(); {\cf20 // When done selecting: sort everything}\par
07984 \}\par
07985 \par
07986 {\cf20 // Apply requests coming from BeginMultiSelect() and EndMultiSelect().}\par
07987 {\cf20 // - Enable 'Demo->Tools->Debug Log->Selection' to see selection requests as they happen.}\par
07988 {\cf20 // - Honoring SetRange requests requires that you can iterate/interpolate between RangeFirstItem and RangeLastItem.}\par
07989 {\cf20 //   - In this demo we often submit indices to SetNextItemSelectionUserData() + store the same indices in persistent selection.}\par
07990 {\cf20 //   - Your code may do differently. If you store pointers or objects ID in ImGuiSelectionUserData you may need to perform}\par
07991 {\cf20 //     a lookup in order to have some way to iterate/interpolate between two items.}\par
07992 {\cf20 // - A full-featured application is likely to allow search/filtering which is likely to lead to using indices}\par
07993 {\cf20 //   and constructing a view index <> object id/ptr data structure anyway.}\par
07994 {\cf20 // WHEN YOUR APPLICATION SETTLES ON A CHOICE, YOU WILL PROBABLY PREFER TO GET RID OF THIS UNNECESSARY 'ImGuiSelectionBasicStorage' INDIRECTION LOGIC.}\par
07995 {\cf20 // Notice that with the simplest adapter (using indices everywhere), all functions return their parameters.}\par
07996 {\cf20 // The most simple implementation (using indices everywhere) would look like:}\par
07997 {\cf20 //   for (ImGuiSelectionRequest& req : ms_io->Requests)}\par
07998 {\cf20 //   \{}\par
07999 {\cf20 //      if (req.Type == ImGuiSelectionRequestType_SetAll)    \{ Clear(); if (req.Selected) \{ for (int n = 0; n < items_count; n++) \{ SetItemSelected(n, true); \} \}}\par
08000 {\cf20 //      if (req.Type == ImGuiSelectionRequestType_SetRange)  \{ for (int n = (int)ms_io->RangeFirstItem; n <= (int)ms_io->RangeLastItem; n++) \{ SetItemSelected(n, ms_io->Selected); \} \}}\par
08001 {\cf20 //   \}}\par
08002 {\cf18 void} ImGuiSelectionBasicStorage::ApplyRequests(ImGuiMultiSelectIO* ms_io)\par
08003 \{\par
08004     {\cf20 // For convenience we obtain ItemsCount as passed to BeginMultiSelect(), which is optional.}\par
08005     {\cf20 // It makes sense when using ImGuiSelectionBasicStorage to simply pass your items count to BeginMultiSelect().}\par
08006     {\cf20 // Other scheme may handle SetAll differently.}\par
08007     IM_ASSERT(ms_io->ItemsCount != -1 && {\cf22 "Missing value for items_count in BeginMultiSelect() call!"});\par
08008     IM_ASSERT(AdapterIndexToStorageId != NULL);\par
08009 \par
08010     {\cf20 // This is optimized/specialized to cope with very large selections (e.g. 100k+ items)}\par
08011     {\cf20 // - A simpler version could call SetItemSelected() directly instead of ImGuiSelectionBasicStorage_BatchSetItemSelected() + ImGuiSelectionBasicStorage_BatchFinish().}\par
08012     {\cf20 // - Optimized select can append unsorted, then sort in a second pass. Optimized unselect can clear in-place then compact in a second pass.}\par
08013     {\cf20 // - A more optimal version wouldn't even use ImGuiStorage but directly a ImVector<ImGuiID> to reduce bandwidth, but this is a reasonable trade off to reuse code.}\par
08014     {\cf20 // - There are many ways this could be better optimized. The worse case scenario being: using BoxSelect2d in a grid, box-select scrolling down while wiggling}\par
08015     {\cf20 //   left and right: it affects coarse clipping + can emit multiple SetRange with 1 item each.)}\par
08016     {\cf20 // FIXME-OPT: For each block of consecutive SetRange request:}\par
08017     {\cf20 // - add all requests to a sorted list, store ID, selected, offset in ImGuiStorage.}\par
08018     {\cf20 // - rewrite sorted storage a single time.}\par
08019     {\cf19 for} (ImGuiSelectionRequest& req : ms_io->Requests)\par
08020     \{\par
08021         {\cf19 if} (req.Type == ImGuiSelectionRequestType_SetAll)\par
08022         \{\par
08023             Clear();\par
08024             {\cf19 if} (req.Selected)\par
08025             \{\par
08026                 _Storage.Data.reserve(ms_io->ItemsCount);\par
08027                 {\cf17 const} {\cf18 int} size_before_amends = _Storage.Data.Size;\par
08028                 {\cf19 for} ({\cf18 int} idx = 0; idx < ms_io->ItemsCount; idx++, _SelectionOrder++)\par
08029                     ImGuiSelectionBasicStorage_BatchSetItemSelected({\cf17 this}, GetStorageIdFromIndex(idx), req.Selected, size_before_amends, _SelectionOrder);\par
08030                 ImGuiSelectionBasicStorage_BatchFinish({\cf17 this}, req.Selected, size_before_amends);\par
08031             \}\par
08032         \}\par
08033         {\cf19 else} {\cf19 if} (req.Type == ImGuiSelectionRequestType_SetRange)\par
08034         \{\par
08035             {\cf17 const} {\cf18 int} selection_changes = (int)req.RangeLastItem - ({\cf18 int})req.RangeFirstItem + 1;\par
08036             {\cf20 //ImGuiContext& g = *GImGui; IMGUI_DEBUG_LOG_SELECTION("Req %d/%d: set %d to %d\\n", ms_io->Requests.index_from_ptr(&req), ms_io->Requests.Size, selection_changes, req.Selected);}\par
08037             {\cf19 if} (selection_changes == 1 || (selection_changes < Size / 100))\par
08038             \{\par
08039                 {\cf20 // Multiple sorted insertion + copy likely to be faster.}\par
08040                 {\cf20 // Technically we could do a single copy with a little more work (sort sequential SetRange requests)}\par
08041                 {\cf19 for} ({\cf18 int} idx = ({\cf18 int})req.RangeFirstItem; idx <= (int)req.RangeLastItem; idx++)\par
08042                     SetItemSelected(GetStorageIdFromIndex(idx), req.Selected);\par
08043             \}\par
08044             {\cf19 else}\par
08045             \{\par
08046                 {\cf20 // Append insertion + single sort likely be faster.}\par
08047                 {\cf20 // Use req.RangeDirection to set order field so that shift+clicking from 1 to 5 is different than shift+clicking from 5 to 1}\par
08048                 {\cf17 const} {\cf18 int} size_before_amends = _Storage.Data.Size;\par
08049                 {\cf18 int} selection_order = _SelectionOrder + ((req.RangeDirection < 0) ? selection_changes - 1 : 0);\par
08050                 {\cf19 for} ({\cf18 int} idx = ({\cf18 int})req.RangeFirstItem; idx <= (int)req.RangeLastItem; idx++, selection_order += req.RangeDirection)\par
08051                     ImGuiSelectionBasicStorage_BatchSetItemSelected({\cf17 this}, GetStorageIdFromIndex(idx), req.Selected, size_before_amends, selection_order);\par
08052                 {\cf19 if} (req.Selected)\par
08053                     _SelectionOrder += selection_changes;\par
08054                 ImGuiSelectionBasicStorage_BatchFinish({\cf17 this}, req.Selected, size_before_amends);\par
08055             \}\par
08056         \}\par
08057     \}\par
08058 \}\par
08059 \par
