01930     {\cf20 // This is essentially a specialized version of BeginPopupEx()}\par
01931     {\cf18 char} name[16];\par
01932     ImFormatString(name, IM_ARRAYSIZE(name), {\cf22 "##Combo_%02d"}, g.BeginComboDepth); {\cf20 // Recycle windows based on depth}\par
