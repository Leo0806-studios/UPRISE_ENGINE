05353     {\cf20 // Read stored options}\par
05354     {\cf19 if} (!(flags & ImGuiColorEditFlags_DisplayMask_))\par
05355         flags |= (g.ColorEditOptions & ImGuiColorEditFlags_DisplayMask_);\par
05356     {\cf19 if} (!(flags & ImGuiColorEditFlags_DataTypeMask_))\par
05357         flags |= (g.ColorEditOptions & ImGuiColorEditFlags_DataTypeMask_);\par
05358     {\cf19 if} (!(flags & ImGuiColorEditFlags_PickerMask_))\par
05359         flags |= (g.ColorEditOptions & ImGuiColorEditFlags_PickerMask_);\par
05360     {\cf19 if} (!(flags & ImGuiColorEditFlags_InputMask_))\par
05361         flags |= (g.ColorEditOptions & ImGuiColorEditFlags_InputMask_);\par
05362     flags |= (g.ColorEditOptions & ~(ImGuiColorEditFlags_DisplayMask_ | ImGuiColorEditFlags_DataTypeMask_ | ImGuiColorEditFlags_PickerMask_ | ImGuiColorEditFlags_InputMask_));\par
05363     IM_ASSERT(ImIsPowerOfTwo(flags & ImGuiColorEditFlags_DisplayMask_)); {\cf20 // Check that only 1 is selected}\par
05364     IM_ASSERT(ImIsPowerOfTwo(flags & ImGuiColorEditFlags_InputMask_));   {\cf20 // Check that only 1 is selected}\par
05365 \par
05366     {\cf17 const} {\cf18 bool} alpha = (flags & ImGuiColorEditFlags_NoAlpha) == 0;\par
05367     {\cf17 const} {\cf18 bool} hdr = (flags & ImGuiColorEditFlags_HDR) != 0;\par
05368     {\cf17 const} {\cf18 int} components = alpha ? 4 : 3;\par
05369     {\cf17 const} {\cf18 float} w_button = (flags & ImGuiColorEditFlags_NoSmallPreview) ? 0.0f : (square_sz + style.ItemInnerSpacing.x);\par
05370     {\cf17 const} {\cf18 float} w_inputs = ImMax(w_full - w_button, 1.0f);\par
05371     w_full = w_inputs + w_button;\par
05372 \par
05373     {\cf20 // Convert to the formats we need}\par
05374     {\cf18 float} f[4] = \{ col[0], col[1], col[2], alpha ? col[3] : 1.0f \};\par
05375     {\cf19 if} ((flags & ImGuiColorEditFlags_InputHSV) && (flags & ImGuiColorEditFlags_DisplayRGB))\par
05376         ColorConvertHSVtoRGB(f[0], f[1], f[2], f[0], f[1], f[2]);\par
05377     {\cf19 else} {\cf19 if} ((flags & ImGuiColorEditFlags_InputRGB) && (flags & ImGuiColorEditFlags_DisplayHSV))\par
05378     \{\par
05379         {\cf20 // Hue is lost when converting from grayscale rgb (saturation=0). Restore it.}\par
05380         ColorConvertRGBtoHSV(f[0], f[1], f[2], f[0], f[1], f[2]);\par
05381         ColorEditRestoreHS(col, &f[0], &f[1], &f[2]);\par
05382     \}\par
05383     {\cf18 int} i[4] = \{ IM_F32_TO_INT8_UNBOUND(f[0]), IM_F32_TO_INT8_UNBOUND(f[1]), IM_F32_TO_INT8_UNBOUND(f[2]), IM_F32_TO_INT8_UNBOUND(f[3]) \};\par
05384 \par
05385     {\cf18 bool} value_changed = {\cf17 false};\par
05386     {\cf18 bool} value_changed_as_float = {\cf17 false};\par
05387 \par
05388     {\cf17 const} ImVec2 pos = window->DC.CursorPos;\par
05389     {\cf17 const} {\cf18 float} inputs_offset_x = (style.ColorButtonPosition == ImGuiDir_Left) ? w_button : 0.0f;\par
05390     window->DC.CursorPos.x = pos.x + inputs_offset_x;\par
05391 \par
05392     {\cf19 if} ((flags & (ImGuiColorEditFlags_DisplayRGB | ImGuiColorEditFlags_DisplayHSV)) != 0 && (flags & ImGuiColorEditFlags_NoInputs) == 0)\par
05393     \{\par
05394         {\cf20 // RGB/HSV 0..255 Sliders}\par
05395         {\cf17 const} {\cf18 float} w_items = w_inputs - style.ItemInnerSpacing.x * (components - 1);\par
05396 \par
05397         {\cf17 const} {\cf18 bool} hide_prefix = (IM_TRUNC(w_items / components) <= CalcTextSize((flags & ImGuiColorEditFlags_Float) ? {\cf22 "M:0.000"} : {\cf22 "M:000"}).x);\par
05398         {\cf17 static} {\cf17 const} {\cf18 char}* ids[4] = \{ {\cf22 "##X"}, {\cf22 "##Y"}, {\cf22 "##Z"}, {\cf22 "##W"} \};\par
05399         {\cf17 static} {\cf17 const} {\cf18 char}* fmt_table_int[3][4] =\par
05400         \{\par
05401             \{   {\cf22 "%3d"},   {\cf22 "%3d"},   {\cf22 "%3d"},   {\cf22 "%3d"} \}, {\cf20 // Short display}\par
05402             \{ {\cf22 "R:%3d"}, {\cf22 "G:%3d"}, {\cf22 "B:%3d"}, {\cf22 "A:%3d"} \}, {\cf20 // Long display for RGBA}\par
05403             \{ {\cf22 "H:%3d"}, {\cf22 "S:%3d"}, {\cf22 "V:%3d"}, {\cf22 "A:%3d"} \}  {\cf20 // Long display for HSVA}\par
05404         \};\par
05405         {\cf17 static} {\cf17 const} {\cf18 char}* fmt_table_float[3][4] =\par
05406         \{\par
05407             \{   {\cf22 "%0.3f"},   {\cf22 "%0.3f"},   {\cf22 "%0.3f"},   {\cf22 "%0.3f"} \}, {\cf20 // Short display}\par
05408             \{ {\cf22 "R:%0.3f"}, {\cf22 "G:%0.3f"}, {\cf22 "B:%0.3f"}, {\cf22 "A:%0.3f"} \}, {\cf20 // Long display for RGBA}\par
05409             \{ {\cf22 "H:%0.3f"}, {\cf22 "S:%0.3f"}, {\cf22 "V:%0.3f"}, {\cf22 "A:%0.3f"} \}  {\cf20 // Long display for HSVA}\par
05410         \};\par
05411         {\cf17 const} {\cf18 int} fmt_idx = hide_prefix ? 0 : (flags & ImGuiColorEditFlags_DisplayHSV) ? 2 : 1;\par
05412 \par
05413         {\cf18 float} prev_split = 0.0f;\par
05414         {\cf19 for} ({\cf18 int} n = 0; n < components; n++)\par
05415         \{\par
05416             {\cf19 if} (n > 0)\par
05417                 SameLine(0, style.ItemInnerSpacing.x);\par
05418             {\cf18 float} next_split = IM_TRUNC(w_items * (n + 1) / components);\par
05419             SetNextItemWidth(ImMax(next_split - prev_split, 1.0f));\par
05420             prev_split = next_split;\par
05421 \par
05422             {\cf20 // FIXME: When ImGuiColorEditFlags_HDR flag is passed HS values snap in weird ways when SV values go below 0.}\par
05423             {\cf19 if} (flags & ImGuiColorEditFlags_Float)\par
05424             \{\par
05425                 value_changed |= DragFloat(ids[n], &f[n], 1.0f / 255.0f, 0.0f, hdr ? 0.0f : 1.0f, fmt_table_float[fmt_idx][n]);\par
05426                 value_changed_as_float |= value_changed;\par
05427             \}\par
05428             {\cf19 else}\par
05429             \{\par
05430                 value_changed |= DragInt(ids[n], &i[n], 1.0f, 0, hdr ? 0 : 255, fmt_table_int[fmt_idx][n]);\par
05431             \}\par
05432             {\cf19 if} (!(flags & ImGuiColorEditFlags_NoOptions))\par
05433                 OpenPopupOnItemClick({\cf22 "context"}, ImGuiPopupFlags_MouseButtonRight);\par
05434         \}\par
05435     \}\par
05436     {\cf19 else} {\cf19 if} ((flags & ImGuiColorEditFlags_DisplayHex) != 0 && (flags & ImGuiColorEditFlags_NoInputs) == 0)\par
05437     \{\par
05438         {\cf20 // RGB Hexadecimal Input}\par
05439         {\cf18 char} buf[64];\par
05440         {\cf19 if} (alpha)\par
05441             ImFormatString(buf, IM_ARRAYSIZE(buf), {\cf22 "#%02X%02X%02X%02X"}, ImClamp(i[0], 0, 255), ImClamp(i[1], 0, 255), ImClamp(i[2], 0, 255), ImClamp(i[3], 0, 255));\par
05442         {\cf19 else}\par
05443             ImFormatString(buf, IM_ARRAYSIZE(buf), {\cf22 "#%02X%02X%02X"}, ImClamp(i[0], 0, 255), ImClamp(i[1], 0, 255), ImClamp(i[2], 0, 255));\par
05444         SetNextItemWidth(w_inputs);\par
05445         {\cf19 if} (InputText({\cf22 "##Text"}, buf, IM_ARRAYSIZE(buf), ImGuiInputTextFlags_CharsUppercase))\par
05446         \{\par
05447             value_changed = {\cf17 true};\par
05448             {\cf18 char}* p = buf;\par
05449             {\cf19 while} (*p == {\cf23 '#'} || ImCharIsBlankA(*p))\par
05450                 p++;\par
05451             i[0] = i[1] = i[2] = 0;\par
05452             i[3] = 0xFF; {\cf20 // alpha default to 255 is not parsed by scanf (e.g. inputting #FFFFFF omitting alpha)}\par
05453             {\cf18 int} r;\par
05454             {\cf19 if} (alpha)\par
05455                 r = sscanf(p, {\cf22 "%02X%02X%02X%02X"}, ({\cf18 unsigned} {\cf18 int}*)&i[0], ({\cf18 unsigned} {\cf18 int}*)&i[1], ({\cf18 unsigned} {\cf18 int}*)&i[2], ({\cf18 unsigned} {\cf18 int}*)&i[3]); {\cf20 // Treat at unsigned (%X is unsigned)}\par
05456             {\cf19 else}\par
05457                 r = sscanf(p, {\cf22 "%02X%02X%02X"}, ({\cf18 unsigned} {\cf18 int}*)&i[0], ({\cf18 unsigned} {\cf18 int}*)&i[1], ({\cf18 unsigned} {\cf18 int}*)&i[2]);\par
05458             IM_UNUSED(r); {\cf20 // Fixes C6031: Return value ignored: 'sscanf'.}\par
05459         \}\par
05460         {\cf19 if} (!(flags & ImGuiColorEditFlags_NoOptions))\par
05461             OpenPopupOnItemClick({\cf22 "context"}, ImGuiPopupFlags_MouseButtonRight);\par
05462     \}\par
05463 \par
05464     ImGuiWindow* picker_active_window = NULL;\par
05465     {\cf19 if} (!(flags & ImGuiColorEditFlags_NoSmallPreview))\par
05466     \{\par
05467         {\cf17 const} {\cf18 float} button_offset_x = ((flags & ImGuiColorEditFlags_NoInputs) || (style.ColorButtonPosition == ImGuiDir_Left)) ? 0.0f : w_inputs + style.ItemInnerSpacing.x;\par
05468         window->DC.CursorPos = ImVec2(pos.x + button_offset_x, pos.y);\par
05469 \par
05470         {\cf17 const} ImVec4 col_v4(col[0], col[1], col[2], alpha ? col[3] : 1.0f);\par
05471         {\cf19 if} (ColorButton({\cf22 "##ColorButton"}, col_v4, flags))\par
05472         \{\par
05473             {\cf19 if} (!(flags & ImGuiColorEditFlags_NoPicker))\par
05474             \{\par
05475                 {\cf20 // Store current color and open a picker}\par
05476                 g.ColorPickerRef = col_v4;\par
05477                 OpenPopup({\cf22 "picker"});\par
05478                 SetNextWindowPos(g.LastItemData.Rect.GetBL() + ImVec2(0.0f, style.ItemSpacing.y));\par
05479             \}\par
05480         \}\par
05481         {\cf19 if} (!(flags & ImGuiColorEditFlags_NoOptions))\par
05482             OpenPopupOnItemClick({\cf22 "context"}, ImGuiPopupFlags_MouseButtonRight);\par
05483 \par
05484         {\cf19 if} (BeginPopup({\cf22 "picker"}))\par
05485         \{\par
05486             {\cf19 if} (g.CurrentWindow->BeginCount == 1)\par
05487             \{\par
05488                 picker_active_window = g.CurrentWindow;\par
05489                 {\cf19 if} (label != label_display_end)\par
05490                 \{\par
05491                     TextEx(label, label_display_end);\par
05492                     Spacing();\par
05493                 \}\par
05494                 ImGuiColorEditFlags picker_flags_to_forward = ImGuiColorEditFlags_DataTypeMask_ | ImGuiColorEditFlags_PickerMask_ | ImGuiColorEditFlags_InputMask_ | ImGuiColorEditFlags_HDR | ImGuiColorEditFlags_NoAlpha | ImGuiColorEditFlags_AlphaBar;\par
05495                 ImGuiColorEditFlags picker_flags = (flags_untouched & picker_flags_to_forward) | ImGuiColorEditFlags_DisplayMask_ | ImGuiColorEditFlags_NoLabel | ImGuiColorEditFlags_AlphaPreviewHalf;\par
05496                 SetNextItemWidth(square_sz * 12.0f); {\cf20 // Use 256 + bar sizes?}\par
05497                 value_changed |= ColorPicker4({\cf22 "##picker"}, col, picker_flags, &g.ColorPickerRef.x);\par
05498             \}\par
05499             EndPopup();\par
05500         \}\par
05501     \}\par
05502 \par
05503     {\cf19 if} (label != label_display_end && !(flags & ImGuiColorEditFlags_NoLabel))\par
05504     \{\par
05505         {\cf20 // Position not necessarily next to last submitted button (e.g. if style.ColorButtonPosition == ImGuiDir_Left),}\par
05506         {\cf20 // but we need to use SameLine() to setup baseline correctly. Might want to refactor SameLine() to simplify this.}\par
05507         SameLine(0.0f, style.ItemInnerSpacing.x);\par
05508         window->DC.CursorPos.x = pos.x + ((flags & ImGuiColorEditFlags_NoInputs) ? w_button : w_full + style.ItemInnerSpacing.x);\par
05509         TextEx(label, label_display_end);\par
05510     \}\par
05511 \par
05512     {\cf20 // Convert back}\par
05513     {\cf19 if} (value_changed && picker_active_window == NULL)\par
05514     \{\par
05515         {\cf19 if} (!value_changed_as_float)\par
05516             {\cf19 for} ({\cf18 int} n = 0; n < 4; n++)\par
05517                 f[n] = i[n] / 255.0f;\par
05518         {\cf19 if} ((flags & ImGuiColorEditFlags_DisplayHSV) && (flags & ImGuiColorEditFlags_InputRGB))\par
05519         \{\par
05520             g.ColorEditSavedHue = f[0];\par
05521             g.ColorEditSavedSat = f[1];\par
05522             ColorConvertHSVtoRGB(f[0], f[1], f[2], f[0], f[1], f[2]);\par
05523             g.ColorEditSavedID = g.ColorEditCurrentID;\par
05524             g.ColorEditSavedColor = ColorConvertFloat4ToU32(ImVec4(f[0], f[1], f[2], 0));\par
05525         \}\par
05526         {\cf19 if} ((flags & ImGuiColorEditFlags_DisplayRGB) && (flags & ImGuiColorEditFlags_InputHSV))\par
05527             ColorConvertRGBtoHSV(f[0], f[1], f[2], f[0], f[1], f[2]);\par
05528 \par
05529         col[0] = f[0];\par
05530         col[1] = f[1];\par
05531         col[2] = f[2];\par
05532         {\cf19 if} (alpha)\par
05533             col[3] = f[3];\par
05534     \}\par
05535 \par
05536     {\cf19 if} (set_current_color_edit_id)\par
05537         g.ColorEditCurrentID = 0;\par
