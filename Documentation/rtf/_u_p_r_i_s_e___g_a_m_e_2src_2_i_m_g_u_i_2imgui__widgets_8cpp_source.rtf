08873 {\cf18 bool} ImGui::MenuItemEx({\cf17 const} {\cf18 char}* label, {\cf17 const} {\cf18 char}* icon, {\cf17 const} {\cf18 char}* shortcut, {\cf18 bool} selected, {\cf18 bool} enabled)\par
08874 \{\par
08875     ImGuiWindow* window = GetCurrentWindow();\par
08876     {\cf19 if} (window->SkipItems)\par
08877         {\cf19 return} {\cf17 false};\par
08878 \par
08879     ImGuiContext& g = *GImGui;\par
08880     ImGuiStyle& style = g.Style;\par
08881     ImVec2 pos = window->DC.CursorPos;\par
08882     ImVec2 label_size = CalcTextSize(label, NULL, {\cf17 true});\par
08883 \par
08884     {\cf20 // See BeginMenuEx() for comments about this.}\par
08885     {\cf17 const} {\cf18 bool} menuset_is_open = IsRootOfOpenMenuSet();\par
08886     {\cf19 if} (menuset_is_open)\par
08887         PushItemFlag(ImGuiItemFlags_NoWindowHoverableCheck, {\cf17 true});\par
08888 \par
08889     {\cf20 // We've been using the equivalent of ImGuiSelectableFlags_SetNavIdOnHover on all Selectable() since early Nav system days (commit 43ee5d73),}\par
08890     {\cf20 // but I am unsure whether this should be kept at all. For now moved it to be an opt-in feature used by menus only.}\par
08891     {\cf18 bool} pressed;\par
08892     PushID(label);\par
08893     {\cf19 if} (!enabled)\par
08894         BeginDisabled();\par
08895 \par
08896     {\cf20 // We use ImGuiSelectableFlags_NoSetKeyOwner to allow down on one menu item, move, up on another.}\par
08897     {\cf17 const} ImGuiSelectableFlags selectable_flags = ImGuiSelectableFlags_SelectOnRelease | ImGuiSelectableFlags_NoSetKeyOwner | ImGuiSelectableFlags_SetNavIdOnHover;\par
08898     {\cf17 const} ImGuiMenuColumns* offsets = &window->DC.MenuColumns;\par
08899     {\cf19 if} (window->DC.LayoutType == ImGuiLayoutType_Horizontal)\par
08900     \{\par
08901         {\cf20 // Mimic the exact layout spacing of BeginMenu() to allow MenuItem() inside a menu bar, which is a little misleading but may be useful}\par
08902         {\cf20 // Note that in this situation: we don't render the shortcut, we render a highlight instead of the selected tick mark.}\par
08903         {\cf18 float} w = label_size.x;\par
08904         window->DC.CursorPos.x += IM_TRUNC(style.ItemSpacing.x * 0.5f);\par
08905         ImVec2 text_pos(window->DC.CursorPos.x + offsets->OffsetLabel, window->DC.CursorPos.y + window->DC.CurrLineTextBaseOffset);\par
08906         PushStyleVar(ImGuiStyleVar_ItemSpacing, ImVec2(style.ItemSpacing.x * 2.0f, style.ItemSpacing.y));\par
08907         pressed = Selectable({\cf22 ""}, selected, selectable_flags, ImVec2(w, 0.0f));\par
08908         PopStyleVar();\par
08909         {\cf19 if} (g.LastItemData.StatusFlags & ImGuiItemStatusFlags_Visible)\par
08910             RenderText(text_pos, label);\par
08911         window->DC.CursorPos.x += IM_TRUNC(style.ItemSpacing.x * (-1.0f + 0.5f)); {\cf20 // -1 spacing to compensate the spacing added when Selectable() did a SameLine(). It would also work to call SameLine() ourselves after the PopStyleVar().}\par
08912     \}\par
08913     {\cf19 else}\par
08914     \{\par
08915         {\cf20 // Menu item inside a vertical menu}\par
08916         {\cf20 // (In a typical menu window where all items are BeginMenu() or MenuItem() calls, extra_w will always be 0.0f.}\par
08917         {\cf20 //  Only when they are other items sticking out we're going to add spacing, yet only register minimum width into the layout system.}\par
08918         {\cf18 float} icon_w = (icon && icon[0]) ? CalcTextSize(icon, NULL).x : 0.0f;\par
08919         {\cf18 float} shortcut_w = (shortcut && shortcut[0]) ? CalcTextSize(shortcut, NULL).x : 0.0f;\par
08920         {\cf18 float} checkmark_w = IM_TRUNC(g.FontSize * 1.20f);\par
08921         {\cf18 float} min_w = window->DC.MenuColumns.DeclColumns(icon_w, label_size.x, shortcut_w, checkmark_w); {\cf20 // Feedback for next frame}\par
08922         {\cf18 float} stretch_w = ImMax(0.0f, GetContentRegionAvail().x - min_w);\par
08923         pressed = Selectable({\cf22 ""}, {\cf17 false}, selectable_flags | ImGuiSelectableFlags_SpanAvailWidth, ImVec2(min_w, label_size.y));\par
08924         {\cf19 if} (g.LastItemData.StatusFlags & ImGuiItemStatusFlags_Visible)\par
08925         \{\par
08926             RenderText(pos + ImVec2(offsets->OffsetLabel, 0.0f), label);\par
08927             {\cf19 if} (icon_w > 0.0f)\par
08928                 RenderText(pos + ImVec2(offsets->OffsetIcon, 0.0f), icon);\par
08929             {\cf19 if} (shortcut_w > 0.0f)\par
08930             \{\par
08931                 PushStyleColor(ImGuiCol_Text, style.Colors[ImGuiCol_TextDisabled]);\par
08932                 RenderText(pos + ImVec2(offsets->OffsetShortcut + stretch_w, 0.0f), shortcut, NULL, {\cf17 false});\par
08933                 PopStyleColor();\par
08934             \}\par
08935             {\cf19 if} (selected)\par
08936                 RenderCheckMark(window->DrawList, pos + ImVec2(offsets->OffsetMark + stretch_w + g.FontSize * 0.40f, g.FontSize * 0.134f * 0.5f), GetColorU32(ImGuiCol_Text), g.FontSize * 0.866f);\par
08937         \}\par
08938     \}\par
08939     IMGUI_TEST_ENGINE_ITEM_INFO(g.LastItemData.ID, label, g.LastItemData.StatusFlags | ImGuiItemStatusFlags_Checkable | (selected ? ImGuiItemStatusFlags_Checked : 0));\par
08940     {\cf19 if} (!enabled)\par
08941         EndDisabled();\par
08942     PopID();\par
08943     {\cf19 if} (menuset_is_open)\par
08944         PopItemFlag();\par
08945 \par
08946     {\cf19 return} pressed;\par
08947 \}\par
