05544     \{\par
05545         {\cf18 bool} accepted_drag_drop = {\cf17 false};\par
05546         {\cf19 if} ({\cf17 const} ImGuiPayload* payload = AcceptDragDropPayload(IMGUI_PAYLOAD_TYPE_COLOR_3F))\par
05547         \{\par
05548             memcpy(({\cf18 float}*)col, payload->Data, {\cf17 sizeof}({\cf18 float}) * 3); {\cf20 // Preserve alpha if any //-V512 //-V1086}\par
05549             value_changed = accepted_drag_drop = {\cf17 true};\par
05550         \}\par
