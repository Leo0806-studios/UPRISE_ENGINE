01757 {\cf20 // Shrink excess width from a set of item, by removing width from the larger items first.}\par
01758 {\cf20 // Set items Width to -1.0f to disable shrinking this item.}\par
01759 {\cf18 void} ImGui::ShrinkWidths(ImGuiShrinkWidthItem* items, {\cf18 int} count, {\cf18 float} width_excess)\par
01760 \{\par
01761     {\cf19 if} (count == 1)\par
01762     \{\par
01763         {\cf19 if} (items[0].Width >= 0.0f)\par
01764             items[0].Width = ImMax(items[0].Width - width_excess, 1.0f);\par
01765         {\cf19 return};\par
01766     \}\par
01767     ImQsort(items, ({\cf18 size_t})count, {\cf17 sizeof}(ImGuiShrinkWidthItem), ShrinkWidthItemComparer);\par
01768     {\cf18 int} count_same_width = 1;\par
01769     {\cf19 while} (width_excess > 0.0f && count_same_width < count)\par
01770     \{\par
01771         {\cf19 while} (count_same_width < count && items[0].Width <= items[count_same_width].Width)\par
01772             count_same_width++;\par
01773         {\cf18 float} max_width_to_remove_per_item = (count_same_width < count && items[count_same_width].Width >= 0.0f) ? (items[0].Width - items[count_same_width].Width) : (items[0].Width - 1.0f);\par
01774         {\cf19 if} (max_width_to_remove_per_item <= 0.0f)\par
01775             {\cf19 break};\par
01776         {\cf18 float} width_to_remove_per_item = ImMin(width_excess / count_same_width, max_width_to_remove_per_item);\par
01777         {\cf19 for} ({\cf18 int} item_n = 0; item_n < count_same_width; item_n++)\par
01778             items[item_n].Width -= width_to_remove_per_item;\par
01779         width_excess -= width_to_remove_per_item * count_same_width;\par
01780     \}\par
01781 \par
01782     {\cf20 // Round width and redistribute remainder}\par
01783     {\cf20 // Ensure that e.g. the right-most tab of a shrunk tab-bar always reaches exactly at the same distance from the right-most edge of the tab bar separator.}\par
01784     width_excess = 0.0f;\par
01785     {\cf19 for} ({\cf18 int} n = 0; n < count; n++)\par
01786     \{\par
01787         {\cf18 float} width_rounded = ImTrunc(items[n].Width);\par
01788         width_excess += items[n].Width - width_rounded;\par
01789         items[n].Width = width_rounded;\par
01790     \}\par
01791     {\cf19 while} (width_excess > 0.0f)\par
01792         {\cf19 for} ({\cf18 int} n = 0; n < count && width_excess > 0.0f; n++)\par
01793         \{\par
01794             {\cf18 float} width_to_add = ImMin(items[n].InitialWidth - items[n].Width, 1.0f);\par
01795             items[n].Width += width_to_add;\par
01796             width_excess -= width_to_add;\par
01797         \}\par
01798 \}\par
