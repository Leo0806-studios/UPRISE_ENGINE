07590     {\cf18 bool} selected = *p_selected;\par
07591     {\cf19 if} (ms->IsFocused)\par
07592     \{\par
07593         ImGuiMultiSelectState* storage = ms->Storage;\par
07594         ImGuiSelectionUserData item_data = g.NextItemData.SelectionUserData;\par
