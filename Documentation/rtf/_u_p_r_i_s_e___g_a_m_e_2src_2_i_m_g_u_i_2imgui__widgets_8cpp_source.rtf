08428 {\cf18 void} ImGuiMenuColumns::CalcNextTotalWidth({\cf18 bool} update_offsets)\par
08429 \{\par
08430     ImU16 offset = 0;\par
08431     {\cf18 bool} want_spacing = {\cf17 false};\par
08432     {\cf19 for} ({\cf18 int} i = 0; i < IM_ARRAYSIZE(Widths); i++)\par
08433     \{\par
08434         ImU16 width = Widths[i];\par
08435         {\cf19 if} (want_spacing && width > 0)\par
08436             offset += Spacing;\par
08437         want_spacing |= (width > 0);\par
08438         {\cf19 if} (update_offsets)\par
08439         \{\par
08440             {\cf19 if} (i == 1) \{ OffsetLabel = offset; \}\par
08441             {\cf19 if} (i == 2) \{ OffsetShortcut = offset; \}\par
08442             {\cf19 if} (i == 3) \{ OffsetMark = offset; \}\par
08443         \}\par
08444         offset += width;\par
08445     \}\par
08446     NextTotalWidth = offset;\par
08447 \}\par
