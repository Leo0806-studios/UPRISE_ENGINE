03837 {\cf17 static} ImVec2 InputTextCalcTextSizeW(ImGuiContext* ctx, {\cf17 const} ImWchar* text_begin, {\cf17 const} ImWchar* text_end, {\cf17 const} ImWchar** remaining, ImVec2* out_offset, {\cf18 bool} stop_on_new_line)\par
03838 \{\par
03839     ImGuiContext& g = *ctx;\par
03840     ImFont* font = g.Font;\par
03841     {\cf17 const} {\cf18 float} line_height = g.FontSize;\par
03842     {\cf17 const} {\cf18 float} scale = line_height / font->FontSize;\par
03843 \par
03844     ImVec2 text_size = ImVec2(0, 0);\par
03845     {\cf18 float} line_width = 0.0f;\par
03846 \par
03847     {\cf17 const} ImWchar* s = text_begin;\par
03848     {\cf19 while} (s < text_end)\par
03849     \{\par
03850         {\cf18 unsigned} {\cf18 int} c = ({\cf18 unsigned} int)(*s++);\par
03851         {\cf19 if} (c == {\cf23 '\\n'})\par
03852         \{\par
03853             text_size.x = ImMax(text_size.x, line_width);\par
03854             text_size.y += line_height;\par
03855             line_width = 0.0f;\par
03856             {\cf19 if} (stop_on_new_line)\par
03857                 {\cf19 break};\par
03858             {\cf19 continue};\par
03859         \}\par
03860         {\cf19 if} (c == {\cf23 '\\r'})\par
03861             {\cf19 continue};\par
03862 \par
03863         {\cf17 const} {\cf18 float} char_width = font->GetCharAdvance((ImWchar)c) * scale;\par
03864         line_width += char_width;\par
03865     \}\par
03866 \par
03867     {\cf19 if} (text_size.x < line_width)\par
03868         text_size.x = line_width;\par
03869 \par
03870     {\cf19 if} (out_offset)\par
03871         *out_offset = ImVec2(line_width, text_size.y + line_height);  {\cf20 // offset allow for the possibility of sitting after a trailing \\n}\par
03872 \par
03873     {\cf19 if} (line_width > 0 || text_size.y == 0.0f)                        {\cf20 // whereas size.y will ignore the trailing \\n}\par
03874         text_size.y += line_height;\par
03875 \par
03876     {\cf19 if} (remaining)\par
03877         *remaining = s;\par
03878 \par
03879     {\cf19 return} text_size;\par
03880 \}\par
