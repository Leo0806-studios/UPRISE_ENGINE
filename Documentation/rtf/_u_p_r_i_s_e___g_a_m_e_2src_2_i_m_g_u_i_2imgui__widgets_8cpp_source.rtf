07858 {\cf18 void} ImGui::MultiSelectAddSetRange(ImGuiMultiSelectTempData* ms, {\cf18 bool} selected, {\cf18 int} range_dir, ImGuiSelectionUserData first_item, ImGuiSelectionUserData last_item)\par
07859 \{\par
07860     {\cf20 // Merge contiguous spans into same request (unless NoRangeSelect is set which guarantees single-item ranges)}\par
07861     {\cf19 if} (ms->IO.Requests.Size > 0 && first_item == last_item && (ms->Flags & ImGuiMultiSelectFlags_NoRangeSelect) == 0)\par
