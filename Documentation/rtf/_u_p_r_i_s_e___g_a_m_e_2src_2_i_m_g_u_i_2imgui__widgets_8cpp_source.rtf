08086 {\cf20 // [SECTION] Widgets: ListBox}\par
08087 {\cf20 //-------------------------------------------------------------------------}\par
08088 {\cf20 // - BeginListBox()}\par
08089 {\cf20 // - EndListBox()}\par
08090 {\cf20 // - ListBox()}\par
08091 {\cf20 //-------------------------------------------------------------------------}\par
08092 \par
08093 {\cf20 // This is essentially a thin wrapper to using BeginChild/EndChild with the ImGuiChildFlags_FrameStyle flag for stylistic changes + displaying a label.}\par
08094 {\cf20 // Tip: To have a list filling the entire window width, use size.x = -FLT_MIN and pass an non-visible label e.g. "##empty"}\par
08095 {\cf20 // Tip: If your vertical size is calculated from an item count (e.g. 10 * item_height) consider adding a fractional part to facilitate seeing scrolling boundaries (e.g. 10.25 * item_height).}\par
08096 {\cf18 bool} ImGui::BeginListBox({\cf17 const} {\cf18 char}* label, {\cf17 const} ImVec2& size_arg)\par
08097 \{\par
08098     ImGuiContext& g = *GImGui;\par
08099     ImGuiWindow* window = GetCurrentWindow();\par
08100     {\cf19 if} (window->SkipItems)\par
08101         {\cf19 return} {\cf17 false};\par
08102 \par
08103     {\cf17 const} ImGuiStyle& style = g.Style;\par
08104     {\cf17 const} ImGuiID {\cf18 id} = GetID(label);\par
08105     {\cf17 const} ImVec2 label_size = CalcTextSize(label, NULL, {\cf17 true});\par
08106 \par
08107     {\cf20 // Size default to hold ~7.25 items.}\par
08108     {\cf20 // Fractional number of items helps seeing that we can scroll down/up without looking at scrollbar.}\par
08109     ImVec2 size = ImTrunc(CalcItemSize(size_arg, CalcItemWidth(), GetTextLineHeightWithSpacing() * 7.25f + style.FramePadding.y * 2.0f));\par
08110     ImVec2 frame_size = ImVec2(size.x, ImMax(size.y, label_size.y));\par
08111     ImRect frame_bb(window->DC.CursorPos, window->DC.CursorPos + frame_size);\par
08112     ImRect bb(frame_bb.Min, frame_bb.Max + ImVec2(label_size.x > 0.0f ? style.ItemInnerSpacing.x + label_size.x : 0.0f, 0.0f));\par
08113     g.NextItemData.ClearFlags();\par
08114 \par
08115     {\cf19 if} (!IsRectVisible(bb.Min, bb.Max))\par
08116     \{\par
08117         ItemSize(bb.GetSize(), style.FramePadding.y);\par
08118         ItemAdd(bb, 0, &frame_bb);\par
08119         g.NextWindowData.ClearFlags(); {\cf20 // We behave like Begin() and need to consume those values}\par
08120         {\cf19 return} {\cf17 false};\par
08121     \}\par
08122 \par
08123     {\cf20 // FIXME-OPT: We could omit the BeginGroup() if label_size.x == 0.0f but would need to omit the EndGroup() as well.}\par
08124     BeginGroup();\par
08125     {\cf19 if} (label_size.x > 0.0f)\par
08126     \{\par
08127         ImVec2 label_pos = ImVec2(frame_bb.Max.x + style.ItemInnerSpacing.x, frame_bb.Min.y + style.FramePadding.y);\par
08128         RenderText(label_pos, label);\par
08129         window->DC.CursorMaxPos = ImMax(window->DC.CursorMaxPos, label_pos + label_size);\par
08130         AlignTextToFramePadding();\par
08131     \}\par
08132 \par
08133     BeginChild({\cf18 id}, frame_bb.GetSize(), ImGuiChildFlags_FrameStyle);\par
08134     {\cf19 return} {\cf17 true};\par
08135 \}\par
