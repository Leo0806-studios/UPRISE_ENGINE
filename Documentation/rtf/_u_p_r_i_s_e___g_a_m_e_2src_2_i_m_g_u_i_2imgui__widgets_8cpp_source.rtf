09532 {\cf20 // Called on manual closure attempt}\par
09533 {\cf18 void} ImGui::TabBarCloseTab(ImGuiTabBar* tab_bar, ImGuiTabItem* tab)\par
09534 \{\par
09535     {\cf19 if} (tab->Flags & ImGuiTabItemFlags_Button)\par
09536         {\cf19 return}; {\cf20 // A button appended with TabItemButton().}\par
09537 \par
09538     {\cf19 if} ((tab->Flags & (ImGuiTabItemFlags_UnsavedDocument | ImGuiTabItemFlags_NoAssumedClosure)) == 0)\par
09539     \{\par
09540         {\cf20 // This will remove a frame of lag for selecting another tab on closure.}\par
09541         {\cf20 // However we don't run it in the case where the 'Unsaved' flag is set, so user gets a chance to fully undo the closure}\par
09542         tab->WantClose = {\cf17 true};\par
09543         {\cf19 if} (tab_bar->VisibleTabId == tab->ID)\par
09544         \{\par
09545             tab->LastFrameVisible = -1;\par
09546             tab_bar->SelectedTabId = tab_bar->NextSelectedTabId = 0;\par
09547         \}\par
09548     \}\par
09549     {\cf19 else}\par
09550     \{\par
09551         {\cf20 // Actually select before expecting closure attempt (on an UnsavedDocument tab user is expect to e.g. show a popup)}\par
09552         {\cf19 if} (tab_bar->VisibleTabId != tab->ID)\par
09553             TabBarQueueFocus(tab_bar, tab);\par
09554     \}\par
09555 \}\par
