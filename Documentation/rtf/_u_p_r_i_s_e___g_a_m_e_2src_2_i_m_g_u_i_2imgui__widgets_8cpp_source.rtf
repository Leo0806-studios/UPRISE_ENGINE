07964 {\cf20 // Optimized for batch edits (with same value of 'selected')}\par
07965 {\cf17 static} {\cf18 void} ImGuiSelectionBasicStorage_BatchSetItemSelected(ImGuiSelectionBasicStorage* selection, ImGuiID {\cf18 id}, {\cf18 bool} selected, {\cf18 int} size_before_amends, {\cf18 int} selection_order)\par
07966 \{\par
07967     ImGuiStorage* storage = &selection->_Storage;\par
07968     ImGuiStoragePair* it = ImLowerBound(storage->Data.Data, storage->Data.Data + size_before_amends, {\cf18 id});\par
07969     {\cf17 const} {\cf18 bool} is_contained = (it != storage->Data.Data + size_before_amends) && (it->key == {\cf18 id});\par
07970     {\cf19 if} (selected == (is_contained && it->val_i != 0))\par
07971         {\cf19 return};\par
07972     {\cf19 if} (selected && !is_contained)\par
07973         storage->Data.push_back(ImGuiStoragePair({\cf18 id}, selection_order)); {\cf20 // Push unsorted at end of vector, will be sorted in SelectionMultiAmendsFinish()}\par
07974     {\cf19 else} {\cf19 if} (is_contained)\par
07975         it->val_i = selected ? selection_order : 0; {\cf20 // Modify in-place.}\par
07976     selection->Size += selected ? +1 : -1;\par
07977 \}\par
