08825         {\cf19 if} (menu_is_open)\par
08826         \{\par
08827             {\cf20 // Implement what ImGuiPopupFlags_NoReopenAlwaysNavInit would do:}\par
08828             {\cf20 // Perform an init request in the case the popup was already open (via a previous mouse hover)}\par
08829             {\cf19 if} (want_open && want_open_nav_init && !g.NavInitRequest)\par
08830             \{\par
08831                 FocusWindow(g.CurrentWindow, ImGuiFocusRequestFlags_UnlessBelowModal);\par
08832                 NavInitWindow(g.CurrentWindow, {\cf17 false});\par
08833             \}\par
08834 \par
08835             {\cf20 // Restore LastItemData so IsItemXXXX functions can work after BeginMenu()/EndMenu()}\par
08836             {\cf20 // (This fixes using IsItemClicked() and IsItemHovered(), but IsItemHovered() also relies on its support for ImGuiItemFlags_NoWindowHoverableCheck)}\par
08837             g.LastItemData = last_item_in_parent;\par
08838             {\cf19 if} (g.HoveredWindow == window)\par
08839                 g.LastItemData.StatusFlags |= ImGuiItemStatusFlags_HoveredWindow;\par
08840         \}\par
08841     \}\par
08842     {\cf19 else}\par
08843     \{\par
08844         g.NextWindowData.ClearFlags(); {\cf20 // We behave like Begin() and need to consume those values}\par
08845     \}\par
08846 \par
08847     {\cf19 return} menu_is_open;\par
