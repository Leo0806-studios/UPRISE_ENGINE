03163         {\cf19 return} SliderBehaviorT<float, float, float >(bb, {\cf18 id}, data_type, ({\cf18 float}*)p_v,  *({\cf17 const} {\cf18 float}*)p_min,  *({\cf17 const} {\cf18 float}*)p_max,  format, flags, out_grab_bb);\par
