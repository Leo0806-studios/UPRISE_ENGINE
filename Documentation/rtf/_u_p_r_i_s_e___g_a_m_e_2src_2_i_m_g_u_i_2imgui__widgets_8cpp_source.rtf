03414 {\cf20 // [SECTION] Widgets: InputScalar, InputFloat, InputInt, etc.}\par
03415 {\cf20 //-------------------------------------------------------------------------}\par
03416 {\cf20 // - ImParseFormatFindStart() [Internal]}\par
03417 {\cf20 // - ImParseFormatFindEnd() [Internal]}\par
03418 {\cf20 // - ImParseFormatTrimDecorations() [Internal]}\par
03419 {\cf20 // - ImParseFormatSanitizeForPrinting() [Internal]}\par
03420 {\cf20 // - ImParseFormatSanitizeForScanning() [Internal]}\par
03421 {\cf20 // - ImParseFormatPrecision() [Internal]}\par
03422 {\cf20 // - TempInputTextScalar() [Internal]}\par
03423 {\cf20 // - InputScalar()}\par
03424 {\cf20 // - InputScalarN()}\par
03425 {\cf20 // - InputFloat()}\par
03426 {\cf20 // - InputFloat2()}\par
03427 {\cf20 // - InputFloat3()}\par
03428 {\cf20 // - InputFloat4()}\par
03429 {\cf20 // - InputInt()}\par
03430 {\cf20 // - InputInt2()}\par
03431 {\cf20 // - InputInt3()}\par
03432 {\cf20 // - InputInt4()}\par
03433 {\cf20 // - InputDouble()}\par
03434 {\cf20 //-------------------------------------------------------------------------}\par
03435 \par
03436 {\cf20 // We don't use strchr() because our strings are usually very short and often start with '%'}\par
03437 {\cf17 const} {\cf18 char}* ImParseFormatFindStart({\cf17 const} {\cf18 char}* fmt)\par
03438 \{\par
03439     {\cf19 while} ({\cf18 char} c = fmt[0])\par
03440     \{\par
03441         {\cf19 if} (c == {\cf23 '%'} && fmt[1] != {\cf23 '%'})\par
03442             {\cf19 return} fmt;\par
03443         {\cf19 else} {\cf19 if} (c == {\cf23 '%'})\par
03444             fmt++;\par
03445         fmt++;\par
03446     \}\par
03447     {\cf19 return} fmt;\par
03448 \}\par
03449 \par
03450 {\cf17 const} {\cf18 char}* ImParseFormatFindEnd({\cf17 const} {\cf18 char}* fmt)\par
03451 \{\par
03452     {\cf20 // Printf/scanf types modifiers: I/L/h/j/l/t/w/z. Other uppercase letters qualify as types aka end of the format.}\par
03453     {\cf19 if} (fmt[0] != {\cf23 '%'})\par
03454         {\cf19 return} fmt;\par
03455     {\cf17 const} {\cf18 unsigned} {\cf18 int} ignored_uppercase_mask = (1 << ({\cf23 'I'}-{\cf23 'A'})) | (1 << ({\cf23 'L'}-{\cf23 'A'}));\par
03456     {\cf17 const} {\cf18 unsigned} {\cf18 int} ignored_lowercase_mask = (1 << ({\cf23 'h'}-{\cf23 'a'})) | (1 << ({\cf23 'j'}-{\cf23 'a'})) | (1 << ({\cf23 'l'}-{\cf23 'a'})) | (1 << ({\cf23 't'}-{\cf23 'a'})) | (1 << ({\cf23 'w'}-{\cf23 'a'})) | (1 << ({\cf23 'z'}-{\cf23 'a'}));\par
03457     {\cf19 for} ({\cf18 char} c; (c = *fmt) != 0; fmt++)\par
03458     \{\par
03459         {\cf19 if} (c >= {\cf23 'A'} && c <= {\cf23 'Z'} && ((1 << (c - {\cf23 'A'})) & ignored_uppercase_mask) == 0)\par
03460             {\cf19 return} fmt + 1;\par
03461         {\cf19 if} (c >= {\cf23 'a'} && c <= {\cf23 'z'} && ((1 << (c - {\cf23 'a'})) & ignored_lowercase_mask) == 0)\par
03462             {\cf19 return} fmt + 1;\par
03463     \}\par
03464     {\cf19 return} fmt;\par
03465 \}\par
03466 \par
03467 {\cf20 // Extract the format out of a format string with leading or trailing decorations}\par
03468 {\cf20 //  fmt = "blah blah"  -> return ""}\par
03469 {\cf20 //  fmt = "%.3f"       -> return fmt}\par
03470 {\cf20 //  fmt = "hello %.3f" -> return fmt + 6}\par
03471 {\cf20 //  fmt = "%.3f hello" -> return buf written with "%.3f"}\par
03472 {\cf17 const} {\cf18 char}* ImParseFormatTrimDecorations({\cf17 const} {\cf18 char}* fmt, {\cf18 char}* buf, {\cf18 size_t} buf_size)\par
03473 \{\par
03474     {\cf17 const} {\cf18 char}* fmt_start = ImParseFormatFindStart(fmt);\par
03475     {\cf19 if} (fmt_start[0] != {\cf23 '%'})\par
03476         {\cf19 return} {\cf22 ""};\par
03477     {\cf17 const} {\cf18 char}* fmt_end = ImParseFormatFindEnd(fmt_start);\par
03478     {\cf19 if} (fmt_end[0] == 0) {\cf20 // If we only have leading decoration, we don't need to copy the data.}\par
03479         {\cf19 return} fmt_start;\par
03480     ImStrncpy(buf, fmt_start, ImMin(({\cf18 size_t})(fmt_end - fmt_start) + 1, buf_size));\par
03481     {\cf19 return} buf;\par
03482 \}\par
03483 \par
03484 {\cf20 // Sanitize format}\par
03485 {\cf20 // - Zero terminate so extra characters after format (e.g. "%f123") don't confuse atof/atoi}\par
03486 {\cf20 // - stb_sprintf.h supports several new modifiers which format numbers in a way that also makes them incompatible atof/atoi.}\par
03487 {\cf18 void} ImParseFormatSanitizeForPrinting({\cf17 const} {\cf18 char}* fmt_in, {\cf18 char}* fmt_out, {\cf18 size_t} fmt_out_size)\par
03488 \{\par
03489     {\cf17 const} {\cf18 char}* fmt_end = ImParseFormatFindEnd(fmt_in);\par
03490     IM_UNUSED(fmt_out_size);\par
03491     IM_ASSERT(({\cf18 size_t})(fmt_end - fmt_in + 1) < fmt_out_size); {\cf20 // Format is too long, let us know if this happens to you!}\par
03492     {\cf19 while} (fmt_in < fmt_end)\par
03493     \{\par
03494         {\cf18 char} c = *fmt_in++;\par
03495         {\cf19 if} (c != {\cf23 '\\''} && c != {\cf23 '$'} && c != {\cf23 '_'}) {\cf20 // Custom flags provided by stb_sprintf.h. POSIX 2008 also supports '.}\par
03496             *(fmt_out++) = c;\par
03497     \}\par
03498     *fmt_out = 0; {\cf20 // Zero-terminate}\par
03499 \}\par
03500 \par
03501 {\cf20 // - For scanning we need to remove all width and precision fields and flags "%+3.7f" -> "%f". BUT don't strip types like "%I64d" which includes digits. ! "%07I64d" -> "%I64d"}\par
03502 {\cf17 const} {\cf18 char}* ImParseFormatSanitizeForScanning({\cf17 const} {\cf18 char}* fmt_in, {\cf18 char}* fmt_out, {\cf18 size_t} fmt_out_size)\par
03503 \{\par
03504     {\cf17 const} {\cf18 char}* fmt_end = ImParseFormatFindEnd(fmt_in);\par
03505     {\cf17 const} {\cf18 char}* fmt_out_begin = fmt_out;\par
03506     IM_UNUSED(fmt_out_size);\par
03507     IM_ASSERT(({\cf18 size_t})(fmt_end - fmt_in + 1) < fmt_out_size); {\cf20 // Format is too long, let us know if this happens to you!}\par
03508     {\cf18 bool} has_type = {\cf17 false};\par
03509     {\cf19 while} (fmt_in < fmt_end)\par
03510     \{\par
03511         {\cf18 char} c = *fmt_in++;\par
03512         {\cf19 if} (!has_type && ((c >= {\cf23 '0'} && c <= {\cf23 '9'}) || c == {\cf23 '.'} || c == {\cf23 '+'} || c == {\cf23 '#'}))\par
03513             {\cf19 continue};\par
03514         has_type |= ((c >= {\cf23 'a'} && c <= {\cf23 'z'}) || (c >= {\cf23 'A'} && c <= {\cf23 'Z'})); {\cf20 // Stop skipping digits}\par
03515         {\cf19 if} (c != {\cf23 '\\''} && c != {\cf23 '$'} && c != {\cf23 '_'}) {\cf20 // Custom flags provided by stb_sprintf.h. POSIX 2008 also supports '.}\par
03516             *(fmt_out++) = c;\par
03517     \}\par
03518     *fmt_out = 0; {\cf20 // Zero-terminate}\par
03519     {\cf19 return} fmt_out_begin;\par
03520 \}\par
