08213 \par
08214 {\cf18 int} ImGui::PlotEx(ImGuiPlotType plot_type, {\cf17 const} {\cf18 char}* label, {\cf18 float} (*values_getter)({\cf18 void}* data, {\cf18 int} idx), {\cf18 void}* data, {\cf18 int} values_count, {\cf18 int} values_offset, {\cf17 const} {\cf18 char}* overlay_text, {\cf18 float} scale_min, {\cf18 float} scale_max, {\cf17 const} ImVec2& size_arg)\par
08215 \{\par
08216     ImGuiContext& g = *GImGui;\par
08217     ImGuiWindow* window = GetCurrentWindow();\par
08218     {\cf19 if} (window->SkipItems)\par
08219         {\cf19 return} -1;\par
08220 \par
08221     {\cf17 const} ImGuiStyle& style = g.Style;\par
08222     {\cf17 const} ImGuiID {\cf18 id} = window->GetID(label);\par
08223 \par
08224     {\cf17 const} ImVec2 label_size = CalcTextSize(label, NULL, {\cf17 true});\par
08225     {\cf17 const} ImVec2 frame_size = CalcItemSize(size_arg, CalcItemWidth(), label_size.y + style.FramePadding.y * 2.0f);\par
08226 \par
08227     {\cf17 const} ImRect frame_bb(window->DC.CursorPos, window->DC.CursorPos + frame_size);\par
08228     {\cf17 const} ImRect inner_bb(frame_bb.Min + style.FramePadding, frame_bb.Max - style.FramePadding);\par
08229     {\cf17 const} ImRect total_bb(frame_bb.Min, frame_bb.Max + ImVec2(label_size.x > 0.0f ? style.ItemInnerSpacing.x + label_size.x : 0.0f, 0));\par
08230     ItemSize(total_bb, style.FramePadding.y);\par
08231     {\cf19 if} (!ItemAdd(total_bb, 0, &frame_bb))\par
08232         {\cf19 return} -1;\par
08233     {\cf17 const} {\cf18 bool} hovered = ItemHoverable(frame_bb, {\cf18 id}, g.LastItemData.InFlags);\par
08234 \par
08235     {\cf20 // Determine scale from values if not specified}\par
08236     {\cf19 if} (scale_min == FLT_MAX || scale_max == FLT_MAX)\par
08237     \{\par
08238         {\cf18 float} v_min = FLT_MAX;\par
08239         {\cf18 float} v_max = -FLT_MAX;\par
08240         {\cf19 for} ({\cf18 int} i = 0; i < values_count; i++)\par
08241         \{\par
08242             {\cf17 const} {\cf18 float} v = values_getter(data, i);\par
08243             {\cf19 if} (v != v) {\cf20 // Ignore NaN values}\par
08244                 {\cf19 continue};\par
08245             v_min = ImMin(v_min, v);\par
08246             v_max = ImMax(v_max, v);\par
08247         \}\par
08248         {\cf19 if} (scale_min == FLT_MAX)\par
08249             scale_min = v_min;\par
08250         {\cf19 if} (scale_max == FLT_MAX)\par
08251             scale_max = v_max;\par
08252     \}\par
08253 \par
08254     RenderFrame(frame_bb.Min, frame_bb.Max, GetColorU32(ImGuiCol_FrameBg), {\cf17 true}, style.FrameRounding);\par
08255 \par
08256     {\cf17 const} {\cf18 int} values_count_min = (plot_type == ImGuiPlotType_Lines) ? 2 : 1;\par
08257     {\cf18 int} idx_hovered = -1;\par
08258     {\cf19 if} (values_count >= values_count_min)\par
08259     \{\par
08260         {\cf18 int} res_w = ImMin(({\cf18 int})frame_size.x, values_count) + ((plot_type == ImGuiPlotType_Lines) ? -1 : 0);\par
08261         {\cf18 int} item_count = values_count + ((plot_type == ImGuiPlotType_Lines) ? -1 : 0);\par
08262 \par
08263         {\cf20 // Tooltip on hover}\par
08264         {\cf19 if} (hovered && inner_bb.Contains(g.IO.MousePos))\par
08265         \{\par
08266             {\cf17 const} {\cf18 float} t = ImClamp((g.IO.MousePos.x - inner_bb.Min.x) / (inner_bb.Max.x - inner_bb.Min.x), 0.0f, 0.9999f);\par
08267             {\cf17 const} {\cf18 int} v_idx = (int)(t * item_count);\par
08268             IM_ASSERT(v_idx >= 0 && v_idx < values_count);\par
08269 \par
08270             {\cf17 const} {\cf18 float} v0 = values_getter(data, (v_idx + values_offset) % values_count);\par
08271             {\cf17 const} {\cf18 float} v1 = values_getter(data, (v_idx + 1 + values_offset) % values_count);\par
08272             {\cf19 if} (plot_type == ImGuiPlotType_Lines)\par
08273                 SetTooltip({\cf22 "%d: %8.4g\\n%d: %8.4g"}, v_idx, v0, v_idx + 1, v1);\par
08274             {\cf19 else} {\cf19 if} (plot_type == ImGuiPlotType_Histogram)\par
08275                 SetTooltip({\cf22 "%d: %8.4g"}, v_idx, v0);\par
08276             idx_hovered = v_idx;\par
08277         \}\par
08278 \par
08279         {\cf17 const} {\cf18 float} t_step = 1.0f / (float)res_w;\par
08280         {\cf17 const} {\cf18 float} inv_scale = (scale_min == scale_max) ? 0.0f : (1.0f / (scale_max - scale_min));\par
08281 \par
08282         {\cf18 float} v0 = values_getter(data, (0 + values_offset) % values_count);\par
08283         {\cf18 float} t0 = 0.0f;\par
08284         ImVec2 tp0 = ImVec2( t0, 1.0f - ImSaturate((v0 - scale_min) * inv_scale) );                       {\cf20 // Point in the normalized space of our target rectangle}\par
08285         {\cf18 float} histogram_zero_line_t = (scale_min * scale_max < 0.0f) ? (1 + scale_min * inv_scale) : (scale_min < 0.0f ? 0.0f : 1.0f);   {\cf20 // Where does the zero line stands}\par
08286 \par
08287         {\cf17 const} ImU32 col_base = GetColorU32((plot_type == ImGuiPlotType_Lines) ? ImGuiCol_PlotLines : ImGuiCol_PlotHistogram);\par
08288         {\cf17 const} ImU32 col_hovered = GetColorU32((plot_type == ImGuiPlotType_Lines) ? ImGuiCol_PlotLinesHovered : ImGuiCol_PlotHistogramHovered);\par
08289 \par
08290         {\cf19 for} ({\cf18 int} n = 0; n < res_w; n++)\par
08291         \{\par
08292             {\cf17 const} {\cf18 float} t1 = t0 + t_step;\par
08293             {\cf17 const} {\cf18 int} v1_idx = (int)(t0 * item_count + 0.5f);\par
08294             IM_ASSERT(v1_idx >= 0 && v1_idx < values_count);\par
08295             {\cf17 const} {\cf18 float} v1 = values_getter(data, (v1_idx + values_offset + 1) % values_count);\par
08296             {\cf17 const} ImVec2 tp1 = ImVec2( t1, 1.0f - ImSaturate((v1 - scale_min) * inv_scale) );\par
08297 \par
08298             {\cf20 // NB: Draw calls are merged together by the DrawList system. Still, we should render our batch are lower level to save a bit of CPU.}\par
08299             ImVec2 pos0 = ImLerp(inner_bb.Min, inner_bb.Max, tp0);\par
08300             ImVec2 pos1 = ImLerp(inner_bb.Min, inner_bb.Max, (plot_type == ImGuiPlotType_Lines) ? tp1 : ImVec2(tp1.x, histogram_zero_line_t));\par
08301             {\cf19 if} (plot_type == ImGuiPlotType_Lines)\par
08302             \{\par
08303                 window->DrawList->AddLine(pos0, pos1, idx_hovered == v1_idx ? col_hovered : col_base);\par
08304             \}\par
08305             {\cf19 else} {\cf19 if} (plot_type == ImGuiPlotType_Histogram)\par
08306             \{\par
08307                 {\cf19 if} (pos1.x >= pos0.x + 2.0f)\par
08308                     pos1.x -= 1.0f;\par
08309                 window->DrawList->AddRectFilled(pos0, pos1, idx_hovered == v1_idx ? col_hovered : col_base);\par
08310             \}\par
08311 \par
08312             t0 = t1;\par
08313             tp0 = tp1;\par
08314         \}\par
08315     \}\par
08316 \par
08317     {\cf20 // Text overlay}\par
08318     {\cf19 if} (overlay_text)\par
08319         RenderTextClipped(ImVec2(frame_bb.Min.x, frame_bb.Min.y + style.FramePadding.y), frame_bb.Max, overlay_text, NULL, NULL, ImVec2(0.5f, 0.0f));\par
08320 \par
08321     {\cf19 if} (label_size.x > 0.0f)\par
08322         RenderText(ImVec2(frame_bb.Max.x + style.ItemInnerSpacing.x, inner_bb.Min.y), label);\par
08323 \par
08324     {\cf20 // Return hovered index or -1 if none are hovered.}\par
08325     {\cf20 // This is currently not exposed in the public API because we need a larger redesign of the whole thing, but in the short-term we are making it available in PlotEx().}\par
08326     {\cf19 return} idx_hovered;\par
08327 \}\par
