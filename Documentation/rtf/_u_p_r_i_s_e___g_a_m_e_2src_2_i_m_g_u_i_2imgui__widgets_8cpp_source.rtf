05965 {\cf20 // A little color square. Return true when clicked.}\par
05966 {\cf20 // FIXME: May want to display/ignore the alpha component in the color display? Yet show it in the tooltip.}\par
05967 {\cf20 // 'desc_id' is not called 'label' because we don't display it next to the button, but only in the tooltip.}\par
05968 {\cf20 // Note that 'col' may be encoded in HSV if ImGuiColorEditFlags_InputHSV is set.}\par
05969 {\cf18 bool} ImGui::ColorButton({\cf17 const} {\cf18 char}* desc_id, {\cf17 const} ImVec4& col, ImGuiColorEditFlags flags, {\cf17 const} ImVec2& size_arg)\par
05970 \{\par
05971     ImGuiWindow* window = GetCurrentWindow();\par
05972     {\cf19 if} (window->SkipItems)\par
05973         {\cf19 return} {\cf17 false};\par
05974 \par
05975     ImGuiContext& g = *GImGui;\par
05976     {\cf17 const} ImGuiID {\cf18 id} = window->GetID(desc_id);\par
05977     {\cf17 const} {\cf18 float} default_size = GetFrameHeight();\par
05978     {\cf17 const} ImVec2 size(size_arg.x == 0.0f ? default_size : size_arg.x, size_arg.y == 0.0f ? default_size : size_arg.y);\par
05979     {\cf17 const} ImRect bb(window->DC.CursorPos, window->DC.CursorPos + size);\par
05980     ItemSize(bb, (size.y >= default_size) ? g.Style.FramePadding.y : 0.0f);\par
05981     {\cf19 if} (!ItemAdd(bb, {\cf18 id}))\par
05982         {\cf19 return} {\cf17 false};\par
05983 \par
05984     {\cf18 bool} hovered, held;\par
05985     {\cf18 bool} pressed = ButtonBehavior(bb, {\cf18 id}, &hovered, &held);\par
05986 \par
05987     {\cf19 if} (flags & ImGuiColorEditFlags_NoAlpha)\par
05988         flags &= ~(ImGuiColorEditFlags_AlphaPreview | ImGuiColorEditFlags_AlphaPreviewHalf);\par
05989 \par
05990     ImVec4 col_rgb = col;\par
05991     {\cf19 if} (flags & ImGuiColorEditFlags_InputHSV)\par
05992         ColorConvertHSVtoRGB(col_rgb.x, col_rgb.y, col_rgb.z, col_rgb.x, col_rgb.y, col_rgb.z);\par
05993 \par
05994     ImVec4 col_rgb_without_alpha(col_rgb.x, col_rgb.y, col_rgb.z, 1.0f);\par
05995     {\cf18 float} grid_step = ImMin(size.x, size.y) / 2.99f;\par
05996     {\cf18 float} rounding = ImMin(g.Style.FrameRounding, grid_step * 0.5f);\par
05997     ImRect bb_inner = bb;\par
05998     {\cf18 float} off = 0.0f;\par
05999     {\cf19 if} ((flags & ImGuiColorEditFlags_NoBorder) == 0)\par
06000     \{\par
06001         off = -0.75f; {\cf20 // The border (using Col_FrameBg) tends to look off when color is near-opaque and rounding is enabled. This offset seemed like a good middle ground to reduce those artifacts.}\par
06002         bb_inner.Expand(off);\par
06003     \}\par
06004     {\cf19 if} ((flags & ImGuiColorEditFlags_AlphaPreviewHalf) && col_rgb.w < 1.0f)\par
06005     \{\par
06006         {\cf18 float} mid_x = IM_ROUND((bb_inner.Min.x + bb_inner.Max.x) * 0.5f);\par
06007         RenderColorRectWithAlphaCheckerboard(window->DrawList, ImVec2(bb_inner.Min.x + grid_step, bb_inner.Min.y), bb_inner.Max, GetColorU32(col_rgb), grid_step, ImVec2(-grid_step + off, off), rounding, ImDrawFlags_RoundCornersRight);\par
06008         window->DrawList->AddRectFilled(bb_inner.Min, ImVec2(mid_x, bb_inner.Max.y), GetColorU32(col_rgb_without_alpha), rounding, ImDrawFlags_RoundCornersLeft);\par
06009     \}\par
06010     {\cf19 else}\par
06011     \{\par
06012         {\cf20 // Because GetColorU32() multiplies by the global style Alpha and we don't want to display a checkerboard if the source code had no alpha}\par
06013         ImVec4 col_source = (flags & ImGuiColorEditFlags_AlphaPreview) ? col_rgb : col_rgb_without_alpha;\par
06014         {\cf19 if} (col_source.w < 1.0f)\par
06015             RenderColorRectWithAlphaCheckerboard(window->DrawList, bb_inner.Min, bb_inner.Max, GetColorU32(col_source), grid_step, ImVec2(off, off), rounding);\par
06016         {\cf19 else}\par
06017             window->DrawList->AddRectFilled(bb_inner.Min, bb_inner.Max, GetColorU32(col_source), rounding);\par
06018     \}\par
06019     RenderNavHighlight(bb, {\cf18 id});\par
06020     {\cf19 if} ((flags & ImGuiColorEditFlags_NoBorder) == 0)\par
06021     \{\par
06022         {\cf19 if} (g.Style.FrameBorderSize > 0.0f)\par
06023             RenderFrameBorder(bb.Min, bb.Max, rounding);\par
06024         {\cf19 else}\par
06025             window->DrawList->AddRect(bb.Min, bb.Max, GetColorU32(ImGuiCol_FrameBg), rounding); {\cf20 // Color button are often in need of some sort of border}\par
06026     \}\par
06027 \par
06028     {\cf20 // Drag and Drop Source}\par
06029     {\cf20 // NB: The ActiveId test is merely an optional micro-optimization, BeginDragDropSource() does the same test.}\par
06030     {\cf19 if} (g.ActiveId == {\cf18 id} && !(flags & ImGuiColorEditFlags_NoDragDrop) && BeginDragDropSource())\par
06031     \{\par
06032         {\cf19 if} (flags & ImGuiColorEditFlags_NoAlpha)\par
06033             SetDragDropPayload(IMGUI_PAYLOAD_TYPE_COLOR_3F, &col_rgb, {\cf17 sizeof}({\cf18 float}) * 3, ImGuiCond_Once);\par
06034         {\cf19 else}\par
06035             SetDragDropPayload(IMGUI_PAYLOAD_TYPE_COLOR_4F, &col_rgb, {\cf17 sizeof}({\cf18 float}) * 4, ImGuiCond_Once);\par
06036         ColorButton(desc_id, col, flags);\par
06037         SameLine();\par
06038         TextEx({\cf22 "Color"});\par
06039         EndDragDropSource();\par
06040     \}\par
06041 \par
06042     {\cf20 // Tooltip}\par
06043     {\cf19 if} (!(flags & ImGuiColorEditFlags_NoTooltip) && hovered && IsItemHovered(ImGuiHoveredFlags_ForTooltip))\par
06044         ColorTooltip(desc_id, &col.x, flags & (ImGuiColorEditFlags_InputMask_ | ImGuiColorEditFlags_NoAlpha | ImGuiColorEditFlags_AlphaPreview | ImGuiColorEditFlags_AlphaPreviewHalf));\par
06045 \par
06046     {\cf19 return} pressed;\par
06047 \}\par
