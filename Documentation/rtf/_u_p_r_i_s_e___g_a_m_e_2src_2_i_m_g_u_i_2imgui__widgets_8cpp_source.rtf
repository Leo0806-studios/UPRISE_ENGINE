08154 {\cf20 // This is merely a helper around BeginListBox(), EndListBox().}\par
08155 {\cf20 // Considering using those directly to submit custom data or store selection differently.}\par
08156 {\cf18 bool} ImGui::ListBox({\cf17 const} {\cf18 char}* label, {\cf18 int}* current_item, {\cf17 const} {\cf18 char}* (*getter)({\cf18 void}* user_data, {\cf18 int} idx), {\cf18 void}* user_data, {\cf18 int} items_count, {\cf18 int} height_in_items)\par
08157 \{\par
08158     ImGuiContext& g = *GImGui;\par
08159 \par
08160     {\cf20 // Calculate size from "height_in_items"}\par
08161     {\cf19 if} (height_in_items < 0)\par
08162         height_in_items = ImMin(items_count, 7);\par
08163     {\cf18 float} height_in_items_f = height_in_items + 0.25f;\par
08164     ImVec2 size(0.0f, ImTrunc(GetTextLineHeightWithSpacing() * height_in_items_f + g.Style.FramePadding.y * 2.0f));\par
08165 \par
08166     {\cf19 if} (!BeginListBox(label, size))\par
08167         {\cf19 return} {\cf17 false};\par
08168 \par
08169     {\cf20 // Assume all items have even height (= 1 line of text). If you need items of different height,}\par
08170     {\cf20 // you can create a custom version of ListBox() in your code without using the clipper.}\par
08171     {\cf18 bool} value_changed = {\cf17 false};\par
08172     ImGuiListClipper clipper;\par
08173     clipper.Begin(items_count, GetTextLineHeightWithSpacing()); {\cf20 // We know exactly our line height here so we pass it as a minor optimization, but generally you don't need to.}\par
08174     clipper.IncludeItemByIndex(*current_item);\par
08175     {\cf19 while} (clipper.Step())\par
08176         {\cf19 for} ({\cf18 int} i = clipper.DisplayStart; i < clipper.DisplayEnd; i++)\par
08177         \{\par
08178             {\cf17 const} {\cf18 char}* item_text = getter(user_data, i);\par
08179             {\cf19 if} (item_text == NULL)\par
08180                 item_text = {\cf22 "*Unknown item*"};\par
08181 \par
08182             PushID(i);\par
08183             {\cf17 const} {\cf18 bool} item_selected = (i == *current_item);\par
08184             {\cf19 if} (Selectable(item_text, item_selected))\par
08185             \{\par
08186                 *current_item = i;\par
08187                 value_changed = {\cf17 true};\par
08188             \}\par
08189             {\cf19 if} (item_selected)\par
08190                 SetItemDefaultFocus();\par
08191             PopID();\par
08192         \}\par
08193     EndListBox();\par
08194 \par
08195     {\cf19 if} (value_changed)\par
08196         MarkItemEdited(g.LastItemData.ID);\par
08197 \par
08198     {\cf19 return} value_changed;\par
08199 \}\par
