03939 {\cf17 static} {\cf18 void} STB_TEXTEDIT_DELETECHARS(ImGuiInputTextState* obj, {\cf18 int} pos, {\cf18 int} n)\par
03940 \{\par
03941     ImWchar* dst = obj->TextW.Data + pos;\par
03942 \par
03943     {\cf20 // We maintain our buffer length in both UTF-8 and wchar formats}\par
03944     obj->Edited = {\cf17 true};\par
03945     obj->CurLenA -= ImTextCountUtf8BytesFromStr(dst, dst + n);\par
03946     obj->CurLenW -= n;\par
03947 \par
03948     {\cf20 // Offset remaining text (FIXME-OPT: Use memmove)}\par
03949     {\cf17 const} ImWchar* src = obj->TextW.Data + pos + n;\par
03950     {\cf19 while} (ImWchar c = *src++)\par
