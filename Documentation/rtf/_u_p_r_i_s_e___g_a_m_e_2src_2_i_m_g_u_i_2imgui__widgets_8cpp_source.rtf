08449 {\cf18 float} ImGuiMenuColumns::DeclColumns({\cf18 float} w_icon, {\cf18 float} w_label, {\cf18 float} w_shortcut, {\cf18 float} w_mark)\par
08450 \{\par
08451     Widths[0] = ImMax(Widths[0], (ImU16)w_icon);\par
08452     Widths[1] = ImMax(Widths[1], (ImU16)w_label);\par
08453     Widths[2] = ImMax(Widths[2], (ImU16)w_shortcut);\par
08454     Widths[3] = ImMax(Widths[3], (ImU16)w_mark);\par
08455     CalcNextTotalWidth({\cf17 false});\par
08456     {\cf19 return} ({\cf18 float})ImMax(TotalWidth, NextTotalWidth);\par
08457 \}\par
08458 \par
08459 {\cf20 // FIXME: Provided a rectangle perhaps e.g. a BeginMenuBarEx() could be used anywhere..}\par
08460 {\cf20 // Currently the main responsibility of this function being to setup clip-rect + horizontal layout + menu navigation layer.}\par
08461 {\cf20 // Ideally we also want this to be responsible for claiming space out of the main window scrolling rectangle, in which case ImGuiWindowFlags_MenuBar will become unnecessary.}\par
08462 {\cf20 // Then later the same system could be used for multiple menu-bars, scrollbars, side-bars.}\par
08463 {\cf18 bool} ImGui::BeginMenuBar()\par
08464 \{\par
08465     ImGuiWindow* window = GetCurrentWindow();\par
08466     {\cf19 if} (window->SkipItems)\par
08467         {\cf19 return} {\cf17 false};\par
08468     {\cf19 if} (!(window->Flags & ImGuiWindowFlags_MenuBar))\par
08469         {\cf19 return} {\cf17 false};\par
08470 \par
08471     IM_ASSERT(!window->DC.MenuBarAppending);\par
08472     BeginGroup(); {\cf20 // Backup position on layer 0 // FIXME: Misleading to use a group for that backup/restore}\par
08473     PushID({\cf22 "##menubar"});\par
08474 \par
08475     {\cf20 // We don't clip with current window clipping rectangle as it is already set to the area below. However we clip with window full rect.}\par
08476     {\cf20 // We remove 1 worth of rounding to Max.x to that text in long menus and small windows don't tend to display over the lower-right rounded area, which looks particularly glitchy.}\par
08477     ImRect bar_rect = window->MenuBarRect();\par
08478     ImRect clip_rect(ImFloor(bar_rect.Min.x + window->WindowBorderSize), ImFloor(bar_rect.Min.y + window->WindowBorderSize), ImFloor(ImMax(bar_rect.Min.x, bar_rect.Max.x - ImMax(window->WindowRounding, window->WindowBorderSize))), ImFloor(bar_rect.Max.y));\par
08479     clip_rect.ClipWith(window->OuterRectClipped);\par
08480     PushClipRect(clip_rect.Min, clip_rect.Max, {\cf17 false});\par
08481 \par
08482     {\cf20 // We overwrite CursorMaxPos because BeginGroup sets it to CursorPos (essentially the .EmitItem hack in EndMenuBar() would need something analogous here, maybe a BeginGroupEx() with flags).}\par
08483     window->DC.CursorPos = window->DC.CursorMaxPos = ImVec2(bar_rect.Min.x + window->DC.MenuBarOffset.x, bar_rect.Min.y + window->DC.MenuBarOffset.y);\par
08484     window->DC.LayoutType = ImGuiLayoutType_Horizontal;\par
08485     window->DC.IsSameLine = {\cf17 false};\par
08486     window->DC.NavLayerCurrent = ImGuiNavLayer_Menu;\par
08487     window->DC.MenuBarAppending = {\cf17 true};\par
08488     AlignTextToFramePadding();\par
08489     {\cf19 return} {\cf17 true};\par
08490 \}\par
08491 \par
08492 {\cf18 void} ImGui::EndMenuBar()\par
08493 \{\par
08494     ImGuiWindow* window = GetCurrentWindow();\par
08495     {\cf19 if} (window->SkipItems)\par
08496         {\cf19 return};\par
08497     ImGuiContext& g = *GImGui;\par
08498 \par
08499     {\cf20 // Nav: When a move request within one of our child menu failed, capture the request to navigate among our siblings.}\par
08500     {\cf19 if} (NavMoveRequestButNoResultYet() && (g.NavMoveDir == ImGuiDir_Left || g.NavMoveDir == ImGuiDir_Right) && (g.NavWindow->Flags & ImGuiWindowFlags_ChildMenu))\par
08501     \{\par
08502         {\cf20 // Try to find out if the request is for one of our child menu}\par
08503         ImGuiWindow* nav_earliest_child = g.NavWindow;\par
