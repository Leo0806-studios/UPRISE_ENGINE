03245     {\cf17 const} {\cf18 char}* value_buf_end = value_buf + DataTypeFormatString(value_buf, IM_ARRAYSIZE(value_buf), data_type, p_data, format);\par
03246     {\cf19 if} (g.LogEnabled)\par
03247         LogSetNextTextDecoration({\cf22 "\{"}, {\cf22 "\}"});\par
03248     RenderTextClipped(frame_bb.Min, frame_bb.Max, value_buf, value_buf_end, NULL, ImVec2(0.5f, 0.5f));\par
03249 \par
03250     {\cf19 if} (label_size.x > 0.0f)\par
03251         RenderText(ImVec2(frame_bb.Max.x + style.ItemInnerSpacing.x, frame_bb.Min.y + style.FramePadding.y), label);\par
03252 \par
03253     IMGUI_TEST_ENGINE_ITEM_INFO({\cf18 id}, label, g.LastItemData.StatusFlags | (temp_input_allowed ? ImGuiItemStatusFlags_Inputable : 0));\par
03254     {\cf19 return} value_changed;\par
