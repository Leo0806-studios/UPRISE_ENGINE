00431 {\cf20 // The ButtonBehavior() function is key to many interactions and used by many/most widgets.}\par
00432 {\cf20 // Because we handle so many cases (keyboard/gamepad navigation, drag and drop) and many specific behavior (via ImGuiButtonFlags_),}\par
00433 {\cf20 // this code is a little complex.}\par
00434 {\cf20 // By far the most common path is interacting with the Mouse using the default ImGuiButtonFlags_PressedOnClickRelease button behavior.}\par
00435 {\cf20 // See the series of events below and the corresponding state reported by dear imgui:}\par
00436 {\cf20 //------------------------------------------------------------------------------------------------------------------------------------------------}\par
00437 {\cf20 // with PressedOnClickRelease:             return-value  IsItemHovered()  IsItemActive()  IsItemActivated()  IsItemDeactivated()  IsItemClicked()}\par
00438 {\cf20 //   Frame N+0 (mouse is outside bb)        -             -                -               -                  -                    -}\par
00439 {\cf20 //   Frame N+1 (mouse moves inside bb)      -             true             -               -                  -                    -}\par
00440 {\cf20 //   Frame N+2 (mouse button is down)       -             true             true            true               -                    true}\par
00441 {\cf20 //   Frame N+3 (mouse button is down)       -             true             true            -                  -                    -}\par
00442 {\cf20 //   Frame N+4 (mouse moves outside bb)     -             -                true            -                  -                    -}\par
00443 {\cf20 //   Frame N+5 (mouse moves inside bb)      -             true             true            -                  -                    -}\par
00444 {\cf20 //   Frame N+6 (mouse button is released)   true          true             -               -                  true                 -}\par
00445 {\cf20 //   Frame N+7 (mouse button is released)   -             true             -               -                  -                    -}\par
00446 {\cf20 //   Frame N+8 (mouse moves outside bb)     -             -                -               -                  -                    -}\par
00447 {\cf20 //------------------------------------------------------------------------------------------------------------------------------------------------}\par
00448 {\cf20 // with PressedOnClick:                    return-value  IsItemHovered()  IsItemActive()  IsItemActivated()  IsItemDeactivated()  IsItemClicked()}\par
00449 {\cf20 //   Frame N+2 (mouse button is down)       true          true             true            true               -                    true}\par
00450 {\cf20 //   Frame N+3 (mouse button is down)       -             true             true            -                  -                    -}\par
00451 {\cf20 //   Frame N+6 (mouse button is released)   -             true             -               -                  true                 -}\par
00452 {\cf20 //   Frame N+7 (mouse button is released)   -             true             -               -                  -                    -}\par
00453 {\cf20 //------------------------------------------------------------------------------------------------------------------------------------------------}\par
00454 {\cf20 // with PressedOnRelease:                  return-value  IsItemHovered()  IsItemActive()  IsItemActivated()  IsItemDeactivated()  IsItemClicked()}\par
00455 {\cf20 //   Frame N+2 (mouse button is down)       -             true             -               -                  -                    true}\par
00456 {\cf20 //   Frame N+3 (mouse button is down)       -             true             -               -                  -                    -}\par
00457 {\cf20 //   Frame N+6 (mouse button is released)   true          true             -               -                  -                    -}\par
00458 {\cf20 //   Frame N+7 (mouse button is released)   -             true             -               -                  -                    -}\par
00459 {\cf20 //------------------------------------------------------------------------------------------------------------------------------------------------}\par
00460 {\cf20 // with PressedOnDoubleClick:              return-value  IsItemHovered()  IsItemActive()  IsItemActivated()  IsItemDeactivated()  IsItemClicked()}\par
00461 {\cf20 //   Frame N+0 (mouse button is down)       -             true             -               -                  -                    true}\par
00462 {\cf20 //   Frame N+1 (mouse button is down)       -             true             -               -                  -                    -}\par
00463 {\cf20 //   Frame N+2 (mouse button is released)   -             true             -               -                  -                    -}\par
00464 {\cf20 //   Frame N+3 (mouse button is released)   -             true             -               -                  -                    -}\par
00465 {\cf20 //   Frame N+4 (mouse button is down)       true          true             true            true               -                    true}\par
00466 {\cf20 //   Frame N+5 (mouse button is down)       -             true             true            -                  -                    -}\par
00467 {\cf20 //   Frame N+6 (mouse button is released)   -             true             -               -                  true                 -}\par
00468 {\cf20 //   Frame N+7 (mouse button is released)   -             true             -               -                  -                    -}\par
00469 {\cf20 //------------------------------------------------------------------------------------------------------------------------------------------------}\par
00470 {\cf20 // Note that some combinations are supported,}\par
00471 {\cf20 // - PressedOnDragDropHold can generally be associated with any flag.}\par
00472 {\cf20 // - PressedOnDoubleClick can be associated by PressedOnClickRelease/PressedOnRelease, in which case the second release event won't be reported.}\par
00473 {\cf20 //------------------------------------------------------------------------------------------------------------------------------------------------}\par
00474 {\cf20 // The behavior of the return-value changes when ImGuiButtonFlags_Repeat is set:}\par
00475 {\cf20 //                                         Repeat+                  Repeat+           Repeat+             Repeat+}\par
00476 {\cf20 //                                         PressedOnClickRelease    PressedOnClick    PressedOnRelease    PressedOnDoubleClick}\par
00477 {\cf20 //-------------------------------------------------------------------------------------------------------------------------------------------------}\par
00478 {\cf20 //   Frame N+0 (mouse button is down)       -                        true              -                   true}\par
00479 {\cf20 //   ...                                    -                        -                 -                   -}\par
00480 {\cf20 //   Frame N + RepeatDelay                  true                     true              -                   true}\par
00481 {\cf20 //   ...                                    -                        -                 -                   -}\par
00482 {\cf20 //   Frame N + RepeatDelay + RepeatRate*N   true                     true              -                   true}\par
00483 {\cf20 //-------------------------------------------------------------------------------------------------------------------------------------------------}\par
00484 \par
00485 {\cf20 // FIXME: For refactor we could output flags, incl mouse hovered vs nav keyboard vs nav triggered etc.}\par
00486 {\cf20 // And better standardize how widgets use 'GetColor32((held && hovered) ? ... : hovered ? ...)' vs 'GetColor32(held ? ... : hovered ? ...);'}\par
00487 {\cf20 // For mouse feedback we typically prefer the 'held && hovered' test, but for nav feedback not always. Outputting hovered=true on Activation may be misleading.}\par
00488 {\cf18 bool} ImGui::ButtonBehavior({\cf17 const} ImRect& bb, ImGuiID {\cf18 id}, {\cf18 bool}* out_hovered, {\cf18 bool}* out_held, ImGuiButtonFlags flags)\par
00489 \{\par
00490     ImGuiContext& g = *GImGui;\par
00491     ImGuiWindow* window = GetCurrentWindow();\par
00492 \par
