03257 {\cf20 // Add multiple sliders on 1 line for compact edition of multiple components}\par
03258 {\cf18 bool} ImGui::SliderScalarN({\cf17 const} {\cf18 char}* label, ImGuiDataType data_type, {\cf18 void}* v, {\cf18 int} components, {\cf17 const} {\cf18 void}* v_min, {\cf17 const} {\cf18 void}* v_max, {\cf17 const} {\cf18 char}* format, ImGuiSliderFlags flags)\par
