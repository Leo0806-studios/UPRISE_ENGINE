09501 {\cf20 // The purpose of this call is to register tab in advance so we can control their order at the time they appear.}\par
09502 {\cf20 // Otherwise calling this is unnecessary as tabs are appending as needed by the BeginTabItem() function.}\par
09503 {\cf18 void} ImGui::TabBarAddTab(ImGuiTabBar* tab_bar, ImGuiTabItemFlags tab_flags, ImGuiWindow* window)\par
09504 \{\par
09505     ImGuiContext& g = *GImGui;\par
