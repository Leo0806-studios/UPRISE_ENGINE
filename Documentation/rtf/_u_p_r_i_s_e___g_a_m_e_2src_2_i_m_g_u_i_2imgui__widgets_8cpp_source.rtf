09646 {\cf18 bool} ImGui::TabBarProcessReorder(ImGuiTabBar* tab_bar)\par
09647 \{\par
09648     ImGuiTabItem* tab1 = TabBarFindTabByID(tab_bar, tab_bar->ReorderRequestTabId);\par
09649     {\cf19 if} (tab1 == NULL || (tab1->Flags & ImGuiTabItemFlags_NoReorder))\par
09650         {\cf19 return} {\cf17 false};\par
09651 \par
09652     {\cf20 //IM_ASSERT(tab_bar->Flags & ImGuiTabBarFlags_Reorderable); // <- this may happen when using debug tools}\par
09653     {\cf18 int} tab2_order = TabBarGetTabOrder(tab_bar, tab1) + tab_bar->ReorderRequestOffset;\par
09654     {\cf19 if} (tab2_order < 0 || tab2_order >= tab_bar->Tabs.Size)\par
09655         {\cf19 return} {\cf17 false};\par
09656 \par
09657     {\cf20 // Reordered tabs must share the same section}\par
09658     {\cf20 // (Note: TabBarQueueReorderFromMousePos() also has a similar test but since we allow direct calls to TabBarQueueReorder() we do it here too)}\par
09659     ImGuiTabItem* tab2 = &tab_bar->Tabs[tab2_order];\par
09660     {\cf19 if} (tab2->Flags & ImGuiTabItemFlags_NoReorder)\par
09661         {\cf19 return} {\cf17 false};\par
09662     {\cf19 if} ((tab1->Flags & ImGuiTabItemFlags_SectionMask_) != (tab2->Flags & ImGuiTabItemFlags_SectionMask_))\par
09663         {\cf19 return} {\cf17 false};\par
09664 \par
09665     ImGuiTabItem item_tmp = *tab1;\par
09666     ImGuiTabItem* src_tab = (tab_bar->ReorderRequestOffset > 0) ? tab1 + 1 : tab2;\par
09667     ImGuiTabItem* dst_tab = (tab_bar->ReorderRequestOffset > 0) ? tab1 : tab2 + 1;\par
09668     {\cf17 const} {\cf18 int} move_count = (tab_bar->ReorderRequestOffset > 0) ? tab_bar->ReorderRequestOffset : -tab_bar->ReorderRequestOffset;\par
09669     memmove(dst_tab, src_tab, move_count * {\cf17 sizeof}(ImGuiTabItem));\par
09670     *tab2 = item_tmp;\par
09671 \par
09672     {\cf19 if} (tab_bar->Flags & ImGuiTabBarFlags_SaveSettings)\par
09673         MarkIniSettingsDirty();\par
09674     {\cf19 return} {\cf17 true};\par
09675 \}\par
