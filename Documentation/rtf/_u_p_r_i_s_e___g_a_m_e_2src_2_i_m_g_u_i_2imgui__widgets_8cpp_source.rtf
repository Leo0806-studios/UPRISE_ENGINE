03262         {\cf19 return} {\cf17 false};\par
03263 \par
03264     ImGuiContext& g = *GImGui;\par
03265     {\cf18 bool} value_changed = {\cf17 false};\par
03266     BeginGroup();\par
03267     PushID(label);\par
03268     PushMultiItemsWidths(components, CalcItemWidth());\par
03269     {\cf18 size_t} type_size = GDataTypeInfo[data_type].Size;\par
03270     {\cf19 for} ({\cf18 int} i = 0; i < components; i++)\par
03271     \{\par
03272         PushID(i);\par
03273         {\cf19 if} (i > 0)\par
03274             SameLine(0, g.Style.ItemInnerSpacing.x);\par
03275         value_changed |= SliderScalar({\cf22 ""}, data_type, v, v_min, v_max, format, flags);\par
03276         PopID();\par
03277         PopItemWidth();\par
03278         v = ({\cf18 void}*)(({\cf18 char}*)v + type_size);\par
03279     \}\par
03280     PopID();\par
03281 \par
03282     {\cf17 const} {\cf18 char}* label_end = FindRenderedTextEnd(label);\par
03283     {\cf19 if} (label != label_end)\par
03284     \{\par
03285         SameLine(0, g.Style.ItemInnerSpacing.x);\par
03286         TextEx(label, label_end);\par
03287     \}\par
03288 \par
03289     EndGroup();\par
03290     {\cf19 return} value_changed;\par
03291 \}\par
