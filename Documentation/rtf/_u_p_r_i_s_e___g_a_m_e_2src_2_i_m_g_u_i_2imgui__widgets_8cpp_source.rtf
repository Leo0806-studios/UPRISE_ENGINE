03909 {\cf17 static} {\cf18 int} is_word_boundary_from_right(ImGuiInputTextState* obj, {\cf18 int} idx)\par
03910 \{\par
03911     {\cf20 // When ImGuiInputTextFlags_Password is set, we don't want actions such as CTRL+Arrow to leak the fact that underlying data are blanks or separators.}\par
03912     {\cf19 if} ((obj->Flags & ImGuiInputTextFlags_Password) || idx <= 0)\par
03913         {\cf19 return} 0;\par
03914 \par
03915     {\cf18 bool} prev_white = ImCharIsBlankW(obj->TextW[idx - 1]);\par
03916     {\cf18 bool} prev_separ = is_separator(obj->TextW[idx - 1]);\par
03917     {\cf18 bool} curr_white = ImCharIsBlankW(obj->TextW[idx]);\par
03918     {\cf18 bool} curr_separ = is_separator(obj->TextW[idx]);\par
03919     {\cf19 return} ((prev_white || prev_separ) && !(curr_separ || curr_white)) || (curr_separ && !prev_separ);\par
03920 \}\par
03921 {\cf17 static} {\cf18 int} is_word_boundary_from_left(ImGuiInputTextState* obj, {\cf18 int} idx)\par
03922 \{\par
