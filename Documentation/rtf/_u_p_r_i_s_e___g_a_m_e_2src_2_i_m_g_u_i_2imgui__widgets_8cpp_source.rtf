00496 \par
00497     {\cf20 // Default behavior requires click + release inside bounding box}\par
00498     {\cf19 if} ((flags & ImGuiButtonFlags_PressedOnMask_) == 0)\par
00499         flags |= ImGuiButtonFlags_PressedOnDefault_;\par
