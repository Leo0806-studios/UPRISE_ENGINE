00712 {\cf18 bool} ImGui::ButtonEx({\cf17 const} {\cf18 char}* label, {\cf17 const} ImVec2& size_arg, ImGuiButtonFlags flags)\par
00713 \{\par
00714     ImGuiWindow* window = GetCurrentWindow();\par
00715     {\cf19 if} (window->SkipItems)\par
00716         {\cf19 return} {\cf17 false};\par
00717 \par
00718     ImGuiContext& g = *GImGui;\par
00719     {\cf17 const} ImGuiStyle& style = g.Style;\par
00720     {\cf17 const} ImGuiID {\cf18 id} = window->GetID(label);\par
00721     {\cf17 const} ImVec2 label_size = CalcTextSize(label, NULL, {\cf17 true});\par
00722 \par
00723     ImVec2 pos = window->DC.CursorPos;\par
00724     {\cf19 if} ((flags & ImGuiButtonFlags_AlignTextBaseLine) && style.FramePadding.y < window->DC.CurrLineTextBaseOffset) {\cf20 // Try to vertically align buttons that are smaller/have no padding so that text baseline matches (bit hacky, since it shouldn't be a flag)}\par
00725         pos.y += window->DC.CurrLineTextBaseOffset - style.FramePadding.y;\par
00726     ImVec2 size = CalcItemSize(size_arg, label_size.x + style.FramePadding.x * 2.0f, label_size.y + style.FramePadding.y * 2.0f);\par
00727 \par
00728     {\cf17 const} ImRect bb(pos, pos + size);\par
00729     ItemSize(size, style.FramePadding.y);\par
00730     {\cf19 if} (!ItemAdd(bb, {\cf18 id}))\par
00731         {\cf19 return} {\cf17 false};\par
00732 \par
00733     {\cf18 bool} hovered, held;\par
00734     {\cf18 bool} pressed = ButtonBehavior(bb, {\cf18 id}, &hovered, &held, flags);\par
00735 \par
00736     {\cf20 // Render}\par
00737     {\cf17 const} ImU32 col = GetColorU32((held && hovered) ? ImGuiCol_ButtonActive : hovered ? ImGuiCol_ButtonHovered : ImGuiCol_Button);\par
00738     RenderNavHighlight(bb, {\cf18 id});\par
00739     RenderFrame(bb.Min, bb.Max, col, {\cf17 true}, style.FrameRounding);\par
00740 \par
00741     {\cf19 if} (g.LogEnabled)\par
00742         LogSetNextTextDecoration({\cf22 "["}, {\cf22 "]"});\par
00743     RenderTextClipped(bb.Min + style.FramePadding, bb.Max - style.FramePadding, label, NULL, &label_size, style.ButtonTextAlign, &bb);\par
00744 \par
00745     {\cf20 // Automatically close popups}\par
00746     {\cf20 //if (pressed && !(flags & ImGuiButtonFlags_DontClosePopups) && (window->Flags & ImGuiWindowFlags_Popup))}\par
00747     {\cf20 //    CloseCurrentPopup();}\par
00748 \par
00749     IMGUI_TEST_ENGINE_ITEM_INFO({\cf18 id}, label, g.LastItemData.StatusFlags);\par
00750     {\cf19 return} pressed;\par
00751 \}\par
