09073 \par
09074 {\cf18 bool}    ImGui::BeginTabBarEx(ImGuiTabBar* tab_bar, {\cf17 const} ImRect& tab_bar_bb, ImGuiTabBarFlags flags)\par
09075 \{\par
09076     ImGuiContext& g = *GImGui;\par
09077     ImGuiWindow* window = g.CurrentWindow;\par
09078     {\cf19 if} (window->SkipItems)\par
09079         {\cf19 return} {\cf17 false};\par
09080 \par
09081     IM_ASSERT(tab_bar->ID != 0);\par
09082     {\cf19 if} ((flags & ImGuiTabBarFlags_DockNode) == 0)\par
09083         PushOverrideID(tab_bar->ID);\par
09084 \par
09085     {\cf20 // Add to stack}\par
09086     g.CurrentTabBarStack.push_back(GetTabBarRefFromTabBar(tab_bar));\par
09087     g.CurrentTabBar = tab_bar;\par
09088 \par
09089     {\cf20 // Append with multiple BeginTabBar()/EndTabBar() pairs.}\par
09090     tab_bar->BackupCursorPos = window->DC.CursorPos;\par
09091     {\cf19 if} (tab_bar->CurrFrameVisible == g.FrameCount)\par
09092     \{\par
09093         window->DC.CursorPos = ImVec2(tab_bar->BarRect.Min.x, tab_bar->BarRect.Max.y + tab_bar->ItemSpacingY);\par
09094         tab_bar->BeginCount++;\par
09095         {\cf19 return} {\cf17 true};\par
09096     \}\par
09097 \par
09098     {\cf20 // Ensure correct ordering when toggling ImGuiTabBarFlags_Reorderable flag, or when a new tab was added while being not reorderable}\par
09099     {\cf19 if} ((flags & ImGuiTabBarFlags_Reorderable) != (tab_bar->Flags & ImGuiTabBarFlags_Reorderable) || (tab_bar->TabsAddedNew && !(flags & ImGuiTabBarFlags_Reorderable)))\par
09100         {\cf19 if} ((flags & ImGuiTabBarFlags_DockNode) == 0) {\cf20 // FIXME: TabBar with DockNode can now be hybrid}\par
09101             ImQsort(tab_bar->Tabs.Data, tab_bar->Tabs.Size, {\cf17 sizeof}(ImGuiTabItem), TabItemComparerByBeginOrder);\par
09102     tab_bar->TabsAddedNew = {\cf17 false};\par
09103 \par
09104     {\cf20 // Flags}\par
09105     {\cf19 if} ((flags & ImGuiTabBarFlags_FittingPolicyMask_) == 0)\par
09106         flags |= ImGuiTabBarFlags_FittingPolicyDefault_;\par
09107 \par
09108     tab_bar->Flags = flags;\par
09109     tab_bar->BarRect = tab_bar_bb;\par
09110     tab_bar->WantLayout = {\cf17 true}; {\cf20 // Layout will be done on the first call to ItemTab()}\par
09111     tab_bar->PrevFrameVisible = tab_bar->CurrFrameVisible;\par
09112     tab_bar->CurrFrameVisible = g.FrameCount;\par
09113     tab_bar->PrevTabsContentsHeight = tab_bar->CurrTabsContentsHeight;\par
09114     tab_bar->CurrTabsContentsHeight = 0.0f;\par
09115     tab_bar->ItemSpacingY = g.Style.ItemSpacing.y;\par
09116     tab_bar->FramePadding = g.Style.FramePadding;\par
09117     tab_bar->TabsActiveCount = 0;\par
09118     tab_bar->LastTabItemIdx = -1;\par
09119     tab_bar->BeginCount = 1;\par
09120 \par
09121     {\cf20 // Set cursor pos in a way which only be used in the off-chance the user erroneously submits item before BeginTabItem(): items will overlap}\par
09122     window->DC.CursorPos = ImVec2(tab_bar->BarRect.Min.x, tab_bar->BarRect.Max.y + tab_bar->ItemSpacingY);\par
09123 \par
09124     {\cf20 // Draw separator}\par
09125     {\cf20 // (it would be misleading to draw this in EndTabBar() suggesting that it may be drawn over tabs, as tab bar are appendable)}\par
09126     {\cf17 const} ImU32 col = GetColorU32((flags & ImGuiTabBarFlags_IsFocused) ? ImGuiCol_TabSelected : ImGuiCol_TabDimmedSelected);\par
09127     {\cf19 if} (g.Style.TabBarBorderSize > 0.0f)\par
09128     \{\par
09129         {\cf17 const} {\cf18 float} y = tab_bar->BarRect.Max.y;\par
09130         window->DrawList->AddRectFilled(ImVec2(tab_bar->SeparatorMinX, y - g.Style.TabBarBorderSize), ImVec2(tab_bar->SeparatorMaxX, y), col);\par
09131     \}\par
09132     {\cf19 return} {\cf17 true};\par
09133 \}\par
09134 \par
09135 {\cf18 void}    ImGui::EndTabBar()\par
09136 \{\par
09137     ImGuiContext& g = *GImGui;\par
09138     ImGuiWindow* window = g.CurrentWindow;\par
09139     {\cf19 if} (window->SkipItems)\par
09140         {\cf19 return};\par
09141 \par
09142     ImGuiTabBar* tab_bar = g.CurrentTabBar;\par
09143     {\cf19 if} (tab_bar == NULL)\par
09144     \{\par
09145         IM_ASSERT_USER_ERROR(tab_bar != NULL, {\cf22 "Mismatched BeginTabBar()/EndTabBar()!"});\par
09146         {\cf19 return};\par
09147     \}\par
09148 \par
09149     {\cf20 // Fallback in case no TabItem have been submitted}\par
09150     {\cf19 if} (tab_bar->WantLayout)\par
09151         TabBarLayout(tab_bar);\par
09152 \par
09153     {\cf20 // Restore the last visible height if no tab is visible, this reduce vertical flicker/movement when a tabs gets removed without calling SetTabItemClosed().}\par
09154     {\cf17 const} {\cf18 bool} tab_bar_appearing = (tab_bar->PrevFrameVisible + 1 < g.FrameCount);\par
09155     {\cf19 if} (tab_bar->VisibleTabWasSubmitted || tab_bar->VisibleTabId == 0 || tab_bar_appearing)\par
09156     \{\par
09157         tab_bar->CurrTabsContentsHeight = ImMax(window->DC.CursorPos.y - tab_bar->BarRect.Max.y, tab_bar->CurrTabsContentsHeight);\par
09158         window->DC.CursorPos.y = tab_bar->BarRect.Max.y + tab_bar->CurrTabsContentsHeight;\par
09159     \}\par
09160     {\cf19 else}\par
09161     \{\par
09162         window->DC.CursorPos.y = tab_bar->BarRect.Max.y + tab_bar->PrevTabsContentsHeight;\par
09163     \}\par
09164     {\cf19 if} (tab_bar->BeginCount > 1)\par
09165         window->DC.CursorPos = tab_bar->BackupCursorPos;\par
09166 \par
09167     tab_bar->LastTabItemIdx = -1;\par
09168     {\cf19 if} ((tab_bar->Flags & ImGuiTabBarFlags_DockNode) == 0)\par
09169         PopID();\par
09170 \par
09171     g.CurrentTabBarStack.pop_back();\par
09172     g.CurrentTabBar = g.CurrentTabBarStack.empty() ? NULL : GetTabBarFromTabBarRef(g.CurrentTabBarStack.back());\par
09173 \}\par
09174 \par
09175 {\cf20 // Scrolling happens only in the central section (leading/trailing sections are not scrolling)}\par
09176 {\cf17 static} {\cf18 float} TabBarCalcScrollableWidth(ImGuiTabBar* tab_bar, ImGuiTabBarSection* sections)\par
09177 \{\par
09178     {\cf19 return} tab_bar->BarRect.GetWidth() - sections[0].Width - sections[2].Width - sections[1].Spacing;\par
09179 \}\par
09180 \par
09181 {\cf20 // This is called only once a frame before by the first call to ItemTab()}\par
09182 {\cf20 // The reason we're not calling it in BeginTabBar() is to leave a chance to the user to call the SetTabItemClosed() functions.}\par
09183 {\cf17 static} {\cf18 void} ImGui::TabBarLayout(ImGuiTabBar* tab_bar)\par
09184 \{\par
09185     ImGuiContext& g = *GImGui;\par
09186     tab_bar->WantLayout = {\cf17 false};\par
09187 \par
09188     {\cf20 // Garbage collect by compacting list}\par
09189     {\cf20 // Detect if we need to sort out tab list (e.g. in rare case where a tab changed section)}\par
09190     {\cf18 int} tab_dst_n = 0;\par
09191     {\cf18 bool} need_sort_by_section = {\cf17 false};\par
09192     ImGuiTabBarSection sections[3]; {\cf20 // Layout sections: Leading, Central, Trailing}\par
09193     {\cf19 for} ({\cf18 int} tab_src_n = 0; tab_src_n < tab_bar->Tabs.Size; tab_src_n++)\par
09194     \{\par
09195         ImGuiTabItem* tab = &tab_bar->Tabs[tab_src_n];\par
09196         {\cf19 if} (tab->LastFrameVisible < tab_bar->PrevFrameVisible || tab->WantClose)\par
09197         \{\par
09198             {\cf20 // Remove tab}\par
09199             {\cf19 if} (tab_bar->VisibleTabId == tab->ID) \{ tab_bar->VisibleTabId = 0; \}\par
09200             {\cf19 if} (tab_bar->SelectedTabId == tab->ID) \{ tab_bar->SelectedTabId = 0; \}\par
09201             {\cf19 if} (tab_bar->NextSelectedTabId == tab->ID) \{ tab_bar->NextSelectedTabId = 0; \}\par
09202             {\cf19 continue};\par
09203         \}\par
09204         {\cf19 if} (tab_dst_n != tab_src_n)\par
09205             tab_bar->Tabs[tab_dst_n] = tab_bar->Tabs[tab_src_n];\par
09206 \par
09207         tab = &tab_bar->Tabs[tab_dst_n];\par
09208         tab->IndexDuringLayout = (ImS16)tab_dst_n;\par
09209 \par
09210         {\cf20 // We will need sorting if tabs have changed section (e.g. moved from one of Leading/Central/Trailing to another)}\par
09211         {\cf18 int} curr_tab_section_n = TabItemGetSectionIdx(tab);\par
09212         {\cf19 if} (tab_dst_n > 0)\par
09213         \{\par
09214             ImGuiTabItem* prev_tab = &tab_bar->Tabs[tab_dst_n - 1];\par
09215             {\cf18 int} prev_tab_section_n = TabItemGetSectionIdx(prev_tab);\par
09216             {\cf19 if} (curr_tab_section_n == 0 && prev_tab_section_n != 0)\par
09217                 need_sort_by_section = {\cf17 true};\par
09218             {\cf19 if} (prev_tab_section_n == 2 && curr_tab_section_n != 2)\par
09219                 need_sort_by_section = {\cf17 true};\par
09220         \}\par
09221 \par
09222         sections[curr_tab_section_n].TabCount++;\par
09223         tab_dst_n++;\par
09224     \}\par
09225     {\cf19 if} (tab_bar->Tabs.Size != tab_dst_n)\par
09226         tab_bar->Tabs.resize(tab_dst_n);\par
09227 \par
09228     {\cf19 if} (need_sort_by_section)\par
09229         ImQsort(tab_bar->Tabs.Data, tab_bar->Tabs.Size, {\cf17 sizeof}(ImGuiTabItem), TabItemComparerBySection);\par
09230 \par
09231     {\cf20 // Calculate spacing between sections}\par
09232     sections[0].Spacing = sections[0].TabCount > 0 && (sections[1].TabCount + sections[2].TabCount) > 0 ? g.Style.ItemInnerSpacing.x : 0.0f;\par
09233     sections[1].Spacing = sections[1].TabCount > 0 && sections[2].TabCount > 0 ? g.Style.ItemInnerSpacing.x : 0.0f;\par
09234 \par
09235     {\cf20 // Setup next selected tab}\par
09236     ImGuiID scroll_to_tab_id = 0;\par
09237     {\cf19 if} (tab_bar->NextSelectedTabId)\par
09238     \{\par
09239         tab_bar->SelectedTabId = tab_bar->NextSelectedTabId;\par
09240         tab_bar->NextSelectedTabId = 0;\par
09241         scroll_to_tab_id = tab_bar->SelectedTabId;\par
09242     \}\par
09243 \par
09244     {\cf20 // Process order change request (we could probably process it when requested but it's just saner to do it in a single spot).}\par
09245     {\cf19 if} (tab_bar->ReorderRequestTabId != 0)\par
09246     \{\par
09247         {\cf19 if} (TabBarProcessReorder(tab_bar))\par
09248             {\cf19 if} (tab_bar->ReorderRequestTabId == tab_bar->SelectedTabId)\par
09249                 scroll_to_tab_id = tab_bar->ReorderRequestTabId;\par
09250         tab_bar->ReorderRequestTabId = 0;\par
09251     \}\par
09252 \par
09253     {\cf20 // Tab List Popup (will alter tab_bar->BarRect and therefore the available width!)}\par
09254     {\cf17 const} {\cf18 bool} tab_list_popup_button = (tab_bar->Flags & ImGuiTabBarFlags_TabListPopupButton) != 0;\par
09255     {\cf19 if} (tab_list_popup_button)\par
09256         {\cf19 if} (ImGuiTabItem* tab_to_select = TabBarTabListPopupButton(tab_bar)) {\cf20 // NB: Will alter BarRect.Min.x!}\par
09257             scroll_to_tab_id = tab_bar->SelectedTabId = tab_to_select->ID;\par
09258 \par
09259     {\cf20 // Leading/Trailing tabs will be shrink only if central one aren't visible anymore, so layout the shrink data as: leading, trailing, central}\par
09260     {\cf20 // (whereas our tabs are stored as: leading, central, trailing)}\par
09261     {\cf18 int} shrink_buffer_indexes[3] = \{ 0, sections[0].TabCount + sections[2].TabCount, sections[0].TabCount \};\par
09262     g.ShrinkWidthBuffer.resize(tab_bar->Tabs.Size);\par
09263 \par
09264     {\cf20 // Compute ideal tabs widths + store them into shrink buffer}\par
09265     ImGuiTabItem* most_recently_selected_tab = NULL;\par
09266     {\cf18 int} curr_section_n = -1;\par
09267     {\cf18 bool} found_selected_tab_id = {\cf17 false};\par
09268     {\cf19 for} ({\cf18 int} tab_n = 0; tab_n < tab_bar->Tabs.Size; tab_n++)\par
09269     \{\par
09270         ImGuiTabItem* tab = &tab_bar->Tabs[tab_n];\par
09271         IM_ASSERT(tab->LastFrameVisible >= tab_bar->PrevFrameVisible);\par
09272 \par
09273         {\cf19 if} ((most_recently_selected_tab == NULL || most_recently_selected_tab->LastFrameSelected < tab->LastFrameSelected) && !(tab->Flags & ImGuiTabItemFlags_Button))\par
09274             most_recently_selected_tab = tab;\par
09275         {\cf19 if} (tab->ID == tab_bar->SelectedTabId)\par
09276             found_selected_tab_id = {\cf17 true};\par
09277         {\cf19 if} (scroll_to_tab_id == 0 && g.NavJustMovedToId == tab->ID)\par
09278             scroll_to_tab_id = tab->ID;\par
09279 \par
09280         {\cf20 // Refresh tab width immediately, otherwise changes of style e.g. style.FramePadding.x would noticeably lag in the tab bar.}\par
09281         {\cf20 // Additionally, when using TabBarAddTab() to manipulate tab bar order we occasionally insert new tabs that don't have a width yet,}\par
09282         {\cf20 // and we cannot wait for the next BeginTabItem() call. We cannot compute this width within TabBarAddTab() because font size depends on the active window.}\par
09283         {\cf17 const} {\cf18 char}* tab_name = TabBarGetTabName(tab_bar, tab);\par
09284         {\cf17 const} {\cf18 bool} has_close_button_or_unsaved_marker = (tab->Flags & ImGuiTabItemFlags_NoCloseButton) == 0 || (tab->Flags & ImGuiTabItemFlags_UnsavedDocument);\par
09285         tab->ContentWidth = (tab->RequestedWidth >= 0.0f) ? tab->RequestedWidth : TabItemCalcSize(tab_name, has_close_button_or_unsaved_marker).x;\par
09286 \par
09287         {\cf18 int} section_n = TabItemGetSectionIdx(tab);\par
09288         ImGuiTabBarSection* section = &sections[section_n];\par
09289         section->Width += tab->ContentWidth + (section_n == curr_section_n ? g.Style.ItemInnerSpacing.x : 0.0f);\par
09290         curr_section_n = section_n;\par
09291 \par
09292         {\cf20 // Store data so we can build an array sorted by width if we need to shrink tabs down}\par
09293         IM_MSVC_WARNING_SUPPRESS(6385);\par
09294         ImGuiShrinkWidthItem* shrink_width_item = &g.ShrinkWidthBuffer[shrink_buffer_indexes[section_n]++];\par
09295         shrink_width_item->Index = tab_n;\par
09296         shrink_width_item->Width = shrink_width_item->InitialWidth = tab->ContentWidth;\par
09297         tab->Width = ImMax(tab->ContentWidth, 1.0f);\par
09298     \}\par
09299 \par
09300     {\cf20 // Compute total ideal width (used for e.g. auto-resizing a window)}\par
09301     tab_bar->WidthAllTabsIdeal = 0.0f;\par
09302     {\cf19 for} ({\cf18 int} section_n = 0; section_n < 3; section_n++)\par
09303         tab_bar->WidthAllTabsIdeal += sections[section_n].Width + sections[section_n].Spacing;\par
09304 \par
09305     {\cf20 // Horizontal scrolling buttons}\par
09306     {\cf20 // (note that TabBarScrollButtons() will alter BarRect.Max.x)}\par
09307     {\cf19 if} ((tab_bar->WidthAllTabsIdeal > tab_bar->BarRect.GetWidth() && tab_bar->Tabs.Size > 1) && !(tab_bar->Flags & ImGuiTabBarFlags_NoTabListScrollingButtons) && (tab_bar->Flags & ImGuiTabBarFlags_FittingPolicyScroll))\par
09308         {\cf19 if} (ImGuiTabItem* scroll_and_select_tab = TabBarScrollingButtons(tab_bar))\par
09309         \{\par
09310             scroll_to_tab_id = scroll_and_select_tab->ID;\par
09311             {\cf19 if} ((scroll_and_select_tab->Flags & ImGuiTabItemFlags_Button) == 0)\par
09312                 tab_bar->SelectedTabId = scroll_to_tab_id;\par
09313         \}\par
09314 \par
09315     {\cf20 // Shrink widths if full tabs don't fit in their allocated space}\par
09316     {\cf18 float} section_0_w = sections[0].Width + sections[0].Spacing;\par
09317     {\cf18 float} section_1_w = sections[1].Width + sections[1].Spacing;\par
09318     {\cf18 float} section_2_w = sections[2].Width + sections[2].Spacing;\par
09319     {\cf18 bool} central_section_is_visible = (section_0_w + section_2_w) < tab_bar->BarRect.GetWidth();\par
09320     {\cf18 float} width_excess;\par
09321     {\cf19 if} (central_section_is_visible)\par
09322         width_excess = ImMax(section_1_w - (tab_bar->BarRect.GetWidth() - section_0_w - section_2_w), 0.0f); {\cf20 // Excess used to shrink central section}\par
09323     {\cf19 else}\par
09324         width_excess = (section_0_w + section_2_w) - tab_bar->BarRect.GetWidth(); {\cf20 // Excess used to shrink leading/trailing section}\par
09325 \par
09326     {\cf20 // With ImGuiTabBarFlags_FittingPolicyScroll policy, we will only shrink leading/trailing if the central section is not visible anymore}\par
09327     {\cf19 if} (width_excess >= 1.0f && ((tab_bar->Flags & ImGuiTabBarFlags_FittingPolicyResizeDown) || !central_section_is_visible))\par
09328     \{\par
09329         {\cf18 int} shrink_data_count = (central_section_is_visible ? sections[1].TabCount : sections[0].TabCount + sections[2].TabCount);\par
09330         {\cf18 int} shrink_data_offset = (central_section_is_visible ? sections[0].TabCount + sections[2].TabCount : 0);\par
09331         ShrinkWidths(g.ShrinkWidthBuffer.Data + shrink_data_offset, shrink_data_count, width_excess);\par
09332 \par
09333         {\cf20 // Apply shrunk values into tabs and sections}\par
09334         {\cf19 for} ({\cf18 int} tab_n = shrink_data_offset; tab_n < shrink_data_offset + shrink_data_count; tab_n++)\par
09335         \{\par
09336             ImGuiTabItem* tab = &tab_bar->Tabs[g.ShrinkWidthBuffer[tab_n].Index];\par
09337             {\cf18 float} shrinked_width = IM_TRUNC(g.ShrinkWidthBuffer[tab_n].Width);\par
09338             {\cf19 if} (shrinked_width < 0.0f)\par
09339                 {\cf19 continue};\par
09340 \par
09341             shrinked_width = ImMax(1.0f, shrinked_width);\par
09342             {\cf18 int} section_n = TabItemGetSectionIdx(tab);\par
09343             sections[section_n].Width -= (tab->Width - shrinked_width);\par
09344             tab->Width = shrinked_width;\par
09345         \}\par
09346     \}\par
09347 \par
09348     {\cf20 // Layout all active tabs}\par
09349     {\cf18 int} section_tab_index = 0;\par
09350     {\cf18 float} tab_offset = 0.0f;\par
09351     tab_bar->WidthAllTabs = 0.0f;\par
09352     {\cf19 for} ({\cf18 int} section_n = 0; section_n < 3; section_n++)\par
09353     \{\par
09354         ImGuiTabBarSection* section = &sections[section_n];\par
09355         {\cf19 if} (section_n == 2)\par
09356             tab_offset = ImMin(ImMax(0.0f, tab_bar->BarRect.GetWidth() - section->Width), tab_offset);\par
09357 \par
09358         {\cf19 for} ({\cf18 int} tab_n = 0; tab_n < section->TabCount; tab_n++)\par
09359         \{\par
09360             ImGuiTabItem* tab = &tab_bar->Tabs[section_tab_index + tab_n];\par
09361             tab->Offset = tab_offset;\par
09362             tab->NameOffset = -1;\par
09363             tab_offset += tab->Width + (tab_n < section->TabCount - 1 ? g.Style.ItemInnerSpacing.x : 0.0f);\par
09364         \}\par
09365         tab_bar->WidthAllTabs += ImMax(section->Width + section->Spacing, 0.0f);\par
09366         tab_offset += section->Spacing;\par
09367         section_tab_index += section->TabCount;\par
09368     \}\par
09369 \par
09370     {\cf20 // Clear name buffers}\par
09371     tab_bar->TabsNames.Buf.resize(0);\par
09372 \par
09373     {\cf20 // If we have lost the selected tab, select the next most recently active one}\par
09374     {\cf19 if} (found_selected_tab_id == {\cf17 false})\par
09375         tab_bar->SelectedTabId = 0;\par
09376     {\cf19 if} (tab_bar->SelectedTabId == 0 && tab_bar->NextSelectedTabId == 0 && most_recently_selected_tab != NULL)\par
09377         scroll_to_tab_id = tab_bar->SelectedTabId = most_recently_selected_tab->ID;\par
09378 \par
09379     {\cf20 // Lock in visible tab}\par
09380     tab_bar->VisibleTabId = tab_bar->SelectedTabId;\par
09381     tab_bar->VisibleTabWasSubmitted = {\cf17 false};\par
09382 \par
09383     {\cf20 // CTRL+TAB can override visible tab temporarily}\par
09384     {\cf19 if} (g.NavWindowingTarget != NULL && g.NavWindowingTarget->DockNode && g.NavWindowingTarget->DockNode->TabBar == tab_bar)\par
09385         tab_bar->VisibleTabId = scroll_to_tab_id = g.NavWindowingTarget->TabId;\par
09386 \par
09387     {\cf20 // Apply request requests}\par
09388     {\cf19 if} (scroll_to_tab_id != 0)\par
09389         TabBarScrollToTab(tab_bar, scroll_to_tab_id, sections);\par
09390     {\cf19 else} {\cf19 if} ((tab_bar->Flags & ImGuiTabBarFlags_FittingPolicyScroll) && IsMouseHoveringRect(tab_bar->BarRect.Min, tab_bar->BarRect.Max, {\cf17 true}) && IsWindowContentHoverable(g.CurrentWindow))\par
09391     \{\par
09392         {\cf17 const} {\cf18 float} wheel = g.IO.MouseWheelRequestAxisSwap ? g.IO.MouseWheel : g.IO.MouseWheelH;\par
09393         {\cf17 const} ImGuiKey wheel_key = g.IO.MouseWheelRequestAxisSwap ? ImGuiKey_MouseWheelY : ImGuiKey_MouseWheelX;\par
09394         {\cf19 if} (TestKeyOwner(wheel_key, tab_bar->ID) && wheel != 0.0f)\par
09395         \{\par
09396             {\cf17 const} {\cf18 float} scroll_step = wheel * TabBarCalcScrollableWidth(tab_bar, sections) / 3.0f;\par
09397             tab_bar->ScrollingTargetDistToVisibility = 0.0f;\par
09398             tab_bar->ScrollingTarget = TabBarScrollClamp(tab_bar, tab_bar->ScrollingTarget - scroll_step);\par
09399         \}\par
09400         SetKeyOwner(wheel_key, tab_bar->ID);\par
09401     \}\par
09402 \par
09403     {\cf20 // Update scrolling}\par
09404     tab_bar->ScrollingAnim = TabBarScrollClamp(tab_bar, tab_bar->ScrollingAnim);\par
09405     tab_bar->ScrollingTarget = TabBarScrollClamp(tab_bar, tab_bar->ScrollingTarget);\par
09406     {\cf19 if} (tab_bar->ScrollingAnim != tab_bar->ScrollingTarget)\par
09407     \{\par
09408         {\cf20 // Scrolling speed adjust itself so we can always reach our target in 1/3 seconds.}\par
09409         {\cf20 // Teleport if we are aiming far off the visible line}\par
09410         tab_bar->ScrollingSpeed = ImMax(tab_bar->ScrollingSpeed, 70.0f * g.FontSize);\par
09411         tab_bar->ScrollingSpeed = ImMax(tab_bar->ScrollingSpeed, ImFabs(tab_bar->ScrollingTarget - tab_bar->ScrollingAnim) / 0.3f);\par
09412         {\cf17 const} {\cf18 bool} teleport = (tab_bar->PrevFrameVisible + 1 < g.FrameCount) || (tab_bar->ScrollingTargetDistToVisibility > 10.0f * g.FontSize);\par
09413         tab_bar->ScrollingAnim = teleport ? tab_bar->ScrollingTarget : ImLinearSweep(tab_bar->ScrollingAnim, tab_bar->ScrollingTarget, g.IO.DeltaTime * tab_bar->ScrollingSpeed);\par
09414     \}\par
09415     {\cf19 else}\par
09416     \{\par
09417         tab_bar->ScrollingSpeed = 0.0f;\par
09418     \}\par
09419     tab_bar->ScrollingRectMinX = tab_bar->BarRect.Min.x + sections[0].Width + sections[0].Spacing;\par
09420     tab_bar->ScrollingRectMaxX = tab_bar->BarRect.Max.x - sections[2].Width - sections[1].Spacing;\par
09421 \par
09422     {\cf20 // Actual layout in host window (we don't do it in BeginTabBar() so as not to waste an extra frame)}\par
09423     ImGuiWindow* window = g.CurrentWindow;\par
09424     window->DC.CursorPos = tab_bar->BarRect.Min;\par
09425     ItemSize(ImVec2(tab_bar->WidthAllTabs, tab_bar->BarRect.GetHeight()), tab_bar->FramePadding.y);\par
09426     window->DC.IdealMaxPos.x = ImMax(window->DC.IdealMaxPos.x, tab_bar->BarRect.Min.x + tab_bar->WidthAllTabsIdeal);\par
09427 \}\par
