02368 {\cf17 template}<{\cf17 typename} TYPE>\par
02369 TYPE ImGui::RoundScalarWithFormatT({\cf17 const} {\cf18 char}* format, ImGuiDataType data_type, TYPE v)\par
02370 \{\par
02371     IM_UNUSED(data_type);\par
02372     IM_ASSERT(data_type == ImGuiDataType_Float || data_type == ImGuiDataType_Double);\par
02373     {\cf17 const} {\cf18 char}* fmt_start = ImParseFormatFindStart(format);\par
02374     {\cf19 if} (fmt_start[0] != {\cf23 '%'} || fmt_start[1] == {\cf23 '%'}) {\cf20 // Don't apply if the value is not visible in the format string}\par
02375         {\cf19 return} v;\par
02376 \par
02377     {\cf20 // Sanitize format}\par
02378     {\cf18 char} fmt_sanitized[32];\par
02379     ImParseFormatSanitizeForPrinting(fmt_start, fmt_sanitized, IM_ARRAYSIZE(fmt_sanitized));\par
02380     fmt_start = fmt_sanitized;\par
02381 \par
02382     {\cf20 // Format value with our rounding, and read back}\par
02383     {\cf18 char} v_str[64];\par
02384     ImFormatString(v_str, IM_ARRAYSIZE(v_str), fmt_start, v);\par
02385     {\cf17 const} {\cf18 char}* p = v_str;\par
02386     {\cf19 while} (*p == {\cf23 ' '})\par
02387         p++;\par
02388     v = (TYPE)ImAtof(p);\par
02389 \par
02390     {\cf19 return} v;\par
02391 \}\par
