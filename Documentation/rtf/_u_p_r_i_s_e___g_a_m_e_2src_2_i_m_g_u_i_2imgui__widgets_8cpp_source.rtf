00946 \par
00947 {\cf20 // Vertical/Horizontal scrollbar}\par
00948 {\cf20 // The entire piece of code below is rather confusing because:}\par
00949 {\cf20 // - We handle absolute seeking (when first clicking outside the grab) and relative manipulation (afterward or when clicking inside the grab)}\par
00950 {\cf20 // - We store values as normalized ratio and in a form that allows the window content to change while we are holding on a scrollbar}\par
00951 {\cf20 // - We handle both horizontal and vertical scrollbars, which makes the terminology not ideal.}\par
00952 {\cf20 // Still, the code should probably be made simpler..}\par
00953 {\cf18 bool} ImGui::ScrollbarEx({\cf17 const} ImRect& bb_frame, ImGuiID {\cf18 id}, ImGuiAxis axis, ImS64* p_scroll_v, ImS64 size_visible_v, ImS64 size_contents_v, ImDrawFlags flags)\par
00954 \{\par
00955     ImGuiContext& g = *GImGui;\par
00956     ImGuiWindow* window = g.CurrentWindow;\par
00957     {\cf19 if} (window->SkipItems)\par
00958         {\cf19 return} {\cf17 false};\par
00959 \par
00960     {\cf17 const} {\cf18 float} bb_frame_width = bb_frame.GetWidth();\par
00961     {\cf17 const} {\cf18 float} bb_frame_height = bb_frame.GetHeight();\par
00962     {\cf19 if} (bb_frame_width <= 0.0f || bb_frame_height <= 0.0f)\par
00963         {\cf19 return} {\cf17 false};\par
00964 \par
00965     {\cf20 // When we are too small, start hiding and disabling the grab (this reduce visual noise on very small window and facilitate using the window resize grab)}\par
00966     {\cf18 float} alpha = 1.0f;\par
00967     {\cf19 if} ((axis == ImGuiAxis_Y) && bb_frame_height < g.FontSize + g.Style.FramePadding.y * 2.0f)\par
00968         alpha = ImSaturate((bb_frame_height - g.FontSize) / (g.Style.FramePadding.y * 2.0f));\par
00969     {\cf19 if} (alpha <= 0.0f)\par
00970         {\cf19 return} {\cf17 false};\par
00971 \par
00972     {\cf17 const} ImGuiStyle& style = g.Style;\par
00973     {\cf17 const} {\cf18 bool} allow_interaction = (alpha >= 1.0f);\par
00974 \par
00975     ImRect bb = bb_frame;\par
00976     bb.Expand(ImVec2(-ImClamp(IM_TRUNC((bb_frame_width - 2.0f) * 0.5f), 0.0f, 3.0f), -ImClamp(IM_TRUNC((bb_frame_height - 2.0f) * 0.5f), 0.0f, 3.0f)));\par
00977 \par
00978     {\cf20 // V denote the main, longer axis of the scrollbar (= height for a vertical scrollbar)}\par
00979     {\cf17 const} {\cf18 float} scrollbar_size_v = (axis == ImGuiAxis_X) ? bb.GetWidth() : bb.GetHeight();\par
00980 \par
00981     {\cf20 // Calculate the height of our grabbable box. It generally represent the amount visible (vs the total scrollable amount)}\par
00982     {\cf20 // But we maintain a minimum size in pixel to allow for the user to still aim inside.}\par
00983     IM_ASSERT(ImMax(size_contents_v, size_visible_v) > 0.0f); {\cf20 // Adding this assert to check if the ImMax(XXX,1.0f) is still needed. PLEASE CONTACT ME if this triggers.}\par
00984     {\cf17 const} ImS64 win_size_v = ImMax(ImMax(size_contents_v, size_visible_v), (ImS64)1);\par
00985     {\cf17 const} {\cf18 float} grab_h_pixels = ImClamp(scrollbar_size_v * (({\cf18 float})size_visible_v / ({\cf18 float})win_size_v), style.GrabMinSize, scrollbar_size_v);\par
00986     {\cf17 const} {\cf18 float} grab_h_norm = grab_h_pixels / scrollbar_size_v;\par
00987 \par
00988     {\cf20 // Handle input right away. None of the code of Begin() is relying on scrolling position before calling Scrollbar().}\par
00989     {\cf18 bool} held = {\cf17 false};\par
00990     {\cf18 bool} hovered = {\cf17 false};\par
00991     ItemAdd(bb_frame, {\cf18 id}, NULL, ImGuiItemFlags_NoNav);\par
00992     ButtonBehavior(bb, {\cf18 id}, &hovered, &held, ImGuiButtonFlags_NoNavFocus);\par
00993 \par
00994     {\cf17 const} ImS64 scroll_max = ImMax((ImS64)1, size_contents_v - size_visible_v);\par
00995     {\cf18 float} scroll_ratio = ImSaturate(({\cf18 float})*p_scroll_v / ({\cf18 float})scroll_max);\par
00996     {\cf18 float} grab_v_norm = scroll_ratio * (scrollbar_size_v - grab_h_pixels) / scrollbar_size_v; {\cf20 // Grab position in normalized space}\par
00997     {\cf19 if} (held && allow_interaction && grab_h_norm < 1.0f)\par
00998     \{\par
00999         {\cf17 const} {\cf18 float} scrollbar_pos_v = bb.Min[axis];\par
01000         {\cf17 const} {\cf18 float} mouse_pos_v = g.IO.MousePos[axis];\par
01001 \par
01002         {\cf20 // Click position in scrollbar normalized space (0.0f->1.0f)}\par
01003         {\cf17 const} {\cf18 float} clicked_v_norm = ImSaturate((mouse_pos_v - scrollbar_pos_v) / scrollbar_size_v);\par
01004 \par
01005         {\cf17 const} {\cf18 int} held_dir = (clicked_v_norm < grab_v_norm) ? -1 : (clicked_v_norm > grab_v_norm + grab_h_norm) ? +1 : 0;\par
01006         {\cf19 if} (g.ActiveIdIsJustActivated)\par
01007         \{\par
01008             {\cf20 // On initial click calculate the distance between mouse and the center of the grab}\par
01009             g.ScrollbarSeekMode = (short)held_dir;\par
01010             g.ScrollbarClickDeltaToGrabCenter = (g.ScrollbarSeekMode == 0.0f) ? clicked_v_norm - grab_v_norm - grab_h_norm * 0.5f : 0.0f;\par
01011         \}\par
01012 \par
01013         {\cf20 // Apply scroll (p_scroll_v will generally point on one member of window->Scroll)}\par
01014         {\cf20 // It is ok to modify Scroll here because we are being called in Begin() after the calculation of ContentSize and before setting up our starting position}\par
01015         {\cf19 if} (g.ScrollbarSeekMode == 0)\par
01016         \{\par
01017             {\cf20 // Absolute seeking}\par
01018             {\cf17 const} {\cf18 float} scroll_v_norm = ImSaturate((clicked_v_norm - g.ScrollbarClickDeltaToGrabCenter - grab_h_norm * 0.5f) / (1.0f - grab_h_norm));\par
01019             *p_scroll_v = (ImS64)(scroll_v_norm * scroll_max);\par
01020         \}\par
01021         {\cf19 else}\par
01022         \{\par
01023             {\cf20 // Page by page}\par
01024             {\cf19 if} (IsMouseClicked(ImGuiMouseButton_Left, ImGuiInputFlags_Repeat) && held_dir == g.ScrollbarSeekMode)\par
01025             \{\par
01026                 {\cf18 float} page_dir = (g.ScrollbarSeekMode > 0.0f) ? +1.0f : -1.0f;\par
01027                 *p_scroll_v = ImClamp(*p_scroll_v + (ImS64)(page_dir * size_visible_v), (ImS64)0, scroll_max);\par
01028             \}\par
01029         \}\par
01030 \par
01031         {\cf20 // Update values for rendering}\par
01032         scroll_ratio = ImSaturate(({\cf18 float})*p_scroll_v / ({\cf18 float})scroll_max);\par
01033         grab_v_norm = scroll_ratio * (scrollbar_size_v - grab_h_pixels) / scrollbar_size_v;\par
01034 \par
01035         {\cf20 // Update distance to grab now that we have seek'ed and saturated}\par
01036         {\cf20 //if (seek_absolute)}\par
01037         {\cf20 //    g.ScrollbarClickDeltaToGrabCenter = clicked_v_norm - grab_v_norm - grab_h_norm * 0.5f;}\par
01038     \}\par
01039 \par
01040     {\cf20 // Render}\par
01041     {\cf17 const} ImU32 bg_col = GetColorU32(ImGuiCol_ScrollbarBg);\par
01042     {\cf17 const} ImU32 grab_col = GetColorU32(held ? ImGuiCol_ScrollbarGrabActive : hovered ? ImGuiCol_ScrollbarGrabHovered : ImGuiCol_ScrollbarGrab, alpha);\par
01043     window->DrawList->AddRectFilled(bb_frame.Min, bb_frame.Max, bg_col, window->WindowRounding, flags);\par
01044     ImRect grab_rect;\par
01045     {\cf19 if} (axis == ImGuiAxis_X)\par
01046         grab_rect = ImRect(ImLerp(bb.Min.x, bb.Max.x, grab_v_norm), bb.Min.y, ImLerp(bb.Min.x, bb.Max.x, grab_v_norm) + grab_h_pixels, bb.Max.y);\par
01047     {\cf19 else}\par
01048         grab_rect = ImRect(bb.Min.x, ImLerp(bb.Min.y, bb.Max.y, grab_v_norm), bb.Max.x, ImLerp(bb.Min.y, bb.Max.y, grab_v_norm) + grab_h_pixels);\par
01049     window->DrawList->AddRectFilled(grab_rect.Min, grab_rect.Max, grab_col, style.ScrollbarRounding);\par
01050 \par
01051     {\cf19 return} held;\par
01052 \}\par
01053 \par
01054 {\cf20 // - Read about ImTextureID here: https://github.com/ocornut/imgui/wiki/Image-Loading-and-Displaying-Examples}\par
01055 {\cf20 // - 'uv0' and 'uv1' are texture coordinates. Read about them from the same link above.}\par
01056 {\cf18 void} ImGui::Image(ImTextureID user_texture_id, {\cf17 const} ImVec2& image_size, {\cf17 const} ImVec2& uv0, {\cf17 const} ImVec2& uv1, {\cf17 const} ImVec4& tint_col, {\cf17 const} ImVec4& border_col)\par
01057 \{\par
