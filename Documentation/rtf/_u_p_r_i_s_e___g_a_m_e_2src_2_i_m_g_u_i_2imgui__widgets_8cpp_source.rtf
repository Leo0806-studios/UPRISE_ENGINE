07734             \}\par
07735         \}\par
07736 \par
07737     {\cf20 // Right-click handling.}\par
07738     {\cf20 // FIXME-MULTISELECT: Currently filtered out by ImGuiMultiSelectFlags_NoAutoSelect but maybe should be moved to Selectable(). See https://github.com/ocornut/imgui/pull/5816}\par
