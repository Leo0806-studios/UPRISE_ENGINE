06929         \{\par
06930             ImGuiNavHighlightFlags nav_highlight_flags = ImGuiNavHighlightFlags_Compact | ImGuiNavHighlightFlags_NoRounding;\par
06931             {\cf19 if} (is_multi_select)\par
