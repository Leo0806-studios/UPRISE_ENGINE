02395 {\cf20 //-------------------------------------------------------------------------}\par
02396 {\cf20 // - DragBehaviorT<>() [Internal]}\par
02397 {\cf20 // - DragBehavior() [Internal]}\par
02398 {\cf20 // - DragScalar()}\par
02399 {\cf20 // - DragScalarN()}\par
02400 {\cf20 // - DragFloat()}\par
02401 {\cf20 // - DragFloat2()}\par
02402 {\cf20 // - DragFloat3()}\par
02403 {\cf20 // - DragFloat4()}\par
02404 {\cf20 // - DragFloatRange2()}\par
02405 {\cf20 // - DragInt()}\par
02406 {\cf20 // - DragInt2()}\par
02407 {\cf20 // - DragInt3()}\par
02408 {\cf20 // - DragInt4()}\par
02409 {\cf20 // - DragIntRange2()}\par
02410 {\cf20 //-------------------------------------------------------------------------}\par
02411 \par
02412 {\cf20 // This is called by DragBehavior() when the widget is active (held by mouse or being manipulated with Nav controls)}\par
02413 {\cf17 template}<{\cf17 typename} TYPE, {\cf17 typename} SIGNEDTYPE, {\cf17 typename} FLOATTYPE>\par
02414 {\cf18 bool} ImGui::DragBehaviorT(ImGuiDataType data_type, TYPE* v, {\cf18 float} v_speed, {\cf17 const} TYPE v_min, {\cf17 const} TYPE v_max, {\cf17 const} {\cf18 char}* format, ImGuiSliderFlags flags)\par
02415 \{\par
02416     ImGuiContext& g = *GImGui;\par
02417     {\cf17 const} ImGuiAxis axis = (flags & ImGuiSliderFlags_Vertical) ? ImGuiAxis_Y : ImGuiAxis_X;\par
02418     {\cf17 const} {\cf18 bool} is_bounded = (v_min < v_max);\par
02419     {\cf17 const} {\cf18 bool} is_wrapped = is_bounded && (flags & ImGuiSliderFlags_WrapAround);\par
02420     {\cf17 const} {\cf18 bool} is_logarithmic = (flags & ImGuiSliderFlags_Logarithmic) != 0;\par
02421     {\cf17 const} {\cf18 bool} is_floating_point = (data_type == ImGuiDataType_Float) || (data_type == ImGuiDataType_Double);\par
02422 \par
02423     {\cf20 // Default tweak speed}\par
02424     {\cf19 if} (v_speed == 0.0f && is_bounded && (v_max - v_min < FLT_MAX))\par
02425         v_speed = ({\cf18 float})((v_max - v_min) * g.DragSpeedDefaultRatio);\par
02426 \par
02427     {\cf20 // Inputs accumulates into g.DragCurrentAccum, which is flushed into the current value as soon as it makes a difference with our precision settings}\par
02428     {\cf18 float} adjust_delta = 0.0f;\par
02429     {\cf19 if} (g.ActiveIdSource == ImGuiInputSource_Mouse && IsMousePosValid() && IsMouseDragPastThreshold(0, g.IO.MouseDragThreshold * DRAG_MOUSE_THRESHOLD_FACTOR))\par
02430     \{\par
02431         adjust_delta = g.IO.MouseDelta[axis];\par
02432         {\cf19 if} (g.IO.KeyAlt)\par
02433             adjust_delta *= 1.0f / 100.0f;\par
02434         {\cf19 if} (g.IO.KeyShift)\par
02435             adjust_delta *= 10.0f;\par
02436     \}\par
02437     {\cf19 else} {\cf19 if} (g.ActiveIdSource == ImGuiInputSource_Keyboard || g.ActiveIdSource == ImGuiInputSource_Gamepad)\par
02438     \{\par
02439         {\cf17 const} {\cf18 int} decimal_precision = is_floating_point ? ImParseFormatPrecision(format, 3) : 0;\par
02440         {\cf17 const} {\cf18 bool} tweak_slow = IsKeyDown((g.NavInputSource == ImGuiInputSource_Gamepad) ? ImGuiKey_NavGamepadTweakSlow : ImGuiKey_NavKeyboardTweakSlow);\par
02441         {\cf17 const} {\cf18 bool} tweak_fast = IsKeyDown((g.NavInputSource == ImGuiInputSource_Gamepad) ? ImGuiKey_NavGamepadTweakFast : ImGuiKey_NavKeyboardTweakFast);\par
02442         {\cf17 const} {\cf18 float} tweak_factor = tweak_slow ? 1.0f / 10.0f : tweak_fast ? 10.0f : 1.0f;\par
02443         adjust_delta = GetNavTweakPressedAmount(axis) * tweak_factor;\par
02444         v_speed = ImMax(v_speed, GetMinimumStepAtDecimalPrecision(decimal_precision));\par
02445     \}\par
02446     adjust_delta *= v_speed;\par
02447 \par
02448     {\cf20 // For vertical drag we currently assume that Up=higher value (like we do with vertical sliders). This may become a parameter.}\par
02449     {\cf19 if} (axis == ImGuiAxis_Y)\par
02450         adjust_delta = -adjust_delta;\par
02451 \par
02452     {\cf20 // For logarithmic use our range is effectively 0..1 so scale the delta into that range}\par
02453     {\cf19 if} (is_logarithmic && (v_max - v_min < FLT_MAX) && ((v_max - v_min) > 0.000001f)) {\cf20 // Epsilon to avoid /0}\par
02454         adjust_delta /= (float)(v_max - v_min);\par
02455 \par
02456     {\cf20 // Clear current value on activation}\par
02457     {\cf20 // Avoid altering values and clamping when we are _already_ past the limits and heading in the same direction, so e.g. if range is 0..255, current value is 300 and we are pushing to the right side, keep the 300.}\par
02458     {\cf17 const} {\cf18 bool} is_just_activated = g.ActiveIdIsJustActivated;\par
02459     {\cf17 const} {\cf18 bool} is_already_past_limits_and_pushing_outward = is_bounded && !is_wrapped && ((*v >= v_max && adjust_delta > 0.0f) || (*v <= v_min && adjust_delta < 0.0f));\par
02460     {\cf19 if} (is_just_activated || is_already_past_limits_and_pushing_outward)\par
02461     \{\par
02462         g.DragCurrentAccum = 0.0f;\par
02463         g.DragCurrentAccumDirty = {\cf17 false};\par
02464     \}\par
02465     {\cf19 else} {\cf19 if} (adjust_delta != 0.0f)\par
02466     \{\par
02467         g.DragCurrentAccum += adjust_delta;\par
02468         g.DragCurrentAccumDirty = {\cf17 true};\par
02469     \}\par
02470 \par
02471     {\cf19 if} (!g.DragCurrentAccumDirty)\par
02472         {\cf19 return} {\cf17 false};\par
02473 \par
02474     TYPE v_cur = *v;\par
02475     FLOATTYPE v_old_ref_for_accum_remainder = (FLOATTYPE)0.0f;\par
02476 \par
02477     {\cf18 float} logarithmic_zero_epsilon = 0.0f; {\cf20 // Only valid when is_logarithmic is true}\par
02478     {\cf17 const} {\cf18 float} zero_deadzone_halfsize = 0.0f; {\cf20 // Drag widgets have no deadzone (as it doesn't make sense)}\par
02479     {\cf19 if} (is_logarithmic)\par
02480     \{\par
02481         {\cf20 // When using logarithmic sliders, we need to clamp to avoid hitting zero, but our choice of clamp value greatly affects slider precision. We attempt to use the specified precision to estimate a good lower bound.}\par
02482         {\cf17 const} {\cf18 int} decimal_precision = is_floating_point ? ImParseFormatPrecision(format, 3) : 1;\par
02483         logarithmic_zero_epsilon = ImPow(0.1f, ({\cf18 float})decimal_precision);\par
02484 \par
02485         {\cf20 // Convert to parametric space, apply delta, convert back}\par
02486         {\cf18 float} v_old_parametric = ScaleRatioFromValueT<TYPE, SIGNEDTYPE, FLOATTYPE>(data_type, v_cur, v_min, v_max, is_logarithmic, logarithmic_zero_epsilon, zero_deadzone_halfsize);\par
02487         {\cf18 float} v_new_parametric = v_old_parametric + g.DragCurrentAccum;\par
02488         v_cur = ScaleValueFromRatioT<TYPE, SIGNEDTYPE, FLOATTYPE>(data_type, v_new_parametric, v_min, v_max, is_logarithmic, logarithmic_zero_epsilon, zero_deadzone_halfsize);\par
02489         v_old_ref_for_accum_remainder = v_old_parametric;\par
02490     \}\par
02491     {\cf19 else}\par
02492     \{\par
02493         v_cur += (SIGNEDTYPE)g.DragCurrentAccum;\par
02494     \}\par
02495 \par
02496     {\cf20 // Round to user desired precision based on format string}\par
02497     {\cf19 if} (is_floating_point && !(flags & ImGuiSliderFlags_NoRoundToFormat))\par
02498         v_cur = RoundScalarWithFormatT<TYPE>(format, data_type, v_cur);\par
02499 \par
02500     {\cf20 // Preserve remainder after rounding has been applied. This also allow slow tweaking of values.}\par
02501     g.DragCurrentAccumDirty = {\cf17 false};\par
02502     {\cf19 if} (is_logarithmic)\par
02503     \{\par
02504         {\cf20 // Convert to parametric space, apply delta, convert back}\par
02505         {\cf18 float} v_new_parametric = ScaleRatioFromValueT<TYPE, SIGNEDTYPE, FLOATTYPE>(data_type, v_cur, v_min, v_max, is_logarithmic, logarithmic_zero_epsilon, zero_deadzone_halfsize);\par
02506         g.DragCurrentAccum -= (float)(v_new_parametric - v_old_ref_for_accum_remainder);\par
02507     \}\par
02508     {\cf19 else}\par
02509     \{\par
02510         g.DragCurrentAccum -= (float)((SIGNEDTYPE)v_cur - (SIGNEDTYPE)*v);\par
02511     \}\par
02512 \par
02513     {\cf20 // Lose zero sign for float/double}\par
02514     {\cf19 if} (v_cur == (TYPE)-0)\par
02515         v_cur = (TYPE)0;\par
02516 \par
02517     {\cf19 if} (*v != v_cur && is_bounded)\par
02518     \{\par
02519         {\cf19 if} (is_wrapped)\par
02520         \{\par
02521             {\cf20 // Wrap values}\par
02522             {\cf19 if} (v_cur < v_min)\par
02523                 v_cur += v_max - v_min + (is_floating_point ? 0 : 1);\par
02524             {\cf19 if} (v_cur > v_max)\par
02525                 v_cur -= v_max - v_min + (is_floating_point ? 0 : 1);\par
02526         \}\par
02527         {\cf19 else}\par
02528         \{\par
02529             {\cf20 // Clamp values + handle overflow/wrap-around for integer types.}\par
02530             {\cf19 if} (v_cur < v_min || (v_cur > *v && adjust_delta < 0.0f && !is_floating_point))\par
02531                 v_cur = v_min;\par
02532             {\cf19 if} (v_cur > v_max || (v_cur < *v && adjust_delta > 0.0f && !is_floating_point))\par
02533                 v_cur = v_max;\par
02534         \}\par
02535     \}\par
02536 \par
02537     {\cf20 // Apply result}\par
02538     {\cf19 if} (*v == v_cur)\par
02539         {\cf19 return} {\cf17 false};\par
02540     *v = v_cur;\par
02541     {\cf19 return} {\cf17 true};\par
02542 \}\par
02543 \par
02544 {\cf18 bool} ImGui::DragBehavior(ImGuiID {\cf18 id}, ImGuiDataType data_type, {\cf18 void}* p_v, {\cf18 float} v_speed, {\cf17 const} {\cf18 void}* p_min, {\cf17 const} {\cf18 void}* p_max, {\cf17 const} {\cf18 char}* format, ImGuiSliderFlags flags)\par
02545 \{\par
02546     {\cf20 // Read imgui.cpp "API BREAKING CHANGES" section for 1.78 if you hit this assert.}\par
02547     IM_ASSERT((flags == 1 || (flags & ImGuiSliderFlags_InvalidMask_) == 0) && {\cf22 "Invalid ImGuiSliderFlags flags! Has the legacy 'float power' argument been mistakenly cast to flags? Call function with ImGuiSliderFlags_Logarithmic flags instead."});\par
02548 \par
02549     ImGuiContext& g = *GImGui;\par
02550     {\cf19 if} (g.ActiveId == {\cf18 id})\par
02551     \{\par
02552         {\cf20 // Those are the things we can do easily outside the DragBehaviorT<> template, saves code generation.}\par
02553         {\cf19 if} (g.ActiveIdSource == ImGuiInputSource_Mouse && !g.IO.MouseDown[0])\par
02554             ClearActiveID();\par
