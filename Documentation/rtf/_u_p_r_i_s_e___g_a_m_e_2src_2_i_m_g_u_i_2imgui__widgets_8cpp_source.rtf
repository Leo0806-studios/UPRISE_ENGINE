03173 {\cf20 // Note: p_data, p_min and p_max are _pointers_ to a memory address holding the data. For a slider, they are all required.}\par
03174 {\cf20 // Read code of e.g. SliderFloat(), SliderInt() etc. or examples in 'Demo->Widgets->Data Types' to understand how to use this function directly.}\par
03175 {\cf18 bool} ImGui::SliderScalar({\cf17 const} {\cf18 char}* label, ImGuiDataType data_type, {\cf18 void}* p_data, {\cf17 const} {\cf18 void}* p_min, {\cf17 const} {\cf18 void}* p_max, {\cf17 const} {\cf18 char}* format, ImGuiSliderFlags flags)\par
03176 \{\par
03177     ImGuiWindow* window = GetCurrentWindow();\par
03178     {\cf19 if} (window->SkipItems)\par
03179         {\cf19 return} {\cf17 false};\par
03180 \par
03181     ImGuiContext& g = *GImGui;\par
03182     {\cf17 const} ImGuiStyle& style = g.Style;\par
03183     {\cf17 const} ImGuiID {\cf18 id} = window->GetID(label);\par
03184     {\cf17 const} {\cf18 float} w = CalcItemWidth();\par
03185 \par
03186     {\cf17 const} ImVec2 label_size = CalcTextSize(label, NULL, {\cf17 true});\par
03187     {\cf17 const} ImRect frame_bb(window->DC.CursorPos, window->DC.CursorPos + ImVec2(w, label_size.y + style.FramePadding.y * 2.0f));\par
03188     {\cf17 const} ImRect total_bb(frame_bb.Min, frame_bb.Max + ImVec2(label_size.x > 0.0f ? style.ItemInnerSpacing.x + label_size.x : 0.0f, 0.0f));\par
03189 \par
03190     {\cf17 const} {\cf18 bool} temp_input_allowed = (flags & ImGuiSliderFlags_NoInput) == 0;\par
03191     ItemSize(total_bb, style.FramePadding.y);\par
03192     {\cf19 if} (!ItemAdd(total_bb, {\cf18 id}, &frame_bb, temp_input_allowed ? ImGuiItemFlags_Inputable : 0))\par
03193         return false;\par
03194 \par
03195     {\cf20 // Default format string when passing NULL}\par
03196     {\cf19 if} (format == NULL)\par
03197         format = DataTypeGetInfo(data_type)->PrintFmt;\par
03198 \par
03199     {\cf17 const} {\cf18 bool} hovered = ItemHoverable(frame_bb, {\cf18 id}, g.LastItemData.InFlags);\par
03200     {\cf18 bool} temp_input_is_active = temp_input_allowed && TempInputIsActive({\cf18 id});\par
03201     {\cf19 if} (!temp_input_is_active)\par
03202     \{\par
03203         {\cf20 // Tabbing or CTRL-clicking on Slider turns it into an input box}\par
03204         {\cf17 const} {\cf18 bool} clicked = hovered && IsMouseClicked(0, ImGuiInputFlags_None, {\cf18 id});\par
03205         {\cf17 const} {\cf18 bool} make_active = (clicked || g.NavActivateId == id);\par
03206         {\cf19 if} (make_active && clicked)\par
03207             SetKeyOwner(ImGuiKey_MouseLeft, {\cf18 id});\par
03208         {\cf19 if} (make_active && temp_input_allowed)\par
03209             {\cf19 if} ((clicked && g.IO.KeyCtrl) || (g.NavActivateId == {\cf18 id} && (g.NavActivateFlags & ImGuiActivateFlags_PreferInput)))\par
03210                 temp_input_is_active = {\cf17 true};\par
03211 \par
03212         {\cf19 if} (make_active && !temp_input_is_active)\par
03213         \{\par
03214             SetActiveID({\cf18 id}, window);\par
03215             SetFocusID({\cf18 id}, window);\par
03216             FocusWindow(window);\par
03217             g.ActiveIdUsingNavDirMask |= (1 << ImGuiDir_Left) | (1 << ImGuiDir_Right);\par
03218         \}\par
03219     \}\par
03220 \par
03221     {\cf19 if} (temp_input_is_active)\par
03222     \{\par
03223         {\cf20 // Only clamp CTRL+Click input when ImGuiSliderFlags_AlwaysClamp is set}\par
03224         {\cf17 const} {\cf18 bool} is_clamp_input = (flags & ImGuiSliderFlags_AlwaysClamp) != 0;\par
03225         {\cf19 return} TempInputScalar(frame_bb, {\cf18 id}, label, data_type, p_data, format, is_clamp_input ? p_min : NULL, is_clamp_input ? p_max : NULL);\par
03226     \}\par
03227 \par
03228     {\cf20 // Draw frame}\par
03229     {\cf17 const} ImU32 frame_col = GetColorU32(g.ActiveId == {\cf18 id} ? ImGuiCol_FrameBgActive : hovered ? ImGuiCol_FrameBgHovered : ImGuiCol_FrameBg);\par
03230     RenderNavHighlight(frame_bb, {\cf18 id});\par
03231     RenderFrame(frame_bb.Min, frame_bb.Max, frame_col, {\cf17 true}, g.Style.FrameRounding);\par
03232 \par
03233     {\cf20 // Slider behavior}\par
03234     ImRect grab_bb;\par
03235     {\cf17 const} {\cf18 bool} value_changed = SliderBehavior(frame_bb, {\cf18 id}, data_type, p_data, p_min, p_max, format, flags, &grab_bb);\par
03236     {\cf19 if} (value_changed)\par
03237         MarkItemEdited({\cf18 id});\par
03238 \par
03239     {\cf20 // Render grab}\par
03240     {\cf19 if} (grab_bb.Max.x > grab_bb.Min.x)\par
03241         window->DrawList->AddRectFilled(grab_bb.Min, grab_bb.Max, GetColorU32(g.ActiveId == {\cf18 id} ? ImGuiCol_SliderGrabActive : ImGuiCol_SliderGrab), style.GrabRounding);\par
03242 \par
03243     {\cf20 // Display value using user-provided display format so user can add prefix/suffix/decorations to the value.}\par
