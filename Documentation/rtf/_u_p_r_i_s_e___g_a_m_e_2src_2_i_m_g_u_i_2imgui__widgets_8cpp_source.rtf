05294 {\cf17 static} {\cf18 void} ColorEditRestoreH({\cf17 const} {\cf18 float}* col, {\cf18 float}* H)\par
05295 \{\par
05296     ImGuiContext& g = *GImGui;\par
05297     IM_ASSERT(g.ColorEditCurrentID != 0);\par
05298     {\cf19 if} (g.ColorEditSavedID != g.ColorEditCurrentID || g.ColorEditSavedColor != ImGui::ColorConvertFloat4ToU32(ImVec4(col[0], col[1], col[2], 0)))\par
05299         {\cf19 return};\par
05300     *H = g.ColorEditSavedHue;\par
05301 \}\par
05302 \par
05303 {\cf20 // ColorEdit supports RGB and HSV inputs. In case of RGB input resulting color may have undefined hue and/or saturation.}\par
05304 {\cf20 // Since widget displays both RGB and HSV values we must preserve hue and saturation to prevent these values resetting.}\par
05305 {\cf17 static} {\cf18 void} ColorEditRestoreHS({\cf17 const} {\cf18 float}* col, {\cf18 float}* H, {\cf18 float}* S, {\cf18 float}* V)\par
05306 \{\par
05307     ImGuiContext& g = *GImGui;\par
05308     IM_ASSERT(g.ColorEditCurrentID != 0);\par
05309     {\cf19 if} (g.ColorEditSavedID != g.ColorEditCurrentID || g.ColorEditSavedColor != ImGui::ColorConvertFloat4ToU32(ImVec4(col[0], col[1], col[2], 0)))\par
05310         {\cf19 return};\par
05311 \par
05312     {\cf20 // When S == 0, H is undefined.}\par
05313     {\cf20 // When H == 1 it wraps around to 0.}\par
05314     {\cf19 if} (*S == 0.0f || (*H == 0.0f && g.ColorEditSavedHue == 1))\par
05315         *H = g.ColorEditSavedHue;\par
05316 \par
05317     {\cf20 // When V == 0, S is undefined.}\par
05318     {\cf19 if} (*V == 0.0f)\par
05319         *S = g.ColorEditSavedSat;\par
05320 \}\par
05321 \par
05322 {\cf20 // Edit colors components (each component in 0.0f..1.0f range).}\par
05323 {\cf20 // See enum ImGuiColorEditFlags_ for available options. e.g. Only access 3 floats if ImGuiColorEditFlags_NoAlpha flag is set.}\par
05324 {\cf20 // With typical options: Left-click on color square to open color picker. Right-click to open option menu. CTRL-Click over input fields to edit them and TAB to go to next item.}\par
05325 {\cf18 bool} ImGui::ColorEdit4({\cf17 const} {\cf18 char}* label, {\cf18 float} col[4], ImGuiColorEditFlags flags)\par
05326 \{\par
05327     ImGuiWindow* window = GetCurrentWindow();\par
05328     {\cf19 if} (window->SkipItems)\par
05329         {\cf19 return} {\cf17 false};\par
05330 \par
05331     ImGuiContext& g = *GImGui;\par
05332     {\cf17 const} ImGuiStyle& style = g.Style;\par
05333     {\cf17 const} {\cf18 float} square_sz = GetFrameHeight();\par
05334     {\cf17 const} {\cf18 char}* label_display_end = FindRenderedTextEnd(label);\par
05335     {\cf18 float} w_full = CalcItemWidth();\par
05336     g.NextItemData.ClearFlags();\par
05337 \par
05338     BeginGroup();\par
05339     PushID(label);\par
05340     {\cf17 const} {\cf18 bool} set_current_color_edit_id = (g.ColorEditCurrentID == 0);\par
05341     {\cf19 if} (set_current_color_edit_id)\par
05342         g.ColorEditCurrentID = window->IDStack.back();\par
05343 \par
05344     {\cf20 // If we're not showing any slider there's no point in doing any HSV conversions}\par
05345     {\cf17 const} ImGuiColorEditFlags flags_untouched = flags;\par
05346     {\cf19 if} (flags & ImGuiColorEditFlags_NoInputs)\par
05347         flags = (flags & (~ImGuiColorEditFlags_DisplayMask_)) | ImGuiColorEditFlags_DisplayRGB | ImGuiColorEditFlags_NoOptions;\par
05348 \par
