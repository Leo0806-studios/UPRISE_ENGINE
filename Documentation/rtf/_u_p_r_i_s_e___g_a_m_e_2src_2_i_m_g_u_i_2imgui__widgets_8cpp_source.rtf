02835 {\cf20 // Convert a value v in the output space of a slider into a parametric position on the slider itself (the logical opposite of ScaleValueFromRatioT)}\par
02836 {\cf17 template}<{\cf17 typename} TYPE, {\cf17 typename} SIGNEDTYPE, {\cf17 typename} FLOATTYPE>\par
02837 {\cf18 float} ImGui::ScaleRatioFromValueT(ImGuiDataType data_type, TYPE v, TYPE v_min, TYPE v_max, {\cf18 bool} is_logarithmic, {\cf18 float} logarithmic_zero_epsilon, {\cf18 float} zero_deadzone_halfsize)\par
02838 \{\par
02839     {\cf19 if} (v_min == v_max)\par
02840         {\cf19 return} 0.0f;\par
02841     IM_UNUSED(data_type);\par
02842 \par
02843     {\cf17 const} TYPE v_clamped = (v_min < v_max) ? ImClamp(v, v_min, v_max) : ImClamp(v, v_max, v_min);\par
02844     {\cf19 if} (is_logarithmic)\par
02845     \{\par
02846         {\cf18 bool} flipped = v_max < v_min;\par
02847 \par
02848         {\cf19 if} (flipped) {\cf20 // Handle the case where the range is backwards}\par
02849             ImSwap(v_min, v_max);\par
02850 \par
02851         {\cf20 // Fudge min/max to avoid getting close to log(0)}\par
02852         FLOATTYPE v_min_fudged = (ImAbs((FLOATTYPE)v_min) < logarithmic_zero_epsilon) ? ((v_min < 0.0f) ? -logarithmic_zero_epsilon : logarithmic_zero_epsilon) : (FLOATTYPE)v_min;\par
02853         FLOATTYPE v_max_fudged = (ImAbs((FLOATTYPE)v_max) < logarithmic_zero_epsilon) ? ((v_max < 0.0f) ? -logarithmic_zero_epsilon : logarithmic_zero_epsilon) : (FLOATTYPE)v_max;\par
02854 \par
