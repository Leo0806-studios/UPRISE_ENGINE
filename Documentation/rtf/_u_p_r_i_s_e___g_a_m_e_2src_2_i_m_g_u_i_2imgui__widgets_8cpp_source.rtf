04200 {\cf20 // Find the shortest single replacement we can make to get the new text from the old text.}\par
04201 {\cf20 // Important: needs to be run before TextW is rewritten with the new characters because calling STB_TEXTEDIT_GETCHAR() at the end.}\par
04202 {\cf20 // FIXME: Ideally we should transition toward (1) making InsertChars()/DeleteChars() update undo-stack (2) discourage (and keep reconcile) or obsolete (and remove reconcile) accessing buffer directly.}\par
04203 {\cf17 static} {\cf18 void} InputTextReconcileUndoStateAfterUserCallback(ImGuiInputTextState* state, {\cf17 const} {\cf18 char}* new_buf_a, {\cf18 int} new_length_a)\par
04204 \{\par
04205     ImGuiContext& g = *GImGui;\par
04206     {\cf17 const} ImWchar* old_buf = state->TextW.Data;\par
04207     {\cf17 const} {\cf18 int} old_length = state->CurLenW;\par
04208     {\cf17 const} {\cf18 int} new_length = ImTextCountCharsFromUtf8(new_buf_a, new_buf_a + new_length_a);\par
04209     g.TempBuffer.reserve_discard((new_length + 1) * {\cf17 sizeof}(ImWchar));\par
04210     ImWchar* new_buf = (ImWchar*)({\cf18 void}*)g.TempBuffer.Data;\par
04211     ImTextStrFromUtf8(new_buf, new_length + 1, new_buf_a, new_buf_a + new_length_a);\par
04212 \par
04213     {\cf17 const} {\cf18 int} shorter_length = ImMin(old_length, new_length);\par
04214     {\cf18 int} first_diff;\par
04215     {\cf19 for} (first_diff = 0; first_diff < shorter_length; first_diff++)\par
04216         {\cf19 if} (old_buf[first_diff] != new_buf[first_diff])\par
04217             {\cf19 break};\par
04218     {\cf19 if} (first_diff == old_length && first_diff == new_length)\par
04219         {\cf19 return};\par
04220 \par
04221     {\cf18 int} old_last_diff = old_length - 1;\par
04222     {\cf18 int} new_last_diff = new_length - 1;\par
04223     {\cf19 for} (; old_last_diff >= first_diff && new_last_diff >= first_diff; old_last_diff--, new_last_diff--)\par
04224         {\cf19 if} (old_buf[old_last_diff] != new_buf[new_last_diff])\par
04225             {\cf19 break};\par
04226 \par
04227     {\cf17 const} {\cf18 int} insert_len = new_last_diff - first_diff + 1;\par
04228     {\cf17 const} {\cf18 int} delete_len = old_last_diff - first_diff + 1;\par
04229     {\cf19 if} (insert_len > 0 || delete_len > 0)\par
04230         {\cf19 if} (IMSTB_TEXTEDIT_CHARTYPE* p = stb_text_createundo(&state->Stb.undostate, first_diff, delete_len, insert_len))\par
04231             {\cf19 for} ({\cf18 int} i = 0; i < delete_len; i++)\par
04232                 p[i] = ImStb::STB_TEXTEDIT_GETCHAR(state, first_diff + i);\par
04233 \}\par
