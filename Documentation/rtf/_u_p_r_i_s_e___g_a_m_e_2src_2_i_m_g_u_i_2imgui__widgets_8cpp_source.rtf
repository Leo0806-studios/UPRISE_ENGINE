07651 {\cf20 // - Altering selection based on Ctrl/Shift modifiers, both for keyboard and mouse.}\par
07652 {\cf20 // - Record current selection state for RangeSrc}\par
07653 {\cf20 // This is all rather complex, best to run and refer to "widgets_multiselect_xxx" tests in imgui_test_suite.}\par
07654 {\cf18 void} ImGui::MultiSelectItemFooter(ImGuiID {\cf18 id}, {\cf18 bool}* p_selected, {\cf18 bool}* p_pressed)\par
07655 \{\par
07656     ImGuiContext& g = *GImGui;\par
07657     ImGuiWindow* window = g.CurrentWindow;\par
07658 \par
07659     {\cf18 bool} selected = *p_selected;\par
07660     {\cf18 bool} pressed = *p_pressed;\par
07661     ImGuiMultiSelectTempData* ms = g.CurrentMultiSelect;\par
07662     ImGuiMultiSelectState* storage = ms->Storage;\par
07663     {\cf19 if} (pressed)\par
07664         ms->IsFocused = {\cf17 true};\par
07665 \par
07666     {\cf18 bool} hovered = {\cf17 false};\par
07667     {\cf19 if} (g.LastItemData.StatusFlags & ImGuiItemStatusFlags_HoveredRect)\par
07668         hovered = IsItemHovered(ImGuiHoveredFlags_AllowWhenBlockedByPopup);\par
