06097             Text({\cf22 "H: %.3f, S: %.3f, V: %.3f"}, col[0], col[1], col[2]);\par
06098         {\cf19 else}\par
06099             Text({\cf22 "H: %.3f, S: %.3f, V: %.3f, A: %.3f"}, col[0], col[1], col[2], col[3]);\par
