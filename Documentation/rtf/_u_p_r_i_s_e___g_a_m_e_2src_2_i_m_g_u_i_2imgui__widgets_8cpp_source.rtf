06977 {\cf20 // [Experimental] Currently not exposed in public API.}\par
06978 {\cf20 // Consume character inputs and return search request, if any.}\par
06979 {\cf20 // This would typically only be called on the focused window or location you want to grab inputs for, e.g.}\par
06980 {\cf20 //   if (ImGui::IsWindowFocused(...))}\par
06981 {\cf20 //       if (ImGuiTypingSelectRequest* req = ImGui::GetTypingSelectRequest())}\par
06982 {\cf20 //           focus_idx = ImGui::TypingSelectFindMatch(req, my_items.size(), [](void*, int n) \{ return my_items[n]->Name; \}, &my_items, -1);}\par
