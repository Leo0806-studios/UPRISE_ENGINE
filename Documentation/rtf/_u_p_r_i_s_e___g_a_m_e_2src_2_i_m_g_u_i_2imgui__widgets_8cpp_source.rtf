02304 {\cf17 static} {\cf18 int} DataTypeCompareT({\cf17 const} T* lhs, {\cf17 const} T* rhs)\par
02305 \{\par
02306     {\cf19 if} (*lhs < *rhs) {\cf19 return} -1;\par
02307     {\cf19 if} (*lhs > *rhs) {\cf19 return} +1;\par
02308     {\cf19 return} 0;\par
02309 \}\par
