02046 {\cf20 // Old API, prefer using BeginCombo() nowadays if you can.}\par
02047 {\cf18 bool} ImGui::Combo({\cf17 const} {\cf18 char}* label, {\cf18 int}* current_item, {\cf17 const} {\cf18 char}* (*getter)({\cf18 void}* user_data, {\cf18 int} idx), {\cf18 void}* user_data, {\cf18 int} items_count, {\cf18 int} popup_max_height_in_items)\par
02048 \{\par
02049     ImGuiContext& g = *GImGui;\par
02050 \par
02051     {\cf20 // Call the getter to obtain the preview string which is a parameter to BeginCombo()}\par
02052     {\cf17 const} {\cf18 char}* preview_value = NULL;\par
02053     {\cf19 if} (*current_item >= 0 && *current_item < items_count)\par
02054         preview_value = getter(user_data, *current_item);\par
02055 \par
02056     {\cf20 // The old Combo() API exposed "popup_max_height_in_items". The new more general BeginCombo() API doesn't have/need it, but we emulate it here.}\par
02057     {\cf19 if} (popup_max_height_in_items != -1 && !(g.NextWindowData.Flags & ImGuiNextWindowDataFlags_HasSizeConstraint))\par
02058         SetNextWindowSizeConstraints(ImVec2(0, 0), ImVec2(FLT_MAX, CalcMaxPopupHeightFromItemCount(popup_max_height_in_items)));\par
02059 \par
02060     {\cf19 if} (!BeginCombo(label, preview_value, ImGuiComboFlags_None))\par
02061         {\cf19 return} {\cf17 false};\par
02062 \par
02063     {\cf20 // Display items}\par
02064     {\cf18 bool} value_changed = {\cf17 false};\par
02065     ImGuiListClipper clipper;\par
02066     clipper.Begin(items_count);\par
02067     clipper.IncludeItemByIndex(*current_item);\par
02068     {\cf19 while} (clipper.Step())\par
02069         {\cf19 for} ({\cf18 int} i = clipper.DisplayStart; i < clipper.DisplayEnd; i++)\par
02070         \{\par
02071             {\cf17 const} {\cf18 char}* item_text = getter(user_data, i);\par
02072             {\cf19 if} (item_text == NULL)\par
02073                 item_text = {\cf22 "*Unknown item*"};\par
02074 \par
02075             PushID(i);\par
02076             {\cf17 const} {\cf18 bool} item_selected = (i == *current_item);\par
02077             {\cf19 if} (Selectable(item_text, item_selected) && *current_item != i)\par
02078             \{\par
02079                 value_changed = {\cf17 true};\par
02080                 *current_item = i;\par
02081             \}\par
02082             {\cf19 if} (item_selected)\par
02083                 SetItemDefaultFocus();\par
02084             PopID();\par
02085         \}\par
02086 \par
02087     EndCombo();\par
02088     {\cf19 if} (value_changed)\par
02089         MarkItemEdited(g.LastItemData.ID);\par
02090 \par
02091     {\cf19 return} value_changed;\par
02092 \}\par
