00625         {\cf19 if} (!(flags & ImGuiButtonFlags_NoHoveredOnFocus))\par
00626             hovered = {\cf17 true};\par
00627     {\cf19 if} (g.NavActivateDownId == {\cf18 id})\par
00628     \{\par
00629         {\cf18 bool} nav_activated_by_code = (g.NavActivateId == id);\par
00630         {\cf18 bool} nav_activated_by_inputs = (g.NavActivatePressedId == id);\par
00631         {\cf19 if} (!nav_activated_by_inputs && (item_flags & ImGuiItemFlags_ButtonRepeat))\par
00632         \{\par
00633             {\cf20 // Avoid pressing multiple keys from triggering excessive amount of repeat events}\par
00634             {\cf17 const} ImGuiKeyData* key1 = GetKeyData(ImGuiKey_Space);\par
00635             {\cf17 const} ImGuiKeyData* key2 = GetKeyData(ImGuiKey_Enter);\par
00636             {\cf17 const} ImGuiKeyData* key3 = GetKeyData(ImGuiKey_NavGamepadActivate);\par
00637             {\cf17 const} {\cf18 float} t1 = ImMax(ImMax(key1->DownDuration, key2->DownDuration), key3->DownDuration);\par
00638             nav_activated_by_inputs = CalcTypematicRepeatAmount(t1 - g.IO.DeltaTime, t1, g.IO.KeyRepeatDelay, g.IO.KeyRepeatRate) > 0;\par
00639         \}\par
00640         {\cf19 if} (nav_activated_by_code || nav_activated_by_inputs)\par
00641         \{\par
00642             {\cf20 // Set active id so it can be queried by user via IsItemActive(), equivalent of holding the mouse button.}\par
