40 {\cf17 template} <{\cf17 typename} T> {\cf17 class }SPSCQueue \{\par
41 {\cf17 public}:\par
42   {\cf17 explicit} SPSCQueue({\cf17 const} {\cf18 size_t} capacity)\par
43       : capacity_(capacity) \{\par
44     capacity_++; {\cf20 // Needs one slack element}\par
45     slots_ = (T*)tracy_malloc({\cf17 sizeof}(T) * (capacity_ + 2 * kPadding));\par
46 \par
47     {\cf17 static_assert}({\cf17 alignof}(SPSCQueue<T>) == kCacheLineSize, {\cf22 ""});\par
48     {\cf17 static_assert}({\cf17 sizeof}(SPSCQueue<T>) >= 3 * kCacheLineSize, {\cf22 ""});\par
49     assert({\cf17 reinterpret_cast<}{\cf18 char} *{\cf17 >}(&readIdx_) -\par
50                {\cf17 reinterpret_cast<}{\cf18 char} *{\cf17 >}(&writeIdx_) >=\par
51            {\cf17 static_cast<}std::ptrdiff_t{\cf17 >}(kCacheLineSize));\par
52   \}\par
53 \par
54   ~SPSCQueue() \{\par
55     {\cf19 while} (front()) \{\par
56       pop();\par
57     \}\par
58     tracy_free(slots_);\par
59   \}\par
60 \par
61   {\cf20 // non-copyable and non-movable}\par
62   SPSCQueue({\cf17 const} SPSCQueue &) = {\cf17 delete};\par
63   SPSCQueue &operator=({\cf17 const} SPSCQueue &) = {\cf17 delete};\par
64 \par
65   {\cf17 template} <{\cf17 typename}... Args>\par
66   {\cf18 void} emplace(Args &&...args) {\cf17 noexcept}(\par
67       std::is_nothrow_constructible<T, Args &&...>::value) \{\par
68     {\cf17 static_assert}(std::is_constructible<T, Args &&...>::value,\par
69                   {\cf22 "T must be constructible with Args&&..."});\par
70     {\cf17 auto} {\cf17 const} writeIdx = writeIdx_.load(std::memory_order_relaxed);\par
71     {\cf17 auto} nextWriteIdx = writeIdx + 1;\par
72     {\cf19 if} (nextWriteIdx == capacity_) \{\par
73       nextWriteIdx = 0;\par
74     \}\par
75     {\cf19 while} (nextWriteIdx == readIdxCache_) \{\par
76       readIdxCache_ = readIdx_.load(std::memory_order_acquire);\par
77     \}\par
78     {\cf17 new} (&slots_[writeIdx + kPadding]) T(std::forward<Args>(args)...);\par
79     writeIdx_.store(nextWriteIdx, std::memory_order_release);\par
80   \}\par
81 \par
82   T *front() noexcept \{\par
83     {\cf17 auto} {\cf17 const} readIdx = readIdx_.load(std::memory_order_relaxed);\par
84     {\cf19 if} (readIdx == writeIdxCache_) \{\par
85       writeIdxCache_ = writeIdx_.load(std::memory_order_acquire);\par
86       {\cf19 if} (writeIdxCache_ == readIdx) \{\par
87         {\cf19 return} {\cf17 nullptr};\par
88       \}\par
89     \}\par
90     {\cf19 return} &slots_[readIdx + kPadding];\par
91   \}\par
92 \par
93   {\cf18 void} pop() noexcept \{\par
94     {\cf17 static_assert}(std::is_nothrow_destructible<T>::value,\par
95                   {\cf22 "T must be nothrow destructible"});\par
96     {\cf17 auto} {\cf17 const} readIdx = readIdx_.load(std::memory_order_relaxed);\par
97     assert(writeIdx_.load(std::memory_order_acquire) != readIdx);\par
98     slots_[readIdx + kPadding].~T();\par
99     {\cf17 auto} nextReadIdx = readIdx + 1;\par
100     {\cf19 if} (nextReadIdx == capacity_) \{\par
101       nextReadIdx = 0;\par
102     \}\par
103     readIdx_.store(nextReadIdx, std::memory_order_release);\par
104   \}\par
105 \par
106   {\cf18 size_t} size() const noexcept \{\par
107     std::ptrdiff_t diff = writeIdx_.load(std::memory_order_acquire) -\par
108                           readIdx_.load(std::memory_order_acquire);\par
109     {\cf19 if} (diff < 0) \{\par
110       diff += capacity_;\par
111     \}\par
112     {\cf19 return} {\cf17 static_cast<}{\cf18 size_t}{\cf17 >}(diff);\par
113   \}\par
114 \par
115   {\cf18 bool} empty() const noexcept \{\par
116       {\cf19 return} writeIdx_.load(std::memory_order_acquire) ==\par
117           readIdx_.load(std::memory_order_acquire);\par
118   \}\par
119 \par
120   {\cf18 size_t} capacity() const noexcept \{ {\cf19 return} capacity_ - 1; \}\par
121 \par
122 {\cf17 private}:\par
123   {\cf17 static} {\cf17 constexpr} {\cf18 size_t} kCacheLineSize = 64;\par
124 \par
125   {\cf20 // Padding to avoid false sharing between slots_ and adjacent allocations}\par
126   {\cf17 static} {\cf17 constexpr} {\cf18 size_t} kPadding = (kCacheLineSize - 1) / {\cf17 sizeof}(T) + 1;\par
127 \par
128 {\cf17 private}:\par
129   {\cf18 size_t} capacity_;\par
130   T *slots_;\par
131 \par
132   {\cf20 // Align to cache line size in order to avoid false sharing}\par
133   {\cf20 // readIdxCache_ and writeIdxCache_ is used to reduce the amount of cache}\par
134   {\cf20 // coherency traffic}\par
135   {\cf17 alignas}(kCacheLineSize) std::atomic<size_t> writeIdx_ = \{0\};\par
136   {\cf17 alignas}(kCacheLineSize) {\cf18 size_t} readIdxCache_ = 0;\par
137   {\cf17 alignas}(kCacheLineSize) std::atomic<size_t> readIdx_ = \{0\};\par
138   {\cf17 alignas}(kCacheLineSize) {\cf18 size_t} writeIdxCache_ = 0;\par
139 \par
140   {\cf20 // Padding to avoid adjacent allocations to share cache line with}\par
141   {\cf20 // writeIdxCache_}\par
142   {\cf18 char} padding_[kCacheLineSize - {\cf17 sizeof}(SPSCQueue<T>::writeIdxCache_)];\par
143 \};\par
144 \} {\cf20 // namespace rigtorp}\par
