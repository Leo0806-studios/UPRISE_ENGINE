04106                   &function_addrs_count);\par
04107       free_line_header (state, &lhdr, error_callback, data);\par
04108       new_data = 1;\par
04109     \}\par
04110 \par
04111       {\cf20 /* Atomically store the information we just read into the unit.}\par
04112 {\cf20      If another thread is simultaneously writing, it presumably}\par
04113 {\cf20      read the same information, and we don't care which one we}\par
04114 {\cf20      wind up with; we just leak the other one.  We do have to}\par
04115 {\cf20      write the lines field last, so that the acquire-loads above}\par
04116 {\cf20      ensure that the other fields are set.  */}\par
04117 \par
04118       {\cf19 if} (!state->threaded)\par
04119     \{\par
04120       u->lines_count = count;\par
04121       u->function_addrs = function_addrs;\par
04122       u->function_addrs_count = function_addrs_count;\par
04123       u->lines = lines;\par
04124     \}\par
04125       {\cf19 else}\par
04126     \{\par
04127       backtrace_atomic_store_size_t (&u->lines_count, count);\par
04128       backtrace_atomic_store_pointer (&u->function_addrs, function_addrs);\par
04129       backtrace_atomic_store_size_t (&u->function_addrs_count,\par
04130                      function_addrs_count);\par
04131       backtrace_atomic_store_pointer (&u->lines, lines);\par
04132     \}\par
04133     \}\par
04134 \par
04135   {\cf20 /* Now all fields of U have been initialized.  */}\par
04136 \par
04137   {\cf19 if} (lines == ({\cf17 struct} line *) (uintptr_t) -1)\par
04138     \{\par
04139       {\cf20 /* If reading the line number information failed in some way,}\par
04140 {\cf20      try again to see if there is a better compilation unit for}\par
04141 {\cf20      this PC.  */}\par
04142       {\cf19 if} (new_data)\par
04143     {\cf19 return} dwarf_lookup_pc (state, ddata, pc, callback, error_callback,\par
04144                 data, found);\par
04145       {\cf19 return} callback (data, pc, 0, NULL, 0, NULL);\par
04146     \}\par
04147 \par
04148   {\cf20 /* Search for PC within this unit.  */}\par
04149 \par
04150   ln = ({\cf17 struct }line *) bsearch (&pc, lines, entry->u->lines_count,\par
04151                 sizeof ({\cf17 struct} line), line_search);\par
04152   {\cf19 if} (ln == NULL)\par
04153     \{\par
04154       {\cf20 /* The PC is between the low_pc and high_pc attributes of the}\par
04155 {\cf20      compilation unit, but no entry in the line table covers it.}\par
04156 {\cf20      This implies that the start of the compilation unit has no}\par
04157 {\cf20      line number information.  */}\par
04158 \par
04159       {\cf19 if} (entry->u->abs_filename == NULL)\par
04160     \{\par
04161       {\cf17 const} {\cf18 char} *filename;\par
04162 \par
04163       filename = entry->u->filename;\par
04164       {\cf19 if} (filename != NULL\par
04165           && !IS_ABSOLUTE_PATH (filename)\par
04166           && entry->u->comp_dir != NULL)\par
04167         \{\par
04168           {\cf18 size_t} filename_len;\par
04169           {\cf17 const} {\cf18 char} *dir;\par
04170           {\cf18 size_t} dir_len;\par
04171           {\cf18 char} *s;\par
04172 \par
04173           filename_len = strlen (filename);\par
04174           dir = entry->u->comp_dir;\par
04175           dir_len = strlen (dir);\par
04176           s = ({\cf18 char} *) backtrace_alloc (state, dir_len + filename_len + 2,\par
04177                         error_callback, data);\par
04178           {\cf19 if} (s == NULL)\par
04179         \{\par
04180           *found = 0;\par
04181           {\cf19 return} 0;\par
04182         \}\par
04183           memcpy (s, dir, dir_len);\par
04184           {\cf20 /* FIXME: Should use backslash if DOS file system.  */}\par
04185           s[dir_len] = {\cf23 '/'};\par
04186           memcpy (s + dir_len + 1, filename, filename_len + 1);\par
04187           filename = s;\par
04188         \}\par
04189       entry->u->abs_filename = filename;\par
04190     \}\par
04191 \par
04192       {\cf19 return} callback (data, pc, 0, entry->u->abs_filename, 0, NULL);\par
04193     \}\par
04194 \par
04195   {\cf20 /* Search for function name within this unit.  */}\par
04196 \par
04197   {\cf19 if} (entry->u->function_addrs_count == 0)\par
04198     {\cf19 return} callback (data, pc, 0, ln->filename, ln->lineno, NULL);\par
04199 \par
04200   p = (({\cf17 struct }function_addrs *)\par
04201        bsearch (&pc, entry->u->function_addrs,\par
04202         entry->u->function_addrs_count,\par
04203         sizeof ({\cf17 struct} function_addrs),\par
04204         function_addrs_search));\par
04205   {\cf19 if} (p == NULL)\par
04206     {\cf19 return} callback (data, pc, 0, ln->filename, ln->lineno, NULL);\par
04207 \par
04208   {\cf20 /* Here pc >= p->low && pc < (p + 1)->low.  The function_addrs are}\par
04209 {\cf20      sorted by low, so if pc > p->low we are at the end of a range of}\par
04210 {\cf20      function_addrs with the same low value.  If pc == p->low walk}\par
04211 {\cf20      forward to the end of the range with that low value.  Then walk}\par
04212 {\cf20      backward and use the first range that includes pc.  */}\par
04213   {\cf19 while} (pc == (p + 1)->low)\par
04214     ++p;\par
04215   fmatch = NULL;\par
04216   {\cf19 while} (1)\par
04217     \{\par
04218       {\cf19 if} (pc < p->high)\par
04219     \{\par
04220       fmatch = p;\par
04221       {\cf19 break};\par
04222     \}\par
04223       {\cf19 if} (p == entry->u->function_addrs)\par
04224     {\cf19 break};\par
04225       {\cf19 if} ((p - 1)->low < p->low)\par
04226     {\cf19 break};\par
04227       --p;\par
04228     \}\par
04229   {\cf19 if} (fmatch == NULL)\par
04230     {\cf19 return} callback (data, pc, 0, ln->filename, ln->lineno, NULL);\par
04231 \par
04232   function = fmatch->function;\par
04233 \par
04234   filename = ln->filename;\par
04235   lineno = ln->lineno;\par
04236 \par
04237   ret = report_inlined_functions (pc, function, entry->u->comp_dir, callback, data,\par
04238                   &filename, &lineno);\par
04239   {\cf19 if} (ret != 0)\par
04240     {\cf19 return} ret;\par
04241 \par
04242   {\cf19 if} (filename[0] != {\cf23 '/'} && entry->u->comp_dir)\par
04243   \{\par
04244     {\cf18 char} buf[1024];\par
04245     snprintf (buf, 1024, {\cf22 "%s/%s"}, entry->u->comp_dir, filename);\par
04246     {\cf19 return} callback (data, pc, fmatch->low, buf, lineno, function->name);\par
04247   \}\par
04248   {\cf19 else}\par
04249   \{\par
04250     {\cf19 return} callback (data, pc, fmatch->low, filename, lineno, function->name);\par
04251   \}\par
04252 \}\par
04253 \par
04254 \par
04255 {\cf20 /* Return the file/line information for a PC using the DWARF mapping}\par
04256 {\cf20    we built earlier.  */}\par
04257 \par
04258 {\cf17 static} {\cf18 int}\par
04259 dwarf_fileline ({\cf17 struct} backtrace_state *state, uintptr_t pc,\par
04260         backtrace_full_callback callback,\par
04261         backtrace_error_callback error_callback, {\cf18 void} *data)\par
04262 \{\par
04263   {\cf17 struct }dwarf_data *ddata;\par
04264   {\cf18 int} found;\par
04265   {\cf18 int} ret;\par
04266 \par
04267   {\cf19 if} (!state->threaded)\par
04268     \{\par
04269       {\cf19 for} (ddata = ({\cf17 struct} dwarf_data *) state->fileline_data;\par
04270        ddata != NULL;\par
04271        ddata = ddata->next)\par
04272     \{\par
04273       ret = dwarf_lookup_pc (state, ddata, pc, callback, error_callback,\par
04274                  data, &found);\par
04275       {\cf19 if} (ret != 0 || found)\par
04276         {\cf19 return} ret;\par
04277     \}\par
04278     \}\par
04279   {\cf19 else}\par
04280     \{\par
04281       {\cf17 struct }dwarf_data **pp;\par
04282 \par
04283       pp = ({\cf17 struct }dwarf_data **) ({\cf18 void} *) &state->fileline_data;\par
04284       {\cf19 while} (1)\par
04285     \{\par
04286       ddata = backtrace_atomic_load_pointer (pp);\par
04287       {\cf19 if} (ddata == NULL)\par
04288         {\cf19 break};\par
04289 \par
04290       ret = dwarf_lookup_pc (state, ddata, pc, callback, error_callback,\par
04291                  data, &found);\par
04292       {\cf19 if} (ret != 0 || found)\par
04293         {\cf19 return} ret;\par
04294 \par
04295       pp = &ddata->next;\par
04296     \}\par
04297     \}\par
04298 \par
04299   {\cf20 /* FIXME: See if any libraries have been dlopen'ed.  */}\par
04300 \par
04301   {\cf19 return} callback (data, pc, 0, NULL, 0, NULL);\par
04302 \}\par
04303 \par
04304 {\cf20 /* Initialize our data structures from the DWARF debug info for a}\par
04305 {\cf20    file.  Return NULL on failure.  */}\par
04306 \par
04307 {\cf17 static} {\cf17 struct }dwarf_data *\par
04308 build_dwarf_data ({\cf17 struct} backtrace_state *state,\par
04309           uintptr_t base_address,\par
04310           {\cf17 const} {\cf17 struct} dwarf_sections *dwarf_sections,\par
04311           {\cf18 int} is_bigendian,\par
04312           {\cf17 struct} dwarf_data *altlink,\par
04313           backtrace_error_callback error_callback,\par
04314           {\cf18 void} *data)\par
04315 \{\par
04316   {\cf17 struct }unit_addrs_vector addrs_vec;\par
04317   {\cf17 struct }unit_addrs *addrs;\par
04318   {\cf18 size_t} addrs_count;\par
04319   {\cf17 struct }unit_vector units_vec;\par
04320   {\cf17 struct }unit **units;\par
04321   {\cf18 size_t} units_count;\par
04322   {\cf17 struct }dwarf_data *fdata;\par
04323 \par
04324   {\cf19 if} (!build_address_map (state, base_address, dwarf_sections, is_bigendian,\par
04325               altlink, error_callback, data, &addrs_vec,\par
04326               &units_vec))\par
04327     {\cf19 return} NULL;\par
04328 \par
04329   {\cf19 if} (!backtrace_vector_release (state, &addrs_vec.vec, error_callback, data))\par
04330     {\cf19 return} NULL;\par
04331   {\cf19 if} (!backtrace_vector_release (state, &units_vec.vec, error_callback, data))\par
04332     {\cf19 return} NULL;\par
04333   addrs = ({\cf17 struct }unit_addrs *) addrs_vec.vec.base;\par
04334   units = ({\cf17 struct }unit **) units_vec.vec.base;\par
04335   addrs_count = addrs_vec.count;\par
04336   units_count = units_vec.count;\par
04337   backtrace_qsort (addrs, addrs_count, {\cf17 sizeof} ({\cf17 struct} unit_addrs),\par
04338            unit_addrs_compare);\par
04339   {\cf20 /* No qsort for units required, already sorted.  */}\par
04340 \par
04341   fdata = (({\cf17 struct }dwarf_data *)\par
04342        backtrace_alloc (state, {\cf17 sizeof} ({\cf17 struct} dwarf_data),\par
04343                 error_callback, data));\par
04344   {\cf19 if} (fdata == NULL)\par
04345     {\cf19 return} NULL;\par
04346 \par
04347   fdata->next = NULL;\par
04348   fdata->altlink = altlink;\par
04349   fdata->base_address = base_address;\par
04350   fdata->addrs = addrs;\par
04351   fdata->addrs_count = addrs_count;\par
04352   fdata->units = units;\par
04353   fdata->units_count = units_count;\par
04354   fdata->dwarf_sections = *dwarf_sections;\par
04355   fdata->is_bigendian = is_bigendian;\par
04356   memset (&fdata->fvec, 0, {\cf17 sizeof} fdata->fvec);\par
04357 \par
04358   {\cf19 return} fdata;\par
04359 \}\par
04360 \par
04361 {\cf20 /* Build our data structures from the DWARF sections for a module.}\par
04362 {\cf20    Set FILELINE_FN and STATE->FILELINE_DATA.  Return 1 on success, 0}\par
04363 {\cf20    on failure.  */}\par
04364 \par
04365 {\cf18 int}\par
04366 backtrace_dwarf_add ({\cf17 struct} backtrace_state *state,\par
04367              uintptr_t base_address,\par
04368              {\cf17 const} {\cf17 struct} dwarf_sections *dwarf_sections,\par
04369              {\cf18 int} is_bigendian,\par
04370              {\cf17 struct} dwarf_data *fileline_altlink,\par
04371              backtrace_error_callback error_callback,\par
04372              {\cf18 void} *data, fileline *fileline_fn,\par
04373              {\cf17 struct} dwarf_data **fileline_entry)\par
04374 \{\par
04375   {\cf17 struct }dwarf_data *fdata;\par
04376 \par
04377   fdata = build_dwarf_data (state, base_address, dwarf_sections, is_bigendian,\par
04378                 fileline_altlink, error_callback, data);\par
04379   {\cf19 if} (fdata == NULL)\par
04380     {\cf19 return} 0;\par
04381 \par
04382   {\cf19 if} (fileline_entry != NULL)\par
04383     *fileline_entry = fdata;\par
04384 \par
04385   {\cf19 if} (!state->threaded)\par
04386     \{\par
04387       {\cf17 struct }dwarf_data **pp;\par
04388 \par
04389       {\cf19 for} (pp = ({\cf17 struct} dwarf_data **) ({\cf18 void} *) &state->fileline_data;\par
04390        *pp != NULL;\par
04391        pp = &(*pp)->next)\par
04392     ;\par
04393       *pp = fdata;\par
04394     \}\par
04395   {\cf19 else}\par
04396     \{\par
04397       {\cf19 while} (1)\par
04398     \{\par
04399       {\cf17 struct }dwarf_data **pp;\par
04400 \par
04401       pp = ({\cf17 struct }dwarf_data **) ({\cf18 void} *) &state->fileline_data;\par
04402 \par
04403       {\cf19 while} (1)\par
04404         \{\par
04405           {\cf17 struct }dwarf_data *p;\par
04406 \par
04407           p = backtrace_atomic_load_pointer (pp);\par
04408 \par
04409           {\cf19 if} (p == NULL)\par
04410         {\cf19 break};\par
04411 \par
04412           pp = &p->next;\par
04413         \}\par
04414 \par
04415       {\cf19 if} (__sync_bool_compare_and_swap (pp, NULL, fdata))\par
04416         {\cf19 break};\par
04417     \}\par
04418     \}\par
04419 \par
04420   *fileline_fn = dwarf_fileline;\par
04421 \par
04422   {\cf19 return} 1;\par
04423 \}\par
04424 \par
04425 \}\par
}
