00747 {\cf20 /* Report an error for a DWARF buffer.  */}\par
00748 \par
00749 {\cf17 static} {\cf18 void}\par
00750 dwarf_buf_error ({\cf17 struct} dwarf_buf *buf, {\cf17 const} {\cf18 char} *msg, {\cf18 int} errnum)\par
00751 \{\par
00752   {\cf18 char} b[200];\par
00753 \par
00754   snprintf (b, {\cf17 sizeof} b, {\cf22 "%s in %s at %d"},\par
00755         msg, buf->name, ({\cf18 int}) (buf->buf - buf->start));\par
00756   buf->error_callback (buf->data, b, errnum);\par
00757 \}\par
00758 \par
00759 {\cf20 /* Require at least COUNT bytes in BUF.  Return 1 if all is well, 0 on}\par
00760 {\cf20    error.  */}\par
00761 \par
00762 {\cf17 static} {\cf18 int}\par
00763 require ({\cf17 struct} dwarf_buf *buf, {\cf18 size_t} count)\par
00764 \{\par
00765   {\cf19 if} (buf->left >= count)\par
00766     {\cf19 return} 1;\par
00767 \par
00768   {\cf19 if} (!buf->reported_underflow)\par
00769     \{\par
00770       dwarf_buf_error (buf, {\cf22 "DWARF underflow"}, 0);\par
00771       buf->reported_underflow = 1;\par
00772     \}\par
00773 \par
00774   {\cf19 return} 0;\par
00775 \}\par
00776 \par
00777 {\cf20 /* Advance COUNT bytes in BUF.  Return 1 if all is well, 0 on}\par
00778 {\cf20    error.  */}\par
00779 \par
00780 {\cf17 static} {\cf18 int}\par
00781 advance ({\cf17 struct} dwarf_buf *buf, {\cf18 size_t} count)\par
00782 \{\par
00783   {\cf19 if} (!require (buf, count))\par
00784     {\cf19 return} 0;\par
00785   buf->buf += count;\par
00786   buf->left -= count;\par
00787   {\cf19 return} 1;\par
00788 \}\par
00789 \par
00790 {\cf20 /* Read one zero-terminated string from BUF and advance past the string.  */}\par
00791 \par
00792 {\cf17 static} {\cf17 const} {\cf18 char} *\par
00793 read_string ({\cf17 struct} dwarf_buf *buf)\par
00794 \{\par
00795   {\cf17 const} {\cf18 char} *p = ({\cf17 const} {\cf18 char} *)buf->buf;\par
00796   {\cf18 size_t} len = strnlen (p, buf->left);\par
00797 \par
00798   {\cf20 /* - If len == left, we ran out of buffer before finding the zero terminator.}\par
00799 {\cf20        Generate an error by advancing len + 1.}\par
00800 {\cf20      - If len < left, advance by len + 1 to skip past the zero terminator.  */}\par
00801   {\cf18 size_t} count = len + 1;\par
00802 \par
00803   {\cf19 if} (!advance (buf, count))\par
00804     {\cf19 return} NULL;\par
00805 \par
00806   {\cf19 return} p;\par
00807 \}\par
00808 \par
