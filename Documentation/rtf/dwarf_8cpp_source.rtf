01988 \par
01989   {\cf19 return} add_range (state, rdata, lowpc, highpc, error_callback, data, vec);\par
01990 \}\par
01991 \par
01992 {\cf20 /* Call ADD_RANGE for each range read from .debug_ranges, as used in}\par
