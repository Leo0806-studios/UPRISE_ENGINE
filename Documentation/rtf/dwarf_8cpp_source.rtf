01530 {\cf20    called via add_ranges.  Returns 1 on success, 0 on failure.  */}\par
01531 \par
01532 {\cf17 static} {\cf18 int}\par
01533 add_unit_addr ({\cf17 struct} backtrace_state *state, {\cf18 void} *rdata,\par
01534            uintptr_t lowpc, uintptr_t highpc,\par
01535            backtrace_error_callback error_callback, {\cf18 void} *data,\par
01536            {\cf18 void} *pvec)\par
01537 \{\par
01538   {\cf17 struct }unit *u = ({\cf17 struct }unit *) rdata;\par
01539   {\cf17 struct }unit_addrs_vector *vec = ({\cf17 struct }unit_addrs_vector *) pvec;\par
01540   {\cf17 struct }unit_addrs *p;\par
01541 \par
01542   {\cf20 /* Try to merge with the last entry.  */}\par
01543   {\cf19 if} (vec->count > 0)\par
01544     \{\par
01545       p = ({\cf17 struct }unit_addrs *) vec->vec.base + (vec->count - 1);\par
01546       {\cf19 if} ((lowpc == p->high || lowpc == p->high + 1)\par
01547       && u == p->u)\par
01548     \{\par
01549       {\cf19 if} (highpc > p->high)\par
01550         p->high = highpc;\par
01551       {\cf19 return} 1;\par
01552     \}\par
01553     \}\par
01554 \par
01555   p = (({\cf17 struct }unit_addrs *)\par
01556        backtrace_vector_grow (state, {\cf17 sizeof} ({\cf17 struct} unit_addrs),\par
01557                   error_callback, data, &vec->vec));\par
01558   {\cf19 if} (p == NULL)\par
01559     {\cf19 return} 0;\par
01560 \par
01561   p->low = lowpc;\par
01562   p->high = highpc;\par
01563   p->u = u;\par
01564 \par
01565   ++vec->count;\par
01566 \par
01567   {\cf19 return} 1;\par
01568 \}\par
01569 \par
01570 {\cf20 /* Compare unit_addrs for qsort.  When ranges are nested, make the}\par
01571 {\cf20    smallest one sort last.  */}\par
01572 \par
01573 {\cf17 static} {\cf18 int}\par
01574 unit_addrs_compare ({\cf17 const} {\cf18 void} *v1, {\cf17 const} {\cf18 void} *v2)\par
01575 \{\par
01576   {\cf17 const} {\cf17 struct }unit_addrs *a1 = ({\cf17 const} {\cf17 struct }unit_addrs *) v1;\par
01577   {\cf17 const} {\cf17 struct }unit_addrs *a2 = ({\cf17 const} {\cf17 struct }unit_addrs *) v2;\par
01578 \par
01579   {\cf19 if} (a1->low < a2->low)\par
01580     {\cf19 return} -1;\par
01581   {\cf19 if} (a1->low > a2->low)\par
01582     {\cf19 return} 1;\par
01583   {\cf19 if} (a1->high < a2->high)\par
01584     {\cf19 return} 1;\par
01585   {\cf19 if} (a1->high > a2->high)\par
01586     {\cf19 return} -1;\par
01587   {\cf19 if} (a1->u->lineoff < a2->u->lineoff)\par
01588     {\cf19 return} -1;\par
01589   {\cf19 if} (a1->u->lineoff > a2->u->lineoff)\par
01590     {\cf19 return} 1;\par
01591   {\cf19 return} 0;\par
01592 \}\par
01593 \par
01594 {\cf20 /* Compare a PC against a unit_addrs for bsearch.  We always allocate}\par
01595 {\cf20    an entry entry at the end of the vector, so that this routine can}\par
01596 {\cf20    safely look at the next entry.  Note that if there are multiple}\par
01597 {\cf20    ranges containing PC, which one will be returned is unpredictable.}\par
01598 {\cf20    We compensate for that in dwarf_fileline.  */}\par
01599 \par
01600 {\cf17 static} {\cf18 int}\par
01601 unit_addrs_search ({\cf17 const} {\cf18 void} *vkey, {\cf17 const} {\cf18 void} *ventry)\par
01602 \{\par
01603   {\cf17 const} uintptr_t *key = ({\cf17 const} uintptr_t *) vkey;\par
01604   {\cf17 const} {\cf17 struct }unit_addrs *entry = ({\cf17 const} {\cf17 struct }unit_addrs *) ventry;\par
01605   uintptr_t pc;\par
01606 \par
01607   pc = *key;\par
01608   {\cf19 if} (pc < entry->low)\par
01609     {\cf19 return} -1;\par
01610   {\cf19 else} {\cf19 if} (pc > (entry + 1)->low)\par
01611     {\cf19 return} 1;\par
01612   {\cf19 else}\par
01613     {\cf19 return} 0;\par
01614 \}\par
01615 \par
01616 {\cf20 /* Sort the line vector by PC.  We want a stable sort here to maintain}\par
01617 {\cf20    the order of lines for the same PC values.  Since the sequence is}\par
01618 {\cf20    being sorted in place, their addresses cannot be relied on to}\par
01619 {\cf20    maintain stability.  That is the purpose of the index member.  */}\par
01620 \par
01621 {\cf17 static} {\cf18 int}\par
01622 line_compare ({\cf17 const} {\cf18 void} *v1, {\cf17 const} {\cf18 void} *v2)\par
01623 \{\par
01624   {\cf17 const} {\cf17 struct }line *ln1 = ({\cf17 const} {\cf17 struct }line *) v1;\par
01625   {\cf17 const} {\cf17 struct }line *ln2 = ({\cf17 const} {\cf17 struct }line *) v2;\par
01626 \par
01627   {\cf19 if} (ln1->pc < ln2->pc)\par
01628     {\cf19 return} -1;\par
01629   {\cf19 else} {\cf19 if} (ln1->pc > ln2->pc)\par
01630     {\cf19 return} 1;\par
01631   {\cf19 else} {\cf19 if} (ln1->idx < ln2->idx)\par
01632     {\cf19 return} -1;\par
01633   {\cf19 else} {\cf19 if} (ln1->idx > ln2->idx)\par
01634     {\cf19 return} 1;\par
01635   {\cf19 else}\par
01636     {\cf19 return} 0;\par
01637 \}\par
01638 \par
01639 {\cf20 /* Find a PC in a line vector.  We always allocate an extra entry at}\par
01640 {\cf20    the end of the lines vector, so that this routine can safely look}\par
01641 {\cf20    at the next entry.  Note that when there are multiple mappings for}\par
01642 {\cf20    the same PC value, this will return the last one.  */}\par
01643 \par
01644 {\cf17 static} {\cf18 int}\par
01645 line_search ({\cf17 const} {\cf18 void} *vkey, {\cf17 const} {\cf18 void} *ventry)\par
01646 \{\par
01647   {\cf17 const} uintptr_t *key = ({\cf17 const} uintptr_t *) vkey;\par
01648   {\cf17 const} {\cf17 struct }line *entry = ({\cf17 const} {\cf17 struct }line *) ventry;\par
01649   uintptr_t pc;\par
01650 \par
01651   pc = *key;\par
01652   {\cf19 if} (pc < entry->pc)\par
01653     {\cf19 return} -1;\par
01654   {\cf19 else} {\cf19 if} (pc >= (entry + 1)->pc)\par
01655     {\cf19 return} 1;\par
01656   {\cf19 else}\par
01657     {\cf19 return} 0;\par
01658 \}\par
01659 \par
01660 {\cf20 /* Sort the abbrevs by the abbrev code.  This function is passed to}\par
01661 {\cf20    both qsort and bsearch.  */}\par
01662 \par
01663 {\cf17 static} {\cf18 int}\par
01664 abbrev_compare ({\cf17 const} {\cf18 void} *v1, {\cf17 const} {\cf18 void} *v2)\par
01665 \{\par
01666   {\cf17 const} {\cf17 struct }abbrev *a1 = ({\cf17 const} {\cf17 struct }abbrev *) v1;\par
01667   {\cf17 const} {\cf17 struct }abbrev *a2 = ({\cf17 const} {\cf17 struct }abbrev *) v2;\par
01668 \par
01669   {\cf19 if} (a1->code < a2->code)\par
01670     {\cf19 return} -1;\par
01671   {\cf19 else} {\cf19 if} (a1->code > a2->code)\par
01672     {\cf19 return} 1;\par
01673   {\cf19 else}\par
01674     \{\par
01675       {\cf20 /* This really shouldn't happen.  It means there are two}\par
01676 {\cf20      different abbrevs with the same code, and that means we don't}\par
01677 {\cf20      know which one lookup_abbrev should return.  */}\par
01678       {\cf19 return} 0;\par
01679     \}\par
01680 \}\par
01681 \par
01682 {\cf20 /* Read the abbreviation table for a compilation unit.  Returns 1 on}\par
01683 {\cf20    success, 0 on failure.  */}\par
01684 \par
01685 {\cf17 static} {\cf18 int}\par
01686 read_abbrevs ({\cf17 struct} backtrace_state *state, uint64_t abbrev_offset,\par
01687           {\cf17 const} {\cf18 unsigned} {\cf18 char} *dwarf_abbrev, {\cf18 size_t} dwarf_abbrev_size,\par
01688           {\cf18 int} is_bigendian, backtrace_error_callback error_callback,\par
01689           {\cf18 void} *data, {\cf17 struct} abbrevs *abbrevs)\par
01690 \{\par
01691   {\cf17 struct }dwarf_buf abbrev_buf;\par
01692   {\cf17 struct }dwarf_buf count_buf;\par
01693   {\cf18 size_t} num_abbrevs;\par
01694 \par
01695   abbrevs->num_abbrevs = 0;\par
01696   abbrevs->abbrevs = NULL;\par
01697 \par
01698   {\cf19 if} (abbrev_offset >= dwarf_abbrev_size)\par
01699     \{\par
01700       error_callback (data, {\cf22 "abbrev offset out of range"}, 0);\par
01701       {\cf19 return} 0;\par
01702     \}\par
01703 \par
01704   abbrev_buf.name = {\cf22 ".debug_abbrev"};\par
01705   abbrev_buf.start = dwarf_abbrev;\par
01706   abbrev_buf.buf = dwarf_abbrev + abbrev_offset;\par
01707   abbrev_buf.left = dwarf_abbrev_size - abbrev_offset;\par
01708   abbrev_buf.is_bigendian = is_bigendian;\par
01709   abbrev_buf.error_callback = error_callback;\par
01710   abbrev_buf.data = data;\par
01711   abbrev_buf.reported_underflow = 0;\par
01712 \par
01713   {\cf20 /* Count the number of abbrevs in this list.  */}\par
01714 \par
01715   count_buf = abbrev_buf;\par
01716   num_abbrevs = 0;\par
01717   {\cf19 while} (read_uleb128 (&count_buf) != 0)\par
01718     \{\par
01719       {\cf19 if} (count_buf.reported_underflow)\par
01720     {\cf19 return} 0;\par
01721       ++num_abbrevs;\par
01722       {\cf20 // Skip tag.}\par
01723       read_uleb128 (&count_buf);\par
01724       {\cf20 // Skip has_children.}\par
01725       read_byte (&count_buf);\par
01726       {\cf20 // Skip attributes.}\par
01727       {\cf19 while} (read_uleb128 (&count_buf) != 0)\par
01728     \{\par
01729       uint64_t form;\par
01730 \par
01731       form = read_uleb128 (&count_buf);\par
01732       {\cf19 if} (({\cf17 enum} dwarf_form) form == DW_FORM_implicit_const)\par
01733         read_sleb128 (&count_buf);\par
01734     \}\par
01735       {\cf20 // Skip form of last attribute.}\par
01736       read_uleb128 (&count_buf);\par
01737     \}\par
01738 \par
01739   {\cf19 if} (count_buf.reported_underflow)\par
01740     {\cf19 return} 0;\par
01741 \par
01742   {\cf19 if} (num_abbrevs == 0)\par
01743     {\cf19 return} 1;\par
01744 \par
01745   abbrevs->abbrevs = (({\cf17 struct }abbrev *)\par
01746               backtrace_alloc (state,\par
01747                        num_abbrevs * {\cf17 sizeof} ({\cf17 struct} abbrev),\par
01748                        error_callback, data));\par
01749   {\cf19 if} (abbrevs->abbrevs == NULL)\par
01750     {\cf19 return} 0;\par
01751   abbrevs->num_abbrevs = num_abbrevs;\par
01752   memset (abbrevs->abbrevs, 0, num_abbrevs * sizeof ({\cf17 struct} abbrev));\par
01753 \par
01754   num_abbrevs = 0;\par
01755   {\cf19 while} (1)\par
01756     \{\par
01757       uint64_t code;\par
01758       {\cf17 struct }abbrev a;\par
01759       {\cf18 size_t} num_attrs;\par
01760       {\cf17 struct }attr *attrs;\par
01761 \par
01762       {\cf19 if} (abbrev_buf.reported_underflow)\par
01763     {\cf19 goto} fail;\par
01764 \par
01765       code = read_uleb128 (&abbrev_buf);\par
01766       {\cf19 if} (code == 0)\par
01767     {\cf19 break};\par
01768 \par
01769       a.code = code;\par
01770       a.tag = ({\cf17 enum} dwarf_tag) read_uleb128 (&abbrev_buf);\par
01771       a.has_children = read_byte (&abbrev_buf);\par
01772 \par
01773       count_buf = abbrev_buf;\par
01774       num_attrs = 0;\par
01775       {\cf19 while} (read_uleb128 (&count_buf) != 0)\par
01776     \{\par
01777       uint64_t form;\par
01778 \par
01779       ++num_attrs;\par
01780       form = read_uleb128 (&count_buf);\par
01781       {\cf19 if} (({\cf17 enum} dwarf_form) form == DW_FORM_implicit_const)\par
01782         read_sleb128 (&count_buf);\par
01783     \}\par
01784 \par
01785       {\cf19 if} (num_attrs == 0)\par
01786     \{\par
01787       attrs = NULL;\par
01788       read_uleb128 (&abbrev_buf);\par
01789       read_uleb128 (&abbrev_buf);\par
01790     \}\par
01791       {\cf19 else}\par
01792     \{\par
01793       attrs = (({\cf17 struct }attr *)\par
01794            backtrace_alloc (state, num_attrs * {\cf17 sizeof} *attrs,\par
01795                     error_callback, data));\par
01796       {\cf19 if} (attrs == NULL)\par
01797         {\cf19 goto} fail;\par
01798       num_attrs = 0;\par
01799       {\cf19 while} (1)\par
01800         \{\par
01801           uint64_t name;\par
01802           uint64_t form;\par
01803 \par
01804           name = read_uleb128 (&abbrev_buf);\par
01805           form = read_uleb128 (&abbrev_buf);\par
01806           {\cf19 if} (name == 0)\par
01807         {\cf19 break};\par
01808           attrs[num_attrs].name = ({\cf17 enum} dwarf_attribute) name;\par
01809           attrs[num_attrs].form = ({\cf17 enum} dwarf_form) form;\par
01810           {\cf19 if} (({\cf17 enum} dwarf_form) form == DW_FORM_implicit_const)\par
01811         attrs[num_attrs].val = read_sleb128 (&abbrev_buf);\par
01812           {\cf19 else}\par
01813         attrs[num_attrs].val = 0;\par
01814           ++num_attrs;\par
01815         \}\par
01816     \}\par
01817 \par
01818       a.num_attrs = num_attrs;\par
01819       a.attrs = attrs;\par
01820 \par
01821       abbrevs->abbrevs[num_abbrevs] = a;\par
01822       ++num_abbrevs;\par
01823     \}\par
01824 \par
01825   backtrace_qsort (abbrevs->abbrevs, abbrevs->num_abbrevs,\par
01826            sizeof ({\cf17 struct} abbrev), abbrev_compare);\par
01827 \par
01828   {\cf19 return} 1;\par
01829 \par
01830  fail:\par
01831   free_abbrevs (state, abbrevs, error_callback, data);\par
01832   {\cf19 return} 0;\par
01833 \}\par
01834 \par
01835 {\cf20 /* Return the abbrev information for an abbrev code.  */}\par
01836 \par
01837 {\cf17 static} {\cf17 const} {\cf17 struct }abbrev *\par
01838 lookup_abbrev ({\cf17 struct} abbrevs *abbrevs, uint64_t code,\par
01839            backtrace_error_callback error_callback, {\cf18 void} *data)\par
01840 \{\par
01841   {\cf17 struct }abbrev key;\par
01842   {\cf18 void} *p;\par
01843 \par
01844   {\cf20 /* With GCC, where abbrevs are simply numbered in order, we should}\par
01845 {\cf20      be able to just look up the entry.  */}\par
01846   {\cf19 if} (code - 1 < abbrevs->num_abbrevs\par
01847       && abbrevs->abbrevs[code - 1].code == code)\par
01848     {\cf19 return} &abbrevs->abbrevs[code - 1];\par
01849 \par
01850   {\cf20 /* Otherwise we have to search.  */}\par
01851   memset (&key, 0, {\cf17 sizeof} key);\par
01852   key.code = code;\par
01853   p = bsearch (&key, abbrevs->abbrevs, abbrevs->num_abbrevs,\par
01854            sizeof ({\cf17 struct} abbrev), abbrev_compare);\par
01855   {\cf19 if} (p == NULL)\par
01856     \{\par
01857       error_callback (data, {\cf22 "invalid abbreviation code"}, 0);\par
01858       {\cf19 return} NULL;\par
01859     \}\par
01860   {\cf19 return} ({\cf17 const} {\cf17 struct} abbrev *) p;\par
01861 \}\par
01862 \par
01863 {\cf20 /* This struct is used to gather address range information while}\par
01864 {\cf20    reading attributes.  We use this while building a mapping from}\par
01865 {\cf20    address ranges to compilation units and then again while mapping}\par
01866 {\cf20    from address ranges to function entries.  Normally either}\par
01867 {\cf20    lowpc/highpc is set or ranges is set.  */}\par
01868 \par
01869 {\cf17 struct }pcrange \{\par
01870   uintptr_t lowpc;             {\cf20 /* The low PC value.  */}\par
01871   {\cf18 int} have_lowpc;       {\cf20 /* Whether a low PC value was found.  */}\par
01872   {\cf18 int} lowpc_is_addr_index;  {\cf20 /* Whether lowpc is in .debug_addr.  */}\par
01873   uintptr_t highpc;            {\cf20 /* The high PC value.  */}\par
01874   {\cf18 int} have_highpc;      {\cf20 /* Whether a high PC value was found.  */}\par
01875   {\cf18 int} highpc_is_relative;   {\cf20 /* Whether highpc is relative to lowpc.  */}\par
01876   {\cf18 int} highpc_is_addr_index; {\cf20 /* Whether highpc is in .debug_addr.  */}\par
01877   uint64_t ranges;      {\cf20 /* Offset in ranges section.  */}\par
01878   {\cf18 int} have_ranges;      {\cf20 /* Whether ranges is valid.  */}\par
01879   {\cf18 int} ranges_is_index;      {\cf20 /* Whether ranges is DW_FORM_rnglistx.  */}\par
01880 \};\par
01881 \par
01882 {\cf20 /* Update PCRANGE from an attribute value.  */}\par
01883 \par
01884 {\cf17 static} {\cf18 void}\par
01885 update_pcrange ({\cf17 const} {\cf17 struct} attr* attr, {\cf17 const} {\cf17 struct} attr_val* val,\par
01886         {\cf17 struct} pcrange *pcrange)\par
01887 \{\par
01888   {\cf19 switch} (attr->name)\par
01889     \{\par
01890     {\cf19 case} DW_AT_low_pc:\par
01891       {\cf19 if} (val->encoding == ATTR_VAL_ADDRESS)\par
01892     \{\par
01893       pcrange->lowpc = (uintptr_t) val->u.uint;\par
01894       pcrange->have_lowpc = 1;\par
01895     \}\par
01896       {\cf19 else} {\cf19 if} (val->encoding == ATTR_VAL_ADDRESS_INDEX)\par
01897     \{\par
01898       pcrange->lowpc = (uintptr_t) val->u.uint;\par
01899       pcrange->have_lowpc = 1;\par
01900       pcrange->lowpc_is_addr_index = 1;\par
01901     \}\par
01902       {\cf19 break};\par
01903 \par
01904     {\cf19 case} DW_AT_high_pc:\par
01905       {\cf19 if} (val->encoding == ATTR_VAL_ADDRESS)\par
01906     \{\par
01907       pcrange->highpc = (uintptr_t) val->u.uint;\par
01908       pcrange->have_highpc = 1;\par
01909     \}\par
01910       {\cf19 else} {\cf19 if} (val->encoding == ATTR_VAL_UINT)\par
01911     \{\par
01912       pcrange->highpc = (uintptr_t) val->u.uint;\par
01913       pcrange->have_highpc = 1;\par
01914       pcrange->highpc_is_relative = 1;\par
01915     \}\par
01916       {\cf19 else} {\cf19 if} (val->encoding == ATTR_VAL_ADDRESS_INDEX)\par
01917     \{\par
01918       pcrange->highpc = (uintptr_t) val->u.uint;\par
01919       pcrange->have_highpc = 1;\par
01920       pcrange->highpc_is_addr_index = 1;\par
01921     \}\par
01922       {\cf19 break};\par
01923 \par
01924     {\cf19 case} DW_AT_ranges:\par
01925       {\cf19 if} (val->encoding == ATTR_VAL_UINT\par
01926       || val->encoding == ATTR_VAL_REF_SECTION)\par
01927     \{\par
01928       pcrange->ranges = val->u.uint;\par
01929       pcrange->have_ranges = 1;\par
01930     \}\par
01931       {\cf19 else} {\cf19 if} (val->encoding == ATTR_VAL_RNGLISTS_INDEX)\par
01932     \{\par
01933       pcrange->ranges = val->u.uint;\par
01934       pcrange->have_ranges = 1;\par
01935       pcrange->ranges_is_index = 1;\par
01936     \}\par
01937       {\cf19 break};\par
01938 \par
01939     {\cf19 default}:\par
01940       {\cf19 break};\par
01941     \}\par
01942 \}\par
01943 \par
01944 {\cf20 /* Call ADD_RANGE for a low/high PC pair.  Returns 1 on success, 0 on}\par
01945 {\cf20   error.  */}\par
