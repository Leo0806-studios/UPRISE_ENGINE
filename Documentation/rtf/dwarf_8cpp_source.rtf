01956                       {\cf18 void} *data, {\cf18 void} *vec),\par
01957             {\cf18 void} *rdata,\par
01958             backtrace_error_callback error_callback, {\cf18 void} *data,\par
01959             {\cf18 void} *vec)\par
01960 \{\par
01961   uintptr_t lowpc;\par
01962   uintptr_t highpc;\par
01963 \par
01964   lowpc = pcrange->lowpc;\par
01965   {\cf19 if} (pcrange->lowpc_is_addr_index)\par
01966     \{\par
01967       {\cf19 if} (!resolve_addr_index (dwarf_sections, u->addr_base, u->addrsize,\par
01968                    is_bigendian, lowpc, error_callback, data,\par
01969                    &lowpc))\par
01970     {\cf19 return} 0;\par
01971     \}\par
01972 \par
01973   highpc = pcrange->highpc;\par
