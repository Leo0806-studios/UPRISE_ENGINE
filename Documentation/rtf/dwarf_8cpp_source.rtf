02021   ranges_buf.left = dwarf_sections->size[DEBUG_RANGES] - pcrange->ranges;\par
02022   ranges_buf.is_bigendian = is_bigendian;\par
02023   ranges_buf.error_callback = error_callback;\par
02024   ranges_buf.data = data;\par
02025   ranges_buf.reported_underflow = 0;\par
02026 \par
02027   {\cf19 while} (1)\par
02028     \{\par
02029       uint64_t low;\par
02030       uint64_t high;\par
02031 \par
02032       {\cf19 if} (ranges_buf.reported_underflow)\par
02033     {\cf19 return} 0;\par
02034 \par
02035       low = read_address (&ranges_buf, u->addrsize);\par
02036       high = read_address (&ranges_buf, u->addrsize);\par
02037 \par
02038       {\cf19 if} (low == 0 && high == 0)\par
02039     {\cf19 break};\par
02040 \par
02041       {\cf19 if} (is_highest_address (low, u->addrsize))\par
02042     base = (uintptr_t) high;\par
02043       {\cf19 else}\par
02044     \{\par
02045       {\cf19 if} (!add_range (state, rdata, \par
02046               (uintptr_t) low + base + base_address,\par
02047               (uintptr_t) high + base + base_address,\par
02048               error_callback, data, vec))\par
02049         {\cf19 return} 0;\par
02050     \}\par
02051     \}\par
02052 \par
02053   {\cf19 if} (ranges_buf.reported_underflow)\par
02054     {\cf19 return} 0;\par
02055 \par
02056   {\cf19 return} 1;\par
02057 \}\par
02058 \par
02059 {\cf20 /* Call ADD_RANGE for each range read from .debug_rnglists, as used in}\par
02060 {\cf20    DWARF version 5.  */}\par
02061 \par
02062 {\cf17 static} {\cf18 int}\par
02063 add_ranges_from_rnglists (\par
02064     {\cf17 struct} backtrace_state *state,\par
02065     {\cf17 const} {\cf17 struct} dwarf_sections *dwarf_sections,\par
02066     uintptr_t base_address, {\cf18 int} is_bigendian,\par
02067     {\cf17 struct} unit *u, uintptr_t base,\par
02068     {\cf17 const} {\cf17 struct} pcrange *pcrange,\par
02069     {\cf18 int} (*add_range) ({\cf17 struct} backtrace_state *state, {\cf18 void} *rdata,\par
02070               uintptr_t lowpc, uintptr_t highpc,\par
02071               backtrace_error_callback error_callback, {\cf18 void} *data,\par
02072               {\cf18 void} *vec),\par
02073     {\cf18 void} *rdata,\par
02074     backtrace_error_callback error_callback, {\cf18 void} *data,\par
02075     {\cf18 void} *vec)\par
02076 \{\par
02077   uint64_t offset;\par
02078   {\cf17 struct }dwarf_buf rnglists_buf;\par
02079 \par
02080   {\cf19 if} (!pcrange->ranges_is_index)\par
02081     offset = pcrange->ranges;\par
02082   {\cf19 else}\par
02083     offset = u->rnglists_base + pcrange->ranges * (u->is_dwarf64 ? 8 : 4);\par
02084   {\cf19 if} (offset >= dwarf_sections->size[DEBUG_RNGLISTS])\par
02085     \{\par
02086       error_callback (data, {\cf22 "rnglists offset out of range"}, 0);\par
02087       {\cf19 return} 0;\par
02088     \}\par
02089 \par
02090   rnglists_buf.name = {\cf22 ".debug_rnglists"};\par
02091   rnglists_buf.start = dwarf_sections->data[DEBUG_RNGLISTS];\par
02092   rnglists_buf.buf = dwarf_sections->data[DEBUG_RNGLISTS] + offset;\par
02093   rnglists_buf.left = dwarf_sections->size[DEBUG_RNGLISTS] - offset;\par
02094   rnglists_buf.is_bigendian = is_bigendian;\par
02095   rnglists_buf.error_callback = error_callback;\par
02096   rnglists_buf.data = data;\par
02097   rnglists_buf.reported_underflow = 0;\par
02098 \par
02099   {\cf19 if} (pcrange->ranges_is_index)\par
02100     \{\par
02101       offset = read_offset (&rnglists_buf, u->is_dwarf64);\par
02102       offset += u->rnglists_base;\par
02103       {\cf19 if} (offset >= dwarf_sections->size[DEBUG_RNGLISTS])\par
02104     \{\par
02105       error_callback (data, {\cf22 "rnglists index offset out of range"}, 0);\par
02106       {\cf19 return} 0;\par
02107     \}\par
02108       rnglists_buf.buf = dwarf_sections->data[DEBUG_RNGLISTS] + offset;\par
02109       rnglists_buf.left = dwarf_sections->size[DEBUG_RNGLISTS] - offset;\par
02110     \}\par
02111 \par
02112   {\cf19 while} (1)\par
02113     \{\par
02114       {\cf18 unsigned} {\cf18 char} rle;\par
02115 \par
02116       rle = read_byte (&rnglists_buf);\par
02117       {\cf19 if} (rle == DW_RLE_end_of_list)\par
02118     {\cf19 break};\par
02119       {\cf19 switch} (rle)\par
02120     \{\par
02121     {\cf19 case} DW_RLE_base_addressx:\par
02122       \{\par
02123         uint64_t index;\par
02124 \par
02125         index = read_uleb128 (&rnglists_buf);\par
02126         {\cf19 if} (!resolve_addr_index (dwarf_sections, u->addr_base,\par
02127                      u->addrsize, is_bigendian, index,\par
02128                      error_callback, data, &base))\par
02129           {\cf19 return} 0;\par
02130       \}\par
02131       {\cf19 break};\par
02132 \par
02133     {\cf19 case} DW_RLE_startx_endx:\par
02134       \{\par
02135         uint64_t index;\par
02136         uintptr_t low;\par
02137         uintptr_t high;\par
02138 \par
02139         index = read_uleb128 (&rnglists_buf);\par
02140         {\cf19 if} (!resolve_addr_index (dwarf_sections, u->addr_base,\par
02141                      u->addrsize, is_bigendian, index,\par
02142                      error_callback, data, &low))\par
02143           {\cf19 return} 0;\par
02144         index = read_uleb128 (&rnglists_buf);\par
02145         {\cf19 if} (!resolve_addr_index (dwarf_sections, u->addr_base,\par
02146                      u->addrsize, is_bigendian, index,\par
02147                      error_callback, data, &high))\par
02148           {\cf19 return} 0;\par
02149         {\cf19 if} (!add_range (state, rdata, low + base_address,\par
02150                 high + base_address, error_callback, data,\par
02151                 vec))\par
02152           {\cf19 return} 0;\par
02153       \}\par
02154       {\cf19 break};\par
02155 \par
02156     {\cf19 case} DW_RLE_startx_length:\par
02157       \{\par
02158         uint64_t index;\par
02159         uintptr_t low;\par
02160         uintptr_t length;\par
02161 \par
02162         index = read_uleb128 (&rnglists_buf);\par
02163         {\cf19 if} (!resolve_addr_index (dwarf_sections, u->addr_base,\par
02164                      u->addrsize, is_bigendian, index,\par
02165                      error_callback, data, &low))\par
02166           {\cf19 return} 0;\par
02167         length = read_uleb128 (&rnglists_buf);\par
02168         low += base_address;\par
02169         {\cf19 if} (!add_range (state, rdata, low, low + length,\par
02170                 error_callback, data, vec))\par
02171           {\cf19 return} 0;\par
02172       \}\par
02173       {\cf19 break};\par
02174 \par
02175     {\cf19 case} DW_RLE_offset_pair:\par
02176       \{\par
02177         uint64_t low;\par
02178         uint64_t high;\par
02179 \par
02180         low = read_uleb128 (&rnglists_buf);\par
02181         high = read_uleb128 (&rnglists_buf);\par
02182         {\cf19 if} (!add_range (state, rdata, low + base + base_address,\par
02183                 high + base + base_address,\par
02184                 error_callback, data, vec))\par
02185           {\cf19 return} 0;\par
02186       \}\par
02187       {\cf19 break};\par
02188 \par
02189     {\cf19 case} DW_RLE_base_address:\par
02190       base = (uintptr_t) read_address (&rnglists_buf, u->addrsize);\par
02191       {\cf19 break};\par
02192 \par
02193     {\cf19 case} DW_RLE_start_end:\par
02194       \{\par
02195         uintptr_t low;\par
02196         uintptr_t high;\par
02197 \par
02198         low = (uintptr_t) read_address (&rnglists_buf, u->addrsize);\par
02199         high = (uintptr_t) read_address (&rnglists_buf, u->addrsize);\par
02200         {\cf19 if} (!add_range (state, rdata, low + base_address,\par
02201                 high + base_address, error_callback, data,\par
02202                 vec))\par
02203           {\cf19 return} 0;\par
02204       \}\par
02205       {\cf19 break};\par
02206 \par
02207     {\cf19 case} DW_RLE_start_length:\par
02208       \{\par
02209         uintptr_t low;\par
02210         uintptr_t length;\par
02211 \par
02212         low = (uintptr_t) read_address (&rnglists_buf, u->addrsize);\par
02213         length = (uintptr_t) read_uleb128 (&rnglists_buf);\par
02214         low += base_address;\par
02215         {\cf19 if} (!add_range (state, rdata, low, low + length,\par
02216                 error_callback, data, vec))\par
02217           {\cf19 return} 0;\par
02218       \}\par
02219       {\cf19 break};\par
02220 \par
02221     {\cf19 default}:\par
02222       dwarf_buf_error (&rnglists_buf, {\cf22 "unrecognized DW_RLE value"}, -1);\par
02223       {\cf19 return} 0;\par
02224     \}\par
02225     \}\par
02226 \par
02227   {\cf19 if} (rnglists_buf.reported_underflow)\par
02228     {\cf19 return} 0;\par
02229 \par
02230   {\cf19 return} 1;\par
02231 \}\par
02232 \par
02233 {\cf20 /* Call ADD_RANGE for each lowpc/highpc pair in PCRANGE.  RDATA is}\par
02234 {\cf20    passed to ADD_RANGE, and is either a struct unit * or a struct}\par
02235 {\cf20    function *.  VEC is the vector we are adding ranges to, and is}\par
02236 {\cf20    either a struct unit_addrs_vector * or a struct function_vector *.}\par
02237 {\cf20    Returns 1 on success, 0 on error.  */}\par
02238 \par
02239 {\cf17 static} {\cf18 int}\par
02240 add_ranges ({\cf17 struct} backtrace_state *state,\par
02241         {\cf17 const} {\cf17 struct} dwarf_sections *dwarf_sections,\par
02242         uintptr_t base_address, {\cf18 int} is_bigendian,\par
02243         {\cf17 struct} unit *u, uintptr_t base, {\cf17 const} {\cf17 struct} pcrange *pcrange,\par
02244         {\cf18 int} (*add_range) ({\cf17 struct} backtrace_state *state, {\cf18 void} *rdata, \par
02245                   uintptr_t lowpc, uintptr_t highpc,\par
02246                   backtrace_error_callback error_callback,\par
02247                   {\cf18 void} *data, {\cf18 void} *vec),\par
02248         {\cf18 void} *rdata,\par
02249         backtrace_error_callback error_callback, {\cf18 void} *data,\par
02250         {\cf18 void} *vec)\par
02251 \{\par
02252   {\cf19 if} (pcrange->have_lowpc && pcrange->have_highpc)\par
02253     {\cf19 return} add_low_high_range (state, dwarf_sections, base_address,\par
02254                    is_bigendian, u, pcrange, add_range, rdata,\par
02255                    error_callback, data, vec);\par
02256 \par
02257   {\cf19 if} (!pcrange->have_ranges)\par
02258     \{\par
02259       {\cf20 /* Did not find any address ranges to add.  */}\par
02260       {\cf19 return} 1;\par
02261     \}\par
02262 \par
02263   {\cf19 if} (u->version < 5)\par
02264     {\cf19 return} add_ranges_from_ranges (state, dwarf_sections, base_address,\par
02265                    is_bigendian, u, base, pcrange, add_range,\par
02266                    rdata, error_callback, data, vec);\par
02267   {\cf19 else}\par
02268     {\cf19 return} add_ranges_from_rnglists (state, dwarf_sections, base_address,\par
02269                      is_bigendian, u, base, pcrange, add_range,\par
02270                      rdata, error_callback, data, vec);\par
02271 \}\par
02272 \par
02273 {\cf20 /* Find the address range covered by a compilation unit, reading from}\par
02274 {\cf20    UNIT_BUF and adding values to U.  Returns 1 if all data could be}\par
02275 {\cf20    read, 0 if there is some error.  */}\par
02276 \par
02277 {\cf17 static} {\cf18 int}\par
02278 find_address_ranges ({\cf17 struct} backtrace_state *state, uintptr_t base_address,\par
02279              {\cf17 struct} dwarf_buf *unit_buf,\par
02280              {\cf17 const} {\cf17 struct} dwarf_sections *dwarf_sections,\par
02281              {\cf18 int} is_bigendian, {\cf17 struct} dwarf_data *altlink,\par
02282              backtrace_error_callback error_callback, {\cf18 void} *data,\par
02283              {\cf17 struct} unit *u, {\cf17 struct} unit_addrs_vector *addrs,\par
02284              {\cf17 enum} dwarf_tag *unit_tag)\par
02285 \{\par
02286   {\cf19 while} (unit_buf->left > 0)\par
02287     \{\par
02288       uint64_t code;\par
02289       {\cf17 const} {\cf17 struct }abbrev *abbrev;\par
02290       {\cf17 struct }pcrange pcrange;\par
02291       {\cf17 struct }attr_val name_val;\par
02292       {\cf18 int} have_name_val;\par
02293       {\cf17 struct }attr_val comp_dir_val;\par
02294       {\cf18 int} have_comp_dir_val;\par
02295       {\cf18 size_t} i;\par
02296 \par
02297       code = read_uleb128 (unit_buf);\par
02298       {\cf19 if} (code == 0)\par
02299     {\cf19 return} 1;\par
02300 \par
02301       abbrev = lookup_abbrev (&u->abbrevs, code, error_callback, data);\par
02302       {\cf19 if} (abbrev == NULL)\par
02303     {\cf19 return} 0;\par
02304 \par
02305       {\cf19 if} (unit_tag != NULL)\par
02306     *unit_tag = abbrev->tag;\par
02307 \par
02308       memset (&pcrange, 0, {\cf17 sizeof} pcrange);\par
02309       memset (&name_val, 0, {\cf17 sizeof} name_val);\par
02310       have_name_val = 0;\par
02311       memset (&comp_dir_val, 0, {\cf17 sizeof} comp_dir_val);\par
02312       have_comp_dir_val = 0;\par
02313       {\cf19 for} (i = 0; i < abbrev->num_attrs; ++i)\par
02314     \{\par
02315       {\cf17 struct }attr_val val;\par
02316 \par
02317       {\cf19 if} (!read_attribute (abbrev->attrs[i].form, abbrev->attrs[i].val,\par
02318                    unit_buf, u->is_dwarf64, u->version,\par
02319                    u->addrsize, dwarf_sections, altlink, &val))\par
02320         {\cf19 return} 0;\par
02321 \par
02322       {\cf19 switch} (abbrev->attrs[i].name)\par
02323         \{\par
02324         {\cf19 case} DW_AT_low_pc: {\cf19 case} DW_AT_high_pc: {\cf19 case} DW_AT_ranges:\par
02325           update_pcrange (&abbrev->attrs[i], &val, &pcrange);\par
02326           {\cf19 break};\par
02327 \par
02328         {\cf19 case} DW_AT_stmt_list:\par
02329           {\cf19 if} ((abbrev->tag == DW_TAG_compile_unit\par
02330            || abbrev->tag == DW_TAG_skeleton_unit)\par
02331           && (val.encoding == ATTR_VAL_UINT\par
02332               || val.encoding == ATTR_VAL_REF_SECTION))\par
02333         u->lineoff = val.u.uint;\par
02334           {\cf19 break};\par
02335 \par
02336         {\cf19 case} DW_AT_name:\par
02337           {\cf19 if} (abbrev->tag == DW_TAG_compile_unit\par
02338           || abbrev->tag == DW_TAG_skeleton_unit)\par
02339         \{\par
02340           name_val = val;\par
02341           have_name_val = 1;\par
02342         \}\par
02343           {\cf19 break};\par
02344 \par
02345         {\cf19 case} DW_AT_comp_dir:\par
02346           {\cf19 if} (abbrev->tag == DW_TAG_compile_unit\par
02347           || abbrev->tag == DW_TAG_skeleton_unit)\par
02348         \{\par
02349           comp_dir_val = val;\par
02350           have_comp_dir_val = 1;\par
02351         \}\par
02352           {\cf19 break};\par
02353 \par
02354         {\cf19 case} DW_AT_str_offsets_base:\par
02355           {\cf19 if} ((abbrev->tag == DW_TAG_compile_unit\par
02356            || abbrev->tag == DW_TAG_skeleton_unit)\par
02357           && val.encoding == ATTR_VAL_REF_SECTION)\par
02358         u->str_offsets_base = val.u.uint;\par
02359           {\cf19 break};\par
02360 \par
02361         {\cf19 case} DW_AT_addr_base:\par
02362           {\cf19 if} ((abbrev->tag == DW_TAG_compile_unit\par
02363            || abbrev->tag == DW_TAG_skeleton_unit)\par
02364           && val.encoding == ATTR_VAL_REF_SECTION)\par
02365         u->addr_base = val.u.uint;\par
02366           {\cf19 break};\par
02367 \par
02368         {\cf19 case} DW_AT_rnglists_base:\par
02369           {\cf19 if} ((abbrev->tag == DW_TAG_compile_unit\par
02370            || abbrev->tag == DW_TAG_skeleton_unit)\par
02371           && val.encoding == ATTR_VAL_REF_SECTION)\par
02372         u->rnglists_base = val.u.uint;\par
02373           {\cf19 break};\par
02374 \par
02375         {\cf19 default}:\par
02376           {\cf19 break};\par
02377         \}\par
02378     \}\par
02379 \par
02380       {\cf20 // Resolve strings after we're sure that we have seen}\par
02381       {\cf20 // DW_AT_str_offsets_base.}\par
02382       {\cf19 if} (have_name_val)\par
02383     \{\par
02384       {\cf19 if} (!resolve_string (dwarf_sections, u->is_dwarf64, is_bigendian,\par
02385                    u->str_offsets_base, &name_val,\par
02386                    error_callback, data, &u->filename))\par
02387         {\cf19 return} 0;\par
02388     \}\par
02389       {\cf19 if} (have_comp_dir_val)\par
02390     \{\par
02391       {\cf19 if} (!resolve_string (dwarf_sections, u->is_dwarf64, is_bigendian,\par
02392                    u->str_offsets_base, &comp_dir_val,\par
02393                    error_callback, data, &u->comp_dir))\par
02394         {\cf19 return} 0;\par
02395     \}\par
02396 \par
02397       {\cf19 if} (abbrev->tag == DW_TAG_compile_unit\par
02398       || abbrev->tag == DW_TAG_subprogram\par
02399       || abbrev->tag == DW_TAG_skeleton_unit)\par
02400     \{\par
02401       {\cf19 if} (!add_ranges (state, dwarf_sections, base_address,\par
02402                is_bigendian, u, pcrange.lowpc, &pcrange,\par
02403                add_unit_addr, ({\cf18 void} *) u, error_callback, data,\par
02404                ({\cf18 void} *) addrs))\par
02405         {\cf19 return} 0;\par
02406 \par
02407       {\cf20 /* If we found the PC range in the DW_TAG_compile_unit or}\par
02408 {\cf20          DW_TAG_skeleton_unit, we can stop now.  */}\par
02409       {\cf19 if} ((abbrev->tag == DW_TAG_compile_unit\par
02410            || abbrev->tag == DW_TAG_skeleton_unit)\par
02411           && (pcrange.have_ranges\par
02412           || (pcrange.have_lowpc && pcrange.have_highpc)))\par
02413         {\cf19 return} 1;\par
02414     \}\par
02415 \par
02416       {\cf19 if} (abbrev->has_children)\par
02417     \{\par
02418       {\cf19 if} (!find_address_ranges (state, base_address, unit_buf,\par
02419                     dwarf_sections, is_bigendian, altlink,\par
02420                     error_callback, data, u, addrs, NULL))\par
02421         {\cf19 return} 0;\par
02422     \}\par
02423     \}\par
02424 \par
02425   {\cf19 return} 1;\par
02426 \}\par
02427 \par
02428 {\cf20 /* Build a mapping from address ranges to the compilation units where}\par
02429 {\cf20    the line number information for that range can be found.  Returns 1}\par
02430 {\cf20    on success, 0 on failure.  */}\par
02431 \par
02432 {\cf17 static} {\cf18 int}\par
02433 build_address_map ({\cf17 struct} backtrace_state *state, uintptr_t base_address,\par
02434            {\cf17 const} {\cf17 struct} dwarf_sections *dwarf_sections,\par
02435            {\cf18 int} is_bigendian, {\cf17 struct} dwarf_data *altlink,\par
02436            backtrace_error_callback error_callback, {\cf18 void} *data,\par
02437            {\cf17 struct} unit_addrs_vector *addrs,\par
02438            {\cf17 struct} unit_vector *unit_vec)\par
02439 \{\par
02440   {\cf17 struct }dwarf_buf info;\par
02441   {\cf17 struct }backtrace_vector units;\par
02442   {\cf18 size_t} units_count;\par
02443   {\cf18 size_t} i;\par
02444   {\cf17 struct }unit **pu;\par
02445   {\cf18 size_t} unit_offset = 0;\par
02446   {\cf17 struct }unit_addrs *pa;\par
02447 \par
02448   memset (&addrs->vec, 0, {\cf17 sizeof} addrs->vec);\par
02449   memset (&unit_vec->vec, 0, {\cf17 sizeof} unit_vec->vec);\par
02450   addrs->count = 0;\par
02451   unit_vec->count = 0;\par
02452 \par
02453   {\cf20 /* Read through the .debug_info section.  FIXME: Should we use the}\par
02454 {\cf20      .debug_aranges section?  gdb and addr2line don't use it, but I'm}\par
02455 {\cf20      not sure why.  */}\par
02456 \par
02457   info.name = {\cf22 ".debug_info"};\par
02458   info.start = dwarf_sections->data[DEBUG_INFO];\par
02459   info.buf = info.start;\par
02460   info.left = dwarf_sections->size[DEBUG_INFO];\par
02461   info.is_bigendian = is_bigendian;\par
02462   info.error_callback = error_callback;\par
02463   info.data = data;\par
02464   info.reported_underflow = 0;\par
02465 \par
02466   memset (&units, 0, {\cf17 sizeof} units);\par
02467   units_count = 0;\par
02468 \par
02469   {\cf19 while} (info.left > 0)\par
02470     \{\par
02471       {\cf17 const} {\cf18 unsigned} {\cf18 char} *unit_data_start;\par
02472       uint64_t len;\par
02473       {\cf18 int} is_dwarf64;\par
02474       {\cf17 struct }dwarf_buf unit_buf;\par
02475       {\cf18 int} version;\par
02476       {\cf18 int} unit_type;\par
02477       uint64_t abbrev_offset;\par
02478       {\cf18 int} addrsize;\par
02479       {\cf17 struct }unit *u;\par
02480       {\cf17 enum} dwarf_tag unit_tag;\par
02481 \par
02482       {\cf19 if} (info.reported_underflow)\par
02483     {\cf19 goto} fail;\par
02484 \par
02485       unit_data_start = info.buf;\par
02486 \par
02487       len = read_initial_length (&info, &is_dwarf64);\par
02488       unit_buf = info;\par
02489       unit_buf.left = len;\par
02490 \par
02491       {\cf19 if} (!advance (&info, len))\par
02492     {\cf19 goto} fail;\par
02493 \par
02494       version = read_uint16 (&unit_buf);\par
02495       {\cf19 if} (version < 2 || version > 5)\par
02496     \{\par
02497       dwarf_buf_error (&unit_buf, {\cf22 "unrecognized DWARF version"}, -1);\par
02498       {\cf19 goto} fail;\par
02499     \}\par
02500 \par
02501       {\cf19 if} (version < 5)\par
02502     unit_type = 0;\par
02503       {\cf19 else}\par
02504     \{\par
02505       unit_type = read_byte (&unit_buf);\par
02506       {\cf19 if} (unit_type == DW_UT_type || unit_type == DW_UT_split_type)\par
02507         \{\par
02508           {\cf20 /* This unit doesn't have anything we need.  */}\par
02509           {\cf19 continue};\par
02510         \}\par
02511     \}\par
02512 \par
02513       pu = (({\cf17 struct }unit **)\par
02514         backtrace_vector_grow (state, {\cf17 sizeof} ({\cf17 struct} unit *),\par
02515                    error_callback, data, &units));\par
02516       {\cf19 if} (pu == NULL)\par
02517       {\cf19 goto} fail;\par
02518 \par
02519       u = (({\cf17 struct }unit *)\par
02520        backtrace_alloc (state, {\cf17 sizeof} *u, error_callback, data));\par
02521       {\cf19 if} (u == NULL)\par
02522     {\cf19 goto} fail;\par
02523 \par
02524       *pu = u;\par
02525       ++units_count;\par
02526 \par
