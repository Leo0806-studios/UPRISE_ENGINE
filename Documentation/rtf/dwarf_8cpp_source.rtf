00957 \par
00958 {\cf20 /* Read an unsigned LEB128 number.  */}\par
00959 \par
00960 {\cf17 static} uint64_t\par
00961 read_uleb128 ({\cf17 struct} dwarf_buf *buf)\par
00962 \{\par
00963   uint64_t ret;\par
00964   {\cf18 unsigned} {\cf18 int} shift;\par
00965   {\cf18 int} overflow;\par
00966   {\cf18 unsigned} {\cf18 char} b;\par
00967 \par
00968   ret = 0;\par
00969   shift = 0;\par
00970   overflow = 0;\par
00971   {\cf19 do}\par
00972     \{\par
00973       {\cf17 const} {\cf18 unsigned} {\cf18 char} *p;\par
00974 \par
00975       p = buf->buf;\par
00976       {\cf19 if} (!advance (buf, 1))\par
00977     {\cf19 return} 0;\par
00978       b = *p;\par
00979       {\cf19 if} (shift < 64)\par
00980     ret |= ((uint64_t) (b & 0x7f)) << shift;\par
00981       {\cf19 else} {\cf19 if} (!overflow)\par
00982     \{\par
00983       dwarf_buf_error (buf, {\cf22 "LEB128 overflows uint64_t"}, 0);\par
00984       overflow = 1;\par
00985     \}\par
00986       shift += 7;\par
00987     \}\par
00988   {\cf19 while} ((b & 0x80) != 0);\par
00989 \par
00990   {\cf19 return} ret;\par
00991 \}\par
00992 \par
00993 {\cf20 /* Read a signed LEB128 number.  */}\par
00994 \par
00995 {\cf17 static} int64_t\par
00996 read_sleb128 ({\cf17 struct} dwarf_buf *buf)\par
00997 \{\par
00998   uint64_t val;\par
00999   {\cf18 unsigned} {\cf18 int} shift;\par
01000   {\cf18 int} overflow;\par
01001   {\cf18 unsigned} {\cf18 char} b;\par
01002 \par
01003   val = 0;\par
01004   shift = 0;\par
01005   overflow = 0;\par
01006   {\cf19 do}\par
01007     \{\par
01008       {\cf17 const} {\cf18 unsigned} {\cf18 char} *p;\par
01009 \par
01010       p = buf->buf;\par
01011       {\cf19 if} (!advance (buf, 1))\par
01012     {\cf19 return} 0;\par
01013       b = *p;\par
01014       {\cf19 if} (shift < 64)\par
01015     val |= ((uint64_t) (b & 0x7f)) << shift;\par
01016       {\cf19 else} {\cf19 if} (!overflow)\par
01017     \{\par
01018       dwarf_buf_error (buf, {\cf22 "signed LEB128 overflows uint64_t"}, 0);\par
01019       overflow = 1;\par
01020     \}\par
01021       shift += 7;\par
01022     \}\par
01023   {\cf19 while} ((b & 0x80) != 0);\par
01024 \par
01025   {\cf19 if} ((b & 0x40) != 0 && shift < 64)\par
01026     val |= ((uint64_t) -1) << shift;\par
01027 \par
01028   {\cf19 return} (int64_t) val;\par
01029 \}\par
01030 \par
01031 {\cf20 /* Return the length of an LEB128 number.  */}\par
01032 \par
01033 {\cf17 static} {\cf18 size_t}\par
01034 leb128_len ({\cf17 const} {\cf18 unsigned} {\cf18 char} *p)\par
01035 \{\par
01036   {\cf18 size_t} ret;\par
