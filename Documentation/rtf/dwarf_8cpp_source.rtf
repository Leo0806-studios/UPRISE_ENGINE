00850 {\cf17 static} uint32_t\par
00851 read_uint24 ({\cf17 struct} dwarf_buf *buf)\par
00852 \{\par
00853   {\cf17 const} {\cf18 unsigned} {\cf18 char} *p = buf->buf;\par
