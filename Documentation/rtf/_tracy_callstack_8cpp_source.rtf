00633 \par
00634     {\cf18 char}* res = ({\cf18 char}*)tracy_malloc( end - ptr + 1 );\par
00635     {\cf18 size_t} rsz = 0;\par
00636 \par
00637     {\cf19 while}( ptr < end )\par
00638     \{\par
00639         {\cf17 const} {\cf18 char}* next = ptr;\par
00640         {\cf19 while}( next < end && *next != {\cf23 '/'} ) next++;\par
00641         {\cf18 size_t} lsz = next - ptr;\par
00642         {\cf19 switch}( lsz )\par
00643         \{\par
00644         {\cf19 case} 2:\par
00645             {\cf19 if}( memcmp( ptr, {\cf22 ".."}, 2 ) == 0 )\par
00646             \{\par
00647                 {\cf17 const} {\cf18 char}* back = res + rsz - 1;\par
00648                 {\cf19 while}( back > res && *back != {\cf23 '/'} ) back--;\par
00649                 rsz = back - res;\par
00650                 ptr = next + 1;\par
00651                 {\cf19 continue};\par
00652             \}\par
00653             {\cf19 break};\par
00654         {\cf19 case} 1:\par
00655             {\cf19 if}( *ptr == {\cf23 '.'} )\par
00656             \{\par
00657                 ptr = next + 1;\par
00658                 {\cf19 continue};\par
00659             \}\par
00660             {\cf19 break};\par
00661         {\cf19 case} 0:\par
00662             ptr = next + 1;\par
00663             {\cf19 continue};\par
00664         \}\par
00665         {\cf19 if}( rsz != 1 ) res[rsz++] = {\cf23 '/'};\par
00666         memcpy( res+rsz, ptr, lsz );\par
00667         rsz += lsz;\par
00668         ptr = next + 1;\par
00669     \}\par
00670 \par
00671     {\cf19 if}( rsz == 0 )\par
00672     \{\par
00673         memcpy( res, {\cf22 "/"}, 2 );\par
00674     \}\par
00675     {\cf19 else}\par
00676     \{\par
00677         res[rsz] = {\cf23 '\\0'};\par
00678     \}\par
