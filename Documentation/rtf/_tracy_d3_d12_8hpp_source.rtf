323     {\cf17 private}:\par
324         tracy_force_inline uint32_t NextQueryId()\par
325         \{\par
326             uint32_t queryCounter = m_queryCounter.fetch_add(2);\par
327             {\cf19 if} (queryCounter >= m_queryLimit)\par
328             \{\par
329                 TracyD3D12Panic({\cf22 "Submitted too many GPU queries! Consider increasing MaxQueries."});\par
330                 {\cf20 // #TODO: consider returning an invalid id or sentinel value here}\par
331             \}\par
332 \par
333             {\cf17 const} uint32_t {\cf18 id} = (m_previousQueryCounter + queryCounter) % m_queryLimit;\par
334 \par
335             {\cf19 return} id;\par
336         \}\par
337 \par
338         tracy_force_inline uint8_t GetId(){\cf17  const}\par
339 {\cf17         }\{\par
340             {\cf19 return} m_contextId;\par
341         \}\par
