67         {\cf20 // In-progress payload.}\par
68         uint32_t m_queryLimit = 0;\par
69         std::atomic<uint32_t> m_queryCounter = 0;\par
70         uint32_t m_previousQueryCounter = 0;\par
71 \par
72         uint32_t m_activePayload = 0;\par
73         ID3D12Fence* m_payloadFence = {\cf17 nullptr};\par
74         std::queue<D3D12QueryPayload> m_payloadQueue;\par
