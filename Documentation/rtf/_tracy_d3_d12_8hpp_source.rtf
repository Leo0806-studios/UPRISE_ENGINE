115     {\cf17 public}:\par
116         D3D12QueueCtx(ID3D12Device* device, ID3D12CommandQueue* queue)\par
117             : m_device(device)\par
118             , m_queue(queue)\par
119         \{\par
120             {\cf20 // Verify we support timestamp queries on this queue.}\par
121 \par
122             {\cf19 if} (queue->GetDesc().Type == D3D12_COMMAND_LIST_TYPE_COPY)\par
123             \{\par
124                 D3D12_FEATURE_DATA_D3D12_OPTIONS3 featureData\{\};\par
125 \par
126                 HRESULT hr = device->CheckFeatureSupport(D3D12_FEATURE_D3D12_OPTIONS3, &featureData, {\cf17 sizeof}(featureData));\par
127                 {\cf19 if} (FAILED(hr) || (featureData.CopyQueueTimestampQueriesSupported == FALSE))\par
128                 \{\par
129                     TracyD3D12Panic({\cf22 "Platform does not support profiling of copy queues."}, {\cf19 return});\par
130                 \}\par
131             \}\par
132 \par
133             {\cf17 static} {\cf17 constexpr} uint32_t MaxQueries = 64 * 1024;  {\cf20 // Must be even, because queries are (begin, end) pairs}\par
134             m_queryLimit = MaxQueries;\par
135 \par
136             D3D12_QUERY_HEAP_DESC heapDesc\{\};\par
137             heapDesc.Type = queue->GetDesc().Type == D3D12_COMMAND_LIST_TYPE_COPY ? D3D12_QUERY_HEAP_TYPE_COPY_QUEUE_TIMESTAMP : D3D12_QUERY_HEAP_TYPE_TIMESTAMP;\par
138             heapDesc.Count = m_queryLimit;\par
139             heapDesc.NodeMask = 0;  {\cf20 // #TODO: Support multiple adapters.}\par
140 \par
141             {\cf19 while} (FAILED(device->CreateQueryHeap(&heapDesc, IID_PPV_ARGS(&m_queryHeap))))\par
142             \{\par
143                 m_queryLimit /= 2;\par
144                 heapDesc.Count = m_queryLimit;\par
145             \}\par
146 \par
147             {\cf20 // Create a readback buffer, which will be used as a destination for the query data.}\par
148 \par
149             D3D12_RESOURCE_DESC readbackBufferDesc\{\};\par
150             readbackBufferDesc.Alignment = 0;\par
151             readbackBufferDesc.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;\par
152             readbackBufferDesc.Width = m_queryLimit * {\cf17 sizeof}(uint64_t);\par
153             readbackBufferDesc.Height = 1;\par
154             readbackBufferDesc.DepthOrArraySize = 1;\par
155             readbackBufferDesc.Format = DXGI_FORMAT_UNKNOWN;\par
156             readbackBufferDesc.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;  {\cf20 // Buffers are always row major.}\par
157             readbackBufferDesc.MipLevels = 1;\par
158             readbackBufferDesc.SampleDesc.Count = 1;\par
159             readbackBufferDesc.SampleDesc.Quality = 0;\par
160             readbackBufferDesc.Flags = D3D12_RESOURCE_FLAG_NONE;\par
161 \par
162             D3D12_HEAP_PROPERTIES readbackHeapProps\{\};\par
163             readbackHeapProps.Type = D3D12_HEAP_TYPE_READBACK;\par
164             readbackHeapProps.CPUPageProperty = D3D12_CPU_PAGE_PROPERTY_UNKNOWN;\par
165             readbackHeapProps.MemoryPoolPreference = D3D12_MEMORY_POOL_UNKNOWN;\par
166             readbackHeapProps.CreationNodeMask = 0;\par
167             readbackHeapProps.VisibleNodeMask = 0;  {\cf20 // #TODO: Support multiple adapters.}\par
168 \par
169             {\cf19 if} (FAILED(device->CreateCommittedResource(&readbackHeapProps, D3D12_HEAP_FLAG_NONE, &readbackBufferDesc, D3D12_RESOURCE_STATE_COPY_DEST, {\cf17 nullptr}, IID_PPV_ARGS(&m_readbackBuffer))))\par
170             \{\par
171                 TracyD3D12Panic({\cf22 "Failed to create query readback buffer."}, {\cf19 return});\par
172             \}\par
173 \par
174             {\cf19 if} (FAILED(device->CreateFence(0, D3D12_FENCE_FLAG_NONE, IID_PPV_ARGS(&m_payloadFence))))\par
175             \{\par
176                 TracyD3D12Panic({\cf22 "Failed to create payload fence."}, {\cf19 return});\par
177             \}\par
178 \par
179             {\cf18 float} period = [queue]()\par
180             \{\par
181                 uint64_t timestampFrequency;\par
182                 {\cf19 if} (FAILED(queue->GetTimestampFrequency(&timestampFrequency)))\par
183                 \{\par
184                     {\cf19 return} 0.0f;\par
185                 \}\par
186                 {\cf19 return} {\cf17 static_cast<}{\cf18 float}{\cf17 >}( 1E+09 / {\cf17 static_cast<}{\cf18 double}{\cf17 >}(timestampFrequency) );\par
187             \}();\par
188 \par
189             {\cf19 if} (period == 0.0f)\par
190             \{\par
191                 TracyD3D12Panic({\cf22 "Failed to get timestamp frequency."}, {\cf19 return});\par
192             \}\par
193 \par
194             uint64_t cpuTimestamp;\par
195             uint64_t gpuTimestamp;\par
196             {\cf19 if} (FAILED(queue->GetClockCalibration(&gpuTimestamp, &cpuTimestamp)))\par
197             \{\par
198                 TracyD3D12Panic({\cf22 "Failed to get queue clock calibration."}, {\cf19 return});\par
199             \}\par
200 \par
201             {\cf20 // Save the device cpu timestamp, not the profiler's timestamp.}\par
202             m_prevCalibrationTicksCPU = cpuTimestamp;\par
203 \par
204             cpuTimestamp = Profiler::GetTime();\par
205 \par
206             {\cf20 // all checked: ready to roll}\par
207             m_contextId = GetGpuCtxCounter().fetch_add(1);\par
208 \par
209             {\cf17 auto}* item = Profiler::QueueSerial();\par
210             MemWrite(&item->hdr.type, QueueType::GpuNewContext);\par
211             MemWrite(&item->gpuNewContext.cpuTime, cpuTimestamp);\par
212             MemWrite(&item->gpuNewContext.gpuTime, gpuTimestamp);\par
213             MemWrite(&item->gpuNewContext.thread, {\cf17 decltype}(item->gpuNewContext.thread)(0)); {\cf20 // #TODO: why 0 instead of GetThreadHandle()?}\par
214             MemWrite(&item->gpuNewContext.period, period);\par
215             MemWrite(&item->gpuNewContext.context, GetId());\par
216             MemWrite(&item->gpuNewContext.flags, GpuContextCalibration);\par
217             MemWrite(&item->gpuNewContext.type, GpuContextType::Direct3D12);\par
218             SubmitQueueItem(item);\par
219         \}\par
220 \par
221         ~D3D12QueueCtx()\par
222         \{\par
223             ZoneScopedC(Color::Red4);\par
224             {\cf20 // collect all pending timestamps}\par
225             {\cf19 while} (m_payloadFence->GetCompletedValue() != m_activePayload)\par
226                 {\cf20 /* busy-wait ... */};\par
227             Collect();\par
228             m_payloadFence->Release();\par
229             m_readbackBuffer->Release();\par
230             m_queryHeap->Release();\par
231         \}\par
232 \par
233 \par
234         {\cf18 void} NewFrame()\par
235         \{\par
236             uint32_t queryCounter = m_queryCounter.exchange(0);\par
237             m_payloadQueue.emplace(D3D12QueryPayload\{ m_previousQueryCounter, queryCounter \});\par
238             m_previousQueryCounter += queryCounter;\par
239 \par
240             {\cf19 if} (m_previousQueryCounter >= m_queryLimit)\par
241             \{\par
242                 m_previousQueryCounter -= m_queryLimit;\par
243             \}\par
244 \par
245             m_queue->Signal(m_payloadFence, ++m_activePayload);\par
246         \}\par
247 \par
248         {\cf18 void} Name( {\cf17 const} {\cf18 char}* name, uint16_t len )\par
249         \{\par
250             {\cf17 auto} ptr = ({\cf18 char}*)tracy_malloc( len );\par
251             memcpy( ptr, name, len );\par
252 \par
253             {\cf17 auto} item = Profiler::QueueSerial();\par
254             MemWrite( &item->hdr.type, QueueType::GpuContextName );\par
255             MemWrite( &item->gpuContextNameFat.context, GetId());\par
256             MemWrite( &item->gpuContextNameFat.ptr, (uint64_t)ptr );\par
257             MemWrite( &item->gpuContextNameFat.size, len );\par
258             SubmitQueueItem(item);\par
259         \}\par
260 \par
261         {\cf18 void} Collect()\par
262         \{\par
263             ZoneScopedC(Color::Red4);\par
264 \par
265 {\cf21 #ifdef TRACY_ON_DEMAND}\par
266             {\cf19 if} (!GetProfiler().IsConnected())\par
267             \{\par
268                 m_queryCounter = 0;\par
269 \par
270                 {\cf19 return};\par
271             \}\par
272 {\cf21 #endif}\par
273 \par
274             {\cf20 // Find out what payloads are available.}\par
275             {\cf17 const} {\cf17 auto} newestReadyPayload = m_payloadFence->GetCompletedValue();\par
276             {\cf17 const} {\cf17 auto} payloadCount = m_payloadQueue.size() - (m_activePayload - newestReadyPayload);\par
277 \par
278             {\cf19 if} (!payloadCount)\par
279             \{\par
280                 {\cf19 return};  {\cf20 // No payloads are available yet, exit out.}\par
281             \}\par
282 \par
283             D3D12_RANGE mapRange\{ 0, m_queryLimit * {\cf17 sizeof}(uint64_t) \};\par
284 \par
285             {\cf20 // Map the readback buffer so we can fetch the query data from the GPU.}\par
286             {\cf18 void}* readbackBufferMapping = {\cf17 nullptr};\par
287 \par
288             {\cf19 if} (FAILED(m_readbackBuffer->Map(0, &mapRange, &readbackBufferMapping)))\par
289             \{\par
290                 TracyD3D12Panic({\cf22 "Failed to map readback buffer."}, {\cf19 return});\par
291             \}\par
292 \par
293             {\cf17 auto}* timestampData = {\cf17 static_cast<}uint64_t*{\cf17 >}(readbackBufferMapping);\par
294 \par
295             {\cf19 for} (uint32_t i = 0; i < payloadCount; ++i)\par
296             \{\par
297                 {\cf17 const} {\cf17 auto}& payload = m_payloadQueue.front();\par
298 \par
299                 {\cf19 for} (uint32_t j = 0; j < payload.m_queryCount; ++j)\par
300                 \{\par
301                     {\cf17 const} {\cf17 auto} counter = (payload.m_queryIdStart + j) % m_queryLimit;\par
302                     {\cf17 const} {\cf17 auto} timestamp = timestampData[counter];\par
303                     {\cf17 const} {\cf17 auto} queryId = counter;\par
304 \par
305                     {\cf17 auto}* item = Profiler::QueueSerial();\par
306                     MemWrite(&item->hdr.type, QueueType::GpuTime);\par
307                     MemWrite(&item->gpuTime.gpuTime, timestamp);\par
308                     MemWrite(&item->gpuTime.queryId, {\cf17 static_cast<}uint16_t{\cf17 >}(queryId));\par
309                     MemWrite(&item->gpuTime.context, GetId());\par
310 \par
311                     Profiler::QueueSerialFinish();\par
312                 \}\par
313 \par
314                 m_payloadQueue.pop();\par
315             \}\par
316 \par
317             m_readbackBuffer->Unmap(0, {\cf17 nullptr});\par
318 \par
319             {\cf20 // Recalibrate to account for drift.}\par
320             RecalibrateClocks();\par
321         \}\par
