78         {\cf18 void} RecalibrateClocks()\par
79         \{\par
80             UINT64 cpuTimestamp;\par
81             UINT64 gpuTimestamp;\par
82             {\cf19 if} (FAILED(m_queue->GetClockCalibration(&gpuTimestamp, &cpuTimestamp)))\par
83             \{\par
84                 TracyD3D12Panic({\cf22 "failed to obtain queue clock calibration counters."}, {\cf19 return});\par
85             \}\par
86 \par
87             int64_t cpuDeltaTicks = cpuTimestamp - m_prevCalibrationTicksCPU;\par
88             {\cf19 if} (cpuDeltaTicks > 0)\par
89             \{\par
90                 {\cf17 static} {\cf17 const} int64_t nanosecodsPerTick = int64_t(1000000000) / GetFrequencyQpc();\par
91                 int64_t cpuDeltaNS = cpuDeltaTicks * nanosecodsPerTick;\par
92                 {\cf20 // Save the device cpu timestamp, not the Tracy profiler timestamp:}\par
93                 m_prevCalibrationTicksCPU = cpuTimestamp;\par
94 \par
95                 cpuTimestamp = Profiler::GetTime();\par
96 \par
97                 {\cf17 auto}* item = Profiler::QueueSerial();\par
98                 MemWrite(&item->hdr.type, QueueType::GpuCalibration);\par
99                 MemWrite(&item->gpuCalibration.gpuTime, gpuTimestamp);\par
100                 MemWrite(&item->gpuCalibration.cpuTime, cpuTimestamp);\par
101                 MemWrite(&item->gpuCalibration.cpuDelta, cpuDeltaNS);\par
102                 MemWrite(&item->gpuCalibration.context, GetId());\par
103                 SubmitQueueItem(item);\par
104             \}\par
105         \}\par
106 \par
107         tracy_force_inline {\cf18 void} SubmitQueueItem(tracy::QueueItem* item)\par
108         \{\par
109 {\cf21 #ifdef TRACY_ON_DEMAND}\par
110             GetProfiler().DeferItem(*item);\par
111 {\cf21 #endif}\par
112             Profiler::QueueSerialFinish();\par
113         \}\par
