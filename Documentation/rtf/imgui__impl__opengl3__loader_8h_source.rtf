748 {\cf17 static} {\cf18 int} open_libgl({\cf18 void})\par
749 \{\par
750     {\cf18 int} res = open_libs();\par
751     {\cf19 if} (res)\par
752         {\cf19 return} res;\par
753 \par
754     {\cf19 if} (libegl)\par
755         *({\cf18 void}**)(&gl_get_proc_address) = dlsym(libegl, {\cf22 "eglGetProcAddress"});\par
756     {\cf19 else} {\cf19 if} (libglx)\par
757         *({\cf18 void}**)(&gl_get_proc_address) = dlsym(libglx, {\cf22 "glXGetProcAddressARB"});\par
758     {\cf19 else}\par
759         *({\cf18 void}**)(&gl_get_proc_address) = dlsym(libgl, {\cf22 "glXGetProcAddressARB"});\par
760 \par
761     {\cf19 if} (!gl_get_proc_address) \{\par
762         close_libgl();\par
763         {\cf19 return} GL3W_ERROR_LIBRARY_OPEN;\par
764     \}\par
765 \par
766     {\cf19 return} GL3W_OK;\par
767 \}\par
