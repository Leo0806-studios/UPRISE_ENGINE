695 {\cf17 static} {\cf18 int} open_libs({\cf18 void})\par
696 \{\par
697     {\cf20 // On Linux we have two APIs to get process addresses: EGL and GLX.}\par
698     {\cf20 // EGL is supported under both X11 and Wayland, whereas GLX is X11-specific.}\par
699 \par
700     libgl = NULL;\par
701     libegl = NULL;\par
702     libglx = NULL;\par
703 \par
704     {\cf20 // First check what's already loaded, the windowing library might have}\par
705     {\cf20 // already loaded either EGL or GLX and we want to use the same one.}\par
706 \par
707     {\cf19 if} (is_library_loaded({\cf22 "libEGL.so.1"}, &libegl) ||\par
708         is_library_loaded({\cf22 "libGLX.so.0"}, &libglx)) \{\par
709         libgl = dlopen({\cf22 "libOpenGL.so.0"}, RTLD_LAZY | RTLD_LOCAL);\par
710         {\cf19 if} (libgl)\par
711             {\cf19 return} GL3W_OK;\par
712         {\cf19 else}\par
713             close_libgl();\par
714     \}\par
715 \par
716     {\cf19 if} (is_library_loaded({\cf22 "libGL.so"}, &libgl))\par
717         {\cf19 return} GL3W_OK;\par
718     {\cf19 if} (is_library_loaded({\cf22 "libGL.so.1"}, &libgl))\par
719         {\cf19 return} GL3W_OK;\par
720     {\cf19 if} (is_library_loaded({\cf22 "libGL.so.3"}, &libgl))\par
721         {\cf19 return} GL3W_OK;\par
722 \par
723     {\cf20 // Neither is already loaded, so we have to load one.  Try EGL first}\par
724     {\cf20 // because it is supported under both X11 and Wayland.}\par
725 \par
726     {\cf20 // Load OpenGL + EGL}\par
727     libgl = dlopen({\cf22 "libOpenGL.so.0"}, RTLD_LAZY | RTLD_LOCAL);\par
728     libegl = dlopen({\cf22 "libEGL.so.1"}, RTLD_LAZY | RTLD_LOCAL);\par
729     {\cf19 if} (libgl && libegl)\par
730         {\cf19 return} GL3W_OK;\par
731     {\cf19 else}\par
732         close_libgl();\par
733 \par
734     {\cf20 // Fall back to legacy libGL, which includes GLX}\par
735     {\cf20 // While most systems use libGL.so.1, NetBSD seems to use that libGL.so.3. See https://github.com/ocornut/imgui/issues/6983}\par
736     libgl = dlopen({\cf22 "libGL.so"}, RTLD_LAZY | RTLD_LOCAL);\par
737     {\cf19 if} (!libgl)\par
738         libgl = dlopen({\cf22 "libGL.so.1"}, RTLD_LAZY | RTLD_LOCAL);\par
739     {\cf19 if} (!libgl)\par
740         libgl = dlopen({\cf22 "libGL.so.3"}, RTLD_LAZY | RTLD_LOCAL);\par
741 \par
742     {\cf19 if} (libgl)\par
743         {\cf19 return} GL3W_OK;\par
744 \par
745     {\cf19 return} GL3W_ERROR_LIBRARY_OPEN;\par
746 \}\par
