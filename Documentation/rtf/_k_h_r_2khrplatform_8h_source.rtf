57 {\cf20  *    khronos_uint32_t            unsigned 32 bit}\par
58 {\cf20  *    khronos_int64_t             signed   64 bit}\par
59 {\cf20  *    khronos_uint64_t            unsigned 64 bit}\par
60 {\cf20  *    khronos_intptr_t            signed   same number of bits as a pointer}\par
61 {\cf20  *    khronos_uintptr_t           unsigned same number of bits as a pointer}\par
62 {\cf20  *    khronos_ssize_t             signed   size}\par
63 {\cf20  *    khronos_usize_t             unsigned size}\par
64 {\cf20  *    khronos_float_t             signed   32 bit floating point}\par
65 {\cf20  *    khronos_time_ns_t           unsigned 64 bit time in nanoseconds}\par
66 {\cf20  *    khronos_utime_nanoseconds_t unsigned time interval or absolute time in}\par
67 {\cf20  *                                         nanoseconds}\par
68 {\cf20  *    khronos_stime_nanoseconds_t signed time interval in nanoseconds}\par
69 {\cf20  *    khronos_boolean_enum_t      enumerated boolean type. This should}\par
70 {\cf20  *      only be used as a base type when a client API's boolean type is}\par
71 {\cf20  *      an enum. Client APIs which use an integer or other type for}\par
72 {\cf20  *      booleans cannot use this as the base type for their boolean.}\par
73 {\cf20  *}\par
74 {\cf20  * Tokens defined in khrplatform.h:}\par
75 {\cf20  *}\par
76 {\cf20  *    KHRONOS_FALSE, KHRONOS_TRUE Enumerated boolean false/true values.}\par
77 {\cf20  *}\par
78 {\cf20  *    KHRONOS_SUPPORT_INT64 is 1 if 64 bit integers are supported; otherwise 0.}\par
79 {\cf20  *    KHRONOS_SUPPORT_FLOAT is 1 if floats are supported; otherwise 0.}\par
80 {\cf20  *}\par
81 {\cf20  * Calling convention macros defined in this file:}\par
82 {\cf20  *    KHRONOS_APICALL}\par
83 {\cf20  *    KHRONOS_APIENTRY}\par
84 {\cf20  *    KHRONOS_APIATTRIBUTES}\par
85 {\cf20  *}\par
86 {\cf20  * These may be used in function prototypes as:}\par
87 {\cf20  *}\par
88 {\cf20  *      KHRONOS_APICALL void KHRONOS_APIENTRY funcname(}\par
89 {\cf20  *                                  int arg1,}\par
90 {\cf20  *                                  int arg2) KHRONOS_APIATTRIBUTES;}\par
91 {\cf20  */}\par
92 \par
93 {\cf21 #if defined(__SCITECH_SNAP__) && !defined(KHRONOS_STATIC)}\par
94 {\cf21 #   define KHRONOS_STATIC 1}\par
95 {\cf21 #endif}\par
96 \par
97 {\cf20 /*-------------------------------------------------------------------------}\par
98 {\cf20  * Definition of KHRONOS_APICALL}\par
99 {\cf20  *-------------------------------------------------------------------------}\par
100 {\cf20  * This precedes the return type of the function in the function prototype.}\par
101 {\cf20  */}\par
102 {\cf21 #if defined(KHRONOS_STATIC)}\par
103     {\cf20 /* If the preprocessor constant KHRONOS_STATIC is defined, make the}\par
104 {\cf20      * header compatible with static linking. */}\par
105 {\cf21 #   define KHRONOS_APICALL}\par
106 {\cf21 #elif defined(_WIN32)}\par
107 {\cf21 #   define KHRONOS_APICALL __declspec(dllimport)}\par
108 {\cf21 #elif defined (__SYMBIAN32__)}\par
109 {\cf21 #   define KHRONOS_APICALL IMPORT_C}\par
110 {\cf21 #elif defined(__ANDROID__)}\par
111 {\cf21 #   define KHRONOS_APICALL __attribute__((visibility("default")))}\par
112 {\cf21 #else}\par
113 {\cf21 #   define KHRONOS_APICALL}\par
114 {\cf21 #endif}\par
115 \par
116 {\cf20 /*-------------------------------------------------------------------------}\par
117 {\cf20  * Definition of KHRONOS_APIENTRY}\par
118 {\cf20  *-------------------------------------------------------------------------}\par
119 {\cf20  * This follows the return type of the function  and precedes the function}\par
120 {\cf20  * name in the function prototype.}\par
121 {\cf20  */}\par
122 {\cf21 #if defined(_WIN32) && !defined(_WIN32_WCE) && !defined(__SCITECH_SNAP__)}\par
123     {\cf20 /* Win32 but not WinCE */}\par
124 {\cf21 #   define KHRONOS_APIENTRY __stdcall}\par
125 {\cf21 #else}\par
126 {\cf21 #   define KHRONOS_APIENTRY}\par
127 {\cf21 #endif}\par
128 \par
129 {\cf20 /*-------------------------------------------------------------------------}\par
130 {\cf20  * Definition of KHRONOS_APIATTRIBUTES}\par
131 {\cf20  *-------------------------------------------------------------------------}\par
132 {\cf20  * This follows the closing parenthesis of the function prototype arguments.}\par
133 {\cf20  */}\par
134 {\cf21 #if defined (__ARMCC_2__)}\par
135 {\cf21 #define KHRONOS_APIATTRIBUTES __softfp}\par
136 {\cf21 #else}\par
137 {\cf21 #define KHRONOS_APIATTRIBUTES}\par
138 {\cf21 #endif}\par
139 \par
140 {\cf20 /*-------------------------------------------------------------------------}\par
141 {\cf20  * basic type definitions}\par
142 {\cf20  *-----------------------------------------------------------------------*/}\par
143 {\cf21 #if (defined(__STDC_VERSION__) && __STDC_VERSION__ >= 199901L) || defined(__GNUC__) || defined(__SCO__) || defined(__USLC__)}\par
144 \par
145 \par
146 {\cf20 /*}\par
147 {\cf20  * Using <stdint.h>}\par
148 {\cf20  */}\par
149 {\cf21 #include <stdint.h>}\par
150 {\cf17 typedef} int32_t                 khronos_int32_t;\par
151 {\cf17 typedef} uint32_t                khronos_uint32_t;\par
152 {\cf17 typedef} int64_t                 khronos_int64_t;\par
153 {\cf17 typedef} uint64_t                khronos_uint64_t;\par
154 {\cf21 #define KHRONOS_SUPPORT_INT64   1}\par
155 {\cf21 #define KHRONOS_SUPPORT_FLOAT   1}\par
156 {\cf20 /*}\par
157 {\cf20  * To support platform where unsigned long cannot be used interchangeably with}\par
158 {\cf20  * inptr_t (e.g. CHERI-extended ISAs), we can use the stdint.h intptr_t.}\par
159 {\cf20  * Ideally, we could just use (u)intptr_t everywhere, but this could result in}\par
160 {\cf20  * ABI breakage if khronos_uintptr_t is changed from unsigned long to}\par
161 {\cf20  * unsigned long long or similar (this results in different C++ name mangling).}\par
162 {\cf20  * To avoid changes for existing platforms, we restrict usage of intptr_t to}\par
163 {\cf20  * platforms where the size of a pointer is larger than the size of long.}\par
164 {\cf20  */}\par
165 {\cf21 #if defined(__SIZEOF_LONG__) && defined(__SIZEOF_POINTER__)}\par
166 {\cf21 #if __SIZEOF_POINTER__ > __SIZEOF_LONG__}\par
167 {\cf21 #define KHRONOS_USE_INTPTR_T}\par
168 {\cf21 #endif}\par
169 {\cf21 #endif}\par
170 \par
171 {\cf21 #elif defined(__VMS ) || defined(__sgi)}\par
172 \par
173 {\cf20 /*}\par
174 {\cf20  * Using <inttypes.h>}\par
175 {\cf20  */}\par
176 {\cf21 #include <inttypes.h>}\par
177 {\cf17 typedef} int32_t                 khronos_int32_t;\par
178 {\cf17 typedef} uint32_t                khronos_uint32_t;\par
179 {\cf17 typedef} int64_t                 khronos_int64_t;\par
180 {\cf17 typedef} uint64_t                khronos_uint64_t;\par
181 {\cf21 #define KHRONOS_SUPPORT_INT64   1}\par
182 {\cf21 #define KHRONOS_SUPPORT_FLOAT   1}\par
183 \par
184 {\cf21 #elif defined(_WIN32) && !defined(__SCITECH_SNAP__)}\par
185 \par
186 {\cf20 /*}\par
187 {\cf20  * Win32}\par
188 {\cf20  */}\par
189 {\cf17 typedef} __int32                 khronos_int32_t;\par
190 {\cf17 typedef} {\cf18 unsigned} __int32        khronos_uint32_t;\par
191 {\cf17 typedef} __int64                 khronos_int64_t;\par
192 {\cf17 typedef} {\cf18 unsigned} __int64        khronos_uint64_t;\par
193 {\cf21 #define KHRONOS_SUPPORT_INT64   1}\par
194 {\cf21 #define KHRONOS_SUPPORT_FLOAT   1}\par
195 \par
196 {\cf21 #elif defined(__sun__) || defined(__digital__)}\par
197 \par
198 {\cf20 /*}\par
199 {\cf20  * Sun or Digital}\par
200 {\cf20  */}\par
201 {\cf17 typedef} {\cf18 int}                     khronos_int32_t;\par
202 {\cf17 typedef} {\cf18 unsigned} {\cf18 int}            khronos_uint32_t;\par
203 {\cf21 #if defined(__arch64__) || defined(_LP64)}\par
204 {\cf17 typedef} {\cf18 long} {\cf18 int}                khronos_int64_t;\par
205 {\cf17 typedef} {\cf18 unsigned} {\cf18 long} {\cf18 int}       khronos_uint64_t;\par
206 {\cf21 #else}\par
207 {\cf17 typedef} {\cf18 long} {\cf18 long} {\cf18 int}           khronos_int64_t;\par
208 {\cf17 typedef} {\cf18 unsigned} {\cf18 long} {\cf18 long} {\cf18 int}  khronos_uint64_t;\par
209 {\cf21 #endif }{\cf20 /* __arch64__ */}{\cf21 }\par
210 {\cf21 #define KHRONOS_SUPPORT_INT64   1}\par
211 {\cf21 #define KHRONOS_SUPPORT_FLOAT   1}\par
212 \par
213 {\cf21 #elif 0}\par
214 \par
215 {\cf20 /*}\par
216 {\cf20  * Hypothetical platform with no float or int64 support}\par
217 {\cf20  */}\par
218 {\cf17 typedef} {\cf18 int}                     khronos_int32_t;\par
219 {\cf17 typedef} {\cf18 unsigned} {\cf18 int}            khronos_uint32_t;\par
220 {\cf21 #define KHRONOS_SUPPORT_INT64   0}\par
221 {\cf21 #define KHRONOS_SUPPORT_FLOAT   0}\par
222 \par
223 {\cf21 #else}\par
224 \par
225 {\cf20 /*}\par
226 {\cf20  * Generic fallback}\par
227 {\cf20  */}\par
228 {\cf21 #include <stdint.h>}\par
229 {\cf17 typedef} int32_t                 khronos_int32_t;\par
230 {\cf17 typedef} uint32_t                khronos_uint32_t;\par
231 {\cf17 typedef} int64_t                 khronos_int64_t;\par
232 {\cf17 typedef} uint64_t                khronos_uint64_t;\par
233 {\cf21 #define KHRONOS_SUPPORT_INT64   1}\par
234 {\cf21 #define KHRONOS_SUPPORT_FLOAT   1}\par
235 \par
236 {\cf21 #endif}\par
237 \par
238 \par
239 {\cf20 /*}\par
240 {\cf20  * Types that are (so far) the same on all platforms}\par
241 {\cf20  */}\par
242 {\cf17 typedef} {\cf18 signed}   {\cf18 char}          khronos_int8_t;\par
243 {\cf17 typedef} {\cf18 unsigned} {\cf18 char}          khronos_uint8_t;\par
244 {\cf17 typedef} {\cf18 signed}   {\cf18 short} {\cf18 int}     khronos_int16_t;\par
245 {\cf17 typedef} {\cf18 unsigned} {\cf18 short} {\cf18 int}     khronos_uint16_t;\par
246 \par
247 {\cf20 /*}\par
248 {\cf20  * Types that differ between LLP64 and LP64 architectures - in LLP64,}\par
249 {\cf20  * pointers are 64 bits, but 'long' is still 32 bits. Win64 appears}\par
250 {\cf20  * to be the only LLP64 architecture in current use.}\par
251 {\cf20  */}\par
252 {\cf21 #ifdef KHRONOS_USE_INTPTR_T}\par
253 {\cf17 typedef} intptr_t               khronos_intptr_t;\par
254 {\cf17 typedef} uintptr_t              khronos_uintptr_t;\par
255 {\cf21 #elif defined(_WIN64)}\par
256 {\cf17 typedef} {\cf18 signed}   {\cf18 long} {\cf18 long} {\cf18 int} khronos_intptr_t;\par
257 {\cf17 typedef} {\cf18 unsigned} {\cf18 long} {\cf18 long} {\cf18 int} khronos_uintptr_t;\par
258 {\cf21 #else}\par
259 {\cf17 typedef} {\cf18 signed}   {\cf18 long}  {\cf18 int}     khronos_intptr_t;\par
260 {\cf17 typedef} {\cf18 unsigned} {\cf18 long}  {\cf18 int}     khronos_uintptr_t;\par
261 {\cf21 #endif}\par
262 \par
263 {\cf21 #if defined(_WIN64)}\par
264 {\cf17 typedef} {\cf18 signed}   {\cf18 long} {\cf18 long} {\cf18 int} khronos_ssize_t;\par
265 {\cf17 typedef} {\cf18 unsigned} {\cf18 long} {\cf18 long} {\cf18 int} khronos_usize_t;\par
266 {\cf21 #else}\par
267 {\cf17 typedef} {\cf18 signed}   {\cf18 long}  {\cf18 int}     khronos_ssize_t;\par
268 {\cf17 typedef} {\cf18 unsigned} {\cf18 long}  {\cf18 int}     khronos_usize_t;\par
269 {\cf21 #endif}\par
270 \par
271 {\cf21 #if KHRONOS_SUPPORT_FLOAT}\par
272 {\cf20 /*}\par
273 {\cf20  * Float type}\par
274 {\cf20  */}\par
275 {\cf17 typedef}          {\cf18 float}         khronos_float_t;\par
276 {\cf21 #endif}\par
277 \par
278 {\cf21 #if KHRONOS_SUPPORT_INT64}\par
279 {\cf20 /* Time types}\par
280 {\cf20  *}\par
281 {\cf20  * These types can be used to represent a time interval in nanoseconds or}\par
282 {\cf20  * an absolute Unadjusted System Time.  Unadjusted System Time is the number}\par
283 {\cf20  * of nanoseconds since some arbitrary system event (e.g. since the last}\par
284 {\cf20  * time the system booted).  The Unadjusted System Time is an unsigned}\par
285 {\cf20  * 64 bit value that wraps back to 0 every 584 years.  Time intervals}\par
286 {\cf20  * may be either signed or unsigned.}\par
287 {\cf20  */}\par
288 {\cf17 typedef} khronos_uint64_t       khronos_utime_nanoseconds_t;\par
289 {\cf17 typedef} khronos_int64_t        khronos_stime_nanoseconds_t;\par
290 {\cf21 #endif}\par
291 \par
292 {\cf20 /*}\par
293 {\cf20  * Dummy value used to pad enum types to 32 bits.}\par
294 {\cf20  */}\par
295 {\cf21 #ifndef KHRONOS_MAX_ENUM}\par
296 {\cf21 #define KHRONOS_MAX_ENUM 0x7FFFFFFF}\par
297 {\cf21 #endif}\par
298 \par
299 {\cf20 /*}\par
300 {\cf20  * Enumerated boolean type}\par
301 {\cf20  *}\par
302 {\cf20  * Values other than zero should be considered to be true.  Therefore}\par
303 {\cf20  * comparisons should not be made against KHRONOS_TRUE.}\par
304 {\cf20  */}\par
305 {\cf17 typedef} {\cf17 enum} \{\par
306     KHRONOS_FALSE = 0,\par
307     KHRONOS_TRUE  = 1,\par
308     KHRONOS_BOOLEAN_ENUM_FORCE_SIZE = KHRONOS_MAX_ENUM\par
309 \} khronos_boolean_enum_t;\par
310 \par
311 {\cf21 #endif }{\cf20 /* __khrplatform_h_ */}{\cf21 }\par
}
