{\xe \v material.h\:_aiTextureType_Force32Bit}
{\qr _aiTextureType_Force32Bit{\bkmkstart AAAAAAACDB}
{\bkmkend AAAAAAACDB}
\cell }{\cell }{\row }
}
}
