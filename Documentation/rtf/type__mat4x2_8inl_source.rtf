498         T {\cf17 const} SrcB00 = m2[0][0];\par
499         T {\cf17 const} SrcB01 = m2[0][1];\par
500         T {\cf17 const} SrcB02 = m2[0][2];\par
501         T {\cf17 const} SrcB03 = m2[0][3];\par
502         T {\cf17 const} SrcB10 = m2[1][0];\par
503         T {\cf17 const} SrcB11 = m2[1][1];\par
504         T {\cf17 const} SrcB12 = m2[1][2];\par
505         T {\cf17 const} SrcB13 = m2[1][3];\par
506 \par
507         mat<2, 2, T, Q> Result;\par
508         Result[0][0] = SrcA00 * SrcB00 + SrcA10 * SrcB01 + SrcA20 * SrcB02 + SrcA30 * SrcB03;\par
509         Result[0][1] = SrcA01 * SrcB00 + SrcA11 * SrcB01 + SrcA21 * SrcB02 + SrcA31 * SrcB03;\par
510         Result[1][0] = SrcA00 * SrcB10 + SrcA10 * SrcB11 + SrcA20 * SrcB12 + SrcA30 * SrcB13;\par
511         Result[1][1] = SrcA01 * SrcB10 + SrcA11 * SrcB11 + SrcA21 * SrcB12 + SrcA31 * SrcB13;\par
512         {\cf19 return} Result;\par
513     \}\par
514 \par
515     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
516     GLM_FUNC_QUALIFIER GLM_CONSTEXPR mat<3, 2, T, Q> operator*(mat<4, 2, T, Q> {\cf17 const}& m1, mat<3, 4, T, Q> {\cf17 const}& m2)\par
517     \{\par
518         {\cf19 return} mat<3, 2, T, Q>(\par
519             m1[0][0] * m2[0][0] + m1[1][0] * m2[0][1] + m1[2][0] * m2[0][2] + m1[3][0] * m2[0][3],\par
520             m1[0][1] * m2[0][0] + m1[1][1] * m2[0][1] + m1[2][1] * m2[0][2] + m1[3][1] * m2[0][3],\par
521             m1[0][0] * m2[1][0] + m1[1][0] * m2[1][1] + m1[2][0] * m2[1][2] + m1[3][0] * m2[1][3],\par
522             m1[0][1] * m2[1][0] + m1[1][1] * m2[1][1] + m1[2][1] * m2[1][2] + m1[3][1] * m2[1][3],\par
523             m1[0][0] * m2[2][0] + m1[1][0] * m2[2][1] + m1[2][0] * m2[2][2] + m1[3][0] * m2[2][3],\par
524             m1[0][1] * m2[2][0] + m1[1][1] * m2[2][1] + m1[2][1] * m2[2][2] + m1[3][1] * m2[2][3]);\par
525     \}\par
526 \par
527     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
528     GLM_FUNC_QUALIFIER GLM_CONSTEXPR mat<4, 2, T, Q> operator*(mat<4, 2, T, Q> {\cf17 const}& m1, mat<4, 4, T, Q> {\cf17 const}& m2)\par
529     \{\par
530         {\cf19 return} mat<4, 2, T, Q>(\par
531             m1[0][0] * m2[0][0] + m1[1][0] * m2[0][1] + m1[2][0] * m2[0][2] + m1[3][0] * m2[0][3],\par
532             m1[0][1] * m2[0][0] + m1[1][1] * m2[0][1] + m1[2][1] * m2[0][2] + m1[3][1] * m2[0][3],\par
533             m1[0][0] * m2[1][0] + m1[1][0] * m2[1][1] + m1[2][0] * m2[1][2] + m1[3][0] * m2[1][3],\par
534             m1[0][1] * m2[1][0] + m1[1][1] * m2[1][1] + m1[2][1] * m2[1][2] + m1[3][1] * m2[1][3],\par
535             m1[0][0] * m2[2][0] + m1[1][0] * m2[2][1] + m1[2][0] * m2[2][2] + m1[3][0] * m2[2][3],\par
536             m1[0][1] * m2[2][0] + m1[1][1] * m2[2][1] + m1[2][1] * m2[2][2] + m1[3][1] * m2[2][3],\par
537             m1[0][0] * m2[3][0] + m1[1][0] * m2[3][1] + m1[2][0] * m2[3][2] + m1[3][0] * m2[3][3],\par
538             m1[0][1] * m2[3][0] + m1[1][1] * m2[3][1] + m1[2][1] * m2[3][2] + m1[3][1] * m2[3][3]);\par
539     \}\par
