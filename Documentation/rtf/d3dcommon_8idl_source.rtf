431 {\cf21 // ID3DInclude:}\par
432 {\cf21 // -------------}\par
433 {\cf21 // This interface is intended to be implemented by the application, and can}\par
434 {\cf21 // be used by various D3D APIs.  This enables application-specific handling}\par
435 {\cf21 // of #include directives in source files.}\par
436 {\cf21 //}\par
437 {\cf21 // Open()}\par
438 {\cf21 //    Opens an include file.  If successful, it should fill in ppData and}\par
439 {\cf21 //    pBytes.  The data pointer returned must remain valid until Close is}\par
440 {\cf21 //    subsequently called.  The name of the file is encoded in UTF-8 format.}\par
441 {\cf21 // Close()}\par
442 {\cf21 //    Closes an include file.  If Open was successful, Close is guaranteed}\par
443 {\cf21 //    to be called before the API using this interface returns.}\par
444 {\cf21 //----------------------------------------------------------------------------}\par
445 {\cf21 }\par
446 {\cf21 cpp_quote("typedef interface ID3DInclude ID3DInclude;")}\par
447 {\cf21 }\par
448 {\cf21 cpp_quote("#undef INTERFACE")}\par
449 {\cf21 cpp_quote("#define INTERFACE ID3DInclude")}\par
450 {\cf21 }\par
451 {\cf21 cpp_quote("DECLARE_INTERFACE(ID3DInclude)")}\par
452 {\cf21 cpp_quote("\{")}\par
453 {\cf21 cpp_quote("    STDMETHOD(Open)(THIS_ D3D_INCLUDE_TYPE IncludeType, LPCSTR pFileName, LPCVOID pParentData, LPCVOID *ppData, UINT *pBytes) PURE;")}\par
454 {\cf21 cpp_quote("    STDMETHOD(Close)(THIS_ LPCVOID pData) PURE;")}\par
455 {\cf21 cpp_quote("\};")}\par
456 {\cf21 }\par
457 {\cf21 cpp_quote("typedef ID3DInclude* LPD3DINCLUDE;")}\par
