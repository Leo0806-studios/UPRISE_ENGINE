01191 {\cf17 static} {\cf18 void}\par
01192 _rpmalloc_span_unmap(span_t* span) \{\par
01193     rpmalloc_assert((span->flags & SPAN_FLAG_MASTER) || (span->flags & SPAN_FLAG_SUBSPAN), {\cf22 "Span flag corrupted"});\par
01194     rpmalloc_assert(!(span->flags & SPAN_FLAG_MASTER) || !(span->flags & SPAN_FLAG_SUBSPAN), {\cf22 "Span flag corrupted"});\par
01195 \par
01196     {\cf18 int} is_master = !!(span->flags & SPAN_FLAG_MASTER);\par
01197     span_t* master = is_master ? span : ((span_t*)pointer_offset(span, -(intptr_t)((uintptr_t)span->offset_from_master * _memory_span_size)));\par
01198     rpmalloc_assert(is_master || (span->flags & SPAN_FLAG_SUBSPAN), {\cf22 "Span flag corrupted"});\par
01199     rpmalloc_assert(master->flags & SPAN_FLAG_MASTER, {\cf22 "Span flag corrupted"});\par
01200 \par
01201     {\cf18 size_t} span_count = span->span_count;\par
01202     {\cf19 if} (!is_master) \{\par
01203         {\cf20 //Directly unmap subspans (unless huge pages, in which case we defer and unmap entire page range with master)}\par
01204         rpmalloc_assert(span->align_offset == 0, {\cf22 "Span align offset corrupted"});\par
01205         {\cf19 if} (_memory_span_size >= _memory_page_size)\par
01206             _rpmalloc_unmap(span, span_count * _memory_span_size, 0, 0);\par
01207     \} {\cf19 else} \{\par
01208         {\cf20 //Special double flag to denote an unmapped master}\par
01209         {\cf20 //It must be kept in memory since span header must be used}\par
01210         span->flags |= SPAN_FLAG_MASTER | SPAN_FLAG_SUBSPAN | SPAN_FLAG_UNMAPPED_MASTER;\par
01211         _rpmalloc_stat_add(&_unmapped_master_spans, 1);\par
01212     \}\par
01213 \par
01214     {\cf19 if} (atomic_add32(&master->remaining_spans, -(int32_t)span_count) <= 0) \{\par
01215         {\cf20 //Everything unmapped, unmap the master span with release flag to unmap the entire range of the super span}\par
01216         rpmalloc_assert(!!(master->flags & SPAN_FLAG_MASTER) && !!(master->flags & SPAN_FLAG_SUBSPAN), {\cf22 "Span flag corrupted"});\par
01217         {\cf18 size_t} unmap_count = master->span_count;\par
01218         {\cf19 if} (_memory_span_size < _memory_page_size)\par
01219             unmap_count = master->total_spans;\par
01220         _rpmalloc_stat_sub(&_master_spans, 1);\par
01221         _rpmalloc_stat_sub(&_unmapped_master_spans, 1);\par
01222         _rpmalloc_unmap(master, unmap_count * _memory_span_size, master->align_offset, ({\cf18 size_t})master->total_spans * _memory_span_size);\par
01223     \}\par
01224 \}\par
