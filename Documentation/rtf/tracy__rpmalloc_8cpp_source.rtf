01120 {\cf17 static} span_t*\par
01121 _rpmalloc_span_map_aligned_count(heap_t* heap, {\cf18 size_t} span_count) \{\par
01122     {\cf20 //If we already have some, but not enough, reserved spans, release those to heap cache and map a new}\par
01123     {\cf20 //full set of spans. Otherwise we would waste memory if page size > span size (huge pages)}\par
01124     {\cf18 size_t} aligned_span_count = _rpmalloc_span_align_count(span_count);\par
01125     {\cf18 size_t} align_offset = 0;\par
