01249 {\cf17 static} uint32_t\par
01250 free_list_partial_init({\cf18 void}** list, {\cf18 void}** first_block, {\cf18 void}* page_start, {\cf18 void}* block_start, uint32_t block_count, uint32_t block_size) \{\par
01251     rpmalloc_assert(block_count, {\cf22 "Internal failure"});\par
01252     *first_block = block_start;\par
01253     {\cf19 if} (block_count > 1) \{\par
01254         {\cf18 void}* free_block = pointer_offset(block_start, block_size);\par
01255         {\cf18 void}* block_end = pointer_offset(block_start, ({\cf18 size_t})block_size * block_count);\par
01256         {\cf20 //If block size is less than half a memory page, bound init to next memory page boundary}\par
01257         {\cf19 if} (block_size < (_memory_page_size >> 1)) \{\par
01258             {\cf18 void}* page_end = pointer_offset(page_start, _memory_page_size);\par
01259             {\cf19 if} (page_end < block_end)\par
01260                 block_end = page_end;\par
01261         \}\par
01262         *list = free_block;\par
01263         block_count = 2;\par
01264         {\cf18 void}* next_block = pointer_offset(free_block, block_size);\par
01265         {\cf19 while} (next_block < block_end) \{\par
01266             *(({\cf18 void}**)free_block) = next_block;\par
01267             free_block = next_block;\par
01268             ++block_count;\par
01269             next_block = pointer_offset(next_block, block_size);\par
01270         \}\par
01271         *(({\cf18 void}**)free_block) = 0;\par
01272     \} {\cf19 else} \{\par
01273         *list = 0;\par
01274     \}\par
01275     {\cf19 return} block_count;\par
01276 \}\par
