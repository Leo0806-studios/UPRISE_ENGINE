01128         {\cf19 return} 0;\par
01129     _rpmalloc_span_initialize(span, aligned_span_count, span_count, align_offset);\par
01130     _rpmalloc_stat_inc(&_master_spans);\par
01131     {\cf19 if} (span_count <= LARGE_CLASS_COUNT)\par
01132         _rpmalloc_stat_inc(&heap->span_use[span_count - 1].spans_map_calls);\par
01133     {\cf19 if} (aligned_span_count > span_count) \{\par
01134         span_t* reserved_spans = (span_t*)pointer_offset(span, span_count * _memory_span_size);\par
01135         {\cf18 size_t} reserved_count = aligned_span_count - span_count;\par
01136         {\cf19 if} (heap->spans_reserved) \{\par
01137             _rpmalloc_span_mark_as_subspan_unless_master(heap->span_reserve_master, heap->span_reserve, heap->spans_reserved);\par
01138             _rpmalloc_heap_cache_insert(heap, heap->span_reserve);\par
01139         \}\par
01140         {\cf19 if} (reserved_count > _memory_heap_reserve_count) \{\par
01141             {\cf20 // If huge pages or eager spam map count, the global reserve spin lock is held by caller, _rpmalloc_span_map}\par
01142             rpmalloc_assert(atomic_load32(&_memory_global_lock) == 1, {\cf22 "Global spin lock not held as expected"});\par
01143             {\cf18 size_t} remain_count = reserved_count - _memory_heap_reserve_count;\par
01144             reserved_count = _memory_heap_reserve_count;\par
01145             span_t* remain_span = (span_t*)pointer_offset(reserved_spans, reserved_count * _memory_span_size);\par
01146             {\cf19 if} (_memory_global_reserve) \{\par
01147                 _rpmalloc_span_mark_as_subspan_unless_master(_memory_global_reserve_master, _memory_global_reserve, _memory_global_reserve_count);\par
01148                 _rpmalloc_span_unmap(_memory_global_reserve);\par
