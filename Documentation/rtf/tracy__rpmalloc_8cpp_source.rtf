01174                 {\cf19 if} (reserve_count > span_count) \{\par
01175                     span_t* reserved_span = (span_t*)pointer_offset(span, span_count << _memory_span_size_shift);\par
01176                     _rpmalloc_heap_set_reserved_spans(heap, _memory_global_reserve_master, reserved_span, reserve_count - span_count);\par
01177                 \}\par
01178                 {\cf20 // Already marked as subspan in _rpmalloc_global_get_reserved_spans}\par
01179                 span->span_count = (uint32_t)span_count;\par
01180             \}\par
01181         \}\par
