01161         {\cf19 return} _rpmalloc_span_map_from_reserve(heap, span_count);\par
01162     span_t* span = 0;\par
01163     {\cf18 int} use_global_reserve = (_memory_page_size > _memory_span_size) || (_memory_span_map_count > _memory_heap_reserve_count);\par
01164     {\cf19 if} (use_global_reserve) \{\par
01165         {\cf20 // If huge pages, make sure only one thread maps more memory to avoid bloat}\par
01166         {\cf19 while} (!atomic_cas32_acquire(&_memory_global_lock, 1, 0))\par
01167             _rpmalloc_spin();\par
01168         {\cf19 if} (_memory_global_reserve_count >= span_count) \{\par
01169             {\cf18 size_t} reserve_count = (!heap->spans_reserved ? _memory_heap_reserve_count : span_count);\par
01170             {\cf19 if} (_memory_global_reserve_count < reserve_count)\par
01171                 reserve_count = _memory_global_reserve_count;\par
01172             span = _rpmalloc_global_get_reserved_spans(reserve_count);\par
