00944                 table->LeftMostStretchedColumn = (ImGuiTableColumnIdx)column_n;\par
00945             {\cf19 if} (table->RightMostStretchedColumn == -1 || table->Columns[table->RightMostStretchedColumn].DisplayOrder < column->DisplayOrder)\par
00946                 table->RightMostStretchedColumn = (ImGuiTableColumnIdx)column_n;\par
00947         \}\par
00948         column->IsPreserveWidthAuto = {\cf17 false};\par
00949         sum_width_requests += table->CellPaddingX * 2.0f;\par
00950     \}\par
00951     table->ColumnsEnabledFixedCount = (ImGuiTableColumnIdx)count_fixed;\par
00952     table->ColumnsStretchSumWeights = stretch_sum_weights;\par
00953 \par
00954     {\cf20 // [Part 4] Apply final widths based on requested widths}\par
00955     {\cf17 const} ImRect work_rect = table->WorkRect;\par
00956     {\cf17 const} {\cf18 float} width_spacings = (table->OuterPaddingX * 2.0f) + (table->CellSpacingX1 + table->CellSpacingX2) * (table->ColumnsEnabledCount - 1);\par
00957     {\cf17 const} {\cf18 float} width_removed = (table->HasScrollbarYPrev && !table->InnerWindow->ScrollbarY) ? g.Style.ScrollbarSize : 0.0f; {\cf20 // To synchronize decoration width of synched tables with mismatching scrollbar state (#5920)}\par
00958     {\cf17 const} {\cf18 float} width_avail = ImMax(1.0f, (((table->Flags & ImGuiTableFlags_ScrollX) && table->InnerWidth == 0.0f) ? table->InnerClipRect.GetWidth() : work_rect.GetWidth()) - width_removed);\par
