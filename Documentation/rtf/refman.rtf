05601 {\cf20 // Find window given position, search front-to-back}\par
05602 {\cf20 // - Typically write output back to g.HoveredWindow and g.HoveredWindowUnderMovingWindow.}\par
05603 {\cf20 // - FIXME: Note that we have an inconsequential lag here: OuterRectClipped is updated in Begin(), so windows moved programmatically}\par
05604 {\cf20 //   with SetWindowPos() and not SetNextWindowPos() will have that rectangle lagging by a frame at the time FindHoveredWindow() is}\par
05605 {\cf20 //   called, aka before the next Begin(). Moving window isn't affected.}\par
05606 {\cf20 // - The 'find_first_and_in_any_viewport = true' mode is only used by TestEngine. It is simpler to maintain here.}\par
05607 {\cf18 void} ImGui::FindHoveredWindowEx({\cf17 const} ImVec2& pos, {\cf18 bool} find_first_and_in_any_viewport, ImGuiWindow** out_hovered_window, ImGuiWindow** out_hovered_window_under_moving_window)\par
05608 \{\par
05609     ImGuiContext& g = *GImGui;\par
05610     ImGuiWindow* hovered_window = NULL;\par
05611     ImGuiWindow* hovered_window_under_moving_window = NULL;\par
05612 \par
05613     {\cf20 // Special handling for the window being moved: Ignore the mouse viewport check (because it may reset/lose its viewport during the undocking frame)}\par
05614     ImGuiViewportP* backup_moving_window_viewport = NULL;\par
05615     {\cf19 if} (find_first_and_in_any_viewport == {\cf17 false} && g.MovingWindow)\par
05616     \{\par
05617         backup_moving_window_viewport = g.MovingWindow->Viewport;\par
05618         g.MovingWindow->Viewport = g.MouseViewport;\par
05619         {\cf19 if} (!(g.MovingWindow->Flags & ImGuiWindowFlags_NoMouseInputs))\par
05620             hovered_window = g.MovingWindow;\par
05621     \}\par
05622 \par
05623     ImVec2 padding_regular = g.Style.TouchExtraPadding;\par
05624     ImVec2 padding_for_resize = g.IO.ConfigWindowsResizeFromEdges ? g.WindowsHoverPadding : padding_regular;\par
05625     {\cf19 for} ({\cf18 int} i = g.Windows.Size - 1; i >= 0; i--)\par
05626     \{\par
05627         ImGuiWindow* window = g.Windows[i];\par
05628         IM_MSVC_WARNING_SUPPRESS(28182); {\cf20 // [Static Analyzer] Dereferencing NULL pointer.}\par
05629         {\cf19 if} (!window->Active || window->Hidden)\par
05630             {\cf19 continue};\par
05631         {\cf19 if} (window->Flags & ImGuiWindowFlags_NoMouseInputs)\par
05632             {\cf19 continue};\par
05633         IM_ASSERT(window->Viewport);\par
05634         {\cf19 if} (window->Viewport != g.MouseViewport)\par
05635             {\cf19 continue};\par
05636 \par
05637         {\cf20 // Using the clipped AABB, a child window will typically be clipped by its parent (not always)}\par
05638         ImVec2 hit_padding = (window->Flags & (ImGuiWindowFlags_NoResize | ImGuiWindowFlags_AlwaysAutoResize)) ? padding_regular : padding_for_resize;\par
05639         {\cf19 if} (!window->OuterRectClipped.ContainsWithPad(pos, hit_padding))\par
05640             {\cf19 continue};\par
05641 \par
05642         {\cf20 // Support for one rectangular hole in any given window}\par
05643         {\cf20 // FIXME: Consider generalizing hit-testing override (with more generic data, callback, etc.) (#1512)}\par
05644         {\cf19 if} (window->HitTestHoleSize.x != 0)\par
05645         \{\par
05646             ImVec2 hole_pos(window->Pos.x + ({\cf18 float})window->HitTestHoleOffset.x, window->Pos.y + ({\cf18 float})window->HitTestHoleOffset.y);\par
05647             ImVec2 hole_size(({\cf18 float})window->HitTestHoleSize.x, ({\cf18 float})window->HitTestHoleSize.y);\par
05648             {\cf19 if} (ImRect(hole_pos, hole_pos + hole_size).Contains(pos))\par
05649                 {\cf19 continue};\par
05650         \}\par
05651 \par
05652         {\cf19 if} (find_first_and_in_any_viewport)\par
05653         \{\par
05654             hovered_window = window;\par
05655             {\cf19 break};\par
05656         \}\par
05657         {\cf19 else}\par
05658         \{\par
05659             {\cf19 if} (hovered_window == NULL)\par
05660                 hovered_window = window;\par
05661             IM_MSVC_WARNING_SUPPRESS(28182); {\cf20 // [Static Analyzer] Dereferencing NULL pointer.}\par
05662             {\cf19 if} (hovered_window_under_moving_window == NULL && (!g.MovingWindow || window->RootWindowDockTree != g.MovingWindow->RootWindowDockTree))\par
05663                 hovered_window_under_moving_window = window;\par
05664             {\cf19 if} (hovered_window && hovered_window_under_moving_window)\par
05665                 {\cf19 break};\par
05666         \}\par
05667     \}\par
05668 \par
05669     *out_hovered_window = hovered_window;\par
05670     {\cf19 if} (out_hovered_window_under_moving_window != NULL)\par
05671         *out_hovered_window_under_moving_window = hovered_window_under_moving_window;\par
05672     {\cf19 if} (find_first_and_in_any_viewport == {\cf17 false} && g.MovingWindow)\par
05673         g.MovingWindow->Viewport = backup_moving_window_viewport;\par
05674 \}\par
