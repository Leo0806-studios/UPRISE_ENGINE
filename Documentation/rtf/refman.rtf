00592         \{\par
00593             GL_CALL(glBufferData(GL_ARRAY_BUFFER, vtx_buffer_size, ({\cf17 const} GLvoid*)cmd_list->VtxBuffer.Data, GL_STREAM_DRAW));\par
00594             GL_CALL(glBufferData(GL_ELEMENT_ARRAY_BUFFER, idx_buffer_size, ({\cf17 const} GLvoid*)cmd_list->IdxBuffer.Data, GL_STREAM_DRAW));\par
00595         \}\par
00596 \par
00597         {\cf19 for} ({\cf18 int} cmd_i = 0; cmd_i < cmd_list->CmdBuffer.Size; cmd_i++)\par
00598         \{\par
00599             {\cf17 const} ImDrawCmd* pcmd = &cmd_list->CmdBuffer[cmd_i];\par
00600             {\cf19 if} (pcmd->UserCallback != {\cf17 nullptr})\par
00601             \{\par
00602                 {\cf20 // User callback, registered via ImDrawList::AddCallback()}\par
00603                 {\cf20 // (ImDrawCallback_ResetRenderState is a special callback value used by the user to request the renderer to reset render state.)}\par
00604                 {\cf19 if} (pcmd->UserCallback == ImDrawCallback_ResetRenderState)\par
