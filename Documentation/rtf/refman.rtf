00673 {\cf20 // Fully unrolled with inline call to keep our debug builds decently fast.}\par
00674 {\cf18 void} ImDrawList::PrimRect({\cf17 const} ImVec2& a, {\cf17 const} ImVec2& c, ImU32 col)\par
00675 \{\par
00676     ImVec2 b(c.x, a.y), d(a.x, c.y), uv(_Data->TexUvWhitePixel);\par
00677     ImDrawIdx idx = (ImDrawIdx)_VtxCurrentIdx;\par
00678     _IdxWritePtr[0] = idx; _IdxWritePtr[1] = (ImDrawIdx)(idx+1); _IdxWritePtr[2] = (ImDrawIdx)(idx+2);\par
00679     _IdxWritePtr[3] = idx; _IdxWritePtr[4] = (ImDrawIdx)(idx+2); _IdxWritePtr[5] = (ImDrawIdx)(idx+3);\par
00680     _VtxWritePtr[0].pos = a; _VtxWritePtr[0].uv = uv; _VtxWritePtr[0].col = col;\par
00681     _VtxWritePtr[1].pos = b; _VtxWritePtr[1].uv = uv; _VtxWritePtr[1].col = col;\par
00682     _VtxWritePtr[2].pos = c; _VtxWritePtr[2].uv = uv; _VtxWritePtr[2].col = col;\par
00683     _VtxWritePtr[3].pos = d; _VtxWritePtr[3].uv = uv; _VtxWritePtr[3].col = col;\par
00684     _VtxWritePtr += 4;\par
00685     _VtxCurrentIdx += 4;\par
00686     _IdxWritePtr += 6;\par
00687 \}\par
