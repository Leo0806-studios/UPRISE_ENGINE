09905         g.LastKeyModsChangeTime = g.Time;\par
09906     {\cf19 if} (prev_key_mods != io.KeyMods && prev_key_mods == 0)\par
09907         g.LastKeyModsChangeFromNoneTime = g.Time;\par
09908 \par
09909     {\cf20 // Clear gamepad data if disabled}\par
09910     {\cf19 if} ((io.BackendFlags & ImGuiBackendFlags_HasGamepad) == 0)\par
09911         {\cf19 for} ({\cf18 int} i = ImGuiKey_Gamepad_BEGIN; i < ImGuiKey_Gamepad_END; i++)\par
09912         \{\par
09913             io.KeysData[i - ImGuiKey_KeysData_OFFSET].Down = {\cf17 false};\par
09914             io.KeysData[i - ImGuiKey_KeysData_OFFSET].AnalogValue = 0.0f;\par
09915         \}\par
09916 \par
09917     {\cf20 // Update keys}\par
09918     {\cf19 for} ({\cf18 int} i = 0; i < ImGuiKey_KeysData_SIZE; i++)\par
09919     \{\par
09920         ImGuiKeyData* key_data = &io.KeysData[i];\par
09921         key_data->DownDurationPrev = key_data->DownDuration;\par
09922         key_data->DownDuration = key_data->Down ? (key_data->DownDuration < 0.0f ? 0.0f : key_data->DownDuration + io.DeltaTime) : -1.0f;\par
09923         {\cf19 if} (key_data->DownDuration == 0.0f)\par
09924         \{\par
09925             ImGuiKey key = (ImGuiKey)(ImGuiKey_KeysData_OFFSET + i);\par
09926             {\cf19 if} (IsKeyboardKey(key))\par
09927                 g.LastKeyboardKeyPressTime = g.Time;\par
