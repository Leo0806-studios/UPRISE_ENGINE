05994             {\cf20 // But when flattened we directly reach items, adjust active layer mask accordingly}\par
05995             {\cf19 if} (nav_flattened)\par
05996                 parent_window->DC.NavLayersActiveMaskNext |= child_window->DC.NavLayersActiveMaskNext;\par
05997         \}\par
05998         {\cf19 if} (g.HoveredWindow == child_window)\par
05999             g.LastItemData.StatusFlags |= ImGuiItemStatusFlags_HoveredWindow;\par
