19147 {\cf20 // Return value is ID of the node at the specified direction, so same as (*out_id_at_dir) if that pointer is set.}\par
19148 {\cf20 // FIXME-DOCK: We are not exposing nor using split_outer.}\par
19149 ImGuiID ImGui::DockBuilderSplitNode(ImGuiID {\cf18 id}, ImGuiDir split_dir, {\cf18 float} size_ratio_for_node_at_dir, ImGuiID* out_id_at_dir, ImGuiID* out_id_at_opposite_dir)\par
19150 \{\par
