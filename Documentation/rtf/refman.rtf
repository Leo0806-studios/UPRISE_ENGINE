06823     window->DC.NavLayerCurrent = ImGuiNavLayer_Main;\par
06824     g.CurrentItemFlags = item_flags_backup;\par
06825 \par
06826     {\cf20 // Title bar text (with: horizontal alignment, avoiding collapse/close button, optional "unsaved document" marker)}\par
06827     {\cf20 // FIXME: Refactor text alignment facilities along with RenderText helpers, this is WAY too much messy code..}\par
06828     {\cf17 const} {\cf18 float} marker_size_x = (flags & ImGuiWindowFlags_UnsavedDocument) ? button_sz * 0.80f : 0.0f;\par
06829     {\cf17 const} ImVec2 text_size = CalcTextSize(name, NULL, {\cf17 true}) + ImVec2(marker_size_x, 0.0f);\par
06830 \par
06831     {\cf20 // As a nice touch we try to ensure that centered title text doesn't get affected by visibility of Close/Collapse button,}\par
06832     {\cf20 // while uncentered title text will still reach edges correctly.}\par
06833     {\cf19 if} (pad_l > style.FramePadding.x)\par
06834         pad_l += g.Style.ItemInnerSpacing.x;\par
06835     {\cf19 if} (pad_r > style.FramePadding.x)\par
