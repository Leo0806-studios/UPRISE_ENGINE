05914     {\cf20 /*if (name && parent_window->IDStack.back() == parent_window->ID)}\par
05915 {\cf20         ImFormatStringToTempBuffer(&temp_window_name, NULL, "%s/%s", parent_window->Name, name); // May omit ID if in root of ID stack}\par
05916 {\cf20     else*/}\par
