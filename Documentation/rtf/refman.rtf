18237 {\cf17 static} {\cf18 void} ImGui::DockNodePreviewDockRender(ImGuiWindow* host_window, ImGuiDockNode* host_node, ImGuiWindow* root_payload, {\cf17 const} ImGuiDockPreviewData* data)\par
18238 \{\par
18239     ImGuiContext& g = *GImGui;\par
18240     IM_ASSERT(g.CurrentWindow == host_window);   {\cf20 // Because we rely on font size to calculate tab sizes}\par
18241 \par
18242     {\cf20 // With this option, we only display the preview on the target viewport, and the payload viewport is made transparent.}\par
18243     {\cf20 // To compensate for the single layer obstructed by the payload, we'll increase the alpha of the preview nodes.}\par
18244     {\cf17 const} {\cf18 bool} is_transparent_payload = g.IO.ConfigDockingTransparentPayload;\par
18245 \par
18246     {\cf20 // In case the two windows involved are on different viewports, we will draw the overlay on each of them.}\par
18247     {\cf18 int} overlay_draw_lists_count = 0;\par
18248     ImDrawList* overlay_draw_lists[2];\par
18249     overlay_draw_lists[overlay_draw_lists_count++] = GetForegroundDrawList(host_window->Viewport);\par
18250     {\cf19 if} (host_window->Viewport != root_payload->Viewport && !is_transparent_payload)\par
18251         overlay_draw_lists[overlay_draw_lists_count++] = GetForegroundDrawList(root_payload->Viewport);\par
18252 \par
18253     {\cf20 // Draw main preview rectangle}\par
18254     {\cf17 const} ImU32 overlay_col_main = GetColorU32(ImGuiCol_DockingPreview, is_transparent_payload ? 0.60f : 0.40f);\par
18255     {\cf17 const} ImU32 overlay_col_drop = GetColorU32(ImGuiCol_DockingPreview, is_transparent_payload ? 0.90f : 0.70f);\par
18256     {\cf17 const} ImU32 overlay_col_drop_hovered = GetColorU32(ImGuiCol_DockingPreview, is_transparent_payload ? 1.20f : 1.00f);\par
18257     {\cf17 const} ImU32 overlay_col_lines = GetColorU32(ImGuiCol_NavWindowingHighlight, is_transparent_payload ? 0.80f : 0.60f);\par
18258 \par
18259     {\cf20 // Display area preview}\par
18260     {\cf17 const} {\cf18 bool} can_preview_tabs = (root_payload->DockNodeAsHost == NULL || root_payload->DockNodeAsHost->Windows.Size > 0);\par
18261     {\cf19 if} (data->IsDropAllowed)\par
18262     \{\par
18263         ImRect overlay_rect = data->FutureNode.Rect();\par
18264         {\cf19 if} (data->SplitDir == ImGuiDir_None && can_preview_tabs)\par
18265             overlay_rect.Min.y += GetFrameHeight();\par
18266         {\cf19 if} (data->SplitDir != ImGuiDir_None || data->IsCenterAvailable)\par
18267             {\cf19 for} ({\cf18 int} overlay_n = 0; overlay_n < overlay_draw_lists_count; overlay_n++)\par
18268                 overlay_draw_lists[overlay_n]->AddRectFilled(overlay_rect.Min, overlay_rect.Max, overlay_col_main, host_window->WindowRounding, CalcRoundingFlagsForRectInRect(overlay_rect, host_window->Rect(), g.Style.DockingSeparatorSize));\par
18269     \}\par
18270 \par
18271     {\cf20 // Display tab shape/label preview unless we are splitting node (it generally makes the situation harder to read)}\par
18272     {\cf19 if} (data->IsDropAllowed && can_preview_tabs && data->SplitDir == ImGuiDir_None && data->IsCenterAvailable)\par
18273     \{\par
18274         {\cf20 // Compute target tab bar geometry so we can locate our preview tabs}\par
18275         ImRect tab_bar_rect;\par
18276         DockNodeCalcTabBarLayout(&data->FutureNode, NULL, &tab_bar_rect, NULL, NULL);\par
18277         ImVec2 tab_pos = tab_bar_rect.Min;\par
18278         {\cf19 if} (host_node && host_node->TabBar)\par
18279         \{\par
18280             {\cf19 if} (!host_node->IsHiddenTabBar() && !host_node->IsNoTabBar())\par
18281                 tab_pos.x += host_node->TabBar->WidthAllTabs + g.Style.ItemInnerSpacing.x; {\cf20 // We don't use OffsetNewTab because when using non-persistent-order tab bar it is incremented with each Tab submission.}\par
18282             {\cf19 else}\par
18283                 tab_pos.x += g.Style.ItemInnerSpacing.x + TabItemCalcSize(host_node->Windows[0]).x;\par
18284         \}\par
18285         {\cf19 else} {\cf19 if} (!(host_window->Flags & ImGuiWindowFlags_DockNodeHost))\par
18286         \{\par
18287             tab_pos.x += g.Style.ItemInnerSpacing.x + TabItemCalcSize(host_window).x; {\cf20 // Account for slight offset which will be added when changing from title bar to tab bar}\par
18288         \}\par
18289 \par
18290         {\cf20 // Draw tab shape/label preview (payload may be a loose window or a host window carrying multiple tabbed windows)}\par
18291         {\cf19 if} (root_payload->DockNodeAsHost)\par
18292             IM_ASSERT(root_payload->DockNodeAsHost->Windows.Size <= root_payload->DockNodeAsHost->TabBar->Tabs.Size);\par
18293         ImGuiTabBar* tab_bar_with_payload = root_payload->DockNodeAsHost ? root_payload->DockNodeAsHost->TabBar : NULL;\par
18294         {\cf17 const} {\cf18 int} payload_count = tab_bar_with_payload ? tab_bar_with_payload->Tabs.Size : 1;\par
18295         {\cf19 for} ({\cf18 int} payload_n = 0; payload_n < payload_count; payload_n++)\par
18296         \{\par
18297             {\cf20 // DockNode's TabBar may have non-window Tabs manually appended by user}\par
18298             ImGuiWindow* payload_window = tab_bar_with_payload ? tab_bar_with_payload->Tabs[payload_n].Window : root_payload;\par
18299             {\cf19 if} (tab_bar_with_payload && payload_window == NULL)\par
18300                 {\cf19 continue};\par
18301             {\cf19 if} (!DockNodeIsDropAllowedOne(payload_window, host_window))\par
18302                 {\cf19 continue};\par
18303 \par
18304             {\cf20 // Calculate the tab bounding box for each payload window}\par
18305             ImVec2 tab_size = TabItemCalcSize(payload_window);\par
18306             ImRect tab_bb(tab_pos.x, tab_pos.y, tab_pos.x + tab_size.x, tab_pos.y + tab_size.y);\par
18307             tab_pos.x += tab_size.x + g.Style.ItemInnerSpacing.x;\par
18308             {\cf17 const} ImU32 overlay_col_text = GetColorU32(payload_window->DockStyle.Colors[ImGuiWindowDockStyleCol_Text]);\par
18309             {\cf17 const} ImU32 overlay_col_tabs = GetColorU32(payload_window->DockStyle.Colors[ImGuiWindowDockStyleCol_TabSelected]);\par
18310             PushStyleColor(ImGuiCol_Text, overlay_col_text);\par
18311             {\cf19 for} ({\cf18 int} overlay_n = 0; overlay_n < overlay_draw_lists_count; overlay_n++)\par
18312             \{\par
18313                 ImGuiTabItemFlags tab_flags = (payload_window->Flags & ImGuiWindowFlags_UnsavedDocument) ? ImGuiTabItemFlags_UnsavedDocument : 0;\par
18314                 {\cf19 if} (!tab_bar_rect.Contains(tab_bb))\par
18315                     overlay_draw_lists[overlay_n]->PushClipRect(tab_bar_rect.Min, tab_bar_rect.Max);\par
18316                 TabItemBackground(overlay_draw_lists[overlay_n], tab_bb, tab_flags, overlay_col_tabs);\par
18317                 TabItemLabelAndCloseButton(overlay_draw_lists[overlay_n], tab_bb, tab_flags, g.Style.FramePadding, payload_window->Name, 0, 0, {\cf17 false}, NULL, NULL);\par
18318                 {\cf19 if} (!tab_bar_rect.Contains(tab_bb))\par
18319                     overlay_draw_lists[overlay_n]->PopClipRect();\par
18320             \}\par
18321             PopStyleColor();\par
18322         \}\par
18323     \}\par
18324 \par
18325     {\cf20 // Display drop boxes}\par
18326     {\cf17 const} {\cf18 float} overlay_rounding = ImMax(3.0f, g.Style.FrameRounding);\par
18327     {\cf19 for} ({\cf18 int} dir = ImGuiDir_None; dir < ImGuiDir_COUNT; dir++)\par
18328     \{\par
18329         {\cf19 if} (!data->DropRectsDraw[dir + 1].IsInverted())\par
18330         \{\par
18331             ImRect draw_r = data->DropRectsDraw[dir + 1];\par
18332             ImRect draw_r_in = draw_r;\par
18333             draw_r_in.Expand(-2.0f);\par
18334             ImU32 overlay_col = (data->SplitDir == (ImGuiDir)dir && data->IsSplitDirExplicit) ? overlay_col_drop_hovered : overlay_col_drop;\par
18335             {\cf19 for} ({\cf18 int} overlay_n = 0; overlay_n < overlay_draw_lists_count; overlay_n++)\par
18336             \{\par
18337                 ImVec2 center = ImFloor(draw_r_in.GetCenter());\par
18338                 overlay_draw_lists[overlay_n]->AddRectFilled(draw_r.Min, draw_r.Max, overlay_col, overlay_rounding);\par
18339                 overlay_draw_lists[overlay_n]->AddRect(draw_r_in.Min, draw_r_in.Max, overlay_col_lines, overlay_rounding);\par
18340                 {\cf19 if} (dir == ImGuiDir_Left || dir == ImGuiDir_Right)\par
18341                     overlay_draw_lists[overlay_n]->AddLine(ImVec2(center.x, draw_r_in.Min.y), ImVec2(center.x, draw_r_in.Max.y), overlay_col_lines);\par
18342                 {\cf19 if} (dir == ImGuiDir_Up || dir == ImGuiDir_Down)\par
18343                     overlay_draw_lists[overlay_n]->AddLine(ImVec2(draw_r_in.Min.x, center.y), ImVec2(draw_r_in.Max.x, center.y), overlay_col_lines);\par
18344             \}\par
18345         \}\par
18346 \par
18347         {\cf20 // Stop after ImGuiDir_None}\par
18348         {\cf19 if} ((host_node && (host_node->MergedFlags & ImGuiDockNodeFlags_NoDockingSplit)) || g.IO.ConfigDockingNoSplit)\par
18349             {\cf19 return};\par
18350     \}\par
18351 \}\par
