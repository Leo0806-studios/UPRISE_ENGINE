05961 {\cf18 void} ImGui::EndChild()\par
05962 \{\par
05963     ImGuiContext& g = *GImGui;\par
05964     ImGuiWindow* child_window = g.CurrentWindow;\par
05965 \par
05966     IM_ASSERT(g.WithinEndChild == {\cf17 false});\par
05967     IM_ASSERT(child_window->Flags & ImGuiWindowFlags_ChildWindow);   {\cf20 // Mismatched BeginChild()/EndChild() calls}\par
05968 \par
05969     g.WithinEndChild = {\cf17 true};\par
05970     ImVec2 child_size = child_window->Size;\par
05971     End();\par
05972     {\cf19 if} (child_window->BeginCount == 1)\par
05973     \{\par
05974         ImGuiWindow* parent_window = g.CurrentWindow;\par
05975         ImRect bb(parent_window->DC.CursorPos, parent_window->DC.CursorPos + child_size);\par
05976         ItemSize(child_size);\par
05977         {\cf17 const} {\cf18 bool} nav_flattened = (child_window->ChildFlags & ImGuiChildFlags_NavFlattened) != 0;\par
05978         {\cf19 if} ((child_window->DC.NavLayersActiveMask != 0 || child_window->DC.NavWindowHasScrollY) && !nav_flattened)\par
05979         \{\par
05980             ItemAdd(bb, child_window->ChildId);\par
05981             RenderNavHighlight(bb, child_window->ChildId);\par
05982 \par
05983             {\cf20 // When browsing a window that has no activable items (scroll only) we keep a highlight on the child (pass g.NavId to trick into always displaying)}\par
05984             {\cf19 if} (child_window->DC.NavLayersActiveMask == 0 && child_window == g.NavWindow)\par
05985                 RenderNavHighlight(ImRect(bb.Min - ImVec2(2, 2), bb.Max + ImVec2(2, 2)), g.NavId, ImGuiNavHighlightFlags_Compact);\par
05986         \}\par
05987         {\cf19 else}\par
05988         \{\par
05989             {\cf20 // Not navigable into}\par
05990             {\cf20 // - This is a bit of a fringe use case, mostly useful for undecorated, non-scrolling contents childs, or empty childs.}\par
05991             {\cf20 // - We could later decide to not apply this path if ImGuiChildFlags_FrameStyle or ImGuiChildFlags_Borders is set.}\par
05992             ItemAdd(bb, child_window->ChildId, NULL, ImGuiItemFlags_NoNav);\par
