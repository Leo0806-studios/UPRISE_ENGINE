08197 {\cf18 void} ImGui::EndDisabled()\par
08198 \{\par
08199     ImGuiContext& g = *GImGui;\par
08200     IM_ASSERT(g.DisabledStackSize > 0);\par
08201     g.DisabledStackSize--;\par
08202     {\cf18 bool} was_disabled = (g.CurrentItemFlags & ImGuiItemFlags_Disabled) != 0;\par
08203     {\cf20 //PopItemFlag();}\par
08204     g.ItemFlagsStack.pop_back();\par
08205     g.CurrentItemFlags = g.ItemFlagsStack.back();\par
08206     {\cf19 if} (was_disabled && (g.CurrentItemFlags & ImGuiItemFlags_Disabled) == 0)\par
08207         g.Style.Alpha = g.DisabledAlphaBackup; {\cf20 //PopStyleVar();}\par
08208 \}\par
08209 \par
08210 {\cf20 // Could have been called BeginDisabledDisable() but it didn't want to be award nominated for most awkward function name.}\par
08211 {\cf20 // Ideally we would use a shared e.g. BeginDisabled()->BeginDisabledEx() but earlier needs to be optimal.}\par
08212 {\cf20 // The whole code for this is awkward, will reevaluate if we find a way to implement SetNextItemDisabled().}\par
08213 {\cf18 void} ImGui::BeginDisabledOverrideReenable()\par
08214 \{\par
