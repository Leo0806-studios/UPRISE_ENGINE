11378     {\cf17 const} {\cf18 bool} group_contains_curr_active_id = (group_data.BackupActiveIdIsAlive != g.ActiveId) && (g.ActiveIdIsAlive == g.ActiveId) && g.ActiveId;\par
11379     {\cf17 const} {\cf18 bool} group_contains_prev_active_id = (group_data.BackupActiveIdPreviousFrameIsAlive == {\cf17 false}) && (g.ActiveIdPreviousFrameIsAlive == {\cf17 true});\par
11380     {\cf19 if} (group_contains_curr_active_id)\par
11381         g.LastItemData.ID = g.ActiveId;\par
11382     {\cf19 else} {\cf19 if} (group_contains_prev_active_id)\par
11383         g.LastItemData.ID = g.ActiveIdPreviousFrame;\par
11384     g.LastItemData.Rect = group_bb;\par
11385 \par
11386     {\cf20 // Forward Hovered flag}\par
11387     {\cf17 const} {\cf18 bool} group_contains_curr_hovered_id = (group_data.BackupHoveredIdIsAlive == {\cf17 false}) && g.HoveredId != 0;\par
11388     {\cf19 if} (group_contains_curr_hovered_id)\par
11389         g.LastItemData.StatusFlags |= ImGuiItemStatusFlags_HoveredWindow;\par
11390 \par
11391     {\cf20 // Forward Edited flag}\par
11392     {\cf19 if} (group_contains_curr_active_id && g.ActiveIdHasBeenEditedThisFrame)\par
11393         g.LastItemData.StatusFlags |= ImGuiItemStatusFlags_Edited;\par
11394 \par
11395     {\cf20 // Forward Deactivated flag}\par
11396     g.LastItemData.StatusFlags |= ImGuiItemStatusFlags_HasDeactivated;\par
11397     {\cf19 if} (group_contains_prev_active_id && g.ActiveId != g.ActiveIdPreviousFrame)\par
11398         g.LastItemData.StatusFlags |= ImGuiItemStatusFlags_Deactivated;\par
11399 \par
11400     g.GroupStack.pop_back();\par
11401     {\cf19 if} (g.DebugShowGroupRects)\par
11402         window->DrawList->AddRect(group_bb.Min, group_bb.Max, IM_COL32(255,0,255,255));   {\cf20 // [Debug]}\par
11403 \}\par
