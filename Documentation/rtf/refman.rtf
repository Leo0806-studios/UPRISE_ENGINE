21916 {\cf20 // [DEBUG] ID Stack Tool: update queries. Called by NewFrame()}\par
21917 {\cf18 void} ImGui::UpdateDebugToolStackQueries()\par
21918 \{\par
21919     ImGuiContext& g = *GImGui;\par
21920     ImGuiIDStackTool* tool = &g.DebugIDStackTool;\par
21921 \par
21922     {\cf20 // Clear hook when id stack tool is not visible}\par
21923     g.DebugHookIdInfo = 0;\par
21924     {\cf19 if} (g.FrameCount != tool->LastActiveFrame + 1)\par
21925         {\cf19 return};\par
21926 \par
21927     {\cf20 // Update queries. The steps are: -1: query Stack, >= 0: query each stack item}\par
21928     {\cf20 // We can only perform 1 ID Info query every frame. This is designed so the GetID() tests are cheap and constant-time}\par
21929     {\cf17 const} ImGuiID query_id = g.HoveredIdPreviousFrame ? g.HoveredIdPreviousFrame : g.ActiveId;\par
21930     {\cf19 if} (tool->QueryId != query_id)\par
21931     \{\par
21932         tool->QueryId = query_id;\par
21933         tool->StackLevel = -1;\par
21934         tool->Results.resize(0);\par
21935     \}\par
21936     {\cf19 if} (query_id == 0)\par
21937         {\cf19 return};\par
21938 \par
21939     {\cf20 // Advance to next stack level when we got our result, or after 2 frames (in case we never get a result)}\par
21940     {\cf18 int} stack_level = tool->StackLevel;\par
21941     {\cf19 if} (stack_level >= 0 && stack_level < tool->Results.Size)\par
21942         {\cf19 if} (tool->Results[stack_level].QuerySuccess || tool->Results[stack_level].QueryFrameCount > 2)\par
21943             tool->StackLevel++;\par
21944 \par
21945     {\cf20 // Update hook}\par
21946     stack_level = tool->StackLevel;\par
21947     {\cf19 if} (stack_level == -1)\par
21948         g.DebugHookIdInfo = query_id;\par
21949     {\cf19 if} (stack_level >= 0 && stack_level < tool->Results.Size)\par
21950     \{\par
21951         g.DebugHookIdInfo = tool->Results[stack_level].ID;\par
21952         tool->Results[stack_level].QueryFrameCount++;\par
21953     \}\par
21954 \}\par
21955 \par
21956 {\cf20 // [DEBUG] ID Stack tool: hooks called by GetID() family functions}\par
21957 {\cf18 void} ImGui::DebugHookIdInfo(ImGuiID {\cf18 id}, ImGuiDataType data_type, {\cf17 const} {\cf18 void}* data_id, {\cf17 const} {\cf18 void}* data_id_end)\par
21958 \{\par
21959     ImGuiContext& g = *GImGui;\par
21960     ImGuiWindow* window = g.CurrentWindow;\par
21961     ImGuiIDStackTool* tool = &g.DebugIDStackTool;\par
21962 \par
21963     {\cf20 // Step 0: stack query}\par
21964     {\cf20 // This assumes that the ID was computed with the current ID stack, which tends to be the case for our widget.}\par
21965     {\cf19 if} (tool->StackLevel == -1)\par
21966     \{\par
21967         tool->StackLevel++;\par
21968         tool->Results.resize(window->IDStack.Size + 1, ImGuiStackLevelInfo());\par
21969         {\cf19 for} ({\cf18 int} n = 0; n < window->IDStack.Size + 1; n++)\par
21970             tool->Results[n].ID = (n < window->IDStack.Size) ? window->IDStack[n] : id;\par
21971         {\cf19 return};\par
21972     \}\par
21973 \par
21974     {\cf20 // Step 1+: query for individual level}\par
21975     IM_ASSERT(tool->StackLevel >= 0);\par
21976     {\cf19 if} (tool->StackLevel != window->IDStack.Size)\par
21977         {\cf19 return};\par
21978     ImGuiStackLevelInfo* info = &tool->Results[tool->StackLevel];\par
21979     IM_ASSERT(info->ID == {\cf18 id} && info->QueryFrameCount > 0);\par
21980 \par
21981     {\cf19 switch} (data_type)\par
21982     \{\par
21983     {\cf19 case} ImGuiDataType_S32:\par
21984         ImFormatString(info->Desc, IM_ARRAYSIZE(info->Desc), {\cf22 "%d"}, ({\cf18 int})(intptr_t)data_id);\par
21985         {\cf19 break};\par
21986     {\cf19 case} ImGuiDataType_String:\par
21987         ImFormatString(info->Desc, IM_ARRAYSIZE(info->Desc), {\cf22 "%.*s"}, data_id_end ? ({\cf18 int})(({\cf17 const} {\cf18 char}*)data_id_end - ({\cf17 const} {\cf18 char}*)data_id) : (int)strlen((const char*)data_id), (const char*)data_id);\par
21988         {\cf19 break};\par
21989     {\cf19 case} ImGuiDataType_Pointer:\par
21990         ImFormatString(info->Desc, IM_ARRAYSIZE(info->Desc), {\cf22 "(void*)0x%p"}, data_id);\par
21991         {\cf19 break};\par
21992     {\cf19 case} ImGuiDataType_ID:\par
21993         {\cf19 if} (info->Desc[0] != 0) {\cf20 // PushOverrideID() is often used to avoid hashing twice, which would lead to 2 calls to DebugHookIdInfo(). We prioritize the first one.}\par
21994             {\cf19 return};\par
21995         ImFormatString(info->Desc, IM_ARRAYSIZE(info->Desc), {\cf22 "0x%08X [override]"}, {\cf18 id});\par
21996         {\cf19 break};\par
21997     {\cf19 default}:\par
21998         IM_ASSERT(0);\par
21999     \}\par
22000     info->QuerySuccess = {\cf17 true};\par
22001     info->DataType = data_type;\par
22002 \}\par
22003 \par
22004 {\cf17 static} {\cf18 int} StackToolFormatLevelInfo(ImGuiIDStackTool* tool, {\cf18 int} n, {\cf18 bool} format_for_ui, {\cf18 char}* buf, {\cf18 size_t} buf_size)\par
22005 \{\par
22006     ImGuiStackLevelInfo* info = &tool->Results[n];\par
22007     ImGuiWindow* window = (info->Desc[0] == 0 && n == 0) ? ImGui::FindWindowByID(info->ID) : NULL;\par
22008     {\cf19 if} (window)                                                                 {\cf20 // Source: window name (because the root ID don't call GetID() and so doesn't get hooked)}\par
22009         {\cf19 return} ImFormatString(buf, buf_size, format_for_ui ? {\cf22 "\\"%s\\" [window]"} : {\cf22 "%s"}, window->Name);\par
22010     {\cf19 if} (info->QuerySuccess)                                                     {\cf20 // Source: GetID() hooks (prioritize over ItemInfo() because we frequently use patterns like: PushID(str), Button("") where they both have same id)}\par
22011         {\cf19 return} ImFormatString(buf, buf_size, (format_for_ui && info->DataType == ImGuiDataType_String) ? {\cf22 "\\"%s\\""} : {\cf22 "%s"}, info->Desc);\par
22012     {\cf19 if} (tool->StackLevel < tool->Results.Size)                                  {\cf20 // Only start using fallback below when all queries are done, so during queries we don't flickering ??? markers.}\par
22013         {\cf19 return} (*buf = 0);\par
22014 {\cf21 #ifdef IMGUI_ENABLE_TEST_ENGINE}\par
22015     {\cf19 if} ({\cf17 const} {\cf18 char}* label = ImGuiTestEngine_FindItemDebugLabel(GImGui, info->ID))   {\cf20 // Source: ImGuiTestEngine's ItemInfo()}\par
22016         {\cf19 return} ImFormatString(buf, buf_size, format_for_ui ? {\cf22 "??? \\"%s\\""} : {\cf22 "%s"}, label);\par
22017 {\cf21 #endif}\par
22018     {\cf19 return} ImFormatString(buf, buf_size, {\cf22 "???"});\par
22019 \}\par
