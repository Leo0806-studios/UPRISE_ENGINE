08176 {\cf20 // BeginDisabled()/EndDisabled()}\par
08177 {\cf20 // - Those can be nested but it cannot be used to enable an already disabled section (a single BeginDisabled(true) in the stack is enough to keep everything disabled)}\par
08178 {\cf20 // - Visually this is currently altering alpha, but it is expected that in a future styling system this would work differently.}\par
08179 {\cf20 // - Feedback welcome at https://github.com/ocornut/imgui/issues/211}\par
08180 {\cf20 // - BeginDisabled(false) essentially does nothing useful but is provided to facilitate use of boolean expressions. If you can avoid calling BeginDisabled(False)/EndDisabled() best to avoid it.}\par
08181 {\cf20 // - Optimized shortcuts instead of PushStyleVar() + PushItemFlag()}\par
08182 {\cf18 void} ImGui::BeginDisabled({\cf18 bool} disabled)\par
08183 \{\par
08184     ImGuiContext& g = *GImGui;\par
08185     {\cf18 bool} was_disabled = (g.CurrentItemFlags & ImGuiItemFlags_Disabled) != 0;\par
08186     {\cf19 if} (!was_disabled && disabled)\par
08187     \{\par
08188         g.DisabledAlphaBackup = g.Style.Alpha;\par
08189         g.Style.Alpha *= g.Style.DisabledAlpha; {\cf20 // PushStyleVar(ImGuiStyleVar_Alpha, g.Style.Alpha * g.Style.DisabledAlpha);}\par
08190     \}\par
08191     {\cf19 if} (was_disabled || disabled)\par
08192         g.CurrentItemFlags |= ImGuiItemFlags_Disabled;\par
08193     g.ItemFlagsStack.push_back(g.CurrentItemFlags); {\cf20 // FIXME-OPT: can we simply skip this and use DisabledStackSize?}\par
08194     g.DisabledStackSize++;\par
08195 \}\par
