15026 {\cf17 static} {\cf18 bool} ImGui::UpdateTryMergeWindowIntoHostViewport(ImGuiWindow* window, ImGuiViewportP* viewport)\par
15027 \{\par
15028     ImGuiContext& g = *GImGui;\par
15029     {\cf19 if} (window->Viewport == viewport)\par
15030         {\cf19 return} {\cf17 false};\par
15031     {\cf19 if} ((viewport->Flags & ImGuiViewportFlags_CanHostOtherWindows) == 0)\par
15032         {\cf19 return} {\cf17 false};\par
15033     {\cf19 if} ((viewport->Flags & ImGuiViewportFlags_IsMinimized) != 0)\par
15034         {\cf19 return} {\cf17 false};\par
15035     {\cf19 if} (!viewport->GetMainRect().Contains(window->Rect()))\par
15036         {\cf19 return} {\cf17 false};\par
15037     {\cf19 if} (GetWindowAlwaysWantOwnViewport(window))\par
15038         {\cf19 return} {\cf17 false};\par
15039 \par
15040     {\cf20 // FIXME: Can't use g.WindowsFocusOrder[] for root windows only as we care about Z order. If we maintained a DisplayOrder along with FocusOrder we could..}\par
15041     {\cf19 for} (ImGuiWindow* window_behind : g.Windows)\par
15042     \{\par
15043         {\cf19 if} (window_behind == window)\par
15044             {\cf19 break};\par
15045         {\cf19 if} (window_behind->WasActive && window_behind->ViewportOwned && !(window_behind->Flags & ImGuiWindowFlags_ChildWindow))\par
15046             {\cf19 if} (window_behind->Viewport->GetMainRect().Overlaps(window->Rect()))\par
15047                 {\cf19 return} {\cf17 false};\par
15048     \}\par
15049 \par
15050     {\cf20 // Move to the existing viewport, Move child/hosted windows as well (FIXME-OPT: iterate child)}\par
15051     ImGuiViewportP* old_viewport = window->Viewport;\par
15052     {\cf19 if} (window->ViewportOwned)\par
15053         {\cf19 for} ({\cf18 int} n = 0; n < g.Windows.Size; n++)\par
15054             {\cf19 if} (g.Windows[n]->Viewport == old_viewport)\par
15055                 SetWindowViewport(g.Windows[n], viewport);\par
15056     SetWindowViewport(window, viewport);\par
15057     BringWindowToDisplayFront(window);\par
15058 \par
15059     {\cf19 return} {\cf17 true};\par
15060 \}\par
