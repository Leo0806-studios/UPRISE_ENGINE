08367     {\cf17 static} {\cf18 int}   Strnicmp({\cf17 const} {\cf18 char}* s1, {\cf17 const} {\cf18 char}* s2, {\cf18 int} n) \{ {\cf18 int} d = 0; {\cf19 while} (n > 0 && (d = toupper(*s2) - toupper(*s1)) == 0 && *s1) \{ s1++; s2++; n--; \} {\cf19 return} d; \}\par
08368     {\cf17 static} {\cf18 char}* Strdup({\cf17 const} {\cf18 char}* s)                           \{ IM_ASSERT(s); {\cf18 size_t} len = strlen(s) + 1; {\cf18 void}* buf = ImGui::MemAlloc(len); IM_ASSERT(buf); {\cf19 return} ({\cf18 char}*)memcpy(buf, ({\cf17 const} {\cf18 void}*)s, len); \}\par
08369     {\cf17 static} {\cf18 void}  Strtrim({\cf18 char}* s)                                \{ {\cf18 char}* str_end = s + strlen(s); {\cf19 while} (str_end > s && str_end[-1] == {\cf23 ' '}) str_end--; *str_end = 0; \}\par
