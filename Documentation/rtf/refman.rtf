01610         {\cf19 else} {\cf19 if} (key == ImGuiKey_RightSuper)\{ key = ImGuiKey_RightCtrl; \}\par
01611         {\cf19 else} {\cf19 if} (key == ImGuiKey_LeftCtrl)  \{ key = ImGuiKey_LeftSuper; \}\par
