00422 {\cf17 static} {\cf18 void} ImGui_ImplOpenGL3_SetupRenderState(ImDrawData* draw_data, {\cf18 int} fb_width, {\cf18 int} fb_height, GLuint vertex_array_object)\par
00423 \{\par
00424     ImGui_ImplOpenGL3_Data* bd = ImGui_ImplOpenGL3_GetBackendData();\par
00425 \par
00426     {\cf20 // Setup render state: alpha-blending enabled, no face culling, no depth testing, scissor enabled, polygon fill}\par
00427     glEnable(GL_BLEND);\par
00428     glBlendEquation(GL_FUNC_ADD);\par
00429     glBlendFuncSeparate(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA, GL_ONE, GL_ONE_MINUS_SRC_ALPHA);\par
00430     glDisable(GL_CULL_FACE);\par
00431     glDisable(GL_DEPTH_TEST);\par
00432     glDisable(GL_STENCIL_TEST);\par
00433     glEnable(GL_SCISSOR_TEST);\par
00434 {\cf21 #ifdef IMGUI_IMPL_OPENGL_MAY_HAVE_PRIMITIVE_RESTART}\par
00435     {\cf19 if} (bd->GlVersion >= 310)\par
00436         glDisable(GL_PRIMITIVE_RESTART);\par
00437 {\cf21 #endif}\par
00438 {\cf21 #ifdef IMGUI_IMPL_OPENGL_MAY_HAVE_POLYGON_MODE}\par
00439     {\cf19 if} (bd->HasPolygonMode)\par
00440         glPolygonMode(GL_FRONT_AND_BACK, GL_FILL);\par
00441 {\cf21 #endif}\par
00442 \par
00443     {\cf20 // Support for GL 4.5 rarely used glClipControl(GL_UPPER_LEFT)}\par
00444 {\cf21 #if defined(GL_CLIP_ORIGIN)}\par
00445     {\cf18 bool} clip_origin_lower_left = {\cf17 true};\par
00446     {\cf19 if} (bd->HasClipOrigin)\par
00447     \{\par
00448         GLenum current_clip_origin = 0; glGetIntegerv(GL_CLIP_ORIGIN, (GLint*)&current_clip_origin);\par
00449         {\cf19 if} (current_clip_origin == GL_UPPER_LEFT)\par
00450             clip_origin_lower_left = {\cf17 false};\par
00451     \}\par
00452 {\cf21 #endif}\par
00453 \par
00454     {\cf20 // Setup viewport, orthographic projection matrix}\par
00455     {\cf20 // Our visible imgui space lies from draw_data->DisplayPos (top left) to draw_data->DisplayPos+data_data->DisplaySize (bottom right). DisplayPos is (0,0) for single viewport apps.}\par
00456     GL_CALL(glViewport(0, 0, (GLsizei)fb_width, (GLsizei)fb_height));\par
00457     {\cf18 float} L = draw_data->DisplayPos.x;\par
