19863             \{\par
19864                 buf->appendf({\cf22 "%*s"}, ImMax(2, (line_start_pos + 92) - buf->size()), {\cf22 ""});     {\cf20 // Align everything}\par
19865                 {\cf19 if} (node->IsDockSpace() && node->HostWindow && node->HostWindow->ParentWindow)\par
19866                     buf->appendf({\cf22 " ; in '%s'"}, node->HostWindow->ParentWindow->Name);\par
