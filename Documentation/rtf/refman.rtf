19419 {\cf18 void} ImGui::BeginDocked(ImGuiWindow* window, {\cf18 bool}* p_open)\par
19420 \{\par
19421     ImGuiContext& g = *GImGui;\par
19422 \par
19423     {\cf20 // Clear fields ahead so most early-out paths don't have to do it}\par
19424     window->DockIsActive = window->DockNodeIsVisible = window->DockTabIsVisible = {\cf17 false};\par
19425 \par
19426     {\cf17 const} {\cf18 bool} auto_dock_node = GetWindowAlwaysWantOwnTabBar(window);\par
19427     {\cf19 if} (auto_dock_node)\par
19428     \{\par
19429         {\cf19 if} (window->DockId == 0)\par
19430         \{\par
19431             IM_ASSERT(window->DockNode == NULL);\par
19432             window->DockId = DockContextGenNodeID(&g);\par
19433         \}\par
19434     \}\par
19435     {\cf19 else}\par
19436     \{\par
19437         {\cf20 // Calling SetNextWindowPos() undock windows by default (by setting PosUndock)}\par
19438         {\cf18 bool} want_undock = {\cf17 false};\par
19439         want_undock |= (window->Flags & ImGuiWindowFlags_NoDocking) != 0;\par
19440         want_undock |= (g.NextWindowData.Flags & ImGuiNextWindowDataFlags_HasPos) && (window->SetWindowPosAllowFlags & g.NextWindowData.PosCond) && g.NextWindowData.PosUndock;\par
19441         {\cf19 if} (want_undock)\par
19442         \{\par
19443             DockContextProcessUndockWindow(&g, window);\par
19444             {\cf19 return};\par
19445         \}\par
19446     \}\par
19447 \par
19448     {\cf20 // Bind to our dock node}\par
19449     ImGuiDockNode* node = window->DockNode;\par
19450     {\cf19 if} (node != NULL)\par
19451         IM_ASSERT(window->DockId == node->ID);\par
19452     {\cf19 if} (window->DockId != 0 && node == NULL)\par
19453     \{\par
19454         node = DockContextBindNodeToWindow(&g, window);\par
19455         {\cf19 if} (node == NULL)\par
19456             {\cf19 return};\par
19457     \}\par
19458 \par
19459 {\cf21 #if 0}\par
19460     {\cf20 // Undock if the ImGuiDockNodeFlags_NoDockingInCentralNode got set}\par
19461     {\cf19 if} (node->IsCentralNode && (node->Flags & ImGuiDockNodeFlags_NoDockingInCentralNode))\par
19462     \{\par
19463         DockContextProcessUndockWindow(ctx, window);\par
19464         {\cf19 return};\par
19465     \}\par
19466 {\cf21 #endif}\par
19467 \par
19468     {\cf20 // Undock if our dockspace node disappeared}\par
19469     {\cf20 // Note how we are testing for LastFrameAlive and NOT LastFrameActive. A DockSpace node can be maintained alive while being inactive with ImGuiDockNodeFlags_KeepAliveOnly.}\par
19470     {\cf19 if} (node->LastFrameAlive < g.FrameCount)\par
19471     \{\par
19472         {\cf20 // If the window has been orphaned, transition the docknode to an implicit node processed in DockContextNewFrameUpdateDocking()}\par
19473         ImGuiDockNode* root_node = DockNodeGetRootNode(node);\par
19474         {\cf19 if} (root_node->LastFrameAlive < g.FrameCount)\par
19475             DockContextProcessUndockWindow(&g, window);\par
19476         {\cf19 else}\par
19477             window->DockIsActive = {\cf17 true};\par
19478         {\cf19 return};\par
19479     \}\par
19480 \par
19481     {\cf20 // Store style overrides}\par
19482     StoreDockStyleForWindow(window);\par
19483 \par
19484     {\cf20 // Fast path return. It is common for windows to hold on a persistent DockId but be the only visible window,}\par
19485     {\cf20 // and never create neither a host window neither a tab bar.}\par
19486     {\cf20 // FIXME-DOCK: replace ->HostWindow NULL compare with something more explicit (~was initially intended as a first frame test)}\par
19487     {\cf19 if} (node->HostWindow == NULL)\par
19488     \{\par
19489         {\cf19 if} (node->State == ImGuiDockNodeState_HostWindowHiddenBecauseWindowsAreResizing)\par
19490             window->DockIsActive = {\cf17 true};\par
19491         {\cf19 if} (node->Windows.Size > 1 && window->Appearing) {\cf20 // Only hide appearing window}\par
19492             DockNodeHideWindowDuringHostWindowCreation(window);\par
19493         {\cf19 return};\par
19494     \}\par
19495 \par
19496     {\cf20 // We can have zero-sized nodes (e.g. children of a small-size dockspace)}\par
19497     IM_ASSERT(node->HostWindow);\par
19498     IM_ASSERT(node->IsLeafNode());\par
19499     IM_ASSERT(node->Size.x >= 0.0f && node->Size.y >= 0.0f);\par
19500     node->State = ImGuiDockNodeState_HostWindowVisible;\par
19501 \par
19502     {\cf20 // Undock if we are submitted earlier than the host window}\par
19503     {\cf19 if} (!(node->MergedFlags & ImGuiDockNodeFlags_KeepAliveOnly) && window->BeginOrderWithinContext < node->HostWindow->BeginOrderWithinContext)\par
19504     \{\par
19505         DockContextProcessUndockWindow(&g, window);\par
19506         {\cf19 return};\par
19507     \}\par
19508 \par
19509     {\cf20 // Position/Size window}\par
19510     SetNextWindowPos(node->Pos);\par
19511     SetNextWindowSize(node->Size);\par
19512     g.NextWindowData.PosUndock = {\cf17 false}; {\cf20 // Cancel implicit undocking of SetNextWindowPos()}\par
19513     window->DockIsActive = {\cf17 true};\par
19514     window->DockNodeIsVisible = {\cf17 true};\par
19515     window->DockTabIsVisible = {\cf17 false};\par
19516     {\cf19 if} (node->MergedFlags & ImGuiDockNodeFlags_KeepAliveOnly)\par
19517         {\cf19 return};\par
19518 \par
19519     {\cf20 // When the window is selected we mark it as visible.}\par
19520     {\cf19 if} (node->VisibleWindow == window)\par
19521         window->DockTabIsVisible = {\cf17 true};\par
19522 \par
19523     {\cf20 // Update window flag}\par
19524     IM_ASSERT((window->Flags & ImGuiWindowFlags_ChildWindow) == 0);\par
19525     window->Flags |= ImGuiWindowFlags_ChildWindow | ImGuiWindowFlags_NoResize;\par
19526     window->ChildFlags |= ImGuiChildFlags_AlwaysUseWindowPadding;\par
19527     {\cf19 if} (node->IsHiddenTabBar() || node->IsNoTabBar())\par
19528         window->Flags |= ImGuiWindowFlags_NoTitleBar;\par
19529     {\cf19 else}\par
19530         window->Flags &= ~ImGuiWindowFlags_NoTitleBar;      {\cf20 // Clear the NoTitleBar flag in case the user set it: confusingly enough we need a title bar height so we are correctly offset, but it won't be displayed!}\par
19531 \par
19532     {\cf20 // Save new dock order only if the window has been visible once already}\par
19533     {\cf20 // This allows multiple windows to be created in the same frame and have their respective dock orders preserved.}\par
19534     {\cf19 if} (node->TabBar && window->WasActive)\par
19535         window->DockOrder = (short)DockNodeGetTabOrder(window);\par
19536 \par
19537     {\cf19 if} ((node->WantCloseAll || node->WantCloseTabId == window->TabId) && p_open != NULL)\par
19538         *p_open = {\cf17 false};\par
19539 \par
19540     {\cf20 // Update ChildId to allow returning from Child to Parent with Escape}\par
19541     ImGuiWindow* parent_window = window->DockNode->HostWindow;\par
19542     window->ChildId = parent_window->GetID(window->Name);\par
19543 \}\par
