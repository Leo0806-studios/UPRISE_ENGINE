06774 {\cf20 // Render title text, collapse button, close button}\par
06775 {\cf18 void} ImGui::RenderWindowTitleBarContents(ImGuiWindow* window, {\cf17 const} ImRect& title_bar_rect, {\cf17 const} {\cf18 char}* name, {\cf18 bool}* p_open)\par
06776 \{\par
06777     ImGuiContext& g = *GImGui;\par
06778     ImGuiStyle& style = g.Style;\par
06779     ImGuiWindowFlags flags = window->Flags;\par
06780 \par
06781     {\cf17 const} {\cf18 bool} has_close_button = (p_open != NULL);\par
06782     {\cf17 const} {\cf18 bool} has_collapse_button = !(flags & ImGuiWindowFlags_NoCollapse) && (style.WindowMenuButtonPosition != ImGuiDir_None);\par
06783 \par
06784     {\cf20 // Close & Collapse button are on the Menu NavLayer and don't default focus (unless there's nothing else on that layer)}\par
06785     {\cf20 // FIXME-NAV: Might want (or not?) to set the equivalent of ImGuiButtonFlags_NoNavFocus so that mouse clicks on standard title bar items don't necessarily set nav/keyboard ref?}\par
06786     {\cf17 const} ImGuiItemFlags item_flags_backup = g.CurrentItemFlags;\par
06787     g.CurrentItemFlags |= ImGuiItemFlags_NoNavDefaultFocus;\par
06788     window->DC.NavLayerCurrent = ImGuiNavLayer_Menu;\par
06789 \par
06790     {\cf20 // Layout buttons}\par
06791     {\cf20 // FIXME: Would be nice to generalize the subtleties expressed here into reusable code.}\par
06792     {\cf18 float} pad_l = style.FramePadding.x;\par
06793     {\cf18 float} pad_r = style.FramePadding.x;\par
06794     {\cf18 float} button_sz = g.FontSize;\par
06795     ImVec2 close_button_pos;\par
06796     ImVec2 collapse_button_pos;\par
06797     {\cf19 if} (has_close_button)\par
06798     \{\par
06799         close_button_pos = ImVec2(title_bar_rect.Max.x - pad_r - button_sz, title_bar_rect.Min.y + style.FramePadding.y);\par
06800         pad_r += button_sz + style.ItemInnerSpacing.x;\par
06801     \}\par
06802     {\cf19 if} (has_collapse_button && style.WindowMenuButtonPosition == ImGuiDir_Right)\par
06803     \{\par
06804         collapse_button_pos = ImVec2(title_bar_rect.Max.x - pad_r - button_sz, title_bar_rect.Min.y + style.FramePadding.y);\par
06805         pad_r += button_sz + style.ItemInnerSpacing.x;\par
06806     \}\par
06807     {\cf19 if} (has_collapse_button && style.WindowMenuButtonPosition == ImGuiDir_Left)\par
06808     \{\par
06809         collapse_button_pos = ImVec2(title_bar_rect.Min.x + pad_l, title_bar_rect.Min.y + style.FramePadding.y);\par
06810         pad_l += button_sz + style.ItemInnerSpacing.x;\par
