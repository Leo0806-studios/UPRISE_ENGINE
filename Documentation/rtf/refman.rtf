09812 {\cf17 static} {\cf18 void} ImGui::UpdateKeyboardInputs()\par
09813 \{\par
09814     ImGuiContext& g = *GImGui;\par
09815     ImGuiIO& io = g.IO;\par
09816 \par
09817     {\cf19 if} (io.ConfigFlags & ImGuiConfigFlags_NoKeyboard)\par
09818         io.ClearInputKeys();\par
09819 \par
09820     {\cf20 // Import legacy keys or verify they are not used}\par
09821 {\cf21 #ifndef IMGUI_DISABLE_OBSOLETE_KEYIO}\par
09822     {\cf19 if} (io.BackendUsingLegacyKeyArrays == 0)\par
09823     \{\par
09824         {\cf20 // Backend used new io.AddKeyEvent() API: Good! Verify that old arrays are never written to externally.}\par
09825         {\cf19 for} ({\cf18 int} n = 0; n < ImGuiKey_LegacyNativeKey_END; n++)\par
09826             IM_ASSERT((io.KeysDown[n] == {\cf17 false} || IsKeyDown((ImGuiKey)n)) && {\cf22 "Backend needs to either only use io.AddKeyEvent(), either only fill legacy io.KeysDown[] + io.KeyMap[]. Not both!"});\par
09827     \}\par
09828     {\cf19 else}\par
09829     \{\par
09830         {\cf19 if} (g.FrameCount == 0)\par
09831             {\cf19 for} ({\cf18 int} n = ImGuiKey_LegacyNativeKey_BEGIN; n < ImGuiKey_LegacyNativeKey_END; n++)\par
09832                 IM_ASSERT(g.IO.KeyMap[n] == -1 && {\cf22 "Backend is not allowed to write to io.KeyMap[0..511]!"});\par
09833 \par
09834         {\cf20 // Build reverse KeyMap (Named -> Legacy)}\par
09835         {\cf19 for} ({\cf18 int} n = ImGuiKey_NamedKey_BEGIN; n < ImGuiKey_NamedKey_END; n++)\par
09836             {\cf19 if} (io.KeyMap[n] != -1)\par
09837             \{\par
09838                 IM_ASSERT(IsLegacyKey((ImGuiKey)io.KeyMap[n]));\par
09839                 io.KeyMap[io.KeyMap[n]] = n;\par
09840             \}\par
09841 \par
09842         {\cf20 // Import legacy keys into new ones}\par
09843         {\cf19 for} ({\cf18 int} n = ImGuiKey_LegacyNativeKey_BEGIN; n < ImGuiKey_LegacyNativeKey_END; n++)\par
09844             {\cf19 if} (io.KeysDown[n] || io.BackendUsingLegacyKeyArrays == 1)\par
09845             \{\par
09846                 {\cf17 const} ImGuiKey key = (ImGuiKey)(io.KeyMap[n] != -1 ? io.KeyMap[n] : n);\par
09847                 IM_ASSERT(io.KeyMap[n] == -1 || IsNamedKey(key));\par
09848                 io.KeysData[key].Down = io.KeysDown[n];\par
09849                 {\cf19 if} (key != n)\par
09850                     io.KeysDown[key] = io.KeysDown[n]; {\cf20 // Allow legacy code using io.KeysDown[GetKeyIndex()] with old backends}\par
09851                 io.BackendUsingLegacyKeyArrays = 1;\par
09852             \}\par
09853         {\cf19 if} (io.BackendUsingLegacyKeyArrays == 1)\par
09854         \{\par
09855             GetKeyData(ImGuiMod_Ctrl)->Down = io.KeyCtrl;\par
09856             GetKeyData(ImGuiMod_Shift)->Down = io.KeyShift;\par
09857             GetKeyData(ImGuiMod_Alt)->Down = io.KeyAlt;\par
09858             GetKeyData(ImGuiMod_Super)->Down = io.KeySuper;\par
09859         \}\par
09860     \}\par
09861 {\cf21 #endif}\par
09862 \par
09863     {\cf20 // Import legacy ImGuiNavInput_ io inputs and convert to gamepad keys}\par
09864 {\cf21 #ifndef IMGUI_DISABLE_OBSOLETE_KEYIO}\par
09865     {\cf17 const} {\cf18 bool} nav_gamepad_active = (io.ConfigFlags & ImGuiConfigFlags_NavEnableGamepad) != 0 && (io.BackendFlags & ImGuiBackendFlags_HasGamepad) != 0;\par
09866     {\cf19 if} (io.BackendUsingLegacyNavInputArray && nav_gamepad_active)\par
09867     \{\par
09868 {\cf21         #define MAP_LEGACY_NAV_INPUT_TO_KEY1(_KEY, _NAV1)           do \{ io.KeysData[_KEY].Down = (io.NavInputs[_NAV1] > 0.0f); io.KeysData[_KEY].AnalogValue = io.NavInputs[_NAV1]; \} while (0)}\par
09869 {\cf21         #define MAP_LEGACY_NAV_INPUT_TO_KEY2(_KEY, _NAV1, _NAV2)    do \{ io.KeysData[_KEY].Down = (io.NavInputs[_NAV1] > 0.0f) || (io.NavInputs[_NAV2] > 0.0f); io.KeysData[_KEY].AnalogValue = ImMax(io.NavInputs[_NAV1], io.NavInputs[_NAV2]); \} while (0)}\par
09870         MAP_LEGACY_NAV_INPUT_TO_KEY1(ImGuiKey_GamepadFaceDown, ImGuiNavInput_Activate);\par
09871         MAP_LEGACY_NAV_INPUT_TO_KEY1(ImGuiKey_GamepadFaceRight, ImGuiNavInput_Cancel);\par
09872         MAP_LEGACY_NAV_INPUT_TO_KEY1(ImGuiKey_GamepadFaceLeft, ImGuiNavInput_Menu);\par
09873         MAP_LEGACY_NAV_INPUT_TO_KEY1(ImGuiKey_GamepadFaceUp, ImGuiNavInput_Input);\par
