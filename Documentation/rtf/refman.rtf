02775 {\cf18 void} ImGuiTextFilter::ImGuiTextRange::split({\cf18 char} separator, ImVector<ImGuiTextRange>* out){\cf17  const}\par
02776 {\cf17 }\{\par
02777     out->resize(0);\par
02778     {\cf17 const} {\cf18 char}* wb = b;\par
02779     {\cf17 const} {\cf18 char}* we = wb;\par
02780     {\cf19 while} (we < e)\par
02781     \{\par
02782         {\cf19 if} (*we == separator)\par
02783         \{\par
02784             out->push_back(ImGuiTextRange(wb, we));\par
02785             wb = we + 1;\par
02786         \}\par
