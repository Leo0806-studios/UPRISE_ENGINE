20254 {\cf20 // Helper tool to diagnose between text encoding issues and font loading issues. Pass your UTF-8 string and verify that there are correct.}\par
20255 {\cf18 void} ImGui::DebugTextEncoding({\cf17 const} {\cf18 char}* str)\par
20256 \{\par
20257     Text({\cf22 "Text: \\"%s\\""}, str);\par
20258     {\cf19 if} (!BeginTable({\cf22 "##DebugTextEncoding"}, 4, ImGuiTableFlags_Borders | ImGuiTableFlags_RowBg | ImGuiTableFlags_SizingFixedFit | ImGuiTableFlags_Resizable))\par
20259         {\cf19 return};\par
20260     TableSetupColumn({\cf22 "Offset"});\par
20261     TableSetupColumn({\cf22 "UTF-8"});\par
20262     TableSetupColumn({\cf22 "Glyph"});\par
20263     TableSetupColumn({\cf22 "Codepoint"});\par
20264     TableHeadersRow();\par
20265     {\cf19 for} ({\cf17 const} {\cf18 char}* p = str; *p != 0; )\par
20266     \{\par
20267         {\cf18 unsigned} {\cf18 int} c;\par
20268         {\cf17 const} {\cf18 int} c_utf8_len = ImTextCharFromUtf8(&c, p, NULL);\par
20269         TableNextColumn();\par
20270         Text({\cf22 "%d"}, ({\cf18 int})(p - str));\par
20271         TableNextColumn();\par
20272         {\cf19 for} ({\cf18 int} byte_index = 0; byte_index < c_utf8_len; byte_index++)\par
20273         \{\par
20274             {\cf19 if} (byte_index > 0)\par
20275                 SameLine();\par
20276             Text({\cf22 "0x%02X"}, ({\cf18 int})({\cf18 unsigned} {\cf18 char})p[byte_index]);\par
20277         \}\par
20278         TableNextColumn();\par
20279         {\cf19 if} (GetFont()->FindGlyphNoFallback((ImWchar)c))\par
20280             TextUnformatted(p, p + c_utf8_len);\par
20281         {\cf19 else}\par
20282             TextUnformatted((c == IM_UNICODE_CODEPOINT_INVALID) ? {\cf22 "[invalid]"} : {\cf22 "[missing]"});\par
20283         TableNextColumn();\par
20284         Text({\cf22 "U+%04X"}, ({\cf18 int})c);\par
20285         p += c_utf8_len;\par
20286     \}\par
20287     EndTable();\par
20288 \}\par
