00893 \par
00894     {\cf20 // [Part 3] Fix column flags and record a few extra information.}\par
00895     {\cf18 float} sum_width_requests = 0.0f;    {\cf20 // Sum of all width for fixed and auto-resize columns, excluding width contributed by Stretch columns but including spacing/padding.}\par
