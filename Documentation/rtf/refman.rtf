00652 \par
00653     {\cf20 // Process while held}\par
00654     {\cf18 bool} held = {\cf17 false};\par
00655     {\cf19 if} (g.ActiveId == {\cf18 id})\par
00656     \{\par
00657         {\cf19 if} (g.ActiveIdSource == ImGuiInputSource_Mouse)\par
00658         \{\par
