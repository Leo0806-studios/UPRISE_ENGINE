00773 {\cf20 // Layout columns for the frame. This is in essence the followup to BeginTable() and this is our largest function.}\par
00774 {\cf20 // Runs on the first call to TableNextRow(), to give a chance for TableSetupColumn() and other TableSetupXXXXX() functions to be called first.}\par
00775 {\cf20 // FIXME-TABLE: Our width (and therefore our WorkRect) will be minimal in the first frame for _WidthAuto columns.}\par
00776 {\cf20 // Increase feedback side-effect with widgets relying on WorkRect.Max.x... Maybe provide a default distribution for _WidthAuto columns?}\par
00777 {\cf18 void} ImGui::TableUpdateLayout(ImGuiTable* table)\par
00778 \{\par
00779     ImGuiContext& g = *GImGui;\par
00780     IM_ASSERT(table->IsLayoutLocked == {\cf17 false});\par
00781 \par
00782     {\cf17 const} ImGuiTableFlags table_sizing_policy = (table->Flags & ImGuiTableFlags_SizingMask_);\par
