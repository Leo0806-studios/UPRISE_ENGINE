04005 {\cf20 // Note: as with every ImDrawList drawing function, this expects that the font atlas texture is bound.}\par
04006 {\cf18 void} ImFont::RenderChar(ImDrawList* draw_list, {\cf18 float} size, {\cf17 const} ImVec2& pos, ImU32 col, ImWchar c){\cf17  const}\par
04007 {\cf17 }\{\par
04008     {\cf17 const} ImFontGlyph* glyph = FindGlyph(c);\par
04009     {\cf19 if} (!glyph || !glyph->Visible)\par
04010         {\cf19 return};\par
04011     {\cf19 if} (glyph->Colored)\par
04012         col |= ~IM_COL32_A_MASK;\par
04013     {\cf18 float} scale = (size >= 0.0f) ? (size / FontSize) : 1.0f;\par
04014     {\cf18 float} x = IM_TRUNC(pos.x);\par
04015     {\cf18 float} y = IM_TRUNC(pos.y);\par
04016     draw_list->PrimReserve(6, 4);\par
04017     draw_list->PrimRectUV(ImVec2(x + glyph->X0 * scale, y + glyph->Y0 * scale), ImVec2(x + glyph->X1 * scale, y + glyph->Y1 * scale), ImVec2(glyph->U0, glyph->V0), ImVec2(glyph->U1, glyph->V1), col);\par
04018 \}\par
