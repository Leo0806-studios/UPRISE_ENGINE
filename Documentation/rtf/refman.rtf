02813 {\cf18 bool} ImGuiTextFilter::PassFilter({\cf17 const} {\cf18 char}* text, {\cf17 const} {\cf18 char}* text_end){\cf17  const}\par
02814 {\cf17 }\{\par
02815     {\cf19 if} (Filters.Size == 0)\par
02816         {\cf19 return} {\cf17 true};\par
02817 \par
02818     {\cf19 if} (text == NULL)\par
02819         text = text_end = {\cf22 ""};\par
02820 \par
02821     {\cf19 for} ({\cf17 const} ImGuiTextRange& f : Filters)\par
02822     \{\par
02823         {\cf19 if} (f.b == f.e)\par
02824             {\cf19 continue};\par
02825         {\cf19 if} (f.b[0] == {\cf23 '-'})\par
02826         \{\par
02827             {\cf20 // Subtract}\par
02828             {\cf19 if} (ImStristr(text, text_end, f.b + 1, f.e) != NULL)\par
02829                 {\cf19 return} {\cf17 false};\par
02830         \}\par
02831         {\cf19 else}\par
02832         \{\par
02833             {\cf20 // Grep}\par
02834             {\cf19 if} (ImStristr(text, text_end, f.b, f.e) != NULL)\par
02835                 {\cf19 return} {\cf17 true};\par
02836         \}\par
02837     \}\par
02838 \par
02839     {\cf20 // Implicit * grep}\par
02840     {\cf19 if} (CountGrep == 0)\par
02841         {\cf19 return} {\cf17 true};\par
02842 \par
02843     {\cf19 return} {\cf17 false};\par
02844 \}\par
