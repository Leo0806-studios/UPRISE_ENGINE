19112 {\cf18 void} ImGui::DockBuilderRemoveNodeDockedWindows(ImGuiID root_id, {\cf18 bool} clear_settings_refs)\par
19113 \{\par
19114     {\cf20 // Clear references in settings}\par
19115     ImGuiContext& g = *GImGui;\par
19116     {\cf19 if} (clear_settings_refs)\par
19117     \{\par
19118         {\cf19 for} (ImGuiWindowSettings* settings = g.SettingsWindows.begin(); settings != NULL; settings = g.SettingsWindows.next_chunk(settings))\par
19119         \{\par
19120             {\cf18 bool} want_removal = (root_id == 0) || (settings->DockId == root_id);\par
19121             {\cf19 if} (!want_removal && settings->DockId != 0)\par
19122                 {\cf19 if} (ImGuiDockNode* node = DockContextFindNodeByID(&g, settings->DockId))\par
19123                     {\cf19 if} (DockNodeGetRootNode(node)->ID == root_id)\par
19124                         want_removal = {\cf17 true};\par
19125             {\cf19 if} (want_removal)\par
19126                 settings->DockId = 0;\par
19127         \}\par
19128     \}\par
19129 \par
19130     {\cf20 // Clear references in windows}\par
19131     {\cf19 for} ({\cf18 int} n = 0; n < g.Windows.Size; n++)\par
19132     \{\par
19133         ImGuiWindow* window = g.Windows[n];\par
19134         {\cf18 bool} want_removal = (root_id == 0) || (window->DockNode && DockNodeGetRootNode(window->DockNode)->ID == root_id) || (window->DockNodeAsHost && window->DockNodeAsHost->ID == root_id);\par
19135         {\cf19 if} (want_removal)\par
19136         \{\par
19137             {\cf17 const} ImGuiID backup_dock_id = window->DockId;\par
19138             IM_UNUSED(backup_dock_id);\par
19139             DockContextProcessUndockWindow(&g, window, clear_settings_refs);\par
19140             {\cf19 if} (!clear_settings_refs)\par
19141                 IM_ASSERT(window->DockId == backup_dock_id);\par
19142         \}\par
19143     \}\par
19144 \}\par
