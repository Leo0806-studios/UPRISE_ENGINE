13754 \par
13755     {\cf20 // Keyboard: Press and Release ALT to toggle menu layer}\par
13756     {\cf17 const} ImGuiKey windowing_toggle_keys[] = \{ ImGuiKey_LeftAlt, ImGuiKey_RightAlt \};\par
