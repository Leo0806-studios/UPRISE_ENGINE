16253 {\cf20 // Docking context update function, called by NewFrame()}\par
16254 {\cf18 void} ImGui::DockContextNewFrameUpdateDocking(ImGuiContext* ctx)\par
16255 \{\par
16256     ImGuiContext& g = *ctx;\par
16257     ImGuiDockContext* dc = &ctx->DockContext;\par
16258     {\cf19 if} (!(g.IO.ConfigFlags & ImGuiConfigFlags_DockingEnable))\par
16259         {\cf19 return};\par
16260 \par
16261     {\cf20 // [DEBUG] Store hovered dock node.}\par
16262     {\cf20 // We could in theory use DockNodeTreeFindVisibleNodeByPos() on the root host dock node, but using ->DockNode is a good shortcut.}\par
16263     {\cf20 // Note this is mostly a debug thing and isn't actually used for docking target, because docking involve more detailed filtering.}\par
16264     g.DebugHoveredDockNode = NULL;\par
16265     {\cf19 if} (ImGuiWindow* hovered_window = g.HoveredWindowUnderMovingWindow)\par
16266     \{\par
16267         {\cf19 if} (hovered_window->DockNodeAsHost)\par
16268             g.DebugHoveredDockNode = DockNodeTreeFindVisibleNodeByPos(hovered_window->DockNodeAsHost, g.IO.MousePos);\par
