08081 {\cf18 void} ImGui::FocusTopMostWindowUnderOne(ImGuiWindow* under_this_window, ImGuiWindow* ignore_window, ImGuiViewport* filter_viewport, ImGuiFocusRequestFlags flags)\par
08082 \{\par
08083     ImGuiContext& g = *GImGui;\par
08084     {\cf18 int} start_idx = g.WindowsFocusOrder.Size - 1;\par
08085     {\cf19 if} (under_this_window != NULL)\par
08086     \{\par
08087         {\cf20 // Aim at root window behind us, if we are in a child window that's our own root (see #4640)}\par
08088         {\cf18 int} offset = -1;\par
08089         {\cf19 while} (under_this_window->Flags & ImGuiWindowFlags_ChildWindow)\par
08090         \{\par
08091             under_this_window = under_this_window->ParentWindow;\par
08092             offset = 0;\par
08093         \}\par
08094         start_idx = FindWindowFocusIndex(under_this_window) + offset;\par
08095     \}\par
08096     {\cf19 for} ({\cf18 int} i = start_idx; i >= 0; i--)\par
08097     \{\par
08098         {\cf20 // We may later decide to test for different NoXXXInputs based on the active navigation input (mouse vs nav) but that may feel more confusing to the user.}\par
08099         ImGuiWindow* window = g.WindowsFocusOrder[i];\par
08100         {\cf19 if} (window == ignore_window || !window->WasActive)\par
08101             {\cf19 continue};\par
08102         {\cf19 if} (filter_viewport != NULL && window->Viewport != filter_viewport)\par
08103             {\cf19 continue};\par
08104         {\cf19 if} ((window->Flags & (ImGuiWindowFlags_NoMouseInputs | ImGuiWindowFlags_NoNavInputs)) != (ImGuiWindowFlags_NoMouseInputs | ImGuiWindowFlags_NoNavInputs))\par
08105         \{\par
08106             {\cf20 // FIXME-DOCK: When ImGuiFocusRequestFlags_RestoreFocusedChild is set...}\par
08107             {\cf20 // This is failing (lagging by one frame) for docked windows.}\par
08108             {\cf20 // If A and B are docked into window and B disappear, at the NewFrame() call site window->NavLastChildNavWindow will still point to B.}\par
08109             {\cf20 // We might leverage the tab order implicitly stored in window->DockNodeAsHost->TabBar (essentially the 'most_recently_selected_tab' code in tab bar will do that but on next update)}\par
08110             {\cf20 // to tell which is the "previous" window. Or we may leverage 'LastFrameFocused/LastFrameJustFocused' and have this function handle child window itself?}\par
08111             FocusWindow(window, flags);\par
08112             {\cf19 return};\par
08113         \}\par
08114     \}\par
08115     FocusWindow(NULL, flags);\par
08116 \}\par
