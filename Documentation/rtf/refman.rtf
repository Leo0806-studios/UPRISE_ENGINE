16196 {\cf20 // [DEBUG] This function also acts as a defacto test to make sure we can rebuild from scratch without a glitch}\par
16197 {\cf20 // (Different from DockSettingsHandler_ClearAll() + DockSettingsHandler_ApplyAll() because this reuses current settings!)}\par
16198 {\cf18 void} ImGui::DockContextRebuildNodes(ImGuiContext* ctx)\par
16199 \{\par
16200     ImGuiContext& g = *ctx;\par
16201     ImGuiDockContext* dc = &ctx->DockContext;\par
16202     IMGUI_DEBUG_LOG_DOCKING({\cf22 "[docking] DockContextRebuildNodes\\n"});\par
16203     SaveIniSettingsToMemory();\par
16204     ImGuiID root_id = 0; {\cf20 // Rebuild all}\par
16205     DockContextClearNodes(ctx, root_id, {\cf17 false});\par
16206     DockContextBuildNodesFromSettings(ctx, dc->NodesSettings.Data, dc->NodesSettings.Size);\par
16207     DockContextBuildAddWindowsToNodes(ctx, root_id);\par
16208 \}\par
