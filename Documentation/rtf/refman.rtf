02408 {\cf20 // Based on stb_to_utf8() from github.com/nothings/stb/}\par
02409 {\cf17 static} {\cf17 inline} {\cf18 int} ImTextCharToUtf8_inline({\cf18 char}* buf, {\cf18 int} buf_size, {\cf18 unsigned} {\cf18 int} c)\par
02410 \{\par
02411     {\cf19 if} (c < 0x80)\par
02412     \{\par
02413         buf[0] = (char)c;\par
02414         {\cf19 return} 1;\par
02415     \}\par
02416     {\cf19 if} (c < 0x800)\par
02417     \{\par
02418         {\cf19 if} (buf_size < 2) {\cf19 return} 0;\par
02419         buf[0] = (char)(0xc0 + (c >> 6));\par
02420         buf[1] = (char)(0x80 + (c & 0x3f));\par
02421         {\cf19 return} 2;\par
02422     \}\par
02423     {\cf19 if} (c < 0x10000)\par
02424     \{\par
02425         {\cf19 if} (buf_size < 3) {\cf19 return} 0;\par
02426         buf[0] = (char)(0xe0 + (c >> 12));\par
02427         buf[1] = (char)(0x80 + ((c >> 6) & 0x3f));\par
02428         buf[2] = (char)(0x80 + ((c ) & 0x3f));\par
02429         {\cf19 return} 3;\par
02430     \}\par
02431     {\cf19 if} (c <= 0x10FFFF)\par
02432     \{\par
02433         {\cf19 if} (buf_size < 4) {\cf19 return} 0;\par
02434         buf[0] = (char)(0xf0 + (c >> 18));\par
02435         buf[1] = (char)(0x80 + ((c >> 12) & 0x3f));\par
02436         buf[2] = (char)(0x80 + ((c >> 6) & 0x3f));\par
02437         buf[3] = (char)(0x80 + ((c ) & 0x3f));\par
02438         {\cf19 return} 4;\par
02439     \}\par
02440     {\cf20 // Invalid code point, the max unicode is 0x10FFFF}\par
02441     {\cf19 return} 0;\par
02442 \}\par
02443 \par
02444 {\cf17 const} {\cf18 char}* ImTextCharToUtf8({\cf18 char} out_buf[5], {\cf18 unsigned} {\cf18 int} c)\par
02445 \{\par
02446     {\cf18 int} count = ImTextCharToUtf8_inline(out_buf, 5, c);\par
02447     out_buf[count] = 0;\par
02448     {\cf19 return} out_buf;\par
02449 \}\par
