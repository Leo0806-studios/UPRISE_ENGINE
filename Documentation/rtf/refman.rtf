04629     {\cf18 bool} can_undock_node = {\cf17 false};\par
04630     {\cf19 if} (undock && node != NULL && node->VisibleWindow && (node->VisibleWindow->Flags & ImGuiWindowFlags_NoMove) == 0 && (node->MergedFlags & ImGuiDockNodeFlags_NoUndocking) == 0)\par
04631     \{\par
04632         {\cf20 // Can undock if:}\par
04633         {\cf20 // - part of a hierarchy with more than one visible node (if only one is visible, we'll just move the root window)}\par
04634         {\cf20 // - part of a dockspace node hierarchy: so we can undock the last single visible node too (trivia: undocking from a fixed/central node will create a new node and copy windows)}\par
04635         ImGuiDockNode* root_node = DockNodeGetRootNode(node);\par
04636         {\cf19 if} (root_node->OnlyNodeWithWindows != node || root_node->CentralNode != NULL)   {\cf20 // -V1051 PVS-Studio thinks node should be root_node and is wrong about that.}\par
04637             can_undock_node = {\cf17 true};\par
04638     \}\par
04639 \par
04640     {\cf17 const} {\cf18 bool} clicked = IsMouseClicked(0);\par
04641     {\cf17 const} {\cf18 bool} dragging = IsMouseDragging(0);\par
04642     {\cf19 if} (can_undock_node && dragging)\par
04643         DockContextQueueUndockNode(&g, node); {\cf20 // Will lead to DockNodeStartMouseMovingWindow() -> StartMouseMovingWindow() being called next frame}\par
04644     {\cf19 else} {\cf19 if} (!can_undock_node && (clicked || dragging) && g.MovingWindow != window)\par
