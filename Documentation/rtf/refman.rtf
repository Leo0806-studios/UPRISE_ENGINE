17107 {\cf20 // - Remove inactive windows/nodes.}\par
17108 {\cf20 // - Update visibility flag.}\par
17109 {\cf17 static} {\cf18 void} ImGui::DockNodeUpdateFlagsAndCollapse(ImGuiDockNode* node)\par
17110 \{\par
17111     ImGuiContext& g = *GImGui;\par
17112     IM_ASSERT(node->ParentNode == NULL || node->ParentNode->ChildNodes[0] == node || node->ParentNode->ChildNodes[1] == node);\par
17113 \par
17114     {\cf20 // Inherit most flags}\par
17115     {\cf19 if} (node->ParentNode)\par
17116         node->SharedFlags = node->ParentNode->SharedFlags & ImGuiDockNodeFlags_SharedFlagsInheritMask_;\par
17117 \par
17118     {\cf20 // Recurse into children}\par
17119     {\cf20 // There is the possibility that one of our child becoming empty will delete itself and moving its sibling contents into 'node'.}\par
17120     {\cf20 // If 'node->ChildNode[0]' delete itself, then 'node->ChildNode[1]->Windows' will be moved into 'node'}\par
17121     {\cf20 // If 'node->ChildNode[1]' delete itself, then 'node->ChildNode[0]->Windows' will be moved into 'node' and the "remove inactive windows" loop will have run twice on those windows (harmless)}\par
17122     node->HasCentralNodeChild = {\cf17 false};\par
17123     {\cf19 if} (node->ChildNodes[0])\par
17124         DockNodeUpdateFlagsAndCollapse(node->ChildNodes[0]);\par
17125     {\cf19 if} (node->ChildNodes[1])\par
17126         DockNodeUpdateFlagsAndCollapse(node->ChildNodes[1]);\par
17127 \par
17128     {\cf20 // Remove inactive windows, collapse nodes}\par
17129     {\cf20 // Merge node flags overrides stored in windows}\par
17130     node->LocalFlagsInWindows = ImGuiDockNodeFlags_None;\par
17131     {\cf19 for} ({\cf18 int} window_n = 0; window_n < node->Windows.Size; window_n++)\par
17132     \{\par
17133         ImGuiWindow* window = node->Windows[window_n];\par
17134         IM_ASSERT(window->DockNode == node);\par
17135 \par
17136         {\cf18 bool} node_was_active = (node->LastFrameActive + 1 == g.FrameCount);\par
17137         {\cf18 bool} remove = {\cf17 false};\par
17138         remove |= node_was_active && (window->LastFrameActive + 1 < g.FrameCount);\par
17139         remove |= node_was_active && (node->WantCloseAll || node->WantCloseTabId == window->TabId) && window->HasCloseButton && !(window->Flags & ImGuiWindowFlags_UnsavedDocument);  {\cf20 // Submit all _expected_ closure from last frame}\par
17140         remove |= (window->DockTabWantClose);\par
17141         {\cf19 if} (remove)\par
17142         \{\par
17143             window->DockTabWantClose = {\cf17 false};\par
17144             {\cf19 if} (node->Windows.Size == 1 && !node->IsCentralNode())\par
17145             \{\par
17146                 DockNodeHideHostWindow(node);\par
17147                 node->State = ImGuiDockNodeState_HostWindowHiddenBecauseSingleWindow;\par
17148                 DockNodeRemoveWindow(node, window, node->ID); {\cf20 // Will delete the node so it'll be invalid on return}\par
17149                 {\cf19 return};\par
17150             \}\par
17151             DockNodeRemoveWindow(node, window, node->ID);\par
17152             window_n--;\par
17153             {\cf19 continue};\par
17154         \}\par
17155 \par
17156         {\cf20 // FIXME-DOCKING: Missing policies for conflict resolution, hence the "Experimental" tag on this.}\par
17157         {\cf20 //node->LocalFlagsInWindow &= ~window->WindowClass.DockNodeFlagsOverrideClear;}\par
17158         node->LocalFlagsInWindows |= window->WindowClass.DockNodeFlagsOverrideSet;\par
17159     \}\par
17160     node->UpdateMergedFlags();\par
17161 \par
17162     {\cf20 // Auto-hide tab bar option}\par
17163     ImGuiDockNodeFlags node_flags = node->MergedFlags;\par
17164     {\cf19 if} (node->WantHiddenTabBarUpdate && node->Windows.Size == 1 && (node_flags & ImGuiDockNodeFlags_AutoHideTabBar) && !node->IsHiddenTabBar())\par
17165         node->WantHiddenTabBarToggle = {\cf17 true};\par
17166     node->WantHiddenTabBarUpdate = {\cf17 false};\par
17167 \par
17168     {\cf20 // Cancel toggling if we know our tab bar is enforced to be hidden at all times}\par
17169     {\cf19 if} (node->WantHiddenTabBarToggle && node->VisibleWindow && (node->VisibleWindow->WindowClass.DockNodeFlagsOverrideSet & ImGuiDockNodeFlags_HiddenTabBar))\par
17170         node->WantHiddenTabBarToggle = {\cf17 false};\par
17171 \par
17172     {\cf20 // Apply toggles at a single point of the frame (here!)}\par
17173     {\cf19 if} (node->Windows.Size > 1)\par
17174         node->SetLocalFlags(node->LocalFlags & ~ImGuiDockNodeFlags_HiddenTabBar);\par
17175     {\cf19 else} {\cf19 if} (node->WantHiddenTabBarToggle)\par
17176         node->SetLocalFlags(node->LocalFlags ^ ImGuiDockNodeFlags_HiddenTabBar);\par
17177     node->WantHiddenTabBarToggle = {\cf17 false};\par
