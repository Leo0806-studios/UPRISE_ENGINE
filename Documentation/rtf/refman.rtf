14281 {\cf20 // [SECTION] LOGGING/CAPTURING}\par
14282 {\cf20 //-----------------------------------------------------------------------------}\par
14283 {\cf20 // All text output from the interface can be captured into tty/file/clipboard.}\par
14284 {\cf20 // By default, tree nodes are automatically opened during logging.}\par
14285 {\cf20 //-----------------------------------------------------------------------------}\par
