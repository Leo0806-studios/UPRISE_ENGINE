19577 {\cf18 void} ImGui::BeginDockableDragDropTarget(ImGuiWindow* window)\par
19578 \{\par
19579     ImGuiContext& g = *GImGui;\par
19580 \par
19581     {\cf20 //IM_ASSERT(window->RootWindowDockTree == window); // May also be a DockSpace}\par
19582     IM_ASSERT((window->Flags & ImGuiWindowFlags_NoDocking) == 0);\par
19583     {\cf19 if} (!g.DragDropActive)\par
19584         {\cf19 return};\par
19585     {\cf20 //GetForegroundDrawList(window)->AddRect(window->Pos, window->Pos + window->Size, IM_COL32(255, 255, 0, 255));}\par
19586     {\cf19 if} (!BeginDragDropTargetCustom(window->Rect(), window->ID))\par
19587         {\cf19 return};\par
19588 \par
19589     {\cf20 // Peek into the payload before calling AcceptDragDropPayload() so we can handle overlapping dock nodes with filtering}\par
19590     {\cf20 // (this is a little unusual pattern, normally most code would call AcceptDragDropPayload directly)}\par
19591     {\cf17 const} ImGuiPayload* payload = &g.DragDropPayload;\par
19592     {\cf19 if} (!payload->IsDataType(IMGUI_PAYLOAD_TYPE_WINDOW) || !DockNodeIsDropAllowed(window, *(ImGuiWindow**)payload->Data))\par
19593     \{\par
19594         EndDragDropTarget();\par
19595         {\cf19 return};\par
19596     \}\par
19597 \par
19598     ImGuiWindow* payload_window = *(ImGuiWindow**)payload->Data;\par
19599     {\cf19 if} (AcceptDragDropPayload(IMGUI_PAYLOAD_TYPE_WINDOW, ImGuiDragDropFlags_AcceptBeforeDelivery | ImGuiDragDropFlags_AcceptNoDrawDefaultRect))\par
19600     \{\par
19601         {\cf20 // Select target node}\par
19602         {\cf20 // (Important: we cannot use g.HoveredDockNode here! Because each of our target node have filters based on payload, each candidate drop target will do its own evaluation)}\par
19603         {\cf18 bool} dock_into_floating_window = {\cf17 false};\par
19604         ImGuiDockNode* node = NULL;\par
19605         {\cf19 if} (window->DockNodeAsHost)\par
19606         \{\par
19607             {\cf20 // Cannot assume that node will != NULL even though we passed the rectangle test: it depends on padding/spacing handled by DockNodeTreeFindVisibleNodeByPos().}\par
19608             node = DockNodeTreeFindVisibleNodeByPos(window->DockNodeAsHost, g.IO.MousePos);\par
19609 \par
19610             {\cf20 // There is an edge case when docking into a dockspace which only has _inactive_ nodes (because none of the windows are active)}\par
19611             {\cf20 // In this case we need to fallback into any leaf mode, possibly the central node.}\par
19612             {\cf20 // FIXME-20181220: We should not have to test for IsLeafNode() here but we have another bug to fix first.}\par
19613             {\cf19 if} (node && node->IsDockSpace() && node->IsRootNode())\par
19614                 node = (node->CentralNode && node->IsLeafNode()) ? node->CentralNode : DockNodeTreeFindFallbackLeafNode(node);\par
19615         \}\par
19616         {\cf19 else}\par
19617         \{\par
19618             {\cf19 if} (window->DockNode)\par
19619                 node = window->DockNode;\par
19620             {\cf19 else}\par
19621                 dock_into_floating_window = {\cf17 true}; {\cf20 // Dock into a regular window}\par
19622         \}\par
19623 \par
19624         {\cf17 const} ImRect explicit_target_rect = (node && node->TabBar && !node->IsHiddenTabBar() && !node->IsNoTabBar()) ? node->TabBar->BarRect : ImRect(window->Pos, window->Pos + ImVec2(window->Size.x, GetFrameHeight()));\par
19625         {\cf17 const} {\cf18 bool} is_explicit_target = g.IO.ConfigDockingWithShift || IsMouseHoveringRect(explicit_target_rect.Min, explicit_target_rect.Max);\par
19626 \par
19627         {\cf20 // Preview docking request and find out split direction/ratio}\par
19628         {\cf20 //const bool do_preview = true;     // Ignore testing for payload->IsPreview() which removes one frame of delay, but breaks overlapping drop targets within the same window.}\par
19629         {\cf17 const} {\cf18 bool} do_preview = payload->IsPreview() || payload->IsDelivery();\par
19630         {\cf19 if} (do_preview && (node != NULL || dock_into_floating_window))\par
19631         \{\par
19632             {\cf20 // If we have a non-leaf node it means we are hovering the border of a parent node, in which case only outer markers will appear.}\par
19633             ImGuiDockPreviewData split_inner;\par
19634             ImGuiDockPreviewData split_outer;\par
19635             ImGuiDockPreviewData* split_data = &split_inner;\par
19636             {\cf19 if} (node && (node->ParentNode || node->IsCentralNode() || !node->IsLeafNode()))\par
19637                 {\cf19 if} (ImGuiDockNode* root_node = DockNodeGetRootNode(node))\par
19638                 \{\par
19639                     DockNodePreviewDockSetup(window, root_node, payload_window, NULL, &split_outer, is_explicit_target, {\cf17 true});\par
19640                     {\cf19 if} (split_outer.IsSplitDirExplicit)\par
19641                         split_data = &split_outer;\par
19642                 \}\par
19643             {\cf19 if} (!node || node->IsLeafNode())\par
19644                 DockNodePreviewDockSetup(window, node, payload_window, NULL, &split_inner, is_explicit_target, {\cf17 false});\par
19645             {\cf19 if} (split_data == &split_outer)\par
19646                 split_inner.IsDropAllowed = {\cf17 false};\par
19647 \par
19648             {\cf20 // Draw inner then outer, so that previewed tab (in inner data) will be behind the outer drop boxes}\par
19649             DockNodePreviewDockRender(window, node, payload_window, &split_inner);\par
19650             DockNodePreviewDockRender(window, node, payload_window, &split_outer);\par
19651 \par
19652             {\cf20 // Queue docking request}\par
19653             {\cf19 if} (split_data->IsDropAllowed && payload->IsDelivery())\par
19654                 DockContextQueueDock(&g, window, split_data->SplitNode, payload_window, split_data->SplitDir, split_data->SplitRatio, split_data == &split_outer);\par
19655         \}\par
19656     \}\par
19657     EndDragDropTarget();\par
19658 \}\par
