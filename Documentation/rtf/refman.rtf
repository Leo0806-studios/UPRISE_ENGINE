15957 {\cf20 //    | - DockContextProcessUndockWindow()    - process one window undocking request}\par
15958 {\cf20 //    | - DockContextProcessUndockNode()      - process one whole node undocking request}\par
15959 {\cf20 //    | DockContextNewFrameUpdateUndocking()  - process queue docking requests, create floating dock nodes}\par
15960 {\cf20 //    | - update g.HoveredDockNode            - [debug] update node hovered by mouse}\par
15961 {\cf20 //    | - DockContextProcessDock()            - process one docking request}\par
15962 {\cf20 //    | - DockNodeUpdate()}\par
15963 {\cf20 //    |   - DockNodeUpdateForRootNode()}\par
15964 {\cf20 //    |     - DockNodeUpdateFlagsAndCollapse()}\par
15965 {\cf20 //    |     - DockNodeFindInfo()}\par
15966 {\cf20 //    |   - destroy unused node or tab bar}\par
15967 {\cf20 //    |   - create dock node host window}\par
15968 {\cf20 //    |      - Begin() etc.}\par
15969 {\cf20 //    |   - DockNodeStartMouseMovingWindow()}\par
15970 {\cf20 //    |   - DockNodeTreeUpdatePosSize()}\par
15971 {\cf20 //    |   - DockNodeTreeUpdateSplitter()}\par
15972 {\cf20 //    |   - draw node background}\par
15973 {\cf20 //    |   - DockNodeUpdateTabBar()            - create/update tab bar for a docking node}\par
15974 {\cf20 //    |     - DockNodeAddTabBar()}\par
15975 {\cf20 //    |     - DockNodeWindowMenuUpdate()}\par
15976 {\cf20 //    |     - DockNodeCalcTabBarLayout()}\par
15977 {\cf20 //    |     - BeginTabBarEx()}\par
15978 {\cf20 //    |     - TabItemEx() calls}\par
15979 {\cf20 //    |     - EndTabBar()}\par
15980 {\cf20 //    |   - BeginDockableDragDropTarget()}\par
