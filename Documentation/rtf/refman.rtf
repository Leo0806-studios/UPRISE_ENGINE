02277 {\cf20 // Helper: Load file content into memory}\par
02278 {\cf20 // Memory allocated with IM_ALLOC(), must be freed by user using IM_FREE() == ImGui::MemFree()}\par
02279 {\cf20 // This can't really be used with "rt" because fseek size won't match read size.}\par
02280 {\cf18 void}*   ImFileLoadToMemory({\cf17 const} {\cf18 char}* filename, {\cf17 const} {\cf18 char}* mode, {\cf18 size_t}* out_file_size, {\cf18 int} padding_bytes)\par
02281 \{\par
02282     IM_ASSERT(filename && mode);\par
02283     {\cf19 if} (out_file_size)\par
02284         *out_file_size = 0;\par
02285 \par
02286     ImFileHandle f;\par
02287     {\cf19 if} ((f = ImFileOpen(filename, mode)) == NULL)\par
02288         {\cf19 return} NULL;\par
02289 \par
02290     {\cf18 size_t} file_size = (size_t)ImFileGetSize(f);\par
02291     {\cf19 if} (file_size == ({\cf18 size_t})-1)\par
02292     \{\par
02293         ImFileClose(f);\par
02294         {\cf19 return} NULL;\par
02295     \}\par
02296 \par
02297     {\cf18 void}* file_data = IM_ALLOC(file_size + padding_bytes);\par
02298     {\cf19 if} (file_data == NULL)\par
02299     \{\par
02300         ImFileClose(f);\par
02301         {\cf19 return} NULL;\par
02302     \}\par
02303     {\cf19 if} (ImFileRead(file_data, 1, file_size, f) != file_size)\par
02304     \{\par
02305         ImFileClose(f);\par
02306         IM_FREE(file_data);\par
02307         {\cf19 return} NULL;\par
02308     \}\par
02309     {\cf19 if} (padding_bytes > 0)\par
02310         memset(({\cf18 void}*)((({\cf18 char}*)file_data) + file_size), 0, ({\cf18 size_t})padding_bytes);\par
02311 \par
02312     ImFileClose(f);\par
02313     {\cf19 if} (out_file_size)\par
02314         *out_file_size = file_size;\par
02315 \par
02316     {\cf19 return} file_data;\par
02317 \}\par
