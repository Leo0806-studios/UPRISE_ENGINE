14205 {\cf17 const} ImGuiPayload* ImGui::AcceptDragDropPayload({\cf17 const} {\cf18 char}* type, ImGuiDragDropFlags flags)\par
14206 \{\par
14207     ImGuiContext& g = *GImGui;\par
14208     ImGuiPayload& payload = g.DragDropPayload;\par
14209     IM_ASSERT(g.DragDropActive);                        {\cf20 // Not called between BeginDragDropTarget() and EndDragDropTarget() ?}\par
14210     IM_ASSERT(payload.DataFrameCount != -1);            {\cf20 // Forgot to call EndDragDropTarget() ?}\par
14211     {\cf19 if} (type != NULL && !payload.IsDataType(type))\par
14212         {\cf19 return} NULL;\par
14213 \par
14214     {\cf20 // Accept smallest drag target bounding box, this allows us to nest drag targets conveniently without ordering constraints.}\par
14215     {\cf20 // NB: We currently accept NULL id as target. However, overlapping targets requires a unique ID to function!}\par
14216     {\cf17 const} {\cf18 bool} was_accepted_previously = (g.DragDropAcceptIdPrev == g.DragDropTargetId);\par
14217     ImRect r = g.DragDropTargetRect;\par
14218     {\cf18 float} r_surface = r.GetWidth() * r.GetHeight();\par
14219     {\cf19 if} (r_surface > g.DragDropAcceptIdCurrRectSurface)\par
14220         {\cf19 return} NULL;\par
14221 \par
14222     g.DragDropAcceptFlags = flags;\par
14223     g.DragDropAcceptIdCurr = g.DragDropTargetId;\par
14224     g.DragDropAcceptIdCurrRectSurface = r_surface;\par
14225     {\cf20 //IMGUI_DEBUG_LOG("AcceptDragDropPayload(): %08X: accept\\n", g.DragDropTargetId);}\par
14226 \par
14227     {\cf20 // Render default drop visuals}\par
14228     payload.Preview = was_accepted_previously;\par
14229     flags |= (g.DragDropSourceFlags & ImGuiDragDropFlags_AcceptNoDrawDefaultRect); {\cf20 // Source can also inhibit the preview (useful for external sources that live for 1 frame)}\par
14230     {\cf19 if} (!(flags & ImGuiDragDropFlags_AcceptNoDrawDefaultRect) && payload.Preview)\par
14231         RenderDragDropTargetRect(r, g.DragDropTargetClipRect);\par
14232 \par
14233     g.DragDropAcceptFrameCount = g.FrameCount;\par
14234     {\cf19 if} ((g.DragDropSourceFlags & ImGuiDragDropFlags_SourceExtern) && g.DragDropMouseButton == -1)\par
14235         payload.Delivery = was_accepted_previously && (g.DragDropSourceFrameCount < g.FrameCount);\par
14236     {\cf19 else}\par
14237         payload.Delivery = was_accepted_previously && !IsMouseDown(g.DragDropMouseButton); {\cf20 // For extern drag sources affecting OS window focus, it's easier to just test !IsMouseDown() instead of IsMouseReleased()}\par
14238     {\cf19 if} (!payload.Delivery && !(flags & ImGuiDragDropFlags_AcceptBeforeDelivery))\par
14239         {\cf19 return} NULL;\par
14240 \par
14241     {\cf19 if} (payload.Delivery)\par
14242         IMGUI_DEBUG_LOG_ACTIVEID({\cf22 "[dragdrop] AcceptDragDropPayload(): 0x%08X: payload delivery\\n"}, g.DragDropTargetId);\par
14243     {\cf19 return} &payload;\par
14244 \}\par
