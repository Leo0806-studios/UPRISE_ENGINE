06628 {\cf18 void} ImGui::RenderWindowDecorations(ImGuiWindow* window, {\cf17 const} ImRect& title_bar_rect, {\cf18 bool} title_bar_is_highlight, {\cf18 bool} handle_borders_and_resize_grips, {\cf18 int} resize_grip_count, {\cf17 const} ImU32 resize_grip_col[4], {\cf18 float} resize_grip_draw_size)\par
06629 \{\par
06630     ImGuiContext& g = *GImGui;\par
06631     ImGuiStyle& style = g.Style;\par
06632     ImGuiWindowFlags flags = window->Flags;\par
06633 \par
06634     {\cf20 // Ensure that ScrollBar doesn't read last frame's SkipItems}\par
06635     IM_ASSERT(window->BeginCount == 0);\par
06636     window->SkipItems = {\cf17 false};\par
06637 \par
06638     {\cf20 // Draw window + handle manual resize}\par
06639     {\cf20 // As we highlight the title bar when want_focus is set, multiple reappearing windows will have their title bar highlighted on their reappearing frame.}\par
06640     {\cf17 const} {\cf18 float} window_rounding = window->WindowRounding;\par
06641     {\cf17 const} {\cf18 float} window_border_size = window->WindowBorderSize;\par
06642     {\cf19 if} (window->Collapsed)\par
06643     \{\par
06644         {\cf20 // Title bar only}\par
06645         {\cf17 const} {\cf18 float} backup_border_size = style.FrameBorderSize;\par
06646         g.Style.FrameBorderSize = window->WindowBorderSize;\par
06647         ImU32 title_bar_col = GetColorU32((title_bar_is_highlight && !g.NavDisableHighlight) ? ImGuiCol_TitleBgActive : ImGuiCol_TitleBgCollapsed);\par
06648         {\cf19 if} (window->ViewportOwned)\par
06649             title_bar_col |= IM_COL32_A_MASK; {\cf20 // No alpha (we don't support is_docking_transparent_payload here because simpler and less meaningful, but could with a bit of code shuffle/reuse)}\par
06650         RenderFrame(title_bar_rect.Min, title_bar_rect.Max, title_bar_col, {\cf17 true}, window_rounding);\par
06651         g.Style.FrameBorderSize = backup_border_size;\par
06652     \}\par
06653     {\cf19 else}\par
06654     \{\par
06655         {\cf20 // Window background}\par
06656         {\cf19 if} (!(flags & ImGuiWindowFlags_NoBackground))\par
06657         \{\par
06658             {\cf18 bool} is_docking_transparent_payload = {\cf17 false};\par
06659             {\cf19 if} (g.DragDropActive && (g.FrameCount - g.DragDropAcceptFrameCount) <= 1 && g.IO.ConfigDockingTransparentPayload)\par
06660                 {\cf19 if} (g.DragDropPayload.IsDataType(IMGUI_PAYLOAD_TYPE_WINDOW) && *(ImGuiWindow**)g.DragDropPayload.Data == window)\par
06661                     is_docking_transparent_payload = {\cf17 true};\par
06662 \par
06663             ImU32 bg_col = GetColorU32(GetWindowBgColorIdx(window));\par
06664             {\cf19 if} (window->ViewportOwned)\par
06665             \{\par
06666                 bg_col |= IM_COL32_A_MASK; {\cf20 // No alpha}\par
06667                 {\cf19 if} (is_docking_transparent_payload)\par
06668                     window->Viewport->Alpha *= DOCKING_TRANSPARENT_PAYLOAD_ALPHA;\par
06669             \}\par
06670             {\cf19 else}\par
06671             \{\par
06672                 {\cf20 // Adjust alpha. For docking}\par
06673                 {\cf18 bool} override_alpha = {\cf17 false};\par
06674                 {\cf18 float} alpha = 1.0f;\par
06675                 {\cf19 if} (g.NextWindowData.Flags & ImGuiNextWindowDataFlags_HasBgAlpha)\par
06676                 \{\par
06677                     alpha = g.NextWindowData.BgAlphaVal;\par
06678                     override_alpha = {\cf17 true};\par
06679                 \}\par
06680                 {\cf19 if} (is_docking_transparent_payload)\par
06681                 \{\par
06682                     alpha *= DOCKING_TRANSPARENT_PAYLOAD_ALPHA; {\cf20 // FIXME-DOCK: Should that be an override?}\par
06683                     override_alpha = {\cf17 true};\par
06684                 \}\par
06685                 {\cf19 if} (override_alpha)\par
06686                     bg_col = (bg_col & ~IM_COL32_A_MASK) | (IM_F32_TO_INT8_SAT(alpha) << IM_COL32_A_SHIFT);\par
06687             \}\par
06688 \par
06689             {\cf20 // Render, for docked windows and host windows we ensure bg goes before decorations}\par
06690             {\cf19 if} (window->DockIsActive)\par
06691                 window->DockNode->LastBgColor = bg_col;\par
06692             ImDrawList* bg_draw_list = window->DockIsActive ? window->DockNode->HostWindow->DrawList : window->DrawList;\par
06693             {\cf19 if} (window->DockIsActive || (flags & ImGuiWindowFlags_DockNodeHost))\par
06694                 bg_draw_list->ChannelsSetCurrent(DOCKING_HOST_DRAW_CHANNEL_BG);\par
06695             bg_draw_list->AddRectFilled(window->Pos + ImVec2(0, window->TitleBarHeight), window->Pos + window->Size, bg_col, window_rounding, (flags & ImGuiWindowFlags_NoTitleBar) ? 0 : ImDrawFlags_RoundCornersBottom);\par
06696             {\cf19 if} (window->DockIsActive || (flags & ImGuiWindowFlags_DockNodeHost))\par
06697                 bg_draw_list->ChannelsSetCurrent(DOCKING_HOST_DRAW_CHANNEL_FG);\par
06698         \}\par
06699         {\cf19 if} (window->DockIsActive)\par
06700             window->DockNode->IsBgDrawnThisFrame = {\cf17 true};\par
06701 \par
06702         {\cf20 // Title bar}\par
06703         {\cf20 // (when docked, DockNode are drawing their own title bar. Individual windows however do NOT set the _NoTitleBar flag,}\par
06704         {\cf20 // in order for their pos/size to be matching their undocking state.)}\par
06705         {\cf19 if} (!(flags & ImGuiWindowFlags_NoTitleBar) && !window->DockIsActive)\par
06706         \{\par
06707             ImU32 title_bar_col = GetColorU32(title_bar_is_highlight ? ImGuiCol_TitleBgActive : ImGuiCol_TitleBg);\par
06708             {\cf19 if} (window->ViewportOwned)\par
06709                 title_bar_col |= IM_COL32_A_MASK; {\cf20 // No alpha}\par
06710             window->DrawList->AddRectFilled(title_bar_rect.Min, title_bar_rect.Max, title_bar_col, window_rounding, ImDrawFlags_RoundCornersTop);\par
06711         \}\par
06712 \par
06713         {\cf20 // Menu bar}\par
06714         {\cf19 if} (flags & ImGuiWindowFlags_MenuBar)\par
06715         \{\par
06716             ImRect menu_bar_rect = window->MenuBarRect();\par
06717             menu_bar_rect.ClipWith(window->Rect());  {\cf20 // Soft clipping, in particular child window don't have minimum size covering the menu bar so this is useful for them.}\par
06718             window->DrawList->AddRectFilled(menu_bar_rect.Min + ImVec2(window_border_size, 0), menu_bar_rect.Max - ImVec2(window_border_size, 0), GetColorU32(ImGuiCol_MenuBarBg), (flags & ImGuiWindowFlags_NoTitleBar) ? window_rounding : 0.0f, ImDrawFlags_RoundCornersTop);\par
06719             {\cf19 if} (style.FrameBorderSize > 0.0f && menu_bar_rect.Max.y < window->Pos.y + window->Size.y)\par
06720                 window->DrawList->AddLine(menu_bar_rect.GetBL(), menu_bar_rect.GetBR(), GetColorU32(ImGuiCol_Border), style.FrameBorderSize);\par
06721         \}\par
06722 \par
06723         {\cf20 // Docking: Unhide tab bar (small triangle in the corner), drag from small triangle to quickly undock}\par
06724         ImGuiDockNode* node = window->DockNode;\par
06725         {\cf19 if} (window->DockIsActive && node->IsHiddenTabBar() && !node->IsNoTabBar())\par
06726         \{\par
06727             {\cf18 float} unhide_sz_draw = ImTrunc(g.FontSize * 0.70f);\par
06728             {\cf18 float} unhide_sz_hit = ImTrunc(g.FontSize * 0.55f);\par
06729             ImVec2 p = node->Pos;\par
06730             ImRect r(p, p + ImVec2(unhide_sz_hit, unhide_sz_hit));\par
06731             ImGuiID unhide_id = window->GetID({\cf22 "#UNHIDE"});\par
06732             KeepAliveID(unhide_id);\par
06733             {\cf18 bool} hovered, held;\par
06734             {\cf19 if} (ButtonBehavior(r, unhide_id, &hovered, &held, ImGuiButtonFlags_FlattenChildren))\par
06735                 node->WantHiddenTabBarToggle = {\cf17 true};\par
06736             {\cf19 else} {\cf19 if} (held && IsMouseDragging(0))\par
06737                 StartMouseMovingWindowOrNode(window, node, {\cf17 true}); {\cf20 // Undock from tab-bar triangle = same as window/collapse menu button}\par
06738 \par
06739             {\cf20 // FIXME-DOCK: Ideally we'd use ImGuiCol_TitleBgActive/ImGuiCol_TitleBg here, but neither is guaranteed to be visible enough at this sort of size..}\par
06740             ImU32 col = GetColorU32(((held && hovered) || (node->IsFocused && !hovered)) ? ImGuiCol_ButtonActive : hovered ? ImGuiCol_ButtonHovered : ImGuiCol_Button);\par
06741             window->DrawList->AddTriangleFilled(p, p + ImVec2(unhide_sz_draw, 0.0f), p + ImVec2(0.0f, unhide_sz_draw), col);\par
06742         \}\par
06743 \par
06744         {\cf20 // Scrollbars}\par
06745         {\cf19 if} (window->ScrollbarX)\par
06746             Scrollbar(ImGuiAxis_X);\par
06747         {\cf19 if} (window->ScrollbarY)\par
06748             Scrollbar(ImGuiAxis_Y);\par
06749 \par
06750         {\cf20 // Render resize grips (after their input handling so we don't have a frame of latency)}\par
06751         {\cf19 if} (handle_borders_and_resize_grips && !(flags & ImGuiWindowFlags_NoResize))\par
06752         \{\par
06753             {\cf19 for} ({\cf18 int} resize_grip_n = 0; resize_grip_n < resize_grip_count; resize_grip_n++)\par
06754             \{\par
06755                 {\cf17 const} ImU32 col = resize_grip_col[resize_grip_n];\par
06756                 {\cf19 if} ((col & IM_COL32_A_MASK) == 0)\par
06757                     {\cf19 continue};\par
06758                 {\cf17 const} ImGuiResizeGripDef& grip = resize_grip_def[resize_grip_n];\par
06759                 {\cf17 const} ImVec2 corner = ImLerp(window->Pos, window->Pos + window->Size, grip.CornerPosN);\par
06760                 window->DrawList->PathLineTo(corner + grip.InnerDir * ((resize_grip_n & 1) ? ImVec2(window_border_size, resize_grip_draw_size) : ImVec2(resize_grip_draw_size, window_border_size)));\par
06761                 window->DrawList->PathLineTo(corner + grip.InnerDir * ((resize_grip_n & 1) ? ImVec2(resize_grip_draw_size, window_border_size) : ImVec2(window_border_size, resize_grip_draw_size)));\par
06762                 window->DrawList->PathArcToFast(ImVec2(corner.x + grip.InnerDir.x * (window_rounding + window_border_size), corner.y + grip.InnerDir.y * (window_rounding + window_border_size)), window_rounding, grip.AngleMin12, grip.AngleMax12);\par
06763                 window->DrawList->PathFillConvex(col);\par
06764             \}\par
06765         \}\par
06766 \par
06767         {\cf20 // Borders (for dock node host they will be rendered over after the tab bar)}\par
06768         {\cf19 if} (handle_borders_and_resize_grips && !window->DockNodeAsHost)\par
06769             RenderWindowOuterBorders(window);\par
06770     \}\par
06771 \}\par
