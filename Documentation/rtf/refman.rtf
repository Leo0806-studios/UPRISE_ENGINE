00788     table->MinColumnWidth = ImMax(1.0f, g.Style.FramePadding.x * 1.0f); {\cf20 // g.Style.ColumnsMinSpacing; // FIXME-TABLE}\par
00789 \par
00790     {\cf20 // [Part 1] Apply/lock Enabled and Order states. Calculate auto/ideal width for columns. Count fixed/stretch columns.}\par
00791     {\cf20 // Process columns in their visible orders as we are building the Prev/Next indices.}\par
00792     {\cf18 int} count_fixed = 0;                {\cf20 // Number of columns that have fixed sizing policies}\par
00793     {\cf18 int} count_stretch = 0;              {\cf20 // Number of columns that have stretch sizing policies}\par
00794     {\cf18 int} prev_visible_column_idx = -1;\par
00795     {\cf18 bool} has_auto_fit_request = {\cf17 false};\par
00796     {\cf18 bool} has_resizable = {\cf17 false};\par
00797     {\cf18 float} stretch_sum_width_auto = 0.0f;\par
00798     {\cf18 float} fixed_max_width_auto = 0.0f;\par
