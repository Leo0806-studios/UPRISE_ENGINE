19022 {\cf18 void} ImGui::DockBuilderRemoveNode(ImGuiID node_id)\par
19023 \{\par
19024     ImGuiContext& g = *GImGui; IM_UNUSED(g);\par
19025     IMGUI_DEBUG_LOG_DOCKING({\cf22 "[docking] DockBuilderRemoveNode 0x%08X\\n"}, node_id);\par
19026 \par
19027     ImGuiDockNode* node = DockContextFindNodeByID(&g, node_id);\par
19028     {\cf19 if} (node == NULL)\par
19029         {\cf19 return};\par
19030     DockBuilderRemoveNodeDockedWindows(node_id, {\cf17 true});\par
19031     DockBuilderRemoveNodeChildNodes(node_id);\par
19032     {\cf20 // Node may have moved or deleted if e.g. any merge happened}\par
19033     node = DockContextFindNodeByID(&g, node_id);\par
19034     {\cf19 if} (node == NULL)\par
19035         {\cf19 return};\par
19036     {\cf19 if} (node->IsCentralNode() && node->ParentNode)\par
19037         node->ParentNode->SetLocalFlags(node->ParentNode->LocalFlags | ImGuiDockNodeFlags_CentralNode);\par
19038     DockContextRemoveNode(&g, node, {\cf17 true});\par
19039 \}\par
