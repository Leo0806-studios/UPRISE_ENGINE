15385 ImGuiViewportP* ImGui::AddUpdateViewport(ImGuiWindow* window, ImGuiID {\cf18 id}, {\cf17 const} ImVec2& pos, {\cf17 const} ImVec2& size, ImGuiViewportFlags flags)\par
15386 \{\par
15387     ImGuiContext& g = *GImGui;\par
15388     IM_ASSERT({\cf18 id} != 0);\par
15389 \par
15390     flags |= ImGuiViewportFlags_IsPlatformWindow;\par
15391     {\cf19 if} (window != NULL)\par
15392     \{\par
15393         {\cf19 if} (g.MovingWindow && g.MovingWindow->RootWindowDockTree == window)\par
15394             flags |= ImGuiViewportFlags_NoInputs | ImGuiViewportFlags_NoFocusOnAppearing;\par
15395         {\cf19 if} ((window->Flags & ImGuiWindowFlags_NoMouseInputs) && (window->Flags & ImGuiWindowFlags_NoNavInputs))\par
15396             flags |= ImGuiViewportFlags_NoInputs;\par
15397         {\cf19 if} (window->Flags & ImGuiWindowFlags_NoFocusOnAppearing)\par
15398             flags |= ImGuiViewportFlags_NoFocusOnAppearing;\par
15399     \}\par
15400 \par
15401     ImGuiViewportP* viewport = (ImGuiViewportP*)FindViewportByID({\cf18 id});\par
15402     {\cf19 if} (viewport)\par
15403     \{\par
15404         {\cf20 // Always update for main viewport as we are already pulling correct platform pos/size (see #4900)}\par
15405         {\cf19 if} (!viewport->PlatformRequestMove || viewport->ID == IMGUI_VIEWPORT_DEFAULT_ID)\par
15406             viewport->Pos = pos;\par
15407         {\cf19 if} (!viewport->PlatformRequestResize || viewport->ID == IMGUI_VIEWPORT_DEFAULT_ID)\par
15408             viewport->Size = size;\par
15409         viewport->Flags = flags | (viewport->Flags & (ImGuiViewportFlags_IsMinimized | ImGuiViewportFlags_IsFocused)); {\cf20 // Preserve existing flags}\par
15410     \}\par
15411     {\cf19 else}\par
15412     \{\par
15413         {\cf20 // New viewport}\par
15414         viewport = IM_NEW(ImGuiViewportP)();\par
15415         viewport->ID = id;\par
15416         viewport->Idx = g.Viewports.Size;\par
15417         viewport->Pos = viewport->LastPos = pos;\par
15418         viewport->Size = size;\par
15419         viewport->Flags = flags;\par
15420         UpdateViewportPlatformMonitor(viewport);\par
15421         g.Viewports.push_back(viewport);\par
15422         g.ViewportCreatedCount++;\par
15423         IMGUI_DEBUG_LOG_VIEWPORT({\cf22 "[viewport] Add Viewport %08X '%s'\\n"}, {\cf18 id}, window ? window->Name : {\cf22 "<NULL>"});\par
15424 \par
15425         {\cf20 // We normally setup for all viewports in NewFrame() but here need to handle the mid-frame creation of a new viewport.}\par
