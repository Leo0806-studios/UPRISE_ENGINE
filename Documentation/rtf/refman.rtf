00795 {\cf18 bool} ImGui::ArrowButtonEx({\cf17 const} {\cf18 char}* str_id, ImGuiDir dir, ImVec2 size, ImGuiButtonFlags flags)\par
00796 \{\par
00797     ImGuiContext& g = *GImGui;\par
