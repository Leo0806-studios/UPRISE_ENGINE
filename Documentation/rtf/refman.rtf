12012     {\cf18 bool} is_open = Begin(name, NULL, extra_window_flags | ImGuiWindowFlags_Popup | ImGuiWindowFlags_NoDocking);\par
12013     {\cf19 if} (!is_open) {\cf20 // NB: Begin can return false when the popup is completely clipped (e.g. zero size display)}\par
12014         EndPopup();\par
12015 \par
12016     {\cf20 //g.CurrentWindow->FocusRouteParentWindow = g.CurrentWindow->ParentWindowInBeginStack;}\par
