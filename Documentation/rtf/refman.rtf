13771         {\cf19 if} (io.InputQueueCharacters.Size > 0 || io.KeyCtrl || io.KeyShift || io.KeySuper)\par
13772             g.NavWindowingToggleLayer = {\cf17 false};\par
13773         {\cf19 if} (TestKeyOwner(g.NavWindowingToggleKey, ImGuiKeyOwner_NoOwner) == {\cf17 false} || TestKeyOwner(ImGuiMod_Alt, ImGuiKeyOwner_NoOwner) == {\cf17 false})\par
