03641 {\cf18 void} ImGui::TableLoadSettings(ImGuiTable* table)\par
03642 \{\par
03643     ImGuiContext& g = *GImGui;\par
03644     table->IsSettingsRequestLoad = {\cf17 false};\par
03645     {\cf19 if} (table->Flags & ImGuiTableFlags_NoSavedSettings)\par
03646         {\cf19 return};\par
03647 \par
03648     {\cf20 // Bind settings}\par
03649     ImGuiTableSettings* settings;\par
03650     {\cf19 if} (table->SettingsOffset == -1)\par
03651     \{\par
03652         settings = TableSettingsFindByID(table->ID);\par
03653         {\cf19 if} (settings == NULL)\par
03654             {\cf19 return};\par
03655         {\cf19 if} (settings->ColumnsCount != table->ColumnsCount) {\cf20 // Allow settings if columns count changed. We could otherwise decide to return...}\par
03656             table->IsSettingsDirty = {\cf17 true};\par
03657         table->SettingsOffset = g.SettingsTables.offset_from_ptr(settings);\par
03658     \}\par
03659     {\cf19 else}\par
03660     \{\par
03661         settings = TableGetBoundSettings(table);\par
03662     \}\par
03663 \par
03664     table->SettingsLoadedFlags = settings->SaveFlags;\par
03665     table->RefScale = settings->RefScale;\par
03666 \par
03667     {\cf20 // Serialize ImGuiTableSettings/ImGuiTableColumnSettings into ImGuiTable/ImGuiTableColumn}\par
03668     ImGuiTableColumnSettings* column_settings = settings->GetColumnSettings();\par
03669     ImU64 display_order_mask = 0;\par
03670     {\cf19 for} ({\cf18 int} data_n = 0; data_n < settings->ColumnsCount; data_n++, column_settings++)\par
03671     \{\par
03672         {\cf18 int} column_n = column_settings->Index;\par
03673         {\cf19 if} (column_n < 0 || column_n >= table->ColumnsCount)\par
03674             {\cf19 continue};\par
03675 \par
03676         ImGuiTableColumn* column = &table->Columns[column_n];\par
03677         {\cf19 if} (settings->SaveFlags & ImGuiTableFlags_Resizable)\par
03678         \{\par
03679             {\cf19 if} (column_settings->IsStretch)\par
03680                 column->StretchWeight = column_settings->WidthOrWeight;\par
03681             {\cf19 else}\par
03682                 column->WidthRequest = column_settings->WidthOrWeight;\par
03683             column->AutoFitQueue = 0x00;\par
03684         \}\par
03685         {\cf19 if} (settings->SaveFlags & ImGuiTableFlags_Reorderable)\par
03686             column->DisplayOrder = column_settings->DisplayOrder;\par
03687         {\cf19 else}\par
03688             column->DisplayOrder = (ImGuiTableColumnIdx)column_n;\par
03689         display_order_mask |= (ImU64)1 << column->DisplayOrder;\par
03690         column->IsUserEnabled = column->IsUserEnabledNextFrame = column_settings->IsEnabled;\par
03691         column->SortOrder = column_settings->SortOrder;\par
03692         column->SortDirection = column_settings->SortDirection;\par
03693     \}\par
03694 \par
03695     {\cf20 // Validate and fix invalid display order data}\par
03696     {\cf17 const} ImU64 expected_display_order_mask = (settings->ColumnsCount == 64) ? ~0 : ((ImU64)1 << settings->ColumnsCount) - 1;\par
03697     {\cf19 if} (display_order_mask != expected_display_order_mask)\par
03698         {\cf19 for} ({\cf18 int} column_n = 0; column_n < table->ColumnsCount; column_n++)\par
03699             table->Columns[column_n].DisplayOrder = (ImGuiTableColumnIdx)column_n;\par
03700 \par
03701     {\cf20 // Rebuild index}\par
03702     {\cf19 for} ({\cf18 int} column_n = 0; column_n < table->ColumnsCount; column_n++)\par
03703         table->DisplayOrderToIndex[table->Columns[column_n].DisplayOrder] = (ImGuiTableColumnIdx)column_n;\par
03704 \}\par
