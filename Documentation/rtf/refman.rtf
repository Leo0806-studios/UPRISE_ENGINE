14323 {\cf20 // Internal version that takes a position to decide on newline placement and pad items according to their depth.}\par
14324 {\cf20 // We split text into individual lines to add current tree level padding}\par
14325 {\cf20 // FIXME: This code is a little complicated perhaps, considering simplifying the whole system.}\par
14326 {\cf18 void} ImGui::LogRenderedText({\cf17 const} ImVec2* ref_pos, {\cf17 const} {\cf18 char}* text, {\cf17 const} {\cf18 char}* text_end)\par
14327 \{\par
14328     ImGuiContext& g = *GImGui;\par
14329     ImGuiWindow* window = g.CurrentWindow;\par
14330 \par
14331     {\cf17 const} {\cf18 char}* prefix = g.LogNextPrefix;\par
14332     {\cf17 const} {\cf18 char}* suffix = g.LogNextSuffix;\par
14333     g.LogNextPrefix = g.LogNextSuffix = NULL;\par
14334 \par
14335     {\cf19 if} (!text_end)\par
14336         text_end = FindRenderedTextEnd(text, text_end);\par
14337 \par
14338     {\cf17 const} {\cf18 bool} log_new_line = ref_pos && (ref_pos->y > g.LogLinePosY + g.Style.FramePadding.y + 1);\par
14339     {\cf19 if} (ref_pos)\par
14340         g.LogLinePosY = ref_pos->y;\par
14341     {\cf19 if} (log_new_line)\par
14342     \{\par
14343         LogText(IM_NEWLINE);\par
14344         g.LogLineFirstItem = {\cf17 true};\par
14345     \}\par
14346 \par
14347     {\cf19 if} (prefix)\par
14348         LogRenderedText(ref_pos, prefix, prefix + strlen(prefix)); {\cf20 // Calculate end ourself to ensure "##" are included here.}\par
14349 \par
14350     {\cf20 // Re-adjust padding if we have popped out of our starting depth}\par
14351     {\cf19 if} (g.LogDepthRef > window->DC.TreeDepth)\par
14352         g.LogDepthRef = window->DC.TreeDepth;\par
14353     {\cf17 const} {\cf18 int} tree_depth = (window->DC.TreeDepth - g.LogDepthRef);\par
14354 \par
14355     {\cf17 const} {\cf18 char}* text_remaining = text;\par
14356     {\cf19 for} (;;)\par
14357     \{\par
14358         {\cf20 // Split the string. Each new line (after a '\\n') is followed by indentation corresponding to the current depth of our log entry.}\par
14359         {\cf20 // We don't add a trailing \\n yet to allow a subsequent item on the same line to be captured.}\par
14360         {\cf17 const} {\cf18 char}* line_start = text_remaining;\par
14361         {\cf17 const} {\cf18 char}* line_end = ImStreolRange(line_start, text_end);\par
14362         {\cf17 const} {\cf18 bool} is_last_line = (line_end == text_end);\par
14363         {\cf19 if} (line_start != line_end || !is_last_line)\par
14364         \{\par
14365             {\cf17 const} {\cf18 int} line_length = (int)(line_end - line_start);\par
14366             {\cf17 const} {\cf18 int} indentation = g.LogLineFirstItem ? tree_depth * 4 : 1;\par
14367             LogText({\cf22 "%*s%.*s"}, indentation, {\cf22 ""}, line_length, line_start);\par
14368             g.LogLineFirstItem = {\cf17 false};\par
14369             {\cf19 if} (*line_end == {\cf23 '\\n'})\par
14370             \{\par
14371                 LogText(IM_NEWLINE);\par
14372                 g.LogLineFirstItem = {\cf17 true};\par
14373             \}\par
14374         \}\par
14375         {\cf19 if} (is_last_line)\par
14376             {\cf19 break};\par
14377         text_remaining = line_end + 1;\par
14378     \}\par
14379 \par
14380     {\cf19 if} (suffix)\par
14381         LogRenderedText(ref_pos, suffix, suffix + strlen(suffix));\par
14382 \}\par
