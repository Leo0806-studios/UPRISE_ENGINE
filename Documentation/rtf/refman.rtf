02558 {\cf20 // Convert rgb floats ([0-1],[0-1],[0-1]) to hsv floats ([0-1],[0-1],[0-1]), from Foley & van Dam p592}\par
02559 {\cf20 // Optimized http://lolengine.net/blog/2013/01/13/fast-rgb-to-hsv}\par
02560 {\cf18 void} ImGui::ColorConvertRGBtoHSV({\cf18 float} r, {\cf18 float} g, {\cf18 float} b, {\cf18 float}& out_h, {\cf18 float}& out_s, {\cf18 float}& out_v)\par
02561 \{\par
02562     {\cf18 float} K = 0.f;\par
02563     {\cf19 if} (g < b)\par
02564     \{\par
02565         ImSwap(g, b);\par
02566         K = -1.f;\par
02567     \}\par
02568     {\cf19 if} (r < g)\par
02569     \{\par
02570         ImSwap(r, g);\par
02571         K = -2.f / 6.f - K;\par
02572     \}\par
02573 \par
02574     {\cf17 const} {\cf18 float} chroma = r - (g < b ? g : b);\par
02575     out_h = ImFabs(K + (g - b) / (6.f * chroma + 1e-20f));\par
02576     out_s = chroma / (r + 1e-20f);\par
02577     out_v = r;\par
02578 \}\par
02579 \par
02580 {\cf20 // Convert hsv floats ([0-1],[0-1],[0-1]) to rgb floats ([0-1],[0-1],[0-1]), from Foley & van Dam p593}\par
02581 {\cf20 // also http://en.wikipedia.org/wiki/HSL_and_HSV}\par
02582 {\cf18 void} ImGui::ColorConvertHSVtoRGB({\cf18 float} h, {\cf18 float} s, {\cf18 float} v, {\cf18 float}& out_r, {\cf18 float}& out_g, {\cf18 float}& out_b)\par
02583 \{\par
02584     {\cf19 if} (s == 0.0f)\par
02585     \{\par
02586         {\cf20 // gray}\par
02587         out_r = out_g = out_b = v;\par
02588         {\cf19 return};\par
02589     \}\par
02590 \par
02591     h = ImFmod(h, 1.0f) / (60.0f / 360.0f);\par
02592     {\cf18 int}   i = (int)h;\par
02593     {\cf18 float} f = h - (float)i;\par
02594     {\cf18 float} p = v * (1.0f - s);\par
02595     {\cf18 float} q = v * (1.0f - s * f);\par
02596     {\cf18 float} t = v * (1.0f - s * (1.0f - f));\par
02597 \par
02598     {\cf19 switch} (i)\par
02599     \{\par
02600     {\cf19 case} 0: out_r = v; out_g = t; out_b = p; {\cf19 break};\par
02601     {\cf19 case} 1: out_r = q; out_g = v; out_b = p; {\cf19 break};\par
02602     {\cf19 case} 2: out_r = p; out_g = v; out_b = t; {\cf19 break};\par
02603     {\cf19 case} 3: out_r = p; out_g = q; out_b = v; {\cf19 break};\par
02604     {\cf19 case} 4: out_r = t; out_g = p; out_b = v; {\cf19 break};\par
02605     {\cf19 case} 5: {\cf19 default}: out_r = v; out_g = p; out_b = q; {\cf19 break};\par
02606     \}\par
02607 \}\par
