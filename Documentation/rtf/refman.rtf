00582             \}\par
00583             {\cf19 if} (bd->IndexBufferSize < idx_buffer_size)\par
00584             \{\par
00585                 bd->IndexBufferSize = idx_buffer_size;\par
00586                 GL_CALL(glBufferData(GL_ELEMENT_ARRAY_BUFFER, bd->IndexBufferSize, {\cf17 nullptr}, GL_STREAM_DRAW));\par
00587             \}\par
00588             GL_CALL(glBufferSubData(GL_ARRAY_BUFFER, 0, vtx_buffer_size, ({\cf17 const} GLvoid*)cmd_list->VtxBuffer.Data));\par
00589             GL_CALL(glBufferSubData(GL_ELEMENT_ARRAY_BUFFER, 0, idx_buffer_size, ({\cf17 const} GLvoid*)cmd_list->IdxBuffer.Data));\par
00590         \}\par
