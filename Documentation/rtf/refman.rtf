15898 {\cf18 void} ImGui::DestroyPlatformWindow(ImGuiViewportP* viewport)\par
15899 \{\par
15900     ImGuiContext& g = *GImGui;\par
15901     {\cf19 if} (viewport->PlatformWindowCreated)\par
15902     \{\par
15903         IMGUI_DEBUG_LOG_VIEWPORT({\cf22 "[viewport] Destroy Platform Window %08X '%s'\\n"}, viewport->ID, viewport->Window ? viewport->Window->Name : {\cf22 "n/a"});\par
15904         {\cf19 if} (g.PlatformIO.Renderer_DestroyWindow)\par
15905             g.PlatformIO.Renderer_DestroyWindow(viewport);\par
15906         {\cf19 if} (g.PlatformIO.Platform_DestroyWindow)\par
15907             g.PlatformIO.Platform_DestroyWindow(viewport);\par
15908         IM_ASSERT(viewport->RendererUserData == NULL && viewport->PlatformUserData == NULL);\par
15909 \par
15910         {\cf20 // Don't clear PlatformWindowCreated for the main viewport, as we initially set that up to true in Initialize()}\par
15911         {\cf20 // The righter way may be to leave it to the backend to set this flag all-together, and made the flag public.}\par
15912         {\cf19 if} (viewport->ID != IMGUI_VIEWPORT_DEFAULT_ID)\par
15913             viewport->PlatformWindowCreated = {\cf17 false};\par
15914     \}\par
15915     {\cf19 else}\par
15916     \{\par
15917         IM_ASSERT(viewport->RendererUserData == NULL && viewport->PlatformUserData == NULL && viewport->PlatformHandle == NULL);\par
15918     \}\par
15919     viewport->RendererUserData = viewport->PlatformUserData = viewport->PlatformHandle = NULL;\par
15920     viewport->ClearRequestFlags();\par
15921 \}\par
15922 \par
15923 {\cf18 void} ImGui::DestroyPlatformWindows()\par
15924 \{\par
15925     {\cf20 // We call the destroy window on every viewport (including the main viewport, index 0) to give a chance to the backend}\par
15926     {\cf20 // to clear any data they may have stored in e.g. PlatformUserData, RendererUserData.}\par
15927     {\cf20 // It is convenient for the platform backend code to store something in the main viewport, in order for e.g. the mouse handling}\par
15928     {\cf20 // code to operator a consistent manner.}\par
15929     {\cf20 // It is expected that the backend can handle calls to Renderer_DestroyWindow/Platform_DestroyWindow without}\par
15930     {\cf20 // crashing if it doesn't have data stored.}\par
15931     ImGuiContext& g = *GImGui;\par
15932     {\cf19 for} (ImGuiViewportP* viewport : g.Viewports)\par
15933         DestroyPlatformWindow(viewport);\par
15934 \}\par
