02247 \{\par
02248 {\cf21 #if defined(_WIN32) && !defined(IMGUI_DISABLE_WIN32_FUNCTIONS) && !defined(__CYGWIN__) && !defined(__GNUC__)}\par
02249     {\cf20 // We need a fopen() wrapper because MSVC/Windows fopen doesn't handle UTF-8 filenames.}\par
