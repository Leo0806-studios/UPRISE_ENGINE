19369 {\cf17 static} ImGuiDockNode* ImGui::DockContextBindNodeToWindow(ImGuiContext* ctx, ImGuiWindow* window)\par
19370 \{\par
19371     ImGuiContext& g = *ctx;\par
19372     ImGuiDockNode* node = DockContextFindNodeByID(ctx, window->DockId);\par
19373     IM_ASSERT(window->DockNode == NULL);\par
19374 \par
19375     {\cf20 // We should not be docking into a split node (SetWindowDock should avoid this)}\par
19376     {\cf19 if} (node && node->IsSplitNode())\par
19377     \{\par
19378         DockContextProcessUndockWindow(ctx, window);\par
19379         {\cf19 return} NULL;\par
19380     \}\par
19381 \par
19382     {\cf20 // Create node}\par
19383     {\cf19 if} (node == NULL)\par
19384     \{\par
19385         node = DockContextAddNode(ctx, window->DockId);\par
19386         node->AuthorityForPos = node->AuthorityForSize = node->AuthorityForViewport = ImGuiDataAuthority_Window;\par
19387         node->LastFrameAlive = g.FrameCount;\par
19388     \}\par
19389 \par
19390     {\cf20 // If the node just turned visible and is part of a hierarchy, it doesn't have a Size assigned by DockNodeTreeUpdatePosSize() yet,}\par
19391     {\cf20 // so we're forcing a Pos/Size update from the first ancestor that is already visible (often it will be the root node).}\par
19392     {\cf20 // If we don't do this, the window will be assigned a zero-size on its first frame, which won't ideally warm up the layout.}\par
19393     {\cf20 // This is a little wonky because we don't normally update the Pos/Size of visible node mid-frame.}\par
19394     {\cf19 if} (!node->IsVisible)\par
19395     \{\par
19396         ImGuiDockNode* ancestor_node = node;\par
19397         {\cf19 while} (!ancestor_node->IsVisible && ancestor_node->ParentNode)\par
19398             ancestor_node = ancestor_node->ParentNode;\par
19399         IM_ASSERT(ancestor_node->Size.x > 0.0f && ancestor_node->Size.y > 0.0f);\par
19400         DockNodeUpdateHasCentralNodeChild(DockNodeGetRootNode(ancestor_node));\par
19401         DockNodeTreeUpdatePosSize(ancestor_node, ancestor_node->Pos, ancestor_node->Size, node);\par
19402     \}\par
19403 \par
19404     {\cf20 // Add window to node}\par
19405     {\cf18 bool} node_was_visible = node->IsVisible;\par
19406     DockNodeAddWindow(node, window, {\cf17 true});\par
19407     node->IsVisible = node_was_visible; {\cf20 // Don't mark visible right away (so DockContextEndFrame() doesn't render it, maybe other side effects? will see)}\par
19408     IM_ASSERT(node == window->DockNode);\par
19409     {\cf19 return} node;\par
19410 \}\par
