16709     IMGUI_DEBUG_LOG_DOCKING({\cf22 "[docking] DockContextProcessUndockWindow window '%s', clear_persistent_docking_ref = %d\\n"}, window->Name, clear_persistent_docking_ref);\par
16710     {\cf19 if} (window->DockNode)\par
16711         DockNodeRemoveWindow(window->DockNode, window, clear_persistent_docking_ref ? 0 : window->DockId);\par
16712     {\cf19 else}\par
16713         window->DockId = 0;\par
16714     window->Collapsed = {\cf17 false};\par
16715     window->DockIsActive = {\cf17 false};\par
16716     window->DockNodeIsVisible = window->DockTabIsVisible = {\cf17 false};\par
