17685 {\cf20 // Submit the tab bar corresponding to a dock node and various housekeeping details.}\par
17686 {\cf17 static} {\cf18 void} ImGui::DockNodeUpdateTabBar(ImGuiDockNode* node, ImGuiWindow* host_window)\par
17687 \{\par
17688     ImGuiContext& g = *GImGui;\par
17689     ImGuiStyle& style = g.Style;\par
17690 \par
17691     {\cf17 const} {\cf18 bool} node_was_active = (node->LastFrameActive + 1 == g.FrameCount);\par
17692     {\cf17 const} {\cf18 bool} closed_all = node->WantCloseAll && node_was_active;\par
17693     {\cf17 const} ImGuiID closed_one = node->WantCloseTabId && node_was_active;\par
17694     node->WantCloseAll = {\cf17 false};\par
17695     node->WantCloseTabId = 0;\par
17696 \par
17697     {\cf20 // Decide if we should use a focused title bar color}\par
17698     {\cf18 bool} is_focused = {\cf17 false};\par
17699     ImGuiDockNode* root_node = DockNodeGetRootNode(node);\par
17700     {\cf19 if} (IsDockNodeTitleBarHighlighted(node, root_node))\par
17701         is_focused = {\cf17 true};\par
17702 \par
17703     {\cf20 // Hidden tab bar will show a triangle on the upper-left (in Begin)}\par
17704     {\cf19 if} (node->IsHiddenTabBar() || node->IsNoTabBar())\par
17705     \{\par
17706         node->VisibleWindow = (node->Windows.Size > 0) ? node->Windows[0] : NULL;\par
17707         node->IsFocused = is_focused;\par
17708         {\cf19 if} (is_focused)\par
17709             node->LastFrameFocused = g.FrameCount;\par
17710         {\cf19 if} (node->VisibleWindow)\par
17711         \{\par
17712             {\cf20 // Notify root of visible window (used to display title in OS task bar)}\par
17713             {\cf19 if} (is_focused || root_node->VisibleWindow == NULL)\par
17714                 root_node->VisibleWindow = node->VisibleWindow;\par
17715             {\cf19 if} (node->TabBar)\par
17716                 node->TabBar->VisibleTabId = node->VisibleWindow->TabId;\par
17717         \}\par
17718         {\cf19 return};\par
17719     \}\par
17720 \par
17721     {\cf20 // Move ourselves to the Menu layer (so we can be accessed by tapping Alt) + undo SkipItems flag in order to draw over the title bar even if the window is collapsed}\par
17722     {\cf18 bool} backup_skip_item = host_window->SkipItems;\par
17723     {\cf19 if} (!node->IsDockSpace())\par
17724     \{\par
17725         host_window->SkipItems = {\cf17 false};\par
17726         host_window->DC.NavLayerCurrent = ImGuiNavLayer_Menu;\par
17727     \}\par
17728 \par
17729     {\cf20 // Use PushOverrideID() instead of PushID() to use the node id _without_ the host window ID.}\par
17730     {\cf20 // This is to facilitate computing those ID from the outside, and will affect more or less only the ID of the collapse button, popup and tabs,}\par
17731     {\cf20 // as docked windows themselves will override the stack with their own root ID.}\par
17732     PushOverrideID(node->ID);\par
17733     ImGuiTabBar* tab_bar = node->TabBar;\par
17734     {\cf18 bool} tab_bar_is_recreated = (tab_bar == NULL); {\cf20 // Tab bar are automatically destroyed when a node gets hidden}\par
17735     {\cf19 if} (tab_bar == NULL)\par
17736     \{\par
17737         DockNodeAddTabBar(node);\par
17738         tab_bar = node->TabBar;\par
17739     \}\par
17740 \par
17741     ImGuiID focus_tab_id = 0;\par
17742     node->IsFocused = is_focused;\par
17743 \par
17744     {\cf17 const} ImGuiDockNodeFlags node_flags = node->MergedFlags;\par
17745     {\cf17 const} {\cf18 bool} has_window_menu_button = (node_flags & ImGuiDockNodeFlags_NoWindowMenuButton) == 0 && (style.WindowMenuButtonPosition != ImGuiDir_None);\par
17746 \par
17747     {\cf20 // In a dock node, the Collapse Button turns into the Window Menu button.}\par
17748     {\cf20 // FIXME-DOCK FIXME-OPT: Could we recycle popups id across multiple dock nodes?}\par
17749     {\cf19 if} (has_window_menu_button && IsPopupOpen({\cf22 "#WindowMenu"}))\par
17750     \{\par
17751         ImGuiID next_selected_tab_id = tab_bar->NextSelectedTabId;\par
17752         DockNodeWindowMenuUpdate(node, tab_bar);\par
17753         {\cf19 if} (tab_bar->NextSelectedTabId != 0 && tab_bar->NextSelectedTabId != next_selected_tab_id)\par
17754             focus_tab_id = tab_bar->NextSelectedTabId;\par
17755         is_focused |= node->IsFocused;\par
17756     \}\par
17757 \par
17758     {\cf20 // Layout}\par
17759     ImRect title_bar_rect, tab_bar_rect;\par
17760     ImVec2 window_menu_button_pos;\par
17761     ImVec2 close_button_pos;\par
17762     DockNodeCalcTabBarLayout(node, &title_bar_rect, &tab_bar_rect, &window_menu_button_pos, &close_button_pos);\par
17763 \par
17764     {\cf20 // Submit new tabs, they will be added as Unsorted and sorted below based on relative DockOrder value.}\par
17765     {\cf17 const} {\cf18 int} tabs_count_old = tab_bar->Tabs.Size;\par
17766     {\cf19 for} ({\cf18 int} window_n = 0; window_n < node->Windows.Size; window_n++)\par
17767     \{\par
17768         ImGuiWindow* window = node->Windows[window_n];\par
17769         {\cf19 if} (TabBarFindTabByID(tab_bar, window->TabId) == NULL)\par
17770             TabBarAddTab(tab_bar, ImGuiTabItemFlags_Unsorted, window);\par
17771     \}\par
17772 \par
17773     {\cf20 // Title bar}\par
17774     {\cf19 if} (is_focused)\par
17775         node->LastFrameFocused = g.FrameCount;\par
17776     ImU32 title_bar_col = GetColorU32(host_window->Collapsed ? ImGuiCol_TitleBgCollapsed : is_focused ? ImGuiCol_TitleBgActive : ImGuiCol_TitleBg);\par
17777     ImDrawFlags rounding_flags = CalcRoundingFlagsForRectInRect(title_bar_rect, host_window->Rect(), g.Style.DockingSeparatorSize);\par
17778     host_window->DrawList->AddRectFilled(title_bar_rect.Min, title_bar_rect.Max, title_bar_col, host_window->WindowRounding, rounding_flags);\par
17779 \par
17780     {\cf20 // Docking/Collapse button}\par
17781     {\cf19 if} (has_window_menu_button)\par
17782     \{\par
17783         {\cf19 if} (CollapseButton(host_window->GetID({\cf22 "#COLLAPSE"}), window_menu_button_pos, node)) {\cf20 // == DockNodeGetWindowMenuButtonId(node)}\par
17784             OpenPopup({\cf22 "#WindowMenu"});\par
17785         {\cf19 if} (IsItemActive())\par
17786             focus_tab_id = tab_bar->SelectedTabId;\par
17787         {\cf19 if} (IsItemHovered(ImGuiHoveredFlags_ForTooltip | ImGuiHoveredFlags_DelayNormal) && g.HoveredIdTimer > 0.5f)\par
17788             SetTooltip({\cf22 "%s"}, LocalizeGetMsg(ImGuiLocKey_DockingDragToUndockOrMoveNode));\par
17789     \}\par
17790 \par
17791     {\cf20 // If multiple tabs are appearing on the same frame, sort them based on their persistent DockOrder value}\par
17792     {\cf18 int} tabs_unsorted_start = tab_bar->Tabs.Size;\par
17793     {\cf19 for} ({\cf18 int} tab_n = tab_bar->Tabs.Size - 1; tab_n >= 0 && (tab_bar->Tabs[tab_n].Flags & ImGuiTabItemFlags_Unsorted); tab_n--)\par
17794     \{\par
17795         {\cf20 // FIXME-DOCK: Consider only clearing the flag after the tab has been alive for a few consecutive frames, allowing late comers to not break sorting?}\par
17796         tab_bar->Tabs[tab_n].Flags &= ~ImGuiTabItemFlags_Unsorted;\par
17797         tabs_unsorted_start = tab_n;\par
17798     \}\par
17799     {\cf19 if} (tab_bar->Tabs.Size > tabs_unsorted_start)\par
17800     \{\par
17801         IMGUI_DEBUG_LOG_DOCKING({\cf22 "[docking] In node 0x%08X: %d new appearing tabs:%s\\n"}, node->ID, tab_bar->Tabs.Size - tabs_unsorted_start, (tab_bar->Tabs.Size > tabs_unsorted_start + 1) ? {\cf22 " (will sort)"} : {\cf22 ""});\par
17802         {\cf19 for} ({\cf18 int} tab_n = tabs_unsorted_start; tab_n < tab_bar->Tabs.Size; tab_n++)\par
17803         \{\par
17804             ImGuiTabItem* tab = &tab_bar->Tabs[tab_n];\par
17805             IMGUI_DEBUG_LOG_DOCKING({\cf22 "[docking] - Tab 0x%08X '%s' Order %d\\n"}, tab->ID, TabBarGetTabName(tab_bar, tab), tab->Window ? tab->Window->DockOrder : -1);\par
17806         \}\par
17807         IMGUI_DEBUG_LOG_DOCKING({\cf22 "[docking] SelectedTabId = 0x%08X, NavWindow->TabId = 0x%08X\\n"}, node->SelectedTabId, g.NavWindow ? g.NavWindow->TabId : -1);\par
17808         {\cf19 if} (tab_bar->Tabs.Size > tabs_unsorted_start + 1)\par
17809             ImQsort(tab_bar->Tabs.Data + tabs_unsorted_start, tab_bar->Tabs.Size - tabs_unsorted_start, {\cf17 sizeof}(ImGuiTabItem), TabItemComparerByDockOrder);\par
17810     \}\par
17811 \par
17812     {\cf20 // Apply NavWindow focus back to the tab bar}\par
17813     {\cf19 if} (g.NavWindow && g.NavWindow->RootWindow->DockNode == node)\par
17814         tab_bar->SelectedTabId = g.NavWindow->RootWindow->TabId;\par
17815 \par
17816     {\cf20 // Selected newly added tabs, or persistent tab ID if the tab bar was just recreated}\par
17817     {\cf19 if} (tab_bar_is_recreated && TabBarFindTabByID(tab_bar, node->SelectedTabId) != NULL)\par
17818         tab_bar->SelectedTabId = tab_bar->NextSelectedTabId = node->SelectedTabId;\par
17819     {\cf19 else} {\cf19 if} (tab_bar->Tabs.Size > tabs_count_old)\par
17820         tab_bar->SelectedTabId = tab_bar->NextSelectedTabId = tab_bar->Tabs.back().Window->TabId;\par
17821 \par
17822     {\cf20 // Begin tab bar}\par
17823     ImGuiTabBarFlags tab_bar_flags = ImGuiTabBarFlags_Reorderable | ImGuiTabBarFlags_AutoSelectNewTabs; {\cf20 // | ImGuiTabBarFlags_NoTabListScrollingButtons);}\par
17824     tab_bar_flags |= ImGuiTabBarFlags_SaveSettings | ImGuiTabBarFlags_DockNode;{\cf20 // | ImGuiTabBarFlags_FittingPolicyScroll;}\par
17825     tab_bar_flags |= ImGuiTabBarFlags_DrawSelectedOverline;\par
17826     {\cf19 if} (!host_window->Collapsed && is_focused)\par
17827         tab_bar_flags |= ImGuiTabBarFlags_IsFocused;\par
17828     tab_bar->ID = GetID({\cf22 "#TabBar"});\par
17829     tab_bar->SeparatorMinX = node->Pos.x + host_window->WindowBorderSize; {\cf20 // Separator cover the whole node width}\par
17830     tab_bar->SeparatorMaxX = node->Pos.x + node->Size.x - host_window->WindowBorderSize;\par
17831     BeginTabBarEx(tab_bar, tab_bar_rect, tab_bar_flags);\par
17832     {\cf20 //host_window->DrawList->AddRect(tab_bar_rect.Min, tab_bar_rect.Max, IM_COL32(255,0,255,255));}\par
17833 \par
17834     {\cf20 // Backup style colors}\par
17835     ImVec4 backup_style_cols[ImGuiWindowDockStyleCol_COUNT];\par
17836     {\cf19 for} ({\cf18 int} color_n = 0; color_n < ImGuiWindowDockStyleCol_COUNT; color_n++)\par
17837         backup_style_cols[color_n] = g.Style.Colors[GWindowDockStyleColors[color_n]];\par
17838 \par
17839     {\cf20 // Submit actual tabs}\par
17840     node->VisibleWindow = NULL;\par
17841     {\cf19 for} ({\cf18 int} window_n = 0; window_n < node->Windows.Size; window_n++)\par
17842     \{\par
17843         ImGuiWindow* window = node->Windows[window_n];\par
17844         {\cf19 if} ((closed_all || closed_one == window->TabId) && window->HasCloseButton && !(window->Flags & ImGuiWindowFlags_UnsavedDocument))\par
17845             {\cf19 continue};\par
17846         {\cf19 if} (window->LastFrameActive + 1 >= g.FrameCount || !node_was_active)\par
17847         \{\par
17848             ImGuiTabItemFlags tab_item_flags = 0;\par
17849             tab_item_flags |= window->WindowClass.TabItemFlagsOverrideSet;\par
17850             {\cf19 if} (window->Flags & ImGuiWindowFlags_UnsavedDocument)\par
17851                 tab_item_flags |= ImGuiTabItemFlags_UnsavedDocument;\par
17852             {\cf19 if} (tab_bar->Flags & ImGuiTabBarFlags_NoCloseWithMiddleMouseButton)\par
17853                 tab_item_flags |= ImGuiTabItemFlags_NoCloseWithMiddleMouseButton;\par
17854 \par
17855             {\cf20 // Apply stored style overrides for the window}\par
17856             {\cf19 for} ({\cf18 int} color_n = 0; color_n < ImGuiWindowDockStyleCol_COUNT; color_n++)\par
17857                 g.Style.Colors[GWindowDockStyleColors[color_n]] = ColorConvertU32ToFloat4(window->DockStyle.Colors[color_n]);\par
17858 \par
17859             {\cf20 // Note that TabItemEx() calls TabBarCalcTabID() so our tab item ID will ignore the current ID stack (rightly so)}\par
17860             {\cf18 bool} tab_open = {\cf17 true};\par
17861             TabItemEx(tab_bar, window->Name, window->HasCloseButton ? &tab_open : NULL, tab_item_flags, window);\par
