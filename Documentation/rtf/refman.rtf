00094                 {\cf20 //int cpuInfo[4] = \{-1\};}\par
00095                 std::array<int, 4> cpui;\par
00096 \par
00097                 {\cf20 // Calling __cpuid with 0x0 as the function_id argument}\par
00098                 {\cf20 // gets the number of the highest valid function ID.}\par
00099                 __cpuid(cpui.data(), 0);\par
00100                 nIds_ = cpui[0];\par
00101 \par
00102                 {\cf19 for} ({\cf18 int} i = 0; i <= nIds_; ++i)\par
00103                 \{\par
00104                     __cpuidex(cpui.data(), i, 0);\par
00105                     data_.push_back(cpui);\par
00106                 \}\par
00107 \par
00108                 {\cf20 // Capture vendor string}\par
00109                 {\cf18 char} vendor[0x20];\par
