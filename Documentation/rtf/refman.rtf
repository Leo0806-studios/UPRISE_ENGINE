03725 {\cf18 void} ImFont::GrowIndex({\cf18 int} new_size)\par
03726 \{\par
03727     IM_ASSERT(IndexAdvanceX.Size == IndexLookup.Size);\par
03728     {\cf19 if} (new_size <= IndexLookup.Size)\par
03729         {\cf19 return};\par
03730     IndexAdvanceX.resize(new_size, -1.0f);\par
03731     IndexLookup.resize(new_size, (ImWchar)-1);\par
03732 \}\par
03733 \par
03734 {\cf20 // x0/y0/x1/y1 are offset from the character upper-left layout position, in pixels. Therefore x0/y0 are often fairly close to zero.}\par
03735 {\cf20 // Not to be mistaken with texture coordinates, which are held by u0/v0/u1/v1 in normalized format (0.0..1.0 on each texture axis).}\par
03736 {\cf20 // 'cfg' is not necessarily == 'this->ConfigData' because multiple source fonts+configs can be used to build one target font.}\par
03737 {\cf18 void} ImFont::AddGlyph({\cf17 const} ImFontConfig* cfg, ImWchar codepoint, {\cf18 float} x0, {\cf18 float} y0, {\cf18 float} x1, {\cf18 float} y1, {\cf18 float} u0, {\cf18 float} v0, {\cf18 float} u1, {\cf18 float} v1, {\cf18 float} advance_x)\par
03738 \{\par
03739     {\cf19 if} (cfg != NULL)\par
03740     \{\par
03741         {\cf20 // Clamp & recenter if needed}\par
03742         {\cf17 const} {\cf18 float} advance_x_original = advance_x;\par
03743         advance_x = ImClamp(advance_x, cfg->GlyphMinAdvanceX, cfg->GlyphMaxAdvanceX);\par
03744         {\cf19 if} (advance_x != advance_x_original)\par
03745         \{\par
03746             {\cf18 float} char_off_x = cfg->PixelSnapH ? ImTrunc((advance_x - advance_x_original) * 0.5f) : (advance_x - advance_x_original) * 0.5f;\par
03747             x0 += char_off_x;\par
03748             x1 += char_off_x;\par
03749         \}\par
03750 \par
03751         {\cf20 // Snap to pixel}\par
03752         {\cf19 if} (cfg->PixelSnapH)\par
03753             advance_x = IM_ROUND(advance_x);\par
03754 \par
03755         {\cf20 // Bake spacing}\par
03756         advance_x += cfg->GlyphExtraSpacing.x;\par
03757     \}\par
03758 \par
03759     Glyphs.resize(Glyphs.Size + 1);\par
03760     ImFontGlyph& glyph = Glyphs.back();\par
03761     glyph.Codepoint = ({\cf18 unsigned} int)codepoint;\par
03762     glyph.Visible = (x0 != x1) && (y0 != y1);\par
03763     glyph.Colored = {\cf17 false};\par
03764     glyph.X0 = x0;\par
03765     glyph.Y0 = y0;\par
03766     glyph.X1 = x1;\par
03767     glyph.Y1 = y1;\par
03768     glyph.U0 = u0;\par
03769     glyph.V0 = v0;\par
03770     glyph.U1 = u1;\par
03771     glyph.V1 = v1;\par
03772     glyph.AdvanceX = advance_x;\par
03773 \par
03774     {\cf20 // Compute rough surface usage metrics (+1 to account for average padding, +0.99 to round)}\par
03775     {\cf20 // We use (U1-U0)*TexWidth instead of X1-X0 to account for oversampling.}\par
03776     {\cf18 float} pad = ContainerAtlas->TexGlyphPadding + 0.99f;\par
03777     DirtyLookupTables = {\cf17 true};\par
03778     MetricsTotalSurface += (int)((glyph.U1 - glyph.U0) * ContainerAtlas->TexWidth + pad) * ({\cf18 int})((glyph.V1 - glyph.V0) * ContainerAtlas->TexHeight + pad);\par
03779 \}\par
03780 \par
03781 {\cf18 void} ImFont::AddRemapChar(ImWchar dst, ImWchar src, {\cf18 bool} overwrite_dst)\par
03782 \{\par
03783     IM_ASSERT(IndexLookup.Size > 0);    {\cf20 // Currently this can only be called AFTER the font has been built, aka after calling ImFontAtlas::GetTexDataAs*() function.}\par
03784     {\cf18 unsigned} {\cf18 int} index_size = ({\cf18 unsigned} int)IndexLookup.Size;\par
03785 \par
03786     {\cf19 if} (dst < index_size && IndexLookup.Data[dst] == (ImWchar)-1 && !overwrite_dst) {\cf20 // 'dst' already exists}\par
03787         {\cf19 return};\par
03788     {\cf19 if} (src >= index_size && dst >= index_size) {\cf20 // both 'dst' and 'src' don't exist -> no-op}\par
03789         {\cf19 return};\par
03790 \par
03791     GrowIndex(dst + 1);\par
03792     IndexLookup[dst] = (src < index_size) ? IndexLookup.Data[src] : (ImWchar)-1;\par
03793     IndexAdvanceX[dst] = (src < index_size) ? IndexAdvanceX.Data[src] : 1.0f;\par
03794 \}\par
03795 \par
03796 {\cf17 const} ImFontGlyph* ImFont::FindGlyph(ImWchar c){\cf17  const}\par
03797 {\cf17 }\{\par
03798     {\cf19 if} (c >= ({\cf18 size_t})IndexLookup.Size)\par
03799         {\cf19 return} FallbackGlyph;\par
03800     {\cf17 const} ImWchar i = IndexLookup.Data[c];\par
03801     {\cf19 if} (i == (ImWchar)-1)\par
03802         {\cf19 return} FallbackGlyph;\par
03803     {\cf19 return} &Glyphs.Data[i];\par
03804 \}\par
03805 \par
03806 {\cf17 const} ImFontGlyph* ImFont::FindGlyphNoFallback(ImWchar c){\cf17  const}\par
03807 {\cf17 }\{\par
03808     {\cf19 if} (c >= ({\cf18 size_t})IndexLookup.Size)\par
03809         {\cf19 return} NULL;\par
03810     {\cf17 const} ImWchar i = IndexLookup.Data[c];\par
03811     {\cf19 if} (i == (ImWchar)-1)\par
03812         {\cf19 return} NULL;\par
03813     {\cf19 return} &Glyphs.Data[i];\par
03814 \}\par
03815 \par
03816 {\cf20 // Wrapping skips upcoming blanks}\par
03817 {\cf17 static} {\cf17 inline} {\cf17 const} {\cf18 char}* CalcWordWrapNextLineStartA({\cf17 const} {\cf18 char}* text, {\cf17 const} {\cf18 char}* text_end)\par
03818 \{\par
03819     {\cf19 while} (text < text_end && ImCharIsBlankA(*text))\par
03820         text++;\par
03821     {\cf19 if} (*text == {\cf23 '\\n'})\par
03822         text++;\par
03823     {\cf19 return} text;\par
03824 \}\par
03825 \par
03826 {\cf20 // Simple word-wrapping for English, not full-featured. Please submit failing cases!}\par
03827 {\cf20 // This will return the next location to wrap from. If no wrapping if necessary, this will fast-forward to e.g. text_end.}\par
03828 {\cf20 // FIXME: Much possible improvements (don't cut things like "word !", "word!!!" but cut within "word,,,,", more sensible support for punctuations, support for Unicode punctuations, etc.)}\par
03829 {\cf17 const} {\cf18 char}* ImFont::CalcWordWrapPositionA({\cf18 float} scale, {\cf17 const} {\cf18 char}* text, {\cf17 const} {\cf18 char}* text_end, {\cf18 float} wrap_width){\cf17  const}\par
03830 {\cf17 }\{\par
03831     {\cf20 // For references, possible wrap point marked with ^}\par
03832     {\cf20 //  "aaa bbb, ccc,ddd. eee   fff. ggg!"}\par
03833     {\cf20 //      ^    ^    ^   ^   ^__    ^    ^}\par
03834 \par
03835     {\cf20 // List of hardcoded separators: .,;!?'"}\par
03836 \par
03837     {\cf20 // Skip extra blanks after a line returns (that includes not counting them in width computation)}\par
03838     {\cf20 // e.g. "Hello    world" --> "Hello" "World"}\par
03839 \par
03840     {\cf20 // Cut words that cannot possibly fit within one line.}\par
03841     {\cf20 // e.g.: "The tropical fish" with ~5 characters worth of width --> "The tr" "opical" "fish"}\par
03842     {\cf18 float} line_width = 0.0f;\par
03843     {\cf18 float} word_width = 0.0f;\par
03844     {\cf18 float} blank_width = 0.0f;\par
03845     wrap_width /= scale; {\cf20 // We work with unscaled widths to avoid scaling every characters}\par
03846 \par
03847     {\cf17 const} {\cf18 char}* word_end = text;\par
03848     {\cf17 const} {\cf18 char}* prev_word_end = NULL;\par
03849     {\cf18 bool} inside_word = {\cf17 true};\par
03850 \par
03851     {\cf17 const} {\cf18 char}* s = text;\par
03852     IM_ASSERT(text_end != NULL);\par
03853     {\cf19 while} (s < text_end)\par
03854     \{\par
03855         {\cf18 unsigned} {\cf18 int} c = ({\cf18 unsigned} int)*s;\par
03856         {\cf17 const} {\cf18 char}* next_s;\par
03857         {\cf19 if} (c < 0x80)\par
03858             next_s = s + 1;\par
03859         {\cf19 else}\par
03860             next_s = s + ImTextCharFromUtf8(&c, s, text_end);\par
03861 \par
03862         {\cf19 if} (c < 32)\par
03863         \{\par
03864             {\cf19 if} (c == {\cf23 '\\n'})\par
03865             \{\par
03866                 line_width = word_width = blank_width = 0.0f;\par
03867                 inside_word = {\cf17 true};\par
03868                 s = next_s;\par
03869                 {\cf19 continue};\par
03870             \}\par
03871             {\cf19 if} (c == {\cf23 '\\r'})\par
03872             \{\par
03873                 s = next_s;\par
03874                 {\cf19 continue};\par
03875             \}\par
03876         \}\par
03877 \par
03878         {\cf17 const} {\cf18 float} char_width = ((int)c < IndexAdvanceX.Size ? IndexAdvanceX.Data[c] : FallbackAdvanceX);\par
03879         {\cf19 if} (ImCharIsBlankW(c))\par
03880         \{\par
03881             {\cf19 if} (inside_word)\par
03882             \{\par
03883                 line_width += blank_width;\par
03884                 blank_width = 0.0f;\par
03885                 word_end = s;\par
03886             \}\par
03887             blank_width += char_width;\par
03888             inside_word = {\cf17 false};\par
03889         \}\par
03890         {\cf19 else}\par
03891         \{\par
03892             word_width += char_width;\par
03893             {\cf19 if} (inside_word)\par
03894             \{\par
03895                 word_end = next_s;\par
03896             \}\par
03897             {\cf19 else}\par
03898             \{\par
03899                 prev_word_end = word_end;\par
03900                 line_width += word_width + blank_width;\par
03901                 word_width = blank_width = 0.0f;\par
03902             \}\par
03903 \par
03904             {\cf20 // Allow wrapping after punctuation.}\par
03905             inside_word = (c != {\cf23 '.'} && c != {\cf23 ','} && c != {\cf23 ';'} && c != {\cf23 '!'} && c != {\cf23 '?'} && c != {\cf23 '\\"'});\par
03906         \}\par
03907 \par
03908         {\cf20 // We ignore blank width at the end of the line (they can be skipped)}\par
03909         {\cf19 if} (line_width + word_width > wrap_width)\par
03910         \{\par
03911             {\cf20 // Words that cannot possibly fit within an entire line will be cut anywhere.}\par
03912             {\cf19 if} (word_width < wrap_width)\par
03913                 s = prev_word_end ? prev_word_end : word_end;\par
03914             {\cf19 break};\par
03915         \}\par
03916 \par
03917         s = next_s;\par
03918     \}\par
03919 \par
03920     {\cf20 // Wrap_width is too small to fit anything. Force displaying 1 character to minimize the height discontinuity.}\par
03921     {\cf20 // +1 may not be a character start point in UTF-8 but it's ok because caller loops use (text >= word_wrap_eol).}\par
03922     {\cf19 if} (s == text && text < text_end)\par
03923         {\cf19 return} s + 1;\par
03924     {\cf19 return} s;\par
03925 \}\par
03926 \par
03927 ImVec2 ImFont::CalcTextSizeA({\cf18 float} size, {\cf18 float} max_width, {\cf18 float} wrap_width, {\cf17 const} {\cf18 char}* text_begin, {\cf17 const} {\cf18 char}* text_end, {\cf17 const} {\cf18 char}** remaining){\cf17  const}\par
03928 {\cf17 }\{\par
03929     {\cf19 if} (!text_end)\par
03930         text_end = text_begin + strlen(text_begin); {\cf20 // FIXME-OPT: Need to avoid this.}\par
03931 \par
03932     {\cf17 const} {\cf18 float} line_height = size;\par
03933     {\cf17 const} {\cf18 float} scale = size / FontSize;\par
03934 \par
03935     ImVec2 text_size = ImVec2(0, 0);\par
03936     {\cf18 float} line_width = 0.0f;\par
03937 \par
03938     {\cf17 const} {\cf18 bool} word_wrap_enabled = (wrap_width > 0.0f);\par
03939     {\cf17 const} {\cf18 char}* word_wrap_eol = NULL;\par
03940 \par
03941     {\cf17 const} {\cf18 char}* s = text_begin;\par
03942     {\cf19 while} (s < text_end)\par
03943     \{\par
03944         {\cf19 if} (word_wrap_enabled)\par
03945         \{\par
03946             {\cf20 // Calculate how far we can render. Requires two passes on the string data but keeps the code simple and not intrusive for what's essentially an uncommon feature.}\par
03947             {\cf19 if} (!word_wrap_eol)\par
03948                 word_wrap_eol = CalcWordWrapPositionA(scale, s, text_end, wrap_width - line_width);\par
03949 \par
03950             {\cf19 if} (s >= word_wrap_eol)\par
03951             \{\par
03952                 {\cf19 if} (text_size.x < line_width)\par
03953                     text_size.x = line_width;\par
03954                 text_size.y += line_height;\par
03955                 line_width = 0.0f;\par
03956                 word_wrap_eol = NULL;\par
03957                 s = CalcWordWrapNextLineStartA(s, text_end); {\cf20 // Wrapping skips upcoming blanks}\par
03958                 {\cf19 continue};\par
03959             \}\par
03960         \}\par
03961 \par
03962         {\cf20 // Decode and advance source}\par
03963         {\cf17 const} {\cf18 char}* prev_s = s;\par
03964         {\cf18 unsigned} {\cf18 int} c = ({\cf18 unsigned} int)*s;\par
03965         {\cf19 if} (c < 0x80)\par
03966             s += 1;\par
03967         {\cf19 else}\par
03968             s += ImTextCharFromUtf8(&c, s, text_end);\par
03969 \par
03970         {\cf19 if} (c < 32)\par
03971         \{\par
03972             {\cf19 if} (c == {\cf23 '\\n'})\par
03973             \{\par
03974                 text_size.x = ImMax(text_size.x, line_width);\par
03975                 text_size.y += line_height;\par
03976                 line_width = 0.0f;\par
03977                 {\cf19 continue};\par
03978             \}\par
03979             {\cf19 if} (c == {\cf23 '\\r'})\par
03980                 {\cf19 continue};\par
03981         \}\par
03982 \par
03983         {\cf17 const} {\cf18 float} char_width = ((int)c < IndexAdvanceX.Size ? IndexAdvanceX.Data[c] : FallbackAdvanceX) * scale;\par
03984         {\cf19 if} (line_width + char_width >= max_width)\par
03985         \{\par
03986             s = prev_s;\par
03987             {\cf19 break};\par
03988         \}\par
03989 \par
03990         line_width += char_width;\par
03991     \}\par
03992 \par
03993     {\cf19 if} (text_size.x < line_width)\par
03994         text_size.x = line_width;\par
03995 \par
03996     {\cf19 if} (line_width > 0 || text_size.y == 0.0f)\par
03997         text_size.y += line_height;\par
03998 \par
03999     {\cf19 if} (remaining)\par
04000         *remaining = s;\par
04001 \par
04002     {\cf19 return} text_size;\par
04003 \}\par
