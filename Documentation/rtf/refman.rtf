14140 {\cf18 bool} ImGui::BeginDragDropTargetCustom({\cf17 const} ImRect& bb, ImGuiID {\cf18 id})\par
14141 \{\par
14142     ImGuiContext& g = *GImGui;\par
14143     {\cf19 if} (!g.DragDropActive)\par
14144         {\cf19 return} {\cf17 false};\par
14145 \par
14146     ImGuiWindow* window = g.CurrentWindow;\par
14147     ImGuiWindow* hovered_window = g.HoveredWindowUnderMovingWindow;\par
14148     {\cf19 if} (hovered_window == NULL || window->RootWindowDockTree != hovered_window->RootWindowDockTree)\par
14149         {\cf19 return} {\cf17 false};\par
14150     IM_ASSERT({\cf18 id} != 0);\par
14151     {\cf19 if} (!IsMouseHoveringRect(bb.Min, bb.Max) || ({\cf18 id} == g.DragDropPayload.SourceId))\par
14152         {\cf19 return} {\cf17 false};\par
14153     {\cf19 if} (window->SkipItems)\par
14154         {\cf19 return} {\cf17 false};\par
14155 \par
14156     IM_ASSERT(g.DragDropWithinTarget == {\cf17 false} && g.DragDropWithinSource == {\cf17 false}); {\cf20 // Can't nest BeginDragDropSource() and BeginDragDropTarget()}\par
14157     g.DragDropTargetRect = bb;\par
14158     g.DragDropTargetClipRect = window->ClipRect; {\cf20 // May want to be overridden by user depending on use case?}\par
14159     g.DragDropTargetId = id;\par
14160     g.DragDropWithinTarget = {\cf17 true};\par
14161     {\cf19 return} {\cf17 true};\par
14162 \}\par
14163 \par
14164 {\cf20 // We don't use BeginDragDropTargetCustom() and duplicate its code because:}\par
14165 {\cf20 // 1) we use LastItemData's ImGuiItemStatusFlags_HoveredRect which handles items that push a temporarily clip rectangle in their code. Calling BeginDragDropTargetCustom(LastItemRect) would not handle them.}\par
14166 {\cf20 // 2) and it's faster. as this code may be very frequently called, we want to early out as fast as we can.}\par
14167 {\cf20 // Also note how the HoveredWindow test is positioned differently in both functions (in both functions we optimize for the cheapest early out case)}\par
14168 {\cf18 bool} ImGui::BeginDragDropTarget()\par
14169 \{\par
14170     ImGuiContext& g = *GImGui;\par
14171     {\cf19 if} (!g.DragDropActive)\par
14172         {\cf19 return} {\cf17 false};\par
14173 \par
14174     ImGuiWindow* window = g.CurrentWindow;\par
14175     {\cf19 if} (!(g.LastItemData.StatusFlags & ImGuiItemStatusFlags_HoveredRect))\par
14176         {\cf19 return} {\cf17 false};\par
14177     ImGuiWindow* hovered_window = g.HoveredWindowUnderMovingWindow;\par
14178     {\cf19 if} (hovered_window == NULL || window->RootWindowDockTree != hovered_window->RootWindowDockTree || window->SkipItems)\par
14179         {\cf19 return} {\cf17 false};\par
14180 \par
14181     {\cf17 const} ImRect& display_rect = (g.LastItemData.StatusFlags & ImGuiItemStatusFlags_HasDisplayRect) ? g.LastItemData.DisplayRect : g.LastItemData.Rect;\par
14182     ImGuiID {\cf18 id} = g.LastItemData.ID;\par
14183     {\cf19 if} ({\cf18 id} == 0)\par
14184     \{\par
14185         {\cf18 id} = window->GetIDFromRectangle(display_rect);\par
14186         KeepAliveID({\cf18 id});\par
14187     \}\par
14188     {\cf19 if} (g.DragDropPayload.SourceId == {\cf18 id})\par
14189         {\cf19 return} {\cf17 false};\par
14190 \par
14191     IM_ASSERT(g.DragDropWithinTarget == {\cf17 false} && g.DragDropWithinSource == {\cf17 false}); {\cf20 // Can't nest BeginDragDropSource() and BeginDragDropTarget()}\par
14192     g.DragDropTargetRect = display_rect;\par
14193     g.DragDropTargetClipRect = (g.LastItemData.StatusFlags & ImGuiItemStatusFlags_HasClipRect) ? g.LastItemData.ClipRect : window->ClipRect;\par
14194     g.DragDropTargetId = id;\par
14195     g.DragDropWithinTarget = {\cf17 true};\par
14196     {\cf19 return} {\cf17 true};\par
14197 \}\par
