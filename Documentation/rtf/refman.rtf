15531     \{\par
15532         {\cf20 // This covers the "always inherit viewport from parent window" case for when a window reattach to a node that was just created mid-frame}\par
15533         window->Viewport = window->DockNode->HostWindow->Viewport;\par
15534     \}\par
15535     {\cf19 else} {\cf19 if} (flags & ImGuiWindowFlags_Tooltip)\par
15536     \{\par
15537         window->Viewport = g.MouseViewport;\par
15538     \}\par
15539     {\cf19 else} {\cf19 if} (GetWindowAlwaysWantOwnViewport(window))\par
15540     \{\par
15541         window->Viewport = AddUpdateViewport(window, window->ID, window->Pos, window->Size, ImGuiViewportFlags_None);\par
15542     \}\par
15543     {\cf19 else} {\cf19 if} (g.MovingWindow && g.MovingWindow->RootWindowDockTree == window && IsMousePosValid())\par
15544     \{\par
15545         {\cf19 if} (window->Viewport != NULL && window->Viewport->Window == window)\par
15546             window->Viewport = AddUpdateViewport(window, window->ID, window->Pos, window->Size, ImGuiViewportFlags_None);\par
15547     \}\par
15548     {\cf19 else}\par
15549     \{\par
15550         {\cf20 // Merge into host viewport?}\par
15551         {\cf20 // We cannot test window->ViewportOwned as it set lower in the function.}\par
15552         {\cf20 // Testing (g.ActiveId == 0 || g.ActiveIdAllowOverlap) to avoid merging during a short-term widget interaction. Main intent was to avoid during resize (see #4212)}\par
15553         {\cf18 bool} try_to_merge_into_host_viewport = (window->Viewport && window == window->Viewport->Window && (g.ActiveId == 0 || g.ActiveIdAllowOverlap));\par
15554         {\cf19 if} (try_to_merge_into_host_viewport)\par
15555             UpdateTryMergeWindowIntoHostViewports(window);\par
15556     \}\par
15557 \par
15558     {\cf20 // Fallback: merge in default viewport if z-order matches, otherwise create a new viewport}\par
15559     {\cf19 if} (window->Viewport == NULL)\par
15560         {\cf19 if} (!UpdateTryMergeWindowIntoHostViewport(window, main_viewport))\par
15561             window->Viewport = AddUpdateViewport(window, window->ID, window->Pos, window->Size, ImGuiViewportFlags_None);\par
15562 \par
15563     {\cf20 // Mark window as allowed to protrude outside of its viewport and into the current monitor}\par
15564     {\cf19 if} (!lock_viewport)\par
15565     \{\par
15566         {\cf19 if} (flags & (ImGuiWindowFlags_Tooltip | ImGuiWindowFlags_Popup))\par
15567         \{\par
15568             {\cf20 // We need to take account of the possibility that mouse may become invalid.}\par
15569             {\cf20 // Popups/Tooltip always set ViewportAllowPlatformMonitorExtend so GetWindowAllowedExtentRect() will return full monitor bounds.}\par
15570             ImVec2 mouse_ref = (flags & ImGuiWindowFlags_Tooltip) ? g.IO.MousePos : g.BeginPopupStack.back().OpenMousePos;\par
15571             {\cf18 bool} use_mouse_ref = (g.NavDisableHighlight || !g.NavDisableMouseHover || !g.NavWindow);\par
15572             {\cf18 bool} mouse_valid = IsMousePosValid(&mouse_ref);\par
15573             {\cf19 if} ((window->Appearing || (flags & (ImGuiWindowFlags_Tooltip | ImGuiWindowFlags_ChildMenu))) && (!use_mouse_ref || mouse_valid))\par
15574                 window->ViewportAllowPlatformMonitorExtend = FindPlatformMonitorForPos((use_mouse_ref && mouse_valid) ? mouse_ref : NavCalcPreferredRefPos());\par
15575             {\cf19 else}\par
15576                 window->ViewportAllowPlatformMonitorExtend = window->Viewport->PlatformMonitor;\par
15577         \}\par
15578         {\cf19 else} {\cf19 if} (window->Viewport && window != window->Viewport->Window && window->Viewport->Window && !(flags & ImGuiWindowFlags_ChildWindow) && window->DockNode == NULL)\par
15579         \{\par
15580             {\cf20 // When called from Begin() we don't have access to a proper version of the Hidden flag yet, so we replicate this code.}\par
15581             {\cf17 const} {\cf18 bool} will_be_visible = (window->DockIsActive && !window->DockTabIsVisible) ? {\cf17 false} : true;\par
15582             {\cf19 if} ((window->Flags & ImGuiWindowFlags_DockNodeHost) && window->Viewport->LastFrameActive < g.FrameCount && will_be_visible)\par
15583             \{\par
15584                 {\cf20 // Steal/transfer ownership}\par
15585                 IMGUI_DEBUG_LOG_VIEWPORT({\cf22 "[viewport] Window '%s' steal Viewport %08X from Window '%s'\\n"}, window->Name, window->Viewport->ID, window->Viewport->Window->Name);\par
15586                 window->Viewport->Window = window;\par
15587                 window->Viewport->ID = window->ID;\par
15588                 window->Viewport->LastNameHash = 0;\par
15589             \}\par
15590             {\cf19 else} {\cf19 if} (!UpdateTryMergeWindowIntoHostViewports(window)) {\cf20 // Merge?}\par
15591             \{\par
15592                 {\cf20 // New viewport}\par
15593                 window->Viewport = AddUpdateViewport(window, window->ID, window->Pos, window->Size, ImGuiViewportFlags_NoFocusOnAppearing);\par
15594             \}\par
15595         \}\par
15596         {\cf19 else} {\cf19 if} (window->ViewportAllowPlatformMonitorExtend < 0 && (flags & ImGuiWindowFlags_ChildWindow) == 0)\par
15597         \{\par
15598             {\cf20 // Regular (non-child, non-popup) windows by default are also allowed to protrude}\par
15599             {\cf20 // Child windows are kept contained within their parent.}\par
15600             window->ViewportAllowPlatformMonitorExtend = window->Viewport->PlatformMonitor;\par
15601         \}\par
15602     \}\par
15603 \par
15604     {\cf20 // Update flags}\par
15605     window->ViewportOwned = (window == window->Viewport->Window);\par
15606     window->ViewportId = window->Viewport->ID;\par
15607 \par
15608     {\cf20 // If the OS window has a title bar, hide our imgui title bar}\par
15609     {\cf20 //if (window->ViewportOwned && !(window->Viewport->Flags & ImGuiViewportFlags_NoDecoration))}\par
15610     {\cf20 //    window->Flags |= ImGuiWindowFlags_NoTitleBar;}\par
15611 \}\par
