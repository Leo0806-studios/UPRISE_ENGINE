05539         {\cf19 if} (IsWindowActiveAndVisible(window) && (window->Flags & ImGuiWindowFlags_ChildWindow) == 0 && window != windows_to_render_top_most[0] && window != windows_to_render_top_most[1])\par
05540             AddRootWindowToDrawData(window);\par
05541     \}\par
05542     {\cf19 for} ({\cf18 int} n = 0; n < IM_ARRAYSIZE(windows_to_render_top_most); n++)\par
05543         {\cf19 if} (windows_to_render_top_most[n] && IsWindowActiveAndVisible(windows_to_render_top_most[n])) {\cf20 // NavWindowingTarget is always temporarily displayed as the top-most window}\par
05544             AddRootWindowToDrawData(windows_to_render_top_most[n]);\par
