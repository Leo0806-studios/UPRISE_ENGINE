01770 {\cf18 void} ImGui::TableSetBgColor(ImGuiTableBgTarget target, ImU32 color, {\cf18 int} column_n)\par
01771 \{\par
01772     ImGuiContext& g = *GImGui;\par
01773     ImGuiTable* table = g.CurrentTable;\par
01774     IM_ASSERT(target != ImGuiTableBgTarget_None);\par
01775 \par
01776     {\cf19 if} (color == IM_COL32_DISABLE)\par
01777         color = 0;\par
01778 \par
01779     {\cf20 // We cannot draw neither the cell or row background immediately as we don't know the row height at this point in time.}\par
01780     {\cf19 switch} (target)\par
01781     \{\par
01782     {\cf19 case} ImGuiTableBgTarget_CellBg:\par
01783     \{\par
01784         {\cf19 if} (table->RowPosY1 > table->InnerClipRect.Max.y) {\cf20 // Discard}\par
01785             {\cf19 return};\par
01786         {\cf19 if} (column_n == -1)\par
01787             column_n = table->CurrentColumn;\par
01788         {\cf19 if} (!IM_BITARRAY_TESTBIT(table->VisibleMaskByIndex, column_n))\par
01789             {\cf19 return};\par
01790         {\cf19 if} (table->RowCellDataCurrent < 0 || table->RowCellData[table->RowCellDataCurrent].Column != column_n)\par
01791             table->RowCellDataCurrent++;\par
01792         ImGuiTableCellData* cell_data = &table->RowCellData[table->RowCellDataCurrent];\par
01793         cell_data->BgColor = color;\par
01794         cell_data->Column = (ImGuiTableColumnIdx)column_n;\par
01795         {\cf19 break};\par
01796     \}\par
01797     {\cf19 case} ImGuiTableBgTarget_RowBg0:\par
01798     {\cf19 case} ImGuiTableBgTarget_RowBg1:\par
01799     \{\par
01800         {\cf19 if} (table->RowPosY1 > table->InnerClipRect.Max.y) {\cf20 // Discard}\par
01801             {\cf19 return};\par
01802         IM_ASSERT(column_n == -1);\par
01803         {\cf18 int} bg_idx = (target == ImGuiTableBgTarget_RowBg1) ? 1 : 0;\par
01804         table->RowBgColor[bg_idx] = color;\par
01805         {\cf19 break};\par
01806     \}\par
01807     {\cf19 default}:\par
01808         IM_ASSERT(0);\par
01809     \}\par
01810 \}\par
