17004 {\cf17 static} {\cf18 void} ImGui::DockNodeMoveWindows(ImGuiDockNode* dst_node, ImGuiDockNode* src_node)\par
17005 \{\par
17006     {\cf20 // Insert tabs in the same orders as currently ordered (node->Windows isn't ordered)}\par
17007     IM_ASSERT(src_node && dst_node && dst_node != src_node);\par
17008     ImGuiTabBar* src_tab_bar = src_node->TabBar;\par
17009     {\cf19 if} (src_tab_bar != NULL)\par
17010         IM_ASSERT(src_node->Windows.Size <= src_node->TabBar->Tabs.Size);\par
17011 \par
17012     {\cf20 // If the dst_node is empty we can just move the entire tab bar (to preserve selection, scrolling, etc.)}\par
17013     {\cf18 bool} move_tab_bar = (src_tab_bar != NULL) && (dst_node->TabBar == NULL);\par
17014     {\cf19 if} (move_tab_bar)\par
17015     \{\par
17016         dst_node->TabBar = src_node->TabBar;\par
17017         src_node->TabBar = NULL;\par
17018     \}\par
17019 \par
17020     {\cf20 // Tab order is not important here, it is preserved by sorting in DockNodeUpdateTabBar().}\par
17021     {\cf19 for} (ImGuiWindow* window : src_node->Windows)\par
17022     \{\par
17023         window->DockNode = NULL;\par
17024         window->DockIsActive = {\cf17 false};\par
17025         DockNodeAddWindow(dst_node, window, !move_tab_bar);\par
17026     \}\par
17027     src_node->Windows.clear();\par
17028 \par
17029     {\cf19 if} (!move_tab_bar && src_node->TabBar)\par
17030     \{\par
17031         {\cf19 if} (dst_node->TabBar)\par
17032             dst_node->TabBar->SelectedTabId = src_node->TabBar->SelectedTabId;\par
17033         DockNodeRemoveTabBar(src_node);\par
17034     \}\par
17035 \}\par
