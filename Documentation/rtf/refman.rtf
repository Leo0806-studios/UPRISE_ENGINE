03000 {\cf18 void} ImGuiListClipper::Begin({\cf18 int} items_count, {\cf18 float} items_height)\par
03001 \{\par
03002     {\cf19 if} (Ctx == NULL)\par
03003         Ctx = ImGui::GetCurrentContext();\par
03004 \par
03005     ImGuiContext& g = *Ctx;\par
03006     ImGuiWindow* window = g.CurrentWindow;\par
03007     IMGUI_DEBUG_LOG_CLIPPER({\cf22 "Clipper: Begin(%d,%.2f) in '%s'\\n"}, items_count, items_height, window->Name);\par
03008 \par
03009     {\cf19 if} (ImGuiTable* table = g.CurrentTable)\par
03010         {\cf19 if} (table->IsInsideRow)\par
03011             ImGui::TableEndRow(table);\par
03012 \par
03013     StartPosY = window->DC.CursorPos.y;\par
03014     ItemsHeight = items_height;\par
03015     ItemsCount = items_count;\par
03016     DisplayStart = -1;\par
03017     DisplayEnd = 0;\par
03018 \par
03019     {\cf20 // Acquire temporary buffer}\par
03020     {\cf19 if} (++g.ClipperTempDataStacked > g.ClipperTempData.Size)\par
03021         g.ClipperTempData.resize(g.ClipperTempDataStacked, ImGuiListClipperData());\par
03022     ImGuiListClipperData* data = &g.ClipperTempData[g.ClipperTempDataStacked - 1];\par
03023     data->Reset({\cf17 this});\par
03024     data->LossynessOffset = window->DC.CursorStartPosLossyness.y;\par
03025     TempData = data;\par
03026     StartSeekOffsetY = data->LossynessOffset;\par
03027 \}\par
03028 \par
03029 {\cf18 void} ImGuiListClipper::End()\par
03030 \{\par
03031     {\cf19 if} (ImGuiListClipperData* data = (ImGuiListClipperData*)TempData)\par
03032     \{\par
03033         {\cf20 // In theory here we should assert that we are already at the right position, but it seems saner to just seek at the end and not assert/crash the user.}\par
03034         ImGuiContext& g = *Ctx;\par
03035         IMGUI_DEBUG_LOG_CLIPPER({\cf22 "Clipper: End() in '%s'\\n"}, g.CurrentWindow->Name);\par
03036         {\cf19 if} (ItemsCount >= 0 && ItemsCount < INT_MAX && DisplayStart >= 0)\par
03037             SeekCursorForItem(ItemsCount);\par
03038 \par
03039         {\cf20 // Restore temporary buffer and fix back pointers which may be invalidated when nesting}\par
03040         IM_ASSERT(data->ListClipper == {\cf17 this});\par
03041         data->StepNo = data->Ranges.Size;\par
03042         {\cf19 if} (--g.ClipperTempDataStacked > 0)\par
03043         \{\par
03044             data = &g.ClipperTempData[g.ClipperTempDataStacked - 1];\par
03045             data->ListClipper->TempData = data;\par
03046         \}\par
03047         TempData = NULL;\par
03048     \}\par
03049     ItemsCount = -1;\par
03050 \}\par
03051 \par
03052 {\cf18 void} ImGuiListClipper::IncludeItemsByIndex({\cf18 int} item_begin, {\cf18 int} item_end)\par
03053 \{\par
03054     ImGuiListClipperData* data = (ImGuiListClipperData*)TempData;\par
03055     IM_ASSERT(DisplayStart < 0); {\cf20 // Only allowed after Begin() and if there has not been a specified range yet.}\par
03056     IM_ASSERT(item_begin <= item_end);\par
03057     {\cf19 if} (item_begin < item_end)\par
03058         data->Ranges.push_back(ImGuiListClipperRange::FromIndices(item_begin, item_end));\par
03059 \}\par
03060 \par
03061 {\cf20 // This is already called while stepping.}\par
03062 {\cf20 // The ONLY reason you may want to call this is if you passed INT_MAX to ImGuiListClipper::Begin() because you couldn't step item count beforehand.}\par
03063 {\cf18 void} ImGuiListClipper::SeekCursorForItem({\cf18 int} item_n)\par
03064 \{\par
03065     {\cf20 // - Perform the add and multiply with double to allow seeking through larger ranges.}\par
03066     {\cf20 // - StartPosY starts from ItemsFrozen, by adding SeekOffsetY we generally cancel that out (SeekOffsetY == LossynessOffset - ItemsFrozen * ItemsHeight).}\par
03067     {\cf20 // - The reason we store SeekOffsetY instead of inferring it, is because we want to allow user to perform Seek after the last step, where ImGuiListClipperData is already done.}\par
03068     {\cf18 float} pos_y = (float)(({\cf18 double})StartPosY + StartSeekOffsetY + (double)item_n * ItemsHeight);\par
03069     ImGuiListClipper_SeekCursorAndSetupPrevLine(pos_y, ItemsHeight);\par
03070 \}\par
03071 \par
03072 {\cf17 static} {\cf18 bool} ImGuiListClipper_StepInternal(ImGuiListClipper* clipper)\par
03073 \{\par
03074     ImGuiContext& g = *clipper->Ctx;\par
03075     ImGuiWindow* window = g.CurrentWindow;\par
03076     ImGuiListClipperData* data = (ImGuiListClipperData*)clipper->TempData;\par
03077     IM_ASSERT(data != NULL && {\cf22 "Called ImGuiListClipper::Step() too many times, or before ImGuiListClipper::Begin() ?"});\par
03078 \par
03079     ImGuiTable* table = g.CurrentTable;\par
03080     {\cf19 if} (table && table->IsInsideRow)\par
03081         ImGui::TableEndRow(table);\par
03082 \par
03083     {\cf20 // No items}\par
03084     {\cf19 if} (clipper->ItemsCount == 0 || GetSkipItemForListClipping())\par
03085         {\cf19 return} {\cf17 false};\par
03086 \par
03087     {\cf20 // While we are in frozen row state, keep displaying items one by one, unclipped}\par
03088     {\cf20 // FIXME: Could be stored as a table-agnostic state.}\par
03089     {\cf19 if} (data->StepNo == 0 && table != NULL && !table->IsUnfrozenRows)\par
03090     \{\par
03091         clipper->DisplayStart = data->ItemsFrozen;\par
03092         clipper->DisplayEnd = ImMin(data->ItemsFrozen + 1, clipper->ItemsCount);\par
03093         {\cf19 if} (clipper->DisplayStart < clipper->DisplayEnd)\par
03094             data->ItemsFrozen++;\par
03095         {\cf19 return} {\cf17 true};\par
03096     \}\par
03097 \par
03098     {\cf20 // Step 0: Let you process the first element (regardless of it being visible or not, so we can measure the element height)}\par
03099     {\cf18 bool} calc_clipping = {\cf17 false};\par
03100     {\cf19 if} (data->StepNo == 0)\par
03101     \{\par
03102         clipper->StartPosY = window->DC.CursorPos.y;\par
03103         {\cf19 if} (clipper->ItemsHeight <= 0.0f)\par
03104         \{\par
03105             {\cf20 // Submit the first item (or range) so we can measure its height (generally the first range is 0..1)}\par
03106             data->Ranges.push_front(ImGuiListClipperRange::FromIndices(data->ItemsFrozen, data->ItemsFrozen + 1));\par
03107             clipper->DisplayStart = ImMax(data->Ranges[0].Min, data->ItemsFrozen);\par
03108             clipper->DisplayEnd = ImMin(data->Ranges[0].Max, clipper->ItemsCount);\par
03109             data->StepNo = 1;\par
03110             {\cf19 return} {\cf17 true};\par
03111         \}\par
03112         calc_clipping = {\cf17 true};   {\cf20 // If on the first step with known item height, calculate clipping.}\par
03113     \}\par
03114 \par
03115     {\cf20 // Step 1: Let the clipper infer height from first range}\par
03116     {\cf19 if} (clipper->ItemsHeight <= 0.0f)\par
03117     \{\par
03118         IM_ASSERT(data->StepNo == 1);\par
03119         {\cf19 if} (table)\par
03120             IM_ASSERT(table->RowPosY1 == clipper->StartPosY && table->RowPosY2 == window->DC.CursorPos.y);\par
03121 \par
03122         clipper->ItemsHeight = (window->DC.CursorPos.y - clipper->StartPosY) / ({\cf18 float})(clipper->DisplayEnd - clipper->DisplayStart);\par
03123         {\cf18 bool} affected_by_floating_point_precision = ImIsFloatAboveGuaranteedIntegerPrecision(clipper->StartPosY) || ImIsFloatAboveGuaranteedIntegerPrecision(window->DC.CursorPos.y);\par
03124         {\cf19 if} (affected_by_floating_point_precision)\par
03125             clipper->ItemsHeight = window->DC.PrevLineSize.y + g.Style.ItemSpacing.y; {\cf20 // FIXME: Technically wouldn't allow multi-line entries.}\par
03126         {\cf19 if} (clipper->ItemsHeight == 0.0f && clipper->ItemsCount == INT_MAX) {\cf20 // Accept that no item have been submitted if in indeterminate mode.}\par
03127             {\cf19 return} {\cf17 false};\par
03128         IM_ASSERT(clipper->ItemsHeight > 0.0f && {\cf22 "Unable to calculate item height! First item hasn't moved the cursor vertically!"});\par
03129         calc_clipping = {\cf17 true};   {\cf20 // If item height had to be calculated, calculate clipping afterwards.}\par
03130     \}\par
03131 \par
03132     {\cf20 // Step 0 or 1: Calculate the actual ranges of visible elements.}\par
03133     {\cf17 const} {\cf18 int} already_submitted = clipper->DisplayEnd;\par
03134     {\cf19 if} (calc_clipping)\par
03135     \{\par
03136         {\cf20 // Record seek offset, this is so ImGuiListClipper::Seek() can be called after ImGuiListClipperData is done}\par
03137         clipper->StartSeekOffsetY = (double)data->LossynessOffset - data->ItemsFrozen * ({\cf18 double})clipper->ItemsHeight;\par
03138 \par
03139         {\cf19 if} (g.LogEnabled)\par
03140         \{\par
03141             {\cf20 // If logging is active, do not perform any clipping}\par
03142             data->Ranges.push_back(ImGuiListClipperRange::FromIndices(0, clipper->ItemsCount));\par
03143         \}\par
03144         {\cf19 else}\par
03145         \{\par
03146             {\cf20 // Add range selected to be included for navigation}\par
03147             {\cf17 const} {\cf18 bool} is_nav_request = (g.NavMoveScoringItems && g.NavWindow && g.NavWindow->RootWindowForNav == window->RootWindowForNav);\par
03148             {\cf19 if} (is_nav_request)\par
03149                 data->Ranges.push_back(ImGuiListClipperRange::FromPositions(g.NavScoringNoClipRect.Min.y, g.NavScoringNoClipRect.Max.y, 0, 0));\par
03150             {\cf19 if} (is_nav_request && (g.NavMoveFlags & ImGuiNavMoveFlags_IsTabbing) && g.NavTabbingDir == -1)\par
03151                 data->Ranges.push_back(ImGuiListClipperRange::FromIndices(clipper->ItemsCount - 1, clipper->ItemsCount));\par
03152 \par
03153             {\cf20 // Add focused/active item}\par
03154             ImRect nav_rect_abs = ImGui::WindowRectRelToAbs(window, window->NavRectRel[0]);\par
03155             {\cf19 if} (g.NavId != 0 && window->NavLastIds[0] == g.NavId)\par
03156                 data->Ranges.push_back(ImGuiListClipperRange::FromPositions(nav_rect_abs.Min.y, nav_rect_abs.Max.y, 0, 0));\par
03157 \par
03158             {\cf20 // Add visible range}\par
03159             {\cf18 float} min_y = window->ClipRect.Min.y;\par
03160             {\cf18 float} max_y = window->ClipRect.Max.y;\par
03161 \par
03162             {\cf20 // Add box selection range}\par
03163             ImGuiBoxSelectState* bs = &g.BoxSelectState;\par
03164             {\cf19 if} (bs->IsActive && bs->Window == window)\par
03165             \{\par
03166                 {\cf20 // FIXME: Selectable() use of half-ItemSpacing isn't consistent in matter of layout, as ItemAdd(bb) stray above ItemSize()'s CursorPos.}\par
03167                 {\cf20 // RangeSelect's BoxSelect relies on comparing overlap of previous and current rectangle and is sensitive to that.}\par
03168                 {\cf20 // As a workaround we currently half ItemSpacing worth on each side.}\par
03169                 min_y -= g.Style.ItemSpacing.y;\par
03170                 max_y += g.Style.ItemSpacing.y;\par
03171 \par
03172                 {\cf20 // Box-select on 2D area requires different clipping.}\par
03173                 {\cf19 if} (bs->UnclipMode)\par
03174                     data->Ranges.push_back(ImGuiListClipperRange::FromPositions(bs->UnclipRect.Min.y, bs->UnclipRect.Max.y, 0, 0));\par
03175             \}\par
03176 \par
03177             {\cf17 const} {\cf18 int} off_min = (is_nav_request && g.NavMoveClipDir == ImGuiDir_Up) ? -1 : 0;\par
03178             {\cf17 const} {\cf18 int} off_max = (is_nav_request && g.NavMoveClipDir == ImGuiDir_Down) ? 1 : 0;\par
03179             data->Ranges.push_back(ImGuiListClipperRange::FromPositions(min_y, max_y, off_min, off_max));\par
03180         \}\par
03181 \par
03182         {\cf20 // Convert position ranges to item index ranges}\par
03183         {\cf20 // - Very important: when a starting position is after our maximum item, we set Min to (ItemsCount - 1). This allows us to handle most forms of wrapping.}\par
03184         {\cf20 // - Due to how Selectable extra padding they tend to be "unaligned" with exact unit in the item list,}\par
03185         {\cf20 //   which with the flooring/ceiling tend to lead to 2 items instead of one being submitted.}\par
03186         {\cf19 for} (ImGuiListClipperRange& range : data->Ranges)\par
03187             if (range.PosToIndexConvert)\par
03188             \{\par
03189                 {\cf18 int} m1 = (int)((({\cf18 double})range.Min - window->DC.CursorPos.y - data->LossynessOffset) / clipper->ItemsHeight);\par
03190                 {\cf18 int} m2 = (int)(((({\cf18 double})range.Max - window->DC.CursorPos.y - data->LossynessOffset) / clipper->ItemsHeight) + 0.999999f);\par
03191                 range.Min = ImClamp(already_submitted + m1 + range.PosToIndexOffsetMin, already_submitted, clipper->ItemsCount - 1);\par
03192                 range.Max = ImClamp(already_submitted + m2 + range.PosToIndexOffsetMax, range.Min + 1, clipper->ItemsCount);\par
03193                 range.PosToIndexConvert = {\cf17 false};\par
03194             \}\par
03195         ImGuiListClipper_SortAndFuseRanges(data->Ranges, data->StepNo);\par
03196     \}\par
03197 \par
03198     {\cf20 // Step 0+ (if item height is given in advance) or 1+: Display the next range in line.}\par
03199     {\cf19 while} (data->StepNo < data->Ranges.Size)\par
03200     \{\par
03201         clipper->DisplayStart = ImMax(data->Ranges[data->StepNo].Min, already_submitted);\par
03202         clipper->DisplayEnd = ImMin(data->Ranges[data->StepNo].Max, clipper->ItemsCount);\par
03203         {\cf19 if} (clipper->DisplayStart > already_submitted) {\cf20 //-V1051}\par
03204             clipper->SeekCursorForItem(clipper->DisplayStart);\par
03205         data->StepNo++;\par
03206         {\cf19 if} (clipper->DisplayStart == clipper->DisplayEnd && data->StepNo < data->Ranges.Size)\par
03207             {\cf19 continue};\par
03208         {\cf19 return} {\cf17 true};\par
03209     \}\par
03210 \par
03211     {\cf20 // After the last step: Let the clipper validate that we have reached the expected Y position (corresponding to element DisplayEnd),}\par
03212     {\cf20 // Advance the cursor to the end of the list and then returns 'false' to end the loop.}\par
03213     {\cf19 if} (clipper->ItemsCount < INT_MAX)\par
03214         clipper->SeekCursorForItem(clipper->ItemsCount);\par
03215 \par
03216     {\cf19 return} {\cf17 false};\par
03217 \}\par
03218 \par
03219 {\cf18 bool} ImGuiListClipper::Step()\par
03220 \{\par
03221     ImGuiContext& g = *Ctx;\par
03222     {\cf18 bool} need_items_height = (ItemsHeight <= 0.0f);\par
03223     {\cf18 bool} ret = ImGuiListClipper_StepInternal({\cf17 this});\par
03224     {\cf19 if} (ret && (DisplayStart == DisplayEnd))\par
03225         ret = {\cf17 false};\par
03226     {\cf19 if} (g.CurrentTable && g.CurrentTable->IsUnfrozenRows == {\cf17 false})\par
03227         IMGUI_DEBUG_LOG_CLIPPER({\cf22 "Clipper: Step(): inside frozen table row.\\n"});\par
03228     {\cf19 if} (need_items_height && ItemsHeight > 0.0f)\par
03229         IMGUI_DEBUG_LOG_CLIPPER({\cf22 "Clipper: Step(): computed ItemsHeight: %.2f.\\n"}, ItemsHeight);\par
03230     {\cf19 if} (ret)\par
03231     \{\par
03232         IMGUI_DEBUG_LOG_CLIPPER({\cf22 "Clipper: Step(): display %d to %d.\\n"}, DisplayStart, DisplayEnd);\par
03233     \}\par
03234     {\cf19 else}\par
03235     \{\par
03236         IMGUI_DEBUG_LOG_CLIPPER({\cf22 "Clipper: Step(): End.\\n"});\par
03237         End();\par
03238     \}\par
03239     {\cf19 return} ret;\par
03240 \}\par
