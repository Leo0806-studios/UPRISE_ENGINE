03555 {\cf20 // Default clip_rect uses (pos_min,pos_max)}\par
03556 {\cf20 // Handle clipping on CPU immediately (vs typically let the GPU clip the triangles that are overlapping the clipping rectangle edges)}\par
03557 {\cf20 // FIXME-OPT: Since we have or calculate text_size we could coarse clip whole block immediately, especally for text above draw_list->DrawList.}\par
03558 {\cf20 // Effectively as this is called from widget doing their own coarse clipping it's not very valuable presently. Next time function will take}\par
03559 {\cf20 // better advantage of the render function taking size into account for coarse clipping.}\par
03560 {\cf18 void} ImGui::RenderTextClippedEx(ImDrawList* draw_list, {\cf17 const} ImVec2& pos_min, {\cf17 const} ImVec2& pos_max, {\cf17 const} {\cf18 char}* text, {\cf17 const} {\cf18 char}* text_display_end, {\cf17 const} ImVec2* text_size_if_known, {\cf17 const} ImVec2& align, {\cf17 const} ImRect* clip_rect)\par
03561 \{\par
03562     {\cf20 // Perform CPU side clipping for single clipped element to avoid using scissor state}\par
03563     ImVec2 pos = pos_min;\par
03564     {\cf17 const} ImVec2 text_size = text_size_if_known ? *text_size_if_known : CalcTextSize(text, text_display_end, {\cf17 false}, 0.0f);\par
03565 \par
03566     {\cf17 const} ImVec2* clip_min = clip_rect ? &clip_rect->Min : &pos_min;\par
03567     {\cf17 const} ImVec2* clip_max = clip_rect ? &clip_rect->Max : &pos_max;\par
03568     {\cf18 bool} need_clipping = (pos.x + text_size.x >= clip_max->x) || (pos.y + text_size.y >= clip_max->y);\par
03569     {\cf19 if} (clip_rect) {\cf20 // If we had no explicit clipping rectangle then pos==clip_min}\par
03570         need_clipping |= (pos.x < clip_min->x) || (pos.y < clip_min->y);\par
03571 \par
03572     {\cf20 // Align whole block. We should defer that to the better rendering function when we'll have support for individual line alignment.}\par
03573     {\cf19 if} (align.x > 0.0f) pos.x = ImMax(pos.x, pos.x + (pos_max.x - pos.x - text_size.x) * align.x);\par
03574     {\cf19 if} (align.y > 0.0f) pos.y = ImMax(pos.y, pos.y + (pos_max.y - pos.y - text_size.y) * align.y);\par
03575 \par
03576     {\cf20 // Render}\par
03577     {\cf19 if} (need_clipping)\par
03578     \{\par
03579         ImVec4 fine_clip_rect(clip_min->x, clip_min->y, clip_max->x, clip_max->y);\par
03580         draw_list->AddText(NULL, 0.0f, pos, GetColorU32(ImGuiCol_Text), text, text_display_end, 0.0f, &fine_clip_rect);\par
03581     \}\par
03582     {\cf19 else}\par
03583     \{\par
03584         draw_list->AddText(NULL, 0.0f, pos, GetColorU32(ImGuiCol_Text), text, text_display_end, 0.0f, NULL);\par
03585     \}\par
03586 \}\par
