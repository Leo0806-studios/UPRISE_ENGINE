08741     g.NavFocusScopeId = focus_scope_id;\par
08742     g.NavFocusRoute.resize(0); {\cf20 // Invalidate}\par
08743     {\cf19 if} (focus_scope_id == 0)\par
08744         {\cf19 return};\par
08745     IM_ASSERT(g.NavWindow != NULL);\par
08746 \par
08747     {\cf20 // Store current path (in reverse order)}\par
08748     {\cf19 if} (focus_scope_id == g.CurrentFocusScopeId)\par
08749     \{\par
08750         {\cf20 // Top of focus stack contains local focus scopes inside current window}\par
08751         {\cf19 for} ({\cf18 int} n = g.FocusScopeStack.Size - 1; n >= 0 && g.FocusScopeStack.Data[n].WindowID == g.CurrentWindow->ID; n--)\par
08752             g.NavFocusRoute.push_back(g.FocusScopeStack.Data[n]);\par
08753     \}\par
08754     {\cf19 else} {\cf19 if} (focus_scope_id == g.NavWindow->NavRootFocusScopeId)\par
08755         g.NavFocusRoute.push_back(\{ focus_scope_id, g.NavWindow->ID \});\par
08756     {\cf19 else}\par
08757         {\cf19 return};\par
08758 \par
08759     {\cf20 // Then follow on manually set ParentWindowForFocusRoute field (#6798)}\par
08760     {\cf19 for} (ImGuiWindow* window = g.NavWindow->ParentWindowForFocusRoute; window != NULL; window = window->ParentWindowForFocusRoute)\par
08761         g.NavFocusRoute.push_back(\{ window->NavRootFocusScopeId, window->ID \});\par
08762     IM_ASSERT(g.NavFocusRoute.Size < 100); {\cf20 // Maximum depth is technically 251 as per CalcRoutingScore(): 254 - 3}\par
08763 \}\par
