06816             window->WantCollapseToggle = {\cf17 true}; {\cf20 // Defer actual collapsing to next frame as we are too far in the Begin() function}\par
06817 \par
06818     {\cf20 // Close button}\par
06819     {\cf19 if} (has_close_button)\par
06820         {\cf19 if} (CloseButton(window->GetID({\cf22 "#CLOSE"}), close_button_pos))\par
06821             *p_open = {\cf17 false};\par
