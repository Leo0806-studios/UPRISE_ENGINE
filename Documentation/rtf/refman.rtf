10556 {\cf20 // Verify ABI compatibility between caller code and compiled version of Dear ImGui. This helps detects some build issues.}\par
10557 {\cf20 // Called by IMGUI_CHECKVERSION().}\par
10558 {\cf20 // Verify that the type sizes are matching between the calling file's compilation unit and imgui.cpp's compilation unit}\par
10559 {\cf20 // If this triggers you have mismatched headers and compiled code versions.}\par
10560 {\cf20 // - It could be because of a build issue (using new headers with old compiled code)}\par
10561 {\cf20 // - It could be because of mismatched configuration #define, compilation settings, packing pragma etc.}\par
10562 {\cf20 //   THE CONFIGURATION SETTINGS MENTIONED IN imconfig.h MUST BE SET FOR ALL COMPILATION UNITS INVOLVED WITH DEAR IMGUI.}\par
10563 {\cf20 //   Which is why it is required you put them in your imconfig file (and NOT only before including imgui.h).}\par
10564 {\cf20 //   Otherwise it is possible that different compilation units would see different structure layout.}\par
10565 {\cf20 //   If you don't want to modify imconfig.h you can use the IMGUI_USER_CONFIG define to change filename.}\par
10566 {\cf18 bool} ImGui::DebugCheckVersionAndDataLayout({\cf17 const} {\cf18 char}* version, {\cf18 size_t} sz_io, {\cf18 size_t} sz_style, {\cf18 size_t} sz_vec2, {\cf18 size_t} sz_vec4, {\cf18 size_t} sz_vert, {\cf18 size_t} sz_idx)\par
10567 \{\par
10568     {\cf18 bool} error = {\cf17 false};\par
10569     {\cf19 if} (strcmp(version, IMGUI_VERSION) != 0) \{ error = {\cf17 true}; IM_ASSERT(strcmp(version, IMGUI_VERSION) == 0 && {\cf22 "Mismatched version string!"}); \}\par
10570     {\cf19 if} (sz_io    != {\cf17 sizeof}(ImGuiIO))    \{ error = {\cf17 true}; IM_ASSERT(sz_io == {\cf17 sizeof}(ImGuiIO) && {\cf22 "Mismatched struct layout!"}); \}\par
10571     {\cf19 if} (sz_style != {\cf17 sizeof}(ImGuiStyle)) \{ error = {\cf17 true}; IM_ASSERT(sz_style == {\cf17 sizeof}(ImGuiStyle) && {\cf22 "Mismatched struct layout!"}); \}\par
10572     {\cf19 if} (sz_vec2  != {\cf17 sizeof}(ImVec2))     \{ error = {\cf17 true}; IM_ASSERT(sz_vec2 == {\cf17 sizeof}(ImVec2) && {\cf22 "Mismatched struct layout!"}); \}\par
10573     {\cf19 if} (sz_vec4  != {\cf17 sizeof}(ImVec4))     \{ error = {\cf17 true}; IM_ASSERT(sz_vec4 == {\cf17 sizeof}(ImVec4) && {\cf22 "Mismatched struct layout!"}); \}\par
10574     {\cf19 if} (sz_vert  != {\cf17 sizeof}(ImDrawVert)) \{ error = {\cf17 true}; IM_ASSERT(sz_vert == {\cf17 sizeof}(ImDrawVert) && {\cf22 "Mismatched struct layout!"}); \}\par
10575     {\cf19 if} (sz_idx   != {\cf17 sizeof}(ImDrawIdx))  \{ error = {\cf17 true}; IM_ASSERT(sz_idx == {\cf17 sizeof}(ImDrawIdx) && {\cf22 "Mismatched struct layout!"}); \}\par
