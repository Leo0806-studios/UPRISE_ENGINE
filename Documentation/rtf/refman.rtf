00696     GL_CALL(glPixelStorei(GL_UNPACK_ROW_LENGTH, 0));\par
00697 {\cf21 #endif}\par
00698     GL_CALL(glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, width, height, 0, GL_RGBA, GL_UNSIGNED_BYTE, pixels));\par
00699 \par
00700     {\cf20 // Store our identifier}\par
00701     io.Fonts->SetTexID((ImTextureID)(intptr_t)bd->FontTexture);\par
00702 \par
00703     {\cf20 // Restore state}\par
00704     GL_CALL(glBindTexture(GL_TEXTURE_2D, last_texture));\par
00705 \par
00706     {\cf19 return} {\cf17 true};\par
00707 \}\par
