16374 {\cf17 struct }ImGuiDockContextPruneNodeData\par
16375 \{\par
16376     {\cf18 int}         CountWindows, CountChildWindows, CountChildNodes;\par
16377     ImGuiID     RootId;\par
16378     ImGuiDockContextPruneNodeData() \{ CountWindows = CountChildWindows = CountChildNodes = 0; RootId = 0; \}\par
