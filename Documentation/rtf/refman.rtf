21194 {\cf17 static} {\cf18 void} FormatTextureIDForDebugDisplay({\cf18 char}* buf, {\cf18 int} buf_size, ImTextureID tex_id)\par
21195 \{\par
21196     {\cf17 union }\{ {\cf18 void}* ptr; {\cf18 int} integer; \} tex_id_opaque;\par
21197     memcpy(&tex_id_opaque, &tex_id, ImMin({\cf17 sizeof}({\cf18 void}*), {\cf17 sizeof}(tex_id)));\par
21198     {\cf19 if} ({\cf17 sizeof}(tex_id) >= {\cf17 sizeof}({\cf18 void}*))\par
21199         ImFormatString(buf, buf_size, {\cf22 "0x%p"}, tex_id_opaque.ptr);\par
21200     {\cf19 else}\par
