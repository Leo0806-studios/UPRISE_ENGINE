02056 {\cf20 // [Public] Append into a specific column}\par
02057 {\cf18 bool} ImGui::TableSetColumnIndex({\cf18 int} column_n)\par
02058 \{\par
02059     ImGuiContext& g = *GImGui;\par
02060     ImGuiTable* table = g.CurrentTable;\par
02061     {\cf19 if} (!table)\par
02062         {\cf19 return} {\cf17 false};\par
02063 \par
02064     {\cf19 if} (table->CurrentColumn != column_n)\par
02065     \{\par
02066         {\cf19 if} (table->CurrentColumn != -1)\par
02067             TableEndCell(table);\par
02068         IM_ASSERT(column_n >= 0 && table->ColumnsCount);\par
02069         TableBeginCell(table, column_n);\par
02070     \}\par
02071 \par
02072     {\cf20 // Return whether the column is visible. User may choose to skip submitting items based on this return value,}\par
02073     {\cf20 // however they shouldn't skip submitting for columns that may have the tallest contribution to row height.}\par
02074     {\cf19 return} table->Columns[column_n].IsRequestOutput;\par
02075 \}\par
02076 \par
02077 {\cf20 // [Public] Append into the next column, wrap and create a new row when already on last column}\par
02078 {\cf18 bool} ImGui::TableNextColumn()\par
02079 \{\par
02080     ImGuiContext& g = *GImGui;\par
02081     ImGuiTable* table = g.CurrentTable;\par
02082     {\cf19 if} (!table)\par
02083         {\cf19 return} {\cf17 false};\par
02084 \par
02085     {\cf19 if} (table->IsInsideRow && table->CurrentColumn + 1 < table->ColumnsCount)\par
02086     \{\par
02087         {\cf19 if} (table->CurrentColumn != -1)\par
02088             TableEndCell(table);\par
02089         TableBeginCell(table, table->CurrentColumn + 1);\par
02090     \}\par
02091     {\cf19 else}\par
02092     \{\par
02093         TableNextRow();\par
02094         TableBeginCell(table, 0);\par
02095     \}\par
02096 \par
02097     {\cf20 // Return whether the column is visible. User may choose to skip submitting items based on this return value,}\par
02098     {\cf20 // however they shouldn't skip submitting for columns that may have the tallest contribution to row height.}\par
02099     {\cf19 return} table->Columns[table->CurrentColumn].IsRequestOutput;\par
02100 \}\par
02101 \par
02102 \par
02103 {\cf20 // [Internal] Called by TableSetColumnIndex()/TableNextColumn()}\par
02104 {\cf20 // This is called very frequently, so we need to be mindful of unnecessary overhead.}\par
02105 {\cf20 // FIXME-TABLE FIXME-OPT: Could probably shortcut some things for non-active or clipped columns.}\par
02106 {\cf18 void} ImGui::TableBeginCell(ImGuiTable* table, {\cf18 int} column_n)\par
02107 \{\par
02108     ImGuiContext& g = *GImGui;\par
02109     ImGuiTableColumn* column = &table->Columns[column_n];\par
02110     ImGuiWindow* window = table->InnerWindow;\par
02111     table->CurrentColumn = column_n;\par
02112 \par
02113     {\cf20 // Start position is roughly ~~ CellRect.Min + CellPadding + Indent}\par
02114     {\cf18 float} start_x = column->WorkMinX;\par
02115     {\cf19 if} (column->Flags & ImGuiTableColumnFlags_IndentEnable)\par
02116         start_x += table->RowIndentOffsetX; {\cf20 // ~~ += window.DC.Indent.x - table->HostIndentX, except we locked it for the row.}\par
02117 \par
02118     window->DC.CursorPos.x = start_x;\par
02119     window->DC.CursorPos.y = table->RowPosY1 + table->RowCellPaddingY;\par
02120     window->DC.CursorMaxPos.x = window->DC.CursorPos.x;\par
02121     window->DC.ColumnsOffset.x = start_x - window->Pos.x - window->DC.Indent.x; {\cf20 // FIXME-WORKRECT}\par
02122     window->DC.CursorPosPrevLine.x = window->DC.CursorPos.x; {\cf20 // PrevLine.y is preserved. This allows users to call SameLine() to share LineSize between columns.}\par
02123     window->DC.CurrLineTextBaseOffset = table->RowTextBaseline;\par
02124     window->DC.NavLayerCurrent = (ImGuiNavLayer)column->NavLayerCurrent;\par
02125 \par
02126     {\cf20 // Note how WorkRect.Max.y is only set once during layout}\par
02127     window->WorkRect.Min.y = window->DC.CursorPos.y;\par
02128     window->WorkRect.Min.x = column->WorkMinX;\par
02129     window->WorkRect.Max.x = column->WorkMaxX;\par
02130     window->DC.ItemWidth = column->ItemWidth;\par
02131 \par
02132     window->SkipItems = column->IsSkipItems;\par
02133     {\cf19 if} (column->IsSkipItems)\par
02134     \{\par
02135         g.LastItemData.ID = 0;\par
02136         g.LastItemData.StatusFlags = 0;\par
02137     \}\par
02138 \par
02139     {\cf19 if} (table->Flags & ImGuiTableFlags_NoClip)\par
02140     \{\par
02141         {\cf20 // FIXME: if we end up drawing all borders/bg in EndTable, could remove this and just assert that channel hasn't changed.}\par
02142         table->DrawSplitter->SetCurrentChannel(window->DrawList, TABLE_DRAW_CHANNEL_NOCLIP);\par
02143         {\cf20 //IM_ASSERT(table->DrawSplitter._Current == TABLE_DRAW_CHANNEL_NOCLIP);}\par
02144     \}\par
02145     {\cf19 else}\par
02146     \{\par
02147         {\cf20 // FIXME-TABLE: Could avoid this if draw channel is dummy channel?}\par
02148         SetWindowClipRectBeforeSetChannel(window, column->ClipRect);\par
02149         table->DrawSplitter->SetCurrentChannel(window->DrawList, column->DrawChannelCurrent);\par
02150     \}\par
02151 \par
02152     {\cf20 // Logging}\par
02153     {\cf19 if} (g.LogEnabled && !column->IsSkipItems)\par
02154     \{\par
02155         LogRenderedText(&window->DC.CursorPos, {\cf22 "|"});\par
02156         g.LogLinePosY = FLT_MAX;\par
02157     \}\par
02158 \}\par
