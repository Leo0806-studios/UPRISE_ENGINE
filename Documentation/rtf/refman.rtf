13954 {\cf20 // When this returns true you need to: a) call SetDragDropPayload() exactly once, b) you may render the payload visual/description, c) call EndDragDropSource()}\par
13955 {\cf20 // If the item has an identifier:}\par
13956 {\cf20 // - This assume/require the item to be activated (typically via ButtonBehavior).}\par
13957 {\cf20 // - Therefore if you want to use this with a mouse button other than left mouse button, it is up to the item itself to activate with another button.}\par
13958 {\cf20 // - We then pull and use the mouse button that was used to activate the item and use it to carry on the drag.}\par
13959 {\cf20 // If the item has no identifier:}\par
13960 {\cf20 // - Currently always assume left mouse button.}\par
13961 {\cf18 bool} ImGui::BeginDragDropSource(ImGuiDragDropFlags flags)\par
13962 \{\par
13963     ImGuiContext& g = *GImGui;\par
13964     ImGuiWindow* window = g.CurrentWindow;\par
13965 \par
13966     {\cf20 // FIXME-DRAGDROP: While in the common-most "drag from non-zero active id" case we can tell the mouse button,}\par
13967     {\cf20 // in both SourceExtern and id==0 cases we may requires something else (explicit flags or some heuristic).}\par
13968     ImGuiMouseButton mouse_button = ImGuiMouseButton_Left;\par
13969 \par
13970     {\cf18 bool} source_drag_active = {\cf17 false};\par
13971     ImGuiID source_id = 0;\par
13972     ImGuiID source_parent_id = 0;\par
13973     {\cf19 if} ((flags & ImGuiDragDropFlags_SourceExtern) == 0)\par
13974     \{\par
13975         source_id = g.LastItemData.ID;\par
13976         {\cf19 if} (source_id != 0)\par
13977         \{\par
13978             {\cf20 // Common path: items with ID}\par
13979             {\cf19 if} (g.ActiveId != source_id)\par
13980                 {\cf19 return} {\cf17 false};\par
13981             {\cf19 if} (g.ActiveIdMouseButton != -1)\par
13982                 mouse_button = g.ActiveIdMouseButton;\par
13983             {\cf19 if} (g.IO.MouseDown[mouse_button] == {\cf17 false} || window->SkipItems)\par
13984                 {\cf19 return} {\cf17 false};\par
13985             g.ActiveIdAllowOverlap = {\cf17 false};\par
13986         \}\par
13987         {\cf19 else}\par
13988         \{\par
13989             {\cf20 // Uncommon path: items without ID}\par
13990             {\cf19 if} (g.IO.MouseDown[mouse_button] == {\cf17 false} || window->SkipItems)\par
13991                 {\cf19 return} {\cf17 false};\par
13992             {\cf19 if} ((g.LastItemData.StatusFlags & ImGuiItemStatusFlags_HoveredRect) == 0 && (g.ActiveId == 0 || g.ActiveIdWindow != window))\par
13993                 {\cf19 return} {\cf17 false};\par
13994 \par
13995             {\cf20 // If you want to use BeginDragDropSource() on an item with no unique identifier for interaction, such as Text() or Image(), you need to:}\par
13996             {\cf20 // A) Read the explanation below, B) Use the ImGuiDragDropFlags_SourceAllowNullID flag.}\par
13997             {\cf19 if} (!(flags & ImGuiDragDropFlags_SourceAllowNullID))\par
13998             \{\par
13999                 IM_ASSERT(0);\par
14000                 {\cf19 return} {\cf17 false};\par
14001             \}\par
14002 \par
14003             {\cf20 // Magic fallback to handle items with no assigned ID, e.g. Text(), Image()}\par
14004             {\cf20 // We build a throwaway ID based on current ID stack + relative AABB of items in window.}\par
14005             {\cf20 // THE IDENTIFIER WON'T SURVIVE ANY REPOSITIONING/RESIZINGG OF THE WIDGET, so if your widget moves your dragging operation will be canceled.}\par
14006             {\cf20 // We don't need to maintain/call ClearActiveID() as releasing the button will early out this function and trigger !ActiveIdIsAlive.}\par
14007             {\cf20 // Rely on keeping other window->LastItemXXX fields intact.}\par
14008             source_id = g.LastItemData.ID = window->GetIDFromRectangle(g.LastItemData.Rect);\par
14009             KeepAliveID(source_id);\par
14010             {\cf18 bool} is_hovered = ItemHoverable(g.LastItemData.Rect, source_id, g.LastItemData.InFlags);\par
14011             {\cf19 if} (is_hovered && g.IO.MouseClicked[mouse_button])\par
14012             \{\par
14013                 SetActiveID(source_id, window);\par
14014                 FocusWindow(window);\par
14015             \}\par
14016             {\cf19 if} (g.ActiveId == source_id) {\cf20 // Allow the underlying widget to display/return hovered during the mouse release frame, else we would get a flicker.}\par
14017                 g.ActiveIdAllowOverlap = is_hovered;\par
14018         \}\par
14019         {\cf19 if} (g.ActiveId != source_id)\par
14020             {\cf19 return} {\cf17 false};\par
14021         source_parent_id = window->IDStack.back();\par
14022         source_drag_active = IsMouseDragging(mouse_button);\par
14023 \par
14024         {\cf20 // Disable navigation and key inputs while dragging + cancel existing request if any}\par
14025         SetActiveIdUsingAllKeyboardKeys();\par
14026     \}\par
14027     {\cf19 else}\par
14028     \{\par
14029         {\cf20 // When ImGuiDragDropFlags_SourceExtern is set:}\par
14030         window = NULL;\par
14031         source_id = ImHashStr({\cf22 "#SourceExtern"});\par
14032         source_drag_active = {\cf17 true};\par
14033         mouse_button = g.IO.MouseDown[0] ? 0 : -1;\par
14034         KeepAliveID(source_id);\par
14035         SetActiveID(source_id, NULL);\par
14036     \}\par
14037 \par
14038     IM_ASSERT(g.DragDropWithinTarget == {\cf17 false}); {\cf20 // Can't nest BeginDragDropSource() and BeginDragDropTarget()}\par
14039     {\cf19 if} (!source_drag_active)\par
14040         {\cf19 return} {\cf17 false};\par
14041 \par
14042     {\cf20 // Activate drag and drop}\par
14043     {\cf19 if} (!g.DragDropActive)\par
14044     \{\par
14045         IM_ASSERT(source_id != 0);\par
14046         ClearDragDrop();\par
14047         IMGUI_DEBUG_LOG_ACTIVEID({\cf22 "[dragdrop] BeginDragDropSource() DragDropActive = true, source_id = 0x%08X%s\\n"},\par
14048             source_id, (flags & ImGuiDragDropFlags_SourceExtern) ? {\cf22 " (EXTERN)"} : {\cf22 ""});\par
14049         ImGuiPayload& payload = g.DragDropPayload;\par
14050         payload.SourceId = source_id;\par
14051         payload.SourceParentId = source_parent_id;\par
14052         g.DragDropActive = {\cf17 true};\par
14053         g.DragDropSourceFlags = flags;\par
14054         g.DragDropMouseButton = mouse_button;\par
14055         {\cf19 if} (payload.SourceId == g.ActiveId)\par
14056             g.ActiveIdNoClearOnFocusLoss = {\cf17 true};\par
14057     \}\par
14058     g.DragDropSourceFrameCount = g.FrameCount;\par
14059     g.DragDropWithinSource = {\cf17 true};\par
14060 \par
14061     {\cf19 if} (!(flags & ImGuiDragDropFlags_SourceNoPreviewTooltip))\par
14062     \{\par
14063         {\cf20 // Target can request the Source to not display its tooltip (we use a dedicated flag to make this request explicit)}\par
14064         {\cf20 // We unfortunately can't just modify the source flags and skip the call to BeginTooltip, as caller may be emitting contents.}\par
14065         {\cf18 bool} ret;\par
14066         {\cf19 if} (g.DragDropAcceptIdPrev && (g.DragDropAcceptFlags & ImGuiDragDropFlags_AcceptNoPreviewTooltip))\par
14067             ret = BeginTooltipHidden();\par
14068         {\cf19 else}\par
14069             ret = BeginTooltip();\par
14070         IM_ASSERT(ret); {\cf20 // FIXME-NEWBEGIN: If this ever becomes false, we need to Begin("##Hidden", NULL, ImGuiWindowFlags_NoSavedSettings) + SetWindowHiddendAndSkipItemsForCurrentFrame().}\par
14071         IM_UNUSED(ret);\par
14072     \}\par
14073 \par
14074     {\cf19 if} (!(flags & ImGuiDragDropFlags_SourceNoDisableHover) && !(flags & ImGuiDragDropFlags_SourceExtern))\par
14075         g.LastItemData.StatusFlags &= ~ImGuiItemStatusFlags_HoveredRect;\par
14076 \par
14077     {\cf19 return} {\cf17 true};\par
14078 \}\par
