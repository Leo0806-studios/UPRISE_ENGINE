20223     \{\par
20224         \{ 0, 0, {\cf22 ""}, ImGuiKey_Tab \},      \{ 0, 1, {\cf22 "Q"}, ImGuiKey_Q \}, \{ 0, 2, {\cf22 "W"}, ImGuiKey_W \}, \{ 0, 3, {\cf22 "E"}, ImGuiKey_E \}, \{ 0, 4, {\cf22 "R"}, ImGuiKey_R \},\par
