14546 {\cf20 // Called by NewFrame()}\par
14547 {\cf18 void} ImGui::UpdateSettings()\par
14548 \{\par
14549     {\cf20 // Load settings on first frame (if not explicitly loaded manually before)}\par
14550     ImGuiContext& g = *GImGui;\par
14551     {\cf19 if} (!g.SettingsLoaded)\par
14552     \{\par
14553         IM_ASSERT(g.SettingsWindows.empty());\par
14554         {\cf19 if} (g.IO.IniFilename)\par
14555             LoadIniSettingsFromDisk(g.IO.IniFilename);\par
14556         g.SettingsLoaded = {\cf17 true};\par
14557     \}\par
14558 \par
14559     {\cf20 // Save settings (with a delay after the last modification, so we don't spam disk too much)}\par
14560     {\cf19 if} (g.SettingsDirtyTimer > 0.0f)\par
14561     \{\par
14562         g.SettingsDirtyTimer -= g.IO.DeltaTime;\par
14563         {\cf19 if} (g.SettingsDirtyTimer <= 0.0f)\par
14564         \{\par
14565             {\cf19 if} (g.IO.IniFilename != NULL)\par
14566                 SaveIniSettingsToDisk(g.IO.IniFilename);\par
14567             {\cf19 else}\par
14568                 g.IO.WantSaveIniSettings = {\cf17 true};  {\cf20 // Let user know they can call SaveIniSettingsToMemory(). user will need to clear io.WantSaveIniSettings themselves.}\par
14569             g.SettingsDirtyTimer = 0.0f;\par
14570         \}\par
14571     \}\par
14572 \}\par
