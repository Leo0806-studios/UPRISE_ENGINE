19787     IM_ASSERT(depth < (1 << ({\cf17 sizeof}(node_settings.Depth) << 3)));\par
19788     node_settings.ID = node->ID;\par
19789     node_settings.ParentNodeId = node->ParentNode ? node->ParentNode->ID : 0;\par
19790     node_settings.ParentWindowId = (node->IsDockSpace() && node->HostWindow && node->HostWindow->ParentWindow) ? node->HostWindow->ParentWindow->ID : 0;\par
19791     node_settings.SelectedTabId = node->SelectedTabId;\par
19792     node_settings.SplitAxis = ({\cf18 signed} char)(node->IsSplitNode() ? node->SplitAxis : ImGuiAxis_None);\par
19793     node_settings.Depth = (char)depth;\par
19794     node_settings.Flags = (node->LocalFlags & ImGuiDockNodeFlags_SavedFlagsMask_);\par
19795     node_settings.Pos = ImVec2ih(node->Pos);\par
19796     node_settings.Size = ImVec2ih(node->Size);\par
19797     node_settings.SizeRef = ImVec2ih(node->SizeRef);\par
19798     dc->NodesSettings.push_back(node_settings);\par
19799     {\cf19 if} (node->ChildNodes[0])\par
19800         DockSettingsHandler_DockNodeToSettings(dc, node->ChildNodes[0], depth + 1);\par
19801     {\cf19 if} (node->ChildNodes[1])\par
19802         DockSettingsHandler_DockNodeToSettings(dc, node->ChildNodes[1], depth + 1);\par
