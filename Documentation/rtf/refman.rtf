00054 {\cf20 //-----------------------------------------------------------------------------}\par
00055 {\cf20 // - TableHeadersRow() or TableHeader()         user submit a headers row (optional)}\par
00056 {\cf20 //    | TableSortSpecsClickColumn()             - when left-clicked: alter sort order and sort direction}\par
00057 {\cf20 //    | TableOpenContextMenu()                  - when right-clicked: trigger opening of the default context menu}\par
00058 {\cf20 // - TableGetSortSpecs()                        user queries updated sort specs (optional, generally after submitting headers)}\par
00059 {\cf20 // - TableNextRow()                             user begin into a new row (also automatically called by TableHeadersRow())}\par
00060 {\cf20 //    | TableEndRow()                           - finish existing row}\par
00061 {\cf20 //    | TableBeginRow()                         - add a new row}\par
00062 {\cf20 // - TableSetColumnIndex() / TableNextColumn()  user begin into a cell}\par
00063 {\cf20 //    | TableEndCell()                          - close existing column/cell}\par
00064 {\cf20 //    | TableBeginCell()                        - enter into current column/cell}\par
00065 {\cf20 // - [...]                                      user emit contents}\par
