02197 \par
02198 {\cf20 // Maximum column content width given current layout. Use column->MinX so this value on a per-column basis.}\par
02199 {\cf18 float} ImGui::TableGetMaxColumnWidth({\cf17 const} ImGuiTable* table, {\cf18 int} column_n)\par
02200 \{\par
02201     {\cf17 const} ImGuiTableColumn* column = &table->Columns[column_n];\par
02202     {\cf18 float} max_width = FLT_MAX;\par
02203     {\cf17 const} {\cf18 float} min_column_distance = table->MinColumnWidth + table->CellPaddingX * 2.0f + table->CellSpacingX1 + table->CellSpacingX2;\par
02204     {\cf19 if} (table->Flags & ImGuiTableFlags_ScrollX)\par
02205     \{\par
02206         {\cf20 // Frozen columns can't reach beyond visible width else scrolling will naturally break.}\par
02207         {\cf20 // (we use DisplayOrder as within a set of multiple frozen column reordering is possible)}\par
02208         {\cf19 if} (column->DisplayOrder < table->FreezeColumnsRequest)\par
02209         \{\par
02210             max_width = (table->InnerClipRect.Max.x - (table->FreezeColumnsRequest - column->DisplayOrder) * min_column_distance) - column->MinX;\par
02211             max_width = max_width - table->OuterPaddingX - table->CellPaddingX - table->CellSpacingX2;\par
02212         \}\par
02213     \}\par
02214     {\cf19 else} {\cf19 if} ((table->Flags & ImGuiTableFlags_NoKeepColumnsVisible) == 0)\par
02215     \{\par
02216         {\cf20 // If horizontal scrolling if disabled, we apply a final lossless shrinking of columns in order to make}\par
02217         {\cf20 // sure they are all visible. Because of this we also know that all of the columns will always fit in}\par
02218         {\cf20 // table->WorkRect and therefore in table->InnerRect (because ScrollX is off)}\par
02219         {\cf20 // FIXME-TABLE: This is solved incorrectly but also quite a difficult problem to fix as we also want ClipRect width to match.}\par
02220         {\cf20 // See "table_width_distrib" and "table_width_keep_visible" tests}\par
02221         max_width = table->WorkRect.Max.x - (table->ColumnsEnabledCount - column->IndexWithinEnabledSet - 1) * min_column_distance - column->MinX;\par
02222         {\cf20 //max_width -= table->CellSpacingX1;}\par
02223         max_width -= table->CellSpacingX2;\par
02224         max_width -= table->CellPaddingX * 2.0f;\par
02225         max_width -= table->OuterPaddingX;\par
02226     \}\par
02227     {\cf19 return} max_width;\par
02228 \}\par
02229 \par
02230 {\cf20 // Note this is meant to be stored in column->WidthAuto, please generally use the WidthAuto field}\par
02231 {\cf18 float} ImGui::TableGetColumnWidthAuto(ImGuiTable* table, ImGuiTableColumn* column)\par
02232 \{\par
02233     {\cf17 const} {\cf18 float} content_width_body = ImMax(column->ContentMaxXFrozen, column->ContentMaxXUnfrozen) - column->WorkMinX;\par
02234     {\cf17 const} {\cf18 float} content_width_headers = column->ContentMaxXHeadersIdeal - column->WorkMinX;\par
02235     {\cf18 float} width_auto = content_width_body;\par
02236     {\cf19 if} (!(column->Flags & ImGuiTableColumnFlags_NoHeaderWidth))\par
02237         width_auto = ImMax(width_auto, content_width_headers);\par
02238 \par
02239     {\cf20 // Non-resizable fixed columns preserve their requested width}\par
02240     {\cf19 if} ((column->Flags & ImGuiTableColumnFlags_WidthFixed) && column->InitStretchWeightOrWidth > 0.0f)\par
02241         {\cf19 if} (!(table->Flags & ImGuiTableFlags_Resizable) || (column->Flags & ImGuiTableColumnFlags_NoResize))\par
02242             width_auto = column->InitStretchWeightOrWidth;\par
02243 \par
02244     {\cf19 return} ImMax(width_auto, table->MinColumnWidth);\par
02245 \}\par
02246 \par
02247 {\cf20 // 'width' = inner column width, without padding}\par
02248 {\cf18 void} ImGui::TableSetColumnWidth({\cf18 int} column_n, {\cf18 float} width)\par
02249 \{\par
02250     ImGuiContext& g = *GImGui;\par
02251     ImGuiTable* table = g.CurrentTable;\par
02252     IM_ASSERT(table != NULL && table->IsLayoutLocked == {\cf17 false});\par
02253     IM_ASSERT(column_n >= 0 && column_n < table->ColumnsCount);\par
02254     ImGuiTableColumn* column_0 = &table->Columns[column_n];\par
02255     {\cf18 float} column_0_width = width;\par
02256 \par
02257     {\cf20 // Apply constraints early}\par
02258     {\cf20 // Compare both requested and actual given width to avoid overwriting requested width when column is stuck (minimum size, bounded)}\par
02259     IM_ASSERT(table->MinColumnWidth > 0.0f);\par
02260     {\cf17 const} {\cf18 float} min_width = table->MinColumnWidth;\par
02261     {\cf17 const} {\cf18 float} max_width = ImMax(min_width, TableGetMaxColumnWidth(table, column_n));\par
02262     column_0_width = ImClamp(column_0_width, min_width, max_width);\par
02263     {\cf19 if} (column_0->WidthGiven == column_0_width || column_0->WidthRequest == column_0_width)\par
02264         {\cf19 return};\par
02265 \par
02266     {\cf20 //IMGUI_DEBUG_PRINT("TableSetColumnWidth(%d, %.1f->%.1f)\\n", column_0_idx, column_0->WidthGiven, column_0_width);}\par
02267     ImGuiTableColumn* column_1 = (column_0->NextEnabledColumn != -1) ? &table->Columns[column_0->NextEnabledColumn] : NULL;\par
02268 \par
02269     {\cf20 // In this surprisingly not simple because of how we support mixing Fixed and multiple Stretch columns.}\par
02270     {\cf20 // - All fixed: easy.}\par
02271     {\cf20 // - All stretch: easy.}\par
02272     {\cf20 // - One or more fixed + one stretch: easy.}\par
02273     {\cf20 // - One or more fixed + more than one stretch: tricky.}\par
02274     {\cf20 // Qt when manual resize is enabled only supports a single _trailing_ stretch column, we support more cases here.}\par
02275 \par
02276     {\cf20 // When forwarding resize from Wn| to Fn+1| we need to be considerate of the _NoResize flag on Fn+1.}\par
02277     {\cf20 // FIXME-TABLE: Find a way to rewrite all of this so interactions feel more consistent for the user.}\par
02278     {\cf20 // Scenarios:}\par
02279     {\cf20 // - F1 F2 F3  resize from F1| or F2|   --> ok: alter ->WidthRequested of Fixed column. Subsequent columns will be offset.}\par
02280     {\cf20 // - F1 F2 F3  resize from F3|          --> ok: alter ->WidthRequested of Fixed column. If active, ScrollX extent can be altered.}\par
02281     {\cf20 // - F1 F2 W3  resize from F1| or F2|   --> ok: alter ->WidthRequested of Fixed column. If active, ScrollX extent can be altered, but it doesn't make much sense as the Stretch column will always be minimal size.}\par
02282     {\cf20 // - F1 F2 W3  resize from W3|          --> ok: no-op (disabled by Resize Rule 1)}\par
02283     {\cf20 // - W1 W2 W3  resize from W1| or W2|   --> ok}\par
02284     {\cf20 // - W1 W2 W3  resize from W3|          --> ok: no-op (disabled by Resize Rule 1)}\par
02285     {\cf20 // - W1 F2 F3  resize from F3|          --> ok: no-op (disabled by Resize Rule 1)}\par
02286     {\cf20 // - W1 F2     resize from F2|          --> ok: no-op (disabled by Resize Rule 1)}\par
02287     {\cf20 // - W1 W2 F3  resize from W1| or W2|   --> ok}\par
02288     {\cf20 // - W1 F2 W3  resize from W1| or F2|   --> ok}\par
02289     {\cf20 // - F1 W2 F3  resize from W2|          --> ok}\par
02290     {\cf20 // - F1 W3 F2  resize from W3|          --> ok}\par
02291     {\cf20 // - W1 F2 F3  resize from W1|          --> ok: equivalent to resizing |F2. F3 will not move.}\par
02292     {\cf20 // - W1 F2 F3  resize from F2|          --> ok}\par
02293     {\cf20 // All resizes from a Wx columns are locking other columns.}\par
02294 \par
02295     {\cf20 // Possible improvements:}\par
02296     {\cf20 // - W1 W2 W3  resize W1|               --> to not be stuck, both W2 and W3 would stretch down. Seems possible to fix. Would be most beneficial to simplify resize of all-weighted columns.}\par
02297     {\cf20 // - W3 F1 F2  resize W3|               --> to not be stuck past F1|, both F1 and F2 would need to stretch down, which would be lossy or ambiguous. Seems hard to fix.}\par
02298 \par
02299     {\cf20 // [Resize Rule 1] Can't resize from right of right-most visible column if there is any Stretch column. Implemented in TableUpdateLayout().}\par
02300 \par
02301     {\cf20 // If we have all Fixed columns OR resizing a Fixed column that doesn't come after a Stretch one, we can do an offsetting resize.}\par
02302     {\cf20 // This is the preferred resize path}\par
02303     {\cf19 if} (column_0->Flags & ImGuiTableColumnFlags_WidthFixed)\par
02304         {\cf19 if} (!column_1 || table->LeftMostStretchedColumn == -1 || table->Columns[table->LeftMostStretchedColumn].DisplayOrder >= column_0->DisplayOrder)\par
02305         \{\par
02306             column_0->WidthRequest = column_0_width;\par
02307             table->IsSettingsDirty = {\cf17 true};\par
02308             {\cf19 return};\par
02309         \}\par
02310 \par
02311     {\cf20 // We can also use previous column if there's no next one (this is used when doing an auto-fit on the right-most stretch column)}\par
02312     {\cf19 if} (column_1 == NULL)\par
02313         column_1 = (column_0->PrevEnabledColumn != -1) ? &table->Columns[column_0->PrevEnabledColumn] : NULL;\par
02314     {\cf19 if} (column_1 == NULL)\par
02315         {\cf19 return};\par
02316 \par
02317     {\cf20 // Resizing from right-side of a Stretch column before a Fixed column forward sizing to left-side of fixed column.}\par
02318     {\cf20 // (old_a + old_b == new_a + new_b) --> (new_a == old_a + old_b - new_b)}\par
02319     {\cf18 float} column_1_width = ImMax(column_1->WidthRequest - (column_0_width - column_0->WidthRequest), min_width);\par
02320     column_0_width = column_0->WidthRequest + column_1->WidthRequest - column_1_width;\par
02321     IM_ASSERT(column_0_width > 0.0f && column_1_width > 0.0f);\par
02322     column_0->WidthRequest = column_0_width;\par
02323     column_1->WidthRequest = column_1_width;\par
02324     {\cf19 if} ((column_0->Flags | column_1->Flags) & ImGuiTableColumnFlags_WidthStretch)\par
02325         TableUpdateColumnsWeightFromWidth(table);\par
02326     table->IsSettingsDirty = {\cf17 true};\par
02327 \}\par
02328 \par
02329 {\cf20 // Disable clipping then auto-fit, will take 2 frames}\par
02330 {\cf20 // (we don't take a shortcut for unclipped columns to reduce inconsistencies when e.g. resizing multiple columns)}\par
02331 {\cf18 void} ImGui::TableSetColumnWidthAutoSingle(ImGuiTable* table, {\cf18 int} column_n)\par
02332 \{\par
02333     {\cf20 // Single auto width uses auto-fit}\par
02334     ImGuiTableColumn* column = &table->Columns[column_n];\par
02335     {\cf19 if} (!column->IsEnabled)\par
02336         {\cf19 return};\par
02337     column->CannotSkipItemsQueue = (1 << 0);\par
02338     table->AutoFitSingleColumn = (ImGuiTableColumnIdx)column_n;\par
02339 \}\par
02340 \par
02341 {\cf18 void} ImGui::TableSetColumnWidthAutoAll(ImGuiTable* table)\par
02342 \{\par
02343     {\cf19 for} ({\cf18 int} column_n = 0; column_n < table->ColumnsCount; column_n++)\par
02344     \{\par
02345         ImGuiTableColumn* column = &table->Columns[column_n];\par
02346         {\cf19 if} (!column->IsEnabled && !(column->Flags & ImGuiTableColumnFlags_WidthStretch)) {\cf20 // Cannot reset weight of hidden stretch column}\par
02347             {\cf19 continue};\par
02348         column->CannotSkipItemsQueue = (1 << 0);\par
02349         column->AutoFitQueue = (1 << 1);\par
02350     \}\par
02351 \}\par
02352 \par
02353 {\cf18 void} ImGui::TableUpdateColumnsWeightFromWidth(ImGuiTable* table)\par
02354 \{\par
02355     IM_ASSERT(table->LeftMostStretchedColumn != -1 && table->RightMostStretchedColumn != -1);\par
02356 \par
02357     {\cf20 // Measure existing quantities}\par
02358     {\cf18 float} visible_weight = 0.0f;\par
02359     {\cf18 float} visible_width = 0.0f;\par
02360     {\cf19 for} ({\cf18 int} column_n = 0; column_n < table->ColumnsCount; column_n++)\par
02361     \{\par
02362         ImGuiTableColumn* column = &table->Columns[column_n];\par
02363         {\cf19 if} (!column->IsEnabled || !(column->Flags & ImGuiTableColumnFlags_WidthStretch))\par
02364             {\cf19 continue};\par
02365         IM_ASSERT(column->StretchWeight > 0.0f);\par
02366         visible_weight += column->StretchWeight;\par
02367         visible_width += column->WidthRequest;\par
02368     \}\par
02369     IM_ASSERT(visible_weight > 0.0f && visible_width > 0.0f);\par
02370 \par
02371     {\cf20 // Apply new weights}\par
02372     {\cf19 for} ({\cf18 int} column_n = 0; column_n < table->ColumnsCount; column_n++)\par
02373     \{\par
02374         ImGuiTableColumn* column = &table->Columns[column_n];\par
02375         {\cf19 if} (!column->IsEnabled || !(column->Flags & ImGuiTableColumnFlags_WidthStretch))\par
02376             {\cf19 continue};\par
02377         column->StretchWeight = (column->WidthRequest / visible_width) * visible_weight;\par
02378         IM_ASSERT(column->StretchWeight > 0.0f);\par
02379     \}\par
02380 \}\par
02381 \par
02382 {\cf20 //-------------------------------------------------------------------------}\par
02383 {\cf20 // [SECTION] Tables: Drawing}\par
02384 {\cf20 //-------------------------------------------------------------------------}\par
02385 {\cf20 // - TablePushBackgroundChannel() [Internal]}\par
02386 {\cf20 // - TablePopBackgroundChannel() [Internal]}\par
02387 {\cf20 // - TableSetupDrawChannels() [Internal]}\par
02388 {\cf20 // - TableMergeDrawChannels() [Internal]}\par
02389 {\cf20 // - TableGetColumnBorderCol() [Internal]}\par
02390 {\cf20 // - TableDrawBorders() [Internal]}\par
02391 {\cf20 //-------------------------------------------------------------------------}\par
02392 \par
02393 {\cf20 // Bg2 is used by Selectable (and possibly other widgets) to render to the background.}\par
02394 {\cf20 // Unlike our Bg0/1 channel which we uses for RowBg/CellBg/Borders and where we guarantee all shapes to be CPU-clipped, the Bg2 channel being widgets-facing will rely on regular ClipRect.}\par
02395 {\cf18 void} ImGui::TablePushBackgroundChannel()\par
02396 \{\par
02397     ImGuiContext& g = *GImGui;\par
02398     ImGuiWindow* window = g.CurrentWindow;\par
02399     ImGuiTable* table = g.CurrentTable;\par
02400 \par
02401     {\cf20 // Optimization: avoid SetCurrentChannel() + PushClipRect()}\par
02402     table->HostBackupInnerClipRect = window->ClipRect;\par
02403     SetWindowClipRectBeforeSetChannel(window, table->Bg2ClipRectForDrawCmd);\par
02404     table->DrawSplitter->SetCurrentChannel(window->DrawList, table->Bg2DrawChannelCurrent);\par
02405 \}\par
02406 \par
02407 {\cf18 void} ImGui::TablePopBackgroundChannel()\par
02408 \{\par
02409     ImGuiContext& g = *GImGui;\par
02410     ImGuiWindow* window = g.CurrentWindow;\par
02411     ImGuiTable* table = g.CurrentTable;\par
02412     ImGuiTableColumn* column = &table->Columns[table->CurrentColumn];\par
02413 \par
02414     {\cf20 // Optimization: avoid PopClipRect() + SetCurrentChannel()}\par
02415     SetWindowClipRectBeforeSetChannel(window, table->HostBackupInnerClipRect);\par
02416     table->DrawSplitter->SetCurrentChannel(window->DrawList, column->DrawChannelCurrent);\par
02417 \}\par
02418 \par
02419 {\cf20 // Allocate draw channels. Called by TableUpdateLayout()}\par
02420 {\cf20 // - We allocate them following storage order instead of display order so reordering columns won't needlessly}\par
02421 {\cf20 //   increase overall dormant memory cost.}\par
02422 {\cf20 // - We isolate headers draw commands in their own channels instead of just altering clip rects.}\par
02423 {\cf20 //   This is in order to facilitate merging of draw commands.}\par
02424 {\cf20 // - After crossing FreezeRowsCount, all columns see their current draw channel changed to a second set of channels.}\par
02425 {\cf20 // - We only use the dummy draw channel so we can push a null clipping rectangle into it without affecting other}\par
02426 {\cf20 //   channels, while simplifying per-row/per-cell overhead. It will be empty and discarded when merged.}\par
02427 {\cf20 // - We allocate 1 or 2 background draw channels. This is because we know TablePushBackgroundChannel() is only used for}\par
02428 {\cf20 //   horizontal spanning. If we allowed vertical spanning we'd need one background draw channel per merge group (1-4).}\par
02429 {\cf20 // Draw channel allocation (before merging):}\par
02430 {\cf20 // - NoClip                       --> 2+D+1 channels: bg0/1 + bg2 + foreground (same clip rect == always 1 draw call)}\par
02431 {\cf20 // - Clip                         --> 2+D+N channels}\par
02432 {\cf20 // - FreezeRows                   --> 2+D+N*2 (unless scrolling value is zero)}\par
02433 {\cf20 // - FreezeRows || FreezeColunns  --> 3+D+N*2 (unless scrolling value is zero)}\par
02434 {\cf20 // Where D is 1 if any column is clipped or hidden (dummy channel) otherwise 0.}\par
02435 {\cf18 void} ImGui::TableSetupDrawChannels(ImGuiTable* table)\par
02436 \{\par
02437     {\cf17 const} {\cf18 int} freeze_row_multiplier = (table->FreezeRowsCount > 0) ? 2 : 1;\par
02438     {\cf17 const} {\cf18 int} channels_for_row = (table->Flags & ImGuiTableFlags_NoClip) ? 1 : table->ColumnsEnabledCount;\par
02439     {\cf17 const} {\cf18 int} channels_for_bg = 1 + 1 * freeze_row_multiplier;\par
02440     {\cf17 const} {\cf18 int} channels_for_dummy = (table->ColumnsEnabledCount < table->ColumnsCount || (memcmp(table->VisibleMaskByIndex, table->EnabledMaskByIndex, ImBitArrayGetStorageSizeInBytes(table->ColumnsCount)) != 0)) ? +1 : 0;\par
02441     {\cf17 const} {\cf18 int} channels_total = channels_for_bg + (channels_for_row * freeze_row_multiplier) + channels_for_dummy;\par
02442     table->DrawSplitter->Split(table->InnerWindow->DrawList, channels_total);\par
02443     table->DummyDrawChannel = (ImGuiTableDrawChannelIdx)((channels_for_dummy > 0) ? channels_total - 1 : -1);\par
02444     table->Bg2DrawChannelCurrent = TABLE_DRAW_CHANNEL_BG2_FROZEN;\par
02445     table->Bg2DrawChannelUnfrozen = (ImGuiTableDrawChannelIdx)((table->FreezeRowsCount > 0) ? 2 + channels_for_row : TABLE_DRAW_CHANNEL_BG2_FROZEN);\par
02446 \par
02447     {\cf18 int} draw_channel_current = 2;\par
02448     {\cf19 for} ({\cf18 int} column_n = 0; column_n < table->ColumnsCount; column_n++)\par
02449     \{\par
02450         ImGuiTableColumn* column = &table->Columns[column_n];\par
02451         {\cf19 if} (column->IsVisibleX && column->IsVisibleY)\par
02452         \{\par
02453             column->DrawChannelFrozen = (ImGuiTableDrawChannelIdx)(draw_channel_current);\par
02454             column->DrawChannelUnfrozen = (ImGuiTableDrawChannelIdx)(draw_channel_current + (table->FreezeRowsCount > 0 ? channels_for_row + 1 : 0));\par
02455             {\cf19 if} (!(table->Flags & ImGuiTableFlags_NoClip))\par
02456                 draw_channel_current++;\par
02457         \}\par
02458         {\cf19 else}\par
02459         \{\par
02460             column->DrawChannelFrozen = column->DrawChannelUnfrozen = table->DummyDrawChannel;\par
02461         \}\par
02462         column->DrawChannelCurrent = column->DrawChannelFrozen;\par
02463     \}\par
02464 \par
02465     {\cf20 // Initial draw cmd starts with a BgClipRect that matches the one of its host, to facilitate merge draw commands by default.}\par
02466     {\cf20 // All our cell highlight are manually clipped with BgClipRect. When unfreezing it will be made smaller to fit scrolling rect.}\par
02467     {\cf20 // (This technically isn't part of setting up draw channels, but is reasonably related to be done here)}\par
02468     table->BgClipRect = table->InnerClipRect;\par
02469     table->Bg0ClipRectForDrawCmd = table->OuterWindow->ClipRect;\par
02470     table->Bg2ClipRectForDrawCmd = table->HostClipRect;\par
02471     IM_ASSERT(table->BgClipRect.Min.y <= table->BgClipRect.Max.y);\par
02472 \}\par
02473 \par
02474 {\cf20 // This function reorder draw channels based on matching clip rectangle, to facilitate merging them. Called by EndTable().}\par
02475 {\cf20 // For simplicity we call it TableMergeDrawChannels() but in fact it only reorder channels + overwrite ClipRect,}\par
02476 {\cf20 // actual merging is done by table->DrawSplitter.Merge() which is called right after TableMergeDrawChannels().}\par
02477 {\cf20 //}\par
02478 {\cf20 // Columns where the contents didn't stray off their local clip rectangle can be merged. To achieve}\par
02479 {\cf20 // this we merge their clip rect and make them contiguous in the channel list, so they can be merged}\par
02480 {\cf20 // by the call to DrawSplitter.Merge() following to the call to this function.}\par
02481 {\cf20 // We reorder draw commands by arranging them into a maximum of 4 distinct groups:}\par
02482 {\cf20 //}\par
02483 {\cf20 //   1 group:               2 groups:              2 groups:              4 groups:}\par
02484 {\cf20 //   [ 0. ] no freeze       [ 0. ] row freeze      [ 01 ] col freeze      [ 01 ] row+col freeze}\par
02485 {\cf20 //   [ .. ]  or no scroll   [ 2. ]  and v-scroll   [ .. ]  and h-scroll   [ 23 ]  and v+h-scroll}\par
02486 {\cf20 //}\par
02487 {\cf20 // Each column itself can use 1 channel (row freeze disabled) or 2 channels (row freeze enabled).}\par
02488 {\cf20 // When the contents of a column didn't stray off its limit, we move its channels into the corresponding group}\par
02489 {\cf20 // based on its position (within frozen rows/columns groups or not).}\par
02490 {\cf20 // At the end of the operation our 1-4 groups will each have a ImDrawCmd using the same ClipRect.}\par
02491 {\cf20 // This function assume that each column are pointing to a distinct draw channel,}\par
02492 {\cf20 // otherwise merge_group->ChannelsCount will not match set bit count of merge_group->ChannelsMask.}\par
02493 {\cf20 //}\par
02494 {\cf20 // Column channels will not be merged into one of the 1-4 groups in the following cases:}\par
02495 {\cf20 // - The contents stray off its clipping rectangle (we only compare the MaxX value, not the MinX value).}\par
02496 {\cf20 //   Direct ImDrawList calls won't be taken into account by default, if you use them make sure the ImGui:: bounds}\par
02497 {\cf20 //   matches, by e.g. calling SetCursorScreenPos().}\par
02498 {\cf20 // - The channel uses more than one draw command itself. We drop all our attempt at merging stuff here..}\par
02499 {\cf20 //   we could do better but it's going to be rare and probably not worth the hassle.}\par
02500 {\cf20 // Columns for which the draw channel(s) haven't been merged with other will use their own ImDrawCmd.}\par
02501 {\cf20 //}\par
02502 {\cf20 // This function is particularly tricky to understand.. take a breath.}\par
02503 {\cf18 void} ImGui::TableMergeDrawChannels(ImGuiTable* table)\par
02504 \{\par
02505     ImGuiContext& g = *GImGui;\par
02506     ImDrawListSplitter* splitter = table->DrawSplitter;\par
02507     {\cf17 const} {\cf18 bool} has_freeze_v = (table->FreezeRowsCount > 0);\par
02508     {\cf17 const} {\cf18 bool} has_freeze_h = (table->FreezeColumnsCount > 0);\par
02509     IM_ASSERT(splitter->_Current == 0);\par
02510 \par
02511     {\cf20 // Track which groups we are going to attempt to merge, and which channels goes into each group.}\par
02512     {\cf17 struct }MergeGroup\par
02513     \{\par
02514         ImRect          ClipRect;\par
02515         {\cf18 int}             ChannelsCount = 0;\par
02516         ImBitArrayPtr   ChannelsMask = NULL;\par
02517     \};\par
02518     {\cf18 int} merge_group_mask = 0x00;\par
02519     MergeGroup merge_groups[4];\par
02520 \par
02521     {\cf20 // Use a reusable temp buffer for the merge masks as they are dynamically sized.}\par
02522     {\cf17 const} {\cf18 int} max_draw_channels = (4 + table->ColumnsCount * 2);\par
02523     {\cf17 const} {\cf18 int} size_for_masks_bitarrays_one = (int)ImBitArrayGetStorageSizeInBytes(max_draw_channels);\par
02524     g.TempBuffer.reserve(size_for_masks_bitarrays_one * 5);\par
02525     memset(g.TempBuffer.Data, 0, size_for_masks_bitarrays_one * 5);\par
02526     {\cf19 for} ({\cf18 int} n = 0; n < IM_ARRAYSIZE(merge_groups); n++)\par
02527         merge_groups[n].ChannelsMask = (ImBitArrayPtr)({\cf18 void}*)(g.TempBuffer.Data + (size_for_masks_bitarrays_one * n));\par
02528     ImBitArrayPtr remaining_mask = (ImBitArrayPtr)({\cf18 void}*)(g.TempBuffer.Data + (size_for_masks_bitarrays_one * 4));\par
02529 \par
02530     {\cf20 // 1. Scan channels and take note of those which can be merged}\par
02531     {\cf19 for} ({\cf18 int} column_n = 0; column_n < table->ColumnsCount; column_n++)\par
02532     \{\par
02533         {\cf19 if} (!IM_BITARRAY_TESTBIT(table->VisibleMaskByIndex, column_n))\par
02534             {\cf19 continue};\par
02535         ImGuiTableColumn* column = &table->Columns[column_n];\par
02536 \par
02537         {\cf17 const} {\cf18 int} merge_group_sub_count = has_freeze_v ? 2 : 1;\par
02538         {\cf19 for} ({\cf18 int} merge_group_sub_n = 0; merge_group_sub_n < merge_group_sub_count; merge_group_sub_n++)\par
02539         \{\par
02540             {\cf17 const} {\cf18 int} channel_no = (merge_group_sub_n == 0) ? column->DrawChannelFrozen : column->DrawChannelUnfrozen;\par
02541 \par
02542             {\cf20 // Don't attempt to merge if there are multiple draw calls within the column}\par
02543             ImDrawChannel* src_channel = &splitter->_Channels[channel_no];\par
02544             {\cf19 if} (src_channel->_CmdBuffer.Size > 0 && src_channel->_CmdBuffer.back().ElemCount == 0 && src_channel->_CmdBuffer.back().UserCallback == NULL) {\cf20 // Equivalent of PopUnusedDrawCmd()}\par
02545                 src_channel->_CmdBuffer.pop_back();\par
02546             {\cf19 if} (src_channel->_CmdBuffer.Size != 1)\par
02547                 {\cf19 continue};\par
02548 \par
02549             {\cf20 // Find out the width of this merge group and check if it will fit in our column}\par
02550             {\cf20 // (note that we assume that rendering didn't stray on the left direction. we should need a CursorMinPos to detect it)}\par
02551             {\cf19 if} (!(column->Flags & ImGuiTableColumnFlags_NoClip))\par
02552             \{\par
02553                 {\cf18 float} content_max_x;\par
02554                 {\cf19 if} (!has_freeze_v)\par
02555                     content_max_x = ImMax(column->ContentMaxXUnfrozen, column->ContentMaxXHeadersUsed); {\cf20 // No row freeze}\par
02556                 {\cf19 else} {\cf19 if} (merge_group_sub_n == 0)\par
02557                     content_max_x = ImMax(column->ContentMaxXFrozen, column->ContentMaxXHeadersUsed);   {\cf20 // Row freeze: use width before freeze}\par
02558                 {\cf19 else}\par
02559                     content_max_x = column->ContentMaxXUnfrozen;                                        {\cf20 // Row freeze: use width after freeze}\par
02560                 {\cf19 if} (content_max_x > column->ClipRect.Max.x)\par
02561                     {\cf19 continue};\par
02562             \}\par
02563 \par
02564             {\cf17 const} {\cf18 int} merge_group_n = (has_freeze_h && column_n < table->FreezeColumnsCount ? 0 : 1) + (has_freeze_v && merge_group_sub_n == 0 ? 0 : 2);\par
02565             IM_ASSERT(channel_no < max_draw_channels);\par
02566             MergeGroup* merge_group = &merge_groups[merge_group_n];\par
02567             {\cf19 if} (merge_group->ChannelsCount == 0)\par
02568                 merge_group->ClipRect = ImRect(+FLT_MAX, +FLT_MAX, -FLT_MAX, -FLT_MAX);\par
02569             ImBitArraySetBit(merge_group->ChannelsMask, channel_no);\par
02570             merge_group->ChannelsCount++;\par
02571             merge_group->ClipRect.Add(src_channel->_CmdBuffer[0].ClipRect);\par
02572             merge_group_mask |= (1 << merge_group_n);\par
02573         \}\par
02574 \par
02575         {\cf20 // Invalidate current draw channel}\par
02576         {\cf20 // (we don't clear DrawChannelFrozen/DrawChannelUnfrozen solely to facilitate debugging/later inspection of data)}\par
02577         column->DrawChannelCurrent = (ImGuiTableDrawChannelIdx)-1;\par
02578     \}\par
02579 \par
02580     {\cf20 // [DEBUG] Display merge groups}\par
02581 {\cf21 #if 0}\par
02582     {\cf19 if} (g.IO.KeyShift)\par
02583         {\cf19 for} ({\cf18 int} merge_group_n = 0; merge_group_n < IM_ARRAYSIZE(merge_groups); merge_group_n++)\par
02584         \{\par
02585             MergeGroup* merge_group = &merge_groups[merge_group_n];\par
02586             {\cf19 if} (merge_group->ChannelsCount == 0)\par
02587                 {\cf19 continue};\par
02588             {\cf18 char} buf[32];\par
02589             ImFormatString(buf, 32, {\cf22 "MG%d:%d"}, merge_group_n, merge_group->ChannelsCount);\par
02590             ImVec2 text_pos = merge_group->ClipRect.Min + ImVec2(4, 4);\par
02591             ImVec2 text_size = CalcTextSize(buf, NULL);\par
02592             GetForegroundDrawList()->AddRectFilled(text_pos, text_pos + text_size, IM_COL32(0, 0, 0, 255));\par
02593             GetForegroundDrawList()->AddText(text_pos, IM_COL32(255, 255, 0, 255), buf, NULL);\par
02594             GetForegroundDrawList()->AddRect(merge_group->ClipRect.Min, merge_group->ClipRect.Max, IM_COL32(255, 255, 0, 255));\par
02595         \}\par
02596 {\cf21 #endif}\par
02597 \par
02598     {\cf20 // 2. Rewrite channel list in our preferred order}\par
02599     {\cf19 if} (merge_group_mask != 0)\par
02600     \{\par
02601         {\cf20 // We skip channel 0 (Bg0/Bg1) and 1 (Bg2 frozen) from the shuffling since they won't move - see channels allocation in TableSetupDrawChannels().}\par
02602         {\cf17 const} {\cf18 int} LEADING_DRAW_CHANNELS = 2;\par
02603         g.DrawChannelsTempMergeBuffer.resize(splitter->_Count - LEADING_DRAW_CHANNELS); {\cf20 // Use shared temporary storage so the allocation gets amortized}\par
02604         ImDrawChannel* dst_tmp = g.DrawChannelsTempMergeBuffer.Data;\par
02605         ImBitArraySetBitRange(remaining_mask, LEADING_DRAW_CHANNELS, splitter->_Count);\par
02606         ImBitArrayClearBit(remaining_mask, table->Bg2DrawChannelUnfrozen);\par
02607         IM_ASSERT(has_freeze_v == {\cf17 false} || table->Bg2DrawChannelUnfrozen != TABLE_DRAW_CHANNEL_BG2_FROZEN);\par
02608         {\cf18 int} remaining_count = splitter->_Count - (has_freeze_v ? LEADING_DRAW_CHANNELS + 1 : LEADING_DRAW_CHANNELS);\par
02609         {\cf20 //ImRect host_rect = (table->InnerWindow == table->OuterWindow) ? table->InnerClipRect : table->HostClipRect;}\par
02610         ImRect host_rect = table->HostClipRect;\par
02611         {\cf19 for} ({\cf18 int} merge_group_n = 0; merge_group_n < IM_ARRAYSIZE(merge_groups); merge_group_n++)\par
02612         \{\par
02613             {\cf19 if} ({\cf18 int} merge_channels_count = merge_groups[merge_group_n].ChannelsCount)\par
02614             \{\par
02615                 MergeGroup* merge_group = &merge_groups[merge_group_n];\par
02616                 ImRect merge_clip_rect = merge_group->ClipRect;\par
02617 \par
02618                 {\cf20 // Extend outer-most clip limits to match those of host, so draw calls can be merged even if}\par
02619                 {\cf20 // outer-most columns have some outer padding offsetting them from their parent ClipRect.}\par
02620                 {\cf20 // The principal cases this is dealing with are:}\par
02621                 {\cf20 // - On a same-window table (not scrolling = single group), all fitting columns ClipRect -> will extend and match host ClipRect -> will merge}\par
02622                 {\cf20 // - Columns can use padding and have left-most ClipRect.Min.x and right-most ClipRect.Max.x != from host ClipRect -> will extend and match host ClipRect -> will merge}\par
02623                 {\cf20 // FIXME-TABLE FIXME-WORKRECT: We are wasting a merge opportunity on tables without scrolling if column doesn't fit}\par
02624                 {\cf20 // within host clip rect, solely because of the half-padding difference between window->WorkRect and window->InnerClipRect.}\par
02625                 {\cf19 if} ((merge_group_n & 1) == 0 || !has_freeze_h)\par
02626                     merge_clip_rect.Min.x = ImMin(merge_clip_rect.Min.x, host_rect.Min.x);\par
02627                 {\cf19 if} ((merge_group_n & 2) == 0 || !has_freeze_v)\par
02628                     merge_clip_rect.Min.y = ImMin(merge_clip_rect.Min.y, host_rect.Min.y);\par
02629                 {\cf19 if} ((merge_group_n & 1) != 0)\par
02630                     merge_clip_rect.Max.x = ImMax(merge_clip_rect.Max.x, host_rect.Max.x);\par
02631                 {\cf19 if} ((merge_group_n & 2) != 0 && (table->Flags & ImGuiTableFlags_NoHostExtendY) == 0)\par
02632                     merge_clip_rect.Max.y = ImMax(merge_clip_rect.Max.y, host_rect.Max.y);\par
02633                 {\cf20 //GetForegroundDrawList()->AddRect(merge_group->ClipRect.Min, merge_group->ClipRect.Max, IM_COL32(255, 0, 0, 200), 0.0f, 0, 1.0f); // [DEBUG]}\par
02634                 {\cf20 //GetForegroundDrawList()->AddLine(merge_group->ClipRect.Min, merge_clip_rect.Min, IM_COL32(255, 100, 0, 200));}\par
02635                 {\cf20 //GetForegroundDrawList()->AddLine(merge_group->ClipRect.Max, merge_clip_rect.Max, IM_COL32(255, 100, 0, 200));}\par
02636                 remaining_count -= merge_group->ChannelsCount;\par
02637                 {\cf19 for} ({\cf18 int} n = 0; n < (size_for_masks_bitarrays_one >> 2); n++)\par
02638                     remaining_mask[n] &= ~merge_group->ChannelsMask[n];\par
02639                 {\cf19 for} ({\cf18 int} n = 0; n < splitter->_Count && merge_channels_count != 0; n++)\par
02640                 \{\par
02641                     {\cf20 // Copy + overwrite new clip rect}\par
02642                     {\cf19 if} (!IM_BITARRAY_TESTBIT(merge_group->ChannelsMask, n))\par
02643                         {\cf19 continue};\par
02644                     IM_BITARRAY_CLEARBIT(merge_group->ChannelsMask, n);\par
02645                     merge_channels_count--;\par
02646 \par
02647                     ImDrawChannel* channel = &splitter->_Channels[n];\par
02648                     IM_ASSERT(channel->_CmdBuffer.Size == 1 && merge_clip_rect.Contains(ImRect(channel->_CmdBuffer[0].ClipRect)));\par
02649                     channel->_CmdBuffer[0].ClipRect = merge_clip_rect.ToVec4();\par
02650                     memcpy(dst_tmp++, channel, {\cf17 sizeof}(ImDrawChannel));\par
02651                 \}\par
02652             \}\par
02653 \par
02654             {\cf20 // Make sure Bg2DrawChannelUnfrozen appears in the middle of our groups (whereas Bg0/Bg1 and Bg2 frozen are fixed to 0 and 1)}\par
02655             {\cf19 if} (merge_group_n == 1 && has_freeze_v)\par
02656                 memcpy(dst_tmp++, &splitter->_Channels[table->Bg2DrawChannelUnfrozen], {\cf17 sizeof}(ImDrawChannel));\par
02657         \}\par
02658 \par
02659         {\cf20 // Append unmergeable channels that we didn't reorder at the end of the list}\par
02660         {\cf19 for} ({\cf18 int} n = 0; n < splitter->_Count && remaining_count != 0; n++)\par
02661         \{\par
02662             {\cf19 if} (!IM_BITARRAY_TESTBIT(remaining_mask, n))\par
02663                 {\cf19 continue};\par
02664             ImDrawChannel* channel = &splitter->_Channels[n];\par
02665             memcpy(dst_tmp++, channel, {\cf17 sizeof}(ImDrawChannel));\par
02666             remaining_count--;\par
02667         \}\par
02668         IM_ASSERT(dst_tmp == g.DrawChannelsTempMergeBuffer.Data + g.DrawChannelsTempMergeBuffer.Size);\par
02669         memcpy(splitter->_Channels.Data + LEADING_DRAW_CHANNELS, g.DrawChannelsTempMergeBuffer.Data, (splitter->_Count - LEADING_DRAW_CHANNELS) * {\cf17 sizeof}(ImDrawChannel));\par
02670     \}\par
02671 \}\par
02672 \par
02673 {\cf17 static} ImU32 TableGetColumnBorderCol(ImGuiTable* table, {\cf18 int} order_n, {\cf18 int} column_n)\par
02674 \{\par
02675     {\cf17 const} {\cf18 bool} is_hovered = (table->HoveredColumnBorder == column_n);\par
02676     {\cf17 const} {\cf18 bool} is_resized = (table->ResizedColumn == column_n) && (table->InstanceInteracted == table->InstanceCurrent);\par
02677     {\cf17 const} {\cf18 bool} is_frozen_separator = (table->FreezeColumnsCount == order_n + 1);\par
02678     {\cf19 if} (is_resized || is_hovered)\par
02679         {\cf19 return} ImGui::GetColorU32(is_resized ? ImGuiCol_SeparatorActive : ImGuiCol_SeparatorHovered);\par
02680     {\cf19 if} (is_frozen_separator || (table->Flags & (ImGuiTableFlags_NoBordersInBody | ImGuiTableFlags_NoBordersInBodyUntilResize)))\par
02681         {\cf19 return} table->BorderColorStrong;\par
02682     {\cf19 return} table->BorderColorLight;\par
02683 \}\par
02684 \par
02685 {\cf20 // FIXME-TABLE: This is a mess, need to redesign how we render borders (as some are also done in TableEndRow)}\par
02686 {\cf18 void} ImGui::TableDrawBorders(ImGuiTable* table)\par
02687 \{\par
02688     ImGuiWindow* inner_window = table->InnerWindow;\par
02689     {\cf19 if} (!table->OuterWindow->ClipRect.Overlaps(table->OuterRect))\par
02690         {\cf19 return};\par
02691 \par
02692     ImDrawList* inner_drawlist = inner_window->DrawList;\par
02693     table->DrawSplitter->SetCurrentChannel(inner_drawlist, TABLE_DRAW_CHANNEL_BG0);\par
02694     inner_drawlist->PushClipRect(table->Bg0ClipRectForDrawCmd.Min, table->Bg0ClipRectForDrawCmd.Max, {\cf17 false});\par
02695 \par
02696     {\cf20 // Draw inner border and resizing feedback}\par
02697     ImGuiTableInstanceData* table_instance = TableGetInstanceData(table, table->InstanceCurrent);\par
02698     {\cf17 const} {\cf18 float} border_size = TABLE_BORDER_SIZE;\par
02699     {\cf17 const} {\cf18 float} draw_y1 = ImMax(table->InnerRect.Min.y, (table->FreezeRowsCount >= 1 ? table->InnerRect.Min.y : table->WorkRect.Min.y) + table->AngledHeadersHeight) + ((table->Flags & ImGuiTableFlags_BordersOuterH) ? 1.0f : 0.0f);\par
02700     {\cf17 const} {\cf18 float} draw_y2_body = table->InnerRect.Max.y;\par
02701     {\cf17 const} {\cf18 float} draw_y2_head = table->IsUsingHeaders ? ImMin(table->InnerRect.Max.y, (table->FreezeRowsCount >= 1 ? table->InnerRect.Min.y : table->WorkRect.Min.y) + table_instance->LastTopHeadersRowHeight) : draw_y1;\par
02702     {\cf19 if} (table->Flags & ImGuiTableFlags_BordersInnerV)\par
02703     \{\par
02704         {\cf19 for} ({\cf18 int} order_n = 0; order_n < table->ColumnsCount; order_n++)\par
02705         \{\par
02706             {\cf19 if} (!IM_BITARRAY_TESTBIT(table->EnabledMaskByDisplayOrder, order_n))\par
02707                 {\cf19 continue};\par
02708 \par
02709             {\cf17 const} {\cf18 int} column_n = table->DisplayOrderToIndex[order_n];\par
02710             ImGuiTableColumn* column = &table->Columns[column_n];\par
02711             {\cf17 const} {\cf18 bool} is_hovered = (table->HoveredColumnBorder == column_n);\par
02712             {\cf17 const} {\cf18 bool} is_resized = (table->ResizedColumn == column_n) && (table->InstanceInteracted == table->InstanceCurrent);\par
02713             {\cf17 const} {\cf18 bool} is_resizable = (column->Flags & (ImGuiTableColumnFlags_NoResize | ImGuiTableColumnFlags_NoDirectResize_)) == 0;\par
02714             {\cf17 const} {\cf18 bool} is_frozen_separator = (table->FreezeColumnsCount == order_n + 1);\par
02715             {\cf19 if} (column->MaxX > table->InnerClipRect.Max.x && !is_resized)\par
02716                 {\cf19 continue};\par
02717 \par
02718             {\cf20 // Decide whether right-most column is visible}\par
02719             {\cf19 if} (column->NextEnabledColumn == -1 && !is_resizable)\par
02720                 {\cf19 if} ((table->Flags & ImGuiTableFlags_SizingMask_) != ImGuiTableFlags_SizingFixedSame || (table->Flags & ImGuiTableFlags_NoHostExtendX))\par
02721                     {\cf19 continue};\par
02722             {\cf19 if} (column->MaxX <= column->ClipRect.Min.x) {\cf20 // FIXME-TABLE FIXME-STYLE: Assume BorderSize==1, this is problematic if we want to increase the border size..}\par
02723                 {\cf19 continue};\par
02724 \par
02725             {\cf20 // Draw in outer window so right-most column won't be clipped}\par
02726             {\cf20 // Always draw full height border when being resized/hovered, or on the delimitation of frozen column scrolling.}\par
02727             {\cf18 float} draw_y2 = (is_hovered || is_resized || is_frozen_separator || (table->Flags & (ImGuiTableFlags_NoBordersInBody | ImGuiTableFlags_NoBordersInBodyUntilResize)) == 0) ? draw_y2_body : draw_y2_head;\par
02728             {\cf19 if} (draw_y2 > draw_y1)\par
02729                 inner_drawlist->AddLine(ImVec2(column->MaxX, draw_y1), ImVec2(column->MaxX, draw_y2), TableGetColumnBorderCol(table, order_n, column_n), border_size);\par
02730         \}\par
02731     \}\par
02732 \par
02733     {\cf20 // Draw outer border}\par
02734     {\cf20 // FIXME: could use AddRect or explicit VLine/HLine helper?}\par
02735     {\cf19 if} (table->Flags & ImGuiTableFlags_BordersOuter)\par
02736     \{\par
02737         {\cf20 // Display outer border offset by 1 which is a simple way to display it without adding an extra draw call}\par
02738         {\cf20 // (Without the offset, in outer_window it would be rendered behind cells, because child windows are above their}\par
02739         {\cf20 // parent. In inner_window, it won't reach out over scrollbars. Another weird solution would be to display part}\par
02740         {\cf20 // of it in inner window, and the part that's over scrollbars in the outer window..)}\par
02741         {\cf20 // Either solution currently won't allow us to use a larger border size: the border would clipped.}\par
02742         {\cf17 const} ImRect outer_border = table->OuterRect;\par
02743         {\cf17 const} ImU32 outer_col = table->BorderColorStrong;\par
02744         {\cf19 if} ((table->Flags & ImGuiTableFlags_BordersOuter) == ImGuiTableFlags_BordersOuter)\par
02745         \{\par
02746             inner_drawlist->AddRect(outer_border.Min, outer_border.Max + ImVec2(1, 1), outer_col, 0.0f, 0, border_size);\par
02747         \}\par
02748         {\cf19 else} {\cf19 if} (table->Flags & ImGuiTableFlags_BordersOuterV)\par
02749         \{\par
02750             inner_drawlist->AddLine(outer_border.Min, ImVec2(outer_border.Min.x, outer_border.Max.y), outer_col, border_size);\par
02751             inner_drawlist->AddLine(ImVec2(outer_border.Max.x, outer_border.Min.y), outer_border.Max, outer_col, border_size);\par
02752         \}\par
02753         {\cf19 else} {\cf19 if} (table->Flags & ImGuiTableFlags_BordersOuterH)\par
02754         \{\par
02755             inner_drawlist->AddLine(outer_border.Min, ImVec2(outer_border.Max.x, outer_border.Min.y), outer_col, border_size);\par
02756             inner_drawlist->AddLine(ImVec2(outer_border.Min.x, outer_border.Max.y), outer_border.Max, outer_col, border_size);\par
02757         \}\par
02758     \}\par
02759     {\cf19 if} ((table->Flags & ImGuiTableFlags_BordersInnerH) && table->RowPosY2 < table->OuterRect.Max.y)\par
02760     \{\par
02761         {\cf20 // Draw bottom-most row border between it is above outer border.}\par
02762         {\cf17 const} {\cf18 float} border_y = table->RowPosY2;\par
02763         {\cf19 if} (border_y >= table->BgClipRect.Min.y && border_y < table->BgClipRect.Max.y)\par
02764             inner_drawlist->AddLine(ImVec2(table->BorderX1, border_y), ImVec2(table->BorderX2, border_y), table->BorderColorLight, border_size);\par
02765     \}\par
02766 \par
02767     inner_drawlist->PopClipRect();\par
02768 \}\par
