00674                 {\cf18 bool} release_in = hovered && (flags & ImGuiButtonFlags_PressedOnClickRelease) != 0;\par
00675                 {\cf18 bool} release_anywhere = (flags & ImGuiButtonFlags_PressedOnClickReleaseAnywhere) != 0;\par
