00507     ImGui_ImplOpenGL3_Data* bd = ImGui_ImplOpenGL3_GetBackendData();\par
00508 \par
00509     {\cf20 // Backup GL state}\par
00510     GLenum last_active_texture; glGetIntegerv(GL_ACTIVE_TEXTURE, (GLint*)&last_active_texture);\par
