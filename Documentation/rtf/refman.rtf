17671     {\cf19 if} (g.NavWindow && root_node->LastFocusedNodeId == node->ID)\par
17672     \{\par
17673         {\cf20 // FIXME: This could all be backed in RootWindowForTitleBarHighlight? Probably need to reorganize for both dock nodes + other RootWindowForTitleBarHighlight users (not-node)}\par
17674         ImGuiWindow* parent_window = g.NavWindow->RootWindow;\par
17675         {\cf19 while} (parent_window->Flags & ImGuiWindowFlags_ChildMenu)\par
17676             parent_window = parent_window->ParentWindow->RootWindow;\par
17677         ImGuiDockNode* start_parent_node = parent_window->DockNodeAsHost ? parent_window->DockNodeAsHost : parent_window->DockNode;\par
17678         {\cf19 for} (ImGuiDockNode* parent_node = start_parent_node; parent_node != NULL; parent_node = parent_node->HostWindow ? parent_node->HostWindow->RootWindow->DockNode : NULL)\par
17679             {\cf19 if} ((parent_node = ImGui::DockNodeGetRootNode(parent_node)) == root_node)\par
17680                 {\cf19 return} {\cf17 true};\par
