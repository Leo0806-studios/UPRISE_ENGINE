14706 {\cf18 void} ImGui::SaveIniSettingsToDisk({\cf17 const} {\cf18 char}* ini_filename)\par
14707 \{\par
14708     ImGuiContext& g = *GImGui;\par
14709     g.SettingsDirtyTimer = 0.0f;\par
14710     {\cf19 if} (!ini_filename)\par
14711         {\cf19 return};\par
14712 \par
14713     {\cf18 size_t} ini_data_size = 0;\par
14714     {\cf17 const} {\cf18 char}* ini_data = SaveIniSettingsToMemory(&ini_data_size);\par
14715     ImFileHandle f = ImFileOpen(ini_filename, {\cf22 "wt"});\par
14716     {\cf19 if} (!f)\par
