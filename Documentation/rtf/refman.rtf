02467 {\cf18 int} ImTextStrToUtf8({\cf18 char}* out_buf, {\cf18 int} out_buf_size, {\cf17 const} ImWchar* in_text, {\cf17 const} ImWchar* in_text_end)\par
02468 \{\par
02469     {\cf18 char}* buf_p = out_buf;\par
02470     {\cf17 const} {\cf18 char}* buf_end = out_buf + out_buf_size;\par
02471     {\cf19 while} (buf_p < buf_end - 1 && (!in_text_end || in_text < in_text_end) && *in_text)\par
02472     \{\par
02473         {\cf18 unsigned} {\cf18 int} c = ({\cf18 unsigned} int)(*in_text++);\par
02474         {\cf19 if} (c < 0x80)\par
02475             *buf_p++ = (char)c;\par
02476         {\cf19 else}\par
02477             buf_p += ImTextCharToUtf8_inline(buf_p, ({\cf18 int})(buf_end - buf_p - 1), c);\par
02478     \}\par
02479     *buf_p = 0;\par
02480     {\cf19 return} ({\cf18 int})(buf_p - out_buf);\par
02481 \}\par
