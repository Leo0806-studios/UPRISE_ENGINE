00722     {\cf20 // Sizing Policy}\par
00723     {\cf19 if} ((flags & ImGuiTableColumnFlags_WidthMask_) == 0)\par
00724     \{\par
00725         {\cf17 const} ImGuiTableFlags table_sizing_policy = (table->Flags & ImGuiTableFlags_SizingMask_);\par
00726         {\cf19 if} (table_sizing_policy == ImGuiTableFlags_SizingFixedFit || table_sizing_policy == ImGuiTableFlags_SizingFixedSame)\par
00727             flags |= ImGuiTableColumnFlags_WidthFixed;\par
00728         {\cf19 else}\par
00729             flags |= ImGuiTableColumnFlags_WidthStretch;\par
00730     \}\par
00731     {\cf19 else}\par
00732     \{\par
00733         IM_ASSERT(ImIsPowerOfTwo(flags & ImGuiTableColumnFlags_WidthMask_)); {\cf20 // Check that only 1 of each set is used.}\par
00734     \}\par
00735 \par
00736     {\cf20 // Resize}\par
00737     {\cf19 if} ((table->Flags & ImGuiTableFlags_Resizable) == 0)\par
00738         flags |= ImGuiTableColumnFlags_NoResize;\par
00739 \par
00740     {\cf20 // Sorting}\par
00741     {\cf19 if} ((flags & ImGuiTableColumnFlags_NoSortAscending) && (flags & ImGuiTableColumnFlags_NoSortDescending))\par
00742         flags |= ImGuiTableColumnFlags_NoSort;\par
00743 \par
00744     {\cf20 // Indentation}\par
00745     {\cf19 if} ((flags & ImGuiTableColumnFlags_IndentMask_) == 0)\par
00746         flags |= (table->Columns.index_from_ptr(column) == 0) ? ImGuiTableColumnFlags_IndentEnable : ImGuiTableColumnFlags_IndentDisable;\par
00747 \par
00748     {\cf20 // Alignment}\par
00749     {\cf20 //if ((flags & ImGuiTableColumnFlags_AlignMask_) == 0)}\par
00750     {\cf20 //    flags |= ImGuiTableColumnFlags_AlignCenter;}\par
00751     {\cf20 //IM_ASSERT(ImIsPowerOfTwo(flags & ImGuiTableColumnFlags_AlignMask_)); // Check that only 1 of each set is used.}\par
00752 \par
00753     {\cf20 // Preserve status flags}\par
00754     column->Flags = flags | (column->Flags & ImGuiTableColumnFlags_StatusMask_);\par
00755 \par
00756     {\cf20 // Build an ordered list of available sort directions}\par
00757     column->SortDirectionsAvailCount = column->SortDirectionsAvailMask = column->SortDirectionsAvailList = 0;\par
00758     {\cf19 if} (table->Flags & ImGuiTableFlags_Sortable)\par
00759     \{\par
00760         {\cf18 int} count = 0, mask = 0, list = 0;\par
00761         {\cf19 if} ((flags & ImGuiTableColumnFlags_PreferSortAscending)  != 0 && (flags & ImGuiTableColumnFlags_NoSortAscending)  == 0) \{ mask |= 1 << ImGuiSortDirection_Ascending;  list |= ImGuiSortDirection_Ascending  << (count << 1); count++; \}\par
00762         {\cf19 if} ((flags & ImGuiTableColumnFlags_PreferSortDescending) != 0 && (flags & ImGuiTableColumnFlags_NoSortDescending) == 0) \{ mask |= 1 << ImGuiSortDirection_Descending; list |= ImGuiSortDirection_Descending << (count << 1); count++; \}\par
00763         {\cf19 if} ((flags & ImGuiTableColumnFlags_PreferSortAscending)  == 0 && (flags & ImGuiTableColumnFlags_NoSortAscending)  == 0) \{ mask |= 1 << ImGuiSortDirection_Ascending;  list |= ImGuiSortDirection_Ascending  << (count << 1); count++; \}\par
00764         {\cf19 if} ((flags & ImGuiTableColumnFlags_PreferSortDescending) == 0 && (flags & ImGuiTableColumnFlags_NoSortDescending) == 0) \{ mask |= 1 << ImGuiSortDirection_Descending; list |= ImGuiSortDirection_Descending << (count << 1); count++; \}\par
00765         {\cf19 if} ((table->Flags & ImGuiTableFlags_SortTristate) || count == 0) \{ mask |= 1 << ImGuiSortDirection_None; count++; \}\par
00766         column->SortDirectionsAvailList = (ImU8)list;\par
00767         column->SortDirectionsAvailMask = (ImU8)mask;\par
00768         column->SortDirectionsAvailCount = (ImU8)count;\par
00769         ImGui::TableFixColumnSortDirection(table, column);\par
00770     \}\par
