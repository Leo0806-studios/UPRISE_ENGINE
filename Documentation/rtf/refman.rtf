17593 {\cf20 // Default handler for g.DockNodeWindowMenuHandler(): display the list of windows for a given dock-node.}\par
17594 {\cf20 // This is exceptionally stored in a function pointer to also user applications to tweak this menu (undocumented)}\par
17595 {\cf20 // Custom overrides may want to decorate, group, sort entries.}\par
17596 {\cf20 // Please note those are internal structures: if you copy this expect occasional breakage.}\par
17597 {\cf20 // (if you don't need to modify the "Tabs.Size == 1" behavior/path it is recommend you call this function in your handler)}\par
17598 {\cf18 void} ImGui::DockNodeWindowMenuHandler_Default(ImGuiContext* ctx, ImGuiDockNode* node, ImGuiTabBar* tab_bar)\par
17599 \{\par
17600     IM_UNUSED(ctx);\par
17601     {\cf19 if} (tab_bar->Tabs.Size == 1)\par
17602     \{\par
17603         {\cf20 // "Hide tab bar" option. Being one of our rare user-facing string we pull it from a table.}\par
17604         {\cf19 if} (MenuItem(LocalizeGetMsg(ImGuiLocKey_DockingHideTabBar), NULL, node->IsHiddenTabBar()))\par
17605             node->WantHiddenTabBarToggle = {\cf17 true};\par
17606     \}\par
17607     {\cf19 else}\par
17608     \{\par
17609         {\cf20 // Display a selectable list of windows in this docking node}\par
17610         {\cf19 for} ({\cf18 int} tab_n = 0; tab_n < tab_bar->Tabs.Size; tab_n++)\par
17611         \{\par
17612             ImGuiTabItem* tab = &tab_bar->Tabs[tab_n];\par
17613             {\cf19 if} (tab->Flags & ImGuiTabItemFlags_Button)\par
17614                 {\cf19 continue};\par
17615             {\cf19 if} (Selectable(TabBarGetTabName(tab_bar, tab), tab->ID == tab_bar->SelectedTabId))\par
17616                 TabBarQueueFocus(tab_bar, tab);\par
17617             SameLine();\par
17618             Text({\cf22 "   "});\par
17619         \}\par
17620     \}\par
17621 \}\par
