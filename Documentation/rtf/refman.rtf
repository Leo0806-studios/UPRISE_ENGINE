00960     {\cf18 float} width_remaining_for_stretched_columns = width_avail_for_stretched_columns;\par
00961     table->ColumnsGivenWidth = width_spacings + (table->CellPaddingX * 2.0f) * table->ColumnsEnabledCount;\par
00962     {\cf19 for} ({\cf18 int} column_n = 0; column_n < table->ColumnsCount; column_n++)\par
00963     \{\par
00964         {\cf19 if} (!IM_BITARRAY_TESTBIT(table->EnabledMaskByIndex, column_n))\par
00965             {\cf19 continue};\par
00966         ImGuiTableColumn* column = &table->Columns[column_n];\par
00967 \par
00968         {\cf20 // Allocate width for stretched/weighted columns (StretchWeight gets converted into WidthRequest)}\par
