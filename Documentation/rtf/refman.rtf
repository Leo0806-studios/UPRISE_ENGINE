04648 {\cf20 // Handle mouse moving window}\par
04649 {\cf20 // Note: moving window with the navigation keys (Square + d-pad / CTRL+TAB + Arrows) are processed in NavUpdateWindowing()}\par
04650 {\cf20 // FIXME: We don't have strong guarantee that g.MovingWindow stay synched with g.ActiveId == g.MovingWindow->MoveId.}\par
04651 {\cf20 // This is currently enforced by the fact that BeginDragDropSource() is setting all g.ActiveIdUsingXXXX flags to inhibit navigation inputs,}\par
04652 {\cf20 // but if we should more thoroughly test cases where g.ActiveId or g.MovingWindow gets changed and not the other.}\par
04653 {\cf18 void} ImGui::UpdateMouseMovingWindowNewFrame()\par
04654 \{\par
04655     ImGuiContext& g = *GImGui;\par
04656     {\cf19 if} (g.MovingWindow != NULL)\par
04657     \{\par
04658         {\cf20 // We actually want to move the root window. g.MovingWindow == window we clicked on (could be a child window).}\par
04659         {\cf20 // We track it to preserve Focus and so that generally ActiveIdWindow == MovingWindow and ActiveId == MovingWindow->MoveId for consistency.}\par
04660         KeepAliveID(g.ActiveId);\par
04661         IM_ASSERT(g.MovingWindow && g.MovingWindow->RootWindowDockTree);\par
04662         ImGuiWindow* moving_window = g.MovingWindow->RootWindowDockTree;\par
04663 \par
04664         {\cf20 // When a window stop being submitted while being dragged, it may will its viewport until next Begin()}\par
04665         {\cf17 const} {\cf18 bool} window_disappared = (!moving_window->WasActive && !moving_window->Active);\par
04666         {\cf19 if} (g.IO.MouseDown[0] && IsMousePosValid(&g.IO.MousePos) && !window_disappared)\par
04667         \{\par
04668             ImVec2 pos = g.IO.MousePos - g.ActiveIdClickOffset;\par
04669             {\cf19 if} (moving_window->Pos.x != pos.x || moving_window->Pos.y != pos.y)\par
04670             \{\par
04671                 SetWindowPos(moving_window, pos, ImGuiCond_Always);\par
04672                 {\cf19 if} (moving_window->Viewport && moving_window->ViewportOwned) {\cf20 // Synchronize viewport immediately because some overlays may relies on clipping rectangle before we Begin() into the window.}\par
04673                 \{\par
04674                     moving_window->Viewport->Pos = pos;\par
04675                     moving_window->Viewport->UpdateWorkRect();\par
04676                 \}\par
04677             \}\par
04678             FocusWindow(g.MovingWindow);\par
04679         \}\par
04680         {\cf19 else}\par
04681         \{\par
04682             {\cf19 if} (!window_disappared)\par
04683             \{\par
04684                 {\cf20 // Try to merge the window back into the main viewport.}\par
04685                 {\cf20 // This works because MouseViewport should be != MovingWindow->Viewport on release (as per code in UpdateViewports)}\par
04686                 {\cf19 if} (g.ConfigFlagsCurrFrame & ImGuiConfigFlags_ViewportsEnable)\par
04687                     UpdateTryMergeWindowIntoHostViewport(moving_window, g.MouseViewport);\par
04688 \par
04689                 {\cf20 // Restore the mouse viewport so that we don't hover the viewport _under_ the moved window during the frame we released the mouse button.}\par
04690                 {\cf19 if} (moving_window->Viewport && !IsDragDropPayloadBeingAccepted())\par
04691                     g.MouseViewport = moving_window->Viewport;\par
04692 \par
04693                 {\cf20 // Clear the NoInput window flag set by the Viewport system}\par
04694                 {\cf19 if} (moving_window->Viewport)\par
04695                     moving_window->Viewport->Flags &= ~ImGuiViewportFlags_NoInputs;\par
04696             \}\par
04697 \par
04698             g.MovingWindow = NULL;\par
04699             ClearActiveID();\par
04700         \}\par
04701     \}\par
04702     {\cf19 else}\par
04703     \{\par
04704         {\cf20 // When clicking/dragging from a window that has the _NoMove flag, we still set the ActiveId in order to prevent hovering others.}\par
04705         {\cf19 if} (g.ActiveIdWindow && g.ActiveIdWindow->MoveId == g.ActiveId)\par
04706         \{\par
04707             KeepAliveID(g.ActiveId);\par
04708             {\cf19 if} (!g.IO.MouseDown[0])\par
04709                 ClearActiveID();\par
04710         \}\par
04711     \}\par
04712 \}\par
