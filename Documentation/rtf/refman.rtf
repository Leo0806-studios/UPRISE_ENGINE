14625     {\cf18 size_t} file_data_size = 0;\par
14626     {\cf18 char}* file_data = ({\cf18 char}*)ImFileLoadToMemory(ini_filename, {\cf22 "rb"}, &file_data_size);\par
14627     {\cf19 if} (!file_data)\par
14628         {\cf19 return};\par
14629     {\cf19 if} (file_data_size > 0)\par
14630         LoadIniSettingsFromMemory(file_data, ({\cf18 size_t})file_data_size);\par
