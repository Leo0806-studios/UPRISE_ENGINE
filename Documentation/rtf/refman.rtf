09894     {\cf20 // Synchronize io.KeyMods and io.KeyCtrl/io.KeyShift/etc. values.}\par
09895     {\cf20 // - New backends (1.87+): send io.AddKeyEvent(ImGuiMod_XXX) ->                                      -> (here) deriving io.KeyMods + io.KeyXXX from key array.}\par
09896     {\cf20 // - Legacy backends:      set io.KeyXXX bools               -> (above) set key array from io.KeyXXX -> (here) deriving io.KeyMods + io.KeyXXX from key array.}\par
09897     {\cf20 // So with legacy backends the 4 values will do a unnecessary back-and-forth but it makes the code simpler and future facing.}\par
09898     {\cf17 const} ImGuiKeyChord prev_key_mods = io.KeyMods;\par
09899     io.KeyMods = GetMergedModsFromKeys();\par
09900     io.KeyCtrl = (io.KeyMods & ImGuiMod_Ctrl) != 0;\par
09901     io.KeyShift = (io.KeyMods & ImGuiMod_Shift) != 0;\par
