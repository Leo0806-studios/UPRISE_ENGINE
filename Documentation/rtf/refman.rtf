14080 {\cf18 void} ImGui::EndDragDropSource()\par
14081 \{\par
14082     ImGuiContext& g = *GImGui;\par
14083     IM_ASSERT(g.DragDropActive);\par
14084     IM_ASSERT(g.DragDropWithinSource && {\cf22 "Not after a BeginDragDropSource()?"});\par
14085 \par
14086     {\cf19 if} (!(g.DragDropSourceFlags & ImGuiDragDropFlags_SourceNoPreviewTooltip))\par
14087         EndTooltip();\par
14088 \par
14089     {\cf20 // Discard the drag if have not called SetDragDropPayload()}\par
14090     {\cf19 if} (g.DragDropPayload.DataFrameCount == -1)\par
14091         ClearDragDrop();\par
14092     g.DragDropWithinSource = {\cf17 false};\par
14093 \}\par
