00627                 GL_CALL(glDrawElements(GL_TRIANGLES, (GLsizei)pcmd->ElemCount, {\cf17 sizeof}(ImDrawIdx) == 2 ? GL_UNSIGNED_SHORT : GL_UNSIGNED_INT, ({\cf18 void}*)(intptr_t)(pcmd->IdxOffset * {\cf17 sizeof}(ImDrawIdx))));\par
00628             \}\par
00629         \}\par
00630     \}\par
00631 \par
00632     {\cf20 // Destroy the temporary VAO}\par
00633 {\cf21 #ifdef IMGUI_IMPL_OPENGL_USE_VERTEX_ARRAY}\par
