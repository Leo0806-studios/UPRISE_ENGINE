12106 {\cf20 // This is a helper to handle the simplest case of associating one named popup to one given widget.}\par
12107 {\cf20 // - To create a popup associated to the last item, you generally want to pass a NULL value to str_id.}\par
12108 {\cf20 // - To create a popup with a specific identifier, pass it in str_id.}\par
12109 {\cf20 //    - This is useful when using using BeginPopupContextItem() on an item which doesn't have an identifier, e.g. a Text() call.}\par
12110 {\cf20 //    - This is useful when multiple code locations may want to manipulate/open the same popup, given an explicit id.}\par
12111 {\cf20 // - You may want to handle the whole on user side if you have specific needs (e.g. tweaking IsItemHovered() parameters).}\par
12112 {\cf20 //   This is essentially the same as:}\par
12113 {\cf20 //       id = str_id ? GetID(str_id) : GetItemID();}\par
12114 {\cf20 //       OpenPopupOnItemClick(str_id, ImGuiPopupFlags_MouseButtonRight);}\par
12115 {\cf20 //       return BeginPopup(id);}\par
12116 {\cf20 //   Which is essentially the same as:}\par
12117 {\cf20 //       id = str_id ? GetID(str_id) : GetItemID();}\par
12118 {\cf20 //       if (IsItemHovered() && IsMouseReleased(ImGuiMouseButton_Right))}\par
12119 {\cf20 //           OpenPopup(id);}\par
12120 {\cf20 //       return BeginPopup(id);}\par
12121 {\cf20 //   The main difference being that this is tweaked to avoid computing the ID twice.}\par
12122 {\cf18 bool} ImGui::BeginPopupContextItem({\cf17 const} {\cf18 char}* str_id, ImGuiPopupFlags popup_flags)\par
12123 \{\par
12124     ImGuiContext& g = *GImGui;\par
12125     ImGuiWindow* window = g.CurrentWindow;\par
12126     {\cf19 if} (window->SkipItems)\par
12127         {\cf19 return} {\cf17 false};\par
12128     ImGuiID {\cf18 id} = str_id ? window->GetID(str_id) : g.LastItemData.ID;    {\cf20 // If user hasn't passed an ID, we can use the LastItemID. Using LastItemID as a Popup ID won't conflict!}\par
12129     IM_ASSERT({\cf18 id} != 0);                                             {\cf20 // You cannot pass a NULL str_id if the last item has no identifier (e.g. a Text() item)}\par
12130     {\cf18 int} mouse_button = (popup_flags & ImGuiPopupFlags_MouseButtonMask_);\par
