17493         {\cf19 if} (hole_rect.Min.y > root_rect.Min.y) \{ hole_rect.Min.y += WINDOWS_HOVER_PADDING; \}\par
17494         {\cf19 if} (hole_rect.Max.y < root_rect.Max.y) \{ hole_rect.Max.y -= WINDOWS_HOVER_PADDING; \}\par
17495         {\cf20 //GetForegroundDrawList()->AddRect(hole_rect.Min, hole_rect.Max, IM_COL32(255, 0, 0, 255));}\par
17496         {\cf19 if} (central_node_hole && !hole_rect.IsInverted())\par
17497         \{\par
17498             SetWindowHitTestHole(host_window, hole_rect.Min, hole_rect.Max - hole_rect.Min);\par
17499             {\cf19 if} (host_window->ParentWindow)\par
17500                 SetWindowHitTestHole(host_window->ParentWindow, hole_rect.Min, hole_rect.Max - hole_rect.Min);\par
17501         \}\par
17502     \}\par
17503 \par
17504     {\cf20 // Update position/size, process and draw resizing splitters}\par
17505     {\cf19 if} (node->IsRootNode() && host_window)\par
17506     \{\par
17507         DockNodeTreeUpdatePosSize(node, host_window->Pos, host_window->Size);\par
17508         PushStyleColor(ImGuiCol_Separator, g.Style.Colors[ImGuiCol_Border]);\par
17509         PushStyleColor(ImGuiCol_SeparatorActive, g.Style.Colors[ImGuiCol_ResizeGripActive]);\par
17510         PushStyleColor(ImGuiCol_SeparatorHovered, g.Style.Colors[ImGuiCol_ResizeGripHovered]);\par
17511         DockNodeTreeUpdateSplitter(node);\par
17512         PopStyleColor(3);\par
17513     \}\par
17514 \par
17515     {\cf20 // Draw empty node background (currently can only be the Central Node)}\par
17516     {\cf19 if} (host_window && node->IsEmpty() && node->IsVisible)\par
17517     \{\par
17518         host_window->DrawList->ChannelsSetCurrent(DOCKING_HOST_DRAW_CHANNEL_BG);\par
17519         node->LastBgColor = (node_flags & ImGuiDockNodeFlags_PassthruCentralNode) ? 0 : GetColorU32(ImGuiCol_DockingEmptyBg);\par
17520         {\cf19 if} (node->LastBgColor != 0)\par
17521             host_window->DrawList->AddRectFilled(node->Pos, node->Pos + node->Size, node->LastBgColor);\par
17522         node->IsBgDrawnThisFrame = {\cf17 true};\par
17523     \}\par
17524 \par
17525     {\cf20 // Draw whole dockspace background if ImGuiDockNodeFlags_PassthruCentralNode if set.}\par
17526     {\cf20 // We need to draw a background at the root level if requested by ImGuiDockNodeFlags_PassthruCentralNode, but we will only know the correct pos/size}\par
17527     {\cf20 // _after_ processing the resizing splitters. So we are using the DrawList channel splitting facility to submit drawing primitives out of order!}\par
17528     {\cf17 const} {\cf18 bool} render_dockspace_bg = node->IsRootNode() && host_window && (node_flags & ImGuiDockNodeFlags_PassthruCentralNode) != 0;\par
17529     {\cf19 if} (render_dockspace_bg && node->IsVisible)\par
17530     \{\par
17531         host_window->DrawList->ChannelsSetCurrent(DOCKING_HOST_DRAW_CHANNEL_BG);\par
17532         {\cf19 if} (central_node_hole)\par
17533             RenderRectFilledWithHole(host_window->DrawList, node->Rect(), central_node->Rect(), GetColorU32(ImGuiCol_WindowBg), 0.0f);\par
17534         {\cf19 else}\par
17535             host_window->DrawList->AddRectFilled(node->Pos, node->Pos + node->Size, GetColorU32(ImGuiCol_WindowBg), 0.0f);\par
17536     \}\par
17537 \par
17538     {\cf20 // Draw and populate Tab Bar}\par
17539     {\cf19 if} (host_window)\par
17540         host_window->DrawList->ChannelsSetCurrent(DOCKING_HOST_DRAW_CHANNEL_FG);\par
17541     {\cf19 if} (host_window && node->Windows.Size > 0)\par
17542     \{\par
17543         DockNodeUpdateTabBar(node, host_window);\par
17544     \}\par
17545     {\cf19 else}\par
17546     \{\par
17547         node->WantCloseAll = {\cf17 false};\par
17548         node->WantCloseTabId = 0;\par
17549         node->IsFocused = {\cf17 false};\par
17550     \}\par
17551     {\cf19 if} (node->TabBar && node->TabBar->SelectedTabId)\par
17552         node->SelectedTabId = node->TabBar->SelectedTabId;\par
17553     {\cf19 else} {\cf19 if} (node->Windows.Size > 0)\par
17554         node->SelectedTabId = node->Windows[0]->TabId;\par
17555 \par
17556     {\cf20 // Draw payload drop target}\par
17557     {\cf19 if} (host_window && node->IsVisible)\par
17558         {\cf19 if} (node->IsRootNode() && (g.MovingWindow == NULL || g.MovingWindow->RootWindowDockTree != host_window))\par
17559             BeginDockableDragDropTarget(host_window);\par
17560 \par
17561     {\cf20 // We update this after DockNodeUpdateTabBar()}\par
17562     node->LastFrameActive = g.FrameCount;\par
17563 \par
17564     {\cf20 // Recurse into children}\par
17565     {\cf20 // FIXME-DOCK FIXME-OPT: Should not need to recurse into children}\par
17566     {\cf19 if} (host_window)\par
17567     \{\par
17568         {\cf19 if} (node->ChildNodes[0])\par
17569             DockNodeUpdate(node->ChildNodes[0]);\par
17570         {\cf19 if} (node->ChildNodes[1])\par
17571             DockNodeUpdate(node->ChildNodes[1]);\par
17572 \par
17573         {\cf20 // Render outer borders last (after the tab bar)}\par
17574         {\cf19 if} (node->IsRootNode())\par
17575             RenderWindowOuterBorders(host_window);\par
17576     \}\par
17577 \par
17578     {\cf20 // End host window}\par
17579     {\cf19 if} (beginned_into_host_window) {\cf20 //-V1020}\par
17580         End();\par
17581 \}\par
