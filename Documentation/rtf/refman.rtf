17664 \{\par
17665     {\cf20 // CTRL+Tab highlight (only highlighting leaf node, not whole hierarchy)}\par
17666     ImGuiContext& g = *GImGui;\par
17667     {\cf19 if} (g.NavWindowingTarget)\par
17668         {\cf19 return} (g.NavWindowingTarget->DockNode == node);\par
17669 \par
