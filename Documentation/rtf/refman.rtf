02889 {\cf18 void} ImGuiTextBuffer::appendfv({\cf17 const} {\cf18 char}* fmt, va_list args)\par
02890 \{\par
02891     va_list args_copy;\par
02892     va_copy(args_copy, args);\par
02893 \par
02894     {\cf18 int} len = ImFormatStringV(NULL, 0, fmt, args);         {\cf20 // FIXME-OPT: could do a first pass write attempt, likely successful on first pass.}\par
02895     {\cf19 if} (len <= 0)\par
02896     \{\par
02897         va_end(args_copy);\par
02898         {\cf19 return};\par
02899     \}\par
02900 \par
02901     {\cf20 // Add zero-terminator the first time}\par
02902     {\cf17 const} {\cf18 int} write_off = (Buf.Size != 0) ? Buf.Size : 1;\par
02903     {\cf17 const} {\cf18 int} needed_sz = write_off + len;\par
02904     {\cf19 if} (write_off + len >= Buf.Capacity)\par
02905     \{\par
