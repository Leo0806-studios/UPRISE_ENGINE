00432 \par
00433     {\cf19 if} (keycode >= 0 && keycode < IM_ARRAYSIZE(bd->KeyOwnerWindows))\par
00434         bd->KeyOwnerWindows[keycode] = (action == GLFW_PRESS) ? window : {\cf17 nullptr};\par
