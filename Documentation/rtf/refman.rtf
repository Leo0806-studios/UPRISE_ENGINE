15428         g.DrawListSharedData.ClipRectFullscreen.y = ImMin(g.DrawListSharedData.ClipRectFullscreen.y, viewport->Pos.y);\par
15429         g.DrawListSharedData.ClipRectFullscreen.z = ImMax(g.DrawListSharedData.ClipRectFullscreen.z, viewport->Pos.x + viewport->Size.x);\par
15430         g.DrawListSharedData.ClipRectFullscreen.w = ImMax(g.DrawListSharedData.ClipRectFullscreen.w, viewport->Pos.y + viewport->Size.y);\par
15431 \par
15432         {\cf20 // Store initial DpiScale before the OS platform window creation, based on expected monitor data.}\par
15433         {\cf20 // This is so we can select an appropriate font size on the first frame of our window lifetime}\par
15434         {\cf19 if} (viewport->PlatformMonitor != -1)\par
15435             viewport->DpiScale = g.PlatformIO.Monitors[viewport->PlatformMonitor].DpiScale;\par
15436     \}\par
15437 \par
15438     viewport->Window = window;\par
15439     viewport->LastFrameActive = g.FrameCount;\par
15440     viewport->UpdateWorkRect();\par
15441     IM_ASSERT(window == NULL || viewport->ID == window->ID);\par
15442 \par
15443     {\cf19 if} (window != NULL)\par
15444         window->ViewportOwned = {\cf17 true};\par
15445 \par
15446     {\cf19 return} viewport;\par
15447 \}\par
