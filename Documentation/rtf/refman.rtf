17628         SetNextWindowPos(ImVec2(node->Pos.x, node->Pos.y + GetFrameHeight()), ImGuiCond_Always, ImVec2(0.0f, 0.0f));\par
17629     {\cf19 else}\par
17630         SetNextWindowPos(ImVec2(node->Pos.x + node->Size.x, node->Pos.y + GetFrameHeight()), ImGuiCond_Always, ImVec2(1.0f, 0.0f));\par
17631     {\cf19 if} (BeginPopup({\cf22 "#WindowMenu"}))\par
17632     \{\par
17633         node->IsFocused = {\cf17 true};\par
17634         g.DockNodeWindowMenuHandler(&g, node, tab_bar);\par
17635         EndPopup();\par
17636     \}\par
