04020 {\cf20 // Note: as with every ImDrawList drawing function, this expects that the font atlas texture is bound.}\par
04021 {\cf18 void} ImFont::RenderText(ImDrawList* draw_list, {\cf18 float} size, {\cf17 const} ImVec2& pos, ImU32 col, {\cf17 const} ImVec4& clip_rect, {\cf17 const} {\cf18 char}* text_begin, {\cf17 const} {\cf18 char}* text_end, {\cf18 float} wrap_width, {\cf18 bool} cpu_fine_clip){\cf17  const}\par
04022 {\cf17 }\{\par
04023     {\cf19 if} (!text_end)\par
04024         text_end = text_begin + strlen(text_begin); {\cf20 // ImGui:: functions generally already provides a valid text_end, so this is merely to handle direct calls.}\par
04025 \par
04026     {\cf20 // Align to be pixel perfect}\par
04027     {\cf18 float} x = IM_TRUNC(pos.x);\par
04028     {\cf18 float} y = IM_TRUNC(pos.y);\par
04029     {\cf19 if} (y > clip_rect.w)\par
04030         {\cf19 return};\par
04031 \par
04032     {\cf17 const} {\cf18 float} start_x = x;\par
04033     {\cf17 const} {\cf18 float} scale = size / FontSize;\par
04034     {\cf17 const} {\cf18 float} line_height = FontSize * scale;\par
04035     {\cf17 const} {\cf18 bool} word_wrap_enabled = (wrap_width > 0.0f);\par
04036 \par
04037     {\cf20 // Fast-forward to first visible line}\par
04038     {\cf17 const} {\cf18 char}* s = text_begin;\par
04039     {\cf19 if} (y + line_height < clip_rect.y)\par
04040         {\cf19 while} (y + line_height < clip_rect.y && s < text_end)\par
04041         \{\par
04042             {\cf17 const} {\cf18 char}* line_end = ({\cf17 const} {\cf18 char}*)memchr(s, {\cf23 '\\n'}, text_end - s);\par
04043             {\cf19 if} (word_wrap_enabled)\par
04044             \{\par
04045                 {\cf20 // FIXME-OPT: This is not optimal as do first do a search for \\n before calling CalcWordWrapPositionA().}\par
04046                 {\cf20 // If the specs for CalcWordWrapPositionA() were reworked to optionally return on \\n we could combine both.}\par
04047                 {\cf20 // However it is still better than nothing performing the fast-forward!}\par
04048                 s = CalcWordWrapPositionA(scale, s, line_end ? line_end : text_end, wrap_width);\par
04049                 s = CalcWordWrapNextLineStartA(s, text_end);\par
04050             \}\par
04051             {\cf19 else}\par
04052             \{\par
04053                 s = line_end ? line_end + 1 : text_end;\par
04054             \}\par
04055             y += line_height;\par
04056         \}\par
04057 \par
04058     {\cf20 // For large text, scan for the last visible line in order to avoid over-reserving in the call to PrimReserve()}\par
04059     {\cf20 // Note that very large horizontal line will still be affected by the issue (e.g. a one megabyte string buffer without a newline will likely crash atm)}\par
04060     {\cf19 if} (text_end - s > 10000 && !word_wrap_enabled)\par
04061     \{\par
04062         {\cf17 const} {\cf18 char}* s_end = s;\par
04063         {\cf18 float} y_end = y;\par
04064         {\cf19 while} (y_end < clip_rect.w && s_end < text_end)\par
04065         \{\par
04066             s_end = ({\cf17 const} {\cf18 char}*)memchr(s_end, {\cf23 '\\n'}, text_end - s_end);\par
04067             s_end = s_end ? s_end + 1 : text_end;\par
04068             y_end += line_height;\par
04069         \}\par
04070         text_end = s_end;\par
04071     \}\par
04072     {\cf19 if} (s == text_end)\par
04073         {\cf19 return};\par
04074 \par
04075     {\cf20 // Reserve vertices for remaining worse case (over-reserving is useful and easily amortized)}\par
04076     {\cf17 const} {\cf18 int} vtx_count_max = (int)(text_end - s) * 4;\par
04077     {\cf17 const} {\cf18 int} idx_count_max = (int)(text_end - s) * 6;\par
04078     {\cf17 const} {\cf18 int} idx_expected_size = draw_list->IdxBuffer.Size + idx_count_max;\par
04079     draw_list->PrimReserve(idx_count_max, vtx_count_max);\par
04080     ImDrawVert*  vtx_write = draw_list->_VtxWritePtr;\par
04081     ImDrawIdx*   idx_write = draw_list->_IdxWritePtr;\par
04082     {\cf18 unsigned} {\cf18 int} vtx_index = draw_list->_VtxCurrentIdx;\par
04083 \par
04084     {\cf17 const} ImU32 col_untinted = col | ~IM_COL32_A_MASK;\par
04085     {\cf17 const} {\cf18 char}* word_wrap_eol = NULL;\par
04086 \par
04087     {\cf19 while} (s < text_end)\par
04088     \{\par
04089         {\cf19 if} (word_wrap_enabled)\par
04090         \{\par
04091             {\cf20 // Calculate how far we can render. Requires two passes on the string data but keeps the code simple and not intrusive for what's essentially an uncommon feature.}\par
04092             {\cf19 if} (!word_wrap_eol)\par
04093                 word_wrap_eol = CalcWordWrapPositionA(scale, s, text_end, wrap_width - (x - start_x));\par
04094 \par
04095             {\cf19 if} (s >= word_wrap_eol)\par
04096             \{\par
04097                 x = start_x;\par
04098                 y += line_height;\par
04099                 {\cf19 if} (y > clip_rect.w)\par
04100                     {\cf19 break}; {\cf20 // break out of main loop}\par
04101                 word_wrap_eol = NULL;\par
04102                 s = CalcWordWrapNextLineStartA(s, text_end); {\cf20 // Wrapping skips upcoming blanks}\par
04103                 {\cf19 continue};\par
04104             \}\par
04105         \}\par
04106 \par
04107         {\cf20 // Decode and advance source}\par
04108         {\cf18 unsigned} {\cf18 int} c = ({\cf18 unsigned} int)*s;\par
04109         {\cf19 if} (c < 0x80)\par
04110             s += 1;\par
04111         {\cf19 else}\par
04112             s += ImTextCharFromUtf8(&c, s, text_end);\par
04113 \par
04114         {\cf19 if} (c < 32)\par
04115         \{\par
04116             {\cf19 if} (c == {\cf23 '\\n'})\par
04117             \{\par
04118                 x = start_x;\par
04119                 y += line_height;\par
04120                 {\cf19 if} (y > clip_rect.w)\par
04121                     {\cf19 break}; {\cf20 // break out of main loop}\par
04122                 {\cf19 continue};\par
04123             \}\par
04124             {\cf19 if} (c == {\cf23 '\\r'})\par
04125                 {\cf19 continue};\par
04126         \}\par
04127 \par
04128         {\cf17 const} ImFontGlyph* glyph = FindGlyph((ImWchar)c);\par
04129         {\cf19 if} (glyph == NULL)\par
04130             {\cf19 continue};\par
04131 \par
04132         {\cf18 float} char_width = glyph->AdvanceX * scale;\par
04133         {\cf19 if} (glyph->Visible)\par
04134         \{\par
04135             {\cf20 // We don't do a second finer clipping test on the Y axis as we've already skipped anything before clip_rect.y and exit once we pass clip_rect.w}\par
04136             {\cf18 float} x1 = x + glyph->X0 * scale;\par
04137             {\cf18 float} x2 = x + glyph->X1 * scale;\par
04138             {\cf18 float} y1 = y + glyph->Y0 * scale;\par
04139             {\cf18 float} y2 = y + glyph->Y1 * scale;\par
04140             {\cf19 if} (x1 <= clip_rect.z && x2 >= clip_rect.x)\par
04141             \{\par
04142                 {\cf20 // Render a character}\par
04143                 {\cf18 float} u1 = glyph->U0;\par
04144                 {\cf18 float} v1 = glyph->V0;\par
04145                 {\cf18 float} u2 = glyph->U1;\par
04146                 {\cf18 float} v2 = glyph->V1;\par
04147 \par
04148                 {\cf20 // CPU side clipping used to fit text in their frame when the frame is too small. Only does clipping for axis aligned quads.}\par
04149                 {\cf19 if} (cpu_fine_clip)\par
04150                 \{\par
04151                     {\cf19 if} (x1 < clip_rect.x)\par
04152                     \{\par
04153                         u1 = u1 + (1.0f - (x2 - clip_rect.x) / (x2 - x1)) * (u2 - u1);\par
04154                         x1 = clip_rect.x;\par
04155                     \}\par
04156                     {\cf19 if} (y1 < clip_rect.y)\par
04157                     \{\par
04158                         v1 = v1 + (1.0f - (y2 - clip_rect.y) / (y2 - y1)) * (v2 - v1);\par
04159                         y1 = clip_rect.y;\par
04160                     \}\par
04161                     {\cf19 if} (x2 > clip_rect.z)\par
04162                     \{\par
04163                         u2 = u1 + ((clip_rect.z - x1) / (x2 - x1)) * (u2 - u1);\par
04164                         x2 = clip_rect.z;\par
04165                     \}\par
04166                     {\cf19 if} (y2 > clip_rect.w)\par
04167                     \{\par
04168                         v2 = v1 + ((clip_rect.w - y1) / (y2 - y1)) * (v2 - v1);\par
04169                         y2 = clip_rect.w;\par
04170                     \}\par
04171                     {\cf19 if} (y1 >= y2)\par
04172                     \{\par
04173                         x += char_width;\par
04174                         {\cf19 continue};\par
04175                     \}\par
04176                 \}\par
04177 \par
04178                 {\cf20 // Support for untinted glyphs}\par
04179                 ImU32 glyph_col = glyph->Colored ? col_untinted : col;\par
04180 \par
04181                 {\cf20 // We are NOT calling PrimRectUV() here because non-inlined causes too much overhead in a debug builds. Inlined here:}\par
04182                 \{\par
04183                     vtx_write[0].pos.x = x1; vtx_write[0].pos.y = y1; vtx_write[0].col = glyph_col; vtx_write[0].uv.x = u1; vtx_write[0].uv.y = v1;\par
04184                     vtx_write[1].pos.x = x2; vtx_write[1].pos.y = y1; vtx_write[1].col = glyph_col; vtx_write[1].uv.x = u2; vtx_write[1].uv.y = v1;\par
04185                     vtx_write[2].pos.x = x2; vtx_write[2].pos.y = y2; vtx_write[2].col = glyph_col; vtx_write[2].uv.x = u2; vtx_write[2].uv.y = v2;\par
04186                     vtx_write[3].pos.x = x1; vtx_write[3].pos.y = y2; vtx_write[3].col = glyph_col; vtx_write[3].uv.x = u1; vtx_write[3].uv.y = v2;\par
04187                     idx_write[0] = (ImDrawIdx)(vtx_index); idx_write[1] = (ImDrawIdx)(vtx_index + 1); idx_write[2] = (ImDrawIdx)(vtx_index + 2);\par
04188                     idx_write[3] = (ImDrawIdx)(vtx_index); idx_write[4] = (ImDrawIdx)(vtx_index + 2); idx_write[5] = (ImDrawIdx)(vtx_index + 3);\par
04189                     vtx_write += 4;\par
04190                     vtx_index += 4;\par
04191                     idx_write += 6;\par
04192                 \}\par
04193             \}\par
04194         \}\par
04195         x += char_width;\par
04196     \}\par
04197 \par
04198     {\cf20 // Give back unused vertices (clipped ones, blanks) ~ this is essentially a PrimUnreserve() action.}\par
04199     draw_list->VtxBuffer.Size = (int)(vtx_write - draw_list->VtxBuffer.Data); {\cf20 // Same as calling shrink()}\par
04200     draw_list->IdxBuffer.Size = (int)(idx_write - draw_list->IdxBuffer.Data);\par
04201     draw_list->CmdBuffer[draw_list->CmdBuffer.Size - 1].ElemCount -= (idx_expected_size - draw_list->IdxBuffer.Size);\par
04202     draw_list->_VtxWritePtr = vtx_write;\par
04203     draw_list->_IdxWritePtr = idx_write;\par
04204     draw_list->_VtxCurrentIdx = vtx_index;\par
04205 \}\par
