06846     ImRect clip_r(layout_r.Min.x, layout_r.Min.y, ImMin(layout_r.Max.x + g.Style.ItemInnerSpacing.x, title_bar_rect.Max.x), layout_r.Max.y);\par
06847     {\cf19 if} (flags & ImGuiWindowFlags_UnsavedDocument)\par
06848     \{\par
06849         ImVec2 marker_pos;\par
06850         marker_pos.x = ImClamp(layout_r.Min.x + (layout_r.GetWidth() - text_size.x) * style.WindowTitleAlign.x + text_size.x, layout_r.Min.x, layout_r.Max.x);\par
06851         marker_pos.y = (layout_r.Min.y + layout_r.Max.y) * 0.5f;\par
06852         {\cf19 if} (marker_pos.x > layout_r.Min.x)\par
06853         \{\par
