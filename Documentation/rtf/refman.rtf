01601     IM_ASSERT(ImGui::IsNamedKeyOrMod(key)); {\cf20 // Backend needs to pass a valid ImGuiKey_ constant. 0..511 values are legacy native key codes which are not accepted by this API.}\par
01602     IM_ASSERT(ImGui::IsAliasKey(key) == {\cf17 false}); {\cf20 // Backend cannot submit ImGuiKey_MouseXXX values they are automatically inferred from AddMouseXXX() events.}\par
