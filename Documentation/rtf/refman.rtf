01831 {\cf20 // [Public] Starts into the first cell of a new row}\par
01832 {\cf18 void} ImGui::TableNextRow(ImGuiTableRowFlags row_flags, {\cf18 float} row_min_height)\par
01833 \{\par
01834     ImGuiContext& g = *GImGui;\par
01835     ImGuiTable* table = g.CurrentTable;\par
01836 \par
01837     {\cf19 if} (!table->IsLayoutLocked)\par
01838         TableUpdateLayout(table);\par
01839     {\cf19 if} (table->IsInsideRow)\par
01840         TableEndRow(table);\par
01841 \par
01842     table->LastRowFlags = table->RowFlags;\par
01843     table->RowFlags = row_flags;\par
01844     table->RowCellPaddingY = g.Style.CellPadding.y;\par
01845     table->RowMinHeight = row_min_height;\par
01846     TableBeginRow(table);\par
01847 \par
01848     {\cf20 // We honor min_row_height requested by user, but cannot guarantee per-row maximum height,}\par
01849     {\cf20 // because that would essentially require a unique clipping rectangle per-cell.}\par
01850     table->RowPosY2 += table->RowCellPaddingY * 2.0f;\par
01851     table->RowPosY2 = ImMax(table->RowPosY2, table->RowPosY1 + row_min_height);\par
01852 \par
01853     {\cf20 // Disable output until user calls TableNextColumn()}\par
01854     table->InnerWindow->SkipItems = {\cf17 true};\par
01855 \}\par
