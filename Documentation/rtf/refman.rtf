14632 \}\par
14633 \par
14634 {\cf20 // Zero-tolerance, no error reporting, cheap .ini parsing}\par
14635 {\cf20 // Set ini_size==0 to let us use strlen(ini_data). Do not call this function with a 0 if your buffer is actually empty!}\par
14636 {\cf18 void} ImGui::LoadIniSettingsFromMemory({\cf17 const} {\cf18 char}* ini_data, {\cf18 size_t} ini_size)\par
14637 \{\par
14638     ImGuiContext& g = *GImGui;\par
14639     IM_ASSERT(g.Initialized);\par
14640     {\cf20 //IM_ASSERT(!g.WithinFrameScope && "Cannot be called between NewFrame() and EndFrame()");}\par
14641     {\cf20 //IM_ASSERT(g.SettingsLoaded == false && g.FrameCount == 0);}\par
14642 \par
14643     {\cf20 // For user convenience, we allow passing a non zero-terminated string (hence the ini_size parameter).}\par
14644     {\cf20 // For our convenience and to make the code simpler, we'll also write zero-terminators within the buffer. So let's create a writable copy..}\par
14645     {\cf19 if} (ini_size == 0)\par
14646         ini_size = strlen(ini_data);\par
14647     g.SettingsIniData.Buf.resize(({\cf18 int})ini_size + 1);\par
14648     {\cf18 char}* {\cf17 const} buf = g.SettingsIniData.Buf.Data;\par
14649     {\cf18 char}* {\cf17 const} buf_end = buf + ini_size;\par
14650     memcpy(buf, ini_data, ini_size);\par
14651     buf_end[0] = 0;\par
14652 \par
14653     {\cf20 // Call pre-read handlers}\par
14654     {\cf20 // Some types will clear their data (e.g. dock information) some types will allow merge/override (window)}\par
14655     {\cf19 for} (ImGuiSettingsHandler& handler : g.SettingsHandlers)\par
14656         if (handler.ReadInitFn != NULL)\par
14657             handler.ReadInitFn(&g, &handler);\par
14658 \par
14659     {\cf18 void}* entry_data = NULL;\par
14660     ImGuiSettingsHandler* entry_handler = NULL;\par
14661 \par
14662     {\cf18 char}* line_end = NULL;\par
14663     {\cf19 for} ({\cf18 char}* line = buf; line < buf_end; line = line_end + 1)\par
14664     \{\par
14665         {\cf20 // Skip new lines markers, then find end of the line}\par
14666         {\cf19 while} (*line == {\cf23 '\\n'} || *line == {\cf23 '\\r'})\par
14667             line++;\par
14668         line_end = line;\par
14669         {\cf19 while} (line_end < buf_end && *line_end != {\cf23 '\\n'} && *line_end != {\cf23 '\\r'})\par
14670             line_end++;\par
14671         line_end[0] = 0;\par
14672         {\cf19 if} (line[0] == {\cf23 ';'})\par
14673             {\cf19 continue};\par
14674         {\cf19 if} (line[0] == {\cf23 '['} && line_end > line && line_end[-1] == {\cf23 ']'})\par
14675         \{\par
14676             {\cf20 // Parse "[Type][Name]". Note that 'Name' can itself contains [] characters, which is acceptable with the current format and parsing code.}\par
14677             line_end[-1] = 0;\par
14678             {\cf17 const} {\cf18 char}* name_end = line_end - 1;\par
14679             {\cf17 const} {\cf18 char}* type_start = line + 1;\par
14680             {\cf18 char}* type_end = ({\cf18 char}*)({\cf18 void}*)ImStrchrRange(type_start, name_end, {\cf23 ']'});\par
14681             {\cf17 const} {\cf18 char}* name_start = type_end ? ImStrchrRange(type_end + 1, name_end, {\cf23 '['}) : NULL;\par
14682             {\cf19 if} (!type_end || !name_start)\par
14683                 {\cf19 continue};\par
14684             *type_end = 0; {\cf20 // Overwrite first ']'}\par
14685             name_start++;  {\cf20 // Skip second '['}\par
14686             entry_handler = FindSettingsHandler(type_start);\par
14687             entry_data = entry_handler ? entry_handler->ReadOpenFn(&g, entry_handler, name_start) : NULL;\par
14688         \}\par
14689         {\cf19 else} {\cf19 if} (entry_handler != NULL && entry_data != NULL)\par
14690         \{\par
14691             {\cf20 // Let type handler parse the line}\par
14692             entry_handler->ReadLineFn(&g, entry_handler, entry_data, line);\par
14693         \}\par
14694     \}\par
14695     g.SettingsLoaded = {\cf17 true};\par
14696 \par
14697     {\cf20 // [DEBUG] Restore untouched copy so it can be browsed in Metrics (not strictly necessary)}\par
14698     memcpy(buf, ini_data, ini_size);\par
14699 \par
14700     {\cf20 // Call post-read handlers}\par
14701     {\cf19 for} (ImGuiSettingsHandler& handler : g.SettingsHandlers)\par
14702         if (handler.ApplyAllFn != NULL)\par
14703             handler.ApplyAllFn(&g, &handler);\par
14704 \}\par
