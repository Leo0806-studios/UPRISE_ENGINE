14095 {\cf20 // Use 'cond' to choose to submit payload on drag start or every frame}\par
14096 {\cf18 bool} ImGui::SetDragDropPayload({\cf17 const} {\cf18 char}* type, {\cf17 const} {\cf18 void}* data, {\cf18 size_t} data_size, ImGuiCond cond)\par
14097 \{\par
14098     ImGuiContext& g = *GImGui;\par
14099     ImGuiPayload& payload = g.DragDropPayload;\par
14100     {\cf19 if} (cond == 0)\par
14101         cond = ImGuiCond_Always;\par
14102 \par
14103     IM_ASSERT(type != NULL);\par
14104     IM_ASSERT(strlen(type) < IM_ARRAYSIZE(payload.DataType) && {\cf22 "Payload type can be at most 32 characters long"});\par
14105     IM_ASSERT((data != NULL && data_size > 0) || (data == NULL && data_size == 0));\par
14106     IM_ASSERT(cond == ImGuiCond_Always || cond == ImGuiCond_Once);\par
14107     IM_ASSERT(payload.SourceId != 0); {\cf20 // Not called between BeginDragDropSource() and EndDragDropSource()}\par
14108 \par
14109     {\cf19 if} (cond == ImGuiCond_Always || payload.DataFrameCount == -1)\par
14110     \{\par
14111         {\cf20 // Copy payload}\par
14112         ImStrncpy(payload.DataType, type, IM_ARRAYSIZE(payload.DataType));\par
14113         g.DragDropPayloadBufHeap.resize(0);\par
14114         {\cf19 if} (data_size > {\cf17 sizeof}(g.DragDropPayloadBufLocal))\par
14115         \{\par
14116             {\cf20 // Store in heap}\par
14117             g.DragDropPayloadBufHeap.resize(({\cf18 int})data_size);\par
14118             payload.Data = g.DragDropPayloadBufHeap.Data;\par
14119             memcpy(payload.Data, data, data_size);\par
14120         \}\par
14121         {\cf19 else} {\cf19 if} (data_size > 0)\par
14122         \{\par
14123             {\cf20 // Store locally}\par
14124             memset(&g.DragDropPayloadBufLocal, 0, {\cf17 sizeof}(g.DragDropPayloadBufLocal));\par
14125             payload.Data = g.DragDropPayloadBufLocal;\par
14126             memcpy(payload.Data, data, data_size);\par
14127         \}\par
14128         {\cf19 else}\par
14129         \{\par
14130             payload.Data = NULL;\par
14131         \}\par
14132         payload.DataSize = (int)data_size;\par
14133     \}\par
14134     payload.DataFrameCount = g.FrameCount;\par
14135 \par
14136     {\cf20 // Return whether the payload has been accepted}\par
14137     {\cf19 return} (g.DragDropAcceptFrameCount == g.FrameCount) || (g.DragDropAcceptFrameCount == g.FrameCount - 1);\par
14138 \}\par
