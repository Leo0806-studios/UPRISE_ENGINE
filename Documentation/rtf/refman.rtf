00259      {\cf18 unsigned} {\cf18 int} Model::TextureFromFile({\cf17 const} {\cf18 char}* path, {\cf17 const} {\cf18 string}& directory, {\cf18 bool} gamma)\par
00260     \{\par
00261 \par
00262         {\cf18 string} filename = string(path);\par
00263         filename = directory + {\cf23 '/'} + filename;\par
00264 \par
00265         {\cf18 unsigned} {\cf18 int} textureID;\par
00266         glGenTextures(1, &textureID);\par
00267 \par
00268         {\cf18 int} width, height, nrComponents;\par
00269         {\cf18 unsigned} {\cf18 char}* data = stbi_load(filename.c_str(), &width, &height, &nrComponents, 0);\par
00270         {\cf19 if} (data)\par
00271         \{\par
00272             GLenum format;\par
00273             {\cf19 if} (nrComponents == 1)\par
00274                 format = GL_RED;\par
00275             {\cf19 else} {\cf19 if} (nrComponents == 3)\par
00276                 format = GL_RGB;\par
00277             {\cf19 else} {\cf19 if} (nrComponents == 4)\par
00278                 format = GL_RGBA;\par
00279 \par
00280             glBindTexture(GL_TEXTURE_2D, textureID);\par
00281             glTexImage2D(GL_TEXTURE_2D, 0, format, width, height, 0, format, GL_UNSIGNED_BYTE, data);\par
00282             glGenerateMipmap(GL_TEXTURE_2D);\par
00283 \par
00284             glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_REPEAT);\par
00285             glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_REPEAT);\par
00286             glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR_MIPMAP_LINEAR);\par
00287             glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);\par
00288 \par
00289             stbi_image_free(data);\par
00290         \}\par
00291         {\cf19 else}\par
00292         \{\par
00293             std::cout << {\cf22 "Texture failed to load at path: "} << path << std::endl;\par
00294             stbi_image_free(data);\par
00295         \}\par
00296 \par
00297         {\cf19 return} textureID;\par
00298     \}\par
