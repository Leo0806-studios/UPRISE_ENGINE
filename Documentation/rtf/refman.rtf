14722 {\cf20 // Call registered handlers (e.g. SettingsHandlerWindow_WriteAll() + custom handlers) to write their stuff into a text buffer}\par
14723 {\cf17 const} {\cf18 char}* ImGui::SaveIniSettingsToMemory({\cf18 size_t}* out_size)\par
14724 \{\par
