02780 \par
02781 {\cf20 // Return NULL if no sort specs (most often when ImGuiTableFlags_Sortable is not set)}\par
02782 {\cf20 // When 'sort_specs->SpecsDirty == true' you should sort your data. It will be true when sorting specs have}\par
02783 {\cf20 // changed since last call, or the first time. Make sure to set 'SpecsDirty = false' after sorting,}\par
02784 {\cf20 // else you may wastefully sort your data every frame!}\par
02785 {\cf20 // Lifetime: don't hold on this pointer over multiple frames or past any subsequent call to BeginTable()!}\par
02786 ImGuiTableSortSpecs* ImGui::TableGetSortSpecs()\par
02787 \{\par
02788     ImGuiContext& g = *GImGui;\par
02789     ImGuiTable* table = g.CurrentTable;\par
02790     IM_ASSERT(table != NULL);\par
02791 \par
02792     {\cf19 if} (!(table->Flags & ImGuiTableFlags_Sortable))\par
02793         {\cf19 return} NULL;\par
02794 \par
02795     {\cf20 // Require layout (in case TableHeadersRow() hasn't been called) as it may alter IsSortSpecsDirty in some paths.}\par
02796     {\cf19 if} (!table->IsLayoutLocked)\par
02797         TableUpdateLayout(table);\par
02798 \par
02799     TableSortSpecsBuild(table);\par
