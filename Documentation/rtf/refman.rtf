03408 {\cf20 // - ImGuiTableFlags_Hideable    -> display columns visibility menu items}\par
03409 {\cf20 // It means if you have a custom context menus you can call this section and omit some sections, and add your own.}\par
03410 {\cf18 void} ImGui::TableDrawDefaultContextMenu(ImGuiTable* table, ImGuiTableFlags flags_for_section_to_display)\par
03411 \{\par
