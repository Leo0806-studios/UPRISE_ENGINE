16862 {\cf17 static} {\cf18 void} ImGui::DockNodeAddWindow(ImGuiDockNode* node, ImGuiWindow* window, {\cf18 bool} add_to_tab_bar)\par
16863 \{\par
16864     ImGuiContext& g = *GImGui; (void)g;\par
16865     {\cf19 if} (window->DockNode)\par
16866     \{\par
16867         {\cf20 // Can overwrite an existing window->DockNode (e.g. pointing to a disabled DockSpace node)}\par
16868         IM_ASSERT(window->DockNode->ID != node->ID);\par
16869         DockNodeRemoveWindow(window->DockNode, window, 0);\par
16870     \}\par
16871     IM_ASSERT(window->DockNode == NULL || window->DockNodeAsHost == NULL);\par
16872     IMGUI_DEBUG_LOG_DOCKING({\cf22 "[docking] DockNodeAddWindow node 0x%08X window '%s'\\n"}, node->ID, window->Name);\par
16873 \par
16874     {\cf20 // If more than 2 windows appeared on the same frame leading to the creation of a new hosting window,}\par
16875     {\cf20 // we'll hide windows until the host window is ready. Hide the 1st window after its been output (so it is not visible for one frame).}\par
16876     {\cf20 // We will call DockNodeHideWindowDuringHostWindowCreation() on ourselves in Begin()}\par
16877     {\cf19 if} (node->HostWindow == NULL && node->Windows.Size == 1 && node->Windows[0]->WasActive == {\cf17 false})\par
16878         DockNodeHideWindowDuringHostWindowCreation(node->Windows[0]);\par
16879 \par
16880     node->Windows.push_back(window);\par
16881     node->WantHiddenTabBarUpdate = {\cf17 true};\par
16882     window->DockNode = node;\par
16883     window->DockId = node->ID;\par
16884     window->DockIsActive = (node->Windows.Size > 1);\par
16885     window->DockTabWantClose = {\cf17 false};\par
16886 \par
16887     {\cf20 // When reactivating a node with one or two loose window, the window pos/size/viewport are authoritative over the node storage.}\par
16888     {\cf20 // In particular it is important we init the viewport from the first window so we don't create two viewports and drop one.}\par
16889     {\cf19 if} (node->HostWindow == NULL && node->IsFloatingNode())\par
16890     \{\par
16891         {\cf19 if} (node->AuthorityForPos == ImGuiDataAuthority_Auto)\par
16892             node->AuthorityForPos = ImGuiDataAuthority_Window;\par
16893         {\cf19 if} (node->AuthorityForSize == ImGuiDataAuthority_Auto)\par
16894             node->AuthorityForSize = ImGuiDataAuthority_Window;\par
16895         {\cf19 if} (node->AuthorityForViewport == ImGuiDataAuthority_Auto)\par
16896             node->AuthorityForViewport = ImGuiDataAuthority_Window;\par
16897     \}\par
16898 \par
16899     {\cf20 // Add to tab bar if requested}\par
16900     {\cf19 if} (add_to_tab_bar)\par
16901     \{\par
16902         {\cf19 if} (node->TabBar == NULL)\par
16903         \{\par
16904             DockNodeAddTabBar(node);\par
16905             node->TabBar->SelectedTabId = node->TabBar->NextSelectedTabId = node->SelectedTabId;\par
16906 \par
16907             {\cf20 // Add existing windows}\par
16908             {\cf19 for} ({\cf18 int} n = 0; n < node->Windows.Size - 1; n++)\par
16909                 TabBarAddTab(node->TabBar, ImGuiTabItemFlags_None, node->Windows[n]);\par
16910         \}\par
16911         TabBarAddTab(node->TabBar, ImGuiTabItemFlags_Unsorted, window);\par
16912     \}\par
16913 \par
16914     DockNodeUpdateVisibleFlag(node);\par
16915 \par
16916     {\cf20 // Update this without waiting for the next time we Begin() in the window, so our host window will have the proper title bar color on its first frame.}\par
16917     {\cf19 if} (node->HostWindow)\par
16918         UpdateWindowParentAndRootLinks(window, window->Flags | ImGuiWindowFlags_ChildWindow, node->HostWindow);\par
16919 \}\par
