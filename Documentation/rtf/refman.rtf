20136 {\cf18 void} ImGui::DebugRenderViewportThumbnail(ImDrawList* draw_list, ImGuiViewportP* viewport, {\cf17 const} ImRect& bb)\par
20137 \{\par
20138     ImGuiContext& g = *GImGui;\par
20139     ImGuiWindow* window = g.CurrentWindow;\par
20140 \par
20141     ImVec2 scale = bb.GetSize() / viewport->Size;\par
20142     ImVec2 off = bb.Min - viewport->Pos * scale;\par
20143     {\cf18 float} alpha_mul = (viewport->Flags & ImGuiViewportFlags_IsMinimized) ? 0.30f : 1.00f;\par
20144     window->DrawList->AddRectFilled(bb.Min, bb.Max, GetColorU32(ImGuiCol_Border, alpha_mul * 0.40f));\par
20145     {\cf19 for} (ImGuiWindow* thumb_window : g.Windows)\par
20146     \{\par
20147         {\cf19 if} (!thumb_window->WasActive || (thumb_window->Flags & ImGuiWindowFlags_ChildWindow))\par
20148             {\cf19 continue};\par
20149         {\cf19 if} (thumb_window->Viewport != viewport)\par
20150             {\cf19 continue};\par
20151 \par
20152         ImRect thumb_r = thumb_window->Rect();\par
20153         ImRect title_r = thumb_window->TitleBarRect();\par
20154         thumb_r = ImRect(ImTrunc(off + thumb_r.Min * scale), ImTrunc(off +  thumb_r.Max * scale));\par
20155         title_r = ImRect(ImTrunc(off + title_r.Min * scale), ImTrunc(off +  ImVec2(title_r.Max.x, title_r.Min.y + title_r.GetHeight() * 3.0f) * scale)); {\cf20 // Exaggerate title bar height}\par
20156         thumb_r.ClipWithFull(bb);\par
20157         title_r.ClipWithFull(bb);\par
20158         {\cf17 const} {\cf18 bool} window_is_focused = (g.NavWindow && thumb_window->RootWindowForTitleBarHighlight == g.NavWindow->RootWindowForTitleBarHighlight);\par
20159         window->DrawList->AddRectFilled(thumb_r.Min, thumb_r.Max, GetColorU32(ImGuiCol_WindowBg, alpha_mul));\par
20160         window->DrawList->AddRectFilled(title_r.Min, title_r.Max, GetColorU32(window_is_focused ? ImGuiCol_TitleBgActive : ImGuiCol_TitleBg, alpha_mul));\par
20161         window->DrawList->AddRect(thumb_r.Min, thumb_r.Max, GetColorU32(ImGuiCol_Border, alpha_mul));\par
20162         window->DrawList->AddText(g.Font, g.FontSize * 1.0f, title_r.Min, GetColorU32(ImGuiCol_Text, alpha_mul), thumb_window->Name, FindRenderedTextEnd(thumb_window->Name));\par
20163     \}\par
20164     draw_list->AddRect(bb.Min, bb.Max, GetColorU32(ImGuiCol_Border, alpha_mul));\par
20165     {\cf19 if} (viewport->ID == g.DebugMetricsConfig.HighlightViewportID)\par
20166         window->DrawList->AddRect(bb.Min, bb.Max, IM_COL32(255, 255, 0, 255));\par
