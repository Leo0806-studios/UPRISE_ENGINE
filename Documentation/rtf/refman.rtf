00680                     {\cf18 bool} is_repeating_already = (item_flags & ImGuiItemFlags_ButtonRepeat) && g.IO.MouseDownDurationPrev[mouse_button] >= g.IO.KeyRepeatDelay; {\cf20 // Repeat mode trumps <on release>}\par
00681                     {\cf18 bool} is_button_avail_or_owned = TestKeyOwner(MouseButtonToKey(mouse_button), test_owner_id);\par
00682                     {\cf19 if} (!is_double_click_release && !is_repeating_already && is_button_avail_or_owned)\par
00683                         pressed = {\cf17 true};\par
00684                 \}\par
00685                 ClearActiveID();\par
00686             \}\par
00687             {\cf19 if} (!(flags & ImGuiButtonFlags_NoNavFocus))\par
00688                 g.NavDisableHighlight = {\cf17 true};\par
