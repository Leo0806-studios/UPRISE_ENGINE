18701 ImGuiDockNode* ImGui::DockNodeTreeFindVisibleNodeByPos(ImGuiDockNode* node, ImVec2 pos)\par
18702 \{\par
18703     {\cf19 if} (!node->IsVisible)\par
18704         {\cf19 return} NULL;\par
18705 \par
18706     {\cf17 const} {\cf18 float} dock_spacing = 0.0f;{\cf20 // g.Style.ItemInnerSpacing.x; // FIXME: Relation to DOCKING_SPLITTER_SIZE?}\par
18707     ImRect r(node->Pos, node->Pos + node->Size);\par
18708     r.Expand(dock_spacing * 0.5f);\par
18709     {\cf18 bool} inside = r.Contains(pos);\par
18710     {\cf19 if} (!inside)\par
18711         {\cf19 return} NULL;\par
18712 \par
18713     {\cf19 if} (node->IsLeafNode())\par
18714         {\cf19 return} node;\par
18715     {\cf19 if} (ImGuiDockNode* hovered_node = DockNodeTreeFindVisibleNodeByPos(node->ChildNodes[0], pos))\par
18716         {\cf19 return} hovered_node;\par
18717     {\cf19 if} (ImGuiDockNode* hovered_node = DockNodeTreeFindVisibleNodeByPos(node->ChildNodes[1], pos))\par
18718         {\cf19 return} hovered_node;\par
18719 \par
18720     {\cf20 // This means we are hovering over the splitter/spacing of a parent node}\par
18721     {\cf19 return} node;\par
18722 \}\par
