09380 {\cf20 // [SECTION] Example App: Custom Rendering using ImDrawList API / ShowExampleAppCustomRendering()}\par
09381 {\cf20 //-----------------------------------------------------------------------------}\par
09382 \par
09383 {\cf20 // Add a |_| looking shape}\par
09384 {\cf17 static} {\cf18 void} PathConcaveShape(ImDrawList* draw_list, {\cf18 float} x, {\cf18 float} y, {\cf18 float} sz)\par
09385 \{\par
09386     {\cf17 const} ImVec2 pos_norms[] = \{ \{ 0.0f, 0.0f \}, \{ 0.3f, 0.0f \}, \{ 0.3f, 0.7f \}, \{ 0.7f, 0.7f \}, \{ 0.7f, 0.0f \}, \{ 1.0f, 0.0f \}, \{ 1.0f, 1.0f \}, \{ 0.0f, 1.0f \} \};\par
09387     {\cf19 for} ({\cf17 const} ImVec2& p : pos_norms)\par
09388         draw_list->PathLineTo(ImVec2(x + 0.5f + (int)(sz * p.x), y + 0.5f + (int)(sz * p.y)));\par
09389 \}\par
09390 \par
09391 {\cf20 // Demonstrate using the low-level ImDrawList to draw custom shapes.}\par
09392 {\cf17 static} {\cf18 void} ShowExampleAppCustomRendering({\cf18 bool}* p_open)\par
09393 \{\par
09394     {\cf19 if} (!ImGui::Begin({\cf22 "Example: Custom rendering"}, p_open))\par
09395     \{\par
09396         ImGui::End();\par
09397         {\cf19 return};\par
09398     \}\par
09399     IMGUI_DEMO_MARKER({\cf22 "Examples/Custom Rendering"});\par
09400 \par
09401     {\cf20 // Tip: If you do a lot of custom rendering, you probably want to use your own geometrical types and benefit of}\par
09402     {\cf20 // overloaded operators, etc. Define IM_VEC2_CLASS_EXTRA in imconfig.h to create implicit conversions between your}\par
09403     {\cf20 // types and ImVec2/ImVec4. Dear ImGui defines overloaded operators but they are internal to imgui.cpp and not}\par
09404     {\cf20 // exposed outside (to avoid messing with your types) In this example we are not using the maths operators!}\par
09405 \par
09406     {\cf19 if} (ImGui::BeginTabBar({\cf22 "##TabBar"}))\par
09407     \{\par
09408         {\cf19 if} (ImGui::BeginTabItem({\cf22 "Primitives"}))\par
09409         \{\par
09410             ImGui::PushItemWidth(-ImGui::GetFontSize() * 15);\par
09411             ImDrawList* draw_list = ImGui::GetWindowDrawList();\par
09412 \par
09413             {\cf20 // Draw gradients}\par
09414             {\cf20 // (note that those are currently exacerbating our sRGB/Linear issues)}\par
09415             {\cf20 // Calling ImGui::GetColorU32() multiplies the given colors by the current Style Alpha, but you may pass the IM_COL32() directly as well..}\par
09416             ImGui::Text({\cf22 "Gradients"});\par
09417             ImVec2 gradient_size = ImVec2(ImGui::CalcItemWidth(), ImGui::GetFrameHeight());\par
09418             \{\par
09419                 ImVec2 p0 = ImGui::GetCursorScreenPos();\par
09420                 ImVec2 p1 = ImVec2(p0.x + gradient_size.x, p0.y + gradient_size.y);\par
09421                 ImU32 col_a = ImGui::GetColorU32(IM_COL32(0, 0, 0, 255));\par
09422                 ImU32 col_b = ImGui::GetColorU32(IM_COL32(255, 255, 255, 255));\par
09423                 draw_list->AddRectFilledMultiColor(p0, p1, col_a, col_b, col_b, col_a);\par
09424                 ImGui::InvisibleButton({\cf22 "##gradient1"}, gradient_size);\par
09425             \}\par
09426             \{\par
09427                 ImVec2 p0 = ImGui::GetCursorScreenPos();\par
09428                 ImVec2 p1 = ImVec2(p0.x + gradient_size.x, p0.y + gradient_size.y);\par
09429                 ImU32 col_a = ImGui::GetColorU32(IM_COL32(0, 255, 0, 255));\par
09430                 ImU32 col_b = ImGui::GetColorU32(IM_COL32(255, 0, 0, 255));\par
09431                 draw_list->AddRectFilledMultiColor(p0, p1, col_a, col_b, col_b, col_a);\par
09432                 ImGui::InvisibleButton({\cf22 "##gradient2"}, gradient_size);\par
09433             \}\par
09434 \par
09435             {\cf20 // Draw a bunch of primitives}\par
09436             ImGui::Text({\cf22 "All primitives"});\par
09437             {\cf17 static} {\cf18 float} sz = 36.0f;\par
09438             {\cf17 static} {\cf18 float} thickness = 3.0f;\par
09439             {\cf17 static} {\cf18 int} ngon_sides = 6;\par
09440             {\cf17 static} {\cf18 bool} circle_segments_override = {\cf17 false};\par
09441             {\cf17 static} {\cf18 int} circle_segments_override_v = 12;\par
09442             {\cf17 static} {\cf18 bool} curve_segments_override = {\cf17 false};\par
09443             {\cf17 static} {\cf18 int} curve_segments_override_v = 8;\par
09444             {\cf17 static} ImVec4 colf = ImVec4(1.0f, 1.0f, 0.4f, 1.0f);\par
09445             ImGui::DragFloat({\cf22 "Size"}, &sz, 0.2f, 2.0f, 100.0f, {\cf22 "%.0f"});\par
09446             ImGui::DragFloat({\cf22 "Thickness"}, &thickness, 0.05f, 1.0f, 8.0f, {\cf22 "%.02f"});\par
09447             ImGui::SliderInt({\cf22 "N-gon sides"}, &ngon_sides, 3, 12);\par
09448             ImGui::Checkbox({\cf22 "##circlesegmentoverride"}, &circle_segments_override);\par
09449             ImGui::SameLine(0.0f, ImGui::GetStyle().ItemInnerSpacing.x);\par
09450             circle_segments_override |= ImGui::SliderInt({\cf22 "Circle segments override"}, &circle_segments_override_v, 3, 40);\par
09451             ImGui::Checkbox({\cf22 "##curvessegmentoverride"}, &curve_segments_override);\par
09452             ImGui::SameLine(0.0f, ImGui::GetStyle().ItemInnerSpacing.x);\par
09453             curve_segments_override |= ImGui::SliderInt({\cf22 "Curves segments override"}, &curve_segments_override_v, 3, 40);\par
09454             ImGui::ColorEdit4({\cf22 "Color"}, &colf.x);\par
09455 \par
09456             {\cf17 const} ImVec2 p = ImGui::GetCursorScreenPos();\par
09457             {\cf17 const} ImU32 col = ImColor(colf);\par
09458             {\cf17 const} {\cf18 float} spacing = 10.0f;\par
09459             {\cf17 const} ImDrawFlags corners_tl_br = ImDrawFlags_RoundCornersTopLeft | ImDrawFlags_RoundCornersBottomRight;\par
09460             {\cf17 const} {\cf18 float} rounding = sz / 5.0f;\par
09461             {\cf17 const} {\cf18 int} circle_segments = circle_segments_override ? circle_segments_override_v : 0;\par
09462             {\cf17 const} {\cf18 int} curve_segments = curve_segments_override ? curve_segments_override_v : 0;\par
09463             {\cf17 const} ImVec2 cp3[3] = \{ ImVec2(0.0f, sz * 0.6f), ImVec2(sz * 0.5f, -sz * 0.4f), ImVec2(sz, sz) \}; {\cf20 // Control points for curves}\par
09464             {\cf17 const} ImVec2 cp4[4] = \{ ImVec2(0.0f, 0.0f), ImVec2(sz * 1.3f, sz * 0.3f), ImVec2(sz - sz * 1.3f, sz - sz * 0.3f), ImVec2(sz, sz) \};\par
09465 \par
09466             {\cf18 float} x = p.x + 4.0f;\par
09467             {\cf18 float} y = p.y + 4.0f;\par
09468             {\cf19 for} ({\cf18 int} n = 0; n < 2; n++)\par
09469             \{\par
09470                 {\cf20 // First line uses a thickness of 1.0f, second line uses the configurable thickness}\par
09471                 {\cf18 float} th = (n == 0) ? 1.0f : thickness;\par
09472                 draw_list->AddNgon(ImVec2(x + sz*0.5f, y + sz*0.5f), sz*0.5f, col, ngon_sides, th);                 x += sz + spacing;  {\cf20 // N-gon}\par
09473                 draw_list->AddCircle(ImVec2(x + sz*0.5f, y + sz*0.5f), sz*0.5f, col, circle_segments, th);          x += sz + spacing;  {\cf20 // Circle}\par
09474                 draw_list->AddEllipse(ImVec2(x + sz*0.5f, y + sz*0.5f), ImVec2(sz*0.5f, sz*0.3f), col, -0.3f, circle_segments, th); x += sz + spacing;  {\cf20 // Ellipse}\par
09475                 draw_list->AddRect(ImVec2(x, y), ImVec2(x + sz, y + sz), col, 0.0f, ImDrawFlags_None, th);          x += sz + spacing;  {\cf20 // Square}\par
09476                 draw_list->AddRect(ImVec2(x, y), ImVec2(x + sz, y + sz), col, rounding, ImDrawFlags_None, th);      x += sz + spacing;  {\cf20 // Square with all rounded corners}\par
09477                 draw_list->AddRect(ImVec2(x, y), ImVec2(x + sz, y + sz), col, rounding, corners_tl_br, th);         x += sz + spacing;  {\cf20 // Square with two rounded corners}\par
09478                 draw_list->AddTriangle(ImVec2(x+sz*0.5f,y), ImVec2(x+sz, y+sz-0.5f), ImVec2(x, y+sz-0.5f), col, th);x += sz + spacing;  {\cf20 // Triangle}\par
09479                 {\cf20 //draw_list->AddTriangle(ImVec2(x+sz*0.2f,y), ImVec2(x, y+sz-0.5f), ImVec2(x+sz*0.4f, y+sz-0.5f), col, th);x+= sz*0.4f + spacing; // Thin triangle}\par
09480                 PathConcaveShape(draw_list, x, y, sz); draw_list->PathStroke(col, ImDrawFlags_Closed, th);          x += sz + spacing;  {\cf20 // Concave Shape}\par
09481                 {\cf20 //draw_list->AddPolyline(concave_shape, IM_ARRAYSIZE(concave_shape), col, ImDrawFlags_Closed, th);}\par
09482                 draw_list->AddLine(ImVec2(x, y), ImVec2(x + sz, y), col, th);                                       x += sz + spacing;  {\cf20 // Horizontal line (note: drawing a filled rectangle will be faster!)}\par
09483                 draw_list->AddLine(ImVec2(x, y), ImVec2(x, y + sz), col, th);                                       x += spacing;       {\cf20 // Vertical line (note: drawing a filled rectangle will be faster!)}\par
09484                 draw_list->AddLine(ImVec2(x, y), ImVec2(x + sz, y + sz), col, th);                                  x += sz + spacing;  {\cf20 // Diagonal line}\par
09485 \par
09486                 {\cf20 // Path}\par
09487                 draw_list->PathArcTo(ImVec2(x + sz*0.5f, y + sz*0.5f), sz*0.5f, 3.141592f, 3.141592f * -0.5f);\par
09488                 draw_list->PathStroke(col, ImDrawFlags_None, th);\par
09489                 x += sz + spacing;\par
09490 \par
09491                 {\cf20 // Quadratic Bezier Curve (3 control points)}\par
09492                 draw_list->AddBezierQuadratic(ImVec2(x + cp3[0].x, y + cp3[0].y), ImVec2(x + cp3[1].x, y + cp3[1].y), ImVec2(x + cp3[2].x, y + cp3[2].y), col, th, curve_segments);\par
09493                 x += sz + spacing;\par
09494 \par
09495                 {\cf20 // Cubic Bezier Curve (4 control points)}\par
09496                 draw_list->AddBezierCubic(ImVec2(x + cp4[0].x, y + cp4[0].y), ImVec2(x + cp4[1].x, y + cp4[1].y), ImVec2(x + cp4[2].x, y + cp4[2].y), ImVec2(x + cp4[3].x, y + cp4[3].y), col, th, curve_segments);\par
09497 \par
09498                 x = p.x + 4;\par
09499                 y += sz + spacing;\par
09500             \}\par
09501 \par
09502             {\cf20 // Filled shapes}\par
09503             draw_list->AddNgonFilled(ImVec2(x + sz * 0.5f, y + sz * 0.5f), sz * 0.5f, col, ngon_sides);             x += sz + spacing;  {\cf20 // N-gon}\par
09504             draw_list->AddCircleFilled(ImVec2(x + sz * 0.5f, y + sz * 0.5f), sz * 0.5f, col, circle_segments);      x += sz + spacing;  {\cf20 // Circle}\par
09505             draw_list->AddEllipseFilled(ImVec2(x + sz * 0.5f, y + sz * 0.5f), ImVec2(sz * 0.5f, sz * 0.3f), col, -0.3f, circle_segments); x += sz + spacing;{\cf20 // Ellipse}\par
09506             draw_list->AddRectFilled(ImVec2(x, y), ImVec2(x + sz, y + sz), col);                                    x += sz + spacing;  {\cf20 // Square}\par
09507             draw_list->AddRectFilled(ImVec2(x, y), ImVec2(x + sz, y + sz), col, 10.0f);                             x += sz + spacing;  {\cf20 // Square with all rounded corners}\par
09508             draw_list->AddRectFilled(ImVec2(x, y), ImVec2(x + sz, y + sz), col, 10.0f, corners_tl_br);              x += sz + spacing;  {\cf20 // Square with two rounded corners}\par
09509             draw_list->AddTriangleFilled(ImVec2(x+sz*0.5f,y), ImVec2(x+sz, y+sz-0.5f), ImVec2(x, y+sz-0.5f), col);  x += sz + spacing;  {\cf20 // Triangle}\par
09510             {\cf20 //draw_list->AddTriangleFilled(ImVec2(x+sz*0.2f,y), ImVec2(x, y+sz-0.5f), ImVec2(x+sz*0.4f, y+sz-0.5f), col); x += sz*0.4f + spacing; // Thin triangle}\par
09511             PathConcaveShape(draw_list, x, y, sz); draw_list->PathFillConcave(col);                                 x += sz + spacing;  {\cf20 // Concave shape}\par
09512             draw_list->AddRectFilled(ImVec2(x, y), ImVec2(x + sz, y + thickness), col);                             x += sz + spacing;  {\cf20 // Horizontal line (faster than AddLine, but only handle integer thickness)}\par
09513             draw_list->AddRectFilled(ImVec2(x, y), ImVec2(x + thickness, y + sz), col);                             x += spacing * 2.0f;{\cf20 // Vertical line (faster than AddLine, but only handle integer thickness)}\par
09514             draw_list->AddRectFilled(ImVec2(x, y), ImVec2(x + 1, y + 1), col);                                      x += sz;            {\cf20 // Pixel (faster than AddLine)}\par
09515 \par
09516             {\cf20 // Path}\par
09517             draw_list->PathArcTo(ImVec2(x + sz * 0.5f, y + sz * 0.5f), sz * 0.5f, 3.141592f * -0.5f, 3.141592f);\par
09518             draw_list->PathFillConvex(col);\par
09519             x += sz + spacing;\par
09520 \par
09521             {\cf20 // Quadratic Bezier Curve (3 control points)}\par
09522             draw_list->PathLineTo(ImVec2(x + cp3[0].x, y + cp3[0].y));\par
09523             draw_list->PathBezierQuadraticCurveTo(ImVec2(x + cp3[1].x, y + cp3[1].y), ImVec2(x + cp3[2].x, y + cp3[2].y), curve_segments);\par
09524             draw_list->PathFillConvex(col);\par
09525             x += sz + spacing;\par
09526 \par
09527             draw_list->AddRectFilledMultiColor(ImVec2(x, y), ImVec2(x + sz, y + sz), IM_COL32(0, 0, 0, 255), IM_COL32(255, 0, 0, 255), IM_COL32(255, 255, 0, 255), IM_COL32(0, 255, 0, 255));\par
09528             x += sz + spacing;\par
09529 \par
09530             ImGui::Dummy(ImVec2((sz + spacing) * 13.2f, (sz + spacing) * 3.0f));\par
09531             ImGui::PopItemWidth();\par
09532             ImGui::EndTabItem();\par
09533         \}\par
09534 \par
09535         {\cf19 if} (ImGui::BeginTabItem({\cf22 "Canvas"}))\par
09536         \{\par
09537             {\cf17 static} ImVector<ImVec2> points;\par
09538             {\cf17 static} ImVec2 scrolling(0.0f, 0.0f);\par
09539             {\cf17 static} {\cf18 bool} opt_enable_grid = {\cf17 true};\par
09540             {\cf17 static} {\cf18 bool} opt_enable_context_menu = {\cf17 true};\par
09541             {\cf17 static} {\cf18 bool} adding_line = {\cf17 false};\par
09542 \par
09543             ImGui::Checkbox({\cf22 "Enable grid"}, &opt_enable_grid);\par
09544             ImGui::Checkbox({\cf22 "Enable context menu"}, &opt_enable_context_menu);\par
09545             ImGui::Text({\cf22 "Mouse Left: drag to add lines,\\nMouse Right: drag to scroll, click for context menu."});\par
09546 \par
09547             {\cf20 // Typically you would use a BeginChild()/EndChild() pair to benefit from a clipping region + own scrolling.}\par
09548             {\cf20 // Here we demonstrate that this can be replaced by simple offsetting + custom drawing + PushClipRect/PopClipRect() calls.}\par
09549             {\cf20 // To use a child window instead we could use, e.g:}\par
09550             {\cf20 //      ImGui::PushStyleVar(ImGuiStyleVar_WindowPadding, ImVec2(0, 0));      // Disable padding}\par
09551             {\cf20 //      ImGui::PushStyleColor(ImGuiCol_ChildBg, IM_COL32(50, 50, 50, 255));  // Set a background color}\par
09552             {\cf20 //      ImGui::BeginChild("canvas", ImVec2(0.0f, 0.0f), ImGuiChildFlags_Border, ImGuiWindowFlags_NoMove);}\par
09553             {\cf20 //      ImGui::PopStyleColor();}\par
09554             {\cf20 //      ImGui::PopStyleVar();}\par
09555             {\cf20 //      [...]}\par
09556             {\cf20 //      ImGui::EndChild();}\par
09557 \par
09558             {\cf20 // Using InvisibleButton() as a convenience 1) it will advance the layout cursor and 2) allows us to use IsItemHovered()/IsItemActive()}\par
09559             ImVec2 canvas_p0 = ImGui::GetCursorScreenPos();      {\cf20 // ImDrawList API uses screen coordinates!}\par
09560             ImVec2 canvas_sz = ImGui::GetContentRegionAvail();   {\cf20 // Resize canvas to what's available}\par
09561             {\cf19 if} (canvas_sz.x < 50.0f) canvas_sz.x = 50.0f;\par
09562             {\cf19 if} (canvas_sz.y < 50.0f) canvas_sz.y = 50.0f;\par
09563             ImVec2 canvas_p1 = ImVec2(canvas_p0.x + canvas_sz.x, canvas_p0.y + canvas_sz.y);\par
09564 \par
09565             {\cf20 // Draw border and background color}\par
09566             ImGuiIO& io = ImGui::GetIO();\par
09567             ImDrawList* draw_list = ImGui::GetWindowDrawList();\par
09568             draw_list->AddRectFilled(canvas_p0, canvas_p1, IM_COL32(50, 50, 50, 255));\par
09569             draw_list->AddRect(canvas_p0, canvas_p1, IM_COL32(255, 255, 255, 255));\par
09570 \par
09571             {\cf20 // This will catch our interactions}\par
09572             ImGui::InvisibleButton({\cf22 "canvas"}, canvas_sz, ImGuiButtonFlags_MouseButtonLeft | ImGuiButtonFlags_MouseButtonRight);\par
09573             {\cf17 const} {\cf18 bool} is_hovered = ImGui::IsItemHovered(); {\cf20 // Hovered}\par
09574             {\cf17 const} {\cf18 bool} is_active = ImGui::IsItemActive();   {\cf20 // Held}\par
09575             {\cf17 const} ImVec2 origin(canvas_p0.x + scrolling.x, canvas_p0.y + scrolling.y); {\cf20 // Lock scrolled origin}\par
09576             {\cf17 const} ImVec2 mouse_pos_in_canvas(io.MousePos.x - origin.x, io.MousePos.y - origin.y);\par
09577 \par
09578             {\cf20 // Add first and second point}\par
09579             {\cf19 if} (is_hovered && !adding_line && ImGui::IsMouseClicked(ImGuiMouseButton_Left))\par
09580             \{\par
09581                 points.push_back(mouse_pos_in_canvas);\par
09582                 points.push_back(mouse_pos_in_canvas);\par
09583                 adding_line = {\cf17 true};\par
09584             \}\par
09585             {\cf19 if} (adding_line)\par
09586             \{\par
09587                 points.back() = mouse_pos_in_canvas;\par
09588                 {\cf19 if} (!ImGui::IsMouseDown(ImGuiMouseButton_Left))\par
09589                     adding_line = {\cf17 false};\par
09590             \}\par
09591 \par
09592             {\cf20 // Pan (we use a zero mouse threshold when there's no context menu)}\par
09593             {\cf20 // You may decide to make that threshold dynamic based on whether the mouse is hovering something etc.}\par
09594             {\cf17 const} {\cf18 float} mouse_threshold_for_pan = opt_enable_context_menu ? -1.0f : 0.0f;\par
09595             {\cf19 if} (is_active && ImGui::IsMouseDragging(ImGuiMouseButton_Right, mouse_threshold_for_pan))\par
09596             \{\par
09597                 scrolling.x += io.MouseDelta.x;\par
09598                 scrolling.y += io.MouseDelta.y;\par
09599             \}\par
09600 \par
09601             {\cf20 // Context menu (under default mouse threshold)}\par
09602             ImVec2 drag_delta = ImGui::GetMouseDragDelta(ImGuiMouseButton_Right);\par
09603             {\cf19 if} (opt_enable_context_menu && drag_delta.x == 0.0f && drag_delta.y == 0.0f)\par
09604                 ImGui::OpenPopupOnItemClick({\cf22 "context"}, ImGuiPopupFlags_MouseButtonRight);\par
09605             {\cf19 if} (ImGui::BeginPopup({\cf22 "context"}))\par
09606             \{\par
09607                 {\cf19 if} (adding_line)\par
09608                     points.resize(points.size() - 2);\par
09609                 adding_line = {\cf17 false};\par
09610                 {\cf19 if} (ImGui::MenuItem({\cf22 "Remove one"}, NULL, {\cf17 false}, points.Size > 0)) \{ points.resize(points.size() - 2); \}\par
09611                 {\cf19 if} (ImGui::MenuItem({\cf22 "Remove all"}, NULL, {\cf17 false}, points.Size > 0)) \{ points.clear(); \}\par
09612                 ImGui::EndPopup();\par
09613             \}\par
09614 \par
09615             {\cf20 // Draw grid + all lines in the canvas}\par
09616             draw_list->PushClipRect(canvas_p0, canvas_p1, {\cf17 true});\par
09617             {\cf19 if} (opt_enable_grid)\par
09618             \{\par
09619                 {\cf17 const} {\cf18 float} GRID_STEP = 64.0f;\par
09620                 {\cf19 for} ({\cf18 float} x = fmodf(scrolling.x, GRID_STEP); x < canvas_sz.x; x += GRID_STEP)\par
09621                     draw_list->AddLine(ImVec2(canvas_p0.x + x, canvas_p0.y), ImVec2(canvas_p0.x + x, canvas_p1.y), IM_COL32(200, 200, 200, 40));\par
09622                 {\cf19 for} ({\cf18 float} y = fmodf(scrolling.y, GRID_STEP); y < canvas_sz.y; y += GRID_STEP)\par
09623                     draw_list->AddLine(ImVec2(canvas_p0.x, canvas_p0.y + y), ImVec2(canvas_p1.x, canvas_p0.y + y), IM_COL32(200, 200, 200, 40));\par
09624             \}\par
09625             {\cf19 for} ({\cf18 int} n = 0; n < points.Size; n += 2)\par
09626                 draw_list->AddLine(ImVec2(origin.x + points[n].x, origin.y + points[n].y), ImVec2(origin.x + points[n + 1].x, origin.y + points[n + 1].y), IM_COL32(255, 255, 0, 255), 2.0f);\par
09627             draw_list->PopClipRect();\par
09628 \par
09629             ImGui::EndTabItem();\par
09630         \}\par
09631 \par
09632         {\cf19 if} (ImGui::BeginTabItem({\cf22 "BG/FG draw lists"}))\par
09633         \{\par
09634             {\cf17 static} {\cf18 bool} draw_bg = {\cf17 true};\par
09635             {\cf17 static} {\cf18 bool} draw_fg = {\cf17 true};\par
09636             ImGui::Checkbox({\cf22 "Draw in Background draw list"}, &draw_bg);\par
09637             ImGui::SameLine(); HelpMarker({\cf22 "The Background draw list will be rendered below every Dear ImGui windows."});\par
09638             ImGui::Checkbox({\cf22 "Draw in Foreground draw list"}, &draw_fg);\par
09639             ImGui::SameLine(); HelpMarker({\cf22 "The Foreground draw list will be rendered over every Dear ImGui windows."});\par
09640             ImVec2 window_pos = ImGui::GetWindowPos();\par
09641             ImVec2 window_size = ImGui::GetWindowSize();\par
09642             ImVec2 window_center = ImVec2(window_pos.x + window_size.x * 0.5f, window_pos.y + window_size.y * 0.5f);\par
09643             {\cf19 if} (draw_bg)\par
09644                 ImGui::GetBackgroundDrawList()->AddCircle(window_center, window_size.x * 0.6f, IM_COL32(255, 0, 0, 200), 0, 10 + 4);\par
09645             {\cf19 if} (draw_fg)\par
09646                 ImGui::GetForegroundDrawList()->AddCircle(window_center, window_size.y * 0.6f, IM_COL32(0, 255, 0, 200), 0, 10);\par
09647             ImGui::EndTabItem();\par
09648         \}\par
09649 \par
09650         {\cf20 // Demonstrate out-of-order rendering via channels splitting}\par
09651         {\cf20 // We use functions in ImDrawList as each draw list contains a convenience splitter,}\par
09652         {\cf20 // but you can also instantiate your own ImDrawListSplitter if you need to nest them.}\par
09653         {\cf19 if} (ImGui::BeginTabItem({\cf22 "Draw Channels"}))\par
09654         \{\par
09655             ImDrawList* draw_list = ImGui::GetWindowDrawList();\par
09656             \{\par
09657                 ImGui::Text({\cf22 "Blue shape is drawn first: appears in back"});\par
09658                 ImGui::Text({\cf22 "Red shape is drawn after: appears in front"});\par
09659                 ImVec2 p0 = ImGui::GetCursorScreenPos();\par
09660                 draw_list->AddRectFilled(ImVec2(p0.x, p0.y), ImVec2(p0.x + 50, p0.y + 50), IM_COL32(0, 0, 255, 255)); {\cf20 // Blue}\par
09661                 draw_list->AddRectFilled(ImVec2(p0.x + 25, p0.y + 25), ImVec2(p0.x + 75, p0.y + 75), IM_COL32(255, 0, 0, 255)); {\cf20 // Red}\par
09662                 ImGui::Dummy(ImVec2(75, 75));\par
09663             \}\par
09664             ImGui::Separator();\par
09665             \{\par
09666                 ImGui::Text({\cf22 "Blue shape is drawn first, into channel 1: appears in front"});\par
09667                 ImGui::Text({\cf22 "Red shape is drawn after, into channel 0: appears in back"});\par
09668                 ImVec2 p1 = ImGui::GetCursorScreenPos();\par
09669 \par
09670                 {\cf20 // Create 2 channels and draw a Blue shape THEN a Red shape.}\par
09671                 {\cf20 // You can create any number of channels. Tables API use 1 channel per column in order to better batch draw calls.}\par
09672                 draw_list->ChannelsSplit(2);\par
09673                 draw_list->ChannelsSetCurrent(1);\par
09674                 draw_list->AddRectFilled(ImVec2(p1.x, p1.y), ImVec2(p1.x + 50, p1.y + 50), IM_COL32(0, 0, 255, 255)); {\cf20 // Blue}\par
09675                 draw_list->ChannelsSetCurrent(0);\par
09676                 draw_list->AddRectFilled(ImVec2(p1.x + 25, p1.y + 25), ImVec2(p1.x + 75, p1.y + 75), IM_COL32(255, 0, 0, 255)); {\cf20 // Red}\par
09677 \par
09678                 {\cf20 // Flatten/reorder channels. Red shape is in channel 0 and it appears below the Blue shape in channel 1.}\par
09679                 {\cf20 // This works by copying draw indices only (vertices are not copied).}\par
09680                 draw_list->ChannelsMerge();\par
09681                 ImGui::Dummy(ImVec2(75, 75));\par
09682                 ImGui::Text({\cf22 "After reordering, contents of channel 0 appears below channel 1."});\par
09683             \}\par
09684             ImGui::EndTabItem();\par
09685         \}\par
09686 \par
09687         ImGui::EndTabBar();\par
09688     \}\par
09689 \par
09690     ImGui::End();\par
09691 \}\par
