00003  DATATYPES::Quaternion DATATYPES::Quaternion::FromEulerAngles(DATATYPES::TS_P_Vector3 vec) \{\par
00004      {\cf18 float} cy = std::cos(vec.y * 0.5);\par
00005      {\cf18 float} sy = std::sin(vec.y * 0.5);\par
00006      {\cf18 float} cp = std::cos(vec.z* 0.5);\par
00007      {\cf18 float} sp = std::sin(vec.z * 0.5);\par
00008      {\cf18 float} cr = std::cos(vec.x * 0.5);\par
00009      {\cf18 float} sr = std::sin(vec.x * 0.5);\par
00010 \par
00011      {\cf19 return} Quaternion(\par
00012          cr * cp * cy + sr * sp * sy,\par
00013          sr * cp * cy - cr * sp * sy,\par
00014          cr * sp * cy + sr * cp * sy,\par
00015          cr * cp * sy - sr * sp * cy\par
00016 \par
00017         {\cf20 //  cr * cp * cy + sr * sp * sy,}\par
00018      {\cf20 //sr * cp * cy - cr * sp * sy,}\par
00019      {\cf20 // cr * sp * cy + sr * cp * sy,}\par
00020      {\cf20 //cr * cp * sy - sr * sp * cy}\par
00021      );\par
00022 \}\par
00023 \par
00024 \par
