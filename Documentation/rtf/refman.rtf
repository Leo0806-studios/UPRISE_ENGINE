00917                 column->WidthRequest = width_auto;\par
00918 \par
00919             {\cf20 // FIXME-TABLE: Increase minimum size during init frame to avoid biasing auto-fitting widgets}\par
00920             {\cf20 // (e.g. TextWrapped) too much. Otherwise what tends to happen is that TextWrapped would output a very}\par
00921             {\cf20 // large height (= first frame scrollbar display very off + clipper would skip lots of items).}\par
