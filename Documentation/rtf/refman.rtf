00128                     f_1_EDX_ = data_[1][3];\par
00129                 \}\par
00130 \par
00131                 {\cf20 // load bitset with flags for function 0x00000007}\par
00132                 {\cf19 if} (nIds_ >= 7)\par
00133                 \{\par
00134                     f_7_EBX_ = data_[7][1];\par
00135                     f_7_ECX_ = data_[7][2];\par
00136                 \}\par
00137 \par
