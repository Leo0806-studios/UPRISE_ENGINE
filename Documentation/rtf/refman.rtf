14736 ImGuiWindowSettings* ImGui::CreateNewWindowSettings({\cf17 const} {\cf18 char}* name)\par
14737 \{\par
14738     ImGuiContext& g = *GImGui;\par
14739 \par
14740     {\cf19 if} (g.IO.ConfigDebugIniSettings == {\cf17 false})\par
14741     \{\par
14742         {\cf20 // Skip to the "###" marker if any. We don't skip past to match the behavior of GetID()}\par
14743         {\cf20 // Preserve the full string when ConfigDebugVerboseIniSettings is set to make .ini inspection easier.}\par
14744         {\cf19 if} ({\cf17 const} {\cf18 char}* p = strstr(name, {\cf22 "###"}))\par
14745             name = p;\par
14746     \}\par
14747     {\cf17 const} {\cf18 size_t} name_len = strlen(name);\par
14748 \par
14749     {\cf20 // Allocate chunk}\par
14750     {\cf17 const} {\cf18 size_t} chunk_size = {\cf17 sizeof}(ImGuiWindowSettings) + name_len + 1;\par
14751     ImGuiWindowSettings* settings = g.SettingsWindows.alloc_chunk(chunk_size);\par
14752     IM_PLACEMENT_NEW(settings) ImGuiWindowSettings();\par
14753     settings->ID = ImHashStr(name, name_len);\par
14754     memcpy(settings->GetName(), name, name_len + 1);   {\cf20 // Store with zero terminator}\par
