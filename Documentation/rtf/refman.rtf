06204 {\cf17 static} ImVec2 CalcWindowAutoFitSize(ImGuiWindow* window, {\cf17 const} ImVec2& size_contents)\par
06205 \{\par
06206     ImGuiContext& g = *GImGui;\par
06207     ImGuiStyle& style = g.Style;\par
06208     {\cf17 const} {\cf18 float} decoration_w_without_scrollbars = window->DecoOuterSizeX1 + window->DecoOuterSizeX2 - window->ScrollbarSizes.x;\par
06209     {\cf17 const} {\cf18 float} decoration_h_without_scrollbars = window->DecoOuterSizeY1 + window->DecoOuterSizeY2 - window->ScrollbarSizes.y;\par
06210     ImVec2 size_pad = window->WindowPadding * 2.0f;\par
06211     ImVec2 size_desired = size_contents + size_pad + ImVec2(decoration_w_without_scrollbars, decoration_h_without_scrollbars);\par
06212     {\cf19 if} (window->Flags & ImGuiWindowFlags_Tooltip)\par
06213     \{\par
06214         {\cf20 // Tooltip always resize}\par
06215         {\cf19 return} size_desired;\par
06216     \}\par
06217     {\cf19 else}\par
06218     \{\par
06219         {\cf20 // Maximum window size is determined by the viewport size or monitor size}\par
06220         ImVec2 size_min = CalcWindowMinSize(window);\par
06221         ImVec2 size_max = ImVec2(FLT_MAX, FLT_MAX);\par
06222 \par
06223         {\cf20 // Child windows are layed within their parent (unless they are also popups/menus) and thus have no restriction}\par
06224         {\cf19 if} ((window->Flags & ImGuiWindowFlags_ChildWindow) == 0 || (window->Flags & ImGuiWindowFlags_Popup) != 0)\par
06225         \{\par
06226             {\cf19 if} (!window->ViewportOwned)\par
06227                 size_max = ImGui::GetMainViewport()->WorkSize - style.DisplaySafeAreaPadding * 2.0f;\par
06228             {\cf17 const} {\cf18 int} monitor_idx = window->ViewportAllowPlatformMonitorExtend;\par
06229             {\cf19 if} (monitor_idx >= 0 && monitor_idx < g.PlatformIO.Monitors.Size)\par
06230                 size_max = g.PlatformIO.Monitors[monitor_idx].WorkSize - style.DisplaySafeAreaPadding * 2.0f;\par
06231         \}\par
06232 \par
06233         ImVec2 size_auto_fit = ImClamp(size_desired, size_min, ImMax(size_min, size_max));\par
06234 \par
06235         {\cf20 // FIXME: CalcWindowAutoFitSize() doesn't take into account that only one axis may be auto-fit when calculating scrollbars,}\par
06236         {\cf20 // we may need to compute/store three variants of size_auto_fit, for x/y/xy.}\par
06237         {\cf20 // Here we implement a workaround for child windows only, but a full solution would apply to normal windows as well:}\par
06238         {\cf19 if} ((window->ChildFlags & ImGuiChildFlags_ResizeX) && !(window->ChildFlags & ImGuiChildFlags_ResizeY))\par
06239             size_auto_fit.y = window->SizeFull.y;\par
06240         {\cf19 else} {\cf19 if} (!(window->ChildFlags & ImGuiChildFlags_ResizeX) && (window->ChildFlags & ImGuiChildFlags_ResizeY))\par
06241             size_auto_fit.x = window->SizeFull.x;\par
06242 \par
06243         {\cf20 // When the window cannot fit all contents (either because of constraints, either because screen is too small),}\par
06244         {\cf20 // we are growing the size on the other axis to compensate for expected scrollbar. FIXME: Might turn bigger than ViewportSize-WindowPadding.}\par
06245         ImVec2 size_auto_fit_after_constraint = CalcWindowSizeAfterConstraint(window, size_auto_fit);\par
06246         {\cf18 bool} will_have_scrollbar_x = (size_auto_fit_after_constraint.x - size_pad.x - decoration_w_without_scrollbars < size_contents.x && !(window->Flags & ImGuiWindowFlags_NoScrollbar) && (window->Flags & ImGuiWindowFlags_HorizontalScrollbar)) || (window->Flags & ImGuiWindowFlags_AlwaysHorizontalScrollbar);\par
06247         {\cf18 bool} will_have_scrollbar_y = (size_auto_fit_after_constraint.y - size_pad.y - decoration_h_without_scrollbars < size_contents.y && !(window->Flags & ImGuiWindowFlags_NoScrollbar)) || (window->Flags & ImGuiWindowFlags_AlwaysVerticalScrollbar);\par
06248         {\cf19 if} (will_have_scrollbar_x)\par
06249             size_auto_fit.y += style.ScrollbarSize;\par
06250         {\cf19 if} (will_have_scrollbar_y)\par
06251             size_auto_fit.x += style.ScrollbarSize;\par
06252         {\cf19 return} size_auto_fit;\par
