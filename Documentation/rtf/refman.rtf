00813             column->UserID = 0;\par
00814             column->InitStretchWeightOrWidth = -1.0f;\par
00815         \}\par
00816 \par
00817         {\cf20 // Update Enabled state, mark settings and sort specs dirty}\par
00818         {\cf19 if} (!(table->Flags & ImGuiTableFlags_Hideable) || (column->Flags & ImGuiTableColumnFlags_NoHide))\par
00819             column->IsUserEnabledNextFrame = {\cf17 true};\par
00820         {\cf19 if} (column->IsUserEnabled != column->IsUserEnabledNextFrame)\par
00821         \{\par
00822             column->IsUserEnabled = column->IsUserEnabledNextFrame;\par
00823             table->IsSettingsDirty = {\cf17 true};\par
00824         \}\par
00825         column->IsEnabled = column->IsUserEnabled && (column->Flags & ImGuiTableColumnFlags_Disabled) == 0;\par
00826 \par
