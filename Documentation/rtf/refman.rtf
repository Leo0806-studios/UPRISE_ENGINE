06840         {\cf18 float} pad_extend = ImMin(ImMax(pad_l, pad_r), title_bar_rect.GetWidth() - pad_l - pad_r - text_size.x);\par
06841         pad_l = ImMax(pad_l, pad_extend * centerness);\par
