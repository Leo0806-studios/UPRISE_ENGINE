15699 {\cf20 // Called by user at the end of the main loop, after EndFrame()}\par
15700 {\cf20 // This will handle the creation/update of all OS windows via function defined in the ImGuiPlatformIO api.}\par
15701 {\cf18 void} ImGui::UpdatePlatformWindows()\par
15702 \{\par
15703     ImGuiContext& g = *GImGui;\par
15704     IM_ASSERT(g.FrameCountEnded == g.FrameCount && {\cf22 "Forgot to call Render() or EndFrame() before UpdatePlatformWindows()?"});\par
15705     IM_ASSERT(g.FrameCountPlatformEnded < g.FrameCount);\par
15706     g.FrameCountPlatformEnded = g.FrameCount;\par
15707     {\cf19 if} (!(g.ConfigFlagsCurrFrame & ImGuiConfigFlags_ViewportsEnable))\par
15708         {\cf19 return};\par
15709 \par
15710     {\cf20 // Create/resize/destroy platform windows to match each active viewport.}\par
15711     {\cf20 // Skip the main viewport (index 0), which is always fully handled by the application!}\par
15712     {\cf19 for} ({\cf18 int} i = 1; i < g.Viewports.Size; i++)\par
15713     \{\par
15714         ImGuiViewportP* viewport = g.Viewports[i];\par
15715 \par
15716         {\cf20 // Destroy platform window if the viewport hasn't been submitted or if it is hosting a hidden window}\par
15717         {\cf20 // (the implicit/fallback Debug##Default window will be registering its viewport then be disabled, causing a dummy DestroyPlatformWindow to be made each frame)}\par
15718         {\cf18 bool} destroy_platform_window = {\cf17 false};\par
15719         destroy_platform_window |= (viewport->LastFrameActive < g.FrameCount - 1);\par
15720         destroy_platform_window |= (viewport->Window && !IsWindowActiveAndVisible(viewport->Window));\par
15721         {\cf19 if} (destroy_platform_window)\par
15722         \{\par
15723             DestroyPlatformWindow(viewport);\par
15724             {\cf19 continue};\par
15725         \}\par
15726 \par
15727         {\cf20 // New windows that appears directly in a new viewport won't always have a size on their first frame}\par
15728         {\cf19 if} (viewport->LastFrameActive < g.FrameCount || viewport->Size.x <= 0 || viewport->Size.y <= 0)\par
15729             {\cf19 continue};\par
15730 \par
15731         {\cf20 // Create window}\par
15732         {\cf17 const} {\cf18 bool} is_new_platform_window = (viewport->PlatformWindowCreated == {\cf17 false});\par
15733         {\cf19 if} (is_new_platform_window)\par
15734         \{\par
15735             IMGUI_DEBUG_LOG_VIEWPORT({\cf22 "[viewport] Create Platform Window %08X '%s'\\n"}, viewport->ID, viewport->Window ? viewport->Window->Name : {\cf22 "n/a"});\par
15736             g.PlatformIO.Platform_CreateWindow(viewport);\par
15737             {\cf19 if} (g.PlatformIO.Renderer_CreateWindow != NULL)\par
15738                 g.PlatformIO.Renderer_CreateWindow(viewport);\par
15739             g.PlatformWindowsCreatedCount++;\par
15740             viewport->LastNameHash = 0;\par
15741             viewport->LastPlatformPos = viewport->LastPlatformSize = ImVec2(FLT_MAX, FLT_MAX); {\cf20 // By clearing those we'll enforce a call to Platform_SetWindowPos/Size below, before Platform_ShowWindow (FIXME: Is that necessary?)}\par
15742             viewport->LastRendererSize = viewport->Size;                                       {\cf20 // We don't need to call Renderer_SetWindowSize() as it is expected Renderer_CreateWindow() already did it.}\par
15743             viewport->PlatformWindowCreated = {\cf17 true};\par
15744         \}\par
15745 \par
15746         {\cf20 // Apply Position and Size (from ImGui to Platform/Renderer backends)}\par
15747         {\cf19 if} ((viewport->LastPlatformPos.x != viewport->Pos.x || viewport->LastPlatformPos.y != viewport->Pos.y) && !viewport->PlatformRequestMove)\par
15748             g.PlatformIO.Platform_SetWindowPos(viewport, viewport->Pos);\par
15749         {\cf19 if} ((viewport->LastPlatformSize.x != viewport->Size.x || viewport->LastPlatformSize.y != viewport->Size.y) && !viewport->PlatformRequestResize)\par
15750             g.PlatformIO.Platform_SetWindowSize(viewport, viewport->Size);\par
15751         {\cf19 if} ((viewport->LastRendererSize.x != viewport->Size.x || viewport->LastRendererSize.y != viewport->Size.y) && g.PlatformIO.Renderer_SetWindowSize)\par
15752             g.PlatformIO.Renderer_SetWindowSize(viewport, viewport->Size);\par
15753         viewport->LastPlatformPos = viewport->Pos;\par
15754         viewport->LastPlatformSize = viewport->LastRendererSize = viewport->Size;\par
15755 \par
15756         {\cf20 // Update title bar (if it changed)}\par
15757         {\cf19 if} (ImGuiWindow* window_for_title = GetWindowForTitleDisplay(viewport->Window))\par
15758         \{\par
15759             {\cf17 const} {\cf18 char}* title_begin = window_for_title->Name;\par
15760             {\cf18 char}* title_end = ({\cf18 char}*)(intptr_t)FindRenderedTextEnd(title_begin);\par
15761             {\cf17 const} ImGuiID title_hash = ImHashStr(title_begin, title_end - title_begin);\par
15762             {\cf19 if} (viewport->LastNameHash != title_hash)\par
15763             \{\par
15764                 {\cf18 char} title_end_backup_c = *title_end;\par
15765                 *title_end = 0; {\cf20 // Cut existing buffer short instead of doing an alloc/free, no small gain.}\par
15766                 g.PlatformIO.Platform_SetWindowTitle(viewport, title_begin);\par
15767                 *title_end = title_end_backup_c;\par
15768                 viewport->LastNameHash = title_hash;\par
15769             \}\par
15770         \}\par
15771 \par
15772         {\cf20 // Update alpha (if it changed)}\par
15773         {\cf19 if} (viewport->LastAlpha != viewport->Alpha && g.PlatformIO.Platform_SetWindowAlpha)\par
15774             g.PlatformIO.Platform_SetWindowAlpha(viewport, viewport->Alpha);\par
15775         viewport->LastAlpha = viewport->Alpha;\par
15776 \par
15777         {\cf20 // Optional, general purpose call to allow the backend to perform general book-keeping even if things haven't changed.}\par
15778         {\cf19 if} (g.PlatformIO.Platform_UpdateWindow)\par
15779             g.PlatformIO.Platform_UpdateWindow(viewport);\par
15780 \par
15781         {\cf19 if} (is_new_platform_window)\par
15782         \{\par
15783             {\cf20 // On startup ensure new platform window don't steal focus (give it a few frames, as nested contents may lead to viewport being created a few frames late)}\par
15784             {\cf19 if} (g.FrameCount < 3)\par
15785                 viewport->Flags |= ImGuiViewportFlags_NoFocusOnAppearing;\par
15786 \par
15787             {\cf20 // Show window}\par
15788             g.PlatformIO.Platform_ShowWindow(viewport);\par
15789 \par
15790             {\cf20 // Even without focus, we assume the window becomes front-most.}\par
15791             {\cf20 // This is useful for our platform z-order heuristic when io.MouseHoveredViewport is not available.}\par
15792             {\cf19 if} (viewport->LastFocusedStampCount != g.ViewportFocusedStampCount)\par
15793                 viewport->LastFocusedStampCount = ++g.ViewportFocusedStampCount;\par
15794         \}\par
15795 \par
15796         {\cf20 // Clear request flags}\par
15797         viewport->ClearRequestFlags();\par
15798     \}\par
15799 \}\par
