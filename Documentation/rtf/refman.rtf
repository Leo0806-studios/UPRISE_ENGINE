10773     IM_ASSERT(window != NULL);\par
10774     {\cf19 while} (g.CurrentTabBar != NULL) {\cf20 //-V1044}\par
10775     \{\par
10776         {\cf19 if} (log_callback) log_callback(user_data, {\cf22 "Recovered from missing EndTabBar() in '%s'"}, window->Name);\par
10777         EndTabBar();\par
10778     \}\par
