09260 {\cf20 // Rewrite routing data buffers to strip old entries + sort by key to make queries not touch scattered data.}\par
09261 {\cf20 //   Entries   D,A,B,B,A,C,B     --> A,A,B,B,B,C,D}\par
09262 {\cf20 //   Index     A:1 B:2 C:5 D:0   --> A:0 B:2 C:5 D:6}\par
09263 {\cf20 // See 'Metrics->Key Owners & Shortcut Routing' to visualize the result of that operation.}\par
09264 {\cf17 static} {\cf18 void} ImGui::UpdateKeyRoutingTable(ImGuiKeyRoutingTable* rt)\par
09265 \{\par
09266     ImGuiContext& g = *GImGui;\par
09267     rt->EntriesNext.resize(0);\par
09268     {\cf19 for} (ImGuiKey key = ImGuiKey_NamedKey_BEGIN; key < ImGuiKey_NamedKey_END; key = (ImGuiKey)(key + 1))\par
09269     \{\par
09270         {\cf17 const} {\cf18 int} new_routing_start_idx = rt->EntriesNext.Size;\par
09271         ImGuiKeyRoutingData* routing_entry;\par
09272         {\cf19 for} ({\cf18 int} old_routing_idx = rt->Index[key - ImGuiKey_NamedKey_BEGIN]; old_routing_idx != -1; old_routing_idx = routing_entry->NextEntryIndex)\par
09273         \{\par
09274             routing_entry = &rt->Entries[old_routing_idx];\par
09275             routing_entry->RoutingCurrScore = routing_entry->RoutingNextScore;\par
09276             routing_entry->RoutingCurr = routing_entry->RoutingNext; {\cf20 // Update entry}\par
09277             routing_entry->RoutingNext = ImGuiKeyOwner_NoOwner;\par
09278             routing_entry->RoutingNextScore = 255;\par
09279             {\cf19 if} (routing_entry->RoutingCurr == ImGuiKeyOwner_NoOwner)\par
09280                 {\cf19 continue};\par
09281             rt->EntriesNext.push_back(*routing_entry); {\cf20 // Write alive ones into new buffer}\par
09282 \par
09283             {\cf20 // Apply routing to owner if there's no owner already (RoutingCurr == None at this point)}\par
09284             {\cf20 // This is the result of previous frame's SetShortcutRouting() call.}\par
09285             {\cf19 if} (routing_entry->Mods == g.IO.KeyMods)\par
09286             \{\par
09287                 ImGuiKeyOwnerData* owner_data = GetKeyOwnerData(&g, key);\par
09288                 {\cf19 if} (owner_data->OwnerCurr == ImGuiKeyOwner_NoOwner)\par
09289                 \{\par
09290                     owner_data->OwnerCurr = routing_entry->RoutingCurr;\par
09291                     {\cf20 //IMGUI_DEBUG_LOG("SetKeyOwner(%s, owner_id=0x%08X) via Routing\\n", GetKeyName(key), routing_entry->RoutingCurr);}\par
09292                 \}\par
09293             \}\par
09294         \}\par
09295 \par
09296         {\cf20 // Rewrite linked-list}\par
09297         rt->Index[key - ImGuiKey_NamedKey_BEGIN] = (ImGuiKeyRoutingIndex)(new_routing_start_idx < rt->EntriesNext.Size ? new_routing_start_idx : -1);\par
09298         {\cf19 for} ({\cf18 int} n = new_routing_start_idx; n < rt->EntriesNext.Size; n++)\par
09299             rt->EntriesNext[n].NextEntryIndex = (ImGuiKeyRoutingIndex)((n + 1 < rt->EntriesNext.Size) ? n + 1 : -1);\par
09300     \}\par
09301     rt->Entries.swap(rt->EntriesNext); {\cf20 // Swap new and old indexes}\par
09302 \}\par
09303 \par
09304 {\cf20 // owner_id may be None/Any, but routing_id needs to be always be set, so we default to GetCurrentFocusScope().}\par
09305 {\cf17 static} {\cf17 inline} ImGuiID GetRoutingIdFromOwnerId(ImGuiID owner_id)\par
09306 \{\par
09307     ImGuiContext& g = *GImGui;\par
09308     {\cf19 return} (owner_id != ImGuiKeyOwner_NoOwner && owner_id != ImGuiKeyOwner_Any) ? owner_id : g.CurrentFocusScopeId;\par
09309 \}\par
