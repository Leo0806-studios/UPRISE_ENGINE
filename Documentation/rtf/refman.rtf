00505         item_flags |= ImGuiItemFlags_AllowOverlap;\par
00506     {\cf19 if} (flags & ImGuiButtonFlags_Repeat)\par
00507         item_flags |= ImGuiItemFlags_ButtonRepeat;\par
00508 \par
00509     ImGuiWindow* backup_hovered_window = g.HoveredWindow;\par
00510     {\cf17 const} {\cf18 bool} flatten_hovered_children = (flags & ImGuiButtonFlags_FlattenChildren) && g.HoveredWindow && g.HoveredWindow->RootWindowDockTree == window->RootWindowDockTree;\par
00511     {\cf19 if} (flatten_hovered_children)\par
00512         g.HoveredWindow = window;\par
00513 \par
00514 {\cf21 #ifdef IMGUI_ENABLE_TEST_ENGINE}\par
00515     {\cf20 // Alternate registration spot, for when caller didn't use ItemAdd()}\par
00516     {\cf19 if} (g.LastItemData.ID != {\cf18 id})\par
00517         IMGUI_TEST_ENGINE_ITEM_ADD({\cf18 id}, bb, NULL);\par
00518 {\cf21 #endif}\par
00519 \par
00520     {\cf18 bool} pressed = {\cf17 false};\par
00521     {\cf18 bool} hovered = ItemHoverable(bb, {\cf18 id}, item_flags);\par
00522 \par
00523     {\cf20 // Special mode for Drag and Drop where holding button pressed for a long time while dragging another item triggers the button}\par
00524     {\cf19 if} (g.DragDropActive && (flags & ImGuiButtonFlags_PressedOnDragDropHold) && !(g.DragDropSourceFlags & ImGuiDragDropFlags_SourceNoHoldToOpenOthers))\par
00525         {\cf19 if} (IsItemHovered(ImGuiHoveredFlags_AllowWhenBlockedByActiveItem))\par
00526         \{\par
00527             hovered = {\cf17 true};\par
00528             SetHoveredID({\cf18 id});\par
00529             {\cf19 if} (g.HoveredIdTimer - g.IO.DeltaTime <= DRAGDROP_HOLD_TO_OPEN_TIMER && g.HoveredIdTimer >= DRAGDROP_HOLD_TO_OPEN_TIMER)\par
00530             \{\par
00531                 pressed = {\cf17 true};\par
00532                 g.DragDropHoldJustPressedId = id;\par
00533                 FocusWindow(window);\par
00534             \}\par
00535         \}\par
00536 \par
00537     {\cf19 if} (flatten_hovered_children)\par
00538         g.HoveredWindow = backup_hovered_window;\par
00539 \par
00540     {\cf20 // Mouse handling}\par
00541     {\cf17 const} ImGuiID test_owner_id = (flags & ImGuiButtonFlags_NoTestKeyOwner) ? ImGuiKeyOwner_Any : id;\par
00542     {\cf19 if} (hovered)\par
00543     \{\par
00544         IM_ASSERT({\cf18 id} != 0); {\cf20 // Lazily check inside rare path.}\par
00545 \par
00546         {\cf20 // Poll mouse buttons}\par
00547         {\cf20 // - 'mouse_button_clicked' is generally carried into ActiveIdMouseButton when setting ActiveId.}\par
00548         {\cf20 // - Technically we only need some values in one code path, but since this is gated by hovered test this is fine.}\par
00549         {\cf18 int} mouse_button_clicked = -1;\par
00550         {\cf18 int} mouse_button_released = -1;\par
00551         {\cf19 for} ({\cf18 int} button = 0; button < 3; button++)\par
00552             {\cf19 if} (flags & (ImGuiButtonFlags_MouseButtonLeft << button)) {\cf20 // Handle ImGuiButtonFlags_MouseButtonRight and ImGuiButtonFlags_MouseButtonMiddle here.}\par
00553             \{\par
00554                 {\cf19 if} (IsMouseClicked(button, ImGuiInputFlags_None, test_owner_id) && mouse_button_clicked == -1) \{ mouse_button_clicked = button; \}\par
00555                 {\cf19 if} (IsMouseReleased(button, test_owner_id) && mouse_button_released == -1) \{ mouse_button_released = button; \}\par
00556             \}\par
00557 \par
00558         {\cf20 // Process initial action}\par
00559         {\cf19 if} (!(flags & ImGuiButtonFlags_NoKeyModifiers) || (!g.IO.KeyCtrl && !g.IO.KeyShift && !g.IO.KeyAlt))\par
00560         \{\par
00561             {\cf19 if} (mouse_button_clicked != -1 && g.ActiveId != {\cf18 id})\par
00562             \{\par
00563                 {\cf19 if} (!(flags & ImGuiButtonFlags_NoSetKeyOwner))\par
00564                     SetKeyOwner(MouseButtonToKey(mouse_button_clicked), {\cf18 id});\par
00565                 {\cf19 if} (flags & (ImGuiButtonFlags_PressedOnClickRelease | ImGuiButtonFlags_PressedOnClickReleaseAnywhere))\par
00566                 \{\par
00567                     SetActiveID({\cf18 id}, window);\par
00568                     g.ActiveIdMouseButton = mouse_button_clicked;\par
00569                     {\cf19 if} (!(flags & ImGuiButtonFlags_NoNavFocus))\par
00570                     \{\par
00571                         SetFocusID({\cf18 id}, window);\par
00572                         FocusWindow(window);\par
00573                     \}\par
00574                     {\cf19 else}\par
00575                     \{\par
00576                         FocusWindow(window, ImGuiFocusRequestFlags_RestoreFocusedChild); {\cf20 // Still need to focus and bring to front, but try to avoid losing NavId when navigating a child}\par
00577                     \}\par
00578                 \}\par
00579                 {\cf19 if} ((flags & ImGuiButtonFlags_PressedOnClick) || ((flags & ImGuiButtonFlags_PressedOnDoubleClick) && g.IO.MouseClickedCount[mouse_button_clicked] == 2))\par
00580                 \{\par
00581                     pressed = {\cf17 true};\par
00582                     {\cf19 if} (flags & ImGuiButtonFlags_NoHoldingActiveId)\par
00583                         ClearActiveID();\par
00584                     {\cf19 else}\par
00585                         SetActiveID({\cf18 id}, window); {\cf20 // Hold on ID}\par
00586                     g.ActiveIdMouseButton = mouse_button_clicked;\par
00587                     {\cf19 if} (!(flags & ImGuiButtonFlags_NoNavFocus))\par
00588                     \{\par
00589                         SetFocusID({\cf18 id}, window);\par
00590                         FocusWindow(window);\par
00591                     \}\par
00592                     {\cf19 else}\par
00593                     \{\par
00594                         FocusWindow(window, ImGuiFocusRequestFlags_RestoreFocusedChild); {\cf20 // Still need to focus and bring to front, but try to avoid losing NavId when navigating a child}\par
00595                     \}\par
00596                 \}\par
00597             \}\par
00598             {\cf19 if} (flags & ImGuiButtonFlags_PressedOnRelease)\par
00599             \{\par
00600                 {\cf19 if} (mouse_button_released != -1)\par
00601                 \{\par
00602                     {\cf17 const} {\cf18 bool} has_repeated_at_least_once = (item_flags & ImGuiItemFlags_ButtonRepeat) && g.IO.MouseDownDurationPrev[mouse_button_released] >= g.IO.KeyRepeatDelay; {\cf20 // Repeat mode trumps on release behavior}\par
00603                     {\cf19 if} (!has_repeated_at_least_once)\par
00604                         pressed = {\cf17 true};\par
00605                     {\cf19 if} (!(flags & ImGuiButtonFlags_NoNavFocus))\par
00606                         SetFocusID({\cf18 id}, window);\par
00607                     ClearActiveID();\par
00608                 \}\par
00609             \}\par
00610 \par
00611             {\cf20 // 'Repeat' mode acts when held regardless of _PressedOn flags (see table above).}\par
00612             {\cf20 // Relies on repeat logic of IsMouseClicked() but we may as well do it ourselves if we end up exposing finer RepeatDelay/RepeatRate settings.}\par
00613             {\cf19 if} (g.ActiveId == {\cf18 id} && (item_flags & ImGuiItemFlags_ButtonRepeat))\par
00614                 {\cf19 if} (g.IO.MouseDownDuration[g.ActiveIdMouseButton] > 0.0f && IsMouseClicked(g.ActiveIdMouseButton, ImGuiInputFlags_Repeat, test_owner_id))\par
00615                     pressed = {\cf17 true};\par
00616         \}\par
00617 \par
00618         {\cf19 if} (pressed)\par
00619             g.NavDisableHighlight = {\cf17 true};\par
00620     \}\par
00621 \par
00622     {\cf20 // Gamepad/Keyboard handling}\par
00623     {\cf20 // We report navigated and navigation-activated items as hovered but we don't set g.HoveredId to not interfere with mouse.}\par
00624     {\cf19 if} (g.NavId == {\cf18 id} && !g.NavDisableHighlight && g.NavDisableMouseHover)\par
00625         {\cf19 if} (!(flags & ImGuiButtonFlags_NoHoveredOnFocus))\par
00626             hovered = {\cf17 true};\par
00627     {\cf19 if} (g.NavActivateDownId == {\cf18 id})\par
00628     \{\par
00629         {\cf18 bool} nav_activated_by_code = (g.NavActivateId == id);\par
00630         {\cf18 bool} nav_activated_by_inputs = (g.NavActivatePressedId == id);\par
00631         {\cf19 if} (!nav_activated_by_inputs && (item_flags & ImGuiItemFlags_ButtonRepeat))\par
00632         \{\par
00633             {\cf20 // Avoid pressing multiple keys from triggering excessive amount of repeat events}\par
00634             {\cf17 const} ImGuiKeyData* key1 = GetKeyData(ImGuiKey_Space);\par
00635             {\cf17 const} ImGuiKeyData* key2 = GetKeyData(ImGuiKey_Enter);\par
00636             {\cf17 const} ImGuiKeyData* key3 = GetKeyData(ImGuiKey_NavGamepadActivate);\par
00637             {\cf17 const} {\cf18 float} t1 = ImMax(ImMax(key1->DownDuration, key2->DownDuration), key3->DownDuration);\par
00638             nav_activated_by_inputs = CalcTypematicRepeatAmount(t1 - g.IO.DeltaTime, t1, g.IO.KeyRepeatDelay, g.IO.KeyRepeatRate) > 0;\par
00639         \}\par
00640         {\cf19 if} (nav_activated_by_code || nav_activated_by_inputs)\par
00641         \{\par
00642             {\cf20 // Set active id so it can be queried by user via IsItemActive(), equivalent of holding the mouse button.}\par
00643             pressed = {\cf17 true};\par
