12647 {\cf20 // Handle "scoring" of an item for a tabbing/focusing request initiated by NavUpdateCreateTabbingRequest().}\par
12648 {\cf20 // Note that SetKeyboardFocusHere() API calls are considered tabbing requests!}\par
12649 {\cf20 // - Case 1: no nav/active id:    set result to first eligible item, stop storing.}\par
12650 {\cf20 // - Case 2: tab forward:         on ref id set counter, on counter elapse store result}\par
12651 {\cf20 // - Case 3: tab forward wrap:    set result to first eligible item (preemptively), on ref id set counter, on next frame if counter hasn't elapsed store result. // FIXME-TABBING: Could be done as a next-frame forwarded request}\par
12652 {\cf20 // - Case 4: tab backward:        store all results, on ref id pick prev, stop storing}\par
12653 {\cf20 // - Case 5: tab backward wrap:   store all results, on ref id if no result keep storing until last // FIXME-TABBING: Could be done as next-frame forwarded requested}\par
12654 {\cf18 void} ImGui::NavProcessItemForTabbingRequest(ImGuiID {\cf18 id}, ImGuiItemFlags item_flags, ImGuiNavMoveFlags move_flags)\par
12655 \{\par
12656     ImGuiContext& g = *GImGui;\par
12657 \par
12658     {\cf19 if} ((move_flags & ImGuiNavMoveFlags_FocusApi) == 0)\par
12659     \{\par
12660         {\cf19 if} (g.NavLayer != g.CurrentWindow->DC.NavLayerCurrent)\par
12661             {\cf19 return};\par
12662         {\cf19 if} (g.NavFocusScopeId != g.CurrentFocusScopeId)\par
12663             {\cf19 return};\par
12664     \}\par
12665 \par
12666     {\cf20 // - Can always land on an item when using API call.}\par
12667     {\cf20 // - Tabbing with _NavEnableKeyboard (space/enter/arrows): goes through every item.}\par
12668     {\cf20 // - Tabbing without _NavEnableKeyboard: goes through inputable items only.}\par
12669     {\cf18 bool} can_stop;\par
12670     {\cf19 if} (move_flags & ImGuiNavMoveFlags_FocusApi)\par
12671         can_stop = {\cf17 true};\par
12672     {\cf19 else}\par
12673         can_stop = (item_flags & ImGuiItemFlags_NoTabStop) == 0 && ((g.IO.ConfigFlags & ImGuiConfigFlags_NavEnableKeyboard) || (item_flags & ImGuiItemFlags_Inputable));\par
12674 \par
12675     {\cf20 // Always store in NavMoveResultLocal (unlike directional request which uses NavMoveResultOther on sibling/flattened windows)}\par
12676     ImGuiNavItemData* result = &g.NavMoveResultLocal;\par
12677     {\cf19 if} (g.NavTabbingDir == +1)\par
12678     \{\par
12679         {\cf20 // Tab Forward or SetKeyboardFocusHere() with >= 0}\par
12680         {\cf19 if} (can_stop && g.NavTabbingResultFirst.ID == 0)\par
12681             NavApplyItemToResult(&g.NavTabbingResultFirst);\par
12682         {\cf19 if} (can_stop && g.NavTabbingCounter > 0 && --g.NavTabbingCounter == 0)\par
12683             NavMoveRequestResolveWithLastItem(result);\par
12684         {\cf19 else} {\cf19 if} (g.NavId == {\cf18 id})\par
12685             g.NavTabbingCounter = 1;\par
12686     \}\par
12687     {\cf19 else} {\cf19 if} (g.NavTabbingDir == -1)\par
12688     \{\par
12689         {\cf20 // Tab Backward}\par
12690         {\cf19 if} (g.NavId == {\cf18 id})\par
12691         \{\par
12692             {\cf19 if} (result->ID)\par
12693             \{\par
12694                 g.NavMoveScoringItems = {\cf17 false};\par
12695                 NavUpdateAnyRequestFlag();\par
12696             \}\par
12697         \}\par
12698         {\cf19 else} {\cf19 if} (can_stop)\par
12699         \{\par
12700             {\cf20 // Keep applying until reaching NavId}\par
12701             NavApplyItemToResult(result);\par
12702         \}\par
12703     \}\par
12704     {\cf19 else} {\cf19 if} (g.NavTabbingDir == 0)\par
12705     \{\par
12706         {\cf19 if} (can_stop && g.NavId == {\cf18 id})\par
12707             NavMoveRequestResolveWithLastItem(result);\par
12708         {\cf19 if} (can_stop && g.NavTabbingResultFirst.ID == 0) {\cf20 // Tab init}\par
12709             NavApplyItemToResult(&g.NavTabbingResultFirst);\par
12710     \}\par
12711 \}\par
