01594 {\cf18 void} ImGuiIO::AddKeyAnalogEvent(ImGuiKey key, {\cf18 bool} down, {\cf18 float} analog_value)\par
01595 \{\par
01596     {\cf20 //if (e->Down) \{ IMGUI_DEBUG_LOG_IO("AddKeyEvent() Key='%s' %d, NativeKeycode = %d, NativeScancode = %d\\n", ImGui::GetKeyName(e->Key), e->Down, e->NativeKeycode, e->NativeScancode); \}}\par
