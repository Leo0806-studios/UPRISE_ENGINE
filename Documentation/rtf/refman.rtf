18992 {\cf20 // Make sure to use the ImGuiDockNodeFlags_DockSpace flag to create a dockspace node! Otherwise this will create a floating node!}\par
18993 {\cf20 // - Floating node: you can then call DockBuilderSetNodePos()/DockBuilderSetNodeSize() to position and size the floating node.}\par
18994 {\cf20 // - Dockspace node: calling DockBuilderSetNodePos() is unnecessary.}\par
18995 {\cf20 // - If you intend to split a node immediately after creation using DockBuilderSplitNode(), make sure to call DockBuilderSetNodeSize() beforehand!}\par
18996 {\cf20 //   For various reason, the splitting code currently needs a base size otherwise space may not be allocated as precisely as you would expect.}\par
18997 {\cf20 // - Use (id == 0) to let the system allocate a node identifier.}\par
18998 {\cf20 // - Existing node with a same id will be removed.}\par
18999 ImGuiID ImGui::DockBuilderAddNode(ImGuiID node_id, ImGuiDockNodeFlags flags)\par
19000 \{\par
19001     ImGuiContext& g = *GImGui; IM_UNUSED(g);\par
19002     IMGUI_DEBUG_LOG_DOCKING({\cf22 "[docking] DockBuilderAddNode 0x%08X flags=%08X\\n"}, node_id, flags);\par
19003 \par
19004     {\cf19 if} (node_id != 0)\par
19005         DockBuilderRemoveNode(node_id);\par
19006 \par
19007     ImGuiDockNode* node = NULL;\par
19008     {\cf19 if} (flags & ImGuiDockNodeFlags_DockSpace)\par
19009     \{\par
19010         DockSpace(node_id, ImVec2(0, 0), (flags & ~ImGuiDockNodeFlags_DockSpace) | ImGuiDockNodeFlags_KeepAliveOnly);\par
19011         node = DockContextFindNodeByID(&g, node_id);\par
19012     \}\par
19013     {\cf19 else}\par
19014     \{\par
19015         node = DockContextAddNode(&g, node_id);\par
19016         node->SetLocalFlags(flags);\par
19017     \}\par
19018     node->LastFrameAlive = g.FrameCount;   {\cf20 // Set this otherwise BeginDocked will undock during the same frame.}\par
19019     {\cf19 return} node->ID;\par
19020 \}\par
