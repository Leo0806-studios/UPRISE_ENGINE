09948 {\cf17 static} {\cf18 void} ImGui::UpdateMouseInputs()\par
09949 \{\par
09950     ImGuiContext& g = *GImGui;\par
09951     ImGuiIO& io = g.IO;\par
09952 \par
09953     {\cf20 // Mouse Wheel swapping flag}\par
09954     {\cf20 // As a standard behavior holding SHIFT while using Vertical Mouse Wheel triggers Horizontal scroll instead}\par
09955     {\cf20 // - We avoid doing it on OSX as it the OS input layer handles this already.}\par
09956     {\cf20 // - FIXME: However this means when running on OSX over Emscripten, Shift+WheelY will incur two swapping (1 in OS, 1 here), canceling the feature.}\par
09957     {\cf20 // - FIXME: When we can distinguish e.g. touchpad scroll events from mouse ones, we'll set this accordingly based on input source.}\par
09958     io.MouseWheelRequestAxisSwap = io.KeyShift && !io.ConfigMacOSXBehaviors;\par
09959 \par
09960     {\cf20 // Round mouse position to avoid spreading non-rounded position (e.g. UpdateManualResize doesn't support them well)}\par
09961     {\cf19 if} (IsMousePosValid(&io.MousePos))\par
09962         io.MousePos = g.MouseLastValidPos = ImFloor(io.MousePos);\par
09963 \par
09964     {\cf20 // If mouse just appeared or disappeared (usually denoted by -FLT_MAX components) we cancel out movement in MouseDelta}\par
09965     {\cf19 if} (IsMousePosValid(&io.MousePos) && IsMousePosValid(&io.MousePosPrev))\par
09966         io.MouseDelta = io.MousePos - io.MousePosPrev;\par
09967     {\cf19 else}\par
09968         io.MouseDelta = ImVec2(0.0f, 0.0f);\par
09969 \par
09970     {\cf20 // Update stationary timer.}\par
09971     {\cf20 // FIXME: May need to rework again to have some tolerance for occasional small movement, while being functional on high-framerates.}\par
09972     {\cf17 const} {\cf18 float} mouse_stationary_threshold = (io.MouseSource == ImGuiMouseSource_Mouse) ? 2.0f : 3.0f; {\cf20 // Slightly higher threshold for ImGuiMouseSource_TouchScreen/ImGuiMouseSource_Pen, may need rework.}\par
09973     {\cf17 const} {\cf18 bool} mouse_stationary = (ImLengthSqr(io.MouseDelta) <= mouse_stationary_threshold * mouse_stationary_threshold);\par
09974     g.MouseStationaryTimer = mouse_stationary ? (g.MouseStationaryTimer + io.DeltaTime) : 0.0f;\par
09975     {\cf20 //IMGUI_DEBUG_LOG("%.4f\\n", g.MouseStationaryTimer);}\par
09976 \par
09977     {\cf20 // If mouse moved we re-enable mouse hovering in case it was disabled by gamepad/keyboard. In theory should use a >0.0f threshold but would need to reset in everywhere we set this to true.}\par
09978     {\cf19 if} (io.MouseDelta.x != 0.0f || io.MouseDelta.y != 0.0f)\par
09979         g.NavDisableMouseHover = {\cf17 false};\par
09980 \par
09981     {\cf19 for} ({\cf18 int} i = 0; i < IM_ARRAYSIZE(io.MouseDown); i++)\par
09982     \{\par
09983         io.MouseClicked[i] = io.MouseDown[i] && io.MouseDownDuration[i] < 0.0f;\par
09984         io.MouseClickedCount[i] = 0; {\cf20 // Will be filled below}\par
09985         io.MouseReleased[i] = !io.MouseDown[i] && io.MouseDownDuration[i] >= 0.0f;\par
09986         io.MouseDownDurationPrev[i] = io.MouseDownDuration[i];\par
09987         io.MouseDownDuration[i] = io.MouseDown[i] ? (io.MouseDownDuration[i] < 0.0f ? 0.0f : io.MouseDownDuration[i] + io.DeltaTime) : -1.0f;\par
09988         {\cf19 if} (io.MouseClicked[i])\par
09989         \{\par
09990             {\cf18 bool} is_repeated_click = {\cf17 false};\par
09991             {\cf19 if} (({\cf18 float})(g.Time - io.MouseClickedTime[i]) < io.MouseDoubleClickTime)\par
09992             \{\par
09993                 ImVec2 delta_from_click_pos = IsMousePosValid(&io.MousePos) ? (io.MousePos - io.MouseClickedPos[i]) : ImVec2(0.0f, 0.0f);\par
09994                 {\cf19 if} (ImLengthSqr(delta_from_click_pos) < io.MouseDoubleClickMaxDist * io.MouseDoubleClickMaxDist)\par
09995                     is_repeated_click = {\cf17 true};\par
09996             \}\par
09997             {\cf19 if} (is_repeated_click)\par
09998                 io.MouseClickedLastCount[i]++;\par
09999             {\cf19 else}\par
10000                 io.MouseClickedLastCount[i] = 1;\par
10001             io.MouseClickedTime[i] = g.Time;\par
10002             io.MouseClickedPos[i] = io.MousePos;\par
10003             io.MouseClickedCount[i] = io.MouseClickedLastCount[i];\par
10004             io.MouseDragMaxDistanceAbs[i] = ImVec2(0.0f, 0.0f);\par
10005             io.MouseDragMaxDistanceSqr[i] = 0.0f;\par
10006         \}\par
10007         {\cf19 else} {\cf19 if} (io.MouseDown[i])\par
10008         \{\par
10009             {\cf20 // Maintain the maximum distance we reaching from the initial click position, which is used with dragging threshold}\par
10010             ImVec2 delta_from_click_pos = IsMousePosValid(&io.MousePos) ? (io.MousePos - io.MouseClickedPos[i]) : ImVec2(0.0f, 0.0f);\par
10011             io.MouseDragMaxDistanceSqr[i] = ImMax(io.MouseDragMaxDistanceSqr[i], ImLengthSqr(delta_from_click_pos));\par
10012             io.MouseDragMaxDistanceAbs[i].x = ImMax(io.MouseDragMaxDistanceAbs[i].x, delta_from_click_pos.x < 0.0f ? -delta_from_click_pos.x : delta_from_click_pos.x);\par
10013             io.MouseDragMaxDistanceAbs[i].y = ImMax(io.MouseDragMaxDistanceAbs[i].y, delta_from_click_pos.y < 0.0f ? -delta_from_click_pos.y : delta_from_click_pos.y);\par
10014         \}\par
10015 \par
10016         {\cf20 // We provide io.MouseDoubleClicked[] as a legacy service}\par
10017         io.MouseDoubleClicked[i] = (io.MouseClickedCount[i] == 2);\par
10018 \par
10019         {\cf20 // Clicking any mouse button reactivate mouse hovering which may have been deactivated by gamepad/keyboard navigation}\par
10020         {\cf19 if} (io.MouseClicked[i])\par
10021             g.NavDisableMouseHover = {\cf17 false};\par
10022     \}\par
10023 \}\par
