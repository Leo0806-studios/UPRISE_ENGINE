00660     {\cf19 if} (last_enable_depth_test) glEnable(GL_DEPTH_TEST); {\cf19 else} glDisable(GL_DEPTH_TEST);\par
00661     {\cf19 if} (last_enable_stencil_test) glEnable(GL_STENCIL_TEST); {\cf19 else} glDisable(GL_STENCIL_TEST);\par
00662     {\cf19 if} (last_enable_scissor_test) glEnable(GL_SCISSOR_TEST); {\cf19 else} glDisable(GL_SCISSOR_TEST);\par
00663 {\cf21 #ifdef IMGUI_IMPL_OPENGL_MAY_HAVE_PRIMITIVE_RESTART}\par
00664     {\cf19 if} (bd->GlVersion >= 310) \{ {\cf19 if} (last_enable_primitive_restart) glEnable(GL_PRIMITIVE_RESTART); {\cf19 else} glDisable(GL_PRIMITIVE_RESTART); \}\par
