03720 {\cf18 void} ImGui::RenderMouseCursor(ImVec2 base_pos, {\cf18 float} base_scale, ImGuiMouseCursor mouse_cursor, ImU32 col_fill, ImU32 col_border, ImU32 col_shadow)\par
03721 \{\par
03722     ImGuiContext& g = *GImGui;\par
03723     IM_ASSERT(mouse_cursor > ImGuiMouseCursor_None && mouse_cursor < ImGuiMouseCursor_COUNT);\par
03724     ImFontAtlas* font_atlas = g.DrawListSharedData.Font->ContainerAtlas;\par
03725     {\cf19 for} (ImGuiViewportP* viewport : g.Viewports)\par
03726     \{\par
03727         {\cf20 // We scale cursor with current viewport/monitor, however Windows 10 for its own hardware cursor seems to be using a different scale factor.}\par
03728         ImVec2 offset, size, uv[4];\par
03729         {\cf19 if} (!font_atlas->GetMouseCursorTexData(mouse_cursor, &offset, &size, &uv[0], &uv[2]))\par
03730             {\cf19 continue};\par
03731         {\cf17 const} ImVec2 pos = base_pos - offset;\par
03732         {\cf17 const} {\cf18 float} scale = base_scale * viewport->DpiScale;\par
03733         {\cf19 if} (!viewport->GetMainRect().Overlaps(ImRect(pos, pos + ImVec2(size.x + 2, size.y + 2) * scale)))\par
03734             {\cf19 continue};\par
03735         ImDrawList* draw_list = GetForegroundDrawList(viewport);\par
03736         ImTextureID tex_id = font_atlas->TexID;\par
03737         draw_list->PushTextureID(tex_id);\par
03738         draw_list->AddImage(tex_id, pos + ImVec2(1, 0) * scale, pos + (ImVec2(1, 0) + size) * scale, uv[2], uv[3], col_shadow);\par
03739         draw_list->AddImage(tex_id, pos + ImVec2(2, 0) * scale, pos + (ImVec2(2, 0) + size) * scale, uv[2], uv[3], col_shadow);\par
03740         draw_list->AddImage(tex_id, pos,                        pos + size * scale,                  uv[2], uv[3], col_border);\par
03741         draw_list->AddImage(tex_id, pos,                        pos + size * scale,                  uv[0], uv[1], col_fill);\par
03742         draw_list->PopTextureID();\par
03743     \}\par
03744 \}\par
