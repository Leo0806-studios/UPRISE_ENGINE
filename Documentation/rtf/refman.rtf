11458 \}\par
11459 \par
11460 {\cf20 // Scroll to keep newly navigated item fully into view}\par
11461 ImVec2 ImGui::ScrollToRectEx(ImGuiWindow* window, {\cf17 const} ImRect& item_rect, ImGuiScrollFlags flags)\par
11462 \{\par
11463     ImGuiContext& g = *GImGui;\par
11464     ImRect scroll_rect(window->InnerRect.Min - ImVec2(1, 1), window->InnerRect.Max + ImVec2(1, 1));\par
11465     scroll_rect.Min.x = ImMin(scroll_rect.Min.x + window->DecoInnerSizeX1, scroll_rect.Max.x);\par
11466     scroll_rect.Min.y = ImMin(scroll_rect.Min.y + window->DecoInnerSizeY1, scroll_rect.Max.y);\par
11467     {\cf20 //GetForegroundDrawList(window)->AddRect(item_rect.Min, item_rect.Max, IM_COL32(255,0,0,255), 0.0f, 0, 5.0f); // [DEBUG]}\par
11468     {\cf20 //GetForegroundDrawList(window)->AddRect(scroll_rect.Min, scroll_rect.Max, IM_COL32_WHITE); // [DEBUG]}\par
11469 \par
11470     {\cf20 // Check that only one behavior is selected per axis}\par
11471     IM_ASSERT((flags & ImGuiScrollFlags_MaskX_) == 0 || ImIsPowerOfTwo(flags & ImGuiScrollFlags_MaskX_));\par
11472     IM_ASSERT((flags & ImGuiScrollFlags_MaskY_) == 0 || ImIsPowerOfTwo(flags & ImGuiScrollFlags_MaskY_));\par
11473 \par
11474     {\cf20 // Defaults}\par
11475     ImGuiScrollFlags in_flags = flags;\par
11476     {\cf19 if} ((flags & ImGuiScrollFlags_MaskX_) == 0 && window->ScrollbarX)\par
11477         flags |= ImGuiScrollFlags_KeepVisibleEdgeX;\par
11478     {\cf19 if} ((flags & ImGuiScrollFlags_MaskY_) == 0)\par
11479         flags |= window->Appearing ? ImGuiScrollFlags_AlwaysCenterY : ImGuiScrollFlags_KeepVisibleEdgeY;\par
11480 \par
11481     {\cf17 const} {\cf18 bool} fully_visible_x = item_rect.Min.x >= scroll_rect.Min.x && item_rect.Max.x <= scroll_rect.Max.x;\par
11482     {\cf17 const} {\cf18 bool} fully_visible_y = item_rect.Min.y >= scroll_rect.Min.y && item_rect.Max.y <= scroll_rect.Max.y;\par
11483     {\cf17 const} {\cf18 bool} can_be_fully_visible_x = (item_rect.GetWidth() + g.Style.ItemSpacing.x * 2.0f) <= scroll_rect.GetWidth() || (window->AutoFitFramesX > 0) || (window->Flags & ImGuiWindowFlags_AlwaysAutoResize) != 0;\par
11484     {\cf17 const} {\cf18 bool} can_be_fully_visible_y = (item_rect.GetHeight() + g.Style.ItemSpacing.y * 2.0f) <= scroll_rect.GetHeight() || (window->AutoFitFramesY > 0) || (window->Flags & ImGuiWindowFlags_AlwaysAutoResize) != 0;\par
11485 \par
11486     {\cf19 if} ((flags & ImGuiScrollFlags_KeepVisibleEdgeX) && !fully_visible_x)\par
11487     \{\par
11488         {\cf19 if} (item_rect.Min.x < scroll_rect.Min.x || !can_be_fully_visible_x)\par
11489             SetScrollFromPosX(window, item_rect.Min.x - g.Style.ItemSpacing.x - window->Pos.x, 0.0f);\par
11490         {\cf19 else} {\cf19 if} (item_rect.Max.x >= scroll_rect.Max.x)\par
11491             SetScrollFromPosX(window, item_rect.Max.x + g.Style.ItemSpacing.x - window->Pos.x, 1.0f);\par
11492     \}\par
11493     {\cf19 else} {\cf19 if} (((flags & ImGuiScrollFlags_KeepVisibleCenterX) && !fully_visible_x) || (flags & ImGuiScrollFlags_AlwaysCenterX))\par
11494     \{\par
11495         {\cf19 if} (can_be_fully_visible_x)\par
11496             SetScrollFromPosX(window, ImTrunc((item_rect.Min.x + item_rect.Max.x) * 0.5f) - window->Pos.x, 0.5f);\par
11497         {\cf19 else}\par
11498             SetScrollFromPosX(window, item_rect.Min.x - window->Pos.x, 0.0f);\par
11499     \}\par
11500 \par
11501     {\cf19 if} ((flags & ImGuiScrollFlags_KeepVisibleEdgeY) && !fully_visible_y)\par
11502     \{\par
11503         {\cf19 if} (item_rect.Min.y < scroll_rect.Min.y || !can_be_fully_visible_y)\par
11504             SetScrollFromPosY(window, item_rect.Min.y - g.Style.ItemSpacing.y - window->Pos.y, 0.0f);\par
11505         {\cf19 else} {\cf19 if} (item_rect.Max.y >= scroll_rect.Max.y)\par
11506             SetScrollFromPosY(window, item_rect.Max.y + g.Style.ItemSpacing.y - window->Pos.y, 1.0f);\par
11507     \}\par
11508     {\cf19 else} {\cf19 if} (((flags & ImGuiScrollFlags_KeepVisibleCenterY) && !fully_visible_y) || (flags & ImGuiScrollFlags_AlwaysCenterY))\par
11509     \{\par
11510         {\cf19 if} (can_be_fully_visible_y)\par
11511             SetScrollFromPosY(window, ImTrunc((item_rect.Min.y + item_rect.Max.y) * 0.5f) - window->Pos.y, 0.5f);\par
11512         {\cf19 else}\par
11513             SetScrollFromPosY(window, item_rect.Min.y - window->Pos.y, 0.0f);\par
11514     \}\par
11515 \par
11516     ImVec2 next_scroll = CalcNextScrollFromScrollTargetAndClamp(window);\par
11517     ImVec2 delta_scroll = next_scroll - window->Scroll;\par
11518 \par
11519     {\cf20 // Also scroll parent window to keep us into view if necessary}\par
11520     {\cf19 if} (!(flags & ImGuiScrollFlags_NoScrollParent) && (window->Flags & ImGuiWindowFlags_ChildWindow))\par
11521     \{\par
11522         {\cf20 // FIXME-SCROLL: May be an option?}\par
11523         {\cf19 if} ((in_flags & (ImGuiScrollFlags_AlwaysCenterX | ImGuiScrollFlags_KeepVisibleCenterX)) != 0)\par
11524             in_flags = (in_flags & ~ImGuiScrollFlags_MaskX_) | ImGuiScrollFlags_KeepVisibleEdgeX;\par
11525         {\cf19 if} ((in_flags & (ImGuiScrollFlags_AlwaysCenterY | ImGuiScrollFlags_KeepVisibleCenterY)) != 0)\par
11526             in_flags = (in_flags & ~ImGuiScrollFlags_MaskY_) | ImGuiScrollFlags_KeepVisibleEdgeY;\par
11527         delta_scroll += ScrollToRectEx(window->ParentWindow, ImRect(item_rect.Min - delta_scroll, item_rect.Max - delta_scroll), in_flags);\par
11528     \}\par
11529 \par
11530     {\cf19 return} delta_scroll;\par
11531 \}\par
