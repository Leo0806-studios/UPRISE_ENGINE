02399     {\cf19 while} ((!in_text_end || in_text < in_text_end) && *in_text)\par
02400     \{\par
02401         {\cf18 unsigned} {\cf18 int} c;\par
02402         in_text += ImTextCharFromUtf8(&c, in_text, in_text_end);\par
02403         char_count++;\par
