21204 {\cf20 // [DEBUG] Display contents of ImDrawList}\par
21205 {\cf20 // Note that both 'window' and 'viewport' may be NULL here. Viewport is generally null of destroyed popups which previously owned a viewport.}\par
21206 {\cf18 void} ImGui::DebugNodeDrawList(ImGuiWindow* window, ImGuiViewportP* viewport, {\cf17 const} ImDrawList* draw_list, {\cf17 const} {\cf18 char}* label)\par
21207 \{\par
21208     ImGuiContext& g = *GImGui;\par
21209     ImGuiMetricsConfig* cfg = &g.DebugMetricsConfig;\par
21210     {\cf18 int} cmd_count = draw_list->CmdBuffer.Size;\par
21211     {\cf19 if} (cmd_count > 0 && draw_list->CmdBuffer.back().ElemCount == 0 && draw_list->CmdBuffer.back().UserCallback == NULL)\par
21212         cmd_count--;\par
21213     {\cf18 bool} node_open = TreeNode(draw_list, {\cf22 "%s: '%s' %d vtx, %d indices, %d cmds"}, label, draw_list->_OwnerName ? draw_list->_OwnerName : {\cf22 ""}, draw_list->VtxBuffer.Size, draw_list->IdxBuffer.Size, cmd_count);\par
21214     {\cf19 if} (draw_list == GetWindowDrawList())\par
21215     \{\par
21216         SameLine();\par
21217         TextColored(ImVec4(1.0f, 0.4f, 0.4f, 1.0f), {\cf22 "CURRENTLY APPENDING"}); {\cf20 // Can't display stats for active draw list! (we don't have the data double-buffered)}\par
21218         {\cf19 if} (node_open)\par
21219             TreePop();\par
21220         {\cf19 return};\par
21221     \}\par
21222 \par
21223     ImDrawList* fg_draw_list = viewport ? GetForegroundDrawList(viewport) : NULL; {\cf20 // Render additional visuals into the top-most draw list}\par
21224     {\cf19 if} (window && IsItemHovered() && fg_draw_list)\par
21225         fg_draw_list->AddRect(window->Pos, window->Pos + window->Size, IM_COL32(255, 255, 0, 255));\par
21226     {\cf19 if} (!node_open)\par
21227         {\cf19 return};\par
21228 \par
21229     {\cf19 if} (window && !window->WasActive)\par
21230         TextDisabled({\cf22 "Warning: owning Window is inactive. This DrawList is not being rendered!"});\par
21231 \par
21232     {\cf19 for} ({\cf17 const} ImDrawCmd* pcmd = draw_list->CmdBuffer.Data; pcmd < draw_list->CmdBuffer.Data + cmd_count; pcmd++)\par
21233     \{\par
21234         {\cf19 if} (pcmd->UserCallback)\par
21235         \{\par
21236             BulletText({\cf22 "Callback %p, user_data %p"}, pcmd->UserCallback, pcmd->UserCallbackData);\par
21237             {\cf19 continue};\par
21238         \}\par
21239 \par
21240         {\cf18 char} texid_desc[20];\par
21241         FormatTextureIDForDebugDisplay(texid_desc, IM_ARRAYSIZE(texid_desc), pcmd->TextureId);\par
21242         {\cf18 char} buf[300];\par
21243         ImFormatString(buf, IM_ARRAYSIZE(buf), {\cf22 "DrawCmd:%5d tris, Tex %s, ClipRect (%4.0f,%4.0f)-(%4.0f,%4.0f)"},\par
21244             pcmd->ElemCount / 3, texid_desc, pcmd->ClipRect.x, pcmd->ClipRect.y, pcmd->ClipRect.z, pcmd->ClipRect.w);\par
21245         {\cf18 bool} pcmd_node_open = TreeNode(({\cf18 void}*)(pcmd - draw_list->CmdBuffer.begin()), {\cf22 "%s"}, buf);\par
21246         {\cf19 if} (IsItemHovered() && (cfg->ShowDrawCmdMesh || cfg->ShowDrawCmdBoundingBoxes) && fg_draw_list)\par
21247             DebugNodeDrawCmdShowMeshAndBoundingBox(fg_draw_list, draw_list, pcmd, cfg->ShowDrawCmdMesh, cfg->ShowDrawCmdBoundingBoxes);\par
21248         {\cf19 if} (!pcmd_node_open)\par
21249             {\cf19 continue};\par
21250 \par
21251         {\cf20 // Calculate approximate coverage area (touched pixel count)}\par
21252         {\cf20 // This will be in pixels squared as long there's no post-scaling happening to the renderer output.}\par
21253         {\cf17 const} ImDrawIdx* idx_buffer = (draw_list->IdxBuffer.Size > 0) ? draw_list->IdxBuffer.Data : NULL;\par
21254         {\cf17 const} ImDrawVert* vtx_buffer = draw_list->VtxBuffer.Data + pcmd->VtxOffset;\par
21255         {\cf18 float} total_area = 0.0f;\par
21256         {\cf19 for} ({\cf18 unsigned} {\cf18 int} idx_n = pcmd->IdxOffset; idx_n < pcmd->IdxOffset + pcmd->ElemCount; )\par
21257         \{\par
21258             ImVec2 triangle[3];\par
21259             {\cf19 for} ({\cf18 int} n = 0; n < 3; n++, idx_n++)\par
21260                 triangle[n] = vtx_buffer[idx_buffer ? idx_buffer[idx_n] : idx_n].pos;\par
21261             total_area += ImTriangleArea(triangle[0], triangle[1], triangle[2]);\par
21262         \}\par
21263 \par
21264         {\cf20 // Display vertex information summary. Hover to get all triangles drawn in wire-frame}\par
21265         ImFormatString(buf, IM_ARRAYSIZE(buf), {\cf22 "Mesh: ElemCount: %d, VtxOffset: +%d, IdxOffset: +%d, Area: ~%0.f px"}, pcmd->ElemCount, pcmd->VtxOffset, pcmd->IdxOffset, total_area);\par
21266         Selectable(buf);\par
21267         {\cf19 if} (IsItemHovered() && fg_draw_list)\par
21268             DebugNodeDrawCmdShowMeshAndBoundingBox(fg_draw_list, draw_list, pcmd, {\cf17 true}, {\cf17 false});\par
21269 \par
21270         {\cf20 // Display individual triangles/vertices. Hover on to get the corresponding triangle highlighted.}\par
21271         ImGuiListClipper clipper;\par
21272         clipper.Begin(pcmd->ElemCount / 3); {\cf20 // Manually coarse clip our print out of individual vertices to save CPU, only items that may be visible.}\par
21273         {\cf19 while} (clipper.Step())\par
21274             {\cf19 for} ({\cf18 int} prim = clipper.DisplayStart, idx_i = pcmd->IdxOffset + clipper.DisplayStart * 3; prim < clipper.DisplayEnd; prim++)\par
21275             \{\par
21276                 {\cf18 char}* buf_p = buf, * buf_end = buf + IM_ARRAYSIZE(buf);\par
21277                 ImVec2 triangle[3];\par
21278                 {\cf19 for} ({\cf18 int} n = 0; n < 3; n++, idx_i++)\par
21279                 \{\par
21280                     {\cf17 const} ImDrawVert& v = vtx_buffer[idx_buffer ? idx_buffer[idx_i] : idx_i];\par
21281                     triangle[n] = v.pos;\par
21282                     buf_p += ImFormatString(buf_p, buf_end - buf_p, {\cf22 "%s %04d: pos (%8.2f,%8.2f), uv (%.6f,%.6f), col %08X\\n"},\par
21283                         (n == 0) ? {\cf22 "Vert:"} : {\cf22 "     "}, idx_i, v.pos.x, v.pos.y, v.uv.x, v.uv.y, v.col);\par
21284                 \}\par
21285 \par
21286                 Selectable(buf, {\cf17 false});\par
21287                 {\cf19 if} (fg_draw_list && IsItemHovered())\par
21288                 \{\par
21289                     ImDrawListFlags backup_flags = fg_draw_list->Flags;\par
21290                     fg_draw_list->Flags &= ~ImDrawListFlags_AntiAliasedLines; {\cf20 // Disable AA on triangle outlines is more readable for very large and thin triangles.}\par
21291                     fg_draw_list->AddPolyline(triangle, 3, IM_COL32(255, 255, 0, 255), ImDrawFlags_Closed, 1.0f);\par
21292                     fg_draw_list->Flags = backup_flags;\par
21293                 \}\par
21294             \}\par
21295         TreePop();\par
21296     \}\par
21297     TreePop();\par
21298 \}\par
21299 \par
21300 {\cf20 // [DEBUG] Display mesh/aabb of a ImDrawCmd}\par
21301 {\cf18 void} ImGui::DebugNodeDrawCmdShowMeshAndBoundingBox(ImDrawList* out_draw_list, {\cf17 const} ImDrawList* draw_list, {\cf17 const} ImDrawCmd* draw_cmd, {\cf18 bool} show_mesh, {\cf18 bool} show_aabb)\par
21302 \{\par
21303     IM_ASSERT(show_mesh || show_aabb);\par
21304 \par
21305     {\cf20 // Draw wire-frame version of all triangles}\par
21306     ImRect clip_rect = draw_cmd->ClipRect;\par
21307     ImRect vtxs_rect(FLT_MAX, FLT_MAX, -FLT_MAX, -FLT_MAX);\par
21308     ImDrawListFlags backup_flags = out_draw_list->Flags;\par
21309     out_draw_list->Flags &= ~ImDrawListFlags_AntiAliasedLines; {\cf20 // Disable AA on triangle outlines is more readable for very large and thin triangles.}\par
21310     {\cf19 for} ({\cf18 unsigned} {\cf18 int} idx_n = draw_cmd->IdxOffset, idx_end = draw_cmd->IdxOffset + draw_cmd->ElemCount; idx_n < idx_end; )\par
21311     \{\par
21312         ImDrawIdx* idx_buffer = (draw_list->IdxBuffer.Size > 0) ? draw_list->IdxBuffer.Data : NULL; {\cf20 // We don't hold on those pointers past iterations as ->AddPolyline() may invalidate them if out_draw_list==draw_list}\par
21313         ImDrawVert* vtx_buffer = draw_list->VtxBuffer.Data + draw_cmd->VtxOffset;\par
21314 \par
21315         ImVec2 triangle[3];\par
21316         {\cf19 for} ({\cf18 int} n = 0; n < 3; n++, idx_n++)\par
21317             vtxs_rect.Add((triangle[n] = vtx_buffer[idx_buffer ? idx_buffer[idx_n] : idx_n].pos));\par
21318         {\cf19 if} (show_mesh)\par
21319             out_draw_list->AddPolyline(triangle, 3, IM_COL32(255, 255, 0, 255), ImDrawFlags_Closed, 1.0f); {\cf20 // In yellow: mesh triangles}\par
21320     \}\par
21321     {\cf20 // Draw bounding boxes}\par
21322     {\cf19 if} (show_aabb)\par
21323     \{\par
21324         out_draw_list->AddRect(ImTrunc(clip_rect.Min), ImTrunc(clip_rect.Max), IM_COL32(255, 0, 255, 255)); {\cf20 // In pink: clipping rectangle submitted to GPU}\par
21325         out_draw_list->AddRect(ImTrunc(vtxs_rect.Min), ImTrunc(vtxs_rect.Max), IM_COL32(0, 255, 255, 255)); {\cf20 // In cyan: bounding box of triangles}\par
21326     \}\par
21327     out_draw_list->Flags = backup_flags;\par
21328 \}\par
21329 \par
21330 {\cf20 // [DEBUG] Display details for a single font, called by ShowStyleEditor().}\par
21331 {\cf18 void} ImGui::DebugNodeFont(ImFont* font)\par
21332 \{\par
21333     {\cf18 bool} opened = TreeNode(font, {\cf22 "Font: \\"%s\\"\\n%.2f px, %d glyphs, %d file(s)"},\par
21334         font->ConfigData ? font->ConfigData[0].Name : {\cf22 ""}, font->FontSize, font->Glyphs.Size, font->ConfigDataCount);\par
21335     SameLine();\par
21336     {\cf19 if} (SmallButton({\cf22 "Set as default"}))\par
21337         GetIO().FontDefault = font;\par
21338     {\cf19 if} (!opened)\par
21339         {\cf19 return};\par
21340 \par
21341     {\cf20 // Display preview text}\par
21342     PushFont(font);\par
21343     Text({\cf22 "The quick brown fox jumps over the lazy dog"});\par
21344     PopFont();\par
21345 \par
21346     {\cf20 // Display details}\par
21347     SetNextItemWidth(GetFontSize() * 8);\par
21348     DragFloat({\cf22 "Font scale"}, &font->Scale, 0.005f, 0.3f, 2.0f, {\cf22 "%.1f"});\par
21349     SameLine(); MetricsHelpMarker(\par
21350         {\cf22 "Note that the default embedded font is NOT meant to be scaled.\\n\\n"}\par
21351         {\cf22 "Font are currently rendered into bitmaps at a given size at the time of building the atlas. "}\par
21352         {\cf22 "You may oversample them to get some flexibility with scaling. "}\par
21353         {\cf22 "You can also render at multiple sizes and select which one to use at runtime.\\n\\n"}\par
21354         {\cf22 "(Glimmer of hope: the atlas system will be rewritten in the future to make scaling more flexible.)"});\par
21355     Text({\cf22 "Ascent: %f, Descent: %f, Height: %f"}, font->Ascent, font->Descent, font->Ascent - font->Descent);\par
21356     {\cf18 char} c_str[5];\par
21357     Text({\cf22 "Fallback character: '%s' (U+%04X)"}, ImTextCharToUtf8(c_str, font->FallbackChar), font->FallbackChar);\par
21358     Text({\cf22 "Ellipsis character: '%s' (U+%04X)"}, ImTextCharToUtf8(c_str, font->EllipsisChar), font->EllipsisChar);\par
21359     {\cf17 const} {\cf18 int} surface_sqrt = (int)ImSqrt(({\cf18 float})font->MetricsTotalSurface);\par
21360     Text({\cf22 "Texture Area: about %d px ~%dx%d px"}, font->MetricsTotalSurface, surface_sqrt, surface_sqrt);\par
21361     {\cf19 for} ({\cf18 int} config_i = 0; config_i < font->ConfigDataCount; config_i++)\par
21362         {\cf19 if} (font->ConfigData)\par
21363             {\cf19 if} ({\cf17 const} ImFontConfig* cfg = &font->ConfigData[config_i])\par
21364                 BulletText({\cf22 "Input %d: \\'%s\\', Oversample: (%d,%d), PixelSnapH: %d, Offset: (%.1f,%.1f)"},\par
21365                     config_i, cfg->Name, cfg->OversampleH, cfg->OversampleV, cfg->PixelSnapH, cfg->GlyphOffset.x, cfg->GlyphOffset.y);\par
21366 \par
21367     {\cf20 // Display all glyphs of the fonts in separate pages of 256 characters}\par
21368     {\cf19 if} (TreeNode({\cf22 "Glyphs"}, {\cf22 "Glyphs (%d)"}, font->Glyphs.Size))\par
21369     \{\par
21370         ImDrawList* draw_list = GetWindowDrawList();\par
21371         {\cf17 const} ImU32 glyph_col = GetColorU32(ImGuiCol_Text);\par
21372         {\cf17 const} {\cf18 float} cell_size = font->FontSize * 1;\par
21373         {\cf17 const} {\cf18 float} cell_spacing = GetStyle().ItemSpacing.y;\par
21374         {\cf19 for} ({\cf18 unsigned} {\cf18 int} base = 0; base <= IM_UNICODE_CODEPOINT_MAX; base += 256)\par
21375         \{\par
21376             {\cf20 // Skip ahead if a large bunch of glyphs are not present in the font (test in chunks of 4k)}\par
21377             {\cf20 // This is only a small optimization to reduce the number of iterations when IM_UNICODE_MAX_CODEPOINT}\par
21378             {\cf20 // is large // (if ImWchar==ImWchar32 we will do at least about 272 queries here)}\par
21379             {\cf19 if} (!(base & 4095) && font->IsGlyphRangeUnused(base, base + 4095))\par
21380             \{\par
21381                 base += 4096 - 256;\par
21382                 {\cf19 continue};\par
21383             \}\par
21384 \par
21385             {\cf18 int} count = 0;\par
21386             {\cf19 for} ({\cf18 unsigned} {\cf18 int} n = 0; n < 256; n++)\par
21387                 {\cf19 if} (font->FindGlyphNoFallback((ImWchar)(base + n)))\par
21388                     count++;\par
21389             {\cf19 if} (count <= 0)\par
21390                 {\cf19 continue};\par
21391             {\cf19 if} (!TreeNode(({\cf18 void}*)(intptr_t)base, {\cf22 "U+%04X..U+%04X (%d %s)"}, base, base + 255, count, count > 1 ? {\cf22 "glyphs"} : {\cf22 "glyph"}))\par
21392                 continue;\par
21393 \par
21394             {\cf20 // Draw a 16x16 grid of glyphs}\par
21395             ImVec2 base_pos = GetCursorScreenPos();\par
21396             {\cf19 for} ({\cf18 unsigned} {\cf18 int} n = 0; n < 256; n++)\par
21397             \{\par
21398                 {\cf20 // We use ImFont::RenderChar as a shortcut because we don't have UTF-8 conversion functions}\par
21399                 {\cf20 // available here and thus cannot easily generate a zero-terminated UTF-8 encoded string.}\par
21400                 ImVec2 cell_p1(base_pos.x + (n % 16) * (cell_size + cell_spacing), base_pos.y + (n / 16) * (cell_size + cell_spacing));\par
21401                 ImVec2 cell_p2(cell_p1.x + cell_size, cell_p1.y + cell_size);\par
21402                 {\cf17 const} ImFontGlyph* glyph = font->FindGlyphNoFallback((ImWchar)(base + n));\par
21403                 draw_list->AddRect(cell_p1, cell_p2, glyph ? IM_COL32(255, 255, 255, 100) : IM_COL32(255, 255, 255, 50));\par
21404                 {\cf19 if} (!glyph)\par
21405                     {\cf19 continue};\par
21406                 font->RenderChar(draw_list, cell_size, cell_p1, glyph_col, (ImWchar)(base + n));\par
21407                 {\cf19 if} (IsMouseHoveringRect(cell_p1, cell_p2) && BeginTooltip())\par
