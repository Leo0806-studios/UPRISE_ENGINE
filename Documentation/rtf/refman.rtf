01230 {\cf20 // [SECTION] CONTEXT AND MEMORY ALLOCATORS}\par
01231 {\cf20 //-----------------------------------------------------------------------------}\par
01232 \par
01233 {\cf20 // DLL users:}\par
01234 {\cf20 // - Heaps and globals are not shared across DLL boundaries!}\par
01235 {\cf20 // - You will need to call SetCurrentContext() + SetAllocatorFunctions() for each static/DLL boundary you are calling from.}\par
01236 {\cf20 // - Same applies for hot-reloading mechanisms that are reliant on reloading DLL (note that many hot-reloading mechanisms work without DLL).}\par
01237 {\cf20 // - Using Dear ImGui via a shared library is not recommended, because of function call overhead and because we don't guarantee backward nor forward ABI compatibility.}\par
01238 {\cf20 // - Confused? In a debugger: add GImGui to your watch window and notice how its value changes depending on your current location (which DLL boundary you are in).}\par
01239 \par
01240 {\cf20 // Current context pointer. Implicitly used by all Dear ImGui functions. Always assumed to be != NULL.}\par
01241 {\cf20 // - ImGui::CreateContext() will automatically set this pointer if it is NULL.}\par
01242 {\cf20 //   Change to a different context by calling ImGui::SetCurrentContext().}\par
01243 {\cf20 // - Important: Dear ImGui functions are not thread-safe because of this pointer.}\par
01244 {\cf20 //   If you want thread-safety to allow N threads to access N different contexts:}\par
01245 {\cf20 //   - Change this variable to use thread local storage so each thread can refer to a different context, in your imconfig.h:}\par
01246 {\cf20 //         struct ImGuiContext;}\par
01247 {\cf20 //         extern thread_local ImGuiContext* MyImGuiTLS;}\par
01248 {\cf20 //         #define GImGui MyImGuiTLS}\par
01249 {\cf20 //     And then define MyImGuiTLS in one of your cpp files. Note that thread_local is a C++11 keyword, earlier C++ uses compiler-specific keyword.}\par
01250 {\cf20 //   - Future development aims to make this context pointer explicit to all calls. Also read https://github.com/ocornut/imgui/issues/586}\par
01251 {\cf20 //   - If you need a finite number of contexts, you may compile and use multiple instances of the ImGui code from a different namespace.}\par
01252 {\cf20 // - DLL users: read comments above.}\par
01253 {\cf21 #ifndef GImGui}\par
01254 ImGuiContext*   GImGui = NULL;\par
01255 {\cf21 #endif}\par
01256 \par
01257 {\cf20 // Memory Allocator functions. Use SetAllocatorFunctions() to change them.}\par
01258 {\cf20 // - You probably don't want to modify that mid-program, and if you use global/static e.g. ImVector<> instances you may need to keep them accessible during program destruction.}\par
01259 {\cf20 // - DLL users: read comments above.}\par
01260 {\cf21 #ifndef IMGUI_DISABLE_DEFAULT_ALLOCATORS}\par
01261 {\cf17 static} {\cf18 void}*   MallocWrapper({\cf18 size_t} size, {\cf18 void}* user_data)    \{ IM_UNUSED(user_data); {\cf19 return} malloc(size); \}\par
01262 {\cf17 static} {\cf18 void}    FreeWrapper({\cf18 void}* ptr, {\cf18 void}* user_data)        \{ IM_UNUSED(user_data); free(ptr); \}\par
01263 {\cf21 #else}\par
01264 {\cf17 static} {\cf18 void}*   MallocWrapper({\cf18 size_t} size, {\cf18 void}* user_data)    \{ IM_UNUSED(user_data); IM_UNUSED(size); IM_ASSERT(0); {\cf19 return} NULL; \}\par
01265 {\cf17 static} {\cf18 void}    FreeWrapper({\cf18 void}* ptr, {\cf18 void}* user_data)        \{ IM_UNUSED(user_data); IM_UNUSED(ptr); IM_ASSERT(0); \}\par
01266 {\cf21 #endif}\par
01267 {\cf17 static} ImGuiMemAllocFunc    GImAllocatorAllocFunc = MallocWrapper;\par
01268 {\cf17 static} ImGuiMemFreeFunc     GImAllocatorFreeFunc = FreeWrapper;\par
01269 {\cf17 static} {\cf18 void}*                GImAllocatorUserData = NULL;\par
