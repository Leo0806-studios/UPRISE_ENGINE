11766                 if (popup_data.PopupId == id)\par
11767                     return true;\par
11768             {\cf19 return} {\cf17 false};\par
11769         \}\par
11770         {\cf19 else}\par
11771         \{\par
11772             {\cf20 // Return true if the popup is open at the current BeginPopup() level of the popup stack (this is the most-common query)}\par
11773             {\cf19 return} g.OpenPopupStack.Size > g.BeginPopupStack.Size && g.OpenPopupStack[g.BeginPopupStack.Size].PopupId == id;\par
11774         \}\par
11775     \}\par
