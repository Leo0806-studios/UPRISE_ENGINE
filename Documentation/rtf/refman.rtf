00800     \{\par
00801         {\cf17 const} {\cf18 int} column_n = table->DisplayOrderToIndex[order_n];\par
00802         {\cf19 if} (column_n != order_n)\par
00803             table->IsDefaultDisplayOrder = {\cf17 false};\par
00804         ImGuiTableColumn* column = &table->Columns[column_n];\par
00805 \par
00806         {\cf20 // Clear column setup if not submitted by user. Currently we make it mandatory to call TableSetupColumn() every frame.}\par
00807         {\cf20 // It would easily work without but we're not ready to guarantee it since e.g. names need resubmission anyway.}\par
