05507 {\cf18 void} ImGui::Render()\par
05508 \{\par
05509     ImGuiContext& g = *GImGui;\par
05510     IM_ASSERT(g.Initialized);\par
05511 \par
05512     {\cf19 if} (g.FrameCountEnded != g.FrameCount)\par
05513         EndFrame();\par
05514     {\cf19 if} (g.FrameCountRendered == g.FrameCount)\par
05515         {\cf19 return};\par
05516     g.FrameCountRendered = g.FrameCount;\par
05517 \par
05518     g.IO.MetricsRenderWindows = 0;\par
