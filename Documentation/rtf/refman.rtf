00607                     pcmd->UserCallback(cmd_list, pcmd);\par
00608             \}\par
00609             {\cf19 else}\par
00610             \{\par
00611                 {\cf20 // Project scissor/clipping rectangles into framebuffer space}\par
00612                 ImVec2 clip_min((pcmd->ClipRect.x - clip_off.x) * clip_scale.x, (pcmd->ClipRect.y - clip_off.y) * clip_scale.y);\par
00613                 ImVec2 clip_max((pcmd->ClipRect.z - clip_off.x) * clip_scale.x, (pcmd->ClipRect.w - clip_off.y) * clip_scale.y);\par
00614                 {\cf19 if} (clip_max.x <= clip_min.x || clip_max.y <= clip_min.y)\par
00615                     {\cf19 continue};\par
00616 \par
00617                 {\cf20 // Apply scissor/clipping rectangle (Y is inverted in OpenGL)}\par
00618                 GL_CALL(glScissor(({\cf18 int})clip_min.x, ({\cf18 int})(({\cf18 float})fb_height - clip_max.y), ({\cf18 int})(clip_max.x - clip_min.x), ({\cf18 int})(clip_max.y - clip_min.y)));\par
00619 \par
00620                 {\cf20 // Bind texture, Draw}\par
00621                 GL_CALL(glBindTexture(GL_TEXTURE_2D, (GLuint)(intptr_t)pcmd->GetTexID()));\par
00622 {\cf21 #ifdef IMGUI_IMPL_OPENGL_MAY_HAVE_VTX_OFFSET}\par
00623                 {\cf19 if} (bd->GlVersion >= 320)\par
00624                     GL_CALL(glDrawElementsBaseVertex(GL_TRIANGLES, (GLsizei)pcmd->ElemCount, {\cf17 sizeof}(ImDrawIdx) == 2 ? GL_UNSIGNED_SHORT : GL_UNSIGNED_INT, ({\cf18 void}*)(intptr_t)(pcmd->IdxOffset * {\cf17 sizeof}(ImDrawIdx)), (GLint)pcmd->VtxOffset));\par
00625                 {\cf19 else}\par
