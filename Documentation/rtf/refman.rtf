00283 {\cf18 bool}    ImGui_ImplOpenGL3_Init({\cf17 const} {\cf18 char}* glsl_version)\par
00284 \{\par
00285     ImGuiIO& io = ImGui::GetIO();\par
00286     IMGUI_CHECKVERSION();\par
00287     IM_ASSERT(io.BackendRendererUserData == {\cf17 nullptr} && {\cf22 "Already initialized a renderer backend!"});\par
00288 \par
00289     {\cf20 // Initialize our loader}\par
00290 {\cf21 #if !defined(IMGUI_IMPL_OPENGL_ES2) && !defined(IMGUI_IMPL_OPENGL_ES3) && !defined(IMGUI_IMPL_OPENGL_LOADER_CUSTOM)}\par
00291     {\cf19 if} (imgl3wInit() != 0)\par
00292     \{\par
00293         fprintf(stderr, {\cf22 "Failed to initialize OpenGL loader!\\n"});\par
00294         {\cf19 return} {\cf17 false};\par
00295     \}\par
00296 {\cf21 #endif}\par
00297 \par
00298     {\cf20 // Setup backend capabilities flags}\par
00299     ImGui_ImplOpenGL3_Data* bd = IM_NEW(ImGui_ImplOpenGL3_Data)();\par
00300     io.BackendRendererUserData = ({\cf18 void}*)bd;\par
00301     io.BackendRendererName = {\cf22 "imgui_impl_opengl3"};\par
00302 \par
00303     {\cf20 // Query for GL version (e.g. 320 for GL 3.2)}\par
00304 {\cf21 #if defined(IMGUI_IMPL_OPENGL_ES2)}\par
00305     {\cf20 // GLES 2}\par
00306     bd->GlVersion = 200;\par
00307     bd->GlProfileIsES2 = {\cf17 true};\par
00308 {\cf21 #else}\par
00309     {\cf20 // Desktop or GLES 3}\par
00310     {\cf17 const} {\cf18 char}* gl_version_str = ({\cf17 const} {\cf18 char}*)glGetString(GL_VERSION);\par
00311     GLint major = 0;\par
00312     GLint minor = 0;\par
00313     glGetIntegerv(GL_MAJOR_VERSION, &major);\par
00314     glGetIntegerv(GL_MINOR_VERSION, &minor);\par
00315     {\cf19 if} (major == 0 && minor == 0)\par
00316         sscanf(gl_version_str, {\cf22 "%d.%d"}, &major, &minor); {\cf20 // Query GL_VERSION in desktop GL 2.x, the string will start with "<major>.<minor>"}\par
00317     bd->GlVersion = (GLuint)(major * 100 + minor * 10);\par
00318 {\cf21 #if defined(GL_CONTEXT_PROFILE_MASK)}\par
00319     {\cf19 if} (bd->GlVersion >= 320)\par
00320         glGetIntegerv(GL_CONTEXT_PROFILE_MASK, &bd->GlProfileMask);\par
00321     bd->GlProfileIsCompat = (bd->GlProfileMask & GL_CONTEXT_COMPATIBILITY_PROFILE_BIT) != 0;\par
00322 {\cf21 #endif}\par
00323 \par
00324 {\cf21 #if defined(IMGUI_IMPL_OPENGL_ES3)}\par
00325     bd->GlProfileIsES3 = {\cf17 true};\par
00326 {\cf21 #else}\par
00327     {\cf19 if} (strncmp(gl_version_str, {\cf22 "OpenGL ES 3"}, 11) == 0)\par
00328         bd->GlProfileIsES3 = {\cf17 true};\par
00329 {\cf21 #endif}\par
00330 \par
00331     bd->UseBufferSubData = {\cf17 false};\par
00332     {\cf20 /*}\par
00333 {\cf20     // Query vendor to enable glBufferSubData kludge}\par
00334 {\cf20 #ifdef _WIN32}\par
00335 {\cf20     if (const char* vendor = (const char*)glGetString(GL_VENDOR))}\par
00336 {\cf20         if (strncmp(vendor, "Intel", 5) == 0)}\par
00337 {\cf20             bd->UseBufferSubData = true;}\par
00338 {\cf20 #endif}\par
00339 {\cf20     */}\par
00340 {\cf21 #endif}\par
00341 \par
00342 {\cf21 #ifdef IMGUI_IMPL_OPENGL_DEBUG}\par
00343     printf({\cf22 "GlVersion = %d, \\"%s\\"\\nGlProfileIsCompat = %d\\nGlProfileMask = 0x%X\\nGlProfileIsES2 = %d, GlProfileIsES3 = %d\\nGL_VENDOR = '%s'\\nGL_RENDERER = '%s'\\n"}, bd->GlVersion, gl_version_str, bd->GlProfileIsCompat, bd->GlProfileMask, bd->GlProfileIsES2, bd->GlProfileIsES3, ({\cf17 const} {\cf18 char}*)glGetString(GL_VENDOR), ({\cf17 const} {\cf18 char}*)glGetString(GL_RENDERER)); {\cf20 // [DEBUG]}\par
00344 {\cf21 #endif}\par
00345 \par
00346 {\cf21 #ifdef IMGUI_IMPL_OPENGL_MAY_HAVE_VTX_OFFSET}\par
00347     {\cf19 if} (bd->GlVersion >= 320)\par
00348         io.BackendFlags |= ImGuiBackendFlags_RendererHasVtxOffset;  {\cf20 // We can honor the ImDrawCmd::VtxOffset field, allowing for large meshes.}\par
00349 {\cf21 #endif}\par
00350     io.BackendFlags |= ImGuiBackendFlags_RendererHasViewports;  {\cf20 // We can create multi-viewports on the Renderer side (optional)}\par
00351 \par
00352     {\cf20 // Store GLSL version string so we can refer to it later in case we recreate shaders.}\par
00353     {\cf20 // Note: GLSL version is NOT the same as GL version. Leave this to nullptr if unsure.}\par
00354     {\cf19 if} (glsl_version == {\cf17 nullptr})\par
00355     \{\par
00356 {\cf21 #if defined(IMGUI_IMPL_OPENGL_ES2)}\par
00357         glsl_version = {\cf22 "#version 100"};\par
00358 {\cf21 #elif defined(IMGUI_IMPL_OPENGL_ES3)}\par
00359         glsl_version = {\cf22 "#version 300 es"};\par
00360 {\cf21 #elif defined(__APPLE__)}\par
00361         glsl_version = {\cf22 "#version 150"};\par
00362 {\cf21 #else}\par
00363         glsl_version = {\cf22 "#version 130"};\par
00364 {\cf21 #endif}\par
00365     \}\par
00366     IM_ASSERT(({\cf18 int})strlen(glsl_version) + 2 < IM_ARRAYSIZE(bd->GlslVersionString));\par
00367     strcpy(bd->GlslVersionString, glsl_version);\par
00368     strcat(bd->GlslVersionString, {\cf22 "\\n"});\par
00369 \par
00370     {\cf20 // Make an arbitrary GL call (we don't actually need the result)}\par
00371     {\cf20 // IF YOU GET A CRASH HERE: it probably means the OpenGL function loader didn't do its job. Let us know!}\par
00372     GLint current_texture;\par
00373     glGetIntegerv(GL_TEXTURE_BINDING_2D, &current_texture);\par
00374 \par
00375     {\cf20 // Detect extensions we support}\par
00376 {\cf21 #ifdef IMGUI_IMPL_OPENGL_MAY_HAVE_POLYGON_MODE}\par
00377     bd->HasPolygonMode = (!bd->GlProfileIsES2 && !bd->GlProfileIsES3);\par
00378 {\cf21 #endif}\par
00379     bd->HasClipOrigin = (bd->GlVersion >= 450);\par
00380 {\cf21 #ifdef IMGUI_IMPL_OPENGL_HAS_EXTENSIONS}\par
00381     GLint num_extensions = 0;\par
00382     glGetIntegerv(GL_NUM_EXTENSIONS, &num_extensions);\par
00383     {\cf19 for} (GLint i = 0; i < num_extensions; i++)\par
00384     \{\par
00385         {\cf17 const} {\cf18 char}* extension = ({\cf17 const} {\cf18 char}*)glGetStringi(GL_EXTENSIONS, i);\par
00386         {\cf19 if} (extension != {\cf17 nullptr} && strcmp(extension, {\cf22 "GL_ARB_clip_control"}) == 0)\par
00387             bd->HasClipOrigin = {\cf17 true};\par
00388     \}\par
00389 {\cf21 #endif}\par
00390 \par
00391     {\cf19 if} (io.ConfigFlags & ImGuiConfigFlags_ViewportsEnable)\par
00392         ImGui_ImplOpenGL3_InitPlatformInterface();\par
00393 \par
00394     {\cf19 return} {\cf17 true};\par
00395 \}\par
