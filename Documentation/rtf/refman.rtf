08011 {\cf20 // Moving window to front of display and set focus (which happens to be back of our sorted list)}\par
08012 {\cf18 void} ImGui::FocusWindow(ImGuiWindow* window, ImGuiFocusRequestFlags flags)\par
08013 \{\par
08014     ImGuiContext& g = *GImGui;\par
08015 \par
08016     {\cf20 // Modal check?}\par
08017     {\cf19 if} ((flags & ImGuiFocusRequestFlags_UnlessBelowModal) && (g.NavWindow != window)) {\cf20 // Early out in common case.}\par
08018         {\cf19 if} (ImGuiWindow* blocking_modal = FindBlockingModal(window))\par
08019         \{\par
08020             {\cf20 // This block would typically be reached in two situations:}\par
08021             {\cf20 // - API call to FocusWindow() with a window under a modal and ImGuiFocusRequestFlags_UnlessBelowModal flag.}\par
08022             {\cf20 // - User clicking on void or anything behind a modal while a modal is open (window == NULL)}\par
08023             IMGUI_DEBUG_LOG_FOCUS({\cf22 "[focus] FocusWindow(\\"%s\\", UnlessBelowModal): prevented by \\"%s\\".\\n"}, window ? window->Name : {\cf22 "<NULL>"}, blocking_modal->Name);\par
08024             {\cf19 if} (window && window == window->RootWindow && (window->Flags & ImGuiWindowFlags_NoBringToFrontOnFocus) == 0)\par
08025                 BringWindowToDisplayBehind(window, blocking_modal); {\cf20 // Still bring right under modal. (FIXME: Could move in focus list too?)}\par
08026             ClosePopupsOverWindow(GetTopMostPopupModal(), {\cf17 false}); {\cf20 // Note how we need to use GetTopMostPopupModal() aad NOT blocking_modal, to handle nested modals}\par
08027             {\cf19 return};\par
08028         \}\par
08029 \par
08030     {\cf20 // Find last focused child (if any) and focus it instead.}\par
08031     {\cf19 if} ((flags & ImGuiFocusRequestFlags_RestoreFocusedChild) && window != NULL)\par
08032         window = NavRestoreLastChildNavWindow(window);\par
08033 \par
08034     {\cf20 // Apply focus}\par
08035     {\cf19 if} (g.NavWindow != window)\par
08036     \{\par
08037         SetNavWindow(window);\par
08038         {\cf19 if} (window && g.NavDisableMouseHover)\par
08039             g.NavMousePosDirty = {\cf17 true};\par
08040         g.NavId = window ? window->NavLastIds[0] : 0; {\cf20 // Restore NavId}\par
08041         g.NavLayer = ImGuiNavLayer_Main;\par
08042         SetNavFocusScope(window ? window->NavRootFocusScopeId : 0);\par
08043         g.NavIdIsAlive = {\cf17 false};\par
08044         g.NavLastValidSelectionUserData = ImGuiSelectionUserData_Invalid;\par
08045 \par
08046         {\cf20 // Close popups if any}\par
08047         ClosePopupsOverWindow(window, {\cf17 false});\par
08048     \}\par
08049 \par
08050     {\cf20 // Move the root window to the top of the pile}\par
08051     IM_ASSERT(window == NULL || window->RootWindowDockTree != NULL);\par
08052     ImGuiWindow* focus_front_window = window ? window->RootWindow : NULL;\par
08053     ImGuiWindow* display_front_window = window ? window->RootWindowDockTree : NULL;\par
08054     ImGuiDockNode* dock_node = window ? window->DockNode : NULL;\par
08055     {\cf18 bool} active_id_window_is_dock_node_host = (g.ActiveIdWindow && dock_node && dock_node->HostWindow == g.ActiveIdWindow);\par
08056 \par
08057     {\cf20 // Steal active widgets. Some of the cases it triggers includes:}\par
08058     {\cf20 // - Focus a window while an InputText in another window is active, if focus happens before the old InputText can run.}\par
08059     {\cf20 // - When using Nav to activate menu items (due to timing of activating on press->new window appears->losing ActiveId)}\par
08060     {\cf20 // - Using dock host items (tab, collapse button) can trigger this before we redirect the ActiveIdWindow toward the child window.}\par
08061     {\cf19 if} (g.ActiveId != 0 && g.ActiveIdWindow && g.ActiveIdWindow->RootWindow != focus_front_window)\par
08062         {\cf19 if} (!g.ActiveIdNoClearOnFocusLoss && !active_id_window_is_dock_node_host)\par
08063             ClearActiveID();\par
08064 \par
08065     {\cf20 // Passing NULL allow to disable keyboard focus}\par
08066     {\cf19 if} (!window)\par
08067         {\cf19 return};\par
08068     window->LastFrameJustFocused = g.FrameCount;\par
08069 \par
08070     {\cf20 // Select in dock node}\par
08071     {\cf20 // For #2304 we avoid applying focus immediately before the tabbar is visible.}\par
08072     {\cf20 //if (dock_node && dock_node->TabBar)}\par
08073     {\cf20 //    dock_node->TabBar->SelectedTabId = dock_node->TabBar->NextSelectedTabId = window->TabId;}\par
08074 \par
08075     {\cf20 // Bring to front}\par
08076     BringWindowToFocusFront(focus_front_window);\par
08077     {\cf19 if} (((window->Flags | focus_front_window->Flags | display_front_window->Flags) & ImGuiWindowFlags_NoBringToFrontOnFocus) == 0)\par
08078         BringWindowToDisplayFront(display_front_window);\par
08079 \}\par
