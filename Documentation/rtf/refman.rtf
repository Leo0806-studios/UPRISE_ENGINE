05529     {\cf20 // Draw modal/window whitening backgrounds}\par
05530     RenderDimmedBackgrounds();\par
05531 \par
05532     {\cf20 // Add ImDrawList to render}\par
05533     ImGuiWindow* windows_to_render_top_most[2];\par
05534     windows_to_render_top_most[0] = (g.NavWindowingTarget && !(g.NavWindowingTarget->Flags & ImGuiWindowFlags_NoBringToFrontOnFocus)) ? g.NavWindowingTarget->RootWindowDockTree : NULL;\par
05535     windows_to_render_top_most[1] = (g.NavWindowingTarget ? g.NavWindowingListWindow : NULL);\par
