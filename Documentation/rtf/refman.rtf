19041 {\cf20 // root_id = 0 to remove all, root_id != 0 to remove child of given node.}\par
19042 {\cf18 void} ImGui::DockBuilderRemoveNodeChildNodes(ImGuiID root_id)\par
19043 \{\par
19044     ImGuiContext& g = *GImGui;\par
19045     ImGuiDockContext* dc = &g.DockContext;\par
19046 \par
19047     ImGuiDockNode* root_node = root_id ? DockContextFindNodeByID(&g, root_id) : NULL;\par
19048     {\cf19 if} (root_id && root_node == NULL)\par
19049         {\cf19 return};\par
19050     {\cf18 bool} has_central_node = {\cf17 false};\par
19051 \par
19052     ImGuiDataAuthority backup_root_node_authority_for_pos = root_node ? root_node->AuthorityForPos : ImGuiDataAuthority_Auto;\par
19053     ImGuiDataAuthority backup_root_node_authority_for_size = root_node ? root_node->AuthorityForSize : ImGuiDataAuthority_Auto;\par
19054 \par
19055     {\cf20 // Process active windows}\par
19056     ImVector<ImGuiDockNode*> nodes_to_remove;\par
19057     {\cf19 for} ({\cf18 int} n = 0; n < dc->Nodes.Data.Size; n++)\par
19058         {\cf19 if} (ImGuiDockNode* node = (ImGuiDockNode*)dc->Nodes.Data[n].val_p)\par
19059         \{\par
19060             {\cf18 bool} want_removal = (root_id == 0) || (node->ID != root_id && DockNodeGetRootNode(node)->ID == root_id);\par
19061             {\cf19 if} (want_removal)\par
19062             \{\par
19063                 {\cf19 if} (node->IsCentralNode())\par
19064                     has_central_node = {\cf17 true};\par
19065                 {\cf19 if} (root_id != 0)\par
19066                     DockContextQueueNotifyRemovedNode(&g, node);\par
19067                 {\cf19 if} (root_node)\par
19068                 \{\par
19069                     DockNodeMoveWindows(root_node, node);\par
19070                     DockSettingsRenameNodeReferences(node->ID, root_node->ID);\par
19071                 \}\par
19072                 nodes_to_remove.push_back(node);\par
19073             \}\par
19074         \}\par
19075 \par
19076     {\cf20 // DockNodeMoveWindows->DockNodeAddWindow will normally set those when reaching two windows (which is only adequate during interactive merge)}\par
19077     {\cf20 // Make sure we don't lose our current pos/size. (FIXME-DOCK: Consider tidying up that code in DockNodeAddWindow instead)}\par
19078     {\cf19 if} (root_node)\par
19079     \{\par
19080         root_node->AuthorityForPos = backup_root_node_authority_for_pos;\par
19081         root_node->AuthorityForSize = backup_root_node_authority_for_size;\par
19082     \}\par
19083 \par
19084     {\cf20 // Apply to settings}\par
19085     {\cf19 for} (ImGuiWindowSettings* settings = g.SettingsWindows.begin(); settings != NULL; settings = g.SettingsWindows.next_chunk(settings))\par
19086         {\cf19 if} (ImGuiID window_settings_dock_id = settings->DockId)\par
19087             {\cf19 for} ({\cf18 int} n = 0; n < nodes_to_remove.Size; n++)\par
19088                 {\cf19 if} (nodes_to_remove[n]->ID == window_settings_dock_id)\par
19089                 \{\par
19090                     settings->DockId = root_id;\par
19091                     {\cf19 break};\par
19092                 \}\par
19093 \par
19094     {\cf20 // Not really efficient, but easier to destroy a whole hierarchy considering DockContextRemoveNode is attempting to merge nodes}\par
19095     {\cf19 if} (nodes_to_remove.Size > 1)\par
19096         ImQsort(nodes_to_remove.Data, nodes_to_remove.Size, {\cf17 sizeof}(ImGuiDockNode*), DockNodeComparerDepthMostFirst);\par
19097     {\cf19 for} ({\cf18 int} n = 0; n < nodes_to_remove.Size; n++)\par
19098         DockContextRemoveNode(&g, nodes_to_remove[n], {\cf17 false});\par
19099 \par
19100     {\cf19 if} (root_id == 0)\par
19101     \{\par
19102         dc->Nodes.Clear();\par
19103         dc->Requests.clear();\par
19104     \}\par
19105     {\cf19 else} {\cf19 if} (has_central_node)\par
19106     \{\par
19107         root_node->CentralNode = root_node;\par
19108         root_node->SetLocalFlags(root_node->LocalFlags | ImGuiDockNodeFlags_CentralNode);\par
19109     \}\par
19110 \}\par
