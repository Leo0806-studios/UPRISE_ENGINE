10210 {\cf20 // Process input queue}\par
10211 {\cf20 // We always call this with the value of 'bool g.IO.ConfigInputTrickleEventQueue'.}\par
10212 {\cf20 // - trickle_fast_inputs = false : process all events, turn into flattened input state (e.g. successive down/up/down/up will be lost)}\par
10213 {\cf20 // - trickle_fast_inputs = true  : process as many events as possible (successive down/up/down/up will be trickled over several frames so nothing is lost) (new feature in 1.87)}\par
10214 {\cf18 void} ImGui::UpdateInputEvents({\cf18 bool} trickle_fast_inputs)\par
10215 \{\par
10216     ImGuiContext& g = *GImGui;\par
10217     ImGuiIO& io = g.IO;\par
10218 \par
10219     {\cf20 // Only trickle chars<>key when working with InputText()}\par
10220     {\cf20 // FIXME: InputText() could parse event trail?}\par
10221     {\cf20 // FIXME: Could specialize chars<>keys trickling rules for control keys (those not typically associated to characters)}\par
10222     {\cf17 const} {\cf18 bool} trickle_interleaved_keys_and_text = (trickle_fast_inputs && g.WantTextInputNextFrame == 1);\par
10223 \par
10224     {\cf18 bool} mouse_moved = {\cf17 false}, mouse_wheeled = {\cf17 false}, key_changed = {\cf17 false}, text_inputted = {\cf17 false};\par
10225     {\cf18 int}  mouse_button_changed = 0x00;\par
10226     ImBitArray<ImGuiKey_KeysData_SIZE> key_changed_mask;\par
10227 \par
10228     {\cf18 int} event_n = 0;\par
10229     {\cf19 for} (; event_n < g.InputEventsQueue.Size; event_n++)\par
10230     \{\par
10231         ImGuiInputEvent* e = &g.InputEventsQueue[event_n];\par
10232         {\cf19 if} (e->Type == ImGuiInputEventType_MousePos)\par
10233         \{\par
10234             {\cf19 if} (g.IO.WantSetMousePos)\par
10235                 {\cf19 continue};\par
10236             {\cf20 // Trickling Rule: Stop processing queued events if we already handled a mouse button change}\par
10237             ImVec2 event_pos(e->MousePos.PosX, e->MousePos.PosY);\par
10238             {\cf19 if} (trickle_fast_inputs && (mouse_button_changed != 0 || mouse_wheeled || key_changed || text_inputted))\par
10239                 {\cf19 break};\par
10240             io.MousePos = event_pos;\par
10241             io.MouseSource = e->MousePos.MouseSource;\par
10242             mouse_moved = {\cf17 true};\par
10243         \}\par
10244         {\cf19 else} {\cf19 if} (e->Type == ImGuiInputEventType_MouseButton)\par
10245         \{\par
10246             {\cf20 // Trickling Rule: Stop processing queued events if we got multiple action on the same button}\par
10247             {\cf17 const} ImGuiMouseButton button = e->MouseButton.Button;\par
10248             IM_ASSERT(button >= 0 && button < ImGuiMouseButton_COUNT);\par
10249             {\cf19 if} (trickle_fast_inputs && ((mouse_button_changed & (1 << button)) || mouse_wheeled))\par
10250                 {\cf19 break};\par
10251             {\cf19 if} (trickle_fast_inputs && e->MouseButton.MouseSource == ImGuiMouseSource_TouchScreen && mouse_moved) {\cf20 // #2702: TouchScreen have no initial hover.}\par
10252                 {\cf19 break};\par
10253             io.MouseDown[button] = e->MouseButton.Down;\par
10254             io.MouseSource = e->MouseButton.MouseSource;\par
10255             mouse_button_changed |= (1 << button);\par
10256         \}\par
10257         {\cf19 else} {\cf19 if} (e->Type == ImGuiInputEventType_MouseWheel)\par
10258         \{\par
10259             {\cf20 // Trickling Rule: Stop processing queued events if we got multiple action on the event}\par
10260             {\cf19 if} (trickle_fast_inputs && (mouse_moved || mouse_button_changed != 0))\par
10261                 {\cf19 break};\par
10262             io.MouseWheelH += e->MouseWheel.WheelX;\par
10263             io.MouseWheel += e->MouseWheel.WheelY;\par
10264             io.MouseSource = e->MouseWheel.MouseSource;\par
