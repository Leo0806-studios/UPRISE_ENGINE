16683 {\cf20 // Problem:}\par
16684 {\cf20 //   Undocking a large (~full screen) window would leave it so large that the bottom right sizing corner would more}\par
16685 {\cf20 //   than likely be off the screen and the window would be hard to resize to fit on screen. This can be particularly problematic}\par
16686 {\cf20 //   with 'ConfigWindowsMoveFromTitleBarOnly=true' and/or with 'ConfigWindowsResizeFromEdges=false' as well (the later can be}\par
16687 {\cf20 //   due to missing ImGuiBackendFlags_HasMouseCursors backend flag).}\par
16688 {\cf20 // Solution:}\par
16689 {\cf20 //   When undocking a window we currently force its maximum size to 90% of the host viewport or monitor.}\par
16690 {\cf20 // Reevaluate this when we implement preserving docked/undocked size ("docking_wip/undocked_size" branch).}\par
16691 {\cf17 static} ImVec2 FixLargeWindowsWhenUndocking({\cf17 const} ImVec2& size, ImGuiViewport* ref_viewport)\par
16692 \{\par
16693     {\cf19 if} (ref_viewport == NULL)\par
16694         {\cf19 return} size;\par
16695 \par
16696     ImGuiContext& g = *GImGui;\par
16697     ImVec2 max_size = ImTrunc(ref_viewport->WorkSize * 0.90f);\par
16698     {\cf19 if} (g.ConfigFlagsCurrFrame & ImGuiConfigFlags_ViewportsEnable)\par
16699     \{\par
16700         {\cf17 const} ImGuiPlatformMonitor* monitor = ImGui::GetViewportPlatformMonitor(ref_viewport);\par
16701         max_size = ImTrunc(monitor->WorkSize * 0.90f);\par
16702     \}\par
16703     {\cf19 return} ImMin(size, max_size);\par
16704 \}\par
