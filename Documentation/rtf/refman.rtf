21060 {\cf20 // In order to reduce interferences with the contents we are trying to debug into.}\par
21061 {\cf18 bool} ImGui::DebugBreakButton({\cf17 const} {\cf18 char}* label, {\cf17 const} {\cf18 char}* description_of_location)\par
21062 \{\par
21063     ImGuiWindow* window = GetCurrentWindow();\par
21064     {\cf19 if} (window->SkipItems)\par
21065         {\cf19 return} {\cf17 false};\par
21066 \par
21067     ImGuiContext& g = *GImGui;\par
21068     {\cf17 const} ImGuiID {\cf18 id} = window->GetID(label);\par
21069     {\cf17 const} ImVec2 label_size = CalcTextSize(label, NULL, {\cf17 true});\par
21070     ImVec2 pos = window->DC.CursorPos + ImVec2(0.0f, window->DC.CurrLineTextBaseOffset);\par
21071     ImVec2 size = ImVec2(label_size.x + g.Style.FramePadding.x * 2.0f, label_size.y);\par
21072 \par
21073     {\cf17 const} ImRect bb(pos, pos + size);\par
21074     ItemSize(size, 0.0f);\par
21075     {\cf19 if} (!ItemAdd(bb, {\cf18 id}))\par
21076         {\cf19 return} {\cf17 false};\par
21077 \par
21078     {\cf20 // WE DO NOT USE ButtonEx() or ButtonBehavior() in order to reduce our side-effects.}\par
21079     {\cf18 bool} hovered = ItemHoverable(bb, {\cf18 id}, g.CurrentItemFlags);\par
21080     {\cf18 bool} pressed = hovered && (IsKeyChordPressed(g.DebugBreakKeyChord) || IsMouseClicked(0) || g.NavActivateId == id);\par
21081     DebugBreakButtonTooltip({\cf17 false}, description_of_location);\par
21082 \par
21083     ImVec4 col4f = GetStyleColorVec4(hovered ? ImGuiCol_ButtonHovered : ImGuiCol_Button);\par
21084     ImVec4 hsv;\par
21085     ColorConvertRGBtoHSV(col4f.x, col4f.y, col4f.z, hsv.x, hsv.y, hsv.z);\par
21086     ColorConvertHSVtoRGB(hsv.x + 0.20f, hsv.y, hsv.z, col4f.x, col4f.y, col4f.z);\par
21087 \par
21088     RenderNavHighlight(bb, {\cf18 id});\par
21089     RenderFrame(bb.Min, bb.Max, GetColorU32(col4f), {\cf17 true}, g.Style.FrameRounding);\par
21090     RenderTextClipped(bb.Min, bb.Max, label, NULL, &label_size, g.Style.ButtonTextAlign, &bb);\par
21091 \par
21092     IMGUI_TEST_ENGINE_ITEM_INFO({\cf18 id}, label, g.LastItemData.StatusFlags);\par
21093     {\cf19 return} pressed;\par
21094 \}\par
