02915 {\cf18 void} ImGuiTextIndex::append({\cf17 const} {\cf18 char}* base, {\cf18 int} old_size, {\cf18 int} new_size)\par
02916 \{\par
02917     IM_ASSERT(old_size >= 0 && new_size >= old_size && new_size >= EndOffset);\par
02918     {\cf19 if} (old_size == new_size)\par
02919         {\cf19 return};\par
02920     {\cf19 if} (EndOffset == 0 || base[EndOffset - 1] == {\cf23 '\\n'})\par
02921         LineOffsets.push_back(EndOffset);\par
02922     {\cf17 const} {\cf18 char}* base_end = base + new_size;\par
02923     {\cf19 for} ({\cf17 const} {\cf18 char}* p = base + old_size; (p = ({\cf17 const} {\cf18 char}*)memchr(p, {\cf23 '\\n'}, base_end - p)) != 0; )\par
02924         {\cf19 if} (++p < base_end) {\cf20 // Don't push a trailing offset on last \\n}\par
02925             LineOffsets.push_back(({\cf18 int})(intptr_t)(p - base));\par
02926     EndOffset = ImMax(EndOffset, new_size);\par
02927 \}\par
