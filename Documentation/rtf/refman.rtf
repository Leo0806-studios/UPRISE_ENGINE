12097     {\cf18 int} mouse_button = (popup_flags & ImGuiPopupFlags_MouseButtonMask_);\par
12098     {\cf19 if} (IsMouseReleased(mouse_button) && IsItemHovered(ImGuiHoveredFlags_AllowWhenBlockedByPopup))\par
