02862 {\cf18 void} ImGuiTextBuffer::append({\cf17 const} {\cf18 char}* str, {\cf17 const} {\cf18 char}* str_end)\par
02863 \{\par
02864     {\cf18 int} len = str_end ? (int)(str_end - str) : (int)strlen(str);\par
02865 \par
02866     {\cf20 // Add zero-terminator the first time}\par
02867     {\cf17 const} {\cf18 int} write_off = (Buf.Size != 0) ? Buf.Size : 1;\par
02868     {\cf17 const} {\cf18 int} needed_sz = write_off + len;\par
02869     {\cf19 if} (write_off + len >= Buf.Capacity)\par
02870     \{\par
02871         {\cf18 int} new_capacity = Buf.Capacity * 2;\par
02872         Buf.reserve(needed_sz > new_capacity ? needed_sz : new_capacity);\par
02873     \}\par
02874 \par
02875     Buf.resize(needed_sz);\par
02876     memcpy(&Buf[write_off - 1], str, ({\cf18 size_t})len);\par
02877     Buf[write_off - 1 + len] = 0;\par
02878 \}\par
