11943 {\cf18 void} ImGui::ClosePopupToLevel({\cf18 int} remaining, {\cf18 bool} restore_focus_to_window_under_popup)\par
11944 \{\par
11945     ImGuiContext& g = *GImGui;\par
11946     IMGUI_DEBUG_LOG_POPUP({\cf22 "[popup] ClosePopupToLevel(%d), restore_under=%d\\n"}, remaining, restore_focus_to_window_under_popup);\par
11947     IM_ASSERT(remaining >= 0 && remaining < g.OpenPopupStack.Size);\par
11948 \par
11949     {\cf20 // Trim open popup stack}\par
11950     ImGuiPopupData prev_popup = g.OpenPopupStack[remaining];\par
11951     g.OpenPopupStack.resize(remaining);\par
11952 \par
11953     {\cf20 // Restore focus (unless popup window was not yet submitted, and didn't have a chance to take focus anyhow. See #7325 for an edge case)}\par
11954     {\cf19 if} (restore_focus_to_window_under_popup && prev_popup.Window)\par
11955     \{\par
11956         ImGuiWindow* popup_window = prev_popup.Window;\par
11957         ImGuiWindow* focus_window = (popup_window->Flags & ImGuiWindowFlags_ChildMenu) ? popup_window->ParentWindow : prev_popup.RestoreNavWindow;\par
11958         {\cf19 if} (focus_window && !focus_window->WasActive)\par
11959             FocusTopMostWindowUnderOne(popup_window, NULL, NULL, ImGuiFocusRequestFlags_RestoreFocusedChild); {\cf20 // Fallback}\par
11960         {\cf19 else}\par
11961             FocusWindow(focus_window, (g.NavLayer == ImGuiNavLayer_Main) ? ImGuiFocusRequestFlags_RestoreFocusedChild : ImGuiFocusRequestFlags_None);\par
11962     \}\par
11963 \}\par
11964 \par
11965 {\cf20 // Close the popup we have begin-ed into.}\par
11966 {\cf18 void} ImGui::CloseCurrentPopup()\par
11967 \{\par
11968     ImGuiContext& g = *GImGui;\par
11969     {\cf18 int} popup_idx = g.BeginPopupStack.Size - 1;\par
11970     {\cf19 if} (popup_idx < 0 || popup_idx >= g.OpenPopupStack.Size || g.BeginPopupStack[popup_idx].PopupId != g.OpenPopupStack[popup_idx].PopupId)\par
11971         {\cf19 return};\par
11972 \par
11973     {\cf20 // Closing a menu closes its top-most parent popup (unless a modal)}\par
11974     {\cf19 while} (popup_idx > 0)\par
11975     \{\par
11976         ImGuiWindow* popup_window = g.OpenPopupStack[popup_idx].Window;\par
11977         ImGuiWindow* parent_popup_window = g.OpenPopupStack[popup_idx - 1].Window;\par
11978         {\cf18 bool} close_parent = {\cf17 false};\par
11979         {\cf19 if} (popup_window && (popup_window->Flags & ImGuiWindowFlags_ChildMenu))\par
11980             {\cf19 if} (parent_popup_window && !(parent_popup_window->Flags & ImGuiWindowFlags_MenuBar))\par
11981                 close_parent = {\cf17 true};\par
11982         {\cf19 if} (!close_parent)\par
11983             {\cf19 break};\par
11984         popup_idx--;\par
11985     \}\par
11986     IMGUI_DEBUG_LOG_POPUP({\cf22 "[popup] CloseCurrentPopup %d -> %d\\n"}, g.BeginPopupStack.Size - 1, popup_idx);\par
11987     ClosePopupToLevel(popup_idx, {\cf17 true});\par
11988 \par
11989     {\cf20 // A common pattern is to close a popup when selecting a menu item/selectable that will open another window.}\par
11990     {\cf20 // To improve this usage pattern, we avoid nav highlight for a single frame in the parent window.}\par
11991     {\cf20 // Similarly, we could avoid mouse hover highlight in this window but it is less visually problematic.}\par
11992     {\cf19 if} (ImGuiWindow* window = g.NavWindow)\par
11993         window->DC.NavHideHighlightOneFrame = {\cf17 true};\par
11994 \}\par
