14246 {\cf20 // FIXME-STYLE FIXME-DRAGDROP: Settle on a proper default visuals for drop target.}\par
14247 {\cf18 void} ImGui::RenderDragDropTargetRect({\cf17 const} ImRect& bb, {\cf17 const} ImRect& item_clip_rect)\par
14248 \{\par
14249     ImGuiContext& g = *GImGui;\par
14250     ImGuiWindow* window = g.CurrentWindow;\par
14251     ImRect bb_display = bb;\par
14252     bb_display.ClipWith(item_clip_rect); {\cf20 // Clip THEN expand so we have a way to visualize that target is not entirely visible.}\par
14253     bb_display.Expand(3.5f);\par
14254     {\cf18 bool} push_clip_rect = !window->ClipRect.Contains(bb_display);\par
14255     {\cf19 if} (push_clip_rect)\par
14256         window->DrawList->PushClipRectFullScreen();\par
14257     window->DrawList->AddRect(bb_display.Min, bb_display.Max, GetColorU32(ImGuiCol_DragDropTarget), 0.0f, 0, 2.0f);\par
14258     {\cf19 if} (push_clip_rect)\par
14259         window->DrawList->PopClipRect();\par
14260 \}\par
