00574         {\cf17 const} GLsizeiptr vtx_buffer_size = (GLsizeiptr)cmd_list->VtxBuffer.Size * ({\cf18 int}){\cf17 sizeof}(ImDrawVert);\par
00575         {\cf17 const} GLsizeiptr idx_buffer_size = (GLsizeiptr)cmd_list->IdxBuffer.Size * ({\cf18 int}){\cf17 sizeof}(ImDrawIdx);\par
