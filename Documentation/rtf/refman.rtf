02458 {\cf17 static} {\cf17 inline} {\cf18 int} ImTextCountUtf8BytesFromChar({\cf18 unsigned} {\cf18 int} c)\par
02459 \{\par
02460     {\cf19 if} (c < 0x80) {\cf19 return} 1;\par
02461     {\cf19 if} (c < 0x800) {\cf19 return} 2;\par
02462     {\cf19 if} (c < 0x10000) {\cf19 return} 3;\par
02463     {\cf19 if} (c <= 0x10FFFF) {\cf19 return} 4;\par
02464     {\cf19 return} 3;\par
02465 \}\par
