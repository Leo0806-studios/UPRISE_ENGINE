06353 {\cf20 // Handle resize for: Resize Grips, Borders, Gamepad}\par
06354 {\cf20 // Return true when using auto-fit (double-click on resize grip)}\par
06355 {\cf17 static} {\cf18 int} ImGui::UpdateWindowManualResize(ImGuiWindow* window, {\cf17 const} ImVec2& size_auto_fit, {\cf18 int}* border_hovered, {\cf18 int}* border_held, {\cf18 int} resize_grip_count, ImU32 resize_grip_col[4], {\cf17 const} ImRect& visibility_rect)\par
06356 \{\par
06357     ImGuiContext& g = *GImGui;\par
06358     ImGuiWindowFlags flags = window->Flags;\par
06359 \par
06360     {\cf19 if} ((flags & ImGuiWindowFlags_NoResize) || (flags & ImGuiWindowFlags_AlwaysAutoResize) || window->AutoFitFramesX > 0 || window->AutoFitFramesY > 0)\par
06361         {\cf19 return} {\cf17 false};\par
06362     {\cf19 if} (window->WasActive == {\cf17 false}) {\cf20 // Early out to avoid running this code for e.g. a hidden implicit/fallback Debug window.}\par
06363         {\cf19 return} {\cf17 false};\par
06364 \par
06365     {\cf18 int} ret_auto_fit_mask = 0x00;\par
06366     {\cf17 const} {\cf18 float} grip_draw_size = IM_TRUNC(ImMax(g.FontSize * 1.35f, window->WindowRounding + 1.0f + g.FontSize * 0.2f));\par
06367     {\cf17 const} {\cf18 float} grip_hover_inner_size = (resize_grip_count > 0) ? IM_TRUNC(grip_draw_size * 0.75f) : 0.0f;\par
06368     {\cf17 const} {\cf18 float} grip_hover_outer_size = g.IO.ConfigWindowsResizeFromEdges ? WINDOWS_HOVER_PADDING : 0.0f;\par
06369 \par
06370     ImRect clamp_rect = visibility_rect;\par
06371     {\cf17 const} {\cf18 bool} window_move_from_title_bar = g.IO.ConfigWindowsMoveFromTitleBarOnly && !(window->Flags & ImGuiWindowFlags_NoTitleBar);\par
06372     {\cf19 if} (window_move_from_title_bar)\par
06373         clamp_rect.Min.y -= window->TitleBarHeight;\par
06374 \par
06375     ImVec2 pos_target(FLT_MAX, FLT_MAX);\par
06376     ImVec2 size_target(FLT_MAX, FLT_MAX);\par
06377 \par
06378     {\cf20 // Clip mouse interaction rectangles within the viewport rectangle (in practice the narrowing is going to happen most of the time).}\par
06379     {\cf20 // - Not narrowing would mostly benefit the situation where OS windows _without_ decoration have a threshold for hovering when outside their limits.}\par
06380     {\cf20 //   This is however not the case with current backends under Win32, but a custom borderless window implementation would benefit from it.}\par
06381     {\cf20 // - When decoration are enabled we typically benefit from that distance, but then our resize elements would be conflicting with OS resize elements, so we also narrow.}\par
06382     {\cf20 // - Note that we are unable to tell if the platform setup allows hovering with a distance threshold (on Win32, decorated window have such threshold).}\par
06383     {\cf20 // We only clip interaction so we overwrite window->ClipRect, cannot call PushClipRect() yet as DrawList is not yet setup.}\par
06384     {\cf17 const} {\cf18 bool} clip_with_viewport_rect = !(g.IO.BackendFlags & ImGuiBackendFlags_HasMouseHoveredViewport) || (g.IO.MouseHoveredViewport != window->ViewportId) || !(window->Viewport->Flags & ImGuiViewportFlags_NoDecoration);\par
06385     {\cf19 if} (clip_with_viewport_rect)\par
06386         window->ClipRect = window->Viewport->GetMainRect();\par
06387 \par
06388     {\cf20 // Resize grips and borders are on layer 1}\par
06389     window->DC.NavLayerCurrent = ImGuiNavLayer_Menu;\par
06390 \par
06391     {\cf20 // Manual resize grips}\par
06392     PushID({\cf22 "#RESIZE"});\par
06393     {\cf19 for} ({\cf18 int} resize_grip_n = 0; resize_grip_n < resize_grip_count; resize_grip_n++)\par
06394     \{\par
06395         {\cf17 const} ImGuiResizeGripDef& def = resize_grip_def[resize_grip_n];\par
06396         {\cf17 const} ImVec2 corner = ImLerp(window->Pos, window->Pos + window->Size, def.CornerPosN);\par
06397 \par
06398         {\cf20 // Using the FlattenChilds button flag we make the resize button accessible even if we are hovering over a child window}\par
06399         {\cf18 bool} hovered, held;\par
06400         ImRect resize_rect(corner - def.InnerDir * grip_hover_outer_size, corner + def.InnerDir * grip_hover_inner_size);\par
06401         {\cf19 if} (resize_rect.Min.x > resize_rect.Max.x) ImSwap(resize_rect.Min.x, resize_rect.Max.x);\par
06402         {\cf19 if} (resize_rect.Min.y > resize_rect.Max.y) ImSwap(resize_rect.Min.y, resize_rect.Max.y);\par
06403         ImGuiID resize_grip_id = window->GetID(resize_grip_n); {\cf20 // == GetWindowResizeCornerID()}\par
06404         ItemAdd(resize_rect, resize_grip_id, NULL, ImGuiItemFlags_NoNav);\par
06405         ButtonBehavior(resize_rect, resize_grip_id, &hovered, &held, ImGuiButtonFlags_FlattenChildren | ImGuiButtonFlags_NoNavFocus);\par
06406         {\cf20 //GetForegroundDrawList(window)->AddRect(resize_rect.Min, resize_rect.Max, IM_COL32(255, 255, 0, 255));}\par
06407         {\cf19 if} (hovered || held)\par
06408             g.MouseCursor = (resize_grip_n & 1) ? ImGuiMouseCursor_ResizeNESW : ImGuiMouseCursor_ResizeNWSE;\par
06409 \par
06410         {\cf19 if} (held && g.IO.MouseDoubleClicked[0])\par
06411         \{\par
06412             {\cf20 // Auto-fit when double-clicking}\par
06413             size_target = CalcWindowSizeAfterConstraint(window, size_auto_fit);\par
06414             ret_auto_fit_mask = 0x03; {\cf20 // Both axises}\par
06415             ClearActiveID();\par
06416         \}\par
06417         {\cf19 else} {\cf19 if} (held)\par
06418         \{\par
06419             {\cf20 // Resize from any of the four corners}\par
06420             {\cf20 // We don't use an incremental MouseDelta but rather compute an absolute target size based on mouse position}\par
06421             ImVec2 clamp_min = ImVec2(def.CornerPosN.x == 1.0f ? clamp_rect.Min.x : -FLT_MAX, (def.CornerPosN.y == 1.0f || (def.CornerPosN.y == 0.0f && window_move_from_title_bar)) ? clamp_rect.Min.y : -FLT_MAX);\par
06422             ImVec2 clamp_max = ImVec2(def.CornerPosN.x == 0.0f ? clamp_rect.Max.x : +FLT_MAX, def.CornerPosN.y == 0.0f ? clamp_rect.Max.y : +FLT_MAX);\par
06423             ImVec2 corner_target = g.IO.MousePos - g.ActiveIdClickOffset + ImLerp(def.InnerDir * grip_hover_outer_size, def.InnerDir * -grip_hover_inner_size, def.CornerPosN); {\cf20 // Corner of the window corresponding to our corner grip}\par
06424             corner_target = ImClamp(corner_target, clamp_min, clamp_max);\par
06425             CalcResizePosSizeFromAnyCorner(window, corner_target, def.CornerPosN, &pos_target, &size_target);\par
06426         \}\par
06427 \par
06428         {\cf20 // Only lower-left grip is visible before hovering/activating}\par
06429         {\cf19 if} (resize_grip_n == 0 || held || hovered)\par
06430             resize_grip_col[resize_grip_n] = GetColorU32(held ? ImGuiCol_ResizeGripActive : hovered ? ImGuiCol_ResizeGripHovered : ImGuiCol_ResizeGrip);\par
06431     \}\par
06432 \par
06433     {\cf18 int} resize_border_mask = 0x00;\par
06434     {\cf19 if} (window->Flags & ImGuiWindowFlags_ChildWindow)\par
06435         resize_border_mask |= ((window->ChildFlags & ImGuiChildFlags_ResizeX) ? 0x02 : 0) | ((window->ChildFlags & ImGuiChildFlags_ResizeY) ? 0x08 : 0);\par
06436     {\cf19 else}\par
06437         resize_border_mask = g.IO.ConfigWindowsResizeFromEdges ? 0x0F : 0x00;\par
06438     {\cf19 for} ({\cf18 int} border_n = 0; border_n < 4; border_n++)\par
06439     \{\par
06440         {\cf19 if} ((resize_border_mask & (1 << border_n)) == 0)\par
06441             {\cf19 continue};\par
06442         {\cf17 const} ImGuiResizeBorderDef& def = resize_border_def[border_n];\par
06443         {\cf17 const} ImGuiAxis axis = (border_n == ImGuiDir_Left || border_n == ImGuiDir_Right) ? ImGuiAxis_X : ImGuiAxis_Y;\par
06444 \par
06445         {\cf18 bool} hovered, held;\par
06446         ImRect border_rect = GetResizeBorderRect(window, border_n, grip_hover_inner_size, WINDOWS_HOVER_PADDING);\par
06447         ImGuiID border_id = window->GetID(border_n + 4); {\cf20 // == GetWindowResizeBorderID()}\par
06448         ItemAdd(border_rect, border_id, NULL, ImGuiItemFlags_NoNav);\par
06449         ButtonBehavior(border_rect, border_id, &hovered, &held, ImGuiButtonFlags_FlattenChildren | ImGuiButtonFlags_NoNavFocus);\par
06450         {\cf20 //GetForegroundDrawList(window)->AddRect(border_rect.Min, border_rect.Max, IM_COL32(255, 255, 0, 255));}\par
06451         {\cf19 if} (hovered && g.HoveredIdTimer <= WINDOWS_RESIZE_FROM_EDGES_FEEDBACK_TIMER)\par
06452             hovered = {\cf17 false};\par
06453         {\cf19 if} (hovered || held)\par
06454             g.MouseCursor = (axis == ImGuiAxis_X) ? ImGuiMouseCursor_ResizeEW : ImGuiMouseCursor_ResizeNS;\par
06455         {\cf19 if} (held && g.IO.MouseDoubleClicked[0])\par
06456         \{\par
06457             {\cf20 // Double-clicking bottom or right border auto-fit on this axis}\par
06458             {\cf20 // FIXME: CalcWindowAutoFitSize() doesn't take into account that only one side may be auto-fit when calculating scrollbars.}\par
06459             {\cf20 // FIXME: Support top and right borders: rework CalcResizePosSizeFromAnyCorner() to be reusable in both cases.}\par
06460             {\cf19 if} (border_n == 1 || border_n == 3) {\cf20 // Right and bottom border}\par
06461             \{\par
06462                 size_target[axis] = CalcWindowSizeAfterConstraint(window, size_auto_fit)[axis];\par
06463                 ret_auto_fit_mask |= (1 << axis);\par
06464                 hovered = held = {\cf17 false}; {\cf20 // So border doesn't show highlighted at new position}\par
06465             \}\par
06466             ClearActiveID();\par
06467         \}\par
06468         {\cf19 else} {\cf19 if} (held)\par
06469         \{\par
06470             {\cf20 // Switch to relative resizing mode when border geometry moved (e.g. resizing a child altering parent scroll), in order to avoid resizing feedback loop.}\par
06471             {\cf20 // Currently only using relative mode on resizable child windows, as the problem to solve is more likely noticeable for them, but could apply for all windows eventually.}\par
06472             {\cf20 // FIXME: May want to generalize this idiom at lower-level, so more widgets can use it!}\par
06473             {\cf17 const} {\cf18 bool} just_scrolled_manually_while_resizing = (g.WheelingWindow != NULL && g.WheelingWindowScrolledFrame == g.FrameCount && IsWindowChildOf(window, g.WheelingWindow, {\cf17 false}, {\cf17 true}));\par
06474             {\cf19 if} (g.ActiveIdIsJustActivated || just_scrolled_manually_while_resizing)\par
06475             \{\par
06476                 g.WindowResizeBorderExpectedRect = border_rect;\par
06477                 g.WindowResizeRelativeMode = {\cf17 false};\par
06478             \}\par
06479             {\cf19 if} ((window->Flags & ImGuiWindowFlags_ChildWindow) && memcmp(&g.WindowResizeBorderExpectedRect, &border_rect, {\cf17 sizeof}(ImRect)) != 0)\par
06480                 g.WindowResizeRelativeMode = {\cf17 true};\par
06481 \par
06482             {\cf17 const} ImVec2 border_curr = (window->Pos + ImMin(def.SegmentN1, def.SegmentN2) * window->Size);\par
06483             {\cf17 const} {\cf18 float} border_target_rel_mode_for_axis = border_curr[axis] + g.IO.MouseDelta[axis];\par
06484             {\cf17 const} {\cf18 float} border_target_abs_mode_for_axis = g.IO.MousePos[axis] - g.ActiveIdClickOffset[axis] + WINDOWS_HOVER_PADDING; {\cf20 // Match ButtonBehavior() padding above.}\par
06485 \par
06486             {\cf20 // Use absolute mode position}\par
06487             ImVec2 border_target = window->Pos;\par
06488             border_target[axis] = border_target_abs_mode_for_axis;\par
06489 \par
06490             {\cf20 // Use relative mode target for child window, ignore resize when moving back toward the ideal absolute position.}\par
06491             {\cf18 bool} ignore_resize = {\cf17 false};\par
06492             {\cf19 if} (g.WindowResizeRelativeMode)\par
06493             \{\par
06494                 {\cf20 //GetForegroundDrawList()->AddText(GetMainViewport()->WorkPos, IM_COL32_WHITE, "Relative Mode");}\par
06495                 border_target[axis] = border_target_rel_mode_for_axis;\par
06496                 {\cf19 if} (g.IO.MouseDelta[axis] == 0.0f || (g.IO.MouseDelta[axis] > 0.0f) == (border_target_rel_mode_for_axis > border_target_abs_mode_for_axis))\par
06497                     ignore_resize = {\cf17 true};\par
06498             \}\par
06499 \par
06500             {\cf20 // Clamp, apply}\par
06501             ImVec2 clamp_min(border_n == ImGuiDir_Right ? clamp_rect.Min.x : -FLT_MAX, border_n == ImGuiDir_Down || (border_n == ImGuiDir_Up && window_move_from_title_bar) ? clamp_rect.Min.y : -FLT_MAX);\par
06502             ImVec2 clamp_max(border_n == ImGuiDir_Left ? clamp_rect.Max.x : +FLT_MAX, border_n == ImGuiDir_Up ? clamp_rect.Max.y : +FLT_MAX);\par
06503             border_target = ImClamp(border_target, clamp_min, clamp_max);\par
06504             {\cf19 if} (flags & ImGuiWindowFlags_ChildWindow) {\cf20 // Clamp resizing of childs within parent}\par
06505             \{\par
06506                 ImGuiWindow* parent_window = window->ParentWindow;\par
06507                 ImGuiWindowFlags parent_flags = parent_window->Flags;\par
06508                 ImRect border_limit_rect = parent_window->InnerRect;\par
06509                 border_limit_rect.Expand(ImVec2(-ImMax(parent_window->WindowPadding.x, parent_window->WindowBorderSize), -ImMax(parent_window->WindowPadding.y, parent_window->WindowBorderSize)));\par
06510                 {\cf19 if} ((axis == ImGuiAxis_X) && ((parent_flags & (ImGuiWindowFlags_HorizontalScrollbar | ImGuiWindowFlags_AlwaysHorizontalScrollbar)) == 0 || (parent_flags & ImGuiWindowFlags_NoScrollbar)))\par
06511                     border_target.x = ImClamp(border_target.x, border_limit_rect.Min.x, border_limit_rect.Max.x);\par
06512                 {\cf19 if} ((axis == ImGuiAxis_Y) && (parent_flags & ImGuiWindowFlags_NoScrollbar))\par
06513                     border_target.y = ImClamp(border_target.y, border_limit_rect.Min.y, border_limit_rect.Max.y);\par
06514             \}\par
06515             {\cf19 if} (!ignore_resize)\par
06516                 CalcResizePosSizeFromAnyCorner(window, border_target, ImMin(def.SegmentN1, def.SegmentN2), &pos_target, &size_target);\par
06517         \}\par
06518         {\cf19 if} (hovered)\par
06519             *border_hovered = border_n;\par
06520         {\cf19 if} (held)\par
06521             *border_held = border_n;\par
06522     \}\par
06523     PopID();\par
06524 \par
06525     {\cf20 // Restore nav layer}\par
06526     window->DC.NavLayerCurrent = ImGuiNavLayer_Main;\par
06527 \par
06528     {\cf20 // Navigation resize (keyboard/gamepad)}\par
06529     {\cf20 // FIXME: This cannot be moved to NavUpdateWindowing() because CalcWindowSizeAfterConstraint() need to callback into user.}\par
06530     {\cf20 // Not even sure the callback works here.}\par
06531     {\cf19 if} (g.NavWindowingTarget && g.NavWindowingTarget->RootWindowDockTree == window)\par
06532     \{\par
06533         ImVec2 nav_resize_dir;\par
06534         {\cf19 if} (g.NavInputSource == ImGuiInputSource_Keyboard && g.IO.KeyShift)\par
06535             nav_resize_dir = GetKeyMagnitude2d(ImGuiKey_LeftArrow, ImGuiKey_RightArrow, ImGuiKey_UpArrow, ImGuiKey_DownArrow);\par
06536         {\cf19 if} (g.NavInputSource == ImGuiInputSource_Gamepad)\par
06537             nav_resize_dir = GetKeyMagnitude2d(ImGuiKey_GamepadDpadLeft, ImGuiKey_GamepadDpadRight, ImGuiKey_GamepadDpadUp, ImGuiKey_GamepadDpadDown);\par
06538         {\cf19 if} (nav_resize_dir.x != 0.0f || nav_resize_dir.y != 0.0f)\par
06539         \{\par
06540             {\cf17 const} {\cf18 float} NAV_RESIZE_SPEED = 600.0f;\par
06541             {\cf17 const} {\cf18 float} resize_step = NAV_RESIZE_SPEED * g.IO.DeltaTime * ImMin(g.IO.DisplayFramebufferScale.x, g.IO.DisplayFramebufferScale.y);\par
06542             g.NavWindowingAccumDeltaSize += nav_resize_dir * resize_step;\par
06543             g.NavWindowingAccumDeltaSize = ImMax(g.NavWindowingAccumDeltaSize, clamp_rect.Min - window->Pos - window->Size); {\cf20 // We need Pos+Size >= clmap_rect.Min, so Size >= clmap_rect.Min - Pos, so size_delta >= clmap_rect.Min - window->Pos - window->Size}\par
06544             g.NavWindowingToggleLayer = {\cf17 false};\par
06545             g.NavDisableMouseHover = {\cf17 true};\par
06546             resize_grip_col[0] = GetColorU32(ImGuiCol_ResizeGripActive);\par
06547             ImVec2 accum_floored = ImTrunc(g.NavWindowingAccumDeltaSize);\par
06548             {\cf19 if} (accum_floored.x != 0.0f || accum_floored.y != 0.0f)\par
06549             \{\par
06550                 {\cf20 // FIXME-NAV: Should store and accumulate into a separate size buffer to handle sizing constraints properly, right now a constraint will make us stuck.}\par
06551                 size_target = CalcWindowSizeAfterConstraint(window, window->SizeFull + accum_floored);\par
06552                 g.NavWindowingAccumDeltaSize -= accum_floored;\par
06553             \}\par
06554         \}\par
06555     \}\par
06556 \par
06557     {\cf20 // Apply back modified position/size to window}\par
06558     {\cf17 const} ImVec2 curr_pos = window->Pos;\par
06559     {\cf17 const} ImVec2 curr_size = window->SizeFull;\par
06560     {\cf19 if} (size_target.x != FLT_MAX && (window->Size.x != size_target.x || window->SizeFull.x != size_target.x))\par
06561         window->Size.x = window->SizeFull.x = size_target.x;\par
06562     {\cf19 if} (size_target.y != FLT_MAX && (window->Size.y != size_target.y || window->SizeFull.y != size_target.y))\par
06563         window->Size.y = window->SizeFull.y = size_target.y;\par
