01725 ImRect ImGui::TableGetCellBgRect({\cf17 const} ImGuiTable* table, {\cf18 int} column_n)\par
01726 \{\par
01727     {\cf17 const} ImGuiTableColumn* column = &table->Columns[column_n];\par
01728     {\cf18 float} x1 = column->MinX;\par
01729     {\cf18 float} x2 = column->MaxX;\par
01730     {\cf20 //if (column->PrevEnabledColumn == -1)}\par
01731     {\cf20 //    x1 -= table->OuterPaddingX;}\par
01732     {\cf20 //if (column->NextEnabledColumn == -1)}\par
01733     {\cf20 //    x2 += table->OuterPaddingX;}\par
01734     x1 = ImMax(x1, table->WorkRect.Min.x);\par
01735     x2 = ImMin(x2, table->WorkRect.Max.x);\par
01736     {\cf19 return} ImRect(x1, table->RowPosY1, x2, table->RowPosY2);\par
01737 \}\par
