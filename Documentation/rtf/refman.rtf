01630     {\cf17 const} {\cf18 float} latest_key_analog = latest_event ? latest_event->Key.AnalogValue : key_data->AnalogValue;\par
01631     {\cf19 if} (latest_key_down == down && latest_key_analog == analog_value)\par
01632         {\cf19 return};\par
01633 \par
