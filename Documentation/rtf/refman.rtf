16381 {\cf20 // Garbage collect unused nodes (run once at init time)}\par
16382 {\cf17 static} {\cf18 void} ImGui::DockContextPruneUnusedSettingsNodes(ImGuiContext* ctx)\par
16383 \{\par
16384     ImGuiContext& g = *ctx;\par
16385     ImGuiDockContext* dc = &ctx->DockContext;\par
16386     IM_ASSERT(g.Windows.Size == 0);\par
16387 \par
16388     ImPool<ImGuiDockContextPruneNodeData> pool;\par
16389     pool.Reserve(dc->NodesSettings.Size);\par
16390 \par
16391     {\cf20 // Count child nodes and compute RootID}\par
16392     {\cf19 for} ({\cf18 int} settings_n = 0; settings_n < dc->NodesSettings.Size; settings_n++)\par
16393     \{\par
16394         ImGuiDockNodeSettings* settings = &dc->NodesSettings[settings_n];\par
16395         ImGuiDockContextPruneNodeData* parent_data = settings->ParentNodeId ? pool.GetByKey(settings->ParentNodeId) : 0;\par
16396         pool.GetOrAddByKey(settings->ID)->RootId = parent_data ? parent_data->RootId : settings->ID;\par
16397         {\cf19 if} (settings->ParentNodeId)\par
16398             pool.GetOrAddByKey(settings->ParentNodeId)->CountChildNodes++;\par
16399     \}\par
16400 \par
16401     {\cf20 // Count reference to dock ids from dockspaces}\par
16402     {\cf20 // We track the 'auto-DockNode <- manual-Window <- manual-DockSpace' in order to avoid 'auto-DockNode' being ditched by DockContextPruneUnusedSettingsNodes()}\par
16403     {\cf19 for} ({\cf18 int} settings_n = 0; settings_n < dc->NodesSettings.Size; settings_n++)\par
16404     \{\par
16405         ImGuiDockNodeSettings* settings = &dc->NodesSettings[settings_n];\par
16406         {\cf19 if} (settings->ParentWindowId != 0)\par
16407             {\cf19 if} (ImGuiWindowSettings* window_settings = FindWindowSettingsByID(settings->ParentWindowId))\par
16408                 {\cf19 if} (window_settings->DockId)\par
16409                     {\cf19 if} (ImGuiDockContextPruneNodeData* data = pool.GetByKey(window_settings->DockId))\par
16410                         data->CountChildNodes++;\par
16411     \}\par
16412 \par
16413     {\cf20 // Count reference to dock ids from window settings}\par
16414     {\cf20 // We guard against the possibility of an invalid .ini file (RootID may point to a missing node)}\par
16415     {\cf19 for} (ImGuiWindowSettings* settings = g.SettingsWindows.begin(); settings != NULL; settings = g.SettingsWindows.next_chunk(settings))\par
16416         {\cf19 if} (ImGuiID dock_id = settings->DockId)\par
16417             {\cf19 if} (ImGuiDockContextPruneNodeData* data = pool.GetByKey(dock_id))\par
16418             \{\par
16419                 data->CountWindows++;\par
16420                 {\cf19 if} (ImGuiDockContextPruneNodeData* data_root = (data->RootId == dock_id) ? data : pool.GetByKey(data->RootId))\par
16421                     data_root->CountChildWindows++;\par
16422             \}\par
16423 \par
16424     {\cf20 // Prune}\par
16425     {\cf19 for} ({\cf18 int} settings_n = 0; settings_n < dc->NodesSettings.Size; settings_n++)\par
16426     \{\par
16427         ImGuiDockNodeSettings* settings = &dc->NodesSettings[settings_n];\par
16428         ImGuiDockContextPruneNodeData* data = pool.GetByKey(settings->ID);\par
16429         {\cf19 if} (data->CountWindows > 1)\par
16430             {\cf19 continue};\par
16431         ImGuiDockContextPruneNodeData* data_root = (data->RootId == settings->ID) ? data : pool.GetByKey(data->RootId);\par
16432 \par
16433         {\cf18 bool} remove = {\cf17 false};\par
16434         remove |= (data->CountWindows == 1 && settings->ParentNodeId == 0 && data->CountChildNodes == 0 && !(settings->Flags & ImGuiDockNodeFlags_CentralNode));  {\cf20 // Floating root node with only 1 window}\par
16435         remove |= (data->CountWindows == 0 && settings->ParentNodeId == 0 && data->CountChildNodes == 0); {\cf20 // Leaf nodes with 0 window}\par
16436         remove |= (data_root->CountChildWindows == 0);\par
16437         {\cf19 if} (remove)\par
16438         \{\par
16439             IMGUI_DEBUG_LOG_DOCKING({\cf22 "[docking] DockContextPruneUnusedSettingsNodes: Prune 0x%08X\\n"}, settings->ID);\par
16440             DockSettingsRemoveNodeReferences(&settings->ID, 1);\par
16441             settings->ID = 0;\par
16442         \}\par
16443     \}\par
16444 \}\par
