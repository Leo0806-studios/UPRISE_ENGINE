20226         \{ 2, 0, {\cf22 ""}, ImGuiKey_LeftShift \},\{ 2, 1, {\cf22 "Z"}, ImGuiKey_Z \}, \{ 2, 2, {\cf22 "X"}, ImGuiKey_X \}, \{ 2, 3, {\cf22 "C"}, ImGuiKey_C \}, \{ 2, 4, {\cf22 "V"}, ImGuiKey_V \}\par
20227     \};\par
