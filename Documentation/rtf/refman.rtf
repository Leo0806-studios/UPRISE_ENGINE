00656     glBlendEquationSeparate(last_blend_equation_rgb, last_blend_equation_alpha);\par
00657     glBlendFuncSeparate(last_blend_src_rgb, last_blend_dst_rgb, last_blend_src_alpha, last_blend_dst_alpha);\par
