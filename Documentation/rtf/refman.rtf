05575 ImVec2 ImGui::CalcTextSize({\cf17 const} {\cf18 char}* text, {\cf17 const} {\cf18 char}* text_end, {\cf18 bool} hide_text_after_double_hash, {\cf18 float} wrap_width)\par
05576 \{\par
05577     ImGuiContext& g = *GImGui;\par
