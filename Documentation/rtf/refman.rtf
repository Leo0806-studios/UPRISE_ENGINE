13672 \{\par
13673     ImGuiContext& g = *GImGui;\par
13674     ImGuiIO& io = g.IO;\par
13675 \par
13676     ImGuiWindow* apply_focus_window = NULL;\par
13677     {\cf18 bool} apply_toggle_layer = {\cf17 false};\par
13678 \par
13679     ImGuiWindow* modal_window = GetTopMostPopupModal();\par
13680     {\cf18 bool} allow_windowing = (modal_window == NULL); {\cf20 // FIXME: This prevent CTRL+TAB from being usable with windows that are inside the Begin-stack of that modal.}\par
