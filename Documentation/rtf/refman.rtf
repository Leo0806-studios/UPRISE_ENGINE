04189 {\cf18 bool} ImGui::IsWindowContentHoverable(ImGuiWindow* window, ImGuiHoveredFlags flags)\par
04190 \{\par
04191     {\cf20 // An active popup disable hovering on other windows (apart from its own children)}\par
04192     {\cf20 // FIXME-OPT: This could be cached/stored within the window.}\par
04193     ImGuiContext& g = *GImGui;\par
04194     {\cf19 if} (g.NavWindow)\par
04195         {\cf19 if} (ImGuiWindow* focused_root_window = g.NavWindow->RootWindowDockTree)\par
04196             {\cf19 if} (focused_root_window->WasActive && focused_root_window != window->RootWindowDockTree)\par
04197             \{\par
04198                 {\cf20 // For the purpose of those flags we differentiate "standard popup" from "modal popup"}\par
04199                 {\cf20 // NB: The 'else' is important because Modal windows are also Popups.}\par
04200                 {\cf18 bool} want_inhibit = {\cf17 false};\par
04201                 {\cf19 if} (focused_root_window->Flags & ImGuiWindowFlags_Modal)\par
04202                     want_inhibit = {\cf17 true};\par
04203                 {\cf19 else} {\cf19 if} ((focused_root_window->Flags & ImGuiWindowFlags_Popup) && !(flags & ImGuiHoveredFlags_AllowWhenBlockedByPopup))\par
04204                     want_inhibit = {\cf17 true};\par
04205 \par
04206                 {\cf20 // Inhibit hover unless the window is within the stack of our modal/popup}\par
04207                 {\cf19 if} (want_inhibit)\par
04208                     {\cf19 if} (!IsWindowWithinBeginStackOf(window->RootWindow, focused_root_window))\par
04209                         {\cf19 return} {\cf17 false};\par
04210             \}\par
04211 \par
04212     {\cf20 // Filter by viewport}\par
04213     {\cf19 if} (window->Viewport != g.MouseViewport)\par
04214         {\cf19 if} (g.MovingWindow == NULL || window->RootWindowDockTree != g.MovingWindow->RootWindowDockTree)\par
04215             {\cf19 return} {\cf17 false};\par
04216 \par
04217     {\cf19 return} {\cf17 true};\par
04218 \}\par
