08311 {\cf20 // Is current window hovered and hoverable (e.g. not blocked by a popup/modal)? See ImGuiHoveredFlags_ for options.}\par
08312 {\cf20 // IMPORTANT: If you are trying to check whether your mouse should be dispatched to Dear ImGui or to your underlying app,}\par
08313 {\cf20 // you should not use this function! Use the 'io.WantCaptureMouse' boolean for that!}\par
08314 {\cf20 // Refer to FAQ entry "How can I tell whether to dispatch mouse/keyboard to Dear ImGui or my application?" for details.}\par
08315 {\cf18 bool} ImGui::IsWindowHovered(ImGuiHoveredFlags flags)\par
08316 \{\par
08317     IM_ASSERT((flags & ~ImGuiHoveredFlags_AllowedMaskForIsWindowHovered) == 0 && {\cf22 "Invalid flags for IsWindowHovered()!"});\par
08318 \par
08319     ImGuiContext& g = *GImGui;\par
08320     ImGuiWindow* ref_window = g.HoveredWindow;\par
08321     ImGuiWindow* cur_window = g.CurrentWindow;\par
08322     {\cf19 if} (ref_window == NULL)\par
08323         {\cf19 return} {\cf17 false};\par
08324 \par
08325     {\cf19 if} ((flags & ImGuiHoveredFlags_AnyWindow) == 0)\par
08326     \{\par
08327         IM_ASSERT(cur_window); {\cf20 // Not inside a Begin()/End()}\par
08328         {\cf17 const} {\cf18 bool} popup_hierarchy = (flags & ImGuiHoveredFlags_NoPopupHierarchy) == 0;\par
08329         {\cf17 const} {\cf18 bool} dock_hierarchy = (flags & ImGuiHoveredFlags_DockHierarchy) != 0;\par
08330         {\cf19 if} (flags & ImGuiHoveredFlags_RootWindow)\par
08331             cur_window = GetCombinedRootWindow(cur_window, popup_hierarchy, dock_hierarchy);\par
08332 \par
08333         {\cf18 bool} result;\par
08334         {\cf19 if} (flags & ImGuiHoveredFlags_ChildWindows)\par
08335             result = IsWindowChildOf(ref_window, cur_window, popup_hierarchy, dock_hierarchy);\par
08336         {\cf19 else}\par
08337             result = (ref_window == cur_window);\par
08338         {\cf19 if} (!result)\par
08339             {\cf19 return} {\cf17 false};\par
08340     \}\par
08341 \par
08342     {\cf19 if} (!IsWindowContentHoverable(ref_window, flags))\par
08343         {\cf19 return} {\cf17 false};\par
08344     {\cf19 if} (!(flags & ImGuiHoveredFlags_AllowWhenBlockedByActiveItem))\par
08345         {\cf19 if} (g.ActiveId != 0 && !g.ActiveIdAllowOverlap && g.ActiveId != ref_window->MoveId)\par
08346             {\cf19 return} {\cf17 false};\par
08347 \par
08348     {\cf20 // When changing hovered window we requires a bit of stationary delay before activating hover timer.}\par
08349     {\cf20 // FIXME: We don't support delay other than stationary one for now, other delay would need a way}\par
08350     {\cf20 // to fulfill the possibility that multiple IsWindowHovered() with varying flag could return true}\par
08351     {\cf20 // for different windows of the hierarchy. Possibly need a Hash(Current+Flags) ==> (Timer) cache.}\par
