00560 \par
00561     {\cf20 // Render command lists}\par
00562     {\cf19 for} ({\cf18 int} n = 0; n < draw_data->CmdListsCount; n++)\par
00563     \{\par
00564         {\cf17 const} ImDrawList* cmd_list = draw_data->CmdLists[n];\par
00565 \par
00566         {\cf20 // Upload vertex/index buffers}\par
00567         {\cf20 // - OpenGL drivers are in a very sorry state nowadays....}\par
00568         {\cf20 //   During 2021 we attempted to switch from glBufferData() to orphaning+glBufferSubData() following reports}\par
00569         {\cf20 //   of leaks on Intel GPU when using multi-viewports on Windows.}\par
00570         {\cf20 // - After this we kept hearing of various display corruptions issues. We started disabling on non-Intel GPU, but issues still got reported on Intel.}\par
00571         {\cf20 // - We are now back to using exclusively glBufferData(). So bd->UseBufferSubData IS ALWAYS FALSE in this code.}\par
00572         {\cf20 //   We are keeping the old code path for a while in case people finding new issues may want to test the bd->UseBufferSubData path.}\par
