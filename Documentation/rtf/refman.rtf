02170     {\cf18 float}* p_max_pos_x;\par
02171     {\cf19 if} (table->RowFlags & ImGuiTableRowFlags_Headers)\par
02172         p_max_pos_x = &column->ContentMaxXHeadersUsed;  {\cf20 // Useful in case user submit contents in header row that is not a TableHeader() call}\par
02173     {\cf19 else}\par
02174         p_max_pos_x = table->IsUnfrozenRows ? &column->ContentMaxXUnfrozen : &column->ContentMaxXFrozen;\par
02175     *p_max_pos_x = ImMax(*p_max_pos_x, window->DC.CursorMaxPos.x);\par
