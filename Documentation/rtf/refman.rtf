00704 {\cf18 void} ImDrawList::PrimQuadUV({\cf17 const} ImVec2& a, {\cf17 const} ImVec2& b, {\cf17 const} ImVec2& c, {\cf17 const} ImVec2& d, {\cf17 const} ImVec2& uv_a, {\cf17 const} ImVec2& uv_b, {\cf17 const} ImVec2& uv_c, {\cf17 const} ImVec2& uv_d, ImU32 col)\par
