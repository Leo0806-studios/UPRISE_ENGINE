01469 {\cf20 // UTF16 strings use surrogate pairs to encode codepoints >= 0x10000, so}\par
01470 {\cf20 // we should save the high surrogate.}\par
01471 {\cf18 void} ImGuiIO::AddInputCharacterUTF16(ImWchar16 c)\par
01472 \{\par
01473     {\cf19 if} ((c == 0 && InputQueueSurrogate == 0) || !AppAcceptingEvents)\par
01474         {\cf19 return};\par
01475 \par
01476     {\cf19 if} ((c & 0xFC00) == 0xD800) {\cf20 // High surrogate, must save}\par
01477     \{\par
01478         {\cf19 if} (InputQueueSurrogate != 0)\par
01479             AddInputCharacter(IM_UNICODE_CODEPOINT_INVALID);\par
01480         InputQueueSurrogate = c;\par
01481         {\cf19 return};\par
01482     \}\par
01483 \par
01484     ImWchar cp = c;\par
01485     {\cf19 if} (InputQueueSurrogate != 0)\par
01486     \{\par
01487         {\cf19 if} ((c & 0xFC00) != 0xDC00) {\cf20 // Invalid low surrogate}\par
01488         \{\par
01489             AddInputCharacter(IM_UNICODE_CODEPOINT_INVALID);\par
01490         \}\par
01491         {\cf19 else}\par
01492         \{\par
01493 {\cf21 #if IM_UNICODE_CODEPOINT_MAX == 0xFFFF}\par
01494             cp = IM_UNICODE_CODEPOINT_INVALID; {\cf20 // Codepoint will not fit in ImWchar}\par
01495 {\cf21 #else}\par
01496             cp = (ImWchar)(((InputQueueSurrogate - 0xD800) << 10) + (c - 0xDC00) + 0x10000);\par
01497 {\cf21 #endif}\par
01498         \}\par
01499 \par
01500         InputQueueSurrogate = 0;\par
01501     \}\par
01502     AddInputCharacter(({\cf18 unsigned})cp);\par
01503 \}\par
