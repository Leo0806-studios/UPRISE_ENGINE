00534     GLenum last_blend_dst_rgb; glGetIntegerv(GL_BLEND_DST_RGB, (GLint*)&last_blend_dst_rgb);\par
00535     GLenum last_blend_src_alpha; glGetIntegerv(GL_BLEND_SRC_ALPHA, (GLint*)&last_blend_src_alpha);\par
00536     GLenum last_blend_dst_alpha; glGetIntegerv(GL_BLEND_DST_ALPHA, (GLint*)&last_blend_dst_alpha);\par
00537     GLenum last_blend_equation_rgb; glGetIntegerv(GL_BLEND_EQUATION_RGB, (GLint*)&last_blend_equation_rgb);\par
00538     GLenum last_blend_equation_alpha; glGetIntegerv(GL_BLEND_EQUATION_ALPHA, (GLint*)&last_blend_equation_alpha);\par
00539     GLboolean last_enable_blend = glIsEnabled(GL_BLEND);\par
00540     GLboolean last_enable_cull_face = glIsEnabled(GL_CULL_FACE);\par
00541     GLboolean last_enable_depth_test = glIsEnabled(GL_DEPTH_TEST);\par
00542     GLboolean last_enable_stencil_test = glIsEnabled(GL_STENCIL_TEST);\par
00543     GLboolean last_enable_scissor_test = glIsEnabled(GL_SCISSOR_TEST);\par
