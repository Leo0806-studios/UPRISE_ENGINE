00111                 *{\cf17 reinterpret_cast<}{\cf18 int}*{\cf17 >}(vendor) = data_[0][1];\par
00112                 *{\cf17 reinterpret_cast<}{\cf18 int}*{\cf17 >}(vendor + 4) = data_[0][3];\par
00113                 *{\cf17 reinterpret_cast<}{\cf18 int}*{\cf17 >}(vendor + 8) = data_[0][2];\par
