22021 {\cf20 // ID Stack Tool: Display UI}\par
22022 {\cf18 void} ImGui::ShowIDStackToolWindow({\cf18 bool}* p_open)\par
22023 \{\par
22024     ImGuiContext& g = *GImGui;\par
22025     {\cf19 if} (!(g.NextWindowData.Flags & ImGuiNextWindowDataFlags_HasSize))\par
22026         SetNextWindowSize(ImVec2(0.0f, GetFontSize() * 8.0f), ImGuiCond_FirstUseEver);\par
22027     {\cf19 if} (!Begin({\cf22 "Dear ImGui ID Stack Tool"}, p_open) || GetCurrentWindow()->BeginCount > 1)\par
22028     \{\par
22029         End();\par
22030         {\cf19 return};\par
22031     \}\par
22032 \par
22033     {\cf20 // Display hovered/active status}\par
22034     ImGuiIDStackTool* tool = &g.DebugIDStackTool;\par
22035     {\cf17 const} ImGuiID hovered_id = g.HoveredIdPreviousFrame;\par
22036     {\cf17 const} ImGuiID active_id = g.ActiveId;\par
22037 {\cf21 #ifdef IMGUI_ENABLE_TEST_ENGINE}\par
22038     Text({\cf22 "HoveredId: 0x%08X (\\"%s\\"), ActiveId:  0x%08X (\\"%s\\")"}, hovered_id, hovered_id ? ImGuiTestEngine_FindItemDebugLabel(&g, hovered_id) : {\cf22 ""}, active_id, active_id ? ImGuiTestEngine_FindItemDebugLabel(&g, active_id) : {\cf22 ""});\par
22039 {\cf21 #else}\par
22040     Text({\cf22 "HoveredId: 0x%08X, ActiveId:  0x%08X"}, hovered_id, active_id);\par
22041 {\cf21 #endif}\par
22042     SameLine();\par
22043     MetricsHelpMarker({\cf22 "Hover an item with the mouse to display elements of the ID Stack leading to the item's final ID.\\nEach level of the stack correspond to a PushID() call.\\nAll levels of the stack are hashed together to make the final ID of a widget (ID displayed at the bottom level of the stack).\\nRead FAQ entry about the ID stack for details."});\par
22044 \par
22045     {\cf20 // CTRL+C to copy path}\par
22046     {\cf17 const} {\cf18 float} time_since_copy = (float)g.Time - tool->CopyToClipboardLastTime;\par
22047     Checkbox({\cf22 "Ctrl+C: copy path to clipboard"}, &tool->CopyToClipboardOnCtrlC);\par
22048     SameLine();\par
22049     TextColored((time_since_copy >= 0.0f && time_since_copy < 0.75f && ImFmod(time_since_copy, 0.25f) < 0.25f * 0.5f) ? ImVec4(1.f, 1.f, 0.3f, 1.f) : ImVec4(), {\cf22 "*COPIED*"});\par
22050     {\cf19 if} (tool->CopyToClipboardOnCtrlC && Shortcut(ImGuiMod_Ctrl | ImGuiKey_C, ImGuiInputFlags_RouteGlobal | ImGuiInputFlags_RouteOverFocused))\par
22051     \{\par
22052         tool->CopyToClipboardLastTime = (float)g.Time;\par
22053         {\cf18 char}* p = g.TempBuffer.Data;\par
22054         {\cf18 char}* p_end = p + g.TempBuffer.Size;\par
22055         {\cf19 for} ({\cf18 int} stack_n = 0; stack_n < tool->Results.Size && p + 3 < p_end; stack_n++)\par
22056         \{\par
22057             *p++ = {\cf23 '/'};\par
22058             {\cf18 char} level_desc[256];\par
22059             StackToolFormatLevelInfo(tool, stack_n, {\cf17 false}, level_desc, IM_ARRAYSIZE(level_desc));\par
22060             {\cf19 for} ({\cf18 int} n = 0; level_desc[n] && p + 2 < p_end; n++)\par
22061             \{\par
22062                 {\cf19 if} (level_desc[n] == {\cf23 '/'})\par
22063                     *p++ = {\cf23 '\\\\'};\par
22064                 *p++ = level_desc[n];\par
22065             \}\par
22066         \}\par
22067         *p = {\cf23 '\\0'};\par
22068         SetClipboardText(g.TempBuffer.Data);\par
22069     \}\par
22070 \par
22071     {\cf20 // Display decorated stack}\par
22072     tool->LastActiveFrame = g.FrameCount;\par
22073     {\cf19 if} (tool->Results.Size > 0 && BeginTable({\cf22 "##table"}, 3, ImGuiTableFlags_Borders))\par
22074     \{\par
22075         {\cf17 const} {\cf18 float} id_width = CalcTextSize({\cf22 "0xDDDDDDDD"}).x;\par
22076         TableSetupColumn({\cf22 "Seed"}, ImGuiTableColumnFlags_WidthFixed, id_width);\par
22077         TableSetupColumn({\cf22 "PushID"}, ImGuiTableColumnFlags_WidthStretch);\par
22078         TableSetupColumn({\cf22 "Result"}, ImGuiTableColumnFlags_WidthFixed, id_width);\par
22079         TableHeadersRow();\par
22080         {\cf19 for} ({\cf18 int} n = 0; n < tool->Results.Size; n++)\par
22081         \{\par
22082             ImGuiStackLevelInfo* info = &tool->Results[n];\par
22083             TableNextColumn();\par
22084             Text({\cf22 "0x%08X"}, (n > 0) ? tool->Results[n - 1].ID : 0);\par
22085             TableNextColumn();\par
22086             StackToolFormatLevelInfo(tool, n, {\cf17 true}, g.TempBuffer.Data, g.TempBuffer.Size);\par
22087             TextUnformatted(g.TempBuffer.Data);\par
22088             TableNextColumn();\par
22089             Text({\cf22 "0x%08X"}, info->ID);\par
22090             {\cf19 if} (n == tool->Results.Size - 1)\par
22091                 TableSetBgColor(ImGuiTableBgTarget_CellBg, GetColorU32(ImGuiCol_Header));\par
22092         \}\par
