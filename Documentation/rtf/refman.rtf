19842         \}\par
19843         {\cf19 if} (node_settings->SplitAxis != ImGuiAxis_None)\par
19844             buf->appendf({\cf22 " Split=%c"}, (node_settings->SplitAxis == ImGuiAxis_X) ? {\cf23 'X'} : {\cf23 'Y'});\par
19845         {\cf19 if} (node_settings->Flags & ImGuiDockNodeFlags_NoResize)\par
19846             buf->appendf({\cf22 " NoResize=1"});\par
19847         {\cf19 if} (node_settings->Flags & ImGuiDockNodeFlags_CentralNode)\par
19848             buf->appendf({\cf22 " CentralNode=1"});\par
19849         {\cf19 if} (node_settings->Flags & ImGuiDockNodeFlags_NoTabBar)\par
19850             buf->appendf({\cf22 " NoTabBar=1"});\par
19851         {\cf19 if} (node_settings->Flags & ImGuiDockNodeFlags_HiddenTabBar)\par
