02907         Buf.reserve(needed_sz > new_capacity ? needed_sz : new_capacity);\par
02908     \}\par
02909 \par
02910     Buf.resize(needed_sz);\par
02911     ImFormatStringV(&Buf[write_off - 1], ({\cf18 size_t})len + 1, fmt, args_copy);\par
02912     va_end(args_copy);\par
02913 \}\par
