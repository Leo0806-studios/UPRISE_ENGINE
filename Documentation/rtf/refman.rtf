00717 {\cf20 // Adjust flags: default width mode + stretch columns are not allowed when auto extending}\par
00718 {\cf17 static} {\cf18 void} TableSetupColumnFlags(ImGuiTable* table, ImGuiTableColumn* column, ImGuiTableColumnFlags flags_in)\par
00719 \{\par
00720     ImGuiTableColumnFlags flags = flags_in;\par
