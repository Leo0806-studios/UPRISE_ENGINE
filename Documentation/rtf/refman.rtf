01830 ImVec2 ImBezierCubicClosestPoint({\cf17 const} ImVec2& p1, {\cf17 const} ImVec2& p2, {\cf17 const} ImVec2& p3, {\cf17 const} ImVec2& p4, {\cf17 const} ImVec2& p, {\cf18 int} num_segments)\par
01831 \{\par
01832     IM_ASSERT(num_segments > 0); {\cf20 // Use ImBezierCubicClosestPointCasteljau()}\par
01833     ImVec2 p_last = p1;\par
01834     ImVec2 p_closest;\par
01835     {\cf18 float} p_closest_dist2 = FLT_MAX;\par
01836     {\cf18 float} t_step = 1.0f / (float)num_segments;\par
01837     {\cf19 for} ({\cf18 int} i_step = 1; i_step <= num_segments; i_step++)\par
01838     \{\par
01839         ImVec2 p_current = ImBezierCubicCalc(p1, p2, p3, p4, t_step * i_step);\par
01840         ImVec2 p_line = ImLineClosestPoint(p_last, p_current, p);\par
01841         {\cf18 float} dist2 = ImLengthSqr(p - p_line);\par
01842         {\cf19 if} (dist2 < p_closest_dist2)\par
01843         \{\par
01844             p_closest = p_line;\par
01845             p_closest_dist2 = dist2;\par
01846         \}\par
01847         p_last = p_current;\par
01848     \}\par
01849     {\cf19 return} p_closest;\par
01850 \}\par
01851 \par
01852 {\cf20 // Closely mimics PathBezierToCasteljau() in imgui_draw.cpp}\par
01853 {\cf17 static} {\cf18 void} ImBezierCubicClosestPointCasteljauStep({\cf17 const} ImVec2& p, ImVec2& p_closest, ImVec2& p_last, {\cf18 float}& p_closest_dist2, {\cf18 float} x1, {\cf18 float} y1, {\cf18 float} x2, {\cf18 float} y2, {\cf18 float} x3, {\cf18 float} y3, {\cf18 float} x4, {\cf18 float} y4, {\cf18 float} tess_tol, {\cf18 int} level)\par
01854 \{\par
01855     {\cf18 float} dx = x4 - x1;\par
01856     {\cf18 float} dy = y4 - y1;\par
01857     {\cf18 float} d2 = ((x2 - x4) * dy - (y2 - y4) * dx);\par
01858     {\cf18 float} d3 = ((x3 - x4) * dy - (y3 - y4) * dx);\par
01859     d2 = (d2 >= 0) ? d2 : -d2;\par
01860     d3 = (d3 >= 0) ? d3 : -d3;\par
01861     {\cf19 if} ((d2 + d3) * (d2 + d3) < tess_tol * (dx * dx + dy * dy))\par
01862     \{\par
01863         ImVec2 p_current(x4, y4);\par
01864         ImVec2 p_line = ImLineClosestPoint(p_last, p_current, p);\par
01865         {\cf18 float} dist2 = ImLengthSqr(p - p_line);\par
01866         {\cf19 if} (dist2 < p_closest_dist2)\par
01867         \{\par
01868             p_closest = p_line;\par
01869             p_closest_dist2 = dist2;\par
01870         \}\par
01871         p_last = p_current;\par
01872     \}\par
01873     {\cf19 else} {\cf19 if} (level < 10)\par
01874     \{\par
01875         {\cf18 float} x12 = (x1 + x2)*0.5f,       y12 = (y1 + y2)*0.5f;\par
01876         {\cf18 float} x23 = (x2 + x3)*0.5f,       y23 = (y2 + y3)*0.5f;\par
01877         {\cf18 float} x34 = (x3 + x4)*0.5f,       y34 = (y3 + y4)*0.5f;\par
01878         {\cf18 float} x123 = (x12 + x23)*0.5f,    y123 = (y12 + y23)*0.5f;\par
01879         {\cf18 float} x234 = (x23 + x34)*0.5f,    y234 = (y23 + y34)*0.5f;\par
01880         {\cf18 float} x1234 = (x123 + x234)*0.5f, y1234 = (y123 + y234)*0.5f;\par
01881         ImBezierCubicClosestPointCasteljauStep(p, p_closest, p_last, p_closest_dist2, x1, y1, x12, y12, x123, y123, x1234, y1234, tess_tol, level + 1);\par
01882         ImBezierCubicClosestPointCasteljauStep(p, p_closest, p_last, p_closest_dist2, x1234, y1234, x234, y234, x34, y34, x4, y4, tess_tol, level + 1);\par
01883     \}\par
01884 \}\par
01885 \par
01886 {\cf20 // tess_tol is generally the same value you would find in ImGui::GetStyle().CurveTessellationTol}\par
01887 {\cf20 // Because those ImXXX functions are lower-level than ImGui:: we cannot access this value automatically.}\par
01888 ImVec2 ImBezierCubicClosestPointCasteljau({\cf17 const} ImVec2& p1, {\cf17 const} ImVec2& p2, {\cf17 const} ImVec2& p3, {\cf17 const} ImVec2& p4, {\cf17 const} ImVec2& p, {\cf18 float} tess_tol)\par
01889 \{\par
01890     IM_ASSERT(tess_tol > 0.0f);\par
01891     ImVec2 p_last = p1;\par
01892     ImVec2 p_closest;\par
01893     {\cf18 float} p_closest_dist2 = FLT_MAX;\par
01894     ImBezierCubicClosestPointCasteljauStep(p, p_closest, p_last, p_closest_dist2, p1.x, p1.y, p2.x, p2.y, p3.x, p3.y, p4.x, p4.y, tess_tol, 0);\par
01895     {\cf19 return} p_closest;\par
01896 \}\par
01897 \par
01898 ImVec2 ImLineClosestPoint({\cf17 const} ImVec2& a, {\cf17 const} ImVec2& b, {\cf17 const} ImVec2& p)\par
01899 \{\par
01900     ImVec2 ap = p - a;\par
01901     ImVec2 ab_dir = b - a;\par
01902     {\cf18 float} dot = ap.x * ab_dir.x + ap.y * ab_dir.y;\par
01903     {\cf19 if} (dot < 0.0f)\par
01904         {\cf19 return} a;\par
01905     {\cf18 float} ab_len_sqr = ab_dir.x * ab_dir.x + ab_dir.y * ab_dir.y;\par
01906     {\cf19 if} (dot > ab_len_sqr)\par
01907         {\cf19 return} b;\par
01908     {\cf19 return} a + ab_dir * dot / ab_len_sqr;\par
01909 \}\par
01910 \par
01911 {\cf18 bool} ImTriangleContainsPoint({\cf17 const} ImVec2& a, {\cf17 const} ImVec2& b, {\cf17 const} ImVec2& c, {\cf17 const} ImVec2& p)\par
01912 \{\par
01913     {\cf18 bool} b1 = ((p.x - b.x) * (a.y - b.y) - (p.y - b.y) * (a.x - b.x)) < 0.0f;\par
01914     {\cf18 bool} b2 = ((p.x - c.x) * (b.y - c.y) - (p.y - c.y) * (b.x - c.x)) < 0.0f;\par
01915     {\cf18 bool} b3 = ((p.x - a.x) * (c.y - a.y) - (p.y - a.y) * (c.x - a.x)) < 0.0f;\par
01916     {\cf19 return} ((b1 == b2) && (b2 == b3));\par
01917 \}\par
01918 \par
01919 {\cf18 void} ImTriangleBarycentricCoords({\cf17 const} ImVec2& a, {\cf17 const} ImVec2& b, {\cf17 const} ImVec2& c, {\cf17 const} ImVec2& p, {\cf18 float}& out_u, {\cf18 float}& out_v, {\cf18 float}& out_w)\par
01920 \{\par
01921     ImVec2 v0 = b - a;\par
01922     ImVec2 v1 = c - a;\par
01923     ImVec2 v2 = p - a;\par
01924     {\cf17 const} {\cf18 float} denom = v0.x * v1.y - v1.x * v0.y;\par
01925     out_v = (v2.x * v1.y - v1.x * v2.y) / denom;\par
01926     out_w = (v0.x * v2.y - v2.x * v0.y) / denom;\par
01927     out_u = 1.0f - out_v - out_w;\par
01928 \}\par
01929 \par
01930 ImVec2 ImTriangleClosestPoint({\cf17 const} ImVec2& a, {\cf17 const} ImVec2& b, {\cf17 const} ImVec2& c, {\cf17 const} ImVec2& p)\par
01931 \{\par
01932     ImVec2 proj_ab = ImLineClosestPoint(a, b, p);\par
01933     ImVec2 proj_bc = ImLineClosestPoint(b, c, p);\par
01934     ImVec2 proj_ca = ImLineClosestPoint(c, a, p);\par
01935     {\cf18 float} dist2_ab = ImLengthSqr(p - proj_ab);\par
01936     {\cf18 float} dist2_bc = ImLengthSqr(p - proj_bc);\par
01937     {\cf18 float} dist2_ca = ImLengthSqr(p - proj_ca);\par
01938     {\cf18 float} m = ImMin(dist2_ab, ImMin(dist2_bc, dist2_ca));\par
01939     {\cf19 if} (m == dist2_ab)\par
01940         {\cf19 return} proj_ab;\par
01941     {\cf19 if} (m == dist2_bc)\par
01942         {\cf19 return} proj_bc;\par
01943     {\cf19 return} proj_ca;\par
01944 \}\par
