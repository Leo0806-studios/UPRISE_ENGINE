02771 {\cf20 // [SECTION] Tables: Sorting}\par
02772 {\cf20 //-------------------------------------------------------------------------}\par
02773 {\cf20 // - TableGetSortSpecs()}\par
02774 {\cf20 // - TableFixColumnSortDirection() [Internal]}\par
02775 {\cf20 // - TableGetColumnNextSortDirection() [Internal]}\par
02776 {\cf20 // - TableSetColumnSortDirection() [Internal]}\par
02777 {\cf20 // - TableSortSpecsSanitize() [Internal]}\par
