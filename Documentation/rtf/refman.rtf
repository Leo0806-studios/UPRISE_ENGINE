00227      vector<Texture> Model::loadMaterialTextures(aiMaterial* mat, aiTextureType type, {\cf18 string} typeName)\par
00228     \{\par
00229 \par
00230         vector<Texture> textures;\par
00231         {\cf19 for} ({\cf18 unsigned} {\cf18 int} i = 0; i < mat->GetTextureCount(type); i++)\par
00232         \{\par
00233             aiString str;\par
00234             mat->GetTexture(type, i, &str);\par
00235             {\cf18 bool} skip = {\cf17 false};\par
00236             {\cf19 for} ({\cf18 unsigned} {\cf18 int} j = 0; j < textures_loaded.size(); j++)\par
00237             \{\par
00238                 {\cf19 if} (std::strcmp(textures_loaded[j].path.data(),\par
00239                     str.C_Str()) == 0)\par
00240                 \{\par
00241                     textures.push_back(textures_loaded[j]);\par
00242                     skip = {\cf17 true};\par
00243                     {\cf19 break};\par
00244                 \}\par
00245             \}\par
00246             {\cf19 if} (!skip)\par
00247             \{ {\cf20 // if texture hasn\'92t been loaded already, load it}\par
00248                 Texture texture;\par
00249                 texture.id = TextureFromFile(str.C_Str(), directory, {\cf17 true});\par
00250                 texture.type = typeName;\par
00251                 texture.path = str.C_Str();\par
00252                 textures.push_back(texture);\par
00253                 textures_loaded.push_back(texture); {\cf20 // add to loaded textures}\par
00254             \}\par
00255         \}\par
00256         {\cf19 return} textures;\par
00257     \}\par
