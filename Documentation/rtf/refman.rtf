04493         entry = &info->LastEntriesBuf[info->LastEntriesIdx];\par
04494         entry->FrameCount = frame_count;\par
04495         entry->AllocCount = entry->FreeCount = 0;\par
04496     \}\par
04497     {\cf19 if} (size != ({\cf18 size_t})-1)\par
04498     \{\par
04499         entry->AllocCount++;\par
04500         info->TotalAllocCount++;\par
04501         {\cf20 //printf("[%05d] MemAlloc(%d) -> 0x%p\\n", frame_count, size, ptr);}\par
04502     \}\par
04503     {\cf19 else}\par
04504     \{\par
04505         entry->FreeCount++;\par
04506         info->TotalFreeCount++;\par
