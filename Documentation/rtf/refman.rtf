17583 {\cf20 // Compare TabItem nodes given the last known DockOrder (will persist in .ini file as hint), used to sort tabs when multiple tabs are added on the same frame.}\par
17584 {\cf17 static} {\cf18 int} IMGUI_CDECL TabItemComparerByDockOrder({\cf17 const} {\cf18 void}* lhs, {\cf17 const} {\cf18 void}* rhs)\par
17585 \{\par
17586     ImGuiWindow* a = (({\cf17 const} ImGuiTabItem*)lhs)->Window;\par
17587     ImGuiWindow* b = (({\cf17 const} ImGuiTabItem*)rhs)->Window;\par
17588     {\cf19 if} ({\cf18 int} d = ((a->DockOrder == -1) ? INT_MAX : a->DockOrder) - ((b->DockOrder == -1) ? INT_MAX : b->DockOrder))\par
17589         {\cf19 return} d;\par
17590     {\cf19 return} (a->BeginOrderWithinContext - b->BeginOrderWithinContext);\par
17591 \}\par
