05523     \{\par
05524         InitViewportDrawData(viewport);\par
05525         {\cf19 if} (viewport->BgFgDrawLists[0] != NULL)\par
05526             AddDrawListToDrawDataEx(&viewport->DrawDataP, viewport->DrawDataBuilder.Layers[0], GetBackgroundDrawList(viewport));\par
05527     \}\par
