02793 {\cf18 void} ImGuiTextFilter::Build()\par
02794 \{\par
02795     Filters.resize(0);\par
02796     ImGuiTextRange input_range(InputBuf, InputBuf + strlen(InputBuf));\par
02797     input_range.split({\cf23 ','}, &Filters);\par
02798 \par
02799     CountGrep = 0;\par
02800     {\cf19 for} (ImGuiTextRange& f : Filters)\par
02801     \{\par
02802         {\cf19 while} (f.b < f.e && ImCharIsBlankA(f.b[0]))\par
02803             f.b++;\par
02804         {\cf19 while} (f.e > f.b && ImCharIsBlankA(f.e[-1]))\par
02805             f.e--;\par
02806         {\cf19 if} (f.empty())\par
02807             {\cf19 continue};\par
02808         {\cf19 if} (f.b[0] != {\cf23 '-'})\par
02809             CountGrep += 1;\par
02810     \}\par
02811 \}\par
