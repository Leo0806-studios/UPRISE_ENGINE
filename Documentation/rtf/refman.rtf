00645     glActiveTexture(last_active_texture);\par
00646 {\cf21 #ifdef IMGUI_IMPL_OPENGL_USE_VERTEX_ARRAY}\par
00647     glBindVertexArray(last_vertex_array_object);\par
00648 {\cf21 #endif}\par
00649     glBindBuffer(GL_ARRAY_BUFFER, last_array_buffer);\par
00650 {\cf21 #ifndef IMGUI_IMPL_OPENGL_USE_VERTEX_ARRAY}\par
00651     glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, last_element_array_buffer);\par
00652     last_vtx_attrib_state_pos.SetState(bd->AttribLocationVtxPos);\par
00653     last_vtx_attrib_state_uv.SetState(bd->AttribLocationVtxUV);\par
00654     last_vtx_attrib_state_color.SetState(bd->AttribLocationVtxColor);\par
