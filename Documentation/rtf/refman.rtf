12386 {\cf17 static} ImGuiDir ImGetDirQuadrantFromDelta({\cf18 float} dx, {\cf18 float} dy)\par
12387 \{\par
12388     {\cf19 if} (ImFabs(dx) > ImFabs(dy))\par
12389         {\cf19 return} (dx > 0.0f) ? ImGuiDir_Right : ImGuiDir_Left;\par
