10763 \{\par
10764     ImGuiContext& g = *GImGui;\par
10765     {\cf19 while} (g.CurrentTable && (g.CurrentTable->OuterWindow == g.CurrentWindow || g.CurrentTable->InnerWindow == g.CurrentWindow))\par
