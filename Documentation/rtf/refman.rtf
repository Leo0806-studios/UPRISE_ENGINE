10025 {\cf17 static} {\cf18 void} LockWheelingWindow(ImGuiWindow* window, {\cf18 float} wheel_amount)\par
10026 \{\par
10027     ImGuiContext& g = *GImGui;\par
10028     {\cf19 if} (window)\par
10029         g.WheelingWindowReleaseTimer = ImMin(g.WheelingWindowReleaseTimer + ImAbs(wheel_amount) * WINDOWS_MOUSE_WHEEL_SCROLL_LOCK_TIMER, WINDOWS_MOUSE_WHEEL_SCROLL_LOCK_TIMER);\par
10030     {\cf19 else}\par
10031         g.WheelingWindowReleaseTimer = 0.0f;\par
10032     {\cf19 if} (g.WheelingWindow == window)\par
10033         {\cf19 return};\par
10034     IMGUI_DEBUG_LOG_IO({\cf22 "[io] LockWheelingWindow() \\"%s\\"\\n"}, window ? window->Name : {\cf22 "NULL"});\par
10035     g.WheelingWindow = window;\par
10036     g.WheelingWindowRefMousePos = g.IO.MousePos;\par
10037     {\cf19 if} (window == NULL)\par
10038     \{\par
10039         g.WheelingWindowStartFrame = -1;\par
10040         g.WheelingAxisAvg = ImVec2(0.0f, 0.0f);\par
10041     \}\par
10042 \}\par
10043 \par
10044 {\cf17 static} ImGuiWindow* FindBestWheelingWindow({\cf17 const} ImVec2& wheel)\par
10045 \{\par
10046     {\cf20 // For each axis, find window in the hierarchy that may want to use scrolling}\par
10047     ImGuiContext& g = *GImGui;\par
10048     ImGuiWindow* windows[2] = \{ NULL, NULL \};\par
10049     {\cf19 for} ({\cf18 int} axis = 0; axis < 2; axis++)\par
10050         {\cf19 if} (wheel[axis] != 0.0f)\par
10051             {\cf19 for} (ImGuiWindow* window = windows[axis] = g.HoveredWindow; window->Flags & ImGuiWindowFlags_ChildWindow; window = windows[axis] = window->ParentWindow)\par
10052             \{\par
10053                 {\cf20 // Bubble up into parent window if:}\par
10054                 {\cf20 // - a child window doesn't allow any scrolling.}\par
10055                 {\cf20 // - a child window has the ImGuiWindowFlags_NoScrollWithMouse flag.}\par
10057                 {\cf17 const} {\cf18 bool} has_scrolling = (window->ScrollMax[axis] != 0.0f);\par
10058                 {\cf17 const} {\cf18 bool} inputs_disabled = (window->Flags & ImGuiWindowFlags_NoScrollWithMouse) && !(window->Flags & ImGuiWindowFlags_NoMouseInputs);\par
10059                 {\cf20 //const bool scrolling_past_limits = (wheel_v < 0.0f) ? (window->Scroll[axis] <= 0.0f) : (window->Scroll[axis] >= window->ScrollMax[axis]);}\par
10060                 {\cf19 if} (has_scrolling && !inputs_disabled) {\cf20 // && !scrolling_past_limits)}\par
10061                     {\cf19 break}; {\cf20 // select this window}\par
10062             \}\par
10063     {\cf19 if} (windows[0] == NULL && windows[1] == NULL)\par
10064         {\cf19 return} NULL;\par
10065 \par
10066     {\cf20 // If there's only one window or only one axis then there's no ambiguity}\par
10067     {\cf19 if} (windows[0] == windows[1] || windows[0] == NULL || windows[1] == NULL)\par
10068         {\cf19 return} windows[1] ? windows[1] : windows[0];\par
10069 \par
10070     {\cf20 // If candidate are different windows we need to decide which one to prioritize}\par
10071     {\cf20 // - First frame: only find a winner if one axis is zero.}\par
10072     {\cf20 // - Subsequent frames: only find a winner when one is more than the other.}\par
10073     {\cf19 if} (g.WheelingWindowStartFrame == -1)\par
10074         g.WheelingWindowStartFrame = g.FrameCount;\par
10075     {\cf19 if} ((g.WheelingWindowStartFrame == g.FrameCount && wheel.x != 0.0f && wheel.y != 0.0f) || (g.WheelingAxisAvg.x == g.WheelingAxisAvg.y))\par
10076     \{\par
10077         g.WheelingWindowWheelRemainder = wheel;\par
10078         {\cf19 return} NULL;\par
10079     \}\par
10080     {\cf19 return} (g.WheelingAxisAvg.x > g.WheelingAxisAvg.y) ? windows[0] : windows[1];\par
10081 \}\par
10082 \par
10083 {\cf20 // Called by NewFrame()}\par
10084 {\cf18 void} ImGui::UpdateMouseWheel()\par
10085 \{\par
10086     {\cf20 // Reset the locked window if we move the mouse or after the timer elapses.}\par
10087     {\cf20 // FIXME: Ideally we could refactor to have one timer for "changing window w/ same axis" and a shorter timer for "changing window or axis w/ other axis" (#3795)}\par
10088     ImGuiContext& g = *GImGui;\par
10089     {\cf19 if} (g.WheelingWindow != NULL)\par
10090     \{\par
10091         g.WheelingWindowReleaseTimer -= g.IO.DeltaTime;\par
10092         {\cf19 if} (IsMousePosValid() && ImLengthSqr(g.IO.MousePos - g.WheelingWindowRefMousePos) > g.IO.MouseDragThreshold * g.IO.MouseDragThreshold)\par
10093             g.WheelingWindowReleaseTimer = 0.0f;\par
10094         {\cf19 if} (g.WheelingWindowReleaseTimer <= 0.0f)\par
10095             LockWheelingWindow(NULL, 0.0f);\par
10096     \}\par
10097 \par
10098     ImVec2 wheel;\par
10099     wheel.x = TestKeyOwner(ImGuiKey_MouseWheelX, ImGuiKeyOwner_NoOwner) ? g.IO.MouseWheelH : 0.0f;\par
10100     wheel.y = TestKeyOwner(ImGuiKey_MouseWheelY, ImGuiKeyOwner_NoOwner) ? g.IO.MouseWheel : 0.0f;\par
10101 \par
10102     {\cf20 //IMGUI_DEBUG_LOG("MouseWheel X:%.3f Y:%.3f\\n", wheel_x, wheel_y);}\par
10103     ImGuiWindow* mouse_window = g.WheelingWindow ? g.WheelingWindow : g.HoveredWindow;\par
10104     {\cf19 if} (!mouse_window || mouse_window->Collapsed)\par
10105         {\cf19 return};\par
10106 \par
10107     {\cf20 // Zoom / Scale window}\par
10108     {\cf20 // FIXME-OBSOLETE: This is an old feature, it still works but pretty much nobody is using it and may be best redesigned.}\par
10109     {\cf19 if} (wheel.y != 0.0f && g.IO.KeyCtrl && g.IO.FontAllowUserScaling)\par
10110     \{\par
10111         LockWheelingWindow(mouse_window, wheel.y);\par
10112         ImGuiWindow* window = mouse_window;\par
10113         {\cf17 const} {\cf18 float} new_font_scale = ImClamp(window->FontWindowScale + g.IO.MouseWheel * 0.10f, 0.50f, 2.50f);\par
10114         {\cf17 const} {\cf18 float} scale = new_font_scale / window->FontWindowScale;\par
10115         window->FontWindowScale = new_font_scale;\par
10116         {\cf19 if} (window == window->RootWindow)\par
10117         \{\par
10118             {\cf17 const} ImVec2 offset = window->Size * (1.0f - scale) * (g.IO.MousePos - window->Pos) / window->Size;\par
10119             SetWindowPos(window, window->Pos + offset, 0);\par
10120             window->Size = ImTrunc(window->Size * scale);\par
10121             window->SizeFull = ImTrunc(window->SizeFull * scale);\par
10122         \}\par
10123         {\cf19 return};\par
10124     \}\par
10125     {\cf19 if} (g.IO.KeyCtrl)\par
10126         {\cf19 return};\par
10127 \par
10128     {\cf20 // Mouse wheel scrolling}\par
10129     {\cf20 // Read about io.MouseWheelRequestAxisSwap and its issue on Mac+Emscripten in UpdateMouseInputs()}\par
10130     {\cf19 if} (g.IO.MouseWheelRequestAxisSwap)\par
10131         wheel = ImVec2(wheel.y, 0.0f);\par
10132 \par
10133     {\cf20 // Maintain a rough average of moving magnitude on both axises}\par
10134     {\cf20 // FIXME: should by based on wall clock time rather than frame-counter}\par
10135     g.WheelingAxisAvg.x = ImExponentialMovingAverage(g.WheelingAxisAvg.x, ImAbs(wheel.x), 30);\par
10136     g.WheelingAxisAvg.y = ImExponentialMovingAverage(g.WheelingAxisAvg.y, ImAbs(wheel.y), 30);\par
10137 \par
10138     {\cf20 // In the rare situation where FindBestWheelingWindow() had to defer first frame of wheeling due to ambiguous main axis, reinject it now.}\par
10139     wheel += g.WheelingWindowWheelRemainder;\par
10140     g.WheelingWindowWheelRemainder = ImVec2(0.0f, 0.0f);\par
10141     {\cf19 if} (wheel.x == 0.0f && wheel.y == 0.0f)\par
10142         {\cf19 return};\par
10143 \par
10144     {\cf20 // Mouse wheel scrolling: find target and apply}\par
10145     {\cf20 // - don't renew lock if axis doesn't apply on the window.}\par
10146     {\cf20 // - select a main axis when both axises are being moved.}\par
10147     {\cf19 if} (ImGuiWindow* window = (g.WheelingWindow ? g.WheelingWindow : FindBestWheelingWindow(wheel)))\par
10148         if (!(window->Flags & ImGuiWindowFlags_NoScrollWithMouse) && !(window->Flags & ImGuiWindowFlags_NoMouseInputs))\par
10149         \{\par
10150             {\cf18 bool} do_scroll[2] = \{ wheel.x != 0.0f && window->ScrollMax.x != 0.0f, wheel.y != 0.0f && window->ScrollMax.y != 0.0f \};\par
10151             {\cf19 if} (do_scroll[ImGuiAxis_X] && do_scroll[ImGuiAxis_Y])\par
10152                 do_scroll[(g.WheelingAxisAvg.x > g.WheelingAxisAvg.y) ? ImGuiAxis_Y : ImGuiAxis_X] = false;\par
10153             {\cf19 if} (do_scroll[ImGuiAxis_X])\par
10154             \{\par
10155                 LockWheelingWindow(window, wheel.x);\par
10156                 {\cf18 float} max_step = window->InnerRect.GetWidth() * 0.67f;\par
10157                 {\cf18 float} scroll_step = ImTrunc(ImMin(2 * window->CalcFontSize(), max_step));\par
10158                 SetScrollX(window, window->Scroll.x - wheel.x * scroll_step);\par
10159                 g.WheelingWindowScrolledFrame = g.FrameCount;\par
10160             \}\par
10161             {\cf19 if} (do_scroll[ImGuiAxis_Y])\par
10162             \{\par
10163                 LockWheelingWindow(window, wheel.y);\par
10164                 {\cf18 float} max_step = window->InnerRect.GetHeight() * 0.67f;\par
10165                 {\cf18 float} scroll_step = ImTrunc(ImMin(5 * window->CalcFontSize(), max_step));\par
10166                 SetScrollY(window, window->Scroll.y - wheel.y * scroll_step);\par
10167                 g.WheelingWindowScrolledFrame = g.FrameCount;\par
10168             \}\par
10169         \}\par
10170 \}\par
