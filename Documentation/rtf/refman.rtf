10898 {\cf18 bool} ImGui::ItemAdd({\cf17 const} ImRect& bb, ImGuiID {\cf18 id}, {\cf17 const} ImRect* nav_bb_arg, ImGuiItemFlags extra_flags)\par
10899 \{\par
10900     ImGuiContext& g = *GImGui;\par
10901     ImGuiWindow* window = g.CurrentWindow;\par
10902 \par
10903     {\cf20 // Set item data}\par
10904     {\cf20 // (DisplayRect is left untouched, made valid when ImGuiItemStatusFlags_HasDisplayRect is set)}\par
10905     g.LastItemData.ID = id;\par
10906     g.LastItemData.Rect = bb;\par
10907     g.LastItemData.NavRect = nav_bb_arg ? *nav_bb_arg : bb;\par
10908     g.LastItemData.InFlags = g.CurrentItemFlags | g.NextItemData.ItemFlags | extra_flags;\par
10909     g.LastItemData.StatusFlags = ImGuiItemStatusFlags_None;\par
10910     {\cf20 // Note: we don't copy 'g.NextItemData.SelectionUserData' to an hypothetical g.LastItemData.SelectionUserData: since the former is not cleared.}\par
10911 \par
10912     {\cf19 if} ({\cf18 id} != 0)\par
10913     \{\par
10914         KeepAliveID({\cf18 id});\par
10915 \par
10916         {\cf20 // Directional navigation processing}\par
10917         {\cf20 // Runs prior to clipping early-out}\par
10918         {\cf20 //  (a) So that NavInitRequest can be honored, for newly opened windows to select a default widget}\par
10919         {\cf20 //  (b) So that we can scroll up/down past clipped items. This adds a small O(N) cost to regular navigation requests}\par
10920         {\cf20 //      unfortunately, but it is still limited to one window. It may not scale very well for windows with ten of}\par
10921         {\cf20 //      thousands of item, but at least NavMoveRequest is only set on user interaction, aka maximum once a frame.}\par
10922         {\cf20 //      We could early out with "if (is_clipped && !g.NavInitRequest) return false;" but when we wouldn't be able}\par
10923         {\cf20 //      to reach unclipped widgets. This would work if user had explicit scrolling control (e.g. mapped on a stick).}\par
10924         {\cf20 // We intentionally don't check if g.NavWindow != NULL because g.NavAnyRequest should only be set when it is non null.}\par
10925         {\cf20 // If we crash on a NULL g.NavWindow we need to fix the bug elsewhere.}\par
10926         {\cf19 if} (!(g.LastItemData.InFlags & ImGuiItemFlags_NoNav))\par
10927         \{\par
10928             {\cf20 // FIMXE-NAV: investigate changing the window tests into a simple 'if (g.NavFocusScopeId == g.CurrentFocusScopeId)' test.}\par
10929             window->DC.NavLayersActiveMaskNext |= (1 << window->DC.NavLayerCurrent);\par
10930             {\cf19 if} (g.NavId == {\cf18 id} || g.NavAnyRequest)\par
10931                 {\cf19 if} (g.NavWindow->RootWindowForNav == window->RootWindowForNav)\par
10932                     {\cf19 if} (window == g.NavWindow || ((window->ChildFlags | g.NavWindow->ChildFlags) & ImGuiChildFlags_NavFlattened))\par
10933                         NavProcessItem();\par
10934         \}\par
10935 \par
10936         {\cf19 if} (g.NextItemData.Flags & ImGuiNextItemDataFlags_HasShortcut)\par
10937             ItemHandleShortcut({\cf18 id});\par
10938     \}\par
10939 \par
10940     {\cf20 // Lightweight clear of SetNextItemXXX data.}\par
10941     g.NextItemData.Flags = ImGuiNextItemDataFlags_None;\par
10942     g.NextItemData.ItemFlags = ImGuiItemFlags_None;\par
10943 \par
10944 {\cf21 #ifdef IMGUI_ENABLE_TEST_ENGINE}\par
10945     {\cf19 if} ({\cf18 id} != 0)\par
10946         IMGUI_TEST_ENGINE_ITEM_ADD({\cf18 id}, g.LastItemData.NavRect, &g.LastItemData);\par
10947 {\cf21 #endif}\par
10948 \par
10949     {\cf20 // Clipping test}\par
10950     {\cf20 // (this is an inline copy of IsClippedEx() so we can reuse the is_rect_visible value, otherwise we'd do 'if (IsClippedEx(bb, id)) return false')}\par
10951     {\cf20 // g.NavActivateId is not necessarily == g.NavId, in the case of remote activation (e.g. shortcuts)}\par
10952     {\cf17 const} {\cf18 bool} is_rect_visible = bb.Overlaps(window->ClipRect);\par
10953     {\cf19 if} (!is_rect_visible)\par
10954         {\cf19 if} ({\cf18 id} == 0 || ({\cf18 id} != g.ActiveId && {\cf18 id} != g.ActiveIdPreviousFrame && {\cf18 id} != g.NavId && {\cf18 id} != g.NavActivateId))\par
10955             {\cf19 if} (!g.ItemUnclipByLog)\par
10956                 {\cf19 return} {\cf17 false};\par
10957 \par
10958     {\cf20 // [DEBUG]}\par
10959 {\cf21 #ifndef IMGUI_DISABLE_DEBUG_TOOLS}\par
10960     {\cf19 if} ({\cf18 id} != 0)\par
10961     \{\par
10962         {\cf19 if} ({\cf18 id} == g.DebugLocateId)\par
10963             DebugLocateItemResolveWithLastItem();\par
10964 \par
10965         {\cf20 // [DEBUG] People keep stumbling on this problem and using "" as identifier in the root of a window instead of "##something".}\par
