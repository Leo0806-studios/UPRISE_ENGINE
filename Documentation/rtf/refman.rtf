17623 {\cf17 static} {\cf18 void} ImGui::DockNodeWindowMenuUpdate(ImGuiDockNode* node, ImGuiTabBar* tab_bar)\par
17624 \{\par
17625     {\cf20 // Try to position the menu so it is more likely to stays within the same viewport}\par
17626     ImGuiContext& g = *GImGui;\par
