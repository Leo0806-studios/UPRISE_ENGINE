15801 {\cf20 // This is a default/basic function for performing the rendering/swap of multiple Platform Windows.}\par
15802 {\cf20 // Custom renderers may prefer to not call this function at all, and instead iterate the publicly exposed platform data and handle rendering/sync themselves.}\par
15803 {\cf20 // The Render/Swap functions stored in ImGuiPlatformIO are merely here to allow for this helper to exist, but you can do it yourself:}\par
15804 {\cf20 //}\par
15805 {\cf20 //    ImGuiPlatformIO& platform_io = ImGui::GetPlatformIO();}\par
15806 {\cf20 //    for (int i = 1; i < platform_io.Viewports.Size; i++)}\par
15807 {\cf20 //        if ((platform_io.Viewports[i]->Flags & ImGuiViewportFlags_Minimized) == 0)}\par
15808 {\cf20 //            MyRenderFunction(platform_io.Viewports[i], my_args);}\par
15809 {\cf20 //    for (int i = 1; i < platform_io.Viewports.Size; i++)}\par
15810 {\cf20 //        if ((platform_io.Viewports[i]->Flags & ImGuiViewportFlags_Minimized) == 0)}\par
15811 {\cf20 //            MySwapBufferFunction(platform_io.Viewports[i], my_args);}\par
15812 {\cf20 //}\par
15813 {\cf18 void} ImGui::RenderPlatformWindowsDefault({\cf18 void}* platform_render_arg, {\cf18 void}* renderer_render_arg)\par
15814 \{\par
15815     {\cf20 // Skip the main viewport (index 0), which is always fully handled by the application!}\par
15816     ImGuiPlatformIO& platform_io = ImGui::GetPlatformIO();\par
15817     {\cf19 for} ({\cf18 int} i = 1; i < platform_io.Viewports.Size; i++)\par
15818     \{\par
15819         ImGuiViewport* viewport = platform_io.Viewports[i];\par
15820         {\cf19 if} (viewport->Flags & ImGuiViewportFlags_IsMinimized)\par
15821             {\cf19 continue};\par
15822         {\cf19 if} (platform_io.Platform_RenderWindow) platform_io.Platform_RenderWindow(viewport, platform_render_arg);\par
15823         {\cf19 if} (platform_io.Renderer_RenderWindow) platform_io.Renderer_RenderWindow(viewport, renderer_render_arg);\par
15824     \}\par
15825     {\cf19 for} ({\cf18 int} i = 1; i < platform_io.Viewports.Size; i++)\par
15826     \{\par
15827         ImGuiViewport* viewport = platform_io.Viewports[i];\par
15828         {\cf19 if} (viewport->Flags & ImGuiViewportFlags_IsMinimized)\par
15829             {\cf19 continue};\par
15830         {\cf19 if} (platform_io.Platform_SwapBuffers) platform_io.Platform_SwapBuffers(viewport, platform_render_arg);\par
15831         {\cf19 if} (platform_io.Renderer_SwapBuffers) platform_io.Renderer_SwapBuffers(viewport, renderer_render_arg);\par
15832     \}\par
15833 \}\par
