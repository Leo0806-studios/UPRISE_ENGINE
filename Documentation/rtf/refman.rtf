01627     {\cf17 const} ImGuiInputEvent* latest_event = FindLatestInputEvent(&g, ImGuiInputEventType_Key, ({\cf18 int})key);\par
01628     {\cf17 const} ImGuiKeyData* key_data = ImGui::GetKeyData(&g, key);\par
