02251     {\cf17 const} {\cf18 int} filename_wsize = ::MultiByteToWideChar(CP_UTF8, 0, filename, -1, NULL, 0);\par
02252     {\cf17 const} {\cf18 int} mode_wsize = ::MultiByteToWideChar(CP_UTF8, 0, mode, -1, NULL, 0);\par
02253 \par
02254     {\cf20 // Use stack buffer if possible, otherwise heap buffer. Sizes include zero terminator.}\par
02255     {\cf20 // We don't rely on current ImGuiContext as this is implied to be a helper function which doesn't depend on it (see #7314).}\par
02256     {\cf18 wchar_t} local_temp_stack[FILENAME_MAX];\par
02257     ImVector<wchar_t> local_temp_heap;\par
02258     {\cf19 if} (filename_wsize + mode_wsize > IM_ARRAYSIZE(local_temp_stack))\par
02259         local_temp_heap.resize(filename_wsize + mode_wsize);\par
02260     {\cf18 wchar_t}* filename_wbuf = local_temp_heap.Data ? local_temp_heap.Data : local_temp_stack;\par
02261     {\cf18 wchar_t}* mode_wbuf = filename_wbuf + filename_wsize;\par
02262     ::MultiByteToWideChar(CP_UTF8, 0, filename, -1, filename_wbuf, filename_wsize);\par
02263     ::MultiByteToWideChar(CP_UTF8, 0, mode, -1, mode_wbuf, mode_wsize);\par
02264     return ::_wfopen(filename_wbuf, mode_wbuf);\par
02265 {\cf21 #else}\par
02266     {\cf19 return} fopen(filename, mode);\par
02267 {\cf21 #endif}\par
02268 \}\par
