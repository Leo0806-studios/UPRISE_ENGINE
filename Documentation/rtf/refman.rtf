07954 {\cf18 void} ImGui::BringWindowToDisplayFront(ImGuiWindow* window)\par
07955 \{\par
07956     ImGuiContext& g = *GImGui;\par
07957     ImGuiWindow* current_front_window = g.Windows.back();\par
07958     {\cf19 if} (current_front_window == window || current_front_window->RootWindowDockTree == window) {\cf20 // Cheap early out (could be better)}\par
07959         {\cf19 return};\par
07960     {\cf19 for} ({\cf18 int} i = g.Windows.Size - 2; i >= 0; i--) {\cf20 // We can ignore the top-most window}\par
07961         {\cf19 if} (g.Windows[i] == window)\par
07962         \{\par
07963             memmove(&g.Windows[i], &g.Windows[i + 1], ({\cf18 size_t})(g.Windows.Size - i - 1) * {\cf17 sizeof}(ImGuiWindow*));\par
07964             g.Windows[g.Windows.Size - 1] = window;\par
07965             {\cf19 break};\par
