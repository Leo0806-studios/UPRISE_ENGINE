07933 {\cf18 void} ImGui::BringWindowToFocusFront(ImGuiWindow* window)\par
07934 \{\par
07935     ImGuiContext& g = *GImGui;\par
07936     IM_ASSERT(window == window->RootWindow);\par
07937 \par
07938     {\cf17 const} {\cf18 int} cur_order = window->FocusOrder;\par
07939     IM_ASSERT(g.WindowsFocusOrder[cur_order] == window);\par
07940     {\cf19 if} (g.WindowsFocusOrder.back() == window)\par
07941         {\cf19 return};\par
07942 \par
07943     {\cf17 const} {\cf18 int} new_order = g.WindowsFocusOrder.Size - 1;\par
07944     {\cf19 for} ({\cf18 int} n = cur_order; n < new_order; n++)\par
07945     \{\par
07946         g.WindowsFocusOrder[n] = g.WindowsFocusOrder[n + 1];\par
07947         g.WindowsFocusOrder[n]->FocusOrder--;\par
07948         IM_ASSERT(g.WindowsFocusOrder[n]->FocusOrder == n);\par
07949     \}\par
07950     g.WindowsFocusOrder[new_order] = window;\par
07951     window->FocusOrder = (short)new_order;\par
07952 \}\par
