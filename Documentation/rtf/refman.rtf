00026 {\cf17  }\{\par
00027     {\cf19 return} Quaternion(\par
00028         w * other.w - x * other.x - y * other.y - z * other.z,\par
00029         w * other.x + x * other.w + y * other.z - z * other.y,\par
00030         w * other.y - x * other.z + y * other.w + z * other.x,\par
00031         w * other.z + x * other.y - y * other.x + z * other.w\par
00032     );\par
00033  \}\par
00034 \par
00035  DATATYPES::TS_P_Vector3 DATATYPES::Quaternion::ToRotationVector(){\cf17  const }\{\par
00036      {\cf20 // Normalize the quaternion}\par
00037      {\cf18 float} length = std::sqrt(w * w + x * x + y * y + z * z);\par
00038      {\cf18 float} nw = w / length;\par
00039      {\cf18 float} nx = x / length;\par
00040      {\cf18 float} ny = y / length;\par
00041      {\cf18 float} nz = z / length;\par
00042 \par
00043      {\cf20 // Compute the angle}\par
00044      {\cf18 float} angle = 2.0f * std::acos(nw);\par
00045 \par
00046      {\cf20 // Compute the axis}\par
00047      {\cf18 float} s = std::sqrt(1.0f - nw * nw);\par
00048      {\cf19 if} (s < 0.0001f) \{\par
00049          {\cf20 // If s is close to zero, return the axis as (1, 0, 0)}\par
00050          {\cf19 return} DATATYPES::TS_P_Vector3(1, 0, 0) * angle;\par
00051      \}\par
00052      {\cf19 else} \{\par
00053          {\cf19 return} DATATYPES::TS_P_Vector3(nx / s, ny / s, nz / s) * angle;\par
00054      \}\par
00055  \}\par
00056  DATATYPES::TS_P_Vector3 DATATYPES::Quaternion::operator*(DATATYPES::TS_P_Vector3 vec)\par
00057  \{\par
00058      {\cf18 float} num = x * 2;\par
00059      {\cf18 float} num2 = y * 2;\par
00060      {\cf18 float} num3 = z * 2;\par
00061      {\cf18 float} num4 = x * num;\par
00062      {\cf18 float} num5 = y * num2;\par
00063      {\cf18 float} num6 = z * num3;\par
00064      {\cf18 float} num7 = x * num2;\par
00065      {\cf18 float} num8 = x * num3;\par
00066      {\cf18 float} num9 = y * num3;\par
00067      {\cf18 float} num10 = w * num;\par
00068      {\cf18 float} num11 = w * num2;\par
00069      {\cf18 float} num12 = w * num3;\par
00070      DATATYPES::TS_P_Vector3 result;\par
00071      result.x = (1 - (num5 + num6)) * vec.x + (num7 - num12) * vec.y + (num8 + num11) * vec.z;\par
00072      result.y = (num7 + num12) * vec.x + (1 - (num4 + num6)) * vec.y + (num9 - num10) * vec.z;\par
00073      result.z = (num8 - num11) * vec.x + (num9 + num10) * vec.y + (1 - (num4 + num5)) * vec.z;\par
00074      {\cf19 return} result;\par
