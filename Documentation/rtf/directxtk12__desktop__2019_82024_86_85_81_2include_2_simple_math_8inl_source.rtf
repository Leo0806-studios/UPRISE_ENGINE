111 {\cf17 inline} Rectangle Rectangle::Union({\cf17 const} Rectangle& ra, {\cf17 const} Rectangle& rb) {\cf17 noexcept}\par
112 \{\par
113     {\cf17 const} {\cf18 long} righta = ra.x + ra.width;\par
114     {\cf17 const} {\cf18 long} rightb = rb.x + rb.width;\par
115 \par
116     {\cf17 const} {\cf18 long} bottoma = ra.y + ra.height;\par
117     {\cf17 const} {\cf18 long} bottomb = rb.y + rb.height;\par
118 \par
119     {\cf17 const} {\cf18 int} minX = ra.x < rb.x ? ra.x : rb.x;\par
120     {\cf17 const} {\cf18 int} minY = ra.y < rb.y ? ra.y : rb.y;\par
121 \par
122     {\cf17 const} {\cf18 int} maxRight = righta > rightb ? righta : rightb;\par
123     {\cf17 const} {\cf18 int} maxBottom = bottoma > bottomb ? bottoma : bottomb;\par
124 \par
125     Rectangle result;\par
126     result.x = minX;\par
127     result.y = minY;\par
128     result.width = maxRight - minX;\par
129     result.height = maxBottom - minY;\par
130     {\cf19 return} result;\par
131 \}\par
