49 {\cf17 inline} Rectangle Rectangle::Intersect({\cf17 const} Rectangle& ra, {\cf17 const} Rectangle& rb) {\cf17 noexcept}\par
50 \{\par
51     {\cf17 const} {\cf18 long} righta = ra.x + ra.width;\par
52     {\cf17 const} {\cf18 long} rightb = rb.x + rb.width;\par
53 \par
54     {\cf17 const} {\cf18 long} bottoma = ra.y + ra.height;\par
55     {\cf17 const} {\cf18 long} bottomb = rb.y + rb.height;\par
56 \par
57     {\cf17 const} {\cf18 long} maxX = ra.x > rb.x ? ra.x : rb.x;\par
58     {\cf17 const} {\cf18 long} maxY = ra.y > rb.y ? ra.y : rb.y;\par
59 \par
60     {\cf17 const} {\cf18 long} minRight = righta < rightb ? righta : rightb;\par
61     {\cf17 const} {\cf18 long} minBottom = bottoma < bottomb ? bottoma : bottomb;\par
62 \par
63     Rectangle result;\par
64 \par
65     {\cf19 if} ((minRight > maxX) && (minBottom > maxY))\par
66     \{\par
67         result.x = maxX;\par
68         result.y = maxY;\par
69         result.width = minRight - maxX;\par
70         result.height = minBottom - maxY;\par
71     \}\par
72     {\cf19 else}\par
73     \{\par
74         result.x = 0;\par
75         result.y = 0;\par
76         result.width = 0;\par
77         result.height = 0;\par
78     \}\par
79 \par
80     {\cf19 return} result;\par
81 \}\par
