3681 {\cf17 inline} {\cf18 bool} Ray::Intersects({\cf17 const} Plane& plane, _Out_ {\cf18 float}& Dist) {\cf17 const} {\cf17 noexcept}\par
3682 \{\par
3683     {\cf17 using namespace }DirectX;\par
3684 \par
3685     {\cf17 const} XMVECTOR p = XMLoadFloat4(&plane);\par
3686     {\cf17 const} XMVECTOR dir = XMLoadFloat3(&direction);\par
3687 \par
3688     {\cf17 const} XMVECTOR nd = XMPlaneDotNormal(p, dir);\par
3689 \par
3690     {\cf19 if} (XMVector3LessOrEqual(XMVectorAbs(nd), g_RayEpsilon))\par
3691     \{\par
3692         Dist = 0.f;\par
3693         {\cf19 return} {\cf17 false};\par
3694     \}\par
3695     {\cf19 else}\par
3696     \{\par
3697         {\cf20 // t = -(dot(n,origin) + D) / dot(n,dir)}\par
3698         {\cf17 const} XMVECTOR pos = XMLoadFloat3(&position);\par
3699         XMVECTOR v = XMPlaneDotNormal(p, pos);\par
3700         v = XMVectorAdd(v, XMVectorSplatW(p));\par
3701         v = XMVectorDivide(v, nd);\par
3702         {\cf18 float} dist = -XMVectorGetX(v);\par
3703         {\cf19 if} (dist < 0)\par
3704         \{\par
3705             Dist = 0.f;\par
3706             {\cf19 return} {\cf17 false};\par
3707         \}\par
3708         {\cf19 else}\par
3709         \{\par
3710             Dist = dist;\par
3711             {\cf19 return} {\cf17 true};\par
3712         \}\par
3713     \}\par
3714 \}\par
