83 {\cf17 inline} RECT Rectangle::Intersect({\cf17 const} RECT& rcta, {\cf17 const} RECT& rctb) {\cf17 noexcept}\par
84 \{\par
85     {\cf17 const} {\cf18 long} maxX = rcta.left > rctb.left ? rcta.left : rctb.left;\par
86     {\cf17 const} {\cf18 long} maxY = rcta.top > rctb.top ? rcta.top : rctb.top;\par
87 \par
88     {\cf17 const} {\cf18 long} minRight = rcta.right < rctb.right ? rcta.right : rctb.right;\par
89     {\cf17 const} {\cf18 long} minBottom = rcta.bottom < rctb.bottom ? rcta.bottom : rctb.bottom;\par
90 \par
91     RECT result;\par
92 \par
93     {\cf19 if} ((minRight > maxX) && (minBottom > maxY))\par
94     \{\par
95         result.left = maxX;\par
96         result.top = maxY;\par
97         result.right = minRight;\par
98         result.bottom = minBottom;\par
99     \}\par
100     {\cf19 else}\par
101     \{\par
102         result.left = 0;\par
103         result.top = 0;\par
104         result.right = 0;\par
105         result.bottom = 0;\par
106     \}\par
107 \par
108     {\cf19 return} result;\par
109 \}\par
