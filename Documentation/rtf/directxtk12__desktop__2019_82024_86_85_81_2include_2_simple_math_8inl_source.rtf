2427 {\cf17 inline} Matrix Matrix::CreateConstrainedBillboard(\par
2428     {\cf17 const} Vector3& {\cf18 object},\par
2429     {\cf17 const} Vector3& cameraPosition,\par
2430     {\cf17 const} Vector3& rotateAxis,\par
2431     {\cf17 const} Vector3* cameraForward,\par
2432     {\cf17 const} Vector3* objectForward) {\cf17 noexcept}\par
2433 \{\par
2434     {\cf17 using namespace }DirectX;\par
2435 \par
2436     {\cf17 static} {\cf17 const} XMVECTORF32 s_minAngle = \{ \{ \{ 0.99825467075f, 0.99825467075f, 0.99825467075f, 0.99825467075f \} \} \}; {\cf20 // 1.0 - XMConvertToRadians( 0.1f );}\par
2437 \par
2438     {\cf17 const} XMVECTOR O = XMLoadFloat3(&{\cf18 object});\par
2439     {\cf17 const} XMVECTOR C = XMLoadFloat3(&cameraPosition);\par
2440     XMVECTOR faceDir = XMVectorSubtract(O, C);\par
2441 \par
2442     {\cf17 const} XMVECTOR N = XMVector3LengthSq(faceDir);\par
2443     {\cf19 if} (XMVector3Less(N, g_XMEpsilon))\par
2444     \{\par
2445         {\cf19 if} (cameraForward)\par
2446         \{\par
2447             {\cf17 const} XMVECTOR F = XMLoadFloat3(cameraForward);\par
2448             faceDir = XMVectorNegate(F);\par
2449         \}\par
