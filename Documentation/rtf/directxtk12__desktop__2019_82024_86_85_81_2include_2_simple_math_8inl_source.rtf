3123 {\cf17 inline} Vector3 Quaternion::ToEuler() const noexcept\par
3124 \{\par
3125     {\cf17 const} {\cf18 float} xx = x * x;\par
3126     {\cf17 const} {\cf18 float} yy = y * y;\par
3127     {\cf17 const} {\cf18 float} zz = z * z;\par
3128 \par
3129     {\cf17 const} {\cf18 float} m31 = 2.f * x * z + 2.f * y * w;\par
3130     {\cf17 const} {\cf18 float} m32 = 2.f * y * z - 2.f * x * w;\par
3131     {\cf17 const} {\cf18 float} m33 = 1.f - 2.f * xx - 2.f * yy;\par
3132 \par
3133     {\cf17 const} {\cf18 float} cy = sqrtf(m33 * m33 + m31 * m31);\par
3134     {\cf17 const} {\cf18 float} cx = atan2f(-m32, cy);\par
3135     {\cf19 if} (cy > 16.f * FLT_EPSILON)\par
3136     \{\par
3137         {\cf17 const} {\cf18 float} m12 = 2.f * x * y + 2.f * z * w;\par
3138         {\cf17 const} {\cf18 float} m22 = 1.f - 2.f * xx - 2.f * zz;\par
3139 \par
3140         {\cf19 return} Vector3(cx, atan2f(m31, m33), atan2f(m12, m22));\par
3141     \}\par
3142     {\cf19 else}\par
3143     \{\par
3144         {\cf17 const} {\cf18 float} m11 = 1.f - 2.f * yy - 2.f * zz;\par
3145         {\cf17 const} {\cf18 float} m21 = 2.f * x * y - 2.f * z * w;\par
3146 \par
3147         {\cf19 return} Vector3(cx, 0.f, atan2f(-m21, m11));\par
3148     \}\par
3149 \}\par
