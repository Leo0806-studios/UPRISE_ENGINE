2462     {\cf19 if} (XMVector3Greater(dot, s_minAngle))\par
2463     \{\par
2464         {\cf19 if} (objectForward)\par
2465         \{\par
2466             Z = XMLoadFloat3(objectForward);\par
2467             dot = XMVectorAbs(XMVector3Dot(Y, Z));\par
2468             {\cf19 if} (XMVector3Greater(dot, s_minAngle))\par
2469             \{\par
2470                 dot = XMVectorAbs(XMVector3Dot(Y, g_XMNegIdentityR2));\par
2471                 Z = (XMVector3Greater(dot, s_minAngle)) ? g_XMIdentityR0 : g_XMNegIdentityR2;\par
2472             \}\par
2473         \}\par
2474         {\cf19 else}\par
2475         \{\par
