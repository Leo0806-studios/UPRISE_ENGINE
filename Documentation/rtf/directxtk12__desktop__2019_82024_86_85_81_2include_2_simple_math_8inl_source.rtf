138     result.right = rcta.right > rctb.right ? rcta.right : rctb.right;\par
139     result.bottom = rcta.bottom > rctb.bottom ? rcta.bottom : rctb.bottom;\par
140     {\cf19 return} result;\par
141 \}\par
