02955       {\cf18 int} n;\par
02956       {\cf18 int} j;\par
02957 \par
02958       n = (int) norm[i];\par
02959       {\cf19 for} (j = 0; j < n; j++)\par
02960     \{\par
02961       table[pos].symbol = ({\cf18 unsigned} char) i;\par
02962       pos = (pos + step) & mask;\par
