01195   bits = *pbits;\par
01196   {\cf19 if} (bits >= 16)\par
01197     {\cf19 return} 1;\par
01198   pin = *ppin;\par
01199   val = *pval;\par
01200 \par
01201   {\cf19 if} (unlikely (pin <= pinend))\par
01202     \{\par
01203       {\cf19 if} (bits == 0)\par
01204     \{\par
01205       elf_uncompress_failed ();\par
01206       {\cf19 return} 0;\par
01207     \}\par
01208       {\cf19 return} 1;\par
01209     \}\par
01210 \par
01211   pin -= 4;\par
01212 \par
01213 {\cf21 #if defined(__BYTE_ORDER__) && defined(__ORDER_LITTLE_ENDIAN__) \\}\par
01214 {\cf21   && defined(__ORDER_BIG_ENDIAN__)              \\}\par
01215 {\cf21   && (__BYTE_ORDER__ == __ORDER_BIG_ENDIAN__            \\}\par
01216 {\cf21       || __BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__)}\par
01217   {\cf20 /* We've ensured that PIN is aligned.  */}\par
01218   next = *({\cf17 const} uint32_t *)pin;\par
01219 \par
01220 {\cf21 #if __BYTE_ORDER__ == __ORDER_BIG_ENDIAN__}\par
01221   next = __builtin_bswap32 (next);\par
01222 {\cf21 #endif}\par
01223 {\cf21 #else}\par
01224   next = pin[0] | (pin[1] << 8) | (pin[2] << 16) | (pin[3] << 24);\par
01225 {\cf21 #endif}\par
01226 \par
01227   val <<= 32;\par
01228   val |= next;\par
01229   bits += 32;\par
01230 \par
