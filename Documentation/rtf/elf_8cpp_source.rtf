01241 \}\par
01242 \par
01243 {\cf20 /* Initialize backward fetching when the bitstream starts with a 1 bit in the}\par
01244 {\cf20    last byte in memory (which is the first one that we read).  This is used by}\par
01245 {\cf20    zstd decompression.  Returns 1 on success, 0 on error.  */}\par
01246 \par
01247 {\cf17 static} {\cf18 int}\par
01248 elf_fetch_backward_init ({\cf17 const} {\cf18 unsigned} {\cf18 char} **ppin,\par
01249              {\cf17 const} {\cf18 unsigned} {\cf18 char} *pinend,\par
01250              uint64_t *pval, {\cf18 unsigned} {\cf18 int} *pbits)\par
01251 \{\par
01252   {\cf17 const} {\cf18 unsigned} {\cf18 char} *pin;\par
01253   {\cf18 unsigned} {\cf18 int} stream_start;\par
01254   uint64_t val;\par
01255   {\cf18 unsigned} {\cf18 int} bits;\par
01256 \par
01257   pin = *ppin;\par
01258   stream_start = ({\cf18 unsigned} int)*pin;\par
01259   {\cf19 if} (unlikely (stream_start == 0))\par
01260     \{\par
01261       elf_uncompress_failed ();\par
01262       {\cf19 return} 0;\par
01263     \}\par
01264   val = 0;\par
01265   bits = 0;\par
01266 \par
01267   {\cf20 /* Align to a 32-bit boundary.  */}\par
01268   {\cf19 while} ((((uintptr_t)pin) & 3) != 0)\par
01269     \{\par
01270       val <<= 8;\par
01271       val |= (uint64_t)*pin;\par
01272       bits += 8;\par
01273       --pin;\par
01274     \}\par
01275 \par
01276   val <<= 8;\par
01277   val |= (uint64_t)*pin;\par
01278   bits += 8;\par
01279 \par
01280   *ppin = pin;\par
01281   *pval = val;\par
01282   *pbits = bits;\par
01283   {\cf19 if} (!elf_fetch_bits_backward (ppin, pinend, pval, pbits))\par
