01232     \{\par
01233       val >>= (pinend - pin) * 8;\par
01234       bits -= (pinend - pin) * 8;\par
01235     \}\par
01236 \par
01237   *ppin = pin;\par
01238   *pval = val;\par
01239   *pbits = bits;\par
