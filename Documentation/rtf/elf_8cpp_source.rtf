00868 {\cf21 #define SYSTEM_BUILD_ID_DIR "/usr/lib/debug/.build-id/"}\par
00869 \par
00870 {\cf20 /* Open a separate debug info file, using the build ID to find it.}\par
00871 {\cf20    Returns an open file descriptor, or -1.}\par
00872 {\cf20 }\par
00873 {\cf20    The GDB manual says that the only place gdb looks for a debug file}\par
00874 {\cf20    when the build ID is known is in /usr/lib/debug/.build-id.  */}\par
00875 \par
00876 {\cf17 static} {\cf18 int}\par
00877 elf_open_debugfile_by_buildid ({\cf17 struct} backtrace_state *state,\par
00878                    {\cf17 const} {\cf18 char} *buildid_data, {\cf18 size_t} buildid_size,\par
00879              {\cf17 const} {\cf18 char} *filename,\par
00880                    backtrace_error_callback error_callback,\par
00881                    {\cf18 void} *data)\par
00882 \{\par
00883   {\cf17 const} {\cf18 char} * {\cf17 const} prefix = SYSTEM_BUILD_ID_DIR;\par
00884   {\cf17 const} {\cf18 size_t} prefix_len = strlen (prefix);\par
00885   {\cf17 const} {\cf18 char} * {\cf17 const} suffix = {\cf22 ".debug"};\par
00886   {\cf17 const} {\cf18 size_t} suffix_len = strlen (suffix);\par
00887   {\cf18 size_t} len;\par
00888   {\cf18 char} *bd_filename;\par
00889   {\cf18 char} *t;\par
00890   {\cf18 size_t} i;\par
00891   {\cf18 int} ret;\par
00892   {\cf18 int} does_not_exist;\par
00893 \par
00894   len = prefix_len + buildid_size * 2 + suffix_len + 2;\par
00895   bd_filename = ({\cf18 char}*)backtrace_alloc (state, len, error_callback, data);\par
00896   {\cf19 if} (bd_filename == NULL)\par
00897     {\cf19 return} -1;\par
00898 \par
00899   t = bd_filename;\par
00900   memcpy (t, prefix, prefix_len);\par
00901   t += prefix_len;\par
00902   {\cf19 for} (i = 0; i < buildid_size; i++)\par
00903     \{\par
00904       {\cf18 unsigned} {\cf18 char} b;\par
00905       {\cf18 unsigned} {\cf18 char} nib;\par
00906 \par
00907       b = ({\cf18 unsigned} char) buildid_data[i];\par
00908       nib = (b & 0xf0) >> 4;\par
00909       *t++ = nib < 10 ? {\cf23 '0'} + nib : {\cf23 'a'} + nib - 10;\par
00910       nib = b & 0x0f;\par
00911       *t++ = nib < 10 ? {\cf23 '0'} + nib : {\cf23 'a'} + nib - 10;\par
00912       {\cf19 if} (i == 0)\par
00913     *t++ = {\cf23 '/'};\par
00914     \}\par
00915   memcpy (t, suffix, suffix_len);\par
00916   t[suffix_len] = {\cf23 '\\0'};\par
00917 \par
00918   ret = backtrace_open (bd_filename, error_callback, data, &does_not_exist);\par
00919 \par
00920   backtrace_free (state, bd_filename, len, error_callback, data);\par
00921 \par
00922   {\cf20 /* gdb checks that the debuginfo file has the same build ID note.}\par
00923 {\cf20      That seems kind of pointless to me--why would it have the right}\par
00924 {\cf20      name but not the right build ID?--so skipping the check.  */}\par
00925 \par
00926 {\cf21 #ifdef TRACY_DEBUGINFOD}\par
00927   {\cf19 if} (ret == -1)\par
00928     {\cf19 return} GetDebugInfoDescriptor( buildid_data, buildid_size, filename );\par
00929   {\cf19 else}\par
00930     {\cf19 return} ret;\par
00931 {\cf21 #else}\par
00932   {\cf19 return} ret;\par
00933 {\cf21 #endif}\par
00934 \}\par
00935 \par
00936 {\cf20 /* Try to open a file whose name is PREFIX (length PREFIX_LEN)}\par
00937 {\cf20    concatenated with PREFIX2 (length PREFIX2_LEN) concatenated with}\par
00938 {\cf20    DEBUGLINK_NAME.  Returns an open file descriptor, or -1.  */}\par
00939 \par
00940 {\cf17 static} {\cf18 int}\par
00941 elf_try_debugfile ({\cf17 struct} backtrace_state *state, {\cf17 const} {\cf18 char} *prefix,\par
00942            {\cf18 size_t} prefix_len, {\cf17 const} {\cf18 char} *prefix2, {\cf18 size_t} prefix2_len,\par
00943            {\cf17 const} {\cf18 char} *debuglink_name,\par
00944            backtrace_error_callback error_callback, {\cf18 void} *data)\par
00945 \{\par
00946   {\cf18 size_t} debuglink_len;\par
00947   {\cf18 size_t} try_len;\par
00948   {\cf18 char} *Try;\par
00949   {\cf18 int} does_not_exist;\par
00950   {\cf18 int} ret;\par
00951 \par
00952   debuglink_len = strlen (debuglink_name);\par
00953   try_len = prefix_len + prefix2_len + debuglink_len + 1;\par
00954   Try = ({\cf18 char}*)backtrace_alloc (state, try_len, error_callback, data);\par
00955   {\cf19 if} (Try == NULL)\par
00956     {\cf19 return} -1;\par
00957 \par
00958   memcpy (Try, prefix, prefix_len);\par
00959   memcpy (Try + prefix_len, prefix2, prefix2_len);\par
