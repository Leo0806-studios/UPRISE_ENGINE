06157               {\cf19 if} (elf_lzma_bit (compressed, compressed_size,\par
06158                         lit_probs + idx, poffset,\par
06159                         &range, &code))\par
06160                 \{\par
06161                   ++sym;\par
06162                   bit &= match_bit;\par
06163                 \}\par
06164               {\cf19 else}\par
06165                 \{\par
06166                   bit &= ~ match_bit;\par
06167                 \}\par
06168             \}\par
06169               {\cf19 while} (sym < 0x100);\par
06170             \}\par
06171 \par
06172           {\cf19 if} (unlikely (uncompressed_offset >= uncompressed_size))\par
06173             \{\par
06174               elf_uncompress_failed ();\par
06175               {\cf19 return} 0;\par
06176             \}\par
06177 \par
06178           uncompressed[uncompressed_offset] = ({\cf18 unsigned} char) sym;\par
06179           ++uncompressed_offset;\par
06180           {\cf19 if} (lstate <= 3)\par
06181             lstate = 0;\par
06182           {\cf19 else} {\cf19 if} (lstate <= 9)\par
06183             lstate -= 3;\par
06184           {\cf19 else}\par
06185             lstate -= 6;\par
06186         \}\par
06187         \}\par
06188 \par
06189       elf_lzma_range_normalize (compressed, compressed_size, poffset,\par
06190                     &range, &code);\par
06191 \par
06192       off = *poffset;\par
06193     \}\par
06194     \}\par
06195 \par
06196   {\cf20 /* We have reached the end of the block.  Pad to four byte}\par
06197 {\cf20      boundary.  */}\par
06198   off = (off + 3) &~ ({\cf18 size_t}) 3;\par
06199   {\cf19 if} (unlikely (off > compressed_size))\par
06200     \{\par
06201       elf_uncompress_failed ();\par
06202       {\cf19 return} 0;\par
06203     \}\par
06204 \par
06205   {\cf19 switch} (check)\par
06206     \{\par
06207     {\cf19 case} 0:\par
06208       {\cf20 /* No check.  */}\par
06209       {\cf19 break};\par
06210 \par
06211     {\cf19 case} 1:\par
06212       {\cf20 /* CRC32 */}\par
06213       {\cf19 if} (unlikely (off + 4 > compressed_size))\par
06214     \{\par
06215       elf_uncompress_failed ();\par
06216       {\cf19 return} 0;\par
06217     \}\par
06218       computed_crc = elf_crc32 (0, uncompressed, uncompressed_offset);\par
06219       stream_crc = (compressed[off]\par
06220             | (compressed[off + 1] << 8)\par
06221             | (compressed[off + 2] << 16)\par
06222             | (compressed[off + 3] << 24));\par
06223       {\cf19 if} (computed_crc != stream_crc)\par
06224     \{\par
06225       elf_uncompress_failed ();\par
06226       {\cf19 return} 0;\par
06227     \}\par
06228       off += 4;\par
06229       {\cf19 break};\par
06230 \par
06231     {\cf19 case} 4:\par
06232       {\cf20 /* CRC64.  We don't bother computing a CRC64 checksum.  */}\par
06233       {\cf19 if} (unlikely (off + 8 > compressed_size))\par
06234     \{\par
06235       elf_uncompress_failed ();\par
06236       {\cf19 return} 0;\par
06237     \}\par
06238       off += 8;\par
06239       {\cf19 break};\par
06240 \par
06241     {\cf19 case} 10:\par
06242       {\cf20 /* SHA.  We don't bother computing a SHA checksum.  */}\par
06243       {\cf19 if} (unlikely (off + 32 > compressed_size))\par
06244     \{\par
06245       elf_uncompress_failed ();\par
06246       {\cf19 return} 0;\par
06247     \}\par
06248       off += 32;\par
06249       {\cf19 break};\par
06250 \par
06251     {\cf19 default}:\par
06252       elf_uncompress_failed ();\par
06253       {\cf19 return} 0;\par
06254     \}\par
06255 \par
06256   *poffset = off;\par
06257 \par
06258   {\cf19 return} 1;\par
06259 \}\par
06260 \par
06261 {\cf20 /* Uncompress LZMA data found in a minidebug file.  The minidebug}\par
06262 {\cf20    format is described at}\par
06263 {\cf20    https://sourceware.org/gdb/current/onlinedocs/gdb/MiniDebugInfo.html.}\par
06264 {\cf20    Returns 0 on error, 1 on successful decompression.  For this}\par
06265 {\cf20    function we return 0 on failure to decompress, as the calling code}\par
06266 {\cf20    will carry on in that case.  */}\par
06267 \par
06268 {\cf17 static} {\cf18 int}\par
06269 elf_uncompress_lzma ({\cf17 struct} backtrace_state *state,\par
06270              {\cf17 const} {\cf18 unsigned} {\cf18 char} *compressed, {\cf18 size_t} compressed_size,\par
06271              backtrace_error_callback error_callback, {\cf18 void} *data,\par
06272              {\cf18 unsigned} {\cf18 char} **uncompressed, {\cf18 size_t} *uncompressed_size)\par
06273 \{\par
06274   {\cf18 size_t} header_size;\par
06275   {\cf18 size_t} footer_size;\par
06276   {\cf18 unsigned} {\cf18 char} check;\par
06277   uint32_t computed_crc;\par
06278   uint32_t stream_crc;\par
06279   {\cf18 size_t} offset;\par
06280   {\cf18 size_t} index_size;\par
06281   {\cf18 size_t} footer_offset;\par
06282   {\cf18 size_t} index_offset;\par
06283   uint64_t index_compressed_size;\par
06284   uint64_t index_uncompressed_size;\par
06285   {\cf18 unsigned} {\cf18 char} *mem;\par
06286   uint16_t *probs;\par
06287   {\cf18 size_t} compressed_block_size;\par
06288 \par
06289   {\cf20 /* The format starts with a stream header and ends with a stream}\par
06290 {\cf20      footer.  */}\par
06291   header_size = 12;\par
06292   footer_size = 12;\par
06293   {\cf19 if} (unlikely (compressed_size < header_size + footer_size))\par
06294     \{\par
06295       elf_uncompress_failed ();\par
06296       {\cf19 return} 0;\par
06297     \}\par
06298 \par
06299   {\cf20 /* The stream header starts with a magic string.  */}\par
06300   {\cf19 if} (unlikely (memcmp (compressed, {\cf22 "\\375"} {\cf22 "7zXZ\\0"}, 6) != 0))\par
06301     \{\par
06302       elf_uncompress_failed ();\par
06303       {\cf19 return} 0;\par
06304     \}\par
06305 \par
06306   {\cf20 /* Next come stream flags.  The first byte is zero, the second byte}\par
06307 {\cf20      is the check.  */}\par
06308   {\cf19 if} (unlikely (compressed[6] != 0))\par
06309     \{\par
06310       elf_uncompress_failed ();\par
06311       {\cf19 return} 0;\par
06312     \}\par
06313   check = compressed[7];\par
06314   {\cf19 if} (unlikely ((check & 0xf8) != 0))\par
06315     \{\par
06316       elf_uncompress_failed ();\par
06317       {\cf19 return} 0;\par
06318     \}\par
06319 \par
06320   {\cf20 /* Next comes a CRC of the stream flags.  */}\par
06321   computed_crc = elf_crc32 (0, compressed + 6, 2);\par
06322   stream_crc = (compressed[8]\par
06323         | (compressed[9] << 8)\par
06324         | (compressed[10] << 16)\par
06325         | (compressed[11] << 24));\par
06326   {\cf19 if} (unlikely (computed_crc != stream_crc))\par
06327     \{\par
06328       elf_uncompress_failed ();\par
06329       {\cf19 return} 0;\par
06330     \}\par
06331 \par
06332   {\cf20 /* Now that we've parsed the header, parse the footer, so that we}\par
06333 {\cf20      can get the uncompressed size.  */}\par
06334 \par
06335   {\cf20 /* The footer ends with two magic bytes.  */}\par
06336 \par
06337   offset = compressed_size;\par
06338   {\cf19 if} (unlikely (memcmp (compressed + offset - 2, {\cf22 "YZ"}, 2) != 0))\par
06339     \{\par
06340       elf_uncompress_failed ();\par
06341       {\cf19 return} 0;\par
06342     \}\par
06343   offset -= 2;\par
06344 \par
06345   {\cf20 /* Before that are the stream flags, which should be the same as the}\par
06346 {\cf20      flags in the header.  */}\par
06347   {\cf19 if} (unlikely (compressed[offset - 2] != 0\par
06348         || compressed[offset - 1] != check))\par
06349     \{\par
06350       elf_uncompress_failed ();\par
06351       {\cf19 return} 0;\par
06352     \}\par
06353   offset -= 2;\par
06354 \par
06355   {\cf20 /* Before that is the size of the index field, which precedes the}\par
06356 {\cf20      footer.  */}\par
06357   index_size = (compressed[offset - 4]\par
06358         | (compressed[offset - 3] << 8)\par
06359         | (compressed[offset - 2] << 16)\par
06360         | (compressed[offset - 1] << 24));\par
06361   index_size = (index_size + 1) * 4;\par
06362   offset -= 4;\par
06363 \par
06364   {\cf20 /* Before that is a footer CRC.  */}\par
06365   computed_crc = elf_crc32 (0, compressed + offset, 6);\par
06366   stream_crc = (compressed[offset - 4]\par
06367         | (compressed[offset - 3] << 8)\par
06368         | (compressed[offset - 2] << 16)\par
06369         | (compressed[offset - 1] << 24));\par
06370   {\cf19 if} (unlikely (computed_crc != stream_crc))\par
06371     \{\par
06372       elf_uncompress_failed ();\par
06373       {\cf19 return} 0;\par
06374     \}\par
06375   offset -= 4;\par
06376 \par
06377   {\cf20 /* The index comes just before the footer.  */}\par
06378   {\cf19 if} (unlikely (offset < index_size + header_size))\par
06379     \{\par
06380       elf_uncompress_failed ();\par
06381       {\cf19 return} 0;\par
06382     \}\par
06383 \par
06384   footer_offset = offset;\par
06385   offset -= index_size;\par
06386   index_offset = offset;\par
06387 \par
06388   {\cf20 /* The index starts with a zero byte.  */}\par
06389   {\cf19 if} (unlikely (compressed[offset] != 0))\par
06390     \{\par
06391       elf_uncompress_failed ();\par
06392       {\cf19 return} 0;\par
06393     \}\par
06394   ++offset;\par
06395 \par
06396   {\cf20 /* Next is the number of blocks.  We expect zero blocks for an empty}\par
06397 {\cf20      stream, and otherwise a single block.  */}\par
06398   {\cf19 if} (unlikely (compressed[offset] == 0))\par
06399     \{\par
06400       *uncompressed = NULL;\par
06401       *uncompressed_size = 0;\par
06402       {\cf19 return} 1;\par
06403     \}\par
06404   {\cf19 if} (unlikely (compressed[offset] != 1))\par
06405     \{\par
06406       elf_uncompress_failed ();\par
06407       {\cf19 return} 0;\par
06408     \}\par
06409   ++offset;\par
06410 \par
06411   {\cf20 /* Next is the compressed size and the uncompressed size.  */}\par
06412   {\cf19 if} (!elf_lzma_varint (compressed, compressed_size, &offset,\par
06413             &index_compressed_size))\par
06414     {\cf19 return} 0;\par
06415   {\cf19 if} (!elf_lzma_varint (compressed, compressed_size, &offset,\par
06416             &index_uncompressed_size))\par
06417     {\cf19 return} 0;\par
06418 \par
06419   {\cf20 /* Pad to a four byte boundary.  */}\par
06420   offset = (offset + 3) &~ ({\cf18 size_t}) 3;\par
06421 \par
06422   {\cf20 /* Next is a CRC of the index.  */}\par
06423   computed_crc = elf_crc32 (0, compressed + index_offset,\par
06424                 offset - index_offset);\par
06425   stream_crc = (compressed[offset]\par
06426         | (compressed[offset + 1] << 8)\par
06427         | (compressed[offset + 2] << 16)\par
06428         | (compressed[offset + 3] << 24));\par
06429   {\cf19 if} (unlikely (computed_crc != stream_crc))\par
06430     \{\par
06431       elf_uncompress_failed ();\par
06432       {\cf19 return} 0;\par
06433     \}\par
06434   offset += 4;\par
06435 \par
06436   {\cf20 /* We should now be back at the footer.  */}\par
06437   {\cf19 if} (unlikely (offset != footer_offset))\par
06438     \{\par
06439       elf_uncompress_failed ();\par
06440       {\cf19 return} 0;\par
06441     \}\par
06442 \par
06443   {\cf20 /* Allocate space to hold the uncompressed data.  If we succeed in}\par
06444 {\cf20      uncompressing the LZMA data, we never free this memory.  */}\par
06445   mem = ({\cf18 unsigned} {\cf18 char} *) backtrace_alloc (state, index_uncompressed_size,\par
06446                        error_callback, data);\par
06447   {\cf19 if} (unlikely (mem == NULL))\par
06448     {\cf19 return} 0;\par
06449   *uncompressed = mem;\par
06450   *uncompressed_size = index_uncompressed_size;\par
06451 \par
06452   {\cf20 /* Allocate space for probabilities.  */}\par
06453   probs = ((uint16_t *)\par
06454        backtrace_alloc (state,\par
06455                 LZMA_PROB_TOTAL_COUNT * {\cf17 sizeof} (uint16_t),\par
06456                 error_callback, data));\par
06457   {\cf19 if} (unlikely (probs == NULL))\par
06458     \{\par
06459       backtrace_free (state, mem, index_uncompressed_size, error_callback,\par
06460               data);\par
06461       {\cf19 return} 0;\par
06462     \}\par
06463 \par
06464   {\cf20 /* Uncompress the block, which follows the header.  */}\par
06465   offset = 12;\par
06466   {\cf19 if} (!elf_uncompress_lzma_block (compressed, compressed_size, check, probs,\par
06467                   mem, index_uncompressed_size, &offset))\par
06468     \{\par
06469       backtrace_free (state, mem, index_uncompressed_size, error_callback,\par
06470               data);\par
06471       {\cf19 return} 0;\par
06472     \}\par
06473 \par
06474   compressed_block_size = offset - 12;\par
06475   {\cf19 if} (unlikely (compressed_block_size\par
06476         != ((index_compressed_size + 3) &~ ({\cf18 size_t}) 3)))\par
06477     \{\par
06478       elf_uncompress_failed ();\par
06479       backtrace_free (state, mem, index_uncompressed_size, error_callback,\par
06480               data);\par
06481       {\cf19 return} 0;\par
06482     \}\par
06483 \par
06484   offset = (offset + 3) &~ ({\cf18 size_t}) 3;\par
06485   {\cf19 if} (unlikely (offset != index_offset))\par
06486     \{\par
06487       elf_uncompress_failed ();\par
06488       backtrace_free (state, mem, index_uncompressed_size, error_callback,\par
06489               data);\par
06490       {\cf19 return} 0;\par
06491     \}\par
06492 \par
06493   {\cf19 return} 1;\par
06494 \}\par
06495 \par
06496 {\cf20 /* This function is a hook for testing the LZMA support.  It is only}\par
06497 {\cf20    used by tests.  */}\par
06498 \par
06499 {\cf18 int}\par
06500 backtrace_uncompress_lzma ({\cf17 struct} backtrace_state *state,\par
06501                {\cf17 const} {\cf18 unsigned} {\cf18 char} *compressed,\par
06502                {\cf18 size_t} compressed_size,\par
06503                backtrace_error_callback error_callback,\par
06504                {\cf18 void} *data, {\cf18 unsigned} {\cf18 char} **uncompressed,\par
06505                {\cf18 size_t} *uncompressed_size)\par
06506 \{\par
06507   {\cf19 return} elf_uncompress_lzma (state, compressed, compressed_size,\par
06508                   error_callback, data, uncompressed,\par
06509                   uncompressed_size);\par
06510 \}\par
