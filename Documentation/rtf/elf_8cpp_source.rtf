03221 \par
03222   count = 1U << table_bits;\par
03223   pfse = fse_table + count;\par
03224   pbaseline = baseline_table + count;\par
03225   {\cf19 while} (pfse > fse_table)\par
03226     \{\par
03227       {\cf18 unsigned} {\cf18 char} symbol;\par
03228       {\cf18 unsigned} {\cf18 char} bits;\par
03229       uint16_t base;\par
03230 \par
03231       --pfse;\par
03232       --pbaseline;\par
03233       symbol = pfse->symbol;\par
03234       bits = pfse->bits;\par
03235       base = pfse->base;\par
03236       {\cf19 if} (symbol < ZSTD_MATCH_LENGTH_BASELINE_OFFSET)\par
03237     \{\par
