05207 {\cf20 /* Number of LZMA states.  */}\par
05208 {\cf21 #define LZMA_STATES (12)}\par
05209 \par
05210 {\cf20 /* Number of LZMA position states.  The pb value of the property byte}\par
05211 {\cf20    is the number of bits to include in these states, and the maximum}\par
05212 {\cf20    value of pb is 4.  */}\par
05213 {\cf21 #define LZMA_POS_STATES (16)}\par
05214 \par
05215 {\cf20 /* Number of LZMA distance states.  These are used match distances}\par
05216 {\cf20    with a short match length: up to 4 bytes.  */}\par
05217 {\cf21 #define LZMA_DIST_STATES (4)}\par
05218 \par
05219 {\cf20 /* Number of LZMA distance slots.  LZMA uses six bits to encode larger}\par
05220 {\cf20    match lengths, so 1 << 6 possible probabilities.  */}\par
05221 {\cf21 #define LZMA_DIST_SLOTS (64)}\par
05222 \par
05223 {\cf20 /* LZMA distances 0 to 3 are encoded directly, larger values use a}\par
05224 {\cf20    probability model.  */}\par
05225 {\cf21 #define LZMA_DIST_MODEL_START (4)}\par
05226 \par
05227 {\cf20 /* The LZMA probability model ends at 14.  */}\par
05228 {\cf21 #define LZMA_DIST_MODEL_END (14)}\par
05229 \par
05230 {\cf20 /* LZMA distance slots for distances less than 127.  */}\par
05231 {\cf21 #define LZMA_FULL_DISTANCES (128)}\par
05232 \par
05233 {\cf20 /* LZMA uses four alignment bits.  */}\par
05234 {\cf21 #define LZMA_ALIGN_SIZE (16)}\par
05235 \par
05236 {\cf20 /* LZMA match length is encoded with 4, 5, or 10 bits, some of which}\par
05237 {\cf20    are already known.  */}\par
05238 {\cf21 #define LZMA_LEN_LOW_SYMBOLS (8)}\par
05239 {\cf21 #define LZMA_LEN_MID_SYMBOLS (8)}\par
05240 {\cf21 #define LZMA_LEN_HIGH_SYMBOLS (256)}\par
05241 \par
05242 {\cf20 /* LZMA literal encoding.  */}\par
05243 {\cf21 #define LZMA_LITERAL_CODERS_MAX (16)}\par
05244 {\cf21 #define LZMA_LITERAL_CODER_SIZE (0x300)}\par
05245 \par
05246 {\cf20 /* LZMA is based on a large set of probabilities, each managed}\par
05247 {\cf20    independently.  Each probability is an 11 bit number that we store}\par
05248 {\cf20    in a uint16_t.  We use a single large array of probabilities.  */}\par
05249 \par
05250 {\cf20 /* Lengths of entries in the LZMA probabilities array.  The names used}\par
05251 {\cf20    here are copied from the Linux kernel implementation.  */}\par
05252 \par
05253 {\cf21 #define LZMA_PROB_IS_MATCH_LEN (LZMA_STATES * LZMA_POS_STATES)}\par
05254 {\cf21 #define LZMA_PROB_IS_REP_LEN LZMA_STATES}\par
05255 {\cf21 #define LZMA_PROB_IS_REP0_LEN LZMA_STATES}\par
05256 {\cf21 #define LZMA_PROB_IS_REP1_LEN LZMA_STATES}\par
05257 {\cf21 #define LZMA_PROB_IS_REP2_LEN LZMA_STATES}\par
05258 {\cf21 #define LZMA_PROB_IS_REP0_LONG_LEN (LZMA_STATES * LZMA_POS_STATES)}\par
05259 {\cf21 #define LZMA_PROB_DIST_SLOT_LEN (LZMA_DIST_STATES * LZMA_DIST_SLOTS)}\par
05260 {\cf21 #define LZMA_PROB_DIST_SPECIAL_LEN (LZMA_FULL_DISTANCES - LZMA_DIST_MODEL_END)}\par
05261 {\cf21 #define LZMA_PROB_DIST_ALIGN_LEN LZMA_ALIGN_SIZE}\par
05262 {\cf21 #define LZMA_PROB_MATCH_LEN_CHOICE_LEN 1}\par
05263 {\cf21 #define LZMA_PROB_MATCH_LEN_CHOICE2_LEN 1}\par
05264 {\cf21 #define LZMA_PROB_MATCH_LEN_LOW_LEN (LZMA_POS_STATES * LZMA_LEN_LOW_SYMBOLS)}\par
05265 {\cf21 #define LZMA_PROB_MATCH_LEN_MID_LEN (LZMA_POS_STATES * LZMA_LEN_MID_SYMBOLS)}\par
05266 {\cf21 #define LZMA_PROB_MATCH_LEN_HIGH_LEN LZMA_LEN_HIGH_SYMBOLS}\par
05267 {\cf21 #define LZMA_PROB_REP_LEN_CHOICE_LEN 1}\par
05268 {\cf21 #define LZMA_PROB_REP_LEN_CHOICE2_LEN 1}\par
05269 {\cf21 #define LZMA_PROB_REP_LEN_LOW_LEN (LZMA_POS_STATES * LZMA_LEN_LOW_SYMBOLS)}\par
05270 {\cf21 #define LZMA_PROB_REP_LEN_MID_LEN (LZMA_POS_STATES * LZMA_LEN_MID_SYMBOLS)}\par
05271 {\cf21 #define LZMA_PROB_REP_LEN_HIGH_LEN LZMA_LEN_HIGH_SYMBOLS}\par
05272 {\cf21 #define LZMA_PROB_LITERAL_LEN \\}\par
05273 {\cf21   (LZMA_LITERAL_CODERS_MAX * LZMA_LITERAL_CODER_SIZE)}\par
05274 \par
05275 {\cf20 /* Offsets into the LZMA probabilities array.  This is mechanically}\par
05276 {\cf20    generated from the above lengths.  */}\par
05277 \par
05278 {\cf21 #define LZMA_PROB_IS_MATCH_OFFSET 0}\par
05279 {\cf21 #define LZMA_PROB_IS_REP_OFFSET \\}\par
05280 {\cf21   (LZMA_PROB_IS_MATCH_OFFSET + LZMA_PROB_IS_MATCH_LEN)}\par
05281 {\cf21 #define LZMA_PROB_IS_REP0_OFFSET \\}\par
05282 {\cf21   (LZMA_PROB_IS_REP_OFFSET + LZMA_PROB_IS_REP_LEN)}\par
05283 {\cf21 #define LZMA_PROB_IS_REP1_OFFSET \\}\par
05284 {\cf21   (LZMA_PROB_IS_REP0_OFFSET + LZMA_PROB_IS_REP0_LEN)}\par
05285 {\cf21 #define LZMA_PROB_IS_REP2_OFFSET \\}\par
05286 {\cf21   (LZMA_PROB_IS_REP1_OFFSET + LZMA_PROB_IS_REP1_LEN)}\par
05287 {\cf21 #define LZMA_PROB_IS_REP0_LONG_OFFSET \\}\par
05288 {\cf21   (LZMA_PROB_IS_REP2_OFFSET + LZMA_PROB_IS_REP2_LEN)}\par
05289 {\cf21 #define LZMA_PROB_DIST_SLOT_OFFSET \\}\par
05290 {\cf21   (LZMA_PROB_IS_REP0_LONG_OFFSET + LZMA_PROB_IS_REP0_LONG_LEN)}\par
05291 {\cf21 #define LZMA_PROB_DIST_SPECIAL_OFFSET \\}\par
05292 {\cf21   (LZMA_PROB_DIST_SLOT_OFFSET + LZMA_PROB_DIST_SLOT_LEN)}\par
05293 {\cf21 #define LZMA_PROB_DIST_ALIGN_OFFSET \\}\par
05294 {\cf21   (LZMA_PROB_DIST_SPECIAL_OFFSET + LZMA_PROB_DIST_SPECIAL_LEN)}\par
05295 {\cf21 #define LZMA_PROB_MATCH_LEN_CHOICE_OFFSET \\}\par
05296 {\cf21   (LZMA_PROB_DIST_ALIGN_OFFSET + LZMA_PROB_DIST_ALIGN_LEN)}\par
05297 {\cf21 #define LZMA_PROB_MATCH_LEN_CHOICE2_OFFSET \\}\par
05298 {\cf21   (LZMA_PROB_MATCH_LEN_CHOICE_OFFSET + LZMA_PROB_MATCH_LEN_CHOICE_LEN)}\par
05299 {\cf21 #define LZMA_PROB_MATCH_LEN_LOW_OFFSET \\}\par
05300 {\cf21   (LZMA_PROB_MATCH_LEN_CHOICE2_OFFSET + LZMA_PROB_MATCH_LEN_CHOICE2_LEN)}\par
05301 {\cf21 #define LZMA_PROB_MATCH_LEN_MID_OFFSET \\}\par
05302 {\cf21   (LZMA_PROB_MATCH_LEN_LOW_OFFSET + LZMA_PROB_MATCH_LEN_LOW_LEN)}\par
05303 {\cf21 #define LZMA_PROB_MATCH_LEN_HIGH_OFFSET \\}\par
05304 {\cf21   (LZMA_PROB_MATCH_LEN_MID_OFFSET + LZMA_PROB_MATCH_LEN_MID_LEN)}\par
05305 {\cf21 #define LZMA_PROB_REP_LEN_CHOICE_OFFSET \\}\par
05306 {\cf21   (LZMA_PROB_MATCH_LEN_HIGH_OFFSET + LZMA_PROB_MATCH_LEN_HIGH_LEN)}\par
05307 {\cf21 #define LZMA_PROB_REP_LEN_CHOICE2_OFFSET \\}\par
05308 {\cf21   (LZMA_PROB_REP_LEN_CHOICE_OFFSET + LZMA_PROB_REP_LEN_CHOICE_LEN)}\par
05309 {\cf21 #define LZMA_PROB_REP_LEN_LOW_OFFSET \\}\par
05310 {\cf21   (LZMA_PROB_REP_LEN_CHOICE2_OFFSET + LZMA_PROB_REP_LEN_CHOICE2_LEN)}\par
05311 {\cf21 #define LZMA_PROB_REP_LEN_MID_OFFSET \\}\par
05312 {\cf21   (LZMA_PROB_REP_LEN_LOW_OFFSET + LZMA_PROB_REP_LEN_LOW_LEN)}\par
05313 {\cf21 #define LZMA_PROB_REP_LEN_HIGH_OFFSET \\}\par
05314 {\cf21   (LZMA_PROB_REP_LEN_MID_OFFSET + LZMA_PROB_REP_LEN_MID_LEN)}\par
05315 {\cf21 #define LZMA_PROB_LITERAL_OFFSET \\}\par
05316 {\cf21   (LZMA_PROB_REP_LEN_HIGH_OFFSET + LZMA_PROB_REP_LEN_HIGH_LEN)}\par
05317 \par
05318 {\cf21 #define LZMA_PROB_TOTAL_COUNT \\}\par
05319 {\cf21   (LZMA_PROB_LITERAL_OFFSET + LZMA_PROB_LITERAL_LEN)}\par
05320 \par
05321 {\cf20 /* Check that the number of LZMA probabilities is the same as the}\par
05322 {\cf20    Linux kernel implementation.  */}\par
05323 \par
05324 {\cf21 #if LZMA_PROB_TOTAL_COUNT != 1846 + (1 << 4) * 0x300}\par
05325 {\cf21  #error Wrong number of LZMA probabilities}\par
05326 {\cf21 #endif}\par
05327 \par
05328 {\cf20 /* Expressions for the offset in the LZMA probabilities array of a}\par
05329 {\cf20    specific probability.  */}\par
05330 \par
05331 {\cf21 #define LZMA_IS_MATCH(state, pos) \\}\par
05332 {\cf21   (LZMA_PROB_IS_MATCH_OFFSET + (state) * LZMA_POS_STATES + (pos))}\par
05333 {\cf21 #define LZMA_IS_REP(state) \\}\par
05334 {\cf21   (LZMA_PROB_IS_REP_OFFSET + (state))}\par
05335 {\cf21 #define LZMA_IS_REP0(state) \\}\par
05336 {\cf21   (LZMA_PROB_IS_REP0_OFFSET + (state))}\par
05337 {\cf21 #define LZMA_IS_REP1(state) \\}\par
05338 {\cf21   (LZMA_PROB_IS_REP1_OFFSET + (state))}\par
05339 {\cf21 #define LZMA_IS_REP2(state) \\}\par
05340 {\cf21   (LZMA_PROB_IS_REP2_OFFSET + (state))}\par
05341 {\cf21 #define LZMA_IS_REP0_LONG(state, pos) \\}\par
05342 {\cf21   (LZMA_PROB_IS_REP0_LONG_OFFSET + (state) * LZMA_POS_STATES + (pos))}\par
05343 {\cf21 #define LZMA_DIST_SLOT(dist, slot) \\}\par
05344 {\cf21   (LZMA_PROB_DIST_SLOT_OFFSET + (dist) * LZMA_DIST_SLOTS + (slot))}\par
05345 {\cf21 #define LZMA_DIST_SPECIAL(dist) \\}\par
05346 {\cf21   (LZMA_PROB_DIST_SPECIAL_OFFSET + (dist))}\par
05347 {\cf21 #define LZMA_DIST_ALIGN(dist) \\}\par
05348 {\cf21   (LZMA_PROB_DIST_ALIGN_OFFSET + (dist))}\par
05349 {\cf21 #define LZMA_MATCH_LEN_CHOICE \\}\par
05350 {\cf21   LZMA_PROB_MATCH_LEN_CHOICE_OFFSET}\par
05351 {\cf21 #define LZMA_MATCH_LEN_CHOICE2 \\}\par
05352 {\cf21   LZMA_PROB_MATCH_LEN_CHOICE2_OFFSET}\par
05353 {\cf21 #define LZMA_MATCH_LEN_LOW(pos, sym) \\}\par
05354 {\cf21   (LZMA_PROB_MATCH_LEN_LOW_OFFSET + (pos) * LZMA_LEN_LOW_SYMBOLS + (sym))}\par
05355 {\cf21 #define LZMA_MATCH_LEN_MID(pos, sym) \\}\par
05356 {\cf21   (LZMA_PROB_MATCH_LEN_MID_OFFSET + (pos) * LZMA_LEN_MID_SYMBOLS + (sym))}\par
05357 {\cf21 #define LZMA_MATCH_LEN_HIGH(sym) \\}\par
05358 {\cf21   (LZMA_PROB_MATCH_LEN_HIGH_OFFSET + (sym))}\par
05359 {\cf21 #define LZMA_REP_LEN_CHOICE \\}\par
05360 {\cf21   LZMA_PROB_REP_LEN_CHOICE_OFFSET}\par
05361 {\cf21 #define LZMA_REP_LEN_CHOICE2 \\}\par
05362 {\cf21   LZMA_PROB_REP_LEN_CHOICE2_OFFSET}\par
05363 {\cf21 #define LZMA_REP_LEN_LOW(pos, sym) \\}\par
05364 {\cf21   (LZMA_PROB_REP_LEN_LOW_OFFSET + (pos) * LZMA_LEN_LOW_SYMBOLS + (sym))}\par
05365 {\cf21 #define LZMA_REP_LEN_MID(pos, sym) \\}\par
05366 {\cf21   (LZMA_PROB_REP_LEN_MID_OFFSET + (pos) * LZMA_LEN_MID_SYMBOLS + (sym))}\par
05367 {\cf21 #define LZMA_REP_LEN_HIGH(sym) \\}\par
05368 {\cf21   (LZMA_PROB_REP_LEN_HIGH_OFFSET + (sym))}\par
05369 {\cf21 #define LZMA_LITERAL(code, size) \\}\par
05370 {\cf21   (LZMA_PROB_LITERAL_OFFSET + (code) * LZMA_LITERAL_CODER_SIZE + (size))}\par
05371 \par
05372 {\cf20 /* Read an LZMA varint from BUF, reading and updating *POFFSET,}\par
05373 {\cf20    setting *VAL.  Returns 0 on error, 1 on success.  */}\par
05374 \par
05375 {\cf17 static} {\cf18 int}\par
05376 elf_lzma_varint ({\cf17 const} {\cf18 unsigned} {\cf18 char} *compressed, {\cf18 size_t} compressed_size,\par
05377          {\cf18 size_t} *poffset, uint64_t *val)\par
05378 \{\par
05379   {\cf18 size_t} off;\par
05380   {\cf18 int} i;\par
05381   uint64_t v;\par
05382   {\cf18 unsigned} {\cf18 char} b;\par
05383 \par
05384   off = *poffset;\par
05385   i = 0;\par
05386   v = 0;\par
05387   {\cf19 while} (1)\par
05388     \{\par
05389       {\cf19 if} (unlikely (off >= compressed_size))\par
05390     \{\par
05391       elf_uncompress_failed ();\par
05392       {\cf19 return} 0;\par
05393     \}\par
05394       b = compressed[off];\par
05395       v |= (b & 0x7f) << (i * 7);\par
05396       ++off;\par
05397       {\cf19 if} ((b & 0x80) == 0)\par
05398     \{\par
05399       *poffset = off;\par
05400       *val = v;\par
05401       {\cf19 return} 1;\par
05402     \}\par
05403       ++i;\par
05404       {\cf19 if} (unlikely (i >= 9))\par
05405     \{\par
05406       elf_uncompress_failed ();\par
05407       {\cf19 return} 0;\par
05408     \}\par
05409     \}\par
05410 \}\par
05411 \par
05412 {\cf20 /* Normalize the LZMA range decoder, pulling in an extra input byte if}\par
05413 {\cf20    needed.  */}\par
05414 \par
05415 {\cf17 static} {\cf18 void}\par
05416 elf_lzma_range_normalize ({\cf17 const} {\cf18 unsigned} {\cf18 char} *compressed,\par
05417               {\cf18 size_t} compressed_size, {\cf18 size_t} *poffset,\par
05418               uint32_t *prange, uint32_t *pcode)\par
05419 \{\par
05420   {\cf19 if} (*prange < (1U << 24))\par
05421     \{\par
05422       {\cf19 if} (unlikely (*poffset >= compressed_size))\par
05423     \{\par
05424       {\cf20 /* We assume this will be caught elsewhere.  */}\par
05425       elf_uncompress_failed ();\par
05426       {\cf19 return};\par
05427     \}\par
05428       *prange <<= 8;\par
05429       *pcode <<= 8;\par
05430       *pcode += compressed[*poffset];\par
05431       ++*poffset;\par
05432     \}\par
05433 \}\par
05434 \par
05435 {\cf20 /* Read and return a single bit from the LZMA stream, reading and}\par
05436 {\cf20    updating *PROB.  Each bit comes from the range coder.  */}\par
05437 \par
05438 {\cf17 static} {\cf18 int}\par
05439 elf_lzma_bit ({\cf17 const} {\cf18 unsigned} {\cf18 char} *compressed, {\cf18 size_t} compressed_size,\par
05440           uint16_t *prob, {\cf18 size_t} *poffset, uint32_t *prange,\par
05441           uint32_t *pcode)\par
05442 \{\par
05443   uint32_t bound;\par
05444 \par
05445   elf_lzma_range_normalize (compressed, compressed_size, poffset,\par
05446                 prange, pcode);\par
05447   bound = (*prange >> 11) * (uint32_t) *prob;\par
05448   {\cf19 if} (*pcode < bound)\par
05449     \{\par
05450       *prange = bound;\par
05451       *prob += ((1U << 11) - *prob) >> 5;\par
05452       {\cf19 return} 0;\par
05453     \}\par
05454   {\cf19 else}\par
05455     \{\par
05456       *prange -= bound;\par
05457       *pcode -= bound;\par
05458       *prob -= *prob >> 5;\par
05459       {\cf19 return} 1;\par
05460     \}\par
05461 \}\par
05462 \par
05463 {\cf20 /* Read an integer of size BITS from the LZMA stream, most significant}\par
05464 {\cf20    bit first.  The bits are predicted using PROBS.  */}\par
05465 \par
05466 {\cf17 static} uint32_t\par
05467 elf_lzma_integer ({\cf17 const} {\cf18 unsigned} {\cf18 char} *compressed, {\cf18 size_t} compressed_size,\par
05468           uint16_t *probs, uint32_t bits, {\cf18 size_t} *poffset,\par
05469           uint32_t *prange, uint32_t *pcode)\par
05470 \{\par
05471   uint32_t sym;\par
05472   uint32_t i;\par
05473 \par
05474   sym = 1;\par
05475   {\cf19 for} (i = 0; i < bits; i++)\par
05476     \{\par
05477       {\cf18 int} bit;\par
05478 \par
05479       bit = elf_lzma_bit (compressed, compressed_size, probs + sym, poffset,\par
05480               prange, pcode);\par
05481       sym <<= 1;\par
05482       sym += bit;\par
05483     \}\par
05484   {\cf19 return} sym - (1 << bits);\par
05485 \}\par
05486 \par
05487 {\cf20 /* Read an integer of size BITS from the LZMA stream, least}\par
05488 {\cf20    significant bit first.  The bits are predicted using PROBS.  */}\par
05489 \par
05490 {\cf17 static} uint32_t\par
05491 elf_lzma_reverse_integer ({\cf17 const} {\cf18 unsigned} {\cf18 char} *compressed,\par
05492               {\cf18 size_t} compressed_size, uint16_t *probs,\par
05493               uint32_t bits, {\cf18 size_t} *poffset, uint32_t *prange,\par
05494               uint32_t *pcode)\par
05495 \{\par
05496   uint32_t sym;\par
05497   uint32_t val;\par
05498   uint32_t i;\par
05499 \par
05500   sym = 1;\par
05501   val = 0;\par
05502   {\cf19 for} (i = 0; i < bits; i++)\par
05503     \{\par
05504       {\cf18 int} bit;\par
05505 \par
05506       bit = elf_lzma_bit (compressed, compressed_size, probs + sym, poffset,\par
05507               prange, pcode);\par
05508       sym <<= 1;\par
05509       sym += bit;\par
05510       val += bit << i;\par
05511     \}\par
05512   {\cf19 return} val;\par
05513 \}\par
05514 \par
05515 {\cf20 /* Read a length from the LZMA stream.  IS_REP picks either LZMA_MATCH}\par
05516 {\cf20    or LZMA_REP probabilities.  */}\par
05517 \par
05518 {\cf17 static} uint32_t\par
05519 elf_lzma_len ({\cf17 const} {\cf18 unsigned} {\cf18 char} *compressed, {\cf18 size_t} compressed_size,\par
05520           uint16_t *probs, {\cf18 int} is_rep, {\cf18 unsigned} {\cf18 int} pos_state,\par
05521           {\cf18 size_t} *poffset, uint32_t *prange, uint32_t *pcode)\par
05522 \{\par
05523   uint16_t *probs_choice;\par
05524   uint16_t *probs_sym;\par
