01128 {\cf20 /* *PVAL is the current value being read from the stream, and *PBITS}\par
01129 {\cf20    is the number of valid bits.  Ensure that *PVAL holds at least 15}\par
01130 {\cf20    bits by reading additional bits from *PPIN, up to PINEND, as}\par
01131 {\cf20    needed.  Updates *PPIN, *PVAL and *PBITS.  Returns 1 on success, 0}\par
01132 {\cf20    on error.  */}\par
01133 \par
01134 {\cf17 static} {\cf18 int}\par
01135 elf_fetch_bits ({\cf17 const} {\cf18 unsigned} {\cf18 char} **ppin, {\cf17 const} {\cf18 unsigned} {\cf18 char} *pinend,\par
01136         uint64_t *pval, {\cf18 unsigned} {\cf18 int} *pbits)\par
01137 \{\par
01138   {\cf18 unsigned} {\cf18 int} bits;\par
01139   {\cf17 const} {\cf18 unsigned} {\cf18 char} *pin;\par
01140   uint64_t val;\par
01141   uint32_t next;\par
01142 \par
01143   bits = *pbits;\par
01144   {\cf19 if} (bits >= 15)\par
01145     {\cf19 return} 1;\par
01146   pin = *ppin;\par
01147   val = *pval;\par
01148 \par
01149   {\cf19 if} (unlikely (pinend - pin < 4))\par
01150     \{\par
01151       elf_uncompress_failed ();\par
01152       {\cf19 return} 0;\par
01153     \}\par
01154 \par
01155 {\cf21 #if defined(__BYTE_ORDER__) && defined(__ORDER_LITTLE_ENDIAN__) \\}\par
01156 {\cf21     && defined(__ORDER_BIG_ENDIAN__) \\}\par
01157 {\cf21     && (__BYTE_ORDER__ == __ORDER_BIG_ENDIAN__ \\}\par
01158 {\cf21         || __BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__)}\par
