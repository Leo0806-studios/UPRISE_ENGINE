00641 {\cf20 /* Initialize the symbol table info for elf_syminfo.  */}\par
00642 \par
00643 {\cf17 static} {\cf18 int}\par
00644 elf_initialize_syminfo ({\cf17 struct} backtrace_state *state,\par
00645             uintptr_t base_address,\par
00646             {\cf17 const} {\cf18 unsigned} {\cf18 char} *symtab_data, {\cf18 size_t} symtab_size,\par
00647             {\cf17 const} {\cf18 unsigned} {\cf18 char} *strtab, {\cf18 size_t} strtab_size,\par
00648             backtrace_error_callback error_callback,\par
00649             {\cf18 void} *data, {\cf17 struct} elf_syminfo_data *sdata,\par
00650             {\cf17 struct} elf_ppc64_opd_data *opd)\par
00651 \{\par
00652   {\cf18 size_t} sym_count;\par
00653   {\cf17 const} b_elf_sym *sym;\par
00654   {\cf18 size_t} elf_symbol_count;\par
00655   {\cf18 size_t} elf_symbol_size;\par
00656   {\cf17 struct }elf_symbol *elf_symbols;\par
00657   {\cf18 size_t} i;\par
00658   {\cf18 unsigned} {\cf18 int} j;\par
00659 \par
00660   sym_count = symtab_size / {\cf17 sizeof} (b_elf_sym);\par
