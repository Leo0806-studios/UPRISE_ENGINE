03239       pbaseline->basebits = 0;\par
03240     \}\par
03241       {\cf19 else}\par
03242     \{\par
03243       {\cf18 unsigned} {\cf18 int} idx;\par
03244       uint32_t basebits;\par
03245 \par
03246       {\cf19 if} (unlikely (symbol > 52))\par
03247         \{\par
03248           elf_uncompress_failed ();\par
03249           {\cf19 return} 0;\par
03250         \}\par
03251       idx = symbol - ZSTD_MATCH_LENGTH_BASELINE_OFFSET;\par
03252       basebits = elf_zstd_match_length_base[idx];\par
03253       pbaseline->baseline = ZSTD_DECODE_BASELINE(basebits);\par
03254       pbaseline->basebits = ZSTD_DECODE_BASEBITS(basebits);\par
03255     \}\par
03256       pbaseline->bits = bits;\par
03257       pbaseline->base = base;\par
03258     \}\par
03259 \par
03260   {\cf19 return} 1;\par
03261 \}\par
