01181 \par
01182 {\cf20 /* This is like elf_fetch_bits, but it fetchs the bits backward, and ensures at}\par
01183 {\cf20    least 16 bits.  This is for zstd.  */}\par
01184 \par
01185 {\cf17 static} {\cf18 int}\par
01186 elf_fetch_bits_backward ({\cf17 const} {\cf18 unsigned} {\cf18 char} **ppin,\par
01187              {\cf17 const} {\cf18 unsigned} {\cf18 char} *pinend,\par
01188              uint64_t *pval, {\cf18 unsigned} {\cf18 int} *pbits)\par
01189 \{\par
01190   {\cf18 unsigned} {\cf18 int} bits;\par
01191   {\cf17 const} {\cf18 unsigned} {\cf18 char} *pin;\par
01192   uint64_t val;\par
01193   uint32_t next;\par
