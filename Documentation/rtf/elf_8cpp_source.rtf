01285 \par
01286   *pbits -= __builtin_clz (stream_start) - ({\cf17 sizeof} ({\cf18 unsigned} int) - 1) * 8 + 1;\par
01287 \par
01288   {\cf19 if} (!elf_fetch_bits_backward (ppin, pinend, pval, pbits))\par
01289     {\cf19 return} 0;\par
