05526   uint32_t len;\par
05527 \par
05528   probs_choice = probs + (is_rep\par
05529               ? LZMA_REP_LEN_CHOICE\par
05530               : LZMA_MATCH_LEN_CHOICE);\par
05531   {\cf19 if} (elf_lzma_bit (compressed, compressed_size, probs_choice, poffset,\par
05532             prange, pcode))\par
05533     \{\par
05534       probs_choice = probs + (is_rep\par
05535                   ? LZMA_REP_LEN_CHOICE2\par
05536                   : LZMA_MATCH_LEN_CHOICE2);\par
05537       {\cf19 if} (elf_lzma_bit (compressed, compressed_size, probs_choice,\par
05538             poffset, prange, pcode))\par
05539     \{\par
05540       probs_sym = probs + (is_rep\par
05541                    ? LZMA_REP_LEN_HIGH (0)\par
05542                    : LZMA_MATCH_LEN_HIGH (0));\par
05543       bits = 8;\par
05544       len = 2 + 8 + 8;\par
05545     \}\par
05546       {\cf19 else}\par
05547     \{\par
05548       probs_sym = probs + (is_rep\par
05549                    ? LZMA_REP_LEN_MID (pos_state, 0)\par
05550                    : LZMA_MATCH_LEN_MID (pos_state, 0));\par
05551       bits = 3;\par
05552       len = 2 + 8;\par
05553     \}\par
05554     \}\par
05555   {\cf19 else}\par
05556     \{\par
