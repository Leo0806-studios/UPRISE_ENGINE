01291   {\cf19 return} 1;\par
01292 \}\par
01293 \par
01294 {\cf20 /* Huffman code tables, like the rest of the zlib format, are defined}\par
01295 {\cf20    by RFC 1951.  We store a Huffman code table as a series of tables}\par
01296 {\cf20    stored sequentially in memory.  Each entry in a table is 16 bits.}\par
01297 {\cf20    The first, main, table has 256 entries.  It is followed by a set of}\par
01298 {\cf20    secondary tables of length 2 to 128 entries.  The maximum length of}\par
01299 {\cf20    a code sequence in the deflate format is 15 bits, so that is all we}\par
01300 {\cf20    need.  Each secondary table has an index, which is the offset of}\par
01301 {\cf20    the table in the overall memory storage.}\par
01302 {\cf20 }\par
01303 {\cf20    The deflate format says that all codes of a given bit length are}\par
01304 {\cf20    lexicographically consecutive.  Perhaps we could have 130 values}\par
01305 {\cf20    that require a 15-bit code, perhaps requiring three secondary}\par
01306 {\cf20    tables of size 128.  I don't know if this is actually possible, but}\par
01307 {\cf20    it suggests that the maximum size required for secondary tables is}\par
01308 {\cf20    3 * 128 + 3 * 64 ... == 768.  The zlib enough program reports 660}\par
01309 {\cf20    as the maximum.  We permit 768, since in addition to the 256 for}\par
01310 {\cf20    the primary table, with two bytes per entry, and with the two}\par
01311 {\cf20    tables we need, that gives us a page.}\par
01312 {\cf20 }\par
01313 {\cf20    A single table entry needs to store a value or (for the main table}\par
01314 {\cf20    only) the index and size of a secondary table.  Values range from 0}\par
01315 {\cf20    to 285, inclusive.  Secondary table indexes, per above, range from}\par
01316 {\cf20    0 to 510.  For a value we need to store the number of bits we need}\par
01317 {\cf20    to determine that value (one value may appear multiple times in the}\par
01318 {\cf20    table), which is 1 to 8.  For a secondary table we need to store}\par
01319 {\cf20    the number of bits used to index into the table, which is 1 to 7.}\par
01320 {\cf20    And of course we need 1 bit to decide whether we have a value or a}\par
01321 {\cf20    secondary table index.  So each entry needs 9 bits for value/table}\par
01322 {\cf20    index, 3 bits for size, 1 bit what it is.  For simplicity we use 16}\par
01323 {\cf20    bits per entry.  */}\par
01324 \par
01325 {\cf20 /* Number of entries we allocate to for one code table.  We get a page}\par
01326 {\cf20    for the two code tables we need.  */}\par
01327 \par
01328 {\cf21 #define ZLIB_HUFFMAN_TABLE_SIZE (1024)}\par
01329 \par
01330 {\cf20 /* Bit masks and shifts for the values in the table.  */}\par
01331 \par
01332 {\cf21 #define ZLIB_HUFFMAN_VALUE_MASK 0x01ff}\par
01333 {\cf21 #define ZLIB_HUFFMAN_BITS_SHIFT 9}\par
01334 {\cf21 #define ZLIB_HUFFMAN_BITS_MASK 0x7}\par
01335 {\cf21 #define ZLIB_HUFFMAN_SECONDARY_SHIFT 12}\par
01336 \par
01337 {\cf20 /* For working memory while inflating we need two code tables, we need}\par
01338 {\cf20    an array of code lengths (max value 15, so we use unsigned char),}\par
01339 {\cf20    and an array of unsigned shorts used while building a table.  The}\par
01340 {\cf20    latter two arrays must be large enough to hold the maximum number}\par
01341 {\cf20    of code lengths, which RFC 1951 defines as 286 + 30.  */}\par
01342 \par
01343 {\cf21 #define ZLIB_TABLE_SIZE \\}\par
01344 {\cf21   (2 * ZLIB_HUFFMAN_TABLE_SIZE * sizeof (uint16_t) \\}\par
01345 {\cf21    + (286 + 30) * sizeof (uint16_t)       \\}\par
01346 {\cf21    + (286 + 30) * sizeof (unsigned char))}\par
01347 \par
01348 {\cf21 #define ZLIB_TABLE_CODELEN_OFFSET \\}\par
01349 {\cf21   (2 * ZLIB_HUFFMAN_TABLE_SIZE * sizeof (uint16_t) \\}\par
01350 {\cf21    + (286 + 30) * sizeof (uint16_t))}\par
01351 \par
01352 {\cf21 #define ZLIB_TABLE_WORK_OFFSET \\}\par
01353 {\cf21   (2 * ZLIB_HUFFMAN_TABLE_SIZE * sizeof (uint16_t))}\par
01354 \par
01355 {\cf21 #ifdef BACKTRACE_GENERATE_FIXED_HUFFMAN_TABLE}\par
01356 \par
01357 {\cf20 /* Used by the main function that generates the fixed table to learn}\par
01358 {\cf20    the table size.  */}\par
01359 {\cf17 static} {\cf18 size_t} final_next_secondary;\par
01360 \par
01361 {\cf21 #endif}\par
01362 \par
01363 {\cf20 /* Build a Huffman code table from an array of lengths in CODES of}\par
01364 {\cf20    length CODES_LEN.  The table is stored into *TABLE.  ZDEBUG_TABLE}\par
01365 {\cf20    is the same as for elf_zlib_inflate, used to find some work space.}\par
01366 {\cf20    Returns 1 on success, 0 on error.  */}\par
01367 \par
01368 {\cf17 static} {\cf18 int}\par
01369 elf_zlib_inflate_table ({\cf18 unsigned} {\cf18 char} *codes, {\cf18 size_t} codes_len,\par
01370             uint16_t *zdebug_table, uint16_t *table)\par
01371 \{\par
01372   uint16_t count[16];\par
01373   uint16_t start[16];\par
01374   uint16_t prev[16];\par
01375   uint16_t firstcode[7];\par
01376   uint16_t *next;\par
01377   {\cf18 size_t} i;\par
01378   {\cf18 size_t} j;\par
01379   {\cf18 unsigned} {\cf18 int} code;\par
01380   {\cf18 size_t} next_secondary;\par
01381 \par
01382   {\cf20 /* Count the number of code of each length.  Set NEXT[val] to be the}\par
01383 {\cf20      next value after VAL with the same bit length.  */}\par
01384 \par
01385   next = (uint16_t *) ((({\cf18 unsigned} {\cf18 char} *) zdebug_table)\par
01386                + ZLIB_TABLE_WORK_OFFSET);\par
01387 \par
01388   memset (&count[0], 0, 16 * {\cf17 sizeof} (uint16_t));\par
01389   {\cf19 for} (i = 0; i < codes_len; ++i)\par
01390     \{\par
01391       {\cf19 if} (unlikely (codes[i] >= 16))\par
01392     \{\par
01393       elf_uncompress_failed ();\par
01394       {\cf19 return} 0;\par
01395     \}\par
01396 \par
01397       {\cf19 if} (count[codes[i]] == 0)\par
01398     \{\par
01399       start[codes[i]] = i;\par
01400       prev[codes[i]] = i;\par
01401     \}\par
01402       {\cf19 else}\par
01403     \{\par
01404       next[prev[codes[i]]] = i;\par
01405       prev[codes[i]] = i;\par
01406     \}\par
01407 \par
01408       ++count[codes[i]];\par
01409     \}\par
01410 \par
01411   {\cf20 /* For each length, fill in the table for the codes of that}\par
01412 {\cf20      length.  */}\par
01413 \par
01414   memset (table, 0, ZLIB_HUFFMAN_TABLE_SIZE * {\cf17 sizeof} (uint16_t));\par
01415 \par
01416   {\cf20 /* Handle the values that do not require a secondary table.  */}\par
01417 \par
01418   code = 0;\par
01419   {\cf19 for} (j = 1; j <= 8; ++j)\par
01420     \{\par
01421       {\cf18 unsigned} {\cf18 int} jcnt;\par
01422       {\cf18 unsigned} {\cf18 int} val;\par
01423 \par
01424       jcnt = count[j];\par
01425       {\cf19 if} (jcnt == 0)\par
01426     {\cf19 continue};\par
01427 \par
01428       {\cf19 if} (unlikely (jcnt > (1U << j)))\par
01429     \{\par
01430       elf_uncompress_failed ();\par
01431       {\cf19 return} 0;\par
01432     \}\par
01433 \par
01434       {\cf20 /* There are JCNT values that have this length, the values}\par
01435 {\cf20      starting from START[j] continuing through NEXT[VAL].  Those}\par
01436 {\cf20      values are assigned consecutive values starting at CODE.  */}\par
01437 \par
01438       val = start[j];\par
01439       {\cf19 for} (i = 0; i < jcnt; ++i)\par
01440     \{\par
01441       uint16_t tval;\par
01442       {\cf18 size_t} ind;\par
01443       {\cf18 unsigned} {\cf18 int} incr;\par
01444 \par
01445       {\cf20 /* In the compressed bit stream, the value VAL is encoded as}\par
01446 {\cf20          J bits with the value C.  */}\par
01447 \par
01448       {\cf19 if} (unlikely ((val & ~ZLIB_HUFFMAN_VALUE_MASK) != 0))\par
01449         \{\par
01450           elf_uncompress_failed ();\par
01451           {\cf19 return} 0;\par
01452         \}\par
01453 \par
01454       tval = val | ((j - 1) << ZLIB_HUFFMAN_BITS_SHIFT);\par
01455 \par
01456       {\cf20 /* The table lookup uses 8 bits.  If J is less than 8, we}\par
01457 {\cf20          don't know what the other bits will be.  We need to fill}\par
01458 {\cf20          in all possibilities in the table.  Since the Huffman}\par
01459 {\cf20          code is unambiguous, those entries can't be used for any}\par
01460 {\cf20          other code.  */}\par
01461 \par
01462       {\cf19 for} (ind = code; ind < 0x100; ind += 1 << j)\par
01463         \{\par
01464           {\cf19 if} (unlikely (table[ind] != 0))\par
01465         \{\par
01466           elf_uncompress_failed ();\par
01467           {\cf19 return} 0;\par
01468         \}\par
01469           table[ind] = tval;\par
01470         \}\par
01471 \par
01472       {\cf20 /* Advance to the next value with this length.  */}\par
01473       {\cf19 if} (i + 1 < jcnt)\par
01474         val = next[val];\par
01475 \par
01476       {\cf20 /* The Huffman codes are stored in the bitstream with the}\par
01477 {\cf20          most significant bit first, as is required to make them}\par
01478 {\cf20          unambiguous.  The effect is that when we read them from}\par
01479 {\cf20          the bitstream we see the bit sequence in reverse order:}\par
01480 {\cf20          the most significant bit of the Huffman code is the least}\par
01481 {\cf20          significant bit of the value we read from the bitstream.}\par
01482 {\cf20          That means that to make our table lookups work, we need}\par
01483 {\cf20          to reverse the bits of CODE.  Since reversing bits is}\par
01484 {\cf20          tedious and in general requires using a table, we instead}\par
01485 {\cf20          increment CODE in reverse order.  That is, if the number}\par
01486 {\cf20          of bits we are currently using, here named J, is 3, we}\par
01487 {\cf20          count as 000, 100, 010, 110, 001, 101, 011, 111, which is}\par
01488 {\cf20          to say the numbers from 0 to 7 but with the bits}\par
01489 {\cf20          reversed.  Going to more bits, aka incrementing J,}\par
01490 {\cf20          effectively just adds more zero bits as the beginning,}\par
01491 {\cf20          and as such does not change the numeric value of CODE.}\par
01492 {\cf20 }\par
01493 {\cf20          To increment CODE of length J in reverse order, find the}\par
01494 {\cf20          most significant zero bit and set it to one while}\par
01495 {\cf20          clearing all higher bits.  In other words, add 1 modulo}\par
01496 {\cf20          2^J, only reversed.  */}\par
01497 \par
01498       incr = 1U << (j - 1);\par
01499       {\cf19 while} ((code & incr) != 0)\par
01500         incr >>= 1;\par
01501       {\cf19 if} (incr == 0)\par
01502         code = 0;\par
01503       {\cf19 else}\par
01504         \{\par
01505           code &= incr - 1;\par
01506           code += incr;\par
01507         \}\par
01508     \}\par
01509     \}\par
01510 \par
01511   {\cf20 /* Handle the values that require a secondary table.  */}\par
01512 \par
01513   {\cf20 /* Set FIRSTCODE, the number at which the codes start, for each}\par
01514 {\cf20      length.  */}\par
01515 \par
01516   {\cf19 for} (j = 9; j < 16; j++)\par
01517     \{\par
01518       {\cf18 unsigned} {\cf18 int} jcnt;\par
01519       {\cf18 unsigned} {\cf18 int} k;\par
01520 \par
01521       jcnt = count[j];\par
01522       {\cf19 if} (jcnt == 0)\par
01523     {\cf19 continue};\par
01524 \par
01525       {\cf20 /* There are JCNT values that have this length, the values}\par
01526 {\cf20      starting from START[j].  Those values are assigned}\par
01527 {\cf20      consecutive values starting at CODE.  */}\par
01528 \par
01529       firstcode[j - 9] = code;\par
