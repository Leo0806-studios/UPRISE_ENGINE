03070 {\cf20 /* An entry in an FSE table used for literal/match/length values.  For these we}\par
03071 {\cf20    have to map the symbol to a baseline value, and we have to read zero or more}\par
03072 {\cf20    bits and add that value to the baseline value.  Rather than look the values}\par
03073 {\cf20    up in a separate table, we grow the FSE table so that we get better memory}\par
03074 {\cf20    caching.  */}\par
03075 \par
03076 {\cf17 struct }elf_zstd_fse_baseline_entry\par
03077 \{\par
03078   {\cf20 /* The baseline for the value that this FSE entry represents..  */}\par
03079   uint32_t baseline;\par
03080   {\cf20 /* The number of bits to read to add to the baseline.  */}\par
03081   {\cf18 unsigned} {\cf18 char} basebits;\par
03082   {\cf20 /* The number of bits to read to determine the next state.  */}\par
03083   {\cf18 unsigned} {\cf18 char} bits;\par
03084   {\cf20 /* Add the bits to this base to get the next state.  */}\par
03085   uint16_t base;\par
03086 \};\par
03087 \par
03088 {\cf20 /* Convert the literal length FSE table FSE_TABLE to an FSE baseline table at}\par
03089 {\cf20    BASELINE_TABLE.  Note that FSE_TABLE and BASELINE_TABLE will overlap.  */}\par
03090 \par
03091 {\cf17 static} {\cf18 int}\par
03092 elf_zstd_make_literal_baseline_fse (\par
03093     {\cf17 const} {\cf17 struct} elf_zstd_fse_entry *fse_table,\par
03094     {\cf18 int} table_bits,\par
03095     {\cf17 struct} elf_zstd_fse_baseline_entry *baseline_table)\par
03096 \{\par
03097   {\cf18 size_t} count;\par
03098   {\cf17 const} {\cf17 struct }elf_zstd_fse_entry *pfse;\par
03099   {\cf17 struct }elf_zstd_fse_baseline_entry *pbaseline;\par
03100 \par
03101   {\cf20 /* Convert backward to avoid overlap.  */}\par
03102 \par
03103   count = 1U << table_bits;\par
03104   pfse = fse_table + count;\par
03105   pbaseline = baseline_table + count;\par
03106   {\cf19 while} (pfse > fse_table)\par
03107     \{\par
03108       {\cf18 unsigned} {\cf18 char} symbol;\par
03109       {\cf18 unsigned} {\cf18 char} bits;\par
03110       uint16_t base;\par
03111 \par
03112       --pfse;\par
03113       --pbaseline;\par
03114       symbol = pfse->symbol;\par
03115       bits = pfse->bits;\par
03116       base = pfse->base;\par
03117       {\cf19 if} (symbol < ZSTD_LITERAL_LENGTH_BASELINE_OFFSET)\par
03118     \{\par
03119       pbaseline->baseline = (uint32_t)symbol;\par
03120       pbaseline->basebits = 0;\par
03121     \}\par
03122       {\cf19 else}\par
03123     \{\par
03124       {\cf18 unsigned} {\cf18 int} idx;\par
03125       uint32_t basebits;\par
03126 \par
03127       {\cf19 if} (unlikely (symbol > 35))\par
03128         \{\par
03129           elf_uncompress_failed ();\par
03130           {\cf19 return} 0;\par
03131         \}\par
03132       idx = symbol - ZSTD_LITERAL_LENGTH_BASELINE_OFFSET;\par
03133       basebits = elf_zstd_literal_length_base[idx];\par
03134       pbaseline->baseline = ZSTD_DECODE_BASELINE(basebits);\par
03135       pbaseline->basebits = ZSTD_DECODE_BASEBITS(basebits);\par
03136     \}\par
03137       pbaseline->bits = bits;\par
03138       pbaseline->base = base;\par
03139     \}\par
03140 \par
03141   {\cf19 return} 1;\par
03142 \}\par
03143 \par
03144 {\cf20 /* Convert the offset length FSE table FSE_TABLE to an FSE baseline table at}\par
03145 {\cf20    BASELINE_TABLE.  Note that FSE_TABLE and BASELINE_TABLE will overlap.  */}\par
03146 \par
03147 {\cf17 static} {\cf18 int}\par
03148 elf_zstd_make_offset_baseline_fse (\par
03149     {\cf17 const} {\cf17 struct} elf_zstd_fse_entry *fse_table,\par
03150     {\cf18 int} table_bits,\par
03151     {\cf17 struct} elf_zstd_fse_baseline_entry *baseline_table)\par
03152 \{\par
03153   {\cf18 size_t} count;\par
03154   {\cf17 const} {\cf17 struct }elf_zstd_fse_entry *pfse;\par
03155   {\cf17 struct }elf_zstd_fse_baseline_entry *pbaseline;\par
03156 \par
03157   {\cf20 /* Convert backward to avoid overlap.  */}\par
03158 \par
03159   count = 1U << table_bits;\par
03160   pfse = fse_table + count;\par
03161   pbaseline = baseline_table + count;\par
03162   {\cf19 while} (pfse > fse_table)\par
03163     \{\par
03164       {\cf18 unsigned} {\cf18 char} symbol;\par
03165       {\cf18 unsigned} {\cf18 char} bits;\par
03166       uint16_t base;\par
03167 \par
03168       --pfse;\par
03169       --pbaseline;\par
03170       symbol = pfse->symbol;\par
03171       bits = pfse->bits;\par
03172       base = pfse->base;\par
03173       {\cf19 if} (unlikely (symbol > 31))\par
03174     \{\par
03175       elf_uncompress_failed ();\par
03176       {\cf19 return} 0;\par
03177     \}\par
03178 \par
03179       {\cf20 /* The simple way to write this is}\par
03180 {\cf20 }\par
03181 {\cf20        pbaseline->baseline = (uint32_t)1 << symbol;}\par
03182 {\cf20        pbaseline->basebits = symbol;}\par
03183 {\cf20 }\par
03184 {\cf20      That will give us an offset value that corresponds to the one}\par
03185 {\cf20      described in the RFC.  However, for offset values > 3, we have to}\par
03186 {\cf20      subtract 3.  And for offset values 1, 2, 3 we use a repeated offset.}\par
03187 {\cf20      The baseline is always a power of 2, and is never 0, so for these low}\par
03188 {\cf20      values we will see one entry that is baseline 1, basebits 0, and one}\par
03189 {\cf20      entry that is baseline 2, basebits 1.  All other entries will have}\par
03190 {\cf20      baseline >= 4 and basebits >= 2.}\par
03191 {\cf20 }\par
03192 {\cf20      So we can check for RFC offset <= 3 by checking for basebits <= 1.}\par
03193 {\cf20      And that means that we can subtract 3 here and not worry about doing}\par
03194 {\cf20      it in the hot loop.  */}\par
03195 \par
03196       pbaseline->baseline = (uint32_t)1 << symbol;\par
03197       {\cf19 if} (symbol >= 2)\par
03198     pbaseline->baseline -= 3;\par
03199       pbaseline->basebits = symbol;\par
03200       pbaseline->bits = bits;\par
03201       pbaseline->base = base;\par
03202     \}\par
03203 \par
03204   {\cf19 return} 1;\par
03205 \}\par
03206 \par
03207 {\cf20 /* Convert the match length FSE table FSE_TABLE to an FSE baseline table at}\par
03208 {\cf20    BASELINE_TABLE.  Note that FSE_TABLE and BASELINE_TABLE will overlap.  */}\par
03209 \par
03210 {\cf17 static} {\cf18 int}\par
03211 elf_zstd_make_match_baseline_fse (\par
03212     {\cf17 const} {\cf17 struct} elf_zstd_fse_entry *fse_table,\par
03213     {\cf18 int} table_bits,\par
