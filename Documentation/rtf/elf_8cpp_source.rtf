00666     \{\par
00667       {\cf18 int} info;\par
00668 \par
00669       info = sym->st_info & 0xf;\par
00670       {\cf19 if} ((info == STT_FUNC || info == STT_OBJECT)\par
00671       && sym->st_shndx != SHN_UNDEF)\par
00672     ++elf_symbol_count;\par
00673     \}\par
00674 \par
00675   elf_symbol_size = elf_symbol_count * {\cf17 sizeof} ({\cf17 struct }elf_symbol);\par
00676   elf_symbols = (({\cf17 struct }elf_symbol *)\par
00677          backtrace_alloc (state, elf_symbol_size, error_callback,\par
00678                   data));\par
00679   {\cf19 if} (elf_symbols == NULL)\par
00680     {\cf19 return} 0;\par
00681 \par
00682   sym = ({\cf17 const} b_elf_sym *) symtab_data;\par
00683   j = 0;\par
00684   {\cf19 for} (i = 0; i < sym_count; ++i, ++sym)\par
00685     \{\par
00686       {\cf18 int} info;\par
00687 \par
00688       info = sym->st_info & 0xf;\par
00689       {\cf19 if} (info != STT_FUNC && info != STT_OBJECT)\par
00690     {\cf19 continue};\par
00691       {\cf19 if} (sym->st_shndx == SHN_UNDEF)\par
00692     {\cf19 continue};\par
00693       {\cf19 if} (sym->st_name >= strtab_size)\par
00694     \{\par
00695       error_callback (data, {\cf22 "symbol string index out of range"}, 0);\par
00696       backtrace_free (state, elf_symbols, elf_symbol_size, error_callback,\par
00697               data);\par
00698       {\cf19 return} 0;\par
00699     \}\par
00700       elf_symbols[j].name = ({\cf17 const} {\cf18 char} *) strtab + sym->st_name;\par
00701       {\cf20 /* Special case PowerPC64 ELFv1 symbols in .opd section, if the symbol}\par
00702 {\cf20      is a function descriptor, read the actual code address from the}\par
00703 {\cf20      descriptor.  */}\par
00704       {\cf19 if} (opd\par
00705       && sym->st_value >= opd->addr\par
00706       && sym->st_value < opd->addr + opd->size)\par
00707     elf_symbols[j].address\par
00708       = *({\cf17 const} b_elf_addr *) (opd->data + (sym->st_value - opd->addr));\par
00709       {\cf19 else}\par
00710     elf_symbols[j].address = sym->st_value;\par
00711       elf_symbols[j].address += base_address;\par
00712       elf_symbols[j].size = sym->st_size;\par
00713       ++j;\par
00714     \}\par
00715 \par
00716   backtrace_qsort (elf_symbols, elf_symbol_count, {\cf17 sizeof} ({\cf17 struct} elf_symbol),\par
00717            elf_symbol_compare);\par
