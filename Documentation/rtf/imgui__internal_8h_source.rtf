3616     {\cf20 // Shortcut Testing & Routing}\par
3617     {\cf20 // - Set Shortcut() and SetNextItemShortcut() in imgui.h}\par
3618     {\cf20 // - When a policy (except for ImGuiInputFlags_RouteAlways *) is set, Shortcut() will register itself with SetShortcutRouting(),}\par
3619     {\cf20 //   allowing the system to decide where to route the input among other route-aware calls.}\par
3620     {\cf20 //   (* using ImGuiInputFlags_RouteAlways is roughly equivalent to calling IsKeyChordPressed(key) and bypassing route registration and check)}\par
3621     {\cf20 // - When using one of the routing option:}\par
3622     {\cf20 //   - The default route is ImGuiInputFlags_RouteFocused (accept inputs if window is in focus stack. Deep-most focused window takes inputs. ActiveId takes inputs over deep-most focused window.)}\par
3623     {\cf20 //   - Routes are requested given a chord (key + modifiers) and a routing policy.}\par
3624     {\cf20 //   - Routes are resolved during NewFrame(): if keyboard modifiers are matching current ones: SetKeyOwner() is called + route is granted for the frame.}\par
3625     {\cf20 //   - Each route may be granted to a single owner. When multiple requests are made we have policies to select the winning route (e.g. deep most window).}\par
3626     {\cf20 //   - Multiple read sites may use the same owner id can all access the granted route.}\par
3627     {\cf20 //   - When owner_id is 0 we use the current Focus Scope ID as a owner ID in order to identify our location.}\par
3628     {\cf20 // - You can chain two unrelated windows in the focus stack using SetWindowParentWindowForFocusRoute()}\par
3629     {\cf20 //   e.g. if you have a tool window associated to a document, and you want document shortcuts to run when the tool is focused.}\par
3630     IMGUI_API {\cf18 bool}          Shortcut(ImGuiKeyChord key_chord, ImGuiInputFlags flags, ImGuiID owner_id);\par
3631     IMGUI_API {\cf18 bool}          SetShortcutRouting(ImGuiKeyChord key_chord, ImGuiInputFlags flags, ImGuiID owner_id); {\cf20 // owner_id needs to be explicit and cannot be 0}\par
3632     IMGUI_API {\cf18 bool}          TestShortcutRouting(ImGuiKeyChord key_chord, ImGuiID owner_id);\par
3633     IMGUI_API ImGuiKeyRoutingData* GetShortcutRoutingData(ImGuiKeyChord key_chord);\par
