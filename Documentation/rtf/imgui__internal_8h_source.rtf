566     {\cf18 bool}        Contains({\cf17 const} ImVec2& p){\cf17  const     }\{ {\cf19 return} p.x     >= Min.x && p.y     >= Min.y && p.x     <  Max.x && p.y     <  Max.y; \}\par
567     {\cf18 bool}        Contains({\cf17 const} ImRect& r){\cf17  const     }\{ {\cf19 return} r.Min.x >= Min.x && r.Min.y >= Min.y && r.Max.x <= Max.x && r.Max.y <= Max.y; \}\par
568     {\cf18 bool}        ContainsWithPad({\cf17 const} ImVec2& p, {\cf17 const} ImVec2& pad){\cf17  const }\{ {\cf19 return} p.x >= Min.x - pad.x && p.y >= Min.y - pad.y && p.x < Max.x + pad.x && p.y < Max.y + pad.y; \}\par
