665 {\cf20 // Helper: ImSpanAllocator<>}\par
666 {\cf20 // Facilitate storing multiple chunks into a single large block (the "arena")}\par
667 {\cf20 // - Usage: call Reserve() N times, allocate GetArenaSizeInBytes() worth, pass it to SetArenaBasePtr(), call GetSpan() N times to retrieve the aligned ranges.}\par
668 {\cf17 template}<{\cf18 int} CHUNKS>\par
669 {\cf17 struct }ImSpanAllocator\par
670 \{\par
671     {\cf18 char}*   BasePtr;\par
672     {\cf18 int}     CurrOff;\par
673     {\cf18 int}     CurrIdx;\par
674     {\cf18 int}     Offsets[CHUNKS];\par
675     {\cf18 int}     Sizes[CHUNKS];\par
676 \par
677     ImSpanAllocator()                               \{ memset({\cf17 this}, 0, {\cf17 sizeof}(*{\cf17 this})); \}\par
678     {\cf17 inline} {\cf18 void}  Reserve({\cf18 int} n, {\cf18 size_t} sz, {\cf18 int} a=4) \{ IM_ASSERT(n == CurrIdx && n < CHUNKS); CurrOff = IM_MEMALIGN(CurrOff, a); Offsets[n] = CurrOff; Sizes[n] = (int)sz; CurrIdx++; CurrOff += (int)sz; \}\par
679     {\cf17 inline} {\cf18 int}   GetArenaSizeInBytes()              \{ {\cf19 return} CurrOff; \}\par
680     {\cf17 inline} {\cf18 void}  SetArenaBasePtr({\cf18 void}* base_ptr)    \{ BasePtr = ({\cf18 char}*)base_ptr; \}\par
681     {\cf17 inline} {\cf18 void}* GetSpanPtrBegin({\cf18 int} n)             \{ IM_ASSERT(n >= 0 && n < CHUNKS && CurrIdx == CHUNKS); {\cf19 return} ({\cf18 void}*)(BasePtr + Offsets[n]); \}\par
682     {\cf17 inline} {\cf18 void}* GetSpanPtrEnd({\cf18 int} n)               \{ IM_ASSERT(n >= 0 && n < CHUNKS && CurrIdx == CHUNKS); {\cf19 return} ({\cf18 void}*)(BasePtr + Offsets[n] + Sizes[n]); \}\par
683     {\cf17 template}<{\cf17 typename} T>\par
684     {\cf17 inline} {\cf18 void}  GetSpan({\cf18 int} n, ImSpan<T>* span)    \{ span->set((T*)GetSpanPtrBegin(n), (T*)GetSpanPtrEnd(n)); \}\par
685 \};\par
