762 \par
763 {\cf20 // ImDrawList: Helper function to calculate a circle's segment count given its radius and a "maximum error" value.}\par
764 {\cf20 // Estimation of number of circle segment based on error is derived using method described in https://stackoverflow.com/a/2244088/15194693}\par
765 {\cf20 // Number of segments (N) is calculated using equation:}\par
766 {\cf20 //   N = ceil ( pi / acos(1 - error / r) )     where r > 0, error <= r}\par
767 {\cf20 // Our equation is significantly simpler that one in the post thanks for choosing segment that is}\par
768 {\cf20 // perpendicular to X axis. Follow steps in the article from this starting condition and you will}\par
769 {\cf20 // will get this result.}\par
770 {\cf20 //}\par
771 {\cf20 // Rendering circles with an odd number of segments, while mathematically correct will produce}\par
772 {\cf20 // asymmetrical results on the raster grid. Therefore we're rounding N to next even number (7->8, 8->8, 9->10 etc.)}\par
773 {\cf21 #define IM_ROUNDUP_TO_EVEN(_V)                                  ((((_V) + 1) / 2) * 2)}\par
774 {\cf21 #define IM_DRAWLIST_CIRCLE_AUTO_SEGMENT_MIN                     4}\par
775 {\cf21 #define IM_DRAWLIST_CIRCLE_AUTO_SEGMENT_MAX                     512}\par
776 {\cf21 #define IM_DRAWLIST_CIRCLE_AUTO_SEGMENT_CALC(_RAD,_MAXERROR)    ImClamp(IM_ROUNDUP_TO_EVEN((int)ImCeil(IM_PI / ImAcos(1 - ImMin((_MAXERROR), (_RAD)) / (_RAD)))), IM_DRAWLIST_CIRCLE_AUTO_SEGMENT_MIN, IM_DRAWLIST_CIRCLE_AUTO_SEGMENT_MAX)}\par
777 \par
778 {\cf20 // Raw equation from IM_DRAWLIST_CIRCLE_AUTO_SEGMENT_CALC rewritten for 'r' and 'error'.}\par
779 {\cf21 #define IM_DRAWLIST_CIRCLE_AUTO_SEGMENT_CALC_R(_N,_MAXERROR)    ((_MAXERROR) / (1 - ImCos(IM_PI / ImMax((float)(_N), IM_PI))))}\par
780 {\cf21 #define IM_DRAWLIST_CIRCLE_AUTO_SEGMENT_CALC_ERROR(_N,_RAD)     ((1 - ImCos(IM_PI / ImMax((float)(_N), IM_PI))) / (_RAD))}\par
