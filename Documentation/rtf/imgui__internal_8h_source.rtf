3583     {\cf20 // [EXPERIMENTAL] Low-Level: Key/Input Ownership}\par
3584     {\cf20 // - The idea is that instead of "eating" a given input, we can link to an owner id.}\par
3585     {\cf20 // - Ownership is most often claimed as a result of reacting to a press/down event (but occasionally may be claimed ahead).}\par
3586     {\cf20 // - Input queries can then read input by specifying ImGuiKeyOwner_Any (== 0), ImGuiKeyOwner_NoOwner (== -1) or a custom ID.}\par
3587     {\cf20 // - Legacy input queries (without specifying an owner or _Any or _None) are equivalent to using ImGuiKeyOwner_Any (== 0).}\par
3588     {\cf20 // - Input ownership is automatically released on the frame after a key is released. Therefore:}\par
3589     {\cf20 //   - for ownership registration happening as a result of a down/press event, the SetKeyOwner() call may be done once (common case).}\par
3590     {\cf20 //   - for ownership registration happening ahead of a down/press event, the SetKeyOwner() call needs to be made every frame (happens if e.g. claiming ownership on hover).}\par
3591     {\cf20 // - SetItemKeyOwner() is a shortcut for common simple case. A custom widget will probably want to call SetKeyOwner() multiple times directly based on its interaction state.}\par
3592     {\cf20 // - This is marked experimental because not all widgets are fully honoring the Set/Test idioms. We will need to move forward step by step.}\par
3593     {\cf20 //   Please open a GitHub Issue to submit your usage scenario or if there's a use case you need solved.}\par
3594     IMGUI_API ImGuiID       GetKeyOwner(ImGuiKey key);\par
3595     IMGUI_API {\cf18 void}          SetKeyOwner(ImGuiKey key, ImGuiID owner_id, ImGuiInputFlags flags = 0);\par
3596     IMGUI_API {\cf18 void}          SetKeyOwnersForKeyChord(ImGuiKeyChord key, ImGuiID owner_id, ImGuiInputFlags flags = 0);\par
3597     IMGUI_API {\cf18 void}          SetItemKeyOwner(ImGuiKey key, ImGuiInputFlags flags);       {\cf20 // Set key owner to last item if it is hovered or active. Equivalent to 'if (IsItemHovered() || IsItemActive()) \{ SetKeyOwner(key, GetItemID());'.}\par
3598     IMGUI_API {\cf18 bool}          TestKeyOwner(ImGuiKey key, ImGuiID owner_id);               {\cf20 // Test that key is either not owned, either owned by 'owner_id'}\par
3599     {\cf17 inline} ImGuiKeyOwnerData* GetKeyOwnerData(ImGuiContext* ctx, ImGuiKey key)          \{ {\cf19 if} (key & ImGuiMod_Mask_) key = ConvertSingleModFlagToKey(key); IM_ASSERT(IsNamedKey(key)); {\cf19 return} &ctx->KeysOwnerData[key - ImGuiKey_NamedKey_BEGIN]; \}\par
