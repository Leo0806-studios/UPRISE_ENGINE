687 {\cf20 // Helper: ImPool<>}\par
688 {\cf20 // Basic keyed storage for contiguous instances, slow/amortized insertion, O(1) indexable, O(Log N) queries by ID over a dense/hot buffer,}\par
689 {\cf20 // Honor constructor/destructor. Add/remove invalidate all pointers. Indexes have the same lifetime as the associated object.}\par
690 {\cf17 typedef} {\cf18 int} ImPoolIdx;\par
691 {\cf17 template}<{\cf17 typename} T>\par
692 {\cf17 struct }ImPool\par
693 \{\par
694     ImVector<T>     Buf;        {\cf20 // Contiguous data}\par
695     ImGuiStorage    Map;        {\cf20 // ID->Index}\par
696     ImPoolIdx       FreeIdx;    {\cf20 // Next free idx to use}\par
697     ImPoolIdx       AliveCount; {\cf20 // Number of active/alive items (for display purpose)}\par
698 \par
699     ImPool()    \{ FreeIdx = AliveCount = 0; \}\par
700     ~ImPool()   \{ Clear(); \}\par
701     T*          GetByKey(ImGuiID key)               \{ {\cf18 int} idx = Map.GetInt(key, -1); {\cf19 return} (idx != -1) ? &Buf[idx] : NULL; \}\par
702     T*          GetByIndex(ImPoolIdx n)             \{ {\cf19 return} &Buf[n]; \}\par
703     ImPoolIdx   GetIndex({\cf17 const} T* p){\cf17  const          }\{ IM_ASSERT(p >= Buf.Data && p < Buf.Data + Buf.Size); {\cf19 return} (ImPoolIdx)(p - Buf.Data); \}\par
704     T*          GetOrAddByKey(ImGuiID key)          \{ {\cf18 int}* p_idx = Map.GetIntRef(key, -1); {\cf19 if} (*p_idx != -1) {\cf19 return} &Buf[*p_idx]; *p_idx = FreeIdx; {\cf19 return} Add(); \}\par
705     {\cf18 bool}        Contains({\cf17 const} T* p){\cf17  const          }\{ {\cf19 return} (p >= Buf.Data && p < Buf.Data + Buf.Size); \}\par
706     {\cf18 void}        Clear()                             \{ {\cf19 for} ({\cf18 int} n = 0; n < Map.Data.Size; n++) \{ {\cf18 int} idx = Map.Data[n].val_i; {\cf19 if} (idx != -1) Buf[idx].~T(); \} Map.Clear(); Buf.clear(); FreeIdx = AliveCount = 0; \}\par
707     T*          Add()                               \{ {\cf18 int} idx = FreeIdx; {\cf19 if} (idx == Buf.Size) \{ Buf.resize(Buf.Size + 1); FreeIdx++; \} {\cf19 else} \{ FreeIdx = *({\cf18 int}*)&Buf[idx]; \} IM_PLACEMENT_NEW(&Buf[idx]) T(); AliveCount++; {\cf19 return} &Buf[idx]; \}\par
708     {\cf18 void}        Remove(ImGuiID key, {\cf17 const} T* p)     \{ Remove(key, GetIndex(p)); \}\par
709     {\cf18 void}        Remove(ImGuiID key, ImPoolIdx idx)  \{ Buf[idx].~T(); *({\cf18 int}*)&Buf[idx] = FreeIdx; FreeIdx = idx; Map.SetInt(key, -1); AliveCount--; \}\par
710     {\cf18 void}        Reserve({\cf18 int} capacity)               \{ Buf.reserve(capacity); Map.Data.reserve(capacity); \}\par
711 \par
712     {\cf20 // To iterate a ImPool: for (int n = 0; n < pool.GetMapSize(); n++) if (T* t = pool.TryGetMapData(n)) \{ ... \}}\par
713     {\cf20 // Can be avoided if you know .Remove() has never been called on the pool, or AliveCount == GetMapSize()}\par
714     {\cf18 int}         GetAliveCount(){\cf17  const               }\{ {\cf19 return} AliveCount; \}      {\cf20 // Number of active/alive items in the pool (for display purpose)}\par
715     {\cf18 int}         GetBufSize(){\cf17  const                  }\{ {\cf19 return} Buf.Size; \}\par
716     {\cf18 int}         GetMapSize(){\cf17  const                  }\{ {\cf19 return} Map.Data.Size; \}   {\cf20 // It is the map we need iterate to find valid items, since we don't have "alive" storage anywhere}\par
717     T*          TryGetMapData(ImPoolIdx n)          \{ {\cf18 int} idx = Map.Data[n].val_i; {\cf19 if} (idx == -1) {\cf19 return} NULL; {\cf19 return} GetByIndex(idx); \}\par
718 \};\par
719 \par
720 {\cf20 // Helper: ImChunkStream<>}\par
721 {\cf20 // Build and iterate a contiguous stream of variable-sized structures.}\par
722 {\cf20 // This is used by Settings to store persistent data while reducing allocation count.}\par
723 {\cf20 // We store the chunk size first, and align the final size on 4 bytes boundaries.}\par
724 {\cf20 // The tedious/zealous amount of casting is to avoid -Wcast-align warnings.}\par
725 {\cf17 template}<{\cf17 typename} T>\par
726 {\cf17 struct }ImChunkStream\par
727 \{\par
728     ImVector<char>  Buf;\par
729 \par
730     {\cf18 void}    clear()                     \{ Buf.clear(); \}\par
731     {\cf18 bool}    empty(){\cf17  const               }\{ {\cf19 return} Buf.Size == 0; \}\par
732     {\cf18 int}     size(){\cf17  const                }\{ {\cf19 return} Buf.Size; \}\par
733     T*      alloc_chunk({\cf18 size_t} sz)      \{ {\cf18 size_t} HDR_SZ = 4; sz = IM_MEMALIGN(HDR_SZ + sz, 4u); {\cf18 int} off = Buf.Size; Buf.resize(off + ({\cf18 int})sz); (({\cf18 int}*)({\cf18 void}*)(Buf.Data + off))[0] = (int)sz; {\cf19 return} (T*)({\cf18 void}*)(Buf.Data + off + ({\cf18 int})HDR_SZ); \}\par
734     T*      begin()                     \{ {\cf18 size_t} HDR_SZ = 4; {\cf19 if} (!Buf.Data) {\cf19 return} NULL; {\cf19 return} (T*)({\cf18 void}*)(Buf.Data + HDR_SZ); \}\par
735     T*      next_chunk(T* p)            \{ {\cf18 size_t} HDR_SZ = 4; IM_ASSERT(p >= begin() && p < end()); p = (T*)({\cf18 void}*)(({\cf18 char}*)({\cf18 void}*)p + chunk_size(p)); {\cf19 if} (p == (T*)({\cf18 void}*)(({\cf18 char}*)end() + HDR_SZ)) {\cf19 return} (T*)0; IM_ASSERT(p < end()); {\cf19 return} p; \}\par
736     {\cf18 int}     chunk_size({\cf17 const} T* p)      \{ {\cf19 return} (({\cf17 const} {\cf18 int}*)p)[-1]; \}\par
737     T*      end()                       \{ {\cf19 return} (T*)({\cf18 void}*)(Buf.Data + Buf.Size); \}\par
738     {\cf18 int}     offset_from_ptr({\cf17 const} T* p) \{ IM_ASSERT(p >= begin() && p < end()); {\cf17 const} ptrdiff_t off = ({\cf17 const} {\cf18 char}*)p - Buf.Data; {\cf19 return} ({\cf18 int})off; \}\par
739     T*      ptr_from_offset({\cf18 int} off)    \{ IM_ASSERT(off >= 4 && off < Buf.Size); {\cf19 return} (T*)({\cf18 void}*)(Buf.Data + off); \}\par
740     {\cf18 void}    swap(ImChunkStream<T>& rhs) \{ rhs.Buf.swap(Buf); \}\par
741 \};\par
