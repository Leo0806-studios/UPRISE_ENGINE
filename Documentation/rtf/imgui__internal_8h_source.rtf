585 {\cf21 #define         IM_BITARRAY_TESTBIT(_ARRAY, _N)                 ((_ARRAY[(_N) >> 5] & ((ImU32)1 << ((_N) & 31))) != 0) }{\cf20 // Macro version of ImBitArrayTestBit(): ensure args have side-effect or are costly!}\par
586 {\cf21 #define         IM_BITARRAY_CLEARBIT(_ARRAY, _N)                ((_ARRAY[(_N) >> 5] &= ~((ImU32)1 << ((_N) & 31))))    }{\cf20 // Macro version of ImBitArrayClearBit(): ensure args have side-effect or are costly!}\par
587 {\cf17 inline} {\cf18 size_t}   ImBitArrayGetStorageSizeInBytes({\cf18 int} bitcount)   \{ {\cf19 return} ({\cf18 size_t})((bitcount + 31) >> 5) << 2; \}\par
588 {\cf17 inline} {\cf18 void}     ImBitArrayClearAllBits(ImU32* arr, {\cf18 int} bitcount)\{ memset(arr, 0, ImBitArrayGetStorageSizeInBytes(bitcount)); \}\par
589 {\cf17 inline} {\cf18 bool}     ImBitArrayTestBit({\cf17 const} ImU32* arr, {\cf18 int} n)      \{ ImU32 mask = (ImU32)1 << (n & 31); {\cf19 return} (arr[n >> 5] & mask) != 0; \}\par
590 {\cf17 inline} {\cf18 void}     ImBitArrayClearBit(ImU32* arr, {\cf18 int} n)           \{ ImU32 mask = (ImU32)1 << (n & 31); arr[n >> 5] &= ~mask; \}\par
591 {\cf17 inline} {\cf18 void}     ImBitArraySetBit(ImU32* arr, {\cf18 int} n)             \{ ImU32 mask = (ImU32)1 << (n & 31); arr[n >> 5] |= mask; \}\par
592 {\cf17 inline} {\cf18 void}     ImBitArraySetBitRange(ImU32* arr, {\cf18 int} n, {\cf18 int} n2) {\cf20 // Works on range [n..n2)}\par
593 \{\par
594     n2--;\par
595     {\cf19 while} (n <= n2)\par
596     \{\par
597         {\cf18 int} a_mod = (n & 31);\par
598         {\cf18 int} b_mod = (n2 > (n | 31) ? 31 : (n2 & 31)) + 1;\par
599         ImU32 mask = (ImU32)(((ImU64)1 << b_mod) - 1) & ~(ImU32)(((ImU64)1 << a_mod) - 1);\par
600         arr[n >> 5] |= mask;\par
601         n = (n + 32) & ~31;\par
602     \}\par
603 \}\par
604 \par
605 {\cf17 typedef} ImU32* ImBitArrayPtr; {\cf20 // Name for use in structs}\par
606 \par
607 {\cf20 // Helper: ImBitArray class (wrapper over ImBitArray functions)}\par
608 {\cf20 // Store 1-bit per value.}\par
609 {\cf17 template}<{\cf18 int} BITCOUNT, {\cf18 int} OFFSET = 0>\par
610 {\cf17 struct }ImBitArray\par
611 \{\par
612     ImU32           Storage[(BITCOUNT + 31) >> 5];\par
613     ImBitArray()                                \{ ClearAllBits(); \}\par
614     {\cf18 void}            ClearAllBits()              \{ memset(Storage, 0, {\cf17 sizeof}(Storage)); \}\par
615     {\cf18 void}            SetAllBits()                \{ memset(Storage, 255, {\cf17 sizeof}(Storage)); \}\par
616     {\cf18 bool}            TestBit({\cf18 int} n){\cf17  const        }\{ n += OFFSET; IM_ASSERT(n >= 0 && n < BITCOUNT); {\cf19 return} IM_BITARRAY_TESTBIT(Storage, n); \}\par
617     {\cf18 void}            SetBit({\cf18 int} n)               \{ n += OFFSET; IM_ASSERT(n >= 0 && n < BITCOUNT); ImBitArraySetBit(Storage, n); \}\par
618     {\cf18 void}            ClearBit({\cf18 int} n)             \{ n += OFFSET; IM_ASSERT(n >= 0 && n < BITCOUNT); ImBitArrayClearBit(Storage, n); \}\par
619     {\cf18 void}            SetBitRange({\cf18 int} n, {\cf18 int} n2)  \{ n += OFFSET; n2 += OFFSET; IM_ASSERT(n >= 0 && n < BITCOUNT && n2 > n && n2 <= BITCOUNT); ImBitArraySetBitRange(Storage, n, n2); \} {\cf20 // Works on range [n..n2)}\par
620     {\cf18 bool}            operator[]({\cf18 int} n){\cf17  const     }\{ n += OFFSET; IM_ASSERT(n >= 0 && n < BITCOUNT); {\cf19 return} IM_BITARRAY_TESTBIT(Storage, n); \}\par
