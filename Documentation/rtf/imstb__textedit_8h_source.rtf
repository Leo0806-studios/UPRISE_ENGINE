1351 {\cf17 static} {\cf18 void} stb_text_makeundo_replace(IMSTB_TEXTEDIT_STRING *str, STB_TexteditState *state, {\cf18 int} where, {\cf18 int} old_length, {\cf18 int} new_length)\par
