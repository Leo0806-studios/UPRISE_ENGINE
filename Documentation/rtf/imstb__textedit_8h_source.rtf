397 {\cf20 //}\par
398 {\cf20 //      Mouse input handling}\par
399 {\cf20 //}\par
400 \par
401 {\cf20 // traverse the layout to locate the nearest character to a display position}\par
402 {\cf17 static} {\cf18 int} stb_text_locate_coord(IMSTB_TEXTEDIT_STRING *str, {\cf18 float} x, {\cf18 float} y)\par
403 \{\par
404    StbTexteditRow r;\par
405    {\cf18 int} n = STB_TEXTEDIT_STRINGLEN(str);\par
406    {\cf18 float} base_y = 0, prev_x;\par
407    {\cf18 int} i=0, k;\par
408 \par
409    r.x0 = r.x1 = 0;\par
410    r.ymin = r.ymax = 0;\par
411    r.num_chars = 0;\par
412 \par
413    {\cf20 // search rows to find one that straddles 'y'}\par
414    {\cf19 while} (i < n) \{\par
415       STB_TEXTEDIT_LAYOUTROW(&r, str, i);\par
416       {\cf19 if} (r.num_chars <= 0)\par
417          {\cf19 return} n;\par
418 \par
419       {\cf19 if} (i==0 && y < base_y + r.ymin)\par
420          {\cf19 return} 0;\par
421 \par
422       {\cf19 if} (y < base_y + r.ymax)\par
423          {\cf19 break};\par
424 \par
425       i += r.num_chars;\par
426       base_y += r.baseline_y_delta;\par
427    \}\par
428 \par
429    {\cf20 // below all text, return 'after' last character}\par
430    {\cf19 if} (i >= n)\par
431       {\cf19 return} n;\par
432 \par
433    {\cf20 // check if it's before the beginning of the line}\par
434    {\cf19 if} (x < r.x0)\par
435       {\cf19 return} i;\par
436 \par
437    {\cf20 // check if it's before the end of the line}\par
438    {\cf19 if} (x < r.x1) \{\par
439       {\cf20 // search characters in row for one that straddles 'x'}\par
440       prev_x = r.x0;\par
441       {\cf19 for} (k=0; k < r.num_chars; ++k) \{\par
442          {\cf18 float} w = STB_TEXTEDIT_GETWIDTH(str, i, k);\par
443          {\cf19 if} (x < prev_x+w) \{\par
444             {\cf19 if} (x < prev_x+w/2)\par
445                {\cf19 return} k+i;\par
446             {\cf19 else}\par
447                {\cf19 return} k+i+1;\par
448          \}\par
449          prev_x += w;\par
450       \}\par
451       {\cf20 // shouldn't happen, but if it does, fall through to end-of-line case}\par
452    \}\par
453 \par
454    {\cf20 // if the last character is a newline, return that. otherwise return 'after' the last character}\par
455    {\cf19 if} (STB_TEXTEDIT_GETCHAR(str, i+r.num_chars-1) == STB_TEXTEDIT_NEWLINE)\par
456       {\cf19 return} i+r.num_chars-1;\par
457    {\cf19 else}\par
458       {\cf19 return} i+r.num_chars;\par
459 \}\par
460 \par
461 {\cf20 // API click: on mouse down, move the cursor to the clicked location, and reset the selection}\par
462 {\cf17 static} {\cf18 void} stb_textedit_click(IMSTB_TEXTEDIT_STRING *str, STB_TexteditState *state, {\cf18 float} x, {\cf18 float} y)\par
463 \{\par
464    {\cf20 // In single-line mode, just always make y = 0. This lets the drag keep working if the mouse}\par
465    {\cf20 // goes off the top or bottom of the text}\par
466    {\cf19 if}( state->single_line )\par
467    \{\par
468       StbTexteditRow r;\par
469       STB_TEXTEDIT_LAYOUTROW(&r, str, 0);\par
470       y = r.ymin;\par
471    \}\par
472 \par
473    state->cursor = stb_text_locate_coord(str, x, y);\par
474    state->select_start = state->cursor;\par
475    state->select_end = state->cursor;\par
476    state->has_preferred_x = 0;\par
477 \}\par
478 \par
479 {\cf20 // API drag: on mouse drag, move the cursor and selection endpoint to the clicked location}\par
480 {\cf17 static} {\cf18 void} stb_textedit_drag(IMSTB_TEXTEDIT_STRING *str, STB_TexteditState *state, {\cf18 float} x, {\cf18 float} y)\par
481 \{\par
482    {\cf18 int} p = 0;\par
483 \par
484    {\cf20 // In single-line mode, just always make y = 0. This lets the drag keep working if the mouse}\par
485    {\cf20 // goes off the top or bottom of the text}\par
486    {\cf19 if}( state->single_line )\par
487    \{\par
488       StbTexteditRow r;\par
489       STB_TEXTEDIT_LAYOUTROW(&r, str, 0);\par
490       y = r.ymin;\par
491    \}\par
492 \par
493    {\cf19 if} (state->select_start == state->select_end)\par
494       state->select_start = state->cursor;\par
495 \par
496    p = stb_text_locate_coord(str, x, y);\par
497    state->cursor = state->select_end = p;\par
498 \}\par
