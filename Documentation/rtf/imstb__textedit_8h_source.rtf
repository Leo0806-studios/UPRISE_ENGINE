1109 {\cf20 //}\par
1110 {\cf20 //      Undo processing}\par
1111 {\cf20 //}\par
1112 {\cf20 // @OPTIMIZE: the undo/redo buffer should be circular}\par
1113 \par
1114 {\cf17 static} {\cf18 void} stb_textedit_flush_redo(StbUndoState *state)\par
1115 \{\par
1116    state->redo_point = IMSTB_TEXTEDIT_UNDOSTATECOUNT;\par
1117    state->redo_char_point = IMSTB_TEXTEDIT_UNDOCHARCOUNT;\par
1118 \}\par
1119 \par
1120 {\cf20 // discard the oldest entry in the undo list}\par
1121 {\cf17 static} {\cf18 void} stb_textedit_discard_undo(StbUndoState *state)\par
1122 \{\par
1123    {\cf19 if} (state->undo_point > 0) \{\par
1124       {\cf20 // if the 0th undo state has characters, clean those up}\par
1125       {\cf19 if} (state->undo_rec[0].char_storage >= 0) \{\par
1126          {\cf18 int} n = state->undo_rec[0].insert_length, i;\par
1127          {\cf20 // delete n characters from all other records}\par
1128          state->undo_char_point -= n;\par
1129          IMSTB_TEXTEDIT_memmove(state->undo_char, state->undo_char + n, ({\cf18 size_t}) (state->undo_char_point*{\cf17 sizeof}(IMSTB_TEXTEDIT_CHARTYPE)));\par
1130          {\cf19 for} (i=0; i < state->undo_point; ++i)\par
1131             {\cf19 if} (state->undo_rec[i].char_storage >= 0)\par
1132                state->undo_rec[i].char_storage -= n; {\cf20 // @OPTIMIZE: get rid of char_storage and infer it}\par
1133       \}\par
1134       --state->undo_point;\par
1135       IMSTB_TEXTEDIT_memmove(state->undo_rec, state->undo_rec+1, ({\cf18 size_t}) (state->undo_point*{\cf17 sizeof}(state->undo_rec[0])));\par
1136    \}\par
1137 \}\par
1138 \par
1139 {\cf20 // discard the oldest entry in the redo list--it's bad if this}\par
1140 {\cf20 // ever happens, but because undo & redo have to store the actual}\par
1141 {\cf20 // characters in different cases, the redo character buffer can}\par
1142 {\cf20 // fill up even though the undo buffer didn't}\par
1143 {\cf17 static} {\cf18 void} stb_textedit_discard_redo(StbUndoState *state)\par
1144 \{\par
1145    {\cf18 int} k = IMSTB_TEXTEDIT_UNDOSTATECOUNT-1;\par
1146 \par
1147    {\cf19 if} (state->redo_point <= k) \{\par
1148       {\cf20 // if the k'th undo state has characters, clean those up}\par
1149       {\cf19 if} (state->undo_rec[k].char_storage >= 0) \{\par
1150          {\cf18 int} n = state->undo_rec[k].insert_length, i;\par
1151          {\cf20 // move the remaining redo character data to the end of the buffer}\par
1152          state->redo_char_point += n;\par
1153          IMSTB_TEXTEDIT_memmove(state->undo_char + state->redo_char_point, state->undo_char + state->redo_char_point-n, ({\cf18 size_t}) ((IMSTB_TEXTEDIT_UNDOCHARCOUNT - state->redo_char_point)*{\cf17 sizeof}(IMSTB_TEXTEDIT_CHARTYPE)));\par
1154          {\cf20 // adjust the position of all the other records to account for above memmove}\par
1155          {\cf19 for} (i=state->redo_point; i < k; ++i)\par
1156             {\cf19 if} (state->undo_rec[i].char_storage >= 0)\par
1157                state->undo_rec[i].char_storage += n;\par
1158       \}\par
1159       {\cf20 // now move all the redo records towards the end of the buffer; the first one is at 'redo_point'}\par
1160       {\cf20 // [DEAR IMGUI]}\par
1161       {\cf18 size_t} move_size = (size_t)((IMSTB_TEXTEDIT_UNDOSTATECOUNT - state->redo_point - 1) * {\cf17 sizeof}(state->undo_rec[0]));\par
1162       {\cf17 const} {\cf18 char}* buf_begin = ({\cf18 char}*)state->undo_rec; (void)buf_begin;\par
1163       {\cf17 const} {\cf18 char}* buf_end   = ({\cf18 char}*)state->undo_rec + {\cf17 sizeof}(state->undo_rec); (void)buf_end;\par
1164       IM_ASSERT((({\cf18 char}*)(state->undo_rec + state->redo_point)) >= buf_begin);\par
1165       IM_ASSERT((({\cf18 char}*)(state->undo_rec + state->redo_point + 1) + move_size) <= buf_end);\par
1166       IMSTB_TEXTEDIT_memmove(state->undo_rec + state->redo_point+1, state->undo_rec + state->redo_point, move_size);\par
1167 \par
1168       {\cf20 // now move redo_point to point to the new one}\par
1169       ++state->redo_point;\par
1170    \}\par
1171 \}\par
1172 \par
1173 {\cf17 static} StbUndoRecord *stb_text_create_undo_record(StbUndoState *state, {\cf18 int} numchars)\par
1174 \{\par
1175    {\cf20 // any time we create a new undo record, we discard redo}\par
1176    stb_textedit_flush_redo(state);\par
1177 \par
1178    {\cf20 // if we have no free records, we have to make room, by sliding the}\par
1179    {\cf20 // existing records down}\par
1180    {\cf19 if} (state->undo_point == IMSTB_TEXTEDIT_UNDOSTATECOUNT)\par
1181       stb_textedit_discard_undo(state);\par
1182 \par
1183    {\cf20 // if the characters to store won't possibly fit in the buffer, we can't undo}\par
1184    {\cf19 if} (numchars > IMSTB_TEXTEDIT_UNDOCHARCOUNT) \{\par
1185       state->undo_point = 0;\par
1186       state->undo_char_point = 0;\par
1187       {\cf19 return} NULL;\par
1188    \}\par
1189 \par
1190    {\cf20 // if we don't have enough free characters in the buffer, we have to make room}\par
1191    {\cf19 while} (state->undo_char_point + numchars > IMSTB_TEXTEDIT_UNDOCHARCOUNT)\par
1192       stb_textedit_discard_undo(state);\par
1193 \par
1194    {\cf19 return} &state->undo_rec[state->undo_point++];\par
1195 \}\par
1196 \par
1197 {\cf17 static} IMSTB_TEXTEDIT_CHARTYPE *stb_text_createundo(StbUndoState *state, {\cf18 int} pos, {\cf18 int} insert_len, {\cf18 int} delete_len)\par
1198 \{\par
1199    StbUndoRecord *r = stb_text_create_undo_record(state, insert_len);\par
1200    {\cf19 if} (r == NULL)\par
1201       {\cf19 return} NULL;\par
1202 \par
1203    r->where = pos;\par
1204    r->insert_length = (IMSTB_TEXTEDIT_POSITIONTYPE) insert_len;\par
1205    r->delete_length = (IMSTB_TEXTEDIT_POSITIONTYPE) delete_len;\par
1206 \par
1207    {\cf19 if} (insert_len == 0) \{\par
1208       r->char_storage = -1;\par
1209       {\cf19 return} NULL;\par
1210    \} {\cf19 else} \{\par
1211       r->char_storage = state->undo_char_point;\par
1212       state->undo_char_point += insert_len;\par
1213       {\cf19 return} &state->undo_char[r->char_storage];\par
1214    \}\par
1215 \}\par
1216 \par
1217 {\cf17 static} {\cf18 void} stb_text_undo(IMSTB_TEXTEDIT_STRING *str, STB_TexteditState *state)\par
1218 \{\par
1219    StbUndoState *s = &state->undostate;\par
1220    StbUndoRecord u, *r;\par
1221    {\cf19 if} (s->undo_point == 0)\par
1222       {\cf19 return};\par
1223 \par
1224    {\cf20 // we need to do two things: apply the undo record, and create a redo record}\par
1225    u = s->undo_rec[s->undo_point-1];\par
1226    r = &s->undo_rec[s->redo_point-1];\par
1227    r->char_storage = -1;\par
1228 \par
1229    r->insert_length = u.delete_length;\par
1230    r->delete_length = u.insert_length;\par
1231    r->where = u.where;\par
1232 \par
1233    {\cf19 if} (u.delete_length) \{\par
1234       {\cf20 // if the undo record says to delete characters, then the redo record will}\par
1235       {\cf20 // need to re-insert the characters that get deleted, so we need to store}\par
1236       {\cf20 // them.}\par
1237 \par
1238       {\cf20 // there are three cases:}\par
1239       {\cf20 //    there's enough room to store the characters}\par
1240       {\cf20 //    characters stored for *redoing* don't leave room for redo}\par
1241       {\cf20 //    characters stored for *undoing* don't leave room for redo}\par
1242       {\cf20 // if the last is true, we have to bail}\par
1243 \par
1244       {\cf19 if} (s->undo_char_point + u.delete_length >= IMSTB_TEXTEDIT_UNDOCHARCOUNT) \{\par
1245          {\cf20 // the undo records take up too much character space; there's no space to store the redo characters}\par
1246          r->insert_length = 0;\par
1247       \} {\cf19 else} \{\par
1248          {\cf18 int} i;\par
1249 \par
1250          {\cf20 // there's definitely room to store the characters eventually}\par
1251          {\cf19 while} (s->undo_char_point + u.delete_length > s->redo_char_point) \{\par
1252             {\cf20 // should never happen:}\par
1253             {\cf19 if} (s->redo_point == IMSTB_TEXTEDIT_UNDOSTATECOUNT)\par
1254                {\cf19 return};\par
1255             {\cf20 // there's currently not enough room, so discard a redo record}\par
1256             stb_textedit_discard_redo(s);\par
1257          \}\par
1258          r = &s->undo_rec[s->redo_point-1];\par
1259 \par
1260          r->char_storage = s->redo_char_point - u.delete_length;\par
1261          s->redo_char_point = s->redo_char_point - u.delete_length;\par
1262 \par
1263          {\cf20 // now save the characters}\par
1264          {\cf19 for} (i=0; i < u.delete_length; ++i)\par
1265             s->undo_char[r->char_storage + i] = STB_TEXTEDIT_GETCHAR(str, u.where + i);\par
1266       \}\par
1267 \par
1268       {\cf20 // now we can carry out the deletion}\par
1269       STB_TEXTEDIT_DELETECHARS(str, u.where, u.delete_length);\par
1270    \}\par
1271 \par
1272    {\cf20 // check type of recorded action:}\par
1273    {\cf19 if} (u.insert_length) \{\par
1274       {\cf20 // easy case: was a deletion, so we need to insert n characters}\par
1275       STB_TEXTEDIT_INSERTCHARS(str, u.where, &s->undo_char[u.char_storage], u.insert_length);\par
1276       s->undo_char_point -= u.insert_length;\par
1277    \}\par
1278 \par
1279    state->cursor = u.where + u.insert_length;\par
1280 \par
1281    s->undo_point--;\par
1282    s->redo_point--;\par
1283 \}\par
1284 \par
1285 {\cf17 static} {\cf18 void} stb_text_redo(IMSTB_TEXTEDIT_STRING *str, STB_TexteditState *state)\par
1286 \{\par
1287    StbUndoState *s = &state->undostate;\par
1288    StbUndoRecord *u, r;\par
1289    {\cf19 if} (s->redo_point == IMSTB_TEXTEDIT_UNDOSTATECOUNT)\par
1290       {\cf19 return};\par
1291 \par
1292    {\cf20 // we need to do two things: apply the redo record, and create an undo record}\par
1293    u = &s->undo_rec[s->undo_point];\par
1294    r = s->undo_rec[s->redo_point];\par
1295 \par
1296    {\cf20 // we KNOW there must be room for the undo record, because the redo record}\par
1297    {\cf20 // was derived from an undo record}\par
1298 \par
1299    u->delete_length = r.insert_length;\par
1300    u->insert_length = r.delete_length;\par
1301    u->where = r.where;\par
1302    u->char_storage = -1;\par
1303 \par
1304    {\cf19 if} (r.delete_length) \{\par
1305       {\cf20 // the redo record requires us to delete characters, so the undo record}\par
1306       {\cf20 // needs to store the characters}\par
1307 \par
1308       {\cf19 if} (s->undo_char_point + u->insert_length > s->redo_char_point) \{\par
1309          u->insert_length = 0;\par
1310          u->delete_length = 0;\par
1311       \} {\cf19 else} \{\par
1312          {\cf18 int} i;\par
1313          u->char_storage = s->undo_char_point;\par
1314          s->undo_char_point = s->undo_char_point + u->insert_length;\par
1315 \par
1316          {\cf20 // now save the characters}\par
1317          {\cf19 for} (i=0; i < u->insert_length; ++i)\par
1318             s->undo_char[u->char_storage + i] = STB_TEXTEDIT_GETCHAR(str, u->where + i);\par
1319       \}\par
1320 \par
1321       STB_TEXTEDIT_DELETECHARS(str, r.where, r.delete_length);\par
1322    \}\par
1323 \par
1324    {\cf19 if} (r.insert_length) \{\par
1325       {\cf20 // easy case: need to insert n characters}\par
1326       STB_TEXTEDIT_INSERTCHARS(str, r.where, &s->undo_char[r.char_storage], r.insert_length);\par
1327       s->redo_char_point += r.insert_length;\par
1328    \}\par
1329 \par
1330    state->cursor = r.where + r.insert_length;\par
1331 \par
1332    s->undo_point++;\par
1333    s->redo_point++;\par
1334 \}\par
1335 \par
1336 {\cf17 static} {\cf18 void} stb_text_makeundo_insert(STB_TexteditState *state, {\cf18 int} where, {\cf18 int} length)\par
1337 \{\par
1338    stb_text_createundo(&state->undostate, where, 0, length);\par
1339 \}\par
