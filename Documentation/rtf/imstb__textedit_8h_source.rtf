505 {\cf20 // forward declarations}\par
506 {\cf17 static} {\cf18 void} stb_text_undo(IMSTB_TEXTEDIT_STRING *str, STB_TexteditState *state);\par
507 {\cf17 static} {\cf18 void} stb_text_redo(IMSTB_TEXTEDIT_STRING *str, STB_TexteditState *state);\par
508 {\cf17 static} {\cf18 void} stb_text_makeundo_delete(IMSTB_TEXTEDIT_STRING *str, STB_TexteditState *state, {\cf18 int} where, {\cf18 int} length);\par
509 {\cf17 static} {\cf18 void} stb_text_makeundo_insert(STB_TexteditState *state, {\cf18 int} where, {\cf18 int} length);\par
510 {\cf17 static} {\cf18 void} stb_text_makeundo_replace(IMSTB_TEXTEDIT_STRING *str, STB_TexteditState *state, {\cf18 int} where, {\cf18 int} old_length, {\cf18 int} new_length);\par
511 \par
512 {\cf17 typedef} {\cf17 struct}\par
513 \{\par
514    {\cf18 float} x,y;    {\cf20 // position of n'th character}\par
515    {\cf18 float} height; {\cf20 // height of line}\par
516    {\cf18 int} first_char, length; {\cf20 // first char of row, and length}\par
517    {\cf18 int} prev_first;  {\cf20 // first char of previous row}\par
518 \} StbFindState;\par
519 \par
520 {\cf20 // find the x/y location of a character, and remember info about the previous row in}\par
521 {\cf20 // case we get a move-up event (for page up, we'll have to rescan)}\par
522 {\cf17 static} {\cf18 void} stb_textedit_find_charpos(StbFindState *find, IMSTB_TEXTEDIT_STRING *str, {\cf18 int} n, {\cf18 int} single_line)\par
523 \{\par
524    StbTexteditRow r;\par
525    {\cf18 int} prev_start = 0;\par
526    {\cf18 int} z = STB_TEXTEDIT_STRINGLEN(str);\par
527    {\cf18 int} i=0, first;\par
528 \par
529    {\cf19 if} (n == z && single_line) \{\par
530       {\cf20 // special case if it's at the end (may not be needed?)}\par
531       STB_TEXTEDIT_LAYOUTROW(&r, str, 0);\par
532       find->y = 0;\par
533       find->first_char = 0;\par
534       find->length = z;\par
535       find->height = r.ymax - r.ymin;\par
536       find->x = r.x1;\par
537       {\cf19 return};\par
538    \}\par
539 \par
540    {\cf20 // search rows to find the one that straddles character n}\par
541    find->y = 0;\par
542 \par
543    {\cf19 for}(;;) \{\par
544       STB_TEXTEDIT_LAYOUTROW(&r, str, i);\par
545       {\cf19 if} (n < i + r.num_chars)\par
546          {\cf19 break};\par
547       {\cf19 if} (i + r.num_chars == z && z > 0 && STB_TEXTEDIT_GETCHAR(str, z - 1) != STB_TEXTEDIT_NEWLINE)  {\cf20 // [DEAR IMGUI] special handling for last line}\par
548          {\cf19 break};   {\cf20 // [DEAR IMGUI]}\par
549       prev_start = i;\par
550       i += r.num_chars;\par
551       find->y += r.baseline_y_delta;\par
552       {\cf19 if} (i == z) {\cf20 // [DEAR IMGUI]}\par
553       \{\par
554          r.num_chars = 0; {\cf20 // [DEAR IMGUI]}\par
555          {\cf19 break};   {\cf20 // [DEAR IMGUI]}\par
556       \}\par
557    \}\par
558 \par
559    find->first_char = first = i;\par
560    find->length = r.num_chars;\par
561    find->height = r.ymax - r.ymin;\par
562    find->prev_first = prev_start;\par
563 \par
564    {\cf20 // now scan to find xpos}\par
565    find->x = r.x0;\par
566    {\cf19 for} (i=0; first+i < n; ++i)\par
567       find->x += STB_TEXTEDIT_GETWIDTH(str, first, i);\par
568 \}\par
569 \par
570 {\cf21 #define STB_TEXT_HAS_SELECTION(s)   ((s)->select_start != (s)->select_end)}\par
571 \par
572 {\cf20 // make the selection/cursor state valid if client altered the string}\par
573 {\cf17 static} {\cf18 void} stb_textedit_clamp(IMSTB_TEXTEDIT_STRING *str, STB_TexteditState *state)\par
574 \{\par
575    {\cf18 int} n = STB_TEXTEDIT_STRINGLEN(str);\par
576    {\cf19 if} (STB_TEXT_HAS_SELECTION(state)) \{\par
577       {\cf19 if} (state->select_start > n) state->select_start = n;\par
578       {\cf19 if} (state->select_end   > n) state->select_end = n;\par
579       {\cf20 // if clamping forced them to be equal, move the cursor to match}\par
580       {\cf19 if} (state->select_start == state->select_end)\par
581          state->cursor = state->select_start;\par
582    \}\par
583    {\cf19 if} (state->cursor > n) state->cursor = n;\par
584 \}\par
585 \par
586 {\cf20 // delete characters while updating undo}\par
587 {\cf17 static} {\cf18 void} stb_textedit_delete(IMSTB_TEXTEDIT_STRING *str, STB_TexteditState *state, {\cf18 int} where, {\cf18 int} len)\par
588 \{\par
589    stb_text_makeundo_delete(str, state, where, len);\par
590    STB_TEXTEDIT_DELETECHARS(str, where, len);\par
591    state->has_preferred_x = 0;\par
592 \}\par
593 \par
594 {\cf20 // delete the section}\par
595 {\cf17 static} {\cf18 void} stb_textedit_delete_selection(IMSTB_TEXTEDIT_STRING *str, STB_TexteditState *state)\par
596 \{\par
597    stb_textedit_clamp(str, state);\par
598    {\cf19 if} (STB_TEXT_HAS_SELECTION(state)) \{\par
599       {\cf19 if} (state->select_start < state->select_end) \{\par
600          stb_textedit_delete(str, state, state->select_start, state->select_end - state->select_start);\par
601          state->select_end = state->cursor = state->select_start;\par
602       \} {\cf19 else} \{\par
603          stb_textedit_delete(str, state, state->select_end, state->select_start - state->select_end);\par
604          state->select_start = state->cursor = state->select_end;\par
605       \}\par
606       state->has_preferred_x = 0;\par
607    \}\par
608 \}\par
609 \par
610 {\cf20 // canoncialize the selection so start <= end}\par
611 {\cf17 static} {\cf18 void} stb_textedit_sortselection(STB_TexteditState *state)\par
612 \{\par
613    {\cf19 if} (state->select_end < state->select_start) \{\par
614       {\cf18 int} temp = state->select_end;\par
615       state->select_end = state->select_start;\par
616       state->select_start = temp;\par
617    \}\par
618 \}\par
619 \par
620 {\cf20 // move cursor to first character of selection}\par
621 {\cf17 static} {\cf18 void} stb_textedit_move_to_first(STB_TexteditState *state)\par
622 \{\par
623    {\cf19 if} (STB_TEXT_HAS_SELECTION(state)) \{\par
624       stb_textedit_sortselection(state);\par
625       state->cursor = state->select_start;\par
626       state->select_end = state->select_start;\par
627       state->has_preferred_x = 0;\par
628    \}\par
629 \}\par
630 \par
631 {\cf20 // move cursor to last character of selection}\par
632 {\cf17 static} {\cf18 void} stb_textedit_move_to_last(IMSTB_TEXTEDIT_STRING *str, STB_TexteditState *state)\par
633 \{\par
634    {\cf19 if} (STB_TEXT_HAS_SELECTION(state)) \{\par
635       stb_textedit_sortselection(state);\par
636       stb_textedit_clamp(str, state);\par
637       state->cursor = state->select_end;\par
638       state->select_start = state->select_end;\par
639       state->has_preferred_x = 0;\par
640    \}\par
641 \}\par
642 \par
643 {\cf21 #ifdef STB_TEXTEDIT_IS_SPACE}\par
644 {\cf17 static} {\cf18 int} is_word_boundary( IMSTB_TEXTEDIT_STRING *str, {\cf18 int} idx )\par
645 \{\par
646    {\cf19 return} idx > 0 ? (STB_TEXTEDIT_IS_SPACE( STB_TEXTEDIT_GETCHAR(str,idx-1) ) && !STB_TEXTEDIT_IS_SPACE( STB_TEXTEDIT_GETCHAR(str, idx) ) ) : 1;\par
647 \}\par
648 \par
649 {\cf21 #ifndef STB_TEXTEDIT_MOVEWORDLEFT}\par
650 {\cf17 static} {\cf18 int} stb_textedit_move_to_word_previous( IMSTB_TEXTEDIT_STRING *str, {\cf18 int} c )\par
651 \{\par
652    --c; {\cf20 // always move at least one character}\par
653    {\cf19 while}( c >= 0 && !is_word_boundary( str, c ) )\par
654       --c;\par
655 \par
656    {\cf19 if}( c < 0 )\par
657       c = 0;\par
658 \par
659    {\cf19 return} c;\par
660 \}\par
661 {\cf21 #define STB_TEXTEDIT_MOVEWORDLEFT stb_textedit_move_to_word_previous}\par
662 {\cf21 #endif}\par
663 \par
664 {\cf21 #ifndef STB_TEXTEDIT_MOVEWORDRIGHT}\par
665 {\cf17 static} {\cf18 int} stb_textedit_move_to_word_next( IMSTB_TEXTEDIT_STRING *str, {\cf18 int} c )\par
666 \{\par
667    {\cf17 const} {\cf18 int} len = STB_TEXTEDIT_STRINGLEN(str);\par
668    ++c; {\cf20 // always move at least one character}\par
669    {\cf19 while}( c < len && !is_word_boundary( str, c ) )\par
670       ++c;\par
671 \par
672    {\cf19 if}( c > len )\par
673       c = len;\par
674 \par
675    {\cf19 return} c;\par
676 \}\par
677 {\cf21 #define STB_TEXTEDIT_MOVEWORDRIGHT stb_textedit_move_to_word_next}\par
678 {\cf21 #endif}\par
679 \par
680 {\cf21 #endif}\par
681 \par
682 {\cf20 // update selection and cursor to match each other}\par
683 {\cf17 static} {\cf18 void} stb_textedit_prep_selection_at_cursor(STB_TexteditState *state)\par
684 \{\par
685    {\cf19 if} (!STB_TEXT_HAS_SELECTION(state))\par
686       state->select_start = state->select_end = state->cursor;\par
687    {\cf19 else}\par
688       state->cursor = state->select_end;\par
689 \}\par
690 \par
691 {\cf20 // API cut: delete selection}\par
692 {\cf17 static} {\cf18 int} stb_textedit_cut(IMSTB_TEXTEDIT_STRING *str, STB_TexteditState *state)\par
693 \{\par
694    {\cf19 if} (STB_TEXT_HAS_SELECTION(state)) \{\par
695       stb_textedit_delete_selection(str,state); {\cf20 // implicitly clamps}\par
696       state->has_preferred_x = 0;\par
697       {\cf19 return} 1;\par
698    \}\par
699    {\cf19 return} 0;\par
700 \}\par
701 \par
702 {\cf20 // API paste: replace existing selection with passed-in text}\par
703 {\cf17 static} {\cf18 int} stb_textedit_paste_internal(IMSTB_TEXTEDIT_STRING *str, STB_TexteditState *state, IMSTB_TEXTEDIT_CHARTYPE *text, {\cf18 int} len)\par
704 \{\par
705    {\cf20 // if there's a selection, the paste should delete it}\par
706    stb_textedit_clamp(str, state);\par
707    stb_textedit_delete_selection(str,state);\par
708    {\cf20 // try to insert the characters}\par
709    {\cf19 if} (STB_TEXTEDIT_INSERTCHARS(str, state->cursor, text, len)) \{\par
710       stb_text_makeundo_insert(state, state->cursor, len);\par
711       state->cursor += len;\par
712       state->has_preferred_x = 0;\par
713       {\cf19 return} 1;\par
714    \}\par
715    {\cf20 // note: paste failure will leave deleted selection, may be restored with an undo (see https://github.com/nothings/stb/issues/734 for details)}\par
716    {\cf19 return} 0;\par
717 \}\par
718 \par
719 {\cf21 #ifndef STB_TEXTEDIT_KEYTYPE}\par
720 {\cf21 #define STB_TEXTEDIT_KEYTYPE int}\par
721 {\cf21 #endif}\par
722 \par
723 {\cf20 // API key: process a keyboard input}\par
724 {\cf17 static} {\cf18 void} stb_textedit_key(IMSTB_TEXTEDIT_STRING *str, STB_TexteditState *state, STB_TEXTEDIT_KEYTYPE key)\par
725 \{\par
726 retry:\par
727    {\cf19 switch} (key) \{\par
728       {\cf19 default}: \{\par
729          {\cf18 int} c = STB_TEXTEDIT_KEYTOTEXT(key);\par
730          {\cf19 if} (c > 0) \{\par
731             IMSTB_TEXTEDIT_CHARTYPE ch = (IMSTB_TEXTEDIT_CHARTYPE) c;\par
732 \par
733             {\cf20 // can't add newline in single-line mode}\par
734             {\cf19 if} (c == {\cf23 '\\n'} && state->single_line)\par
735                {\cf19 break};\par
736 \par
737             {\cf19 if} (state->insert_mode && !STB_TEXT_HAS_SELECTION(state) && state->cursor < STB_TEXTEDIT_STRINGLEN(str)) \{\par
738                stb_text_makeundo_replace(str, state, state->cursor, 1, 1);\par
739                STB_TEXTEDIT_DELETECHARS(str, state->cursor, 1);\par
740                {\cf19 if} (STB_TEXTEDIT_INSERTCHARS(str, state->cursor, &ch, 1)) \{\par
741                   ++state->cursor;\par
742                   state->has_preferred_x = 0;\par
743                \}\par
744             \} {\cf19 else} \{\par
745                stb_textedit_delete_selection(str,state); {\cf20 // implicitly clamps}\par
746                {\cf19 if} (STB_TEXTEDIT_INSERTCHARS(str, state->cursor, &ch, 1)) \{\par
747                   stb_text_makeundo_insert(state, state->cursor, 1);\par
748                   ++state->cursor;\par
749                   state->has_preferred_x = 0;\par
750                \}\par
751             \}\par
752          \}\par
753          {\cf19 break};\par
754       \}\par
755 \par
756 {\cf21 #ifdef STB_TEXTEDIT_K_INSERT}\par
757       {\cf19 case} STB_TEXTEDIT_K_INSERT:\par
758          state->insert_mode = !state->insert_mode;\par
759          {\cf19 break};\par
760 {\cf21 #endif}\par
761 \par
762       {\cf19 case} STB_TEXTEDIT_K_UNDO:\par
763          stb_text_undo(str, state);\par
764          state->has_preferred_x = 0;\par
765          {\cf19 break};\par
766 \par
767       {\cf19 case} STB_TEXTEDIT_K_REDO:\par
768          stb_text_redo(str, state);\par
769          state->has_preferred_x = 0;\par
770          {\cf19 break};\par
771 \par
772       {\cf19 case} STB_TEXTEDIT_K_LEFT:\par
773          {\cf20 // if currently there's a selection, move cursor to start of selection}\par
774          {\cf19 if} (STB_TEXT_HAS_SELECTION(state))\par
775             stb_textedit_move_to_first(state);\par
776          {\cf19 else}\par
777             {\cf19 if} (state->cursor > 0)\par
778                --state->cursor;\par
779          state->has_preferred_x = 0;\par
780          {\cf19 break};\par
781 \par
782       {\cf19 case} STB_TEXTEDIT_K_RIGHT:\par
783          {\cf20 // if currently there's a selection, move cursor to end of selection}\par
784          {\cf19 if} (STB_TEXT_HAS_SELECTION(state))\par
785             stb_textedit_move_to_last(str, state);\par
786          {\cf19 else}\par
787             ++state->cursor;\par
788          stb_textedit_clamp(str, state);\par
789          state->has_preferred_x = 0;\par
790          {\cf19 break};\par
791 \par
792       {\cf19 case} STB_TEXTEDIT_K_LEFT | STB_TEXTEDIT_K_SHIFT:\par
793          stb_textedit_clamp(str, state);\par
794          stb_textedit_prep_selection_at_cursor(state);\par
795          {\cf20 // move selection left}\par
796          {\cf19 if} (state->select_end > 0)\par
797             --state->select_end;\par
798          state->cursor = state->select_end;\par
799          state->has_preferred_x = 0;\par
800          {\cf19 break};\par
801 \par
802 {\cf21 #ifdef STB_TEXTEDIT_MOVEWORDLEFT}\par
803       {\cf19 case} STB_TEXTEDIT_K_WORDLEFT:\par
804          {\cf19 if} (STB_TEXT_HAS_SELECTION(state))\par
805             stb_textedit_move_to_first(state);\par
806          {\cf19 else} \{\par
807             state->cursor = STB_TEXTEDIT_MOVEWORDLEFT(str, state->cursor);\par
808             stb_textedit_clamp( str, state );\par
809          \}\par
810          {\cf19 break};\par
811 \par
812       {\cf19 case} STB_TEXTEDIT_K_WORDLEFT | STB_TEXTEDIT_K_SHIFT:\par
813          {\cf19 if}( !STB_TEXT_HAS_SELECTION( state ) )\par
814             stb_textedit_prep_selection_at_cursor(state);\par
815 \par
816          state->cursor = STB_TEXTEDIT_MOVEWORDLEFT(str, state->cursor);\par
817          state->select_end = state->cursor;\par
818 \par
819          stb_textedit_clamp( str, state );\par
820          {\cf19 break};\par
821 {\cf21 #endif}\par
822 \par
823 {\cf21 #ifdef STB_TEXTEDIT_MOVEWORDRIGHT}\par
824       {\cf19 case} STB_TEXTEDIT_K_WORDRIGHT:\par
825          {\cf19 if} (STB_TEXT_HAS_SELECTION(state))\par
826             stb_textedit_move_to_last(str, state);\par
827          {\cf19 else} \{\par
828             state->cursor = STB_TEXTEDIT_MOVEWORDRIGHT(str, state->cursor);\par
829             stb_textedit_clamp( str, state );\par
830          \}\par
831          {\cf19 break};\par
832 \par
833       {\cf19 case} STB_TEXTEDIT_K_WORDRIGHT | STB_TEXTEDIT_K_SHIFT:\par
834          {\cf19 if}( !STB_TEXT_HAS_SELECTION( state ) )\par
835             stb_textedit_prep_selection_at_cursor(state);\par
836 \par
837          state->cursor = STB_TEXTEDIT_MOVEWORDRIGHT(str, state->cursor);\par
838          state->select_end = state->cursor;\par
839 \par
840          stb_textedit_clamp( str, state );\par
841          {\cf19 break};\par
842 {\cf21 #endif}\par
843 \par
844       {\cf19 case} STB_TEXTEDIT_K_RIGHT | STB_TEXTEDIT_K_SHIFT:\par
845          stb_textedit_prep_selection_at_cursor(state);\par
846          {\cf20 // move selection right}\par
847          ++state->select_end;\par
848          stb_textedit_clamp(str, state);\par
849          state->cursor = state->select_end;\par
850          state->has_preferred_x = 0;\par
851          {\cf19 break};\par
852 \par
853       {\cf19 case} STB_TEXTEDIT_K_DOWN:\par
854       {\cf19 case} STB_TEXTEDIT_K_DOWN | STB_TEXTEDIT_K_SHIFT:\par
855       {\cf19 case} STB_TEXTEDIT_K_PGDOWN:\par
856       {\cf19 case} STB_TEXTEDIT_K_PGDOWN | STB_TEXTEDIT_K_SHIFT: \{\par
857          StbFindState find;\par
858          StbTexteditRow row;\par
859          {\cf18 int} i, j, sel = (key & STB_TEXTEDIT_K_SHIFT) != 0;\par
860          {\cf18 int} is_page = (key & ~STB_TEXTEDIT_K_SHIFT) == STB_TEXTEDIT_K_PGDOWN;\par
861          {\cf18 int} row_count = is_page ? state->row_count_per_page : 1;\par
862 \par
863          {\cf19 if} (!is_page && state->single_line) \{\par
864             {\cf20 // on windows, up&down in single-line behave like left&right}\par
865             key = STB_TEXTEDIT_K_RIGHT | (key & STB_TEXTEDIT_K_SHIFT);\par
866             {\cf19 goto} retry;\par
867          \}\par
868 \par
869          {\cf19 if} (sel)\par
870             stb_textedit_prep_selection_at_cursor(state);\par
871          {\cf19 else} {\cf19 if} (STB_TEXT_HAS_SELECTION(state))\par
872             stb_textedit_move_to_last(str, state);\par
873 \par
874          {\cf20 // compute current position of cursor point}\par
875          stb_textedit_clamp(str, state);\par
876          stb_textedit_find_charpos(&find, str, state->cursor, state->single_line);\par
877 \par
878          {\cf19 for} (j = 0; j < row_count; ++j) \{\par
879             {\cf18 float} x, goal_x = state->has_preferred_x ? state->preferred_x : find.x;\par
880             {\cf18 int} start = find.first_char + find.length;\par
881 \par
882             {\cf19 if} (find.length == 0)\par
883                {\cf19 break};\par
884 \par
885             {\cf20 // [DEAR IMGUI]}\par
886             {\cf20 // going down while being on the last line shouldn't bring us to that line end}\par
887             {\cf19 if} (STB_TEXTEDIT_GETCHAR(str, find.first_char + find.length - 1) != STB_TEXTEDIT_NEWLINE)\par
888                {\cf19 break};\par
889 \par
890             {\cf20 // now find character position down a row}\par
891             state->cursor = start;\par
892             STB_TEXTEDIT_LAYOUTROW(&row, str, state->cursor);\par
893             x = row.x0;\par
894             {\cf19 for} (i=0; i < row.num_chars; ++i) \{\par
895                {\cf18 float} dx = STB_TEXTEDIT_GETWIDTH(str, start, i);\par
896 {\cf21                #ifdef IMSTB_TEXTEDIT_GETWIDTH_NEWLINE}\par
897                {\cf19 if} (dx == IMSTB_TEXTEDIT_GETWIDTH_NEWLINE)\par
898                   {\cf19 break};\par
899 {\cf21                #endif}\par
900                x += dx;\par
901                {\cf19 if} (x > goal_x)\par
902                   {\cf19 break};\par
903                ++state->cursor;\par
904             \}\par
905             stb_textedit_clamp(str, state);\par
906 \par
907             state->has_preferred_x = 1;\par
908             state->preferred_x = goal_x;\par
909 \par
910             {\cf19 if} (sel)\par
911                state->select_end = state->cursor;\par
912 \par
913             {\cf20 // go to next line}\par
914             find.first_char = find.first_char + find.length;\par
915             find.length = row.num_chars;\par
916          \}\par
917          {\cf19 break};\par
918       \}\par
919 \par
920       {\cf19 case} STB_TEXTEDIT_K_UP:\par
921       {\cf19 case} STB_TEXTEDIT_K_UP | STB_TEXTEDIT_K_SHIFT:\par
922       {\cf19 case} STB_TEXTEDIT_K_PGUP:\par
923       {\cf19 case} STB_TEXTEDIT_K_PGUP | STB_TEXTEDIT_K_SHIFT: \{\par
924          StbFindState find;\par
925          StbTexteditRow row;\par
926          {\cf18 int} i, j, prev_scan, sel = (key & STB_TEXTEDIT_K_SHIFT) != 0;\par
927          {\cf18 int} is_page = (key & ~STB_TEXTEDIT_K_SHIFT) == STB_TEXTEDIT_K_PGUP;\par
928          {\cf18 int} row_count = is_page ? state->row_count_per_page : 1;\par
929 \par
930          {\cf19 if} (!is_page && state->single_line) \{\par
931             {\cf20 // on windows, up&down become left&right}\par
932             key = STB_TEXTEDIT_K_LEFT | (key & STB_TEXTEDIT_K_SHIFT);\par
933             {\cf19 goto} retry;\par
934          \}\par
935 \par
936          {\cf19 if} (sel)\par
937             stb_textedit_prep_selection_at_cursor(state);\par
938          {\cf19 else} {\cf19 if} (STB_TEXT_HAS_SELECTION(state))\par
939             stb_textedit_move_to_first(state);\par
940 \par
941          {\cf20 // compute current position of cursor point}\par
942          stb_textedit_clamp(str, state);\par
943          stb_textedit_find_charpos(&find, str, state->cursor, state->single_line);\par
944 \par
945          {\cf19 for} (j = 0; j < row_count; ++j) \{\par
946             {\cf18 float}  x, goal_x = state->has_preferred_x ? state->preferred_x : find.x;\par
947 \par
948             {\cf20 // can only go up if there's a previous row}\par
949             {\cf19 if} (find.prev_first == find.first_char)\par
950                {\cf19 break};\par
951 \par
952             {\cf20 // now find character position up a row}\par
953             state->cursor = find.prev_first;\par
954             STB_TEXTEDIT_LAYOUTROW(&row, str, state->cursor);\par
955             x = row.x0;\par
956             {\cf19 for} (i=0; i < row.num_chars; ++i) \{\par
957                {\cf18 float} dx = STB_TEXTEDIT_GETWIDTH(str, find.prev_first, i);\par
958 {\cf21                #ifdef IMSTB_TEXTEDIT_GETWIDTH_NEWLINE}\par
959                {\cf19 if} (dx == IMSTB_TEXTEDIT_GETWIDTH_NEWLINE)\par
960                   {\cf19 break};\par
961 {\cf21                #endif}\par
962                x += dx;\par
963                {\cf19 if} (x > goal_x)\par
964                   {\cf19 break};\par
965                ++state->cursor;\par
966             \}\par
967             stb_textedit_clamp(str, state);\par
968 \par
969             state->has_preferred_x = 1;\par
970             state->preferred_x = goal_x;\par
971 \par
972             {\cf19 if} (sel)\par
973                state->select_end = state->cursor;\par
974 \par
975             {\cf20 // go to previous line}\par
976             {\cf20 // (we need to scan previous line the hard way. maybe we could expose this as a new API function?)}\par
977             prev_scan = find.prev_first > 0 ? find.prev_first - 1 : 0;\par
978             {\cf19 while} (prev_scan > 0 && STB_TEXTEDIT_GETCHAR(str, prev_scan - 1) != STB_TEXTEDIT_NEWLINE)\par
979                --prev_scan;\par
980             find.first_char = find.prev_first;\par
981             find.prev_first = prev_scan;\par
982          \}\par
983          {\cf19 break};\par
984       \}\par
985 \par
986       {\cf19 case} STB_TEXTEDIT_K_DELETE:\par
987       {\cf19 case} STB_TEXTEDIT_K_DELETE | STB_TEXTEDIT_K_SHIFT:\par
988          {\cf19 if} (STB_TEXT_HAS_SELECTION(state))\par
989             stb_textedit_delete_selection(str, state);\par
990          {\cf19 else} \{\par
991             {\cf18 int} n = STB_TEXTEDIT_STRINGLEN(str);\par
992             {\cf19 if} (state->cursor < n)\par
993                stb_textedit_delete(str, state, state->cursor, 1);\par
994          \}\par
995          state->has_preferred_x = 0;\par
996          {\cf19 break};\par
997 \par
998       {\cf19 case} STB_TEXTEDIT_K_BACKSPACE:\par
999       {\cf19 case} STB_TEXTEDIT_K_BACKSPACE | STB_TEXTEDIT_K_SHIFT:\par
1000          {\cf19 if} (STB_TEXT_HAS_SELECTION(state))\par
1001             stb_textedit_delete_selection(str, state);\par
1002          {\cf19 else} \{\par
1003             stb_textedit_clamp(str, state);\par
1004             {\cf19 if} (state->cursor > 0) \{\par
1005                stb_textedit_delete(str, state, state->cursor-1, 1);\par
1006                --state->cursor;\par
1007             \}\par
1008          \}\par
1009          state->has_preferred_x = 0;\par
1010          {\cf19 break};\par
1011 \par
1012 {\cf21 #ifdef STB_TEXTEDIT_K_TEXTSTART2}\par
1013       {\cf19 case} STB_TEXTEDIT_K_TEXTSTART2:\par
1014 {\cf21 #endif}\par
1015       {\cf19 case} STB_TEXTEDIT_K_TEXTSTART:\par
1016          state->cursor = state->select_start = state->select_end = 0;\par
1017          state->has_preferred_x = 0;\par
1018          {\cf19 break};\par
1019 \par
1020 {\cf21 #ifdef STB_TEXTEDIT_K_TEXTEND2}\par
1021       {\cf19 case} STB_TEXTEDIT_K_TEXTEND2:\par
1022 {\cf21 #endif}\par
1023       {\cf19 case} STB_TEXTEDIT_K_TEXTEND:\par
1024          state->cursor = STB_TEXTEDIT_STRINGLEN(str);\par
1025          state->select_start = state->select_end = 0;\par
1026          state->has_preferred_x = 0;\par
1027          {\cf19 break};\par
1028 \par
1029 {\cf21 #ifdef STB_TEXTEDIT_K_TEXTSTART2}\par
1030       {\cf19 case} STB_TEXTEDIT_K_TEXTSTART2 | STB_TEXTEDIT_K_SHIFT:\par
1031 {\cf21 #endif}\par
1032       {\cf19 case} STB_TEXTEDIT_K_TEXTSTART | STB_TEXTEDIT_K_SHIFT:\par
1033          stb_textedit_prep_selection_at_cursor(state);\par
1034          state->cursor = state->select_end = 0;\par
1035          state->has_preferred_x = 0;\par
1036          {\cf19 break};\par
1037 \par
1038 {\cf21 #ifdef STB_TEXTEDIT_K_TEXTEND2}\par
1039       {\cf19 case} STB_TEXTEDIT_K_TEXTEND2 | STB_TEXTEDIT_K_SHIFT:\par
1040 {\cf21 #endif}\par
1041       {\cf19 case} STB_TEXTEDIT_K_TEXTEND | STB_TEXTEDIT_K_SHIFT:\par
1042          stb_textedit_prep_selection_at_cursor(state);\par
1043          state->cursor = state->select_end = STB_TEXTEDIT_STRINGLEN(str);\par
1044          state->has_preferred_x = 0;\par
1045          {\cf19 break};\par
1046 \par
1047 \par
1048 {\cf21 #ifdef STB_TEXTEDIT_K_LINESTART2}\par
1049       {\cf19 case} STB_TEXTEDIT_K_LINESTART2:\par
1050 {\cf21 #endif}\par
1051       {\cf19 case} STB_TEXTEDIT_K_LINESTART:\par
1052          stb_textedit_clamp(str, state);\par
1053          stb_textedit_move_to_first(state);\par
1054          {\cf19 if} (state->single_line)\par
1055             state->cursor = 0;\par
1056          {\cf19 else} {\cf19 while} (state->cursor > 0 && STB_TEXTEDIT_GETCHAR(str, state->cursor-1) != STB_TEXTEDIT_NEWLINE)\par
1057             --state->cursor;\par
1058          state->has_preferred_x = 0;\par
1059          {\cf19 break};\par
1060 \par
1061 {\cf21 #ifdef STB_TEXTEDIT_K_LINEEND2}\par
1062       {\cf19 case} STB_TEXTEDIT_K_LINEEND2:\par
1063 {\cf21 #endif}\par
1064       {\cf19 case} STB_TEXTEDIT_K_LINEEND: \{\par
1065          {\cf18 int} n = STB_TEXTEDIT_STRINGLEN(str);\par
1066          stb_textedit_clamp(str, state);\par
1067          stb_textedit_move_to_first(state);\par
1068          {\cf19 if} (state->single_line)\par
1069              state->cursor = n;\par
1070          {\cf19 else} {\cf19 while} (state->cursor < n && STB_TEXTEDIT_GETCHAR(str, state->cursor) != STB_TEXTEDIT_NEWLINE)\par
1071              ++state->cursor;\par
1072          state->has_preferred_x = 0;\par
1073          {\cf19 break};\par
1074       \}\par
1075 \par
1076 {\cf21 #ifdef STB_TEXTEDIT_K_LINESTART2}\par
1077       {\cf19 case} STB_TEXTEDIT_K_LINESTART2 | STB_TEXTEDIT_K_SHIFT:\par
1078 {\cf21 #endif}\par
1079       {\cf19 case} STB_TEXTEDIT_K_LINESTART | STB_TEXTEDIT_K_SHIFT:\par
1080          stb_textedit_clamp(str, state);\par
1081          stb_textedit_prep_selection_at_cursor(state);\par
1082          {\cf19 if} (state->single_line)\par
1083             state->cursor = 0;\par
1084          {\cf19 else} {\cf19 while} (state->cursor > 0 && STB_TEXTEDIT_GETCHAR(str, state->cursor-1) != STB_TEXTEDIT_NEWLINE)\par
1085             --state->cursor;\par
1086          state->select_end = state->cursor;\par
1087          state->has_preferred_x = 0;\par
1088          {\cf19 break};\par
1089 \par
1090 {\cf21 #ifdef STB_TEXTEDIT_K_LINEEND2}\par
1091       {\cf19 case} STB_TEXTEDIT_K_LINEEND2 | STB_TEXTEDIT_K_SHIFT:\par
1092 {\cf21 #endif}\par
1093       {\cf19 case} STB_TEXTEDIT_K_LINEEND | STB_TEXTEDIT_K_SHIFT: \{\par
1094          {\cf18 int} n = STB_TEXTEDIT_STRINGLEN(str);\par
1095          stb_textedit_clamp(str, state);\par
1096          stb_textedit_prep_selection_at_cursor(state);\par
1097          {\cf19 if} (state->single_line)\par
1098              state->cursor = n;\par
1099          {\cf19 else} {\cf19 while} (state->cursor < n && STB_TEXTEDIT_GETCHAR(str, state->cursor) != STB_TEXTEDIT_NEWLINE)\par
1100             ++state->cursor;\par
1101          state->select_end = state->cursor;\par
1102          state->has_preferred_x = 0;\par
1103          {\cf19 break};\par
1104       \}\par
1105    \}\par
1106 \}\par
