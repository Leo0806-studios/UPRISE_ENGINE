483 {\cf17 class }XmlNodeIterator \{\par
484 {\cf17 public}:\par
486     {\cf17 enum} IterationMode \{\par
487         PreOrderMode, \par
488         PostOrderMode \par
489     \};\par
493     {\cf17 explicit} XmlNodeIterator(XmlNode &parent, IterationMode mode) :\par
494             mParent(parent),\par
495             mNodes(),\par
496             mIndex(0) \{\par
497         {\cf19 if} (mode == PreOrderMode) \{\par
498             collectChildrenPreOrder(parent);\par
499         \} {\cf19 else} \{\par
500             collectChildrenPostOrder(parent);\par
501         \}\par
502     \}\par
503 \par
505     ~XmlNodeIterator() = {\cf19 default};\par
506 \par
509     {\cf18 void} collectChildrenPreOrder(XmlNode &node) \{\par
510         {\cf19 if} (node != mParent && node.type() == pugi::node_element) \{\par
511             mNodes.push_back(node);\par
512         \}\par
513         {\cf19 for} (XmlNode currentNode : node.children()) \{\par
514             collectChildrenPreOrder(currentNode);\par
515         \}\par
516     \}\par
517 \par
520     {\cf18 void} collectChildrenPostOrder(XmlNode &node) \{\par
521         {\cf19 for} (XmlNode currentNode = node.first_child(); currentNode; currentNode = currentNode.next_sibling()) \{\par
522             collectChildrenPostOrder(currentNode);\par
523         \}\par
524         {\cf19 if} (node != mParent) \{\par
525             mNodes.push_back(node);\par
526         \}\par
527     \}\par
528 \par
532     {\cf18 bool} getNext(XmlNode &next) \{\par
533         {\cf19 if} (mIndex == mNodes.size()) \{\par
534             {\cf19 return} {\cf17 false};\par
535         \}\par
536 \par
537         next = mNodes[mIndex];\par
538         ++mIndex;\par
539 \par
540         {\cf19 return} {\cf17 true};\par
541     \}\par
542 \par
545     {\cf18 size_t} size(){\cf17  const }\{\par
546         {\cf19 return} mNodes.size();\par
547     \}\par
548 \par
551     {\cf18 bool} isEmpty(){\cf17  const }\{\par
552         {\cf19 return} mNodes.empty();\par
553     \}\par
554 \par
556     {\cf18 void} clear() \{\par
557         {\cf19 if} (mNodes.empty()) \{\par
558             {\cf19 return};\par
559         \}\par
560 \par
561         mNodes.clear();\par
562         mIndex = 0;\par
563     \}\par
564 \par
565 {\cf17 private}:\par
566     XmlNode &mParent;\par
567     std::vector<XmlNode> mNodes;\par
568     {\cf18 size_t} mIndex;\par
569 \};\par
