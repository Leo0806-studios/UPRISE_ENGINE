283 {\cf17 template} <{\cf17 class} TNodeType>\par
284 {\cf18 bool} TXmlParser<TNodeType>::parse(IOStream *stream) \{\par
285     {\cf19 if} (hasRoot()) \{\par
286         clear();\par
287     \}\par
288 \par
289     {\cf19 if} ({\cf17 nullptr} == stream) \{\par
290         ASSIMP_LOG_DEBUG({\cf22 "Stream is nullptr."});\par
291         {\cf19 return} {\cf17 false};\par
292     \}\par
293 \par
294     {\cf17 const} {\cf18 size_t} len = stream->FileSize();\par
295     mData.resize(len + 1);\par
296     memset(&mData[0], {\cf23 '\\0'}, len + 1);\par
297     stream->Read(&mData[0], 1, len);\par
298 \par
299     mDoc = {\cf17 new} pugi::xml_document();\par
300     pugi::xml_parse_result parse_result = mDoc->load_string(&mData[0], pugi::parse_full);\par
301     {\cf19 if} (parse_result.status == pugi::status_ok) \{\par
302         {\cf19 return} {\cf17 true};\par
303     \}\par
304 \par
305     ASSIMP_LOG_DEBUG({\cf22 "Error while parse xml."}, std::string(parse_result.description()), {\cf22 " @ "}, parse_result.offset);\par
306 \par
307     {\cf19 return} {\cf17 false};\par
308 \}\par
