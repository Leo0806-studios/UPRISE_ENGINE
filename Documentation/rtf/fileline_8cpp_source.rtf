00161 {\cf20 /* Initialize the fileline information from the executable.  Returns 1}\par
00162 {\cf20    on success, 0 on failure.  */}\par
00163 \par
00164 {\cf17 static} {\cf18 int}\par
00165 fileline_initialize ({\cf17 struct} backtrace_state *state,\par
00166              backtrace_error_callback error_callback, {\cf18 void} *data)\par
00167 \{\par
00168   {\cf18 int} failed;\par
00169   fileline fileline_fn;\par
00170   {\cf18 int} pass;\par
00171   {\cf18 int} called_error_callback;\par
00172   {\cf18 int} descriptor;\par
00173   {\cf17 const} {\cf18 char} *filename;\par
00174   {\cf18 char} buf[64];\par
00175 \par
00176   {\cf19 if} (!state->threaded)\par
00177     failed = state->fileline_initialization_failed;\par
00178   {\cf19 else}\par
00179     failed = backtrace_atomic_load_int (&state->fileline_initialization_failed);\par
00180 \par
00181   {\cf19 if} (failed)\par
00182     \{\par
00183       error_callback (data, {\cf22 "failed to read executable information"}, -1);\par
00184       {\cf19 return} 0;\par
00185     \}\par
00186 \par
00187   {\cf19 if} (!state->threaded)\par
00188     fileline_fn = state->fileline_fn;\par
00189   {\cf19 else}\par
00190     fileline_fn = backtrace_atomic_load_pointer (&state->fileline_fn);\par
00191   {\cf19 if} (fileline_fn != NULL)\par
00192     {\cf19 return} 1;\par
00193 \par
00194   {\cf20 /* We have not initialized the information.  Do it now.  */}\par
00195 \par
00196   descriptor = -1;\par
00197   called_error_callback = 0;\par
00198   {\cf19 for} (pass = 0; pass < 8; ++pass)\par
00199     \{\par
00200       {\cf18 int} does_not_exist;\par
00201 \par
00202       {\cf19 switch} (pass)\par
00203     \{\par
00204     {\cf19 case} 0:\par
00205       filename = state->filename;\par
00206       {\cf19 break};\par
00207     {\cf19 case} 1:\par
00208       filename = getexecname ();\par
00209       {\cf19 break};\par
00210     {\cf19 case} 2:\par
00211       filename = {\cf22 "/proc/self/exe"};\par
00212       {\cf19 break};\par
00213     {\cf19 case} 3:\par
00214       filename = {\cf22 "/proc/curproc/file"};\par
00215       {\cf19 break};\par
00216     {\cf19 case} 4:\par
00217       snprintf (buf, {\cf17 sizeof} (buf), {\cf22 "/proc/%ld/object/a.out"},\par
00218             ({\cf18 long}) getpid ());\par
00219       filename = buf;\par
00220       {\cf19 break};\par
00221     {\cf19 case} 5:\par
00222       filename = sysctl_exec_name1 (state, error_callback, data);\par
00223       {\cf19 break};\par
00224     {\cf19 case} 6:\par
00225       filename = sysctl_exec_name2 (state, error_callback, data);\par
00226       {\cf19 break};\par
00227     {\cf19 case} 7:\par
00228       filename = macho_get_executable_path (state, error_callback, data);\par
00229       {\cf19 break};\par
00230     {\cf19 default}:\par
00231       abort ();\par
00232     \}\par
00233 \par
00234       {\cf19 if} (filename == NULL)\par
00235     {\cf19 continue};\par
00236 \par
00237       descriptor = backtrace_open (filename, error_callback, data,\par
00238                    &does_not_exist);\par
00239       {\cf19 if} (descriptor < 0 && !does_not_exist)\par
00240     \{\par
00241       called_error_callback = 1;\par
00242       {\cf19 break};\par
00243     \}\par
00244       {\cf19 if} (descriptor >= 0)\par
00245     {\cf19 break};\par
00246     \}\par
00247 \par
00248   {\cf19 if} (descriptor < 0)\par
00249     \{\par
00250       {\cf19 if} (!called_error_callback)\par
00251     \{\par
00252       {\cf19 if} (state->filename != NULL)\par
00253         error_callback (data, state->filename, ENOENT);\par
00254       {\cf19 else}\par
00255         error_callback (data,\par
00256                 {\cf22 "libbacktrace could not find executable to open"},\par
00257                 0);\par
00258     \}\par
00259       failed = 1;\par
00260     \}\par
00261 \par
00262   {\cf19 if} (!failed)\par
00263     \{\par
00264       {\cf19 if} (!backtrace_initialize (state, filename, descriptor, error_callback,\par
00265                  data, &fileline_fn))\par
00266     failed = 1;\par
00267     \}\par
00268 \par
00269   {\cf19 if} (failed)\par
00270     \{\par
00271       {\cf19 if} (!state->threaded)\par
00272     state->fileline_initialization_failed = 1;\par
00273       {\cf19 else}\par
00274     backtrace_atomic_store_int (&state->fileline_initialization_failed, 1);\par
00275       {\cf19 return} 0;\par
00276     \}\par
00277 \par
00278   {\cf19 if} (!state->threaded)\par
00279     state->fileline_fn = fileline_fn;\par
00280   {\cf19 else}\par
00281     \{\par
00282       backtrace_atomic_store_pointer (&state->fileline_fn, fileline_fn);\par
00283 \par
00284       {\cf20 /* Note that if two threads initialize at once, one of the data}\par
00285 {\cf20      sets may be leaked.  */}\par
00286     \}\par
00287 \par
00288   {\cf19 return} 1;\par
00289 \}\par
