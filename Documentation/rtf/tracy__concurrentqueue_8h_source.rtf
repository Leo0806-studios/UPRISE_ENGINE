599     {\cf17 inline} {\cf18 bool} update_current_producer_after_rotation(consumer_token_t& token)\par
600     \{\par
601         {\cf20 // Ah, there's been a rotation, figure out where we should be!}\par
602         {\cf17 auto} tail = producerListTail.load(std::memory_order_acquire);\par
603         {\cf19 if} (token.desiredProducer == {\cf17 nullptr} && tail == {\cf17 nullptr}) \{\par
604             {\cf19 return} {\cf17 false};\par
605         \}\par
606         {\cf17 auto} prodCount = producerCount.load(std::memory_order_relaxed);\par
607         {\cf17 auto} globalOffset = globalExplicitConsumerOffset.load(std::memory_order_relaxed);\par
608         {\cf19 if} (details::cqUnlikely(token.desiredProducer == {\cf17 nullptr})) \{\par
609             {\cf20 // Aha, first time we're dequeueing anything.}\par
610             {\cf20 // Figure out our local position}\par
611             {\cf20 // Note: offset is from start, not end, but we're traversing from end -- subtract from count first}\par
612             std::uint32_t offset = prodCount - 1 - (token.initialOffset % prodCount);\par
613             token.desiredProducer = tail;\par
614             {\cf19 for} (std::uint32_t i = 0; i != offset; ++i) \{\par
615                 token.desiredProducer = {\cf17 static_cast<}ProducerBase*{\cf17 >}(token.desiredProducer)->next_prod();\par
616                 {\cf19 if} (token.desiredProducer == {\cf17 nullptr}) \{\par
617                     token.desiredProducer = tail;\par
618                 \}\par
619             \}\par
620         \}\par
621 \par
622         std::uint32_t delta = globalOffset - token.lastKnownGlobalOffset;\par
623         {\cf19 if} (delta >= prodCount) \{\par
624             delta = delta % prodCount;\par
625         \}\par
626         {\cf19 for} (std::uint32_t i = 0; i != delta; ++i) \{\par
627             token.desiredProducer = {\cf17 static_cast<}ProducerBase*{\cf17 >}(token.desiredProducer)->next_prod();\par
628             {\cf19 if} (token.desiredProducer == {\cf17 nullptr}) \{\par
629                 token.desiredProducer = tail;\par
630             \}\par
631         \}\par
632 \par
633         token.lastKnownGlobalOffset = globalOffset;\par
634         token.currentProducer = token.desiredProducer;\par
635         token.itemsConsumedFromCurrent = 0;\par
636         {\cf19 return} {\cf17 true};\par
637     \}\par
