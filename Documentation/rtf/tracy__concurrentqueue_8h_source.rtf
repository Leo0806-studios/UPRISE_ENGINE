652 \par
653     {\cf20 // A simple CAS-based lock-free free list. Not the fastest thing in the world under heavy contention, but}\par
654     {\cf20 // simple and correct (assuming nodes are never freed until after the free list is destroyed), and fairly}\par
655     {\cf20 // speedy under low contention.}\par
656     {\cf17 template}<{\cf17 typename} N>        {\cf20 // N must inherit FreeListNode or have the same fields (and initialization of them)}\par
657     {\cf17 struct }FreeList\par
658     \{\par
659         FreeList() : freeListHead(nullptr) \{ \}\par
660         FreeList(FreeList&& other) : freeListHead(other.freeListHead.load(std::memory_order_relaxed)) \{ other.freeListHead.store({\cf17 nullptr}, std::memory_order_relaxed); \}\par
661         {\cf18 void} swap(FreeList& other) \{ details::swap_relaxed(freeListHead, other.freeListHead); \}\par
662 \par
663         FreeList(FreeList {\cf17 const}&) = {\cf17 delete};\par
664         FreeList& operator=(FreeList {\cf17 const}&) = {\cf17 delete};\par
665 \par
666         {\cf17 inline} {\cf18 void} add(N* node)\par
667         \{\par
668             {\cf20 // We know that the should-be-on-freelist bit is 0 at this point, so it's safe to}\par
669             {\cf20 // set it using a fetch_add}\par
670             {\cf19 if} (node->freeListRefs.fetch_add(SHOULD_BE_ON_FREELIST, std::memory_order_acq_rel) == 0) \{\par
671                 {\cf20 // Oh look! We were the last ones referencing this node, and we know}\par
672                 {\cf20 // we want to add it to the free list, so let's do it!}\par
673                 add_knowing_refcount_is_zero(node);\par
674             \}\par
675         \}\par
676 \par
677         {\cf17 inline} N* try_get()\par
678         \{\par
679             {\cf17 auto} head = freeListHead.load(std::memory_order_acquire);\par
680             {\cf19 while} (head != {\cf17 nullptr}) \{\par
681                 {\cf17 auto} prevHead = head;\par
682                 {\cf17 auto} refs = head->freeListRefs.load(std::memory_order_relaxed);\par
683                 {\cf19 if} ((refs & REFS_MASK) == 0 || !head->freeListRefs.compare_exchange_strong(refs, refs + 1, std::memory_order_acquire, std::memory_order_relaxed)) \{\par
684                     head = freeListHead.load(std::memory_order_acquire);\par
685                     {\cf19 continue};\par
686                 \}\par
687 \par
688                 {\cf20 // Good, reference count has been incremented (it wasn't at zero), which means we can read the}\par
689                 {\cf20 // next and not worry about it changing between now and the time we do the CAS}\par
690                 {\cf17 auto} next = head->freeListNext.load(std::memory_order_relaxed);\par
691                 {\cf19 if} (freeListHead.compare_exchange_strong(head, next, std::memory_order_acquire, std::memory_order_relaxed)) \{\par
692                     {\cf20 // Yay, got the node. This means it was on the list, which means shouldBeOnFreeList must be false no}\par
693                     {\cf20 // matter the refcount (because nobody else knows it's been taken off yet, it can't have been put back on).}\par
694                     assert((head->freeListRefs.load(std::memory_order_relaxed) & SHOULD_BE_ON_FREELIST) == 0);\par
695 \par
696                     {\cf20 // Decrease refcount twice, once for our ref, and once for the list's ref}\par
697                     head->freeListRefs.fetch_sub(2, std::memory_order_release);\par
698                     {\cf19 return} head;\par
699                 \}\par
700 \par
701                 {\cf20 // OK, the head must have changed on us, but we still need to decrease the refcount we increased.}\par
702                 {\cf20 // Note that we don't need to release any memory effects, but we do need to ensure that the reference}\par
703                 {\cf20 // count decrement happens-after the CAS on the head.}\par
704                 refs = prevHead->freeListRefs.fetch_sub(1, std::memory_order_acq_rel);\par
705                 {\cf19 if} (refs == SHOULD_BE_ON_FREELIST + 1) \{\par
706                     add_knowing_refcount_is_zero(prevHead);\par
707                 \}\par
708             \}\par
709 \par
710             {\cf19 return} {\cf17 nullptr};\par
711         \}\par
712 \par
713         {\cf20 // Useful for traversing the list when there's no contention (e.g. to destroy remaining nodes)}\par
714         N* head_unsafe(){\cf17  const }\{ {\cf19 return} freeListHead.load(std::memory_order_relaxed); \}\par
715 \par
716     {\cf17 private}:\par
717         {\cf17 inline} {\cf18 void} add_knowing_refcount_is_zero(N* node)\par
718         \{\par
719             {\cf20 // Since the refcount is zero, and nobody can increase it once it's zero (except us, and we run}\par
720             {\cf20 // only one copy of this method per node at a time, i.e. the single thread case), then we know}\par
721             {\cf20 // we can safely change the next pointer of the node; however, once the refcount is back above}\par
722             {\cf20 // zero, then other threads could increase it (happens under heavy contention, when the refcount}\par
723             {\cf20 // goes to zero in between a load and a refcount increment of a node in try_get, then back up to}\par
724             {\cf20 // something non-zero, then the refcount increment is done by the other thread) -- so, if the CAS}\par
725             {\cf20 // to add the node to the actual list fails, decrease the refcount and leave the add operation to}\par
726             {\cf20 // the next thread who puts the refcount back at zero (which could be us, hence the loop).}\par
727             {\cf17 auto} head = freeListHead.load(std::memory_order_relaxed);\par
728             {\cf19 while} ({\cf17 true}) \{\par
729                 node->freeListNext.store(head, std::memory_order_relaxed);\par
730                 node->freeListRefs.store(1, std::memory_order_release);\par
731                 {\cf19 if} (!freeListHead.compare_exchange_strong(head, node, std::memory_order_release, std::memory_order_relaxed)) \{\par
732                     {\cf20 // Hmm, the add failed, but we can only try again when the refcount goes back to zero}\par
733                     {\cf19 if} (node->freeListRefs.fetch_add(SHOULD_BE_ON_FREELIST - 1, std::memory_order_release) == 1) \{\par
734                         {\cf19 continue};\par
735                     \}\par
736                 \}\par
737                 {\cf19 return};\par
738             \}\par
739         \}\par
