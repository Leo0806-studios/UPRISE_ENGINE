127     {\cf20 // The type used for the enqueue and dequeue indices. Must be at least as}\par
128     {\cf20 // large as size_t. Should be significantly larger than the number of elements}\par
129     {\cf20 // you expect to hold at once, especially if you have a high turnover rate;}\par
130     {\cf20 // for example, on 32-bit x86, if you expect to have over a hundred million}\par
131     {\cf20 // elements or pump several million elements through your queue in a very}\par
132     {\cf20 // short space of time, using a 32-bit type *may* trigger a race condition.}\par
133     {\cf20 // A 64-bit int type is recommended in that case, and in practice will}\par
134     {\cf20 // prevent a race condition no matter the usage of the queue. Note that}\par
135     {\cf20 // whether the queue is lock-free with a 64-int type depends on the whether}\par
136     {\cf20 // std::atomic<std::uint64_t> is lock-free, which is platform-specific.}\par
137     {\cf17 typedef} std::size_t index_t;\par
138 \par
139     {\cf20 // Internally, all elements are enqueued and dequeued from multi-element}\par
140     {\cf20 // blocks; this is the smallest controllable unit. If you expect few elements}\par
141     {\cf20 // but many producers, a smaller block size should be favoured. For few producers}\par
142     {\cf20 // and/or many elements, a larger block size is preferred. A sane default}\par
143     {\cf20 // is provided. Must be a power of 2.}\par
144     {\cf17 static} {\cf17 const} {\cf18 size_t} BLOCK_SIZE = 64*1024;\par
145 \par
146     {\cf20 // For explicit producers (i.e. when using a producer token), the block is}\par
147     {\cf20 // checked for being empty by iterating through a list of flags, one per element.}\par
148     {\cf20 // For large block sizes, this is too inefficient, and switching to an atomic}\par
149     {\cf20 // counter-based approach is faster. The switch is made for block sizes strictly}\par
150     {\cf20 // larger than this threshold.}\par
151     {\cf17 static} {\cf17 const} {\cf18 size_t} EXPLICIT_BLOCK_EMPTY_COUNTER_THRESHOLD = 32;\par
152 \par
153     {\cf20 // How many full blocks can be expected for a single explicit producer? This should}\par
154     {\cf20 // reflect that number's maximum for optimal performance. Must be a power of 2.}\par
155     {\cf17 static} {\cf17 const} {\cf18 size_t} EXPLICIT_INITIAL_INDEX_SIZE = 32;\par
156 \par
157     {\cf20 // Controls the number of items that an explicit consumer (i.e. one with a token)}\par
158     {\cf20 // must consume before it causes all consumers to rotate and move on to the next}\par
159     {\cf20 // internal queue.}\par
160     {\cf17 static} {\cf17 const} std::uint32_t EXPLICIT_CONSUMER_CONSUMPTION_QUOTA_BEFORE_ROTATE = 256;\par
