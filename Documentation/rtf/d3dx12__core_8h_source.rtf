908 {\cf17 inline} {\cf18 bool} operator==( {\cf17 const} D3D12_CLEAR_VALUE &a, {\cf17 const} D3D12_CLEAR_VALUE &b) {\cf17 noexcept}\par
909 \{\par
910     {\cf19 if} (a.Format != b.Format) {\cf19 return} {\cf17 false};\par
911     {\cf19 if} (a.Format == DXGI_FORMAT_D24_UNORM_S8_UINT\par
912      || a.Format == DXGI_FORMAT_D16_UNORM\par
913      || a.Format == DXGI_FORMAT_D32_FLOAT\par
914      || a.Format == DXGI_FORMAT_D32_FLOAT_S8X24_UINT)\par
915     \{\par
916         {\cf19 return} (a.DepthStencil.Depth == b.DepthStencil.Depth) &&\par
917           (a.DepthStencil.Stencil == b.DepthStencil.Stencil);\par
918     \} {\cf19 else} \{\par
919         {\cf19 return} (a.Color[0] == b.Color[0]) &&\par
920                (a.Color[1] == b.Color[1]) &&\par
921                (a.Color[2] == b.Color[2]) &&\par
922                (a.Color[3] == b.Color[3]);\par
923     \}\par
924 \}\par
