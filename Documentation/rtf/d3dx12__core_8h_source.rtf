892         memcpy( Color, color, {\cf17 sizeof}( Color ) );\par
893     \}\par
894     CD3DX12_CLEAR_VALUE(\par
895         DXGI_FORMAT format,\par
896         FLOAT depth,\par
897         UINT8 stencil ) {\cf17 noexcept}\par
898     \{\par
899         Format = format;\par
900         memset( &Color, 0, {\cf17 sizeof}( Color ) );\par
901         {\cf20 /* Use memcpy to preserve NAN values */}\par
