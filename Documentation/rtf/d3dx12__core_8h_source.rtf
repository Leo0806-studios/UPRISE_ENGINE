1444 {\cf20 // Fills in the mipmap and alignment values of pDesc when either members are zero}\par
1445 {\cf20 // Used to replace an implicit field to an explicit (0 mip map = max mip map level)}\par
1446 {\cf20 // If expansion has occured, returns LclDesc, else returns the original pDesc}\par
1447 {\cf17 inline} {\cf17 const} CD3DX12_RESOURCE_DESC1* D3DX12ConditionallyExpandAPIDesc(\par
1448     CD3DX12_RESOURCE_DESC1& LclDesc,\par
1449     {\cf17 const} CD3DX12_RESOURCE_DESC1* pDesc)\par
1450 \{\par
1451     {\cf20 // Expand mip levels:}\par
1452     {\cf19 if} (pDesc->MipLevels == 0 || pDesc->Alignment == 0)\par
1453     \{\par
1454         LclDesc = *pDesc;\par
1455         {\cf19 if} (pDesc->MipLevels == 0)\par
1456         \{\par
1457             {\cf17 auto} MaxMipLevels = [](UINT64 uiMaxDimension) -> UINT16\par
1458             \{\par
1459                 UINT16 uiRet = 0;\par
1460                 {\cf19 while} (uiMaxDimension > 0)\par
1461                 \{\par
1462                     uiRet++;\par
1463                     uiMaxDimension >>= 1;\par
1464                 \}\par
1465                 {\cf19 return} uiRet;\par
1466             \};\par
