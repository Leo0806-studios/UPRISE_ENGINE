489 {\cf17 class }VkCtxScope\par
490 \{\par
491 {\cf17 public}:\par
492     tracy_force_inline VkCtxScope( VkCtx* ctx, {\cf17 const} SourceLocationData* srcloc, VkCommandBuffer cmdbuf, {\cf18 bool} is_active )\par
493 {\cf21 #ifdef TRACY_ON_DEMAND}\par
494         : m_active( is_active && GetProfiler().IsConnected() )\par
495 {\cf21 #else}\par
496         : m_active( is_active )\par
497 {\cf21 #endif}\par
498     \{\par
499         {\cf19 if}( !m_active ) {\cf19 return};\par
500         m_cmdbuf = cmdbuf;\par
501         m_ctx = ctx;\par
502 \par
503         {\cf17 const} {\cf17 auto} queryId = ctx->NextQueryId();\par
504         CONTEXT_VK_FUNCTION_WRAPPER( vkCmdWriteTimestamp( cmdbuf, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, ctx->m_query, queryId ) );\par
505 \par
506         {\cf17 auto} item = Profiler::QueueSerial();\par
507         MemWrite( &item->hdr.type, QueueType::GpuZoneBeginSerial );\par
508         MemWrite( &item->gpuZoneBegin.cpuTime, Profiler::GetTime() );\par
509         MemWrite( &item->gpuZoneBegin.srcloc, (uint64_t)srcloc );\par
510         MemWrite( &item->gpuZoneBegin.thread, GetThreadHandle() );\par
511         MemWrite( &item->gpuZoneBegin.queryId, uint16_t( queryId ) );\par
512         MemWrite( &item->gpuZoneBegin.context, ctx->GetId() );\par
513         Profiler::QueueSerialFinish();\par
514     \}\par
515 \par
516     tracy_force_inline VkCtxScope( VkCtx* ctx, {\cf17 const} SourceLocationData* srcloc, VkCommandBuffer cmdbuf, {\cf18 int} depth, {\cf18 bool} is_active )\par
517 {\cf21 #ifdef TRACY_ON_DEMAND}\par
518         : m_active( is_active && GetProfiler().IsConnected() )\par
519 {\cf21 #else}\par
520         : m_active( is_active )\par
521 {\cf21 #endif}\par
522     \{\par
523         {\cf19 if}( !m_active ) {\cf19 return};\par
524         m_cmdbuf = cmdbuf;\par
525         m_ctx = ctx;\par
526 \par
527         {\cf17 const} {\cf17 auto} queryId = ctx->NextQueryId();\par
528         CONTEXT_VK_FUNCTION_WRAPPER( vkCmdWriteTimestamp( cmdbuf, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, ctx->m_query, queryId ) );\par
529 \par
