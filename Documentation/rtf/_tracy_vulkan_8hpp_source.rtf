447     {\cf18 void} PopulateSymbolTable( VkInstance instance, PFN_vkGetInstanceProcAddr instanceProcAddr, PFN_vkGetDeviceProcAddr deviceProcAddr )\par
448     \{\par
449 {\cf21 #define VK_GET_DEVICE_SYMBOL( name ) \\}\par
450 {\cf21         (PFN_##name)deviceProcAddr( m_device, #name );}\par
451 {\cf21 #define VK_LOAD_DEVICE_SYMBOL( name ) \\}\par
452 {\cf21         m_symbols.name = VK_GET_DEVICE_SYMBOL( name );}\par
453 {\cf21 #define VK_GET_INSTANCE_SYMBOL( name ) \\}\par
454 {\cf21         (PFN_##name)instanceProcAddr( instance, #name );}\par
455 {\cf21 #define VK_LOAD_INSTANCE_SYMBOL( name ) \\}\par
456 {\cf21         m_symbols.name = VK_GET_INSTANCE_SYMBOL( name );}\par
457 \par
458         LoadVkDeviceCoreSymbols( VK_LOAD_DEVICE_SYMBOL )\par
459         LoadVkDeviceExtensionSymbols( VK_LOAD_DEVICE_SYMBOL )\par
460         LoadVkInstanceCoreSymbols( VK_LOAD_INSTANCE_SYMBOL )\par
461 {\cf21 #undef VK_GET_DEVICE_SYMBOL}\par
462 {\cf21 #undef VK_LOAD_DEVICE_SYMBOL}\par
463 {\cf21 #undef VK_GET_INSTANCE_SYMBOL}\par
464 {\cf21 #undef VK_LOAD_INSTANCE_SYMBOL}\par
465     \}\par
466 {\cf21 #endif}\par
