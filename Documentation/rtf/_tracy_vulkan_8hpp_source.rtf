132         submitInfo.sType = VK_STRUCTURE_TYPE_SUBMIT_INFO;\par
133         submitInfo.commandBufferCount = 1;\par
134         submitInfo.pCommandBuffers = &cmdbuf;\par
135 \par
136         VK_FUNCTION_WRAPPER( vkBeginCommandBuffer( cmdbuf, &beginInfo ) );\par
137         VK_FUNCTION_WRAPPER( vkCmdResetQueryPool( cmdbuf, m_query, 0, m_queryCount ) );\par
138         VK_FUNCTION_WRAPPER( vkEndCommandBuffer( cmdbuf ) );\par
139         VK_FUNCTION_WRAPPER( vkQueueSubmit( queue, 1, &submitInfo, VK_NULL_HANDLE ) );\par
140         VK_FUNCTION_WRAPPER( vkQueueWaitIdle( queue ) );\par
141 \par
142         int64_t tcpu, tgpu;\par
143         {\cf19 if}( m_timeDomain == VK_TIME_DOMAIN_DEVICE_EXT )\par
144         \{\par
145             VK_FUNCTION_WRAPPER( vkBeginCommandBuffer( cmdbuf, &beginInfo ) );\par
146             VK_FUNCTION_WRAPPER( vkCmdWriteTimestamp( cmdbuf, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, m_query, 0 ) );\par
147             VK_FUNCTION_WRAPPER( vkEndCommandBuffer( cmdbuf ) );\par
