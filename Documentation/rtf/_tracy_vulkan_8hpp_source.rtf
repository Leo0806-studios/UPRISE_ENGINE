335     tracy_force_inline {\cf18 void} Calibrate( VkDevice device, int64_t& tCpu, int64_t& tGpu )\par
336     \{\par
337         assert( m_timeDomain != VK_TIME_DOMAIN_DEVICE_EXT );\par
338         VkCalibratedTimestampInfoEXT spec[2] = \{\par
339             \{ VK_STRUCTURE_TYPE_CALIBRATED_TIMESTAMP_INFO_EXT, {\cf17 nullptr}, VK_TIME_DOMAIN_DEVICE_EXT \},\par
340             \{ VK_STRUCTURE_TYPE_CALIBRATED_TIMESTAMP_INFO_EXT, {\cf17 nullptr}, m_timeDomain \},\par
341         \};\par
342         uint64_t ts[2];\par
343         uint64_t deviation;\par
344         {\cf19 do}\par
345         \{\par
346             m_vkGetCalibratedTimestampsEXT( device, 2, spec, ts, &deviation );\par
347         \}\par
348         {\cf19 while}( deviation > m_deviation );\par
349 \par
350 {\cf21 #if defined _WIN32}\par
351         tGpu = ts[0];\par
352         tCpu = ts[1] * m_qpcToNs;\par
353 {\cf21 #elif defined __linux__ && defined CLOCK_MONOTONIC_RAW}\par
354         tGpu = ts[0];\par
355         tCpu = ts[1];\par
356 {\cf21 #else}\par
357         assert( {\cf17 false} );\par
358 {\cf21 #endif}\par
359     \}\par
360 \par
361     tracy_force_inline {\cf18 void} CreateQueryPool()\par
362     \{\par
363         VkQueryPoolCreateInfo poolInfo = \{\};\par
364         poolInfo.sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO;\par
365         poolInfo.queryCount = m_queryCount;\par
366         poolInfo.queryType = VK_QUERY_TYPE_TIMESTAMP;\par
367         {\cf19 while} ( VK_FUNCTION_WRAPPER( vkCreateQueryPool( m_device, &poolInfo, {\cf17 nullptr}, &m_query ) != VK_SUCCESS ) )\par
368         \{\par
369             m_queryCount /= 2;\par
370             poolInfo.queryCount = m_queryCount;\par
371         \}\par
372     \}\par
373 \par
374     tracy_force_inline {\cf18 void} FindAvailableTimeDomains( VkPhysicalDevice physicalDevice, PFN_vkGetPhysicalDeviceCalibrateableTimeDomainsEXT _vkGetPhysicalDeviceCalibrateableTimeDomainsEXT )\par
375     \{\par
376         uint32_t num;\par
377         _vkGetPhysicalDeviceCalibrateableTimeDomainsEXT( physicalDevice, &num, {\cf17 nullptr} );\par
378         {\cf19 if}(num > 4) num = 4;\par
379         VkTimeDomainEXT data[4];\par
380         _vkGetPhysicalDeviceCalibrateableTimeDomainsEXT( physicalDevice, &num, data );\par
381         VkTimeDomainEXT supportedDomain = (VkTimeDomainEXT)-1;\par
382 {\cf21 #if defined _WIN32}\par
383         supportedDomain = VK_TIME_DOMAIN_QUERY_PERFORMANCE_COUNTER_EXT;\par
384 {\cf21 #elif defined __linux__ && defined CLOCK_MONOTONIC_RAW}\par
385         supportedDomain = VK_TIME_DOMAIN_CLOCK_MONOTONIC_RAW_EXT;\par
386 {\cf21 #endif}\par
387         {\cf19 for}( uint32_t i=0; i<num; i++ ) \{\par
388             {\cf19 if}(data[i] == supportedDomain) \{\par
389                 m_timeDomain = data[i];\par
390                 {\cf19 break};\par
391             \}\par
392         \}\par
393     \}\par
394 \par
395     tracy_force_inline {\cf18 void} FindCalibratedTimestampDeviation()\par
396     \{\par
397         assert( m_timeDomain != VK_TIME_DOMAIN_DEVICE_EXT );\par
398         {\cf17 constexpr} {\cf18 size_t} NumProbes = 32;\par
399         VkCalibratedTimestampInfoEXT spec[2] = \{\par
400             \{ VK_STRUCTURE_TYPE_CALIBRATED_TIMESTAMP_INFO_EXT, {\cf17 nullptr}, VK_TIME_DOMAIN_DEVICE_EXT \},\par
401             \{ VK_STRUCTURE_TYPE_CALIBRATED_TIMESTAMP_INFO_EXT, {\cf17 nullptr}, m_timeDomain \},\par
402         \};\par
403         uint64_t ts[2];\par
404         uint64_t deviation[NumProbes];\par
405         {\cf19 for}( {\cf18 int} i=0; i<NumProbes; i++ ) \{\par
406             m_vkGetCalibratedTimestampsEXT( m_device, 2, spec, ts, deviation + i );\par
407         \}\par
408         uint64_t minDeviation = deviation[0];\par
409         {\cf19 for}( {\cf18 int} i=1; i<NumProbes; i++ ) \{\par
410             {\cf19 if} ( minDeviation > deviation[i] ) \{\par
411                 minDeviation = deviation[i];\par
412             \}\par
413         \}\par
414         m_deviation = minDeviation * 3 / 2;\par
415 \par
416 {\cf21 #if defined _WIN32}\par
417         m_qpcToNs = int64_t( 1000000000. / GetFrequencyQpc() );\par
418 {\cf21 #endif}\par
419     \}\par
420 \par
421     tracy_force_inline {\cf18 void} WriteInitialItem( VkPhysicalDevice physdev, int64_t tcpu, int64_t tgpu )\par
422     \{\par
423         uint8_t flags = 0;\par
424         {\cf19 if}( m_timeDomain != VK_TIME_DOMAIN_DEVICE_EXT ) flags |= GpuContextCalibration;\par
425 \par
426         VkPhysicalDeviceProperties prop;\par
427         VK_FUNCTION_WRAPPER( vkGetPhysicalDeviceProperties( physdev, &prop ) );\par
428         {\cf17 const} {\cf18 float} period = prop.limits.timestampPeriod;\par
429 \par
430         {\cf17 auto} item = Profiler::QueueSerial();\par
431         MemWrite( &item->hdr.type, QueueType::GpuNewContext );\par
432         MemWrite( &item->gpuNewContext.cpuTime, tcpu );\par
433         MemWrite( &item->gpuNewContext.gpuTime, tgpu );\par
434         memset( &item->gpuNewContext.thread, 0, {\cf17 sizeof}( item->gpuNewContext.thread ) );\par
435         MemWrite( &item->gpuNewContext.period, period );\par
436         MemWrite( &item->gpuNewContext.context, m_context );\par
437         MemWrite( &item->gpuNewContext.flags, flags );\par
438         MemWrite( &item->gpuNewContext.type, GpuContextType::Vulkan );\par
439 \par
440 {\cf21 #ifdef TRACY_ON_DEMAND}\par
441         GetProfiler().DeferItem( *item );\par
442 {\cf21 #endif}\par
443         Profiler::QueueSerialFinish();\par
444     \}\par
