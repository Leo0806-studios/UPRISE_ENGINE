149             VK_FUNCTION_WRAPPER( vkQueueWaitIdle( queue ) );\par
150 \par
151             tcpu = Profiler::GetTime();\par
152             VK_FUNCTION_WRAPPER( vkGetQueryPoolResults( device, m_query, 0, 1, {\cf17 sizeof}( tgpu ), &tgpu, {\cf17 sizeof}( tgpu ), VK_QUERY_RESULT_64_BIT | VK_QUERY_RESULT_WAIT_BIT ) );\par
153 \par
154             VK_FUNCTION_WRAPPER( vkBeginCommandBuffer( cmdbuf, &beginInfo ) );\par
155             VK_FUNCTION_WRAPPER( vkCmdResetQueryPool( cmdbuf, m_query, 0, 1 ) );\par
156             VK_FUNCTION_WRAPPER( vkEndCommandBuffer( cmdbuf ) );\par
157             VK_FUNCTION_WRAPPER( vkQueueSubmit( queue, 1, &submitInfo, VK_NULL_HANDLE ) );\par
158             VK_FUNCTION_WRAPPER( vkQueueWaitIdle( queue ) );\par
159         \}\par
160         {\cf19 else}\par
161         \{\par
162             FindCalibratedTimestampDeviation();\par
163             Calibrate( device, m_prevCalibration, tgpu );\par
164             tcpu = Profiler::GetTime();\par
165         \}\par
