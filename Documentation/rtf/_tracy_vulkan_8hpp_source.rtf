228     {\cf18 void} Name( {\cf17 const} {\cf18 char}* name, uint16_t len )\par
229     \{\par
230         {\cf17 auto} ptr = ({\cf18 char}*)tracy_malloc( len );\par
231         memcpy( ptr, name, len );\par
232 \par
233         {\cf17 auto} item = Profiler::QueueSerial();\par
234         MemWrite( &item->hdr.type, QueueType::GpuContextName );\par
235         MemWrite( &item->gpuContextNameFat.context, m_context );\par
236         MemWrite( &item->gpuContextNameFat.ptr, (uint64_t)ptr );\par
237         MemWrite( &item->gpuContextNameFat.size, len );\par
238 {\cf21 #ifdef TRACY_ON_DEMAND}\par
239         GetProfiler().DeferItem( *item );\par
240 {\cf21 #endif}\par
241         Profiler::QueueSerialFinish();\par
242     \}\par
