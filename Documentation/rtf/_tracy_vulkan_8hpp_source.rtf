324     tracy_force_inline {\cf18 unsigned} {\cf18 int} NextQueryId()\par
325     \{\par
326         {\cf17 const} uint64_t {\cf18 id} = m_head.fetch_add(1, std::memory_order_relaxed);\par
327         {\cf19 return} {\cf18 id} % m_queryCount;\par
