244     {\cf18 void} Collect( VkCommandBuffer cmdbuf )\par
245     \{\par
246         ZoneScopedC( Color::Red4 );\par
247 \par
248         {\cf17 const} uint64_t head = m_head.load(std::memory_order_relaxed);\par
249         {\cf19 if}( m_tail == head ) {\cf19 return};\par
250 \par
251 {\cf21 #ifdef TRACY_ON_DEMAND}\par
252         {\cf19 if}( !GetProfiler().IsConnected() )\par
253         \{\par
254             VK_FUNCTION_WRAPPER( vkCmdResetQueryPool( cmdbuf, m_query, 0, m_queryCount ) );\par
255             m_tail = head;\par
256             m_oldCnt = 0;\par
257             int64_t tgpu;\par
258             {\cf19 if}( m_timeDomain != VK_TIME_DOMAIN_DEVICE_EXT ) Calibrate( m_device, m_prevCalibration, tgpu );\par
259             {\cf19 return};\par
260         \}\par
261 {\cf21 #endif}\par
262         assert( head > m_tail );\par
263         \par
264         {\cf17 const} {\cf18 unsigned} {\cf18 int} wrappedTail = ({\cf18 unsigned} int)( m_tail % m_queryCount );\par
265 \par
266         {\cf18 unsigned} {\cf18 int} cnt;\par
267         {\cf19 if}( m_oldCnt != 0 )\par
268         \{\par
269             cnt = m_oldCnt;\par
270             m_oldCnt = 0;\par
271         \}\par
272         {\cf19 else}\par
273         \{\par
274             cnt = ({\cf18 unsigned} int)( head - m_tail );\par
275             assert( cnt <= m_queryCount );\par
276             {\cf19 if}( wrappedTail + cnt > m_queryCount )\par
277             \{\par
278                 cnt = m_queryCount - wrappedTail;\par
279             \}\par
280         \}\par
281 \par
282 \par
283         {\cf19 if}( VK_FUNCTION_WRAPPER( vkGetQueryPoolResults( m_device, m_query, wrappedTail, cnt, {\cf17 sizeof}( int64_t ) * m_queryCount, m_res, {\cf17 sizeof}( int64_t ), VK_QUERY_RESULT_64_BIT ) == VK_NOT_READY ) )\par
284         \{\par
285             m_oldCnt = cnt;\par
286             {\cf19 return};\par
287         \}\par
288 \par
289         {\cf19 for}( {\cf18 unsigned} {\cf18 int} idx=0; idx<cnt; idx++ )\par
290         \{\par
291             {\cf17 auto} item = Profiler::QueueSerial();\par
292             MemWrite( &item->hdr.type, QueueType::GpuTime );\par
293             MemWrite( &item->gpuTime.gpuTime, m_res[idx] );\par
294             MemWrite( &item->gpuTime.queryId, uint16_t( wrappedTail + idx ) );\par
295             MemWrite( &item->gpuTime.context, m_context );\par
296             Profiler::QueueSerialFinish();\par
297         \}\par
298 \par
299         {\cf19 if}( m_timeDomain != VK_TIME_DOMAIN_DEVICE_EXT )\par
300         \{\par
301             int64_t tgpu, tcpu;\par
302             Calibrate( m_device, tcpu, tgpu );\par
303             {\cf17 const} {\cf17 auto} refCpu = Profiler::GetTime();\par
304             {\cf17 const} {\cf17 auto} delta = tcpu - m_prevCalibration;\par
305             {\cf19 if}( delta > 0 )\par
306             \{\par
307                 m_prevCalibration = tcpu;\par
308                 {\cf17 auto} item = Profiler::QueueSerial();\par
309                 MemWrite( &item->hdr.type, QueueType::GpuCalibration );\par
310                 MemWrite( &item->gpuCalibration.gpuTime, tgpu );\par
311                 MemWrite( &item->gpuCalibration.cpuTime, refCpu );\par
312                 MemWrite( &item->gpuCalibration.cpuDelta, delta );\par
313                 MemWrite( &item->gpuCalibration.context, m_context );\par
314                 Profiler::QueueSerialFinish();\par
315             \}\par
316         \}\par
317 \par
318         VK_FUNCTION_WRAPPER( vkCmdResetQueryPool( cmdbuf, m_query, wrappedTail, cnt ) );\par
319 \par
320         m_tail += cnt;\par
321     \}\par
