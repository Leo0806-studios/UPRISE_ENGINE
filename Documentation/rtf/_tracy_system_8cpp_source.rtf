195 TRACY_API {\cf17 const} {\cf18 char}* GetThreadName( uint32_t {\cf18 id} )\par
196 \{\par
197     {\cf17 static} {\cf18 char} buf[256];\par
198 {\cf21 #ifdef TRACY_ENABLE}\par
199     {\cf17 auto} ptr = GetThreadNameData().load( std::memory_order_relaxed );\par
200     {\cf19 while}( ptr )\par
201     \{\par
202         {\cf19 if}( ptr->id == {\cf18 id} )\par
203         \{\par
204             {\cf19 return} ptr->name;\par
205         \}\par
206         ptr = ptr->next;\par
207     \}\par
208 {\cf21 #endif}\par
209 \par
210 {\cf21 #if defined _WIN32}\par
211 {\cf21 # ifdef TRACY_UWP}\par
212    {\cf17 static} {\cf17 auto} _GetThreadDescription = &::GetThreadDescription;\par
213 {\cf21 # else}\par
214    {\cf17 static} {\cf17 auto} _GetThreadDescription = (t_GetThreadDescription)GetProcAddress( GetModuleHandleA( {\cf22 "kernel32.dll"} ), {\cf22 "GetThreadDescription"} );\par
215 {\cf21 # endif}\par
216     {\cf19 if}( _GetThreadDescription )\par
217     \{\par
218         {\cf17 auto} hnd = OpenThread( THREAD_QUERY_LIMITED_INFORMATION, FALSE, (DWORD){\cf18 id} );\par
219         {\cf19 if}( hnd != 0 )\par
220         \{\par
221             PWSTR tmp;\par
222             {\cf19 if}( SUCCEEDED( _GetThreadDescription( hnd, &tmp ) ) )\par
223             \{\par
224                 {\cf17 auto} ret = wcstombs( buf, tmp, 256 );\par
225                 CloseHandle( hnd );\par
226                 LocalFree( tmp );\par
227                 {\cf19 if}( ret != {\cf17 static_cast<}{\cf18 size_t}{\cf17 >}( -1 ) )\par
228                 \{\par
229                     {\cf19 return} buf;\par
230                 \}\par
231             \}\par
232         \}\par
233     \}\par
234 {\cf21 #elif defined __linux__}\par
235   {\cf18 int} cs, fd;\par
236   {\cf18 char} path[32];\par
237   snprintf( path, {\cf17 sizeof}( path ), {\cf22 "/proc/self/task/%d/comm"}, {\cf18 id} );\par
238   sprintf( buf, {\cf22 "%"} PRIu32, {\cf18 id} );\par
239 {\cf21 # ifndef __ANDROID__}\par
240    pthread_setcancelstate( PTHREAD_CANCEL_DISABLE, &cs );\par
241 {\cf21 # endif}\par
242   {\cf19 if} ( ( fd = open( path, O_RDONLY ) ) > 0) \{\par
243       {\cf18 int} len = read( fd, buf, 255 );\par
244       {\cf19 if}( len > 0 )\par
245       \{\par
246           buf[len] = 0;\par
247           {\cf19 if}( len > 1 && buf[len-1] == {\cf23 '\\n'} )\par
248           \{\par
249               buf[len-1] = 0;\par
250           \}\par
251       \}\par
252       close( fd );\par
253   \}\par
254 {\cf21 # ifndef __ANDROID__}\par
255    pthread_setcancelstate( cs, 0 );\par
256 {\cf21 # endif}\par
257   {\cf19 return} buf;\par
258 {\cf21 #endif}\par
259 \par
260   sprintf( buf, {\cf22 "%"} PRIu32, {\cf18 id} );\par
261   {\cf19 return} buf;\par
262 \}\par
