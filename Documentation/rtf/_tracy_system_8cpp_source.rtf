131 TRACY_API {\cf18 void} SetThreadName( {\cf17 const} {\cf18 char}* name )\par
132 \{\par
133 {\cf21 #if defined _WIN32}\par
134 {\cf21 #  ifdef TRACY_UWP}\par
135     {\cf17 static} {\cf17 auto} _SetThreadDescription = &::SetThreadDescription;\par
136 {\cf21 #  else}\par
137     {\cf17 static} {\cf17 auto} _SetThreadDescription = (t_SetThreadDescription)GetProcAddress( GetModuleHandleA( {\cf22 "kernel32.dll"} ), {\cf22 "SetThreadDescription"} );\par
138 {\cf21 #  endif}\par
139     {\cf19 if}( _SetThreadDescription )\par
140     \{\par
141         {\cf18 wchar_t} buf[256];\par
142         mbstowcs( buf, name, 256 );\par
143         _SetThreadDescription( GetCurrentThread(), buf );\par
144     \}\par
145     {\cf19 else}\par
146     \{\par
147 {\cf21 #  if defined _MSC_VER}\par
148         THREADNAME_INFO info;\par
149         info.dwType = 0x1000;\par
150         info.szName = name;\par
151         info.dwThreadID = GetCurrentThreadId();\par
152         info.dwFlags = 0;\par
153         ThreadNameMsvcMagic( info );\par
154 {\cf21 #  endif}\par
155     \}\par
156 {\cf21 #elif defined _GNU_SOURCE && !defined __EMSCRIPTEN__}\par
157     \{\par
158         {\cf17 const} {\cf17 auto} sz = strlen( name );\par
159         {\cf19 if}( sz <= 15 )\par
160         \{\par
161 {\cf21 #if defined __APPLE__}\par
162             pthread_setname_np( name );\par
163 {\cf21 #else}\par
164             pthread_setname_np( pthread_self(), name );\par
165 {\cf21 #endif}\par
166         \}\par
167         {\cf19 else}\par
168         \{\par
169             {\cf18 char} buf[16];\par
170             memcpy( buf, name, 15 );\par
171             buf[15] = {\cf23 '\\0'};\par
172 {\cf21 #if defined __APPLE__}\par
173             pthread_setname_np( buf );\par
174 {\cf21 #else}\par
175             pthread_setname_np( pthread_self(), buf );\par
176 {\cf21 #endif}\par
177         \}\par
178     \}\par
179 {\cf21 #endif}\par
180 {\cf21 #ifdef TRACY_ENABLE}\par
181     \{\par
182         {\cf17 const} {\cf17 auto} sz = strlen( name );\par
183         {\cf18 char}* buf = ({\cf18 char}*)tracy_malloc( sz+1 );\par
184         memcpy( buf, name, sz );\par
185         buf[sz] = {\cf23 '\\0'};\par
186         {\cf17 auto} data = (ThreadNameData*)tracy_malloc_fast( {\cf17 sizeof}( ThreadNameData ) );\par
187         data->id = detail::GetThreadHandleImpl();\par
188         data->name = buf;\par
189         data->next = GetThreadNameData().load( std::memory_order_relaxed );\par
190         {\cf19 while}( !GetThreadNameData().compare_exchange_weak( data->next, data, std::memory_order_release, std::memory_order_relaxed ) ) \{\}\par
191     \}\par
192 {\cf21 #endif}\par
193 \}\par
