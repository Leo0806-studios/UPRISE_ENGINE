264 TRACY_API {\cf17 const} {\cf18 char}* GetEnvVar( {\cf17 const} {\cf18 char}* name )\par
265 \{\par
266 {\cf21 #if defined _WIN32}\par
267     {\cf20 // unfortunately getenv() on Windows is just fundamentally broken.  It caches the entire}\par
268     {\cf20 // environment block once on startup, then never refreshes it again.  If any environment}\par
269     {\cf20 // strings are added or modified after startup of the CRT, those changes will not be}\par
270     {\cf20 // seen by getenv().  This removes the possibility of an app using this SDK from}\par
271     {\cf20 // programmatically setting any of the behaviour controlling envvars here.}\par
272     {\cf20 //}\par
273     {\cf20 // To work around this, we'll instead go directly to the Win32 environment strings APIs}\par
274     {\cf20 // to get the current value.}\par
275     {\cf17 static} {\cf18 char} buffer[1024];\par
276     DWORD {\cf17 const} kBufferSize = DWORD({\cf17 sizeof}(buffer) / {\cf17 sizeof}(buffer[0]));\par
277     DWORD count = GetEnvironmentVariableA(name, buffer, kBufferSize);\par
278 \par
279     {\cf19 if}( count == 0 )\par
280         {\cf19 return} {\cf17 nullptr};\par
281 \par
282     {\cf19 if}( count >= kBufferSize )\par
283     \{\par
284         {\cf18 char}* buf = {\cf17 reinterpret_cast<}{\cf18 char}*{\cf17 >}(_alloca(count + 1));\par
285         count = GetEnvironmentVariableA(name, buf, count + 1);\par
286         memcpy(buffer, buf, kBufferSize);\par
287         buffer[kBufferSize - 1] = 0;\par
288     \}\par
289 \par
290     {\cf19 return} buffer;\par
291 {\cf21 #else}\par
292     {\cf19 return} getenv(name);\par
293 {\cf21 #endif}\par
294 \}\par
