2435 {\cf20 //         contains extended operand description.  This dcl is currently not}\par
2436 {\cf20 //         extended.}\par
2437 {\cf20 //}\par
2438 {\cf20 // OpcodeToken0 is followed by 1 operand on Shader Models 4.0 through 5.0:}\par
