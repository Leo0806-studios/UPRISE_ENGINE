524 {\cf20 // ----------------------------------------------------------------------------}\par
525 {\cf20 // Extended Opcode Format (OpcodeToken1)}\par
526 {\cf20 //}\par
527 {\cf20 // If bit31 of an opcode token is set, the}\par
528 {\cf20 // opcode has an additional extended opcode token DWORD}\par
529 {\cf20 // directly following OpcodeToken0.  Other tokens}\par
530 {\cf20 // expected for the opcode, such as the operand}\par
531 {\cf20 // token(s) always follow}\par
532 {\cf20 // OpcodeToken0 AND OpcodeToken1..n (extended}\par
533 {\cf20 // opcode tokens, if present).}\par
534 {\cf20 //}\par
535 {\cf20 // [05:00] D3D10_SB_EXTENDED_OPCODE_TYPE}\par
536 {\cf20 // [30:06] if([05:00] == D3D10_SB_EXTENDED_OPCODE_SAMPLE_CONTROLS)}\par
537 {\cf20 //         \{}\par
538 {\cf20 //              This custom opcode contains controls for SAMPLE.}\par
539 {\cf20 //              [08:06] Ignored, 0.}\par
540 {\cf20 //              [12:09] U texel immediate offset (4 bit 2's comp) (0 default)}\par
541 {\cf20 //              [16:13] V texel immediate offset (4 bit 2's comp) (0 default)}\par
542 {\cf20 //              [20:17] W texel immediate offset (4 bit 2's comp) (0 default)}\par
543 {\cf20 //              [30:14] Ignored, 0.}\par
544 {\cf20 //         \}}\par
545 {\cf20 //         else if( [05:00] == D3D11_SB_EXTENDED_OPCODE_RESOURCE_DIM )}\par
546 {\cf20 //         \{}\par
547 {\cf20 //              [10:06] D3D10_SB_RESOURCE_DIMENSION}\par
548 {\cf20 //              [22:11] When dimension is D3D11_SB_RESOURCE_DIMENSION_STRUCTURED_BUFFER this holds the buffer stride, otherwise 0}\par
549 {\cf20 //              [30:23] Ignored, 0.}\par
550 {\cf20 //         \}}\par
551 {\cf20 //         else if( [05:00] == D3D11_SB_EXTENDED_OPCODE_RESOURCE_RETURN_TYPE )}\par
552 {\cf20 //         \{}\par
553 {\cf20 //              [09:06] D3D10_SB_RESOURCE_RETURN_TYPE for component X}\par
554 {\cf20 //              [13:10] D3D10_SB_RESOURCE_RETURN_TYPE for component Y}\par
555 {\cf20 //              [17:14] D3D10_SB_RESOURCE_RETURN_TYPE for component Z}\par
556 {\cf20 //              [21:18] D3D10_SB_RESOURCE_RETURN_TYPE for component W}\par
557 {\cf20 //              [30:22] Ignored, 0.}\par
558 {\cf20 //         \}}\par
559 {\cf20 //         else}\par
560 {\cf20 //         \{}\par
561 {\cf20 //              [30:04] Ignored, 0.}\par
562 {\cf20 //         \}}\par
563 {\cf20 // [31]    0 normally. 1 there is another extended opcode.  Any number}\par
564 {\cf20 //         of extended opcode tokens can be chained.  It is possible that some extended}\par
565 {\cf20 //         opcode tokens could include multiple DWORDS - that is defined}\par
566 {\cf20 //         on a case by case basis.}\par
567 {\cf20 //}\par
568 {\cf20 // ----------------------------------------------------------------------------}\par
