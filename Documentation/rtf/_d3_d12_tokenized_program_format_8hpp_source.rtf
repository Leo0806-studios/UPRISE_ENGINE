694 {\cf20 // ----------------------------------------------------------------------------}\par
695 {\cf20 // Instruction Operand Format (OperandToken0)}\par
696 {\cf20 //}\par
697 {\cf20 // [01:00] D3D10_SB_OPERAND_NUM_COMPONENTS}\par
698 {\cf20 // [11:02] Component Selection}\par
699 {\cf20 //         if([01:00] == D3D10_SB_OPERAND_0_COMPONENT)}\par
700 {\cf20 //              [11:02] = Ignored, 0}\par
701 {\cf20 //         else if([01:00] == D3D10_SB_OPERAND_1_COMPONENT}\par
702 {\cf20 //              [11:02] = Ignored, 0}\par
703 {\cf20 //         else if([01:00] == D3D10_SB_OPERAND_4_COMPONENT}\par
704 {\cf20 //         \{}\par
705 {\cf20 //              [03:02] = D3D10_SB_OPERAND_4_COMPONENT_SELECTION_MODE}\par
706 {\cf20 //              if([03:02] == D3D10_SB_OPERAND_4_COMPONENT_MASK_MODE)}\par
707 {\cf20 //              \{}\par
708 {\cf20 //                  [07:04] = D3D10_SB_OPERAND_4_COMPONENT_MASK}\par
709 {\cf20 //                  [11:08] = Ignored, 0}\par
710 {\cf20 //              \}}\par
711 {\cf20 //              else if([03:02] == D3D10_SB_OPERAND_4_COMPONENT_SWIZZLE_MODE)}\par
712 {\cf20 //              \{}\par
713 {\cf20 //                  [11:04] = D3D10_SB_4_COMPONENT_SWIZZLE}\par
714 {\cf20 //              \}}\par
715 {\cf20 //              else if([03:02] == D3D10_SB_OPERAND_4_COMPONENT_SELECT_1_MODE)}\par
716 {\cf20 //              \{}\par
717 {\cf20 //                  [05:04] = D3D10_SB_4_COMPONENT_NAME}\par
718 {\cf20 //                  [11:06] = Ignored, 0}\par
719 {\cf20 //              \}}\par
720 {\cf20 //         \}}\par
721 {\cf20 //         else if([01:00] == D3D10_SB_OPERAND_N_COMPONENT)}\par
722 {\cf20 //         \{}\par
723 {\cf20 //              Currently not defined.}\par
724 {\cf20 //         \}}\par
725 {\cf20 // [19:12] D3D10_SB_OPERAND_TYPE}\par
726 {\cf20 // [21:20] D3D10_SB_OPERAND_INDEX_DIMENSION:}\par
727 {\cf20 //            Number of dimensions in the register}\par
728 {\cf20 //            file (NOT the # of dimensions in the}\par
729 {\cf20 //            individual register or memory}\par
730 {\cf20 //            resource being referenced).}\par
731 {\cf20 // [24:22] if( [21:20] >= D3D10_SB_OPERAND_INDEX_1D )}\par
732 {\cf20 //             D3D10_SB_OPERAND_INDEX_REPRESENTATION for first operand index}\par
733 {\cf20 //         else}\par
734 {\cf20 //             Ignored, 0}\par
735 {\cf20 // [27:25] if( [21:20] >= D3D10_SB_OPERAND_INDEX_2D )}\par
736 {\cf20 //             D3D10_SB_OPERAND_INDEX_REPRESENTATION for second operand index}\par
737 {\cf20 //         else}\par
738 {\cf20 //             Ignored, 0}\par
739 {\cf20 // [30:28] if( [21:20] == D3D10_SB_OPERAND_INDEX_3D )}\par
740 {\cf20 //             D3D10_SB_OPERAND_INDEX_REPRESENTATION for third operand index}\par
741 {\cf20 //         else}\par
742 {\cf20 //             Ignored, 0}\par
743 {\cf20 // [31]    0 normally. 1 if extended operand definition, meaning next DWORD}\par
744 {\cf20 //         contains extended operand description.}\par
745 {\cf20 //}\par
746 {\cf20 // ----------------------------------------------------------------------------}\par
747 \par
