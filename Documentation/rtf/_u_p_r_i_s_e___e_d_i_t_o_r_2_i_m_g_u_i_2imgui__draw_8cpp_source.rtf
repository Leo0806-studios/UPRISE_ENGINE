02190 {\cf20 // Important: 'out_list' is generally going to be draw_data->CmdLists, but may be another temporary list}\par
02191 {\cf20 // as long at it is expected that the result will be later merged into draw_data->CmdLists[].}\par
02192 {\cf18 void} ImGui::AddDrawListToDrawDataEx(ImDrawData* draw_data, ImVector<ImDrawList*>* out_list, ImDrawList* draw_list)\par
02193 \{\par
02194     {\cf19 if} (draw_list->CmdBuffer.Size == 0)\par
02195         {\cf19 return};\par
02196     {\cf19 if} (draw_list->CmdBuffer.Size == 1 && draw_list->CmdBuffer[0].ElemCount == 0 && draw_list->CmdBuffer[0].UserCallback == NULL)\par
02197         {\cf19 return};\par
02198 \par
02199     {\cf20 // Draw list sanity check. Detect mismatch between PrimReserve() calls and incrementing _VtxCurrentIdx, _VtxWritePtr etc.}\par
02200     {\cf20 // May trigger for you if you are using PrimXXX functions incorrectly.}\par
02201     IM_ASSERT(draw_list->VtxBuffer.Size == 0 || draw_list->_VtxWritePtr == draw_list->VtxBuffer.Data + draw_list->VtxBuffer.Size);\par
02202     IM_ASSERT(draw_list->IdxBuffer.Size == 0 || draw_list->_IdxWritePtr == draw_list->IdxBuffer.Data + draw_list->IdxBuffer.Size);\par
02203     {\cf19 if} (!(draw_list->Flags & ImDrawListFlags_AllowVtxOffset))\par
02204         IM_ASSERT(({\cf18 int})draw_list->_VtxCurrentIdx == draw_list->VtxBuffer.Size);\par
02205 \par
02206     {\cf20 // Check that draw_list doesn't use more vertices than indexable (default ImDrawIdx = unsigned short = 2 bytes = 64K vertices per ImDrawList = per window)}\par
02207     {\cf20 // If this assert triggers because you are drawing lots of stuff manually:}\par
02208     {\cf20 // - First, make sure you are coarse clipping yourself and not trying to draw many things outside visible bounds.}\par
02209     {\cf20 //   Be mindful that the lower-level ImDrawList API doesn't filter vertices. Use the Metrics/Debugger window to inspect draw list contents.}\par
02210     {\cf20 // - If you want large meshes with more than 64K vertices, you can either:}\par
02211     {\cf20 //   (A) Handle the ImDrawCmd::VtxOffset value in your renderer backend, and set 'io.BackendFlags |= ImGuiBackendFlags_RendererHasVtxOffset'.}\par
02212     {\cf20 //       Most example backends already support this from 1.71. Pre-1.71 backends won't.}\par
02213     {\cf20 //       Some graphics API such as GL ES 1/2 don't have a way to offset the starting vertex so it is not supported for them.}\par
02214     {\cf20 //   (B) Or handle 32-bit indices in your renderer backend, and uncomment '#define ImDrawIdx unsigned int' line in imconfig.h.}\par
02215     {\cf20 //       Most example backends already support this. For example, the OpenGL example code detect index size at compile-time:}\par
02216     {\cf20 //         glDrawElements(GL_TRIANGLES, (GLsizei)pcmd->ElemCount, sizeof(ImDrawIdx) == 2 ? GL_UNSIGNED_SHORT : GL_UNSIGNED_INT, idx_buffer_offset);}\par
02217     {\cf20 //       Your own engine or render API may use different parameters or function calls to specify index sizes.}\par
02218     {\cf20 //       2 and 4 bytes indices are generally supported by most graphics API.}\par
02219     {\cf20 // - If for some reason neither of those solutions works for you, a workaround is to call BeginChild()/EndChild() before reaching}\par
02220     {\cf20 //   the 64K limit to split your draw commands in multiple draw lists.}\par
02221     {\cf19 if} ({\cf17 sizeof}(ImDrawIdx) == 2)\par
02222         IM_ASSERT(draw_list->_VtxCurrentIdx < (1 << 16) && {\cf22 "Too many vertices in ImDrawList using 16-bit indices. Read comment above"});\par
02223 \par
02224     {\cf20 // Add to output list + records state in ImDrawData}\par
02225     out_list->push_back(draw_list);\par
02226     draw_data->CmdListsCount++;\par
02227     draw_data->TotalVtxCount += draw_list->VtxBuffer.Size;\par
02228     draw_data->TotalIdxCount += draw_list->IdxBuffer.Size;\par
02229 \}\par
