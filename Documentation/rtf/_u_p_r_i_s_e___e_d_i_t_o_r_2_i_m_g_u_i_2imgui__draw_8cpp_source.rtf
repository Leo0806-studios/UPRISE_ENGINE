00588 {\cf20 // Render-level scissoring. This is passed down to your render function but not used for CPU-side coarse clipping. Prefer using higher-level ImGui::PushClipRect() to affect logic (hit-testing and widget culling)}\par
00589 {\cf18 void} ImDrawList::PushClipRect({\cf17 const} ImVec2& cr_min, {\cf17 const} ImVec2& cr_max, {\cf18 bool} intersect_with_current_clip_rect)\par
00590 \{\par
00591     ImVec4 cr(cr_min.x, cr_min.y, cr_max.x, cr_max.y);\par
00592     {\cf19 if} (intersect_with_current_clip_rect)\par
00593     \{\par
00594         ImVec4 current = _CmdHeader.ClipRect;\par
00595         {\cf19 if} (cr.x < current.x) cr.x = current.x;\par
00596         {\cf19 if} (cr.y < current.y) cr.y = current.y;\par
00597         {\cf19 if} (cr.z > current.z) cr.z = current.z;\par
00598         {\cf19 if} (cr.w > current.w) cr.w = current.w;\par
00599     \}\par
00600     cr.z = ImMax(cr.x, cr.z);\par
00601     cr.w = ImMax(cr.y, cr.w);\par
00602 \par
00603     _ClipRectStack.push_back(cr);\par
00604     _CmdHeader.ClipRect = cr;\par
00605     _OnChangedClipRect();\par
00606 \}\par
