04021 {\cf18 void} ImFont::RenderText(ImDrawList* draw_list, {\cf18 float} size, {\cf17 const} ImVec2& pos, ImU32 col, {\cf17 const} ImVec4& clip_rect, {\cf17 const} {\cf18 char}* text_begin, {\cf17 const} {\cf18 char}* text_end, {\cf18 float} wrap_width, {\cf18 bool} cpu_fine_clip){\cf17  const}\par
04022 {\cf17 }\{\par
04023     {\cf19 if} (!text_end)\par
04024         text_end = text_begin + strlen(text_begin); {\cf20 // ImGui:: functions generally already provides a valid text_end, so this is merely to handle direct calls.}\par
04025 \par
