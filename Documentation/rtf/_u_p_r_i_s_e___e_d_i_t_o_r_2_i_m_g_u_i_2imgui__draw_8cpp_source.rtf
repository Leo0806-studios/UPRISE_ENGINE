03110 {\cf18 void} ImFontAtlasBuildRender32bppRectFromString(ImFontAtlas* atlas, {\cf18 int} x, {\cf18 int} y, {\cf18 int} w, {\cf18 int} h, {\cf17 const} {\cf18 char}* in_str, {\cf18 char} in_marker_char, {\cf18 unsigned} {\cf18 int} in_marker_pixel_value)\par
03111 \{\par
03112     IM_ASSERT(x >= 0 && x + w <= atlas->TexWidth);\par
03113     IM_ASSERT(y >= 0 && y + h <= atlas->TexHeight);\par
03114     {\cf18 unsigned} {\cf18 int}* out_pixel = atlas->TexPixelsRGBA32 + x + (y * atlas->TexWidth);\par
03115     {\cf19 for} ({\cf18 int} off_y = 0; off_y < h; off_y++, out_pixel += atlas->TexWidth, in_str += w)\par
03116         {\cf19 for} ({\cf18 int} off_x = 0; off_x < w; off_x++)\par
03117             out_pixel[off_x] = (in_str[off_x] == in_marker_char) ? in_marker_pixel_value : IM_COL32_BLACK_TRANS;\par
