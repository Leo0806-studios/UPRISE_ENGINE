03734 {\cf20 // x0/y0/x1/y1 are offset from the character upper-left layout position, in pixels. Therefore x0/y0 are often fairly close to zero.}\par
03735 {\cf20 // Not to be mistaken with texture coordinates, which are held by u0/v0/u1/v1 in normalized format (0.0..1.0 on each texture axis).}\par
03736 {\cf20 // 'cfg' is not necessarily == 'this->ConfigData' because multiple source fonts+configs can be used to build one target font.}\par
03737 {\cf18 void} ImFont::AddGlyph({\cf17 const} ImFontConfig* cfg, ImWchar codepoint, {\cf18 float} x0, {\cf18 float} y0, {\cf18 float} x1, {\cf18 float} y1, {\cf18 float} u0, {\cf18 float} v0, {\cf18 float} u1, {\cf18 float} v1, {\cf18 float} advance_x)\par
03738 \{\par
03739     {\cf19 if} (cfg != NULL)\par
03740     \{\par
03741         {\cf20 // Clamp & recenter if needed}\par
03742         {\cf17 const} {\cf18 float} advance_x_original = advance_x;\par
03743         advance_x = ImClamp(advance_x, cfg->GlyphMinAdvanceX, cfg->GlyphMaxAdvanceX);\par
03744         {\cf19 if} (advance_x != advance_x_original)\par
03745         \{\par
03746             {\cf18 float} char_off_x = cfg->PixelSnapH ? ImTrunc((advance_x - advance_x_original) * 0.5f) : (advance_x - advance_x_original) * 0.5f;\par
03747             x0 += char_off_x;\par
03748             x1 += char_off_x;\par
03749         \}\par
03750 \par
03751         {\cf20 // Snap to pixel}\par
03752         {\cf19 if} (cfg->PixelSnapH)\par
03753             advance_x = IM_ROUND(advance_x);\par
03754 \par
03755         {\cf20 // Bake spacing}\par
03756         advance_x += cfg->GlyphExtraSpacing.x;\par
03757     \}\par
03758 \par
03759     Glyphs.resize(Glyphs.Size + 1);\par
03760     ImFontGlyph& glyph = Glyphs.back();\par
03761     glyph.Codepoint = ({\cf18 unsigned} int)codepoint;\par
03762     glyph.Visible = (x0 != x1) && (y0 != y1);\par
03763     glyph.Colored = {\cf17 false};\par
03764     glyph.X0 = x0;\par
03765     glyph.Y0 = y0;\par
03766     glyph.X1 = x1;\par
03767     glyph.Y1 = y1;\par
03768     glyph.U0 = u0;\par
03769     glyph.V0 = v0;\par
03770     glyph.U1 = u1;\par
03771     glyph.V1 = v1;\par
03772     glyph.AdvanceX = advance_x;\par
03773 \par
