03725 {\cf18 void} ImFont::GrowIndex({\cf18 int} new_size)\par
03726 \{\par
03727     IM_ASSERT(IndexAdvanceX.Size == IndexLookup.Size);\par
03728     {\cf19 if} (new_size <= IndexLookup.Size)\par
03729         {\cf19 return};\par
03730     IndexAdvanceX.resize(new_size, -1.0f);\par
03731     IndexLookup.resize(new_size, (ImWchar)-1);\par
03732 \}\par
