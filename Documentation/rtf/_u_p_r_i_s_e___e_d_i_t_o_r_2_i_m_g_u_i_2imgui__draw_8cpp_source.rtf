02271 {\cf20 // Generic linear color gradient, write to RGB fields, leave A untouched.}\par
02272 {\cf18 void} ImGui::ShadeVertsLinearColorGradientKeepAlpha(ImDrawList* draw_list, {\cf18 int} vert_start_idx, {\cf18 int} vert_end_idx, ImVec2 gradient_p0, ImVec2 gradient_p1, ImU32 col0, ImU32 col1)\par
02273 \{\par
02274     ImVec2 gradient_extent = gradient_p1 - gradient_p0;\par
02275     {\cf18 float} gradient_inv_length2 = 1.0f / ImLengthSqr(gradient_extent);\par
02276     ImDrawVert* vert_start = draw_list->VtxBuffer.Data + vert_start_idx;\par
02277     ImDrawVert* vert_end = draw_list->VtxBuffer.Data + vert_end_idx;\par
02278     {\cf17 const} {\cf18 int} col0_r = (int)(col0 >> IM_COL32_R_SHIFT) & 0xFF;\par
02279     {\cf17 const} {\cf18 int} col0_g = (int)(col0 >> IM_COL32_G_SHIFT) & 0xFF;\par
02280     {\cf17 const} {\cf18 int} col0_b = (int)(col0 >> IM_COL32_B_SHIFT) & 0xFF;\par
02281     {\cf17 const} {\cf18 int} col_delta_r = ((int)(col1 >> IM_COL32_R_SHIFT) & 0xFF) - col0_r;\par
02282     {\cf17 const} {\cf18 int} col_delta_g = ((int)(col1 >> IM_COL32_G_SHIFT) & 0xFF) - col0_g;\par
02283     {\cf17 const} {\cf18 int} col_delta_b = ((int)(col1 >> IM_COL32_B_SHIFT) & 0xFF) - col0_b;\par
02284     {\cf19 for} (ImDrawVert* vert = vert_start; vert < vert_end; vert++)\par
02285     \{\par
02286         {\cf18 float} d = ImDot(vert->pos - gradient_p0, gradient_extent);\par
02287         {\cf18 float} t = ImClamp(d * gradient_inv_length2, 0.0f, 1.0f);\par
02288         {\cf18 int} r = (int)(col0_r + col_delta_r * t);\par
02289         {\cf18 int} g = (int)(col0_g + col_delta_g * t);\par
02290         {\cf18 int} b = (int)(col0_b + col_delta_b * t);\par
02291         vert->col = (r << IM_COL32_R_SHIFT) | (g << IM_COL32_G_SHIFT) | (b << IM_COL32_B_SHIFT) | (vert->col & IM_COL32_A_MASK);\par
02292     \}\par
02293 \}\par
02294 \par
02295 {\cf20 // Distribute UV over (a, b) rectangle}\par
02296 {\cf18 void} ImGui::ShadeVertsLinearUV(ImDrawList* draw_list, {\cf18 int} vert_start_idx, {\cf18 int} vert_end_idx, {\cf17 const} ImVec2& a, {\cf17 const} ImVec2& b, {\cf17 const} ImVec2& uv_a, {\cf17 const} ImVec2& uv_b, {\cf18 bool} clamp)\par
02297 \{\par
02298     {\cf17 const} ImVec2 size = b - a;\par
02299     {\cf17 const} ImVec2 uv_size = uv_b - uv_a;\par
02300     {\cf17 const} ImVec2 scale = ImVec2(\par
02301         size.x != 0.0f ? (uv_size.x / size.x) : 0.0f,\par
02302         size.y != 0.0f ? (uv_size.y / size.y) : 0.0f);\par
02303 \par
02304     ImDrawVert* vert_start = draw_list->VtxBuffer.Data + vert_start_idx;\par
02305     ImDrawVert* vert_end = draw_list->VtxBuffer.Data + vert_end_idx;\par
02306     {\cf19 if} (clamp)\par
02307     \{\par
02308         {\cf17 const} ImVec2 min = ImMin(uv_a, uv_b);\par
02309         {\cf17 const} ImVec2 max = ImMax(uv_a, uv_b);\par
02310         {\cf19 for} (ImDrawVert* vertex = vert_start; vertex < vert_end; ++vertex)\par
02311             vertex->uv = ImClamp(uv_a + ImMul(ImVec2(vertex->pos.x, vertex->pos.y) - a, scale), min, max);\par
02312     \}\par
02313     {\cf19 else}\par
02314     \{\par
02315         {\cf19 for} (ImDrawVert* vertex = vert_start; vertex < vert_end; ++vertex)\par
02316             vertex->uv = uv_a + ImMul(ImVec2(vertex->pos.x, vertex->pos.y) - a, scale);\par
02317     \}\par
02318 \}\par
02319 \par
02320 {\cf18 void} ImGui::ShadeVertsTransformPos(ImDrawList* draw_list, {\cf18 int} vert_start_idx, {\cf18 int} vert_end_idx, {\cf17 const} ImVec2& pivot_in, {\cf18 float} cos_a, {\cf18 float} sin_a, {\cf17 const} ImVec2& pivot_out)\par
02321 \{\par
02322     ImDrawVert* vert_start = draw_list->VtxBuffer.Data + vert_start_idx;\par
02323     ImDrawVert* vert_end = draw_list->VtxBuffer.Data + vert_end_idx;\par
02324     {\cf19 for} (ImDrawVert* vertex = vert_start; vertex < vert_end; ++vertex)\par
02325         vertex->pos = ImRotate(vertex->pos- pivot_in, cos_a, sin_a) + pivot_out;\par
02326 \}\par
