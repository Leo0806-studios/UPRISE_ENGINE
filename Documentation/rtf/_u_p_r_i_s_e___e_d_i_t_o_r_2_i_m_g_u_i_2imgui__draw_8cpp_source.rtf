01721 {\cf20 //-----------------------------------------------------------------------------}\par
01722 {\cf20 // [SECTION] ImTriangulator, ImDrawList concave polygon fill}\par
01723 {\cf20 //-----------------------------------------------------------------------------}\par
01724 {\cf20 // Triangulate concave polygons. Based on "Triangulation by Ear Clipping" paper, O(N^2) complexity.}\par
01725 {\cf20 // Reference: https://www.geometrictools.com/Documentation/TriangulationByEarClipping.pdf}\par
01726 {\cf20 // Provided as a convenience for user but not used by main library.}\par
01727 {\cf20 //-----------------------------------------------------------------------------}\par
01728 {\cf20 // - ImTriangulator [Internal]}\par
01729 {\cf20 // - AddConcavePolyFilled()}\par
01730 {\cf20 //-----------------------------------------------------------------------------}\par
01731 \par
01732 {\cf17 enum} ImTriangulatorNodeType\par
01733 \{\par
01734     ImTriangulatorNodeType_Convex,\par
01735     ImTriangulatorNodeType_Ear,\par
01736     ImTriangulatorNodeType_Reflex\par
01737 \};\par
01738 \par
01739 {\cf17 struct }ImTriangulatorNode\par
01740 \{\par
01741     ImTriangulatorNodeType  Type;\par
01742     {\cf18 int}                     Index;\par
01743     ImVec2                  Pos;\par
01744     ImTriangulatorNode*     Next;\par
01745     ImTriangulatorNode*     Prev;\par
01746 \par
01747     {\cf18 void}    Unlink()        \{ Next->Prev = Prev; Prev->Next = Next; \}\par
01748 \};\par
01749 \par
01750 {\cf17 struct }ImTriangulatorNodeSpan\par
01751 \{\par
01752     ImTriangulatorNode**    Data = NULL;\par
01753     {\cf18 int}                     Size = 0;\par
01754 \par
01755     {\cf18 void}    push_back(ImTriangulatorNode* node) \{ Data[Size++] = node; \}\par
01756     {\cf18 void}    find_erase_unsorted({\cf18 int} idx)        \{ {\cf19 for} ({\cf18 int} i = Size - 1; i >= 0; i--) {\cf19 if} (Data[i]->Index == idx) \{ Data[i] = Data[Size - 1]; Size--; {\cf19 return}; \} \}\par
01757 \};\par
01758 \par
01759 {\cf17 struct }ImTriangulator\par
01760 \{\par
01761     {\cf17 static} {\cf18 int} EstimateTriangleCount({\cf18 int} points_count)      \{ {\cf19 return} (points_count < 3) ? 0 : points_count - 2; \}\par
01762     {\cf17 static} {\cf18 int} EstimateScratchBufferSize({\cf18 int} points_count)  \{ {\cf19 return} {\cf17 sizeof}(ImTriangulatorNode) * points_count + {\cf17 sizeof}(ImTriangulatorNode*) * points_count * 2; \}\par
01763 \par
01764     {\cf18 void}    Init({\cf17 const} ImVec2* points, {\cf18 int} points_count, {\cf18 void}* scratch_buffer);\par
01765     {\cf18 void}    GetNextTriangle({\cf18 unsigned} {\cf18 int} out_triangle[3]);     {\cf20 // Return relative indexes for next triangle}\par
01766 \par
01767     {\cf20 // Internal functions}\par
01768     {\cf18 void}    BuildNodes({\cf17 const} ImVec2* points, {\cf18 int} points_count);\par
01769     {\cf18 void}    BuildReflexes();\par
01770     {\cf18 void}    BuildEars();\par
01771     {\cf18 void}    FlipNodeList();\par
01772     {\cf18 bool}    IsEar({\cf18 int} i0, {\cf18 int} i1, {\cf18 int} i2, {\cf17 const} ImVec2& v0, {\cf17 const} ImVec2& v1, {\cf17 const} ImVec2& v2) {\cf17 const};\par
01773     {\cf18 void}    ReclassifyNode(ImTriangulatorNode* node);\par
01774 \par
01775     {\cf20 // Internal members}\par
01776     {\cf18 int}                     _TrianglesLeft = 0;\par
01777     ImTriangulatorNode*     _Nodes = NULL;\par
01778     ImTriangulatorNodeSpan  _Ears;\par
01779     ImTriangulatorNodeSpan  _Reflexes;\par
01780 \};\par
01781 \par
01782 {\cf20 // Distribute storage for nodes, ears and reflexes.}\par
01783 {\cf20 // FIXME-OPT: if everything is convex, we could report it to caller and let it switch to an convex renderer}\par
01784 {\cf20 // (this would require first building reflexes to bail to convex if empty, without even building nodes)}\par
01785 {\cf18 void} ImTriangulator::Init({\cf17 const} ImVec2* points, {\cf18 int} points_count, {\cf18 void}* scratch_buffer)\par
01786 \{\par
01787     IM_ASSERT(scratch_buffer != NULL && points_count >= 3);\par
01788     _TrianglesLeft = EstimateTriangleCount(points_count);\par
01789     _Nodes         = (ImTriangulatorNode*)scratch_buffer;                          {\cf20 // points_count x Node}\par
01790     _Ears.Data     = (ImTriangulatorNode**)(_Nodes + points_count);                {\cf20 // points_count x Node*}\par
01791     _Reflexes.Data = (ImTriangulatorNode**)(_Nodes + points_count) + points_count; {\cf20 // points_count x Node*}\par
01792     BuildNodes(points, points_count);\par
01793     BuildReflexes();\par
01794     BuildEars();\par
01795 \}\par
01796 \par
01797 {\cf18 void} ImTriangulator::BuildNodes({\cf17 const} ImVec2* points, {\cf18 int} points_count)\par
01798 \{\par
01799     {\cf19 for} ({\cf18 int} i = 0; i < points_count; i++)\par
01800     \{\par
01801         _Nodes[i].Type = ImTriangulatorNodeType_Convex;\par
01802         _Nodes[i].Index = i;\par
01803         _Nodes[i].Pos = points[i];\par
01804         _Nodes[i].Next = _Nodes + i + 1;\par
01805         _Nodes[i].Prev = _Nodes + i - 1;\par
01806     \}\par
01807     _Nodes[0].Prev = _Nodes + points_count - 1;\par
01808     _Nodes[points_count - 1].Next = _Nodes;\par
01809 \}\par
01810 \par
01811 {\cf18 void} ImTriangulator::BuildReflexes()\par
01812 \{\par
01813     ImTriangulatorNode* n1 = _Nodes;\par
01814     {\cf19 for} ({\cf18 int} i = _TrianglesLeft; i >= 0; i--, n1 = n1->Next)\par
01815     \{\par
01816         {\cf19 if} (ImTriangleIsClockwise(n1->Prev->Pos, n1->Pos, n1->Next->Pos))\par
01817             {\cf19 continue};\par
01818         n1->Type = ImTriangulatorNodeType_Reflex;\par
01819         _Reflexes.push_back(n1);\par
01820     \}\par
01821 \}\par
01822 \par
01823 {\cf18 void} ImTriangulator::BuildEars()\par
01824 \{\par
01825     ImTriangulatorNode* n1 = _Nodes;\par
01826     {\cf19 for} ({\cf18 int} i = _TrianglesLeft; i >= 0; i--, n1 = n1->Next)\par
01827     \{\par
01828         {\cf19 if} (n1->Type != ImTriangulatorNodeType_Convex)\par
01829             {\cf19 continue};\par
01830         {\cf19 if} (!IsEar(n1->Prev->Index, n1->Index, n1->Next->Index, n1->Prev->Pos, n1->Pos, n1->Next->Pos))\par
01831             {\cf19 continue};\par
01832         n1->Type = ImTriangulatorNodeType_Ear;\par
01833         _Ears.push_back(n1);\par
01834     \}\par
01835 \}\par
01836 \par
01837 {\cf18 void} ImTriangulator::GetNextTriangle({\cf18 unsigned} {\cf18 int} out_triangle[3])\par
01838 \{\par
01839     {\cf19 if} (_Ears.Size == 0)\par
01840     \{\par
01841         FlipNodeList();\par
01842 \par
01843         ImTriangulatorNode* node = _Nodes;\par
01844         {\cf19 for} ({\cf18 int} i = _TrianglesLeft; i >= 0; i--, node = node->Next)\par
01845             node->Type = ImTriangulatorNodeType_Convex;\par
01846         _Reflexes.Size = 0;\par
01847         BuildReflexes();\par
01848         BuildEars();\par
01849 \par
01850         {\cf20 // If we still don't have ears, it means geometry is degenerated.}\par
01851         {\cf19 if} (_Ears.Size == 0)\par
01852         \{\par
01853             {\cf20 // Return first triangle available, mimicking the behavior of convex fill.}\par
01854             IM_ASSERT(_TrianglesLeft > 0); {\cf20 // Geometry is degenerated}\par
01855             _Ears.Data[0] = _Nodes;\par
01856             _Ears.Size    = 1;\par
01857         \}\par
01858     \}\par
01859 \par
01860     ImTriangulatorNode* ear = _Ears.Data[--_Ears.Size];\par
01861     out_triangle[0] = ear->Prev->Index;\par
01862     out_triangle[1] = ear->Index;\par
01863     out_triangle[2] = ear->Next->Index;\par
01864 \par
01865     ear->Unlink();\par
01866     {\cf19 if} (ear == _Nodes)\par
01867         _Nodes = ear->Next;\par
01868 \par
01869     ReclassifyNode(ear->Prev);\par
01870     ReclassifyNode(ear->Next);\par
01871     _TrianglesLeft--;\par
01872 \}\par
01873 \par
01874 {\cf18 void} ImTriangulator::FlipNodeList()\par
01875 \{\par
01876     ImTriangulatorNode* prev = _Nodes;\par
01877     ImTriangulatorNode* temp = _Nodes;\par
01878     ImTriangulatorNode* current = _Nodes->Next;\par
01879     prev->Next = prev;\par
01880     prev->Prev = prev;\par
01881     {\cf19 while} (current != _Nodes)\par
01882     \{\par
01883         temp = current->Next;\par
01884 \par
01885         current->Next = prev;\par
01886         prev->Prev = current;\par
01887         _Nodes->Next = current;\par
01888         current->Prev = _Nodes;\par
01889 \par
01890         prev = current;\par
01891         current = temp;\par
01892     \}\par
01893     _Nodes = prev;\par
01894 \}\par
01895 \par
01896 {\cf20 // A triangle is an ear is no other vertex is inside it. We can test reflexes vertices only (see reference algorithm)}\par
01897 {\cf18 bool} ImTriangulator::IsEar({\cf18 int} i0, {\cf18 int} i1, {\cf18 int} i2, {\cf17 const} ImVec2& v0, {\cf17 const} ImVec2& v1, {\cf17 const} ImVec2& v2){\cf17  const}\par
01898 {\cf17 }\{\par
01899     ImTriangulatorNode** p_end = _Reflexes.Data + _Reflexes.Size;\par
01900     {\cf19 for} (ImTriangulatorNode** p = _Reflexes.Data; p < p_end; p++)\par
01901     \{\par
01902         ImTriangulatorNode* reflex = *p;\par
01903         {\cf19 if} (reflex->Index != i0 && reflex->Index != i1 && reflex->Index != i2)\par
01904             {\cf19 if} (ImTriangleContainsPoint(v0, v1, v2, reflex->Pos))\par
01905                 {\cf19 return} {\cf17 false};\par
01906     \}\par
01907     {\cf19 return} {\cf17 true};\par
01908 \}\par
01909 \par
01910 {\cf18 void} ImTriangulator::ReclassifyNode(ImTriangulatorNode* n1)\par
01911 \{\par
01912     {\cf20 // Classify node}\par
01913     ImTriangulatorNodeType type;\par
01914     {\cf17 const} ImTriangulatorNode* n0 = n1->Prev;\par
01915     {\cf17 const} ImTriangulatorNode* n2 = n1->Next;\par
01916     {\cf19 if} (!ImTriangleIsClockwise(n0->Pos, n1->Pos, n2->Pos))\par
01917         type = ImTriangulatorNodeType_Reflex;\par
01918     {\cf19 else} {\cf19 if} (IsEar(n0->Index, n1->Index, n2->Index, n0->Pos, n1->Pos, n2->Pos))\par
01919         type = ImTriangulatorNodeType_Ear;\par
01920     {\cf19 else}\par
01921         type = ImTriangulatorNodeType_Convex;\par
01922 \par
01923     {\cf20 // Update lists when a type changes}\par
01924     {\cf19 if} (type == n1->Type)\par
01925         {\cf19 return};\par
01926     {\cf19 if} (n1->Type == ImTriangulatorNodeType_Reflex)\par
01927         _Reflexes.find_erase_unsorted(n1->Index);\par
01928     {\cf19 else} {\cf19 if} (n1->Type == ImTriangulatorNodeType_Ear)\par
01929         _Ears.find_erase_unsorted(n1->Index);\par
01930     {\cf19 if} (type == ImTriangulatorNodeType_Reflex)\par
01931         _Reflexes.push_back(n1);\par
01932     {\cf19 else} {\cf19 if} (type == ImTriangulatorNodeType_Ear)\par
01933         _Ears.push_back(n1);\par
01934     n1->Type = type;\par
01935 \}\par
01936 \par
01937 {\cf20 // Use ear-clipping algorithm to triangulate a simple polygon (no self-interaction, no holes).}\par
01938 {\cf20 // (Reminder: we don't perform any coarse clipping/culling in ImDrawList layer!}\par
01939 {\cf20 // It is up to caller to ensure not making costly calls that will be outside of visible area.}\par
01940 {\cf20 // As concave fill is noticeably more expensive than other primitives, be mindful of this...}\par
01941 {\cf20 // Caller can build AABB of points, and avoid filling if 'draw_list->_CmdHeader.ClipRect.Overlays(points_bb) == false')}\par
01942 {\cf18 void} ImDrawList::AddConcavePolyFilled({\cf17 const} ImVec2* points, {\cf17 const} {\cf18 int} points_count, ImU32 col)\par
01943 \{\par
01944     {\cf19 if} (points_count < 3 || (col & IM_COL32_A_MASK) == 0)\par
01945         {\cf19 return};\par
01946 \par
01947     {\cf17 const} ImVec2 uv = _Data->TexUvWhitePixel;\par
01948     ImTriangulator triangulator;\par
01949     {\cf18 unsigned} {\cf18 int} triangle[3];\par
01950     {\cf19 if} (Flags & ImDrawListFlags_AntiAliasedFill)\par
01951     \{\par
01952         {\cf20 // Anti-aliased Fill}\par
01953         {\cf17 const} {\cf18 float} AA_SIZE = _FringeScale;\par
01954         {\cf17 const} ImU32 col_trans = col & ~IM_COL32_A_MASK;\par
01955         {\cf17 const} {\cf18 int} idx_count = (points_count - 2) * 3 + points_count * 6;\par
01956         {\cf17 const} {\cf18 int} vtx_count = (points_count * 2);\par
01957         PrimReserve(idx_count, vtx_count);\par
01958 \par
01959         {\cf20 // Add indexes for fill}\par
01960         {\cf18 unsigned} {\cf18 int} vtx_inner_idx = _VtxCurrentIdx;\par
01961         {\cf18 unsigned} {\cf18 int} vtx_outer_idx = _VtxCurrentIdx + 1;\par
01962 \par
01963         _Data->TempBuffer.reserve_discard((ImTriangulator::EstimateScratchBufferSize(points_count) + {\cf17 sizeof}(ImVec2)) / {\cf17 sizeof}(ImVec2));\par
01964         triangulator.Init(points, points_count, _Data->TempBuffer.Data);\par
01965         {\cf19 while} (triangulator._TrianglesLeft > 0)\par
01966         \{\par
01967             triangulator.GetNextTriangle(triangle);\par
01968             _IdxWritePtr[0] = (ImDrawIdx)(vtx_inner_idx + (triangle[0] << 1)); _IdxWritePtr[1] = (ImDrawIdx)(vtx_inner_idx + (triangle[1] << 1)); _IdxWritePtr[2] = (ImDrawIdx)(vtx_inner_idx + (triangle[2] << 1));\par
01969             _IdxWritePtr += 3;\par
01970         \}\par
01971 \par
01972         {\cf20 // Compute normals}\par
01973         _Data->TempBuffer.reserve_discard(points_count);\par
01974         ImVec2* temp_normals = _Data->TempBuffer.Data;\par
01975         {\cf19 for} ({\cf18 int} i0 = points_count - 1, i1 = 0; i1 < points_count; i0 = i1++)\par
01976         \{\par
01977             {\cf17 const} ImVec2& p0 = points[i0];\par
01978             {\cf17 const} ImVec2& p1 = points[i1];\par
01979             {\cf18 float} dx = p1.x - p0.x;\par
01980             {\cf18 float} dy = p1.y - p0.y;\par
01981             IM_NORMALIZE2F_OVER_ZERO(dx, dy);\par
01982             temp_normals[i0].x = dy;\par
01983             temp_normals[i0].y = -dx;\par
01984         \}\par
01985 \par
01986         {\cf19 for} ({\cf18 int} i0 = points_count - 1, i1 = 0; i1 < points_count; i0 = i1++)\par
01987         \{\par
01988             {\cf20 // Average normals}\par
01989             {\cf17 const} ImVec2& n0 = temp_normals[i0];\par
01990             {\cf17 const} ImVec2& n1 = temp_normals[i1];\par
01991             {\cf18 float} dm_x = (n0.x + n1.x) * 0.5f;\par
01992             {\cf18 float} dm_y = (n0.y + n1.y) * 0.5f;\par
01993             IM_FIXNORMAL2F(dm_x, dm_y);\par
01994             dm_x *= AA_SIZE * 0.5f;\par
01995             dm_y *= AA_SIZE * 0.5f;\par
01996 \par
01997             {\cf20 // Add vertices}\par
01998             _VtxWritePtr[0].pos.x = (points[i1].x - dm_x); _VtxWritePtr[0].pos.y = (points[i1].y - dm_y); _VtxWritePtr[0].uv = uv; _VtxWritePtr[0].col = col;        {\cf20 // Inner}\par
01999             _VtxWritePtr[1].pos.x = (points[i1].x + dm_x); _VtxWritePtr[1].pos.y = (points[i1].y + dm_y); _VtxWritePtr[1].uv = uv; _VtxWritePtr[1].col = col_trans;  {\cf20 // Outer}\par
02000             _VtxWritePtr += 2;\par
02001 \par
02002             {\cf20 // Add indexes for fringes}\par
02003             _IdxWritePtr[0] = (ImDrawIdx)(vtx_inner_idx + (i1 << 1)); _IdxWritePtr[1] = (ImDrawIdx)(vtx_inner_idx + (i0 << 1)); _IdxWritePtr[2] = (ImDrawIdx)(vtx_outer_idx + (i0 << 1));\par
02004             _IdxWritePtr[3] = (ImDrawIdx)(vtx_outer_idx + (i0 << 1)); _IdxWritePtr[4] = (ImDrawIdx)(vtx_outer_idx + (i1 << 1)); _IdxWritePtr[5] = (ImDrawIdx)(vtx_inner_idx + (i1 << 1));\par
02005             _IdxWritePtr += 6;\par
02006         \}\par
02007         _VtxCurrentIdx += (ImDrawIdx)vtx_count;\par
02008     \}\par
02009     {\cf19 else}\par
02010     \{\par
02011         {\cf20 // Non Anti-aliased Fill}\par
02012         {\cf17 const} {\cf18 int} idx_count = (points_count - 2) * 3;\par
02013         {\cf17 const} {\cf18 int} vtx_count = points_count;\par
02014         PrimReserve(idx_count, vtx_count);\par
02015         {\cf19 for} ({\cf18 int} i = 0; i < vtx_count; i++)\par
02016         \{\par
02017             _VtxWritePtr[0].pos = points[i]; _VtxWritePtr[0].uv = uv; _VtxWritePtr[0].col = col;\par
02018             _VtxWritePtr++;\par
02019         \}\par
02020         _Data->TempBuffer.reserve_discard((ImTriangulator::EstimateScratchBufferSize(points_count) + {\cf17 sizeof}(ImVec2)) / {\cf17 sizeof}(ImVec2));\par
02021         triangulator.Init(points, points_count, _Data->TempBuffer.Data);\par
02022         {\cf19 while} (triangulator._TrianglesLeft > 0)\par
02023         \{\par
02024             triangulator.GetNextTriangle(triangle);\par
02025             _IdxWritePtr[0] = (ImDrawIdx)(_VtxCurrentIdx + triangle[0]); _IdxWritePtr[1] = (ImDrawIdx)(_VtxCurrentIdx + triangle[1]); _IdxWritePtr[2] = (ImDrawIdx)(_VtxCurrentIdx + triangle[2]);\par
02026             _IdxWritePtr += 3;\par
02027         \}\par
02028         _VtxCurrentIdx += (ImDrawIdx)vtx_count;\par
02029     \}\par
02030 \}\par
02031 \par
02032 {\cf20 //-----------------------------------------------------------------------------}\par
02033 {\cf20 // [SECTION] ImDrawListSplitter}\par
02034 {\cf20 //-----------------------------------------------------------------------------}\par
02035 {\cf20 // FIXME: This may be a little confusing, trying to be a little too low-level/optimal instead of just doing vector swap..}\par
02036 {\cf20 //-----------------------------------------------------------------------------}\par
02037 \par
02038 {\cf18 void} ImDrawListSplitter::ClearFreeMemory()\par
02039 \{\par
02040     {\cf19 for} ({\cf18 int} i = 0; i < _Channels.Size; i++)\par
02041     \{\par
02042         {\cf19 if} (i == _Current)\par
02043             memset(&_Channels[i], 0, {\cf17 sizeof}(_Channels[i]));  {\cf20 // Current channel is a copy of CmdBuffer/IdxBuffer, don't destruct again}\par
02044         _Channels[i]._CmdBuffer.clear();\par
02045         _Channels[i]._IdxBuffer.clear();\par
02046     \}\par
02047     _Current = 0;\par
02048     _Count = 1;\par
02049     _Channels.clear();\par
02050 \}\par
02051 \par
02052 {\cf18 void} ImDrawListSplitter::Split(ImDrawList* draw_list, {\cf18 int} channels_count)\par
02053 \{\par
02054     IM_UNUSED(draw_list);\par
02055     IM_ASSERT(_Current == 0 && _Count <= 1 && {\cf22 "Nested channel splitting is not supported. Please use separate instances of ImDrawListSplitter."});\par
02056     {\cf18 int} old_channels_count = _Channels.Size;\par
02057     {\cf19 if} (old_channels_count < channels_count)\par
02058     \{\par
02059         _Channels.reserve(channels_count); {\cf20 // Avoid over reserving since this is likely to stay stable}\par
02060         _Channels.resize(channels_count);\par
02061     \}\par
02062     _Count = channels_count;\par
02063 \par
02064     {\cf20 // Channels[] (24/32 bytes each) hold storage that we'll swap with draw_list->_CmdBuffer/_IdxBuffer}\par
02065     {\cf20 // The content of Channels[0] at this point doesn't matter. We clear it to make state tidy in a debugger but we don't strictly need to.}\par
02066     {\cf20 // When we switch to the next channel, we'll copy draw_list->_CmdBuffer/_IdxBuffer into Channels[0] and then Channels[1] into draw_list->CmdBuffer/_IdxBuffer}\par
02067     memset(&_Channels[0], 0, {\cf17 sizeof}(ImDrawChannel));\par
02068     {\cf19 for} ({\cf18 int} i = 1; i < channels_count; i++)\par
02069     \{\par
02070         {\cf19 if} (i >= old_channels_count)\par
02071         \{\par
02072             IM_PLACEMENT_NEW(&_Channels[i]) ImDrawChannel();\par
02073         \}\par
02074         {\cf19 else}\par
02075         \{\par
02076             _Channels[i]._CmdBuffer.resize(0);\par
02077             _Channels[i]._IdxBuffer.resize(0);\par
02078         \}\par
02079     \}\par
02080 \}\par
02081 \par
02082 {\cf18 void} ImDrawListSplitter::Merge(ImDrawList* draw_list)\par
02083 \{\par
02084     {\cf20 // Note that we never use or rely on _Channels.Size because it is merely a buffer that we never shrink back to 0 to keep all sub-buffers ready for use.}\par
02085     {\cf19 if} (_Count <= 1)\par
02086         {\cf19 return};\par
02087 \par
02088     SetCurrentChannel(draw_list, 0);\par
02089     draw_list->_PopUnusedDrawCmd();\par
02090 \par
02091     {\cf20 // Calculate our final buffer sizes. Also fix the incorrect IdxOffset values in each command.}\par
02092     {\cf18 int} new_cmd_buffer_count = 0;\par
02093     {\cf18 int} new_idx_buffer_count = 0;\par
02094     ImDrawCmd* last_cmd = (_Count > 0 && draw_list->CmdBuffer.Size > 0) ? &draw_list->CmdBuffer.back() : NULL;\par
02095     {\cf18 int} idx_offset = last_cmd ? last_cmd->IdxOffset + last_cmd->ElemCount : 0;\par
02096     {\cf19 for} ({\cf18 int} i = 1; i < _Count; i++)\par
02097     \{\par
02098         ImDrawChannel& ch = _Channels[i];\par
02099         {\cf19 if} (ch._CmdBuffer.Size > 0 && ch._CmdBuffer.back().ElemCount == 0 && ch._CmdBuffer.back().UserCallback == NULL) {\cf20 // Equivalent of PopUnusedDrawCmd()}\par
02100             ch._CmdBuffer.pop_back();\par
02101 \par
02102         {\cf19 if} (ch._CmdBuffer.Size > 0 && last_cmd != NULL)\par
02103         \{\par
02104             {\cf20 // Do not include ImDrawCmd_AreSequentialIdxOffset() in the compare as we rebuild IdxOffset values ourselves.}\par
02105             {\cf20 // Manipulating IdxOffset (e.g. by reordering draw commands like done by RenderDimmedBackgroundBehindWindow()) is not supported within a splitter.}\par
02106             ImDrawCmd* next_cmd = &ch._CmdBuffer[0];\par
02107             {\cf19 if} (ImDrawCmd_HeaderCompare(last_cmd, next_cmd) == 0 && last_cmd->UserCallback == NULL && next_cmd->UserCallback == NULL)\par
02108             \{\par
02109                 {\cf20 // Merge previous channel last draw command with current channel first draw command if matching.}\par
02110                 last_cmd->ElemCount += next_cmd->ElemCount;\par
02111                 idx_offset += next_cmd->ElemCount;\par
02112                 ch._CmdBuffer.erase(ch._CmdBuffer.Data); {\cf20 // FIXME-OPT: Improve for multiple merges.}\par
02113             \}\par
02114         \}\par
02115         {\cf19 if} (ch._CmdBuffer.Size > 0)\par
02116             last_cmd = &ch._CmdBuffer.back();\par
02117         new_cmd_buffer_count += ch._CmdBuffer.Size;\par
02118         new_idx_buffer_count += ch._IdxBuffer.Size;\par
02119         {\cf19 for} ({\cf18 int} cmd_n = 0; cmd_n < ch._CmdBuffer.Size; cmd_n++)\par
02120         \{\par
02121             ch._CmdBuffer.Data[cmd_n].IdxOffset = idx_offset;\par
02122             idx_offset += ch._CmdBuffer.Data[cmd_n].ElemCount;\par
02123         \}\par
02124     \}\par
02125     draw_list->CmdBuffer.resize(draw_list->CmdBuffer.Size + new_cmd_buffer_count);\par
02126     draw_list->IdxBuffer.resize(draw_list->IdxBuffer.Size + new_idx_buffer_count);\par
02127 \par
02128     {\cf20 // Write commands and indices in order (they are fairly small structures, we don't copy vertices only indices)}\par
02129     ImDrawCmd* cmd_write = draw_list->CmdBuffer.Data + draw_list->CmdBuffer.Size - new_cmd_buffer_count;\par
02130     ImDrawIdx* idx_write = draw_list->IdxBuffer.Data + draw_list->IdxBuffer.Size - new_idx_buffer_count;\par
02131     {\cf19 for} ({\cf18 int} i = 1; i < _Count; i++)\par
02132     \{\par
02133         ImDrawChannel& ch = _Channels[i];\par
02134         {\cf19 if} ({\cf18 int} sz = ch._CmdBuffer.Size) \{ memcpy(cmd_write, ch._CmdBuffer.Data, sz * {\cf17 sizeof}(ImDrawCmd)); cmd_write += sz; \}\par
02135         {\cf19 if} ({\cf18 int} sz = ch._IdxBuffer.Size) \{ memcpy(idx_write, ch._IdxBuffer.Data, sz * {\cf17 sizeof}(ImDrawIdx)); idx_write += sz; \}\par
02136     \}\par
02137     draw_list->_IdxWritePtr = idx_write;\par
02138 \par
02139     {\cf20 // Ensure there's always a non-callback draw command trailing the command-buffer}\par
02140     {\cf19 if} (draw_list->CmdBuffer.Size == 0 || draw_list->CmdBuffer.back().UserCallback != NULL)\par
02141         draw_list->AddDrawCmd();\par
02142 \par
02143     {\cf20 // If current command is used with different settings we need to add a new command}\par
02144     ImDrawCmd* curr_cmd = &draw_list->CmdBuffer.Data[draw_list->CmdBuffer.Size - 1];\par
02145     {\cf19 if} (curr_cmd->ElemCount == 0)\par
02146         ImDrawCmd_HeaderCopy(curr_cmd, &draw_list->_CmdHeader); {\cf20 // Copy ClipRect, TextureId, VtxOffset}\par
02147     {\cf19 else} {\cf19 if} (ImDrawCmd_HeaderCompare(curr_cmd, &draw_list->_CmdHeader) != 0)\par
02148         draw_list->AddDrawCmd();\par
02149 \par
02150     _Count = 1;\par
02151 \}\par
02152 \par
02153 {\cf18 void} ImDrawListSplitter::SetCurrentChannel(ImDrawList* draw_list, {\cf18 int} idx)\par
02154 \{\par
02155     IM_ASSERT(idx >= 0 && idx < _Count);\par
02156     {\cf19 if} (_Current == idx)\par
02157         {\cf19 return};\par
02158 \par
02159     {\cf20 // Overwrite ImVector (12/16 bytes), four times. This is merely a silly optimization instead of doing .swap()}\par
02160     memcpy(&_Channels.Data[_Current]._CmdBuffer, &draw_list->CmdBuffer, {\cf17 sizeof}(draw_list->CmdBuffer));\par
02161     memcpy(&_Channels.Data[_Current]._IdxBuffer, &draw_list->IdxBuffer, {\cf17 sizeof}(draw_list->IdxBuffer));\par
02162     _Current = idx;\par
02163     memcpy(&draw_list->CmdBuffer, &_Channels.Data[idx]._CmdBuffer, {\cf17 sizeof}(draw_list->CmdBuffer));\par
02164     memcpy(&draw_list->IdxBuffer, &_Channels.Data[idx]._IdxBuffer, {\cf17 sizeof}(draw_list->IdxBuffer));\par
02165     draw_list->_IdxWritePtr = draw_list->IdxBuffer.Data + draw_list->IdxBuffer.Size;\par
02166 \par
02167     {\cf20 // If current command is used with different settings we need to add a new command}\par
02168     ImDrawCmd* curr_cmd = (draw_list->CmdBuffer.Size == 0) ? NULL : &draw_list->CmdBuffer.Data[draw_list->CmdBuffer.Size - 1];\par
02169     {\cf19 if} (curr_cmd == NULL)\par
02170         draw_list->AddDrawCmd();\par
02171     {\cf19 else} {\cf19 if} (curr_cmd->ElemCount == 0)\par
02172         ImDrawCmd_HeaderCopy(curr_cmd, &draw_list->_CmdHeader); {\cf20 // Copy ClipRect, TextureId, VtxOffset}\par
02173     {\cf19 else} {\cf19 if} (ImDrawCmd_HeaderCompare(curr_cmd, &draw_list->_CmdHeader) != 0)\par
02174         draw_list->AddDrawCmd();\par
02175 \}\par
