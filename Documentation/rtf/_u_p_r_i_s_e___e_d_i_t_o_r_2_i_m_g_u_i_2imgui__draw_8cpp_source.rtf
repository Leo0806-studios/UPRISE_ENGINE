02484             {\cf17 const} {\cf18 unsigned} {\cf18 char}* src = pixels;\par
02485             {\cf18 unsigned} {\cf18 int}* dst = TexPixelsRGBA32;\par
02486             {\cf19 for} ({\cf18 int} n = TexWidth * TexHeight; n > 0; n--)\par
02487                 *dst++ = IM_COL32(255, 255, 255, ({\cf18 unsigned} {\cf18 int})(*src++));\par
02488         \}\par
02489     \}\par
02490 \par
02491     *out_pixels = ({\cf18 unsigned} {\cf18 char}*)TexPixelsRGBA32;\par
02492     {\cf19 if} (out_width) *out_width = TexWidth;\par
