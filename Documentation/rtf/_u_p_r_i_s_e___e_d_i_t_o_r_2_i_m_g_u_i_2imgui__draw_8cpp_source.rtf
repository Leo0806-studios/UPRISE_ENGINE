03057 {\cf18 void} ImFontAtlasBuildSetupFont(ImFontAtlas* atlas, ImFont* font, ImFontConfig* font_config, {\cf18 float} ascent, {\cf18 float} descent)\par
03058 \{\par
03059     {\cf19 if} (!font_config->MergeMode)\par
03060     \{\par
03061         font->ClearOutputData();\par
03062         font->FontSize = font_config->SizePixels;\par
03063         IM_ASSERT(font->ConfigData == font_config);\par
03064         font->ContainerAtlas = atlas;\par
03065         font->Ascent = ascent;\par
03066         font->Descent = descent;\par
03067     \}\par
03068 \}\par
03069 \par
03070 {\cf18 void} ImFontAtlasBuildPackCustomRects(ImFontAtlas* atlas, {\cf18 void}* stbrp_context_opaque)\par
03071 \{\par
03072     stbrp_context* pack_context = (stbrp_context*)stbrp_context_opaque;\par
03073     IM_ASSERT(pack_context != NULL);\par
03074 \par
03075     ImVector<ImFontAtlasCustomRect>& user_rects = atlas->CustomRects;\par
03076     IM_ASSERT(user_rects.Size >= 1); {\cf20 // We expect at least the default custom rects to be registered, else something went wrong.}\par
03077 {\cf21 #ifdef __GNUC__}\par
03078     {\cf19 if} (user_rects.Size < 1) \{ __builtin_unreachable(); \} {\cf20 // Workaround for GCC bug if IM_ASSERT() is defined to conditionally throw (see #5343)}\par
03079 {\cf21 #endif}\par
03080 \par
03081     ImVector<stbrp_rect> pack_rects;\par
03082     pack_rects.resize(user_rects.Size);\par
03083     memset(pack_rects.Data, 0, ({\cf18 size_t})pack_rects.size_in_bytes());\par
03084     {\cf19 for} ({\cf18 int} i = 0; i < user_rects.Size; i++)\par
03085     \{\par
03086         pack_rects[i].w = user_rects[i].Width;\par
03087         pack_rects[i].h = user_rects[i].Height;\par
03088     \}\par
03089     stbrp_pack_rects(pack_context, &pack_rects[0], pack_rects.Size);\par
03090     {\cf19 for} ({\cf18 int} i = 0; i < pack_rects.Size; i++)\par
03091         {\cf19 if} (pack_rects[i].was_packed)\par
03092         \{\par
03093             user_rects[i].X = ({\cf18 unsigned} short)pack_rects[i].x;\par
03094             user_rects[i].Y = ({\cf18 unsigned} short)pack_rects[i].y;\par
03095             IM_ASSERT(pack_rects[i].w == user_rects[i].Width && pack_rects[i].h == user_rects[i].Height);\par
03096             atlas->TexHeight = ImMax(atlas->TexHeight, pack_rects[i].y + pack_rects[i].h);\par
03097         \}\par
03098 \}\par
03099 \par
03100 {\cf18 void} ImFontAtlasBuildRender8bppRectFromString(ImFontAtlas* atlas, {\cf18 int} x, {\cf18 int} y, {\cf18 int} w, {\cf18 int} h, {\cf17 const} {\cf18 char}* in_str, {\cf18 char} in_marker_char, {\cf18 unsigned} {\cf18 char} in_marker_pixel_value)\par
03101 \{\par
03102     IM_ASSERT(x >= 0 && x + w <= atlas->TexWidth);\par
03103     IM_ASSERT(y >= 0 && y + h <= atlas->TexHeight);\par
03104     {\cf18 unsigned} {\cf18 char}* out_pixel = atlas->TexPixelsAlpha8 + x + (y * atlas->TexWidth);\par
03105     {\cf19 for} ({\cf18 int} off_y = 0; off_y < h; off_y++, out_pixel += atlas->TexWidth, in_str += w)\par
03106         {\cf19 for} ({\cf18 int} off_x = 0; off_x < w; off_x++)\par
03107             out_pixel[off_x] = (in_str[off_x] == in_marker_char) ? in_marker_pixel_value : 0x00;\par
03108 \}\par
