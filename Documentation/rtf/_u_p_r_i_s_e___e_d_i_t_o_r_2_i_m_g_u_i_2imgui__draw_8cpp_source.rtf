03622 {\cf18 void} ImFont::BuildLookupTable()\par
03623 \{\par
03624     {\cf18 int} max_codepoint = 0;\par
03625     {\cf19 for} ({\cf18 int} i = 0; i != Glyphs.Size; i++)\par
03626         max_codepoint = ImMax(max_codepoint, ({\cf18 int})Glyphs[i].Codepoint);\par
03627 \par
03628     {\cf20 // Build lookup table}\par
03629     IM_ASSERT(Glyphs.Size > 0 && {\cf22 "Font has not loaded glyph!"});\par
03630     IM_ASSERT(Glyphs.Size < 0xFFFF); {\cf20 // -1 is reserved}\par
03631     IndexAdvanceX.clear();\par
03632     IndexLookup.clear();\par
03633     DirtyLookupTables = {\cf17 false};\par
03634     memset(Used4kPagesMap, 0, {\cf17 sizeof}(Used4kPagesMap));\par
03635     GrowIndex(max_codepoint + 1);\par
03636     {\cf19 for} ({\cf18 int} i = 0; i < Glyphs.Size; i++)\par
03637     \{\par
03638         {\cf18 int} codepoint = (int)Glyphs[i].Codepoint;\par
03639         IndexAdvanceX[codepoint] = Glyphs[i].AdvanceX;\par
03640         IndexLookup[codepoint] = (ImWchar)i;\par
03641 \par
03642         {\cf20 // Mark 4K page as used}\par
03643         {\cf17 const} {\cf18 int} page_n = codepoint / 4096;\par
03644         Used4kPagesMap[page_n >> 3] |= 1 << (page_n & 7);\par
03645     \}\par
03646 \par
03647     {\cf20 // Create a glyph to handle TAB}\par
03648     {\cf20 // FIXME: Needs proper TAB handling but it needs to be contextualized (or we could arbitrary say that each string starts at "column 0" ?)}\par
03649     {\cf19 if} (FindGlyph((ImWchar){\cf23 ' '}))\par
03650     \{\par
03651         {\cf19 if} (Glyphs.back().Codepoint != {\cf23 '\\t'})   {\cf20 // So we can call this function multiple times (FIXME: Flaky)}\par
03652             Glyphs.resize(Glyphs.Size + 1);\par
03653         ImFontGlyph& tab_glyph = Glyphs.back();\par
03654         tab_glyph = *FindGlyph((ImWchar){\cf23 ' '});\par
03655         tab_glyph.Codepoint = {\cf23 '\\t'};\par
03656         tab_glyph.AdvanceX *= IM_TABSIZE;\par
03657         IndexAdvanceX[(int)tab_glyph.Codepoint] = ({\cf18 float})tab_glyph.AdvanceX;\par
03658         IndexLookup[(int)tab_glyph.Codepoint] = (ImWchar)(Glyphs.Size - 1);\par
03659     \}\par
03660 \par
03661     {\cf20 // Mark special glyphs as not visible (note that AddGlyph already mark as non-visible glyphs with zero-size polygons)}\par
03662     SetGlyphVisible((ImWchar){\cf23 ' '}, {\cf17 false});\par
03663     SetGlyphVisible((ImWchar){\cf23 '\\t'}, {\cf17 false});\par
03664 \par
03665     {\cf20 // Setup Fallback character}\par
03666     {\cf17 const} ImWchar fallback_chars[] = \{ (ImWchar)IM_UNICODE_CODEPOINT_INVALID, (ImWchar){\cf23 '?'}, (ImWchar){\cf23 ' '} \};\par
03667     FallbackGlyph = FindGlyphNoFallback(FallbackChar);\par
03668     {\cf19 if} (FallbackGlyph == NULL)\par
03669     \{\par
03670         FallbackChar = FindFirstExistingGlyph({\cf17 this}, fallback_chars, IM_ARRAYSIZE(fallback_chars));\par
03671         FallbackGlyph = FindGlyphNoFallback(FallbackChar);\par
03672         {\cf19 if} (FallbackGlyph == NULL)\par
03673         \{\par
03674             FallbackGlyph = &Glyphs.back();\par
03675             FallbackChar = (ImWchar)FallbackGlyph->Codepoint;\par
03676         \}\par
03677     \}\par
03678     FallbackAdvanceX = FallbackGlyph->AdvanceX;\par
03679     {\cf19 for} ({\cf18 int} i = 0; i < max_codepoint + 1; i++)\par
03680         {\cf19 if} (IndexAdvanceX[i] < 0.0f)\par
03681             IndexAdvanceX[i] = FallbackAdvanceX;\par
03682 \par
03683     {\cf20 // Setup Ellipsis character. It is required for rendering elided text. We prefer using U+2026 (horizontal ellipsis).}\par
03684     {\cf20 // However some old fonts may contain ellipsis at U+0085. Here we auto-detect most suitable ellipsis character.}\par
03685     {\cf20 // FIXME: Note that 0x2026 is rarely included in our font ranges. Because of this we are more likely to use three individual dots.}\par
03686     {\cf17 const} ImWchar ellipsis_chars[] = \{ (ImWchar)0x2026, (ImWchar)0x0085 \};\par
03687     {\cf17 const} ImWchar dots_chars[] = \{ (ImWchar){\cf23 '.'}, (ImWchar)0xFF0E \};\par
03688     {\cf19 if} (EllipsisChar == (ImWchar)-1)\par
03689         EllipsisChar = FindFirstExistingGlyph({\cf17 this}, ellipsis_chars, IM_ARRAYSIZE(ellipsis_chars));\par
03690     {\cf17 const} ImWchar dot_char = FindFirstExistingGlyph({\cf17 this}, dots_chars, IM_ARRAYSIZE(dots_chars));\par
03691     {\cf19 if} (EllipsisChar != (ImWchar)-1)\par
03692     \{\par
03693         EllipsisCharCount = 1;\par
03694         EllipsisWidth = EllipsisCharStep = FindGlyph(EllipsisChar)->X1;\par
03695     \}\par
03696     {\cf19 else} {\cf19 if} (dot_char != (ImWchar)-1)\par
03697     \{\par
03698         {\cf17 const} ImFontGlyph* glyph = FindGlyph(dot_char);\par
03699         EllipsisChar = dot_char;\par
03700         EllipsisCharCount = 3;\par
03701         EllipsisCharStep = (glyph->X1 - glyph->X0) + 1.0f;\par
03702         EllipsisWidth = EllipsisCharStep * 3.0f - 1.0f;\par
03703     \}\par
03704 \}\par
03705 \par
03706 {\cf20 // API is designed this way to avoid exposing the 4K page size}\par
03707 {\cf20 // e.g. use with IsGlyphRangeUnused(0, 255)}\par
03708 {\cf18 bool} ImFont::IsGlyphRangeUnused({\cf18 unsigned} {\cf18 int} c_begin, {\cf18 unsigned} {\cf18 int} c_last)\par
03709 \{\par
03710     {\cf18 unsigned} {\cf18 int} page_begin = (c_begin / 4096);\par
03711     {\cf18 unsigned} {\cf18 int} page_last = (c_last / 4096);\par
03712     {\cf19 for} ({\cf18 unsigned} {\cf18 int} page_n = page_begin; page_n <= page_last; page_n++)\par
03713         {\cf19 if} ((page_n >> 3) < {\cf17 sizeof}(Used4kPagesMap))\par
03714             {\cf19 if} (Used4kPagesMap[page_n >> 3] & (1 << (page_n & 7)))\par
03715                 {\cf19 return} {\cf17 false};\par
03716     {\cf19 return} {\cf17 true};\par
03717 \}\par
