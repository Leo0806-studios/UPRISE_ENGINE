00454 {\cf18 void} ImDrawList::AddDrawCmd()\par
00455 \{\par
00456     ImDrawCmd draw_cmd;\par
00457     draw_cmd.ClipRect = _CmdHeader.ClipRect;    {\cf20 // Same as calling ImDrawCmd_HeaderCopy()}\par
00458     draw_cmd.TextureId = _CmdHeader.TextureId;\par
00459     draw_cmd.VtxOffset = _CmdHeader.VtxOffset;\par
00460     draw_cmd.IdxOffset = IdxBuffer.Size;\par
