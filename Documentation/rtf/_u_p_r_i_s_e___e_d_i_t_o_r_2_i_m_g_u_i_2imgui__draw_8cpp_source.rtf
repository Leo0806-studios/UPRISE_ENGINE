02181 {\cf18 void} ImDrawData::Clear()\par
02182 \{\par
02183     Valid = {\cf17 false};\par
02184     CmdListsCount = TotalIdxCount = TotalVtxCount = 0;\par
02185     CmdLists.resize(0); {\cf20 // The ImDrawList are NOT owned by ImDrawData but e.g. by ImGuiContext, so we don't clear them.}\par
02186     DisplayPos = DisplaySize = FramebufferScale = ImVec2(0.0f, 0.0f);\par
02187     OwnerViewport = NULL;\par
02188 \}\par
