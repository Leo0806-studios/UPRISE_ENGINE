04061     \{\par
04062         {\cf17 const} {\cf18 char}* s_end = s;\par
04063         {\cf18 float} y_end = y;\par
04064         {\cf19 while} (y_end < clip_rect.w && s_end < text_end)\par
04065         \{\par
04066             s_end = ({\cf17 const} {\cf18 char}*)memchr(s_end, {\cf23 '\\n'}, text_end - s_end);\par
