03927 ImVec2 ImFont::CalcTextSizeA({\cf18 float} size, {\cf18 float} max_width, {\cf18 float} wrap_width, {\cf17 const} {\cf18 char}* text_begin, {\cf17 const} {\cf18 char}* text_end, {\cf17 const} {\cf18 char}** remaining){\cf17  const}\par
03928 {\cf17 }\{\par
03929     {\cf19 if} (!text_end)\par
03930         text_end = text_begin + strlen(text_begin); {\cf20 // FIXME-OPT: Need to avoid this.}\par
03931 \par
03932     {\cf17 const} {\cf18 float} line_height = size;\par
03933     {\cf17 const} {\cf18 float} scale = size / FontSize;\par
03934 \par
03935     ImVec2 text_size = ImVec2(0, 0);\par
03936     {\cf18 float} line_width = 0.0f;\par
03937 \par
03938     {\cf17 const} {\cf18 bool} word_wrap_enabled = (wrap_width > 0.0f);\par
03939     {\cf17 const} {\cf18 char}* word_wrap_eol = NULL;\par
03940 \par
03941     {\cf17 const} {\cf18 char}* s = text_begin;\par
03942     {\cf19 while} (s < text_end)\par
03943     \{\par
03944         {\cf19 if} (word_wrap_enabled)\par
03945         \{\par
03946             {\cf20 // Calculate how far we can render. Requires two passes on the string data but keeps the code simple and not intrusive for what's essentially an uncommon feature.}\par
03947             {\cf19 if} (!word_wrap_eol)\par
03948                 word_wrap_eol = CalcWordWrapPositionA(scale, s, text_end, wrap_width - line_width);\par
03949 \par
03950             {\cf19 if} (s >= word_wrap_eol)\par
