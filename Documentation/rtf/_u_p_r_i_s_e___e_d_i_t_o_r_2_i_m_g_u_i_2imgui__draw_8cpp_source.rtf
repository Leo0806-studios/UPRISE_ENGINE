04523     {\cf19 if} (stb__in4(0) != 0x57bC0000) {\cf19 return} 0;\par
04524     {\cf19 if} (stb__in4(4) != 0)          {\cf19 return} 0; {\cf20 // error! stream is > 4GB}\par
04525     {\cf17 const} {\cf18 unsigned} {\cf18 int} olen = stb_decompress_length(i);\par
