03614 {\cf17 static} ImWchar FindFirstExistingGlyph(ImFont* font, {\cf17 const} ImWchar* candidate_chars, {\cf18 int} candidate_chars_count)\par
03615 \{\par
03616     {\cf19 for} ({\cf18 int} n = 0; n < candidate_chars_count; n++)\par
03617         {\cf19 if} (font->FindGlyphNoFallback(candidate_chars[n]) != NULL)\par
03618             {\cf19 return} candidate_chars[n];\par
03619     {\cf19 return} (ImWchar)-1;\par
03620 \}\par
