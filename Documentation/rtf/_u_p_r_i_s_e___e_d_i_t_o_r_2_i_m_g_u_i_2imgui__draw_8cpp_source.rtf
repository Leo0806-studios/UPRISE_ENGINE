04115         \{\par
04116             {\cf19 if} (c == {\cf23 '\\n'})\par
04117             \{\par
04118                 x = start_x;\par
04119                 y += line_height;\par
04120                 {\cf19 if} (y > clip_rect.w)\par
04121                     {\cf19 break}; {\cf20 // break out of main loop}\par
04122                 {\cf19 continue};\par
04123             \}\par
04124             {\cf19 if} (c == {\cf23 '\\r'})\par
04125                 {\cf19 continue};\par
