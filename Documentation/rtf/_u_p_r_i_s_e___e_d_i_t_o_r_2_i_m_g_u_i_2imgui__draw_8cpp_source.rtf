04223 {\cf20 // Render an arrow aimed to be aligned with text (p_min is a position in the same space text would be positioned). To e.g. denote expanded/collapsed state}\par
04224 {\cf18 void} ImGui::RenderArrow(ImDrawList* draw_list, ImVec2 pos, ImU32 col, ImGuiDir dir, {\cf18 float} scale)\par
04225 \{\par
04226     {\cf17 const} {\cf18 float} h = draw_list->_Data->FontSize * 1.00f;\par
04227     {\cf18 float} r = h * 0.40f * scale;\par
04228     ImVec2 center = pos + ImVec2(h * 0.50f, h * 0.50f * scale);\par
04229 \par
04230     ImVec2 a, b, c;\par
04231     {\cf19 switch} (dir)\par
04232     \{\par
04233     {\cf19 case} ImGuiDir_Up:\par
04234     {\cf19 case} ImGuiDir_Down:\par
04235         {\cf19 if} (dir == ImGuiDir_Up) r = -r;\par
04236         a = ImVec2(+0.000f, +0.750f) * r;\par
04237         b = ImVec2(-0.866f, -0.750f) * r;\par
04238         c = ImVec2(+0.866f, -0.750f) * r;\par
04239         {\cf19 break};\par
04240     {\cf19 case} ImGuiDir_Left:\par
04241     {\cf19 case} ImGuiDir_Right:\par
04242         {\cf19 if} (dir == ImGuiDir_Left) r = -r;\par
04243         a = ImVec2(+0.750f, +0.000f) * r;\par
04244         b = ImVec2(-0.750f, +0.866f) * r;\par
04245         c = ImVec2(-0.750f, -0.866f) * r;\par
04246         {\cf19 break};\par
04247     {\cf19 case} ImGuiDir_None:\par
04248     {\cf19 case} ImGuiDir_COUNT:\par
04249         IM_ASSERT(0);\par
04250         {\cf19 break};\par
04251     \}\par
04252     draw_list->AddTriangleFilled(center + a, center + b, center + c, col);\par
04253 \}\par
