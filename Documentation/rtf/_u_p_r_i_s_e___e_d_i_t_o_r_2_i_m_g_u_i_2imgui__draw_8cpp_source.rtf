00466 {\cf20 // Pop trailing draw command (used before merging or presenting to user)}\par
00467 {\cf20 // Note that this leaves the ImDrawList in a state unfit for further commands, as most code assume that CmdBuffer.Size > 0 && CmdBuffer.back().UserCallback == NULL}\par
00468 {\cf18 void} ImDrawList::_PopUnusedDrawCmd()\par
00469 \{\par
00470     {\cf19 while} (CmdBuffer.Size > 0)\par
00471     \{\par
00472         ImDrawCmd* curr_cmd = &CmdBuffer.Data[CmdBuffer.Size - 1];\par
00473         {\cf19 if} (curr_cmd->ElemCount != 0 || curr_cmd->UserCallback != NULL)\par
00474             {\cf19 return};{\cf20 // break;}\par
00475         CmdBuffer.pop_back();\par
00476     \}\par
00477 \}\par
00478 \par
00479 {\cf18 void} ImDrawList::AddCallback(ImDrawCallback callback, {\cf18 void}* callback_data)\par
00480 \{\par
00481     IM_ASSERT_PARANOID(CmdBuffer.Size > 0);\par
00482     ImDrawCmd* curr_cmd = &CmdBuffer.Data[CmdBuffer.Size - 1];\par
00483     IM_ASSERT(curr_cmd->UserCallback == NULL);\par
00484     {\cf19 if} (curr_cmd->ElemCount != 0)\par
00485     \{\par
00486         AddDrawCmd();\par
00487         curr_cmd = &CmdBuffer.Data[CmdBuffer.Size - 1];\par
00488     \}\par
00489     curr_cmd->UserCallback = callback;\par
00490     curr_cmd->UserCallbackData = callback_data;\par
00491 \par
00492     AddDrawCmd(); {\cf20 // Force a new command after us (see comment below)}\par
00493 \}\par
