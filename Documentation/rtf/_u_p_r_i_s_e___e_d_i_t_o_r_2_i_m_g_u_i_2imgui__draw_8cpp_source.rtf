01377 {\cf18 void} ImDrawList::PathRect({\cf17 const} ImVec2& a, {\cf17 const} ImVec2& b, {\cf18 float} rounding, ImDrawFlags flags)\par
01378 \{\par
01379     {\cf19 if} (rounding >= 0.5f)\par
01380     \{\par
01381         flags = FixRectCornerFlags(flags);\par
01382         rounding = ImMin(rounding, ImFabs(b.x - a.x) * (((flags & ImDrawFlags_RoundCornersTop) == ImDrawFlags_RoundCornersTop) || ((flags & ImDrawFlags_RoundCornersBottom) == ImDrawFlags_RoundCornersBottom) ? 0.5f : 1.0f) - 1.0f);\par
01383         rounding = ImMin(rounding, ImFabs(b.y - a.y) * (((flags & ImDrawFlags_RoundCornersLeft) == ImDrawFlags_RoundCornersLeft) || ((flags & ImDrawFlags_RoundCornersRight) == ImDrawFlags_RoundCornersRight) ? 0.5f : 1.0f) - 1.0f);\par
01384     \}\par
01385     {\cf19 if} (rounding < 0.5f || (flags & ImDrawFlags_RoundCornersMask_) == ImDrawFlags_RoundCornersNone)\par
01386     \{\par
01387         PathLineTo(a);\par
01388         PathLineTo(ImVec2(b.x, a.y));\par
01389         PathLineTo(b);\par
01390         PathLineTo(ImVec2(a.x, b.y));\par
01391     \}\par
01392     {\cf19 else}\par
01393     \{\par
01394         {\cf17 const} {\cf18 float} rounding_tl = (flags & ImDrawFlags_RoundCornersTopLeft)     ? rounding : 0.0f;\par
01395         {\cf17 const} {\cf18 float} rounding_tr = (flags & ImDrawFlags_RoundCornersTopRight)    ? rounding : 0.0f;\par
01396         {\cf17 const} {\cf18 float} rounding_br = (flags & ImDrawFlags_RoundCornersBottomRight) ? rounding : 0.0f;\par
01397         {\cf17 const} {\cf18 float} rounding_bl = (flags & ImDrawFlags_RoundCornersBottomLeft)  ? rounding : 0.0f;\par
01398         PathArcToFast(ImVec2(a.x + rounding_tl, a.y + rounding_tl), rounding_tl, 6, 9);\par
01399         PathArcToFast(ImVec2(b.x - rounding_tr, a.y + rounding_tr), rounding_tr, 9, 12);\par
01400         PathArcToFast(ImVec2(b.x - rounding_br, b.y - rounding_br), rounding_br, 0, 3);\par
01401         PathArcToFast(ImVec2(a.x + rounding_bl, b.y - rounding_bl), rounding_bl, 3, 6);\par
01402     \}\par
01403 \}\par
