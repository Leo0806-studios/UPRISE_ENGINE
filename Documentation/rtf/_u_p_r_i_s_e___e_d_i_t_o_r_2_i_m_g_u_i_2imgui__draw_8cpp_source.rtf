03816 {\cf20 // Wrapping skips upcoming blanks}\par
03817 {\cf17 static} {\cf17 inline} {\cf17 const} {\cf18 char}* CalcWordWrapNextLineStartA({\cf17 const} {\cf18 char}* text, {\cf17 const} {\cf18 char}* text_end)\par
03818 \{\par
03819     {\cf19 while} (text < text_end && ImCharIsBlankA(*text))\par
03820         text++;\par
03821     {\cf19 if} (*text == {\cf23 '\\n'})\par
03822         text++;\par
03823     {\cf19 return} text;\par
03824 \}\par
03825 \par
03826 {\cf20 // Simple word-wrapping for English, not full-featured. Please submit failing cases!}\par
03827 {\cf20 // This will return the next location to wrap from. If no wrapping if necessary, this will fast-forward to e.g. text_end.}\par
03828 {\cf20 // FIXME: Much possible improvements (don't cut things like "word !", "word!!!" but cut within "word,,,,", more sensible support for punctuations, support for Unicode punctuations, etc.)}\par
03829 {\cf17 const} {\cf18 char}* ImFont::CalcWordWrapPositionA({\cf18 float} scale, {\cf17 const} {\cf18 char}* text, {\cf17 const} {\cf18 char}* text_end, {\cf18 float} wrap_width){\cf17  const}\par
03830 {\cf17 }\{\par
03831     {\cf20 // For references, possible wrap point marked with ^}\par
03832     {\cf20 //  "aaa bbb, ccc,ddd. eee   fff. ggg!"}\par
03833     {\cf20 //      ^    ^    ^   ^   ^__    ^    ^}\par
03834 \par
03835     {\cf20 // List of hardcoded separators: .,;!?'"}\par
03836 \par
03837     {\cf20 // Skip extra blanks after a line returns (that includes not counting them in width computation)}\par
03838     {\cf20 // e.g. "Hello    world" --> "Hello" "World"}\par
03839 \par
03840     {\cf20 // Cut words that cannot possibly fit within one line.}\par
03841     {\cf20 // e.g.: "The tropical fish" with ~5 characters worth of width --> "The tr" "opical" "fish"}\par
03842     {\cf18 float} line_width = 0.0f;\par
03843     {\cf18 float} word_width = 0.0f;\par
03844     {\cf18 float} blank_width = 0.0f;\par
03845     wrap_width /= scale; {\cf20 // We work with unscaled widths to avoid scaling every characters}\par
03846 \par
03847     {\cf17 const} {\cf18 char}* word_end = text;\par
03848     {\cf17 const} {\cf18 char}* prev_word_end = NULL;\par
03849     {\cf18 bool} inside_word = {\cf17 true};\par
03850 \par
03851     {\cf17 const} {\cf18 char}* s = text;\par
03852     IM_ASSERT(text_end != NULL);\par
03853     {\cf19 while} (s < text_end)\par
03854     \{\par
03855         {\cf18 unsigned} {\cf18 int} c = ({\cf18 unsigned} int)*s;\par
03856         {\cf17 const} {\cf18 char}* next_s;\par
03857         {\cf19 if} (c < 0x80)\par
03858             next_s = s + 1;\par
03859         {\cf19 else}\par
03860             next_s = s + ImTextCharFromUtf8(&c, s, text_end);\par
03861 \par
03862         {\cf19 if} (c < 32)\par
03863         \{\par
03864             {\cf19 if} (c == {\cf23 '\\n'})\par
03865             \{\par
03866                 line_width = word_width = blank_width = 0.0f;\par
03867                 inside_word = {\cf17 true};\par
03868                 s = next_s;\par
03869                 {\cf19 continue};\par
03870             \}\par
03871             {\cf19 if} (c == {\cf23 '\\r'})\par
03872             \{\par
03873                 s = next_s;\par
03874                 {\cf19 continue};\par
03875             \}\par
03876         \}\par
03877 \par
03878         {\cf17 const} {\cf18 float} char_width = ((int)c < IndexAdvanceX.Size ? IndexAdvanceX.Data[c] : FallbackAdvanceX);\par
03879         {\cf19 if} (ImCharIsBlankW(c))\par
03880         \{\par
03881             {\cf19 if} (inside_word)\par
03882             \{\par
03883                 line_width += blank_width;\par
03884                 blank_width = 0.0f;\par
03885                 word_end = s;\par
03886             \}\par
03887             blank_width += char_width;\par
03888             inside_word = {\cf17 false};\par
03889         \}\par
03890         {\cf19 else}\par
03891         \{\par
03892             word_width += char_width;\par
03893             {\cf19 if} (inside_word)\par
03894             \{\par
03895                 word_end = next_s;\par
03896             \}\par
03897             {\cf19 else}\par
03898             \{\par
03899                 prev_word_end = word_end;\par
03900                 line_width += word_width + blank_width;\par
03901                 word_width = blank_width = 0.0f;\par
03902             \}\par
03903 \par
03904             {\cf20 // Allow wrapping after punctuation.}\par
03905             inside_word = (c != {\cf23 '.'} && c != {\cf23 ','} && c != {\cf23 ';'} && c != {\cf23 '!'} && c != {\cf23 '?'} && c != {\cf23 '\\"'});\par
03906         \}\par
03907 \par
03908         {\cf20 // We ignore blank width at the end of the line (they can be skipped)}\par
03909         {\cf19 if} (line_width + word_width > wrap_width)\par
03910         \{\par
03911             {\cf20 // Words that cannot possibly fit within an entire line will be cut anywhere.}\par
03912             {\cf19 if} (word_width < wrap_width)\par
03913                 s = prev_word_end ? prev_word_end : word_end;\par
03914             {\cf19 break};\par
03915         \}\par
03916 \par
03917         s = next_s;\par
03918     \}\par
03919 \par
03920     {\cf20 // Wrap_width is too small to fit anything. Force displaying 1 character to minimize the height discontinuity.}\par
03921     {\cf20 // +1 may not be a character start point in UTF-8 but it's ok because caller loops use (text >= word_wrap_eol).}\par
03922     {\cf19 if} (s == text && text < text_end)\par
03923         {\cf19 return} s + 1;\par
03924     {\cf19 return} s;\par
03925 \}\par
