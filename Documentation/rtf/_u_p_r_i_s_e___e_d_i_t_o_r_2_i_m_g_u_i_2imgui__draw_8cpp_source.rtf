00634 {\cf20 // Reserve space for a number of vertices and indices.}\par
00635 {\cf20 // You must finish filling your reserved data before calling PrimReserve() again, as it may reallocate or}\par
00636 {\cf20 // submit the intermediate results. PrimUnreserve() can be used to release unused allocations.}\par
00637 {\cf18 void} ImDrawList::PrimReserve({\cf18 int} idx_count, {\cf18 int} vtx_count)\par
00638 \{\par
00639     {\cf20 // Large mesh support (when enabled)}\par
00640     IM_ASSERT_PARANOID(idx_count >= 0 && vtx_count >= 0);\par
00641     {\cf19 if} ({\cf17 sizeof}(ImDrawIdx) == 2 && (_VtxCurrentIdx + vtx_count >= (1 << 16)) && (Flags & ImDrawListFlags_AllowVtxOffset))\par
00642     \{\par
00643         {\cf20 // FIXME: In theory we should be testing that vtx_count <64k here.}\par
00644         {\cf20 // In practice, RenderText() relies on reserving ahead for a worst case scenario so it is currently useful for us}\par
00645         {\cf20 // to not make that check until we rework the text functions to handle clipping and large horizontal lines better.}\par
00646         _CmdHeader.VtxOffset = VtxBuffer.Size;\par
00647         _OnChangedVtxOffset();\par
00648     \}\par
00649 \par
00650     ImDrawCmd* draw_cmd = &CmdBuffer.Data[CmdBuffer.Size - 1];\par
00651     draw_cmd->ElemCount += idx_count;\par
00652 \par
00653     {\cf18 int} vtx_buffer_old_size = VtxBuffer.Size;\par
00654     VtxBuffer.resize(vtx_buffer_old_size + vtx_count);\par
00655     _VtxWritePtr = VtxBuffer.Data + vtx_buffer_old_size;\par
00656 \par
00657     {\cf18 int} idx_buffer_old_size = IdxBuffer.Size;\par
00658     IdxBuffer.resize(idx_buffer_old_size + idx_count);\par
00659     _IdxWritePtr = IdxBuffer.Data + idx_buffer_old_size;\par
00660 \}\par
00661 \par
00662 {\cf20 // Release the number of reserved vertices/indices from the end of the last reservation made with PrimReserve().}\par
00663 {\cf18 void} ImDrawList::PrimUnreserve({\cf18 int} idx_count, {\cf18 int} vtx_count)\par
00664 \{\par
00665     IM_ASSERT_PARANOID(idx_count >= 0 && vtx_count >= 0);\par
00666 \par
00667     ImDrawCmd* draw_cmd = &CmdBuffer.Data[CmdBuffer.Size - 1];\par
00668     draw_cmd->ElemCount -= idx_count;\par
00669     VtxBuffer.shrink(VtxBuffer.Size - vtx_count);\par
00670     IdxBuffer.shrink(IdxBuffer.Size - idx_count);\par
00671 \}\par
