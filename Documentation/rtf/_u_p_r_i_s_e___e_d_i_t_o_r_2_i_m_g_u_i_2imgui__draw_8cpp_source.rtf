03043 {\cf18 void} ImFontAtlasUpdateConfigDataPointers(ImFontAtlas* atlas)\par
03044 \{\par
03045     {\cf19 for} (ImFontConfig& font_cfg : atlas->ConfigData)\par
03046     \{\par
03047         ImFont* font = font_cfg.DstFont;\par
03048         {\cf19 if} (!font_cfg.MergeMode)\par
03049         \{\par
03050             font->ConfigData = &font_cfg;\par
03051             font->ConfigDataCount = 0;\par
03052         \}\par
03053         font->ConfigDataCount++;\par
03054     \}\par
