03952                 {\cf19 if} (text_size.x < line_width)\par
03953                     text_size.x = line_width;\par
03954                 text_size.y += line_height;\par
03955                 line_width = 0.0f;\par
03956                 word_wrap_eol = NULL;\par
03957                 s = CalcWordWrapNextLineStartA(s, text_end); {\cf20 // Wrapping skips upcoming blanks}\par
03958                 {\cf19 continue};\par
03959             \}\par
03960         \}\par
03961 \par
03962         {\cf20 // Decode and advance source}\par
03963         {\cf17 const} {\cf18 char}* prev_s = s;\par
03964         {\cf18 unsigned} {\cf18 int} c = ({\cf18 unsigned} int)*s;\par
03965         {\cf19 if} (c < 0x80)\par
03966             s += 1;\par
03967         {\cf19 else}\par
03968             s += ImTextCharFromUtf8(&c, s, text_end);\par
03969 \par
03970         {\cf19 if} (c < 32)\par
03971         \{\par
03972             {\cf19 if} (c == {\cf23 '\\n'})\par
03973             \{\par
03974                 text_size.x = ImMax(text_size.x, line_width);\par
03975                 text_size.y += line_height;\par
03976                 line_width = 0.0f;\par
03977                 {\cf19 continue};\par
03978             \}\par
03979             {\cf19 if} (c == {\cf23 '\\r'})\par
03980                 {\cf19 continue};\par
03981         \}\par
03982 \par
03983         {\cf17 const} {\cf18 float} char_width = ((int)c < IndexAdvanceX.Size ? IndexAdvanceX.Data[c] : FallbackAdvanceX) * scale;\par
03984         {\cf19 if} (line_width + char_width >= max_width)\par
03985         \{\par
03986             s = prev_s;\par
03987             {\cf19 break};\par
03988         \}\par
03989 \par
03990         line_width += char_width;\par
03991     \}\par
03992 \par
03993     {\cf19 if} (text_size.x < line_width)\par
03994         text_size.x = line_width;\par
03995 \par
03996     {\cf19 if} (line_width > 0 || text_size.y == 0.0f)\par
03997         text_size.y += line_height;\par
03998 \par
03999     {\cf19 if} (remaining)\par
04000         *remaining = s;\par
04001 \par
04002     {\cf19 return} text_size;\par
04003 \}\par
