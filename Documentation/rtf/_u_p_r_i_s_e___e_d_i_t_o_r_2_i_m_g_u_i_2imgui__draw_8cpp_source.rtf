03558 {\cf18 void} ImFontGlyphRangesBuilder::BuildRanges(ImVector<ImWchar>* out_ranges)\par
03559 \{\par
03560     {\cf17 const} {\cf18 int} max_codepoint = IM_UNICODE_CODEPOINT_MAX;\par
03561     {\cf19 for} ({\cf18 int} n = 0; n <= max_codepoint; n++)\par
03562         {\cf19 if} (GetBit(n))\par
03563         \{\par
03564             out_ranges->push_back((ImWchar)n);\par
03565             {\cf19 while} (n < max_codepoint && GetBit(n + 1))\par
03566                 n++;\par
03567             out_ranges->push_back((ImWchar)n);\par
03568         \}\par
03569     out_ranges->push_back(0);\par
03570 \}\par
