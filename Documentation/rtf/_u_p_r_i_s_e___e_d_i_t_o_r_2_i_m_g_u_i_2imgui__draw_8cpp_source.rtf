02550     ImFontConfig font_cfg = font_cfg_template ? *font_cfg_template : ImFontConfig();\par
02551     {\cf19 if} (!font_cfg_template)\par
02552     \{\par
02553         font_cfg.OversampleH = font_cfg.OversampleV = 1;\par
02554         font_cfg.PixelSnapH = {\cf17 true};\par
02555     \}\par
02556     {\cf19 if} (font_cfg.SizePixels <= 0.0f)\par
02557         font_cfg.SizePixels = 13.0f * 1.0f;\par
02558     {\cf19 if} (font_cfg.Name[0] == {\cf23 '\\0'})\par
02559         ImFormatString(font_cfg.Name, IM_ARRAYSIZE(font_cfg.Name), {\cf22 "ProggyClean.ttf, %dpx"}, ({\cf18 int})font_cfg.SizePixels);\par
