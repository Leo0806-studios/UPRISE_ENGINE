02531 {\cf20 // Default font TTF is compressed with stb_compress then base85 encoded (see misc/fonts/binary_to_compressed_c.cpp for encoder)}\par
02532 {\cf17 static} {\cf18 unsigned} {\cf18 int} stb_decompress_length({\cf17 const} {\cf18 unsigned} {\cf18 char}* input);\par
02533 {\cf17 static} {\cf18 unsigned} {\cf18 int} stb_decompress({\cf18 unsigned} {\cf18 char}* output, {\cf17 const} {\cf18 unsigned} {\cf18 char}* input, {\cf18 unsigned} {\cf18 int} length);\par
02534 {\cf17 static} {\cf17 const} {\cf18 char}*  GetDefaultCompressedFontDataTTFBase85();\par
02535 {\cf17 static} {\cf18 unsigned} {\cf18 int} Decode85Byte({\cf18 char} c)                                    \{ {\cf19 return} c >= {\cf23 '\\\\'} ? c-36 : c-35; \}\par
02536 {\cf17 static} {\cf18 void}         Decode85({\cf17 const} {\cf18 unsigned} {\cf18 char}* src, {\cf18 unsigned} {\cf18 char}* dst)\par
02537 \{\par
02538     {\cf19 while} (*src)\par
02539     \{\par
02540         {\cf18 unsigned} {\cf18 int} tmp = Decode85Byte(src[0]) + 85 * (Decode85Byte(src[1]) + 85 * (Decode85Byte(src[2]) + 85 * (Decode85Byte(src[3]) + 85 * Decode85Byte(src[4]))));\par
02541         dst[0] = ((tmp >> 0) & 0xFF); dst[1] = ((tmp >> 8) & 0xFF); dst[2] = ((tmp >> 16) & 0xFF); dst[3] = ((tmp >> 24) & 0xFF);   {\cf20 // We can't assume little-endianness.}\par
02542         src += 5;\par
02543         dst += 4;\par
02544     \}\par
02545 \}\par
