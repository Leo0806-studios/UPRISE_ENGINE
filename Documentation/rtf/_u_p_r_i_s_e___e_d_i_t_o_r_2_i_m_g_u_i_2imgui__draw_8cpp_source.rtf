00495 {\cf20 // Compare ClipRect, TextureId and VtxOffset with a single memcmp()}\par
00496 {\cf21 #define ImDrawCmd_HeaderSize                            (offsetof(ImDrawCmd, VtxOffset) + sizeof(unsigned int))}\par
00497 {\cf21 #define ImDrawCmd_HeaderCompare(CMD_LHS, CMD_RHS)       (memcmp(CMD_LHS, CMD_RHS, ImDrawCmd_HeaderSize))    }{\cf20 // Compare ClipRect, TextureId, VtxOffset}\par
00498 {\cf21 #define ImDrawCmd_HeaderCopy(CMD_DST, CMD_SRC)          (memcpy(CMD_DST, CMD_SRC, ImDrawCmd_HeaderSize))    }{\cf20 // Copy ClipRect, TextureId, VtxOffset}\par
00499 {\cf21 #define ImDrawCmd_AreSequentialIdxOffset(CMD_0, CMD_1)  (CMD_0->IdxOffset + CMD_0->ElemCount == CMD_1->IdxOffset)}\par
00500 \par
00501 {\cf20 // Try to merge two last draw commands}\par
00502 {\cf18 void} ImDrawList::_TryMergeDrawCmds()\par
00503 \{\par
00504     IM_ASSERT_PARANOID(CmdBuffer.Size > 0);\par
00505     ImDrawCmd* curr_cmd = &CmdBuffer.Data[CmdBuffer.Size - 1];\par
00506     ImDrawCmd* prev_cmd = curr_cmd - 1;\par
00507     {\cf19 if} (ImDrawCmd_HeaderCompare(curr_cmd, prev_cmd) == 0 && ImDrawCmd_AreSequentialIdxOffset(prev_cmd, curr_cmd) && curr_cmd->UserCallback == NULL && prev_cmd->UserCallback == NULL)\par
00508     \{\par
00509         prev_cmd->ElemCount += curr_cmd->ElemCount;\par
00510         CmdBuffer.pop_back();\par
00511     \}\par
00512 \}\par
00513 \par
00514 {\cf20 // Our scheme may appears a bit unusual, basically we want the most-common calls AddLine AddRect etc. to not have to perform any check so we always have a command ready in the stack.}\par
00515 {\cf20 // The cost of figuring out if a new command has to be added or if we can merge is paid in those Update** functions only.}\par
00516 {\cf18 void} ImDrawList::_OnChangedClipRect()\par
00517 \{\par
00518     {\cf20 // If current command is used with different settings we need to add a new command}\par
00519     IM_ASSERT_PARANOID(CmdBuffer.Size > 0);\par
00520     ImDrawCmd* curr_cmd = &CmdBuffer.Data[CmdBuffer.Size - 1];\par
00521     {\cf19 if} (curr_cmd->ElemCount != 0 && memcmp(&curr_cmd->ClipRect, &_CmdHeader.ClipRect, {\cf17 sizeof}(ImVec4)) != 0)\par
00522     \{\par
00523         AddDrawCmd();\par
00524         {\cf19 return};\par
00525     \}\par
00526     IM_ASSERT(curr_cmd->UserCallback == NULL);\par
00527 \par
00528     {\cf20 // Try to merge with previous command if it matches, else use current command}\par
00529     ImDrawCmd* prev_cmd = curr_cmd - 1;\par
00530     {\cf19 if} (curr_cmd->ElemCount == 0 && CmdBuffer.Size > 1 && ImDrawCmd_HeaderCompare(&_CmdHeader, prev_cmd) == 0 && ImDrawCmd_AreSequentialIdxOffset(prev_cmd, curr_cmd) && prev_cmd->UserCallback == NULL)\par
00531     \{\par
00532         CmdBuffer.pop_back();\par
00533         {\cf19 return};\par
00534     \}\par
00535 \par
00536     curr_cmd->ClipRect = _CmdHeader.ClipRect;\par
00537 \}\par
00538 \par
00539 {\cf18 void} ImDrawList::_OnChangedTextureID()\par
00540 \{\par
00541     {\cf20 // If current command is used with different settings we need to add a new command}\par
00542     IM_ASSERT_PARANOID(CmdBuffer.Size > 0);\par
00543     ImDrawCmd* curr_cmd = &CmdBuffer.Data[CmdBuffer.Size - 1];\par
00544     {\cf19 if} (curr_cmd->ElemCount != 0 && curr_cmd->TextureId != _CmdHeader.TextureId)\par
00545     \{\par
00546         AddDrawCmd();\par
00547         {\cf19 return};\par
00548     \}\par
00549     IM_ASSERT(curr_cmd->UserCallback == NULL);\par
00550 \par
00551     {\cf20 // Try to merge with previous command if it matches, else use current command}\par
00552     ImDrawCmd* prev_cmd = curr_cmd - 1;\par
00553     {\cf19 if} (curr_cmd->ElemCount == 0 && CmdBuffer.Size > 1 && ImDrawCmd_HeaderCompare(&_CmdHeader, prev_cmd) == 0 && ImDrawCmd_AreSequentialIdxOffset(prev_cmd, curr_cmd) && prev_cmd->UserCallback == NULL)\par
00554     \{\par
00555         CmdBuffer.pop_back();\par
00556         {\cf19 return};\par
00557     \}\par
