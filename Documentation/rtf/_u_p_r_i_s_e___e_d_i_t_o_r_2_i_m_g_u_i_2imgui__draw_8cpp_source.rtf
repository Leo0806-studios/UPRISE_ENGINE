02477     {\cf19 if} (!TexPixelsRGBA32)\par
02478     \{\par
02479         {\cf18 unsigned} {\cf18 char}* pixels = NULL;\par
02480         GetTexDataAsAlpha8(&pixels, NULL, NULL);\par
