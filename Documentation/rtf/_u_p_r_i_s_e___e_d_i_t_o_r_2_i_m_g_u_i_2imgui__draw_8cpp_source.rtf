04029     {\cf19 if} (y > clip_rect.w)\par
04030         {\cf19 return};\par
04031 \par
04032     {\cf17 const} {\cf18 float} start_x = x;\par
04033     {\cf17 const} {\cf18 float} scale = size / FontSize;\par
04034     {\cf17 const} {\cf18 float} line_height = FontSize * scale;\par
04035     {\cf17 const} {\cf18 bool} word_wrap_enabled = (wrap_width > 0.0f);\par
04036 \par
04037     {\cf20 // Fast-forward to first visible line}\par
04038     {\cf17 const} {\cf18 char}* s = text_begin;\par
04039     {\cf19 if} (y + line_height < clip_rect.y)\par
04040         {\cf19 while} (y + line_height < clip_rect.y && s < text_end)\par
04041         \{\par
04042             {\cf17 const} {\cf18 char}* line_end = ({\cf17 const} {\cf18 char}*)memchr(s, {\cf23 '\\n'}, text_end - s);\par
04043             {\cf19 if} (word_wrap_enabled)\par
04044             \{\par
04045                 {\cf20 // FIXME-OPT: This is not optimal as do first do a search for \\n before calling CalcWordWrapPositionA().}\par
04046                 {\cf20 // If the specs for CalcWordWrapPositionA() were reworked to optionally return on \\n we could combine both.}\par
04047                 {\cf20 // However it is still better than nothing performing the fast-forward!}\par
04048                 s = CalcWordWrapPositionA(scale, s, line_end ? line_end : text_end, wrap_width);\par
04049                 s = CalcWordWrapNextLineStartA(s, text_end);\par
04050             \}\par
04051             {\cf19 else}\par
04052             \{\par
04053                 s = line_end ? line_end + 1 : text_end;\par
04054             \}\par
04055             y += line_height;\par
04056         \}\par
04057 \par
04058     {\cf20 // For large text, scan for the last visible line in order to avoid over-reserving in the call to PrimReserve()}\par
