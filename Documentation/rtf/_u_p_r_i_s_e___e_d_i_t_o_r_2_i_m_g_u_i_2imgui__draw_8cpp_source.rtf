00718 {\cf20 // On AddPolyline() and AddConvexPolyFilled() we intentionally avoid using ImVec2 and superfluous function calls to optimize debug/non-inlined builds.}\par
00719 {\cf20 // - Those macros expects l-values and need to be used as their own statement.}\par
00720 {\cf20 // - Those macros are intentionally not surrounded by the 'do \{\} while (0)' idiom because even that translates to runtime with debug compilers.}\par
00721 {\cf21 #define IM_NORMALIZE2F_OVER_ZERO(VX,VY)     \{ float d2 = VX*VX + VY*VY; if (d2 > 0.0f) \{ float inv_len = ImRsqrt(d2); VX *= inv_len; VY *= inv_len; \} \} (void)0}\par
00722 {\cf21 #define IM_FIXNORMAL2F_MAX_INVLEN2          100.0f }{\cf20 // 500.0f (see #4053, #3366)}\par
00723 {\cf21 #define IM_FIXNORMAL2F(VX,VY)               \{ float d2 = VX*VX + VY*VY; if (d2 > 0.000001f) \{ float inv_len2 = 1.0f / d2; if (inv_len2 > IM_FIXNORMAL2F_MAX_INVLEN2) inv_len2 = IM_FIXNORMAL2F_MAX_INVLEN2; VX *= inv_len2; VY *= inv_len2; \} \} (void)0}\par
00724 \par
00725 {\cf20 // TODO: Thickness anti-aliased lines cap are missing their AA fringe.}\par
00726 {\cf20 // We avoid using the ImVec2 math operators here to reduce cost to a minimum for debug/non-inlined builds.}\par
00727 {\cf18 void} ImDrawList::AddPolyline({\cf17 const} ImVec2* points, {\cf17 const} {\cf18 int} points_count, ImU32 col, ImDrawFlags flags, {\cf18 float} thickness)\par
00728 \{\par
00729     {\cf19 if} (points_count < 2 || (col & IM_COL32_A_MASK) == 0)\par
00730         {\cf19 return};\par
00731 \par
00732     {\cf17 const} {\cf18 bool} closed = (flags & ImDrawFlags_Closed) != 0;\par
00733     {\cf17 const} ImVec2 opaque_uv = _Data->TexUvWhitePixel;\par
00734     {\cf17 const} {\cf18 int} count = closed ? points_count : points_count - 1; {\cf20 // The number of line segments we need to draw}\par
00735     {\cf17 const} {\cf18 bool} thick_line = (thickness > _FringeScale);\par
00736 \par
00737     {\cf19 if} (Flags & ImDrawListFlags_AntiAliasedLines)\par
00738     \{\par
00739         {\cf20 // Anti-aliased stroke}\par
00740         {\cf17 const} {\cf18 float} AA_SIZE = _FringeScale;\par
00741         {\cf17 const} ImU32 col_trans = col & ~IM_COL32_A_MASK;\par
00742 \par
00743         {\cf20 // Thicknesses <1.0 should behave like thickness 1.0}\par
00744         thickness = ImMax(thickness, 1.0f);\par
00745         {\cf17 const} {\cf18 int} integer_thickness = (int)thickness;\par
00746         {\cf17 const} {\cf18 float} fractional_thickness = thickness - integer_thickness;\par
00747 \par
00748         {\cf20 // Do we want to draw this line using a texture?}\par
00749         {\cf20 // - For now, only draw integer-width lines using textures to avoid issues with the way scaling occurs, could be improved.}\par
00750         {\cf20 // - If AA_SIZE is not 1.0f we cannot use the texture path.}\par
00751         {\cf17 const} {\cf18 bool} use_texture = (Flags & ImDrawListFlags_AntiAliasedLinesUseTex) && (integer_thickness < IM_DRAWLIST_TEX_LINES_WIDTH_MAX) && (fractional_thickness <= 0.00001f) && (AA_SIZE == 1.0f);\par
00752 \par
00753         {\cf20 // We should never hit this, because NewFrame() doesn't set ImDrawListFlags_AntiAliasedLinesUseTex unless ImFontAtlasFlags_NoBakedLines is off}\par
00754         IM_ASSERT_PARANOID(!use_texture || !(_Data->Font->ContainerAtlas->Flags & ImFontAtlasFlags_NoBakedLines));\par
00755 \par
00756         {\cf17 const} {\cf18 int} idx_count = use_texture ? (count * 6) : (thick_line ? count * 18 : count * 12);\par
00757         {\cf17 const} {\cf18 int} vtx_count = use_texture ? (points_count * 2) : (thick_line ? points_count * 4 : points_count * 3);\par
00758         PrimReserve(idx_count, vtx_count);\par
00759 \par
00760         {\cf20 // Temporary buffer}\par
00761         {\cf20 // The first <points_count> items are normals at each line point, then after that there are either 2 or 4 temp points for each line point}\par
00762         _Data->TempBuffer.reserve_discard(points_count * ((use_texture || !thick_line) ? 3 : 5));\par
00763         ImVec2* temp_normals = _Data->TempBuffer.Data;\par
00764         ImVec2* temp_points = temp_normals + points_count;\par
00765 \par
00766         {\cf20 // Calculate normals (tangents) for each line segment}\par
00767         {\cf19 for} ({\cf18 int} i1 = 0; i1 < count; i1++)\par
00768         \{\par
00769             {\cf17 const} {\cf18 int} i2 = (i1 + 1) == points_count ? 0 : i1 + 1;\par
00770             {\cf18 float} dx = points[i2].x - points[i1].x;\par
00771             {\cf18 float} dy = points[i2].y - points[i1].y;\par
00772             IM_NORMALIZE2F_OVER_ZERO(dx, dy);\par
00773             temp_normals[i1].x = dy;\par
00774             temp_normals[i1].y = -dx;\par
00775         \}\par
00776         {\cf19 if} (!closed)\par
00777             temp_normals[points_count - 1] = temp_normals[points_count - 2];\par
00778 \par
00779         {\cf20 // If we are drawing a one-pixel-wide line without a texture, or a textured line of any width, we only need 2 or 3 vertices per point}\par
00780         {\cf19 if} (use_texture || !thick_line)\par
00781         \{\par
00782             {\cf20 // [PATH 1] Texture-based lines (thick or non-thick)}\par
00783             {\cf20 // [PATH 2] Non texture-based lines (non-thick)}\par
00784 \par
00785             {\cf20 // The width of the geometry we need to draw - this is essentially <thickness> pixels for the line itself, plus "one pixel" for AA.}\par
00786             {\cf20 // - In the texture-based path, we don't use AA_SIZE here because the +1 is tied to the generated texture}\par
00787             {\cf20 //   (see ImFontAtlasBuildRenderLinesTexData() function), and so alternate values won't work without changes to that code.}\par
00788             {\cf20 // - In the non texture-based paths, we would allow AA_SIZE to potentially be != 1.0f with a patch (e.g. fringe_scale patch to}\par
00789             {\cf20 //   allow scaling geometry while preserving one-screen-pixel AA fringe).}\par
00790             {\cf17 const} {\cf18 float} half_draw_size = use_texture ? ((thickness * 0.5f) + 1) : AA_SIZE;\par
00791 \par
00792             {\cf20 // If line is not closed, the first and last points need to be generated differently as there are no normals to blend}\par
00793             {\cf19 if} (!closed)\par
00794             \{\par
00795                 temp_points[0] = points[0] + temp_normals[0] * half_draw_size;\par
00796                 temp_points[1] = points[0] - temp_normals[0] * half_draw_size;\par
00797                 temp_points[(points_count-1)*2+0] = points[points_count-1] + temp_normals[points_count-1] * half_draw_size;\par
00798                 temp_points[(points_count-1)*2+1] = points[points_count-1] - temp_normals[points_count-1] * half_draw_size;\par
00799             \}\par
00800 \par
00801             {\cf20 // Generate the indices to form a number of triangles for each line segment, and the vertices for the line edges}\par
00802             {\cf20 // This takes points n and n+1 and writes into n+1, with the first point in a closed line being generated from the final one (as n+1 wraps)}\par
00803             {\cf20 // FIXME-OPT: Merge the different loops, possibly remove the temporary buffer.}\par
00804             {\cf18 unsigned} {\cf18 int} idx1 = _VtxCurrentIdx; {\cf20 // Vertex index for start of line segment}\par
00805             {\cf19 for} ({\cf18 int} i1 = 0; i1 < count; i1++) {\cf20 // i1 is the first point of the line segment}\par
00806             \{\par
00807                 {\cf17 const} {\cf18 int} i2 = (i1 + 1) == points_count ? 0 : i1 + 1; {\cf20 // i2 is the second point of the line segment}\par
00808                 {\cf17 const} {\cf18 unsigned} {\cf18 int} idx2 = ((i1 + 1) == points_count) ? _VtxCurrentIdx : (idx1 + (use_texture ? 2 : 3)); {\cf20 // Vertex index for end of segment}\par
00809 \par
00810                 {\cf20 // Average normals}\par
00811                 {\cf18 float} dm_x = (temp_normals[i1].x + temp_normals[i2].x) * 0.5f;\par
00812                 {\cf18 float} dm_y = (temp_normals[i1].y + temp_normals[i2].y) * 0.5f;\par
00813                 IM_FIXNORMAL2F(dm_x, dm_y);\par
00814                 dm_x *= half_draw_size; {\cf20 // dm_x, dm_y are offset to the outer edge of the AA area}\par
00815                 dm_y *= half_draw_size;\par
00816 \par
00817                 {\cf20 // Add temporary vertexes for the outer edges}\par
00818                 ImVec2* out_vtx = &temp_points[i2 * 2];\par
00819                 out_vtx[0].x = points[i2].x + dm_x;\par
00820                 out_vtx[0].y = points[i2].y + dm_y;\par
00821                 out_vtx[1].x = points[i2].x - dm_x;\par
00822                 out_vtx[1].y = points[i2].y - dm_y;\par
00823 \par
00824                 {\cf19 if} (use_texture)\par
00825                 \{\par
00826                     {\cf20 // Add indices for two triangles}\par
00827                     _IdxWritePtr[0] = (ImDrawIdx)(idx2 + 0); _IdxWritePtr[1] = (ImDrawIdx)(idx1 + 0); _IdxWritePtr[2] = (ImDrawIdx)(idx1 + 1); {\cf20 // Right tri}\par
00828                     _IdxWritePtr[3] = (ImDrawIdx)(idx2 + 1); _IdxWritePtr[4] = (ImDrawIdx)(idx1 + 1); _IdxWritePtr[5] = (ImDrawIdx)(idx2 + 0); {\cf20 // Left tri}\par
00829                     _IdxWritePtr += 6;\par
00830                 \}\par
00831                 {\cf19 else}\par
00832                 \{\par
00833                     {\cf20 // Add indexes for four triangles}\par
00834                     _IdxWritePtr[0] = (ImDrawIdx)(idx2 + 0); _IdxWritePtr[1] = (ImDrawIdx)(idx1 + 0); _IdxWritePtr[2] = (ImDrawIdx)(idx1 + 2); {\cf20 // Right tri 1}\par
00835                     _IdxWritePtr[3] = (ImDrawIdx)(idx1 + 2); _IdxWritePtr[4] = (ImDrawIdx)(idx2 + 2); _IdxWritePtr[5] = (ImDrawIdx)(idx2 + 0); {\cf20 // Right tri 2}\par
00836                     _IdxWritePtr[6] = (ImDrawIdx)(idx2 + 1); _IdxWritePtr[7] = (ImDrawIdx)(idx1 + 1); _IdxWritePtr[8] = (ImDrawIdx)(idx1 + 0); {\cf20 // Left tri 1}\par
00837                     _IdxWritePtr[9] = (ImDrawIdx)(idx1 + 0); _IdxWritePtr[10] = (ImDrawIdx)(idx2 + 0); _IdxWritePtr[11] = (ImDrawIdx)(idx2 + 1); {\cf20 // Left tri 2}\par
00838                     _IdxWritePtr += 12;\par
00839                 \}\par
00840 \par
00841                 idx1 = idx2;\par
00842             \}\par
00843 \par
00844             {\cf20 // Add vertexes for each point on the line}\par
00845             {\cf19 if} (use_texture)\par
00846             \{\par
00847                 {\cf20 // If we're using textures we only need to emit the left/right edge vertices}\par
00848                 ImVec4 tex_uvs = _Data->TexUvLines[integer_thickness];\par
00849                 {\cf20 /*if (fractional_thickness != 0.0f) // Currently always zero when use_texture==false!}\par
00850 {\cf20                 \{}\par
00851 {\cf20                     const ImVec4 tex_uvs_1 = _Data->TexUvLines[integer_thickness + 1];}\par
00852 {\cf20                     tex_uvs.x = tex_uvs.x + (tex_uvs_1.x - tex_uvs.x) * fractional_thickness; // inlined ImLerp()}\par
00853 {\cf20                     tex_uvs.y = tex_uvs.y + (tex_uvs_1.y - tex_uvs.y) * fractional_thickness;}\par
00854 {\cf20                     tex_uvs.z = tex_uvs.z + (tex_uvs_1.z - tex_uvs.z) * fractional_thickness;}\par
00855 {\cf20                     tex_uvs.w = tex_uvs.w + (tex_uvs_1.w - tex_uvs.w) * fractional_thickness;}\par
00856 {\cf20                 \}*/}\par
00857                 ImVec2 tex_uv0(tex_uvs.x, tex_uvs.y);\par
00858                 ImVec2 tex_uv1(tex_uvs.z, tex_uvs.w);\par
00859                 {\cf19 for} ({\cf18 int} i = 0; i < points_count; i++)\par
00860                 \{\par
00861                     _VtxWritePtr[0].pos = temp_points[i * 2 + 0]; _VtxWritePtr[0].uv = tex_uv0; _VtxWritePtr[0].col = col; {\cf20 // Left-side outer edge}\par
00862                     _VtxWritePtr[1].pos = temp_points[i * 2 + 1]; _VtxWritePtr[1].uv = tex_uv1; _VtxWritePtr[1].col = col; {\cf20 // Right-side outer edge}\par
00863                     _VtxWritePtr += 2;\par
00864                 \}\par
00865             \}\par
00866             {\cf19 else}\par
00867             \{\par
00868                 {\cf20 // If we're not using a texture, we need the center vertex as well}\par
00869                 {\cf19 for} ({\cf18 int} i = 0; i < points_count; i++)\par
00870                 \{\par
00871                     _VtxWritePtr[0].pos = points[i];              _VtxWritePtr[0].uv = opaque_uv; _VtxWritePtr[0].col = col;       {\cf20 // Center of line}\par
00872                     _VtxWritePtr[1].pos = temp_points[i * 2 + 0]; _VtxWritePtr[1].uv = opaque_uv; _VtxWritePtr[1].col = col_trans; {\cf20 // Left-side outer edge}\par
00873                     _VtxWritePtr[2].pos = temp_points[i * 2 + 1]; _VtxWritePtr[2].uv = opaque_uv; _VtxWritePtr[2].col = col_trans; {\cf20 // Right-side outer edge}\par
00874                     _VtxWritePtr += 3;\par
00875                 \}\par
00876             \}\par
00877         \}\par
00878         {\cf19 else}\par
00879         \{\par
00880             {\cf20 // [PATH 2] Non texture-based lines (thick): we need to draw the solid line core and thus require four vertices per point}\par
00881             {\cf17 const} {\cf18 float} half_inner_thickness = (thickness - AA_SIZE) * 0.5f;\par
00882 \par
00883             {\cf20 // If line is not closed, the first and last points need to be generated differently as there are no normals to blend}\par
00884             {\cf19 if} (!closed)\par
00885             \{\par
00886                 {\cf17 const} {\cf18 int} points_last = points_count - 1;\par
00887                 temp_points[0] = points[0] + temp_normals[0] * (half_inner_thickness + AA_SIZE);\par
00888                 temp_points[1] = points[0] + temp_normals[0] * (half_inner_thickness);\par
00889                 temp_points[2] = points[0] - temp_normals[0] * (half_inner_thickness);\par
00890                 temp_points[3] = points[0] - temp_normals[0] * (half_inner_thickness + AA_SIZE);\par
00891                 temp_points[points_last * 4 + 0] = points[points_last] + temp_normals[points_last] * (half_inner_thickness + AA_SIZE);\par
00892                 temp_points[points_last * 4 + 1] = points[points_last] + temp_normals[points_last] * (half_inner_thickness);\par
00893                 temp_points[points_last * 4 + 2] = points[points_last] - temp_normals[points_last] * (half_inner_thickness);\par
00894                 temp_points[points_last * 4 + 3] = points[points_last] - temp_normals[points_last] * (half_inner_thickness + AA_SIZE);\par
00895             \}\par
00896 \par
00897             {\cf20 // Generate the indices to form a number of triangles for each line segment, and the vertices for the line edges}\par
00898             {\cf20 // This takes points n and n+1 and writes into n+1, with the first point in a closed line being generated from the final one (as n+1 wraps)}\par
00899             {\cf20 // FIXME-OPT: Merge the different loops, possibly remove the temporary buffer.}\par
00900             {\cf18 unsigned} {\cf18 int} idx1 = _VtxCurrentIdx; {\cf20 // Vertex index for start of line segment}\par
00901             {\cf19 for} ({\cf18 int} i1 = 0; i1 < count; i1++) {\cf20 // i1 is the first point of the line segment}\par
00902             \{\par
00903                 {\cf17 const} {\cf18 int} i2 = (i1 + 1) == points_count ? 0 : (i1 + 1); {\cf20 // i2 is the second point of the line segment}\par
00904                 {\cf17 const} {\cf18 unsigned} {\cf18 int} idx2 = (i1 + 1) == points_count ? _VtxCurrentIdx : (idx1 + 4); {\cf20 // Vertex index for end of segment}\par
00905 \par
00906                 {\cf20 // Average normals}\par
00907                 {\cf18 float} dm_x = (temp_normals[i1].x + temp_normals[i2].x) * 0.5f;\par
00908                 {\cf18 float} dm_y = (temp_normals[i1].y + temp_normals[i2].y) * 0.5f;\par
00909                 IM_FIXNORMAL2F(dm_x, dm_y);\par
00910                 {\cf18 float} dm_out_x = dm_x * (half_inner_thickness + AA_SIZE);\par
00911                 {\cf18 float} dm_out_y = dm_y * (half_inner_thickness + AA_SIZE);\par
00912                 {\cf18 float} dm_in_x = dm_x * half_inner_thickness;\par
00913                 {\cf18 float} dm_in_y = dm_y * half_inner_thickness;\par
00914 \par
00915                 {\cf20 // Add temporary vertices}\par
00916                 ImVec2* out_vtx = &temp_points[i2 * 4];\par
00917                 out_vtx[0].x = points[i2].x + dm_out_x;\par
00918                 out_vtx[0].y = points[i2].y + dm_out_y;\par
00919                 out_vtx[1].x = points[i2].x + dm_in_x;\par
00920                 out_vtx[1].y = points[i2].y + dm_in_y;\par
00921                 out_vtx[2].x = points[i2].x - dm_in_x;\par
00922                 out_vtx[2].y = points[i2].y - dm_in_y;\par
00923                 out_vtx[3].x = points[i2].x - dm_out_x;\par
00924                 out_vtx[3].y = points[i2].y - dm_out_y;\par
00925 \par
00926                 {\cf20 // Add indexes}\par
00927                 _IdxWritePtr[0]  = (ImDrawIdx)(idx2 + 1); _IdxWritePtr[1]  = (ImDrawIdx)(idx1 + 1); _IdxWritePtr[2]  = (ImDrawIdx)(idx1 + 2);\par
00928                 _IdxWritePtr[3]  = (ImDrawIdx)(idx1 + 2); _IdxWritePtr[4]  = (ImDrawIdx)(idx2 + 2); _IdxWritePtr[5]  = (ImDrawIdx)(idx2 + 1);\par
00929                 _IdxWritePtr[6]  = (ImDrawIdx)(idx2 + 1); _IdxWritePtr[7]  = (ImDrawIdx)(idx1 + 1); _IdxWritePtr[8]  = (ImDrawIdx)(idx1 + 0);\par
00930                 _IdxWritePtr[9]  = (ImDrawIdx)(idx1 + 0); _IdxWritePtr[10] = (ImDrawIdx)(idx2 + 0); _IdxWritePtr[11] = (ImDrawIdx)(idx2 + 1);\par
00931                 _IdxWritePtr[12] = (ImDrawIdx)(idx2 + 2); _IdxWritePtr[13] = (ImDrawIdx)(idx1 + 2); _IdxWritePtr[14] = (ImDrawIdx)(idx1 + 3);\par
00932                 _IdxWritePtr[15] = (ImDrawIdx)(idx1 + 3); _IdxWritePtr[16] = (ImDrawIdx)(idx2 + 3); _IdxWritePtr[17] = (ImDrawIdx)(idx2 + 2);\par
00933                 _IdxWritePtr += 18;\par
00934 \par
00935                 idx1 = idx2;\par
00936             \}\par
00937 \par
00938             {\cf20 // Add vertices}\par
00939             {\cf19 for} ({\cf18 int} i = 0; i < points_count; i++)\par
00940             \{\par
00941                 _VtxWritePtr[0].pos = temp_points[i * 4 + 0]; _VtxWritePtr[0].uv = opaque_uv; _VtxWritePtr[0].col = col_trans;\par
00942                 _VtxWritePtr[1].pos = temp_points[i * 4 + 1]; _VtxWritePtr[1].uv = opaque_uv; _VtxWritePtr[1].col = col;\par
00943                 _VtxWritePtr[2].pos = temp_points[i * 4 + 2]; _VtxWritePtr[2].uv = opaque_uv; _VtxWritePtr[2].col = col;\par
00944                 _VtxWritePtr[3].pos = temp_points[i * 4 + 3]; _VtxWritePtr[3].uv = opaque_uv; _VtxWritePtr[3].col = col_trans;\par
00945                 _VtxWritePtr += 4;\par
00946             \}\par
00947         \}\par
00948         _VtxCurrentIdx += (ImDrawIdx)vtx_count;\par
00949     \}\par
00950     {\cf19 else}\par
00951     \{\par
00952         {\cf20 // [PATH 4] Non texture-based, Non anti-aliased lines}\par
00953         {\cf17 const} {\cf18 int} idx_count = count * 6;\par
00954         {\cf17 const} {\cf18 int} vtx_count = count * 4;    {\cf20 // FIXME-OPT: Not sharing edges}\par
00955         PrimReserve(idx_count, vtx_count);\par
00956 \par
00957         {\cf19 for} ({\cf18 int} i1 = 0; i1 < count; i1++)\par
00958         \{\par
00959             {\cf17 const} {\cf18 int} i2 = (i1 + 1) == points_count ? 0 : i1 + 1;\par
00960             {\cf17 const} ImVec2& p1 = points[i1];\par
00961             {\cf17 const} ImVec2& p2 = points[i2];\par
00962 \par
00963             {\cf18 float} dx = p2.x - p1.x;\par
00964             {\cf18 float} dy = p2.y - p1.y;\par
00965             IM_NORMALIZE2F_OVER_ZERO(dx, dy);\par
00966             dx *= (thickness * 0.5f);\par
00967             dy *= (thickness * 0.5f);\par
00968 \par
00969             _VtxWritePtr[0].pos.x = p1.x + dy; _VtxWritePtr[0].pos.y = p1.y - dx; _VtxWritePtr[0].uv = opaque_uv; _VtxWritePtr[0].col = col;\par
00970             _VtxWritePtr[1].pos.x = p2.x + dy; _VtxWritePtr[1].pos.y = p2.y - dx; _VtxWritePtr[1].uv = opaque_uv; _VtxWritePtr[1].col = col;\par
00971             _VtxWritePtr[2].pos.x = p2.x - dy; _VtxWritePtr[2].pos.y = p2.y + dx; _VtxWritePtr[2].uv = opaque_uv; _VtxWritePtr[2].col = col;\par
00972             _VtxWritePtr[3].pos.x = p1.x - dy; _VtxWritePtr[3].pos.y = p1.y + dx; _VtxWritePtr[3].uv = opaque_uv; _VtxWritePtr[3].col = col;\par
00973             _VtxWritePtr += 4;\par
00974 \par
00975             _IdxWritePtr[0] = (ImDrawIdx)(_VtxCurrentIdx); _IdxWritePtr[1] = (ImDrawIdx)(_VtxCurrentIdx + 1); _IdxWritePtr[2] = (ImDrawIdx)(_VtxCurrentIdx + 2);\par
00976             _IdxWritePtr[3] = (ImDrawIdx)(_VtxCurrentIdx); _IdxWritePtr[4] = (ImDrawIdx)(_VtxCurrentIdx + 2); _IdxWritePtr[5] = (ImDrawIdx)(_VtxCurrentIdx + 3);\par
00977             _IdxWritePtr += 6;\par
00978             _VtxCurrentIdx += 4;\par
00979         \}\par
00980     \}\par
00981 \}\par
00982 \par
00983 {\cf20 // - We intentionally avoid using ImVec2 and its math operators here to reduce cost to a minimum for debug/non-inlined builds.}\par
00984 {\cf20 // - Filled shapes must always use clockwise winding order. The anti-aliasing fringe depends on it. Counter-clockwise shapes will have "inward" anti-aliasing.}\par
00985 {\cf18 void} ImDrawList::AddConvexPolyFilled({\cf17 const} ImVec2* points, {\cf17 const} {\cf18 int} points_count, ImU32 col)\par
00986 \{\par
00987     {\cf19 if} (points_count < 3 || (col & IM_COL32_A_MASK) == 0)\par
00988         {\cf19 return};\par
00989 \par
00990     {\cf17 const} ImVec2 uv = _Data->TexUvWhitePixel;\par
00991 \par
00992     {\cf19 if} (Flags & ImDrawListFlags_AntiAliasedFill)\par
00993     \{\par
00994         {\cf20 // Anti-aliased Fill}\par
00995         {\cf17 const} {\cf18 float} AA_SIZE = _FringeScale;\par
00996         {\cf17 const} ImU32 col_trans = col & ~IM_COL32_A_MASK;\par
00997         {\cf17 const} {\cf18 int} idx_count = (points_count - 2)*3 + points_count * 6;\par
00998         {\cf17 const} {\cf18 int} vtx_count = (points_count * 2);\par
00999         PrimReserve(idx_count, vtx_count);\par
01000 \par
01001         {\cf20 // Add indexes for fill}\par
01002         {\cf18 unsigned} {\cf18 int} vtx_inner_idx = _VtxCurrentIdx;\par
01003         {\cf18 unsigned} {\cf18 int} vtx_outer_idx = _VtxCurrentIdx + 1;\par
01004         {\cf19 for} ({\cf18 int} i = 2; i < points_count; i++)\par
01005         \{\par
01006             _IdxWritePtr[0] = (ImDrawIdx)(vtx_inner_idx); _IdxWritePtr[1] = (ImDrawIdx)(vtx_inner_idx + ((i - 1) << 1)); _IdxWritePtr[2] = (ImDrawIdx)(vtx_inner_idx + (i << 1));\par
01007             _IdxWritePtr += 3;\par
01008         \}\par
01009 \par
01010         {\cf20 // Compute normals}\par
01011         _Data->TempBuffer.reserve_discard(points_count);\par
01012         ImVec2* temp_normals = _Data->TempBuffer.Data;\par
01013         {\cf19 for} ({\cf18 int} i0 = points_count - 1, i1 = 0; i1 < points_count; i0 = i1++)\par
01014         \{\par
01015             {\cf17 const} ImVec2& p0 = points[i0];\par
01016             {\cf17 const} ImVec2& p1 = points[i1];\par
01017             {\cf18 float} dx = p1.x - p0.x;\par
01018             {\cf18 float} dy = p1.y - p0.y;\par
01019             IM_NORMALIZE2F_OVER_ZERO(dx, dy);\par
01020             temp_normals[i0].x = dy;\par
01021             temp_normals[i0].y = -dx;\par
01022         \}\par
01023 \par
01024         {\cf19 for} ({\cf18 int} i0 = points_count - 1, i1 = 0; i1 < points_count; i0 = i1++)\par
01025         \{\par
01026             {\cf20 // Average normals}\par
01027             {\cf17 const} ImVec2& n0 = temp_normals[i0];\par
01028             {\cf17 const} ImVec2& n1 = temp_normals[i1];\par
01029             {\cf18 float} dm_x = (n0.x + n1.x) * 0.5f;\par
01030             {\cf18 float} dm_y = (n0.y + n1.y) * 0.5f;\par
01031             IM_FIXNORMAL2F(dm_x, dm_y);\par
01032             dm_x *= AA_SIZE * 0.5f;\par
01033             dm_y *= AA_SIZE * 0.5f;\par
01034 \par
01035             {\cf20 // Add vertices}\par
01036             _VtxWritePtr[0].pos.x = (points[i1].x - dm_x); _VtxWritePtr[0].pos.y = (points[i1].y - dm_y); _VtxWritePtr[0].uv = uv; _VtxWritePtr[0].col = col;        {\cf20 // Inner}\par
01037             _VtxWritePtr[1].pos.x = (points[i1].x + dm_x); _VtxWritePtr[1].pos.y = (points[i1].y + dm_y); _VtxWritePtr[1].uv = uv; _VtxWritePtr[1].col = col_trans;  {\cf20 // Outer}\par
01038             _VtxWritePtr += 2;\par
01039 \par
01040             {\cf20 // Add indexes for fringes}\par
01041             _IdxWritePtr[0] = (ImDrawIdx)(vtx_inner_idx + (i1 << 1)); _IdxWritePtr[1] = (ImDrawIdx)(vtx_inner_idx + (i0 << 1)); _IdxWritePtr[2] = (ImDrawIdx)(vtx_outer_idx + (i0 << 1));\par
01042             _IdxWritePtr[3] = (ImDrawIdx)(vtx_outer_idx + (i0 << 1)); _IdxWritePtr[4] = (ImDrawIdx)(vtx_outer_idx + (i1 << 1)); _IdxWritePtr[5] = (ImDrawIdx)(vtx_inner_idx + (i1 << 1));\par
01043             _IdxWritePtr += 6;\par
01044         \}\par
01045         _VtxCurrentIdx += (ImDrawIdx)vtx_count;\par
01046     \}\par
01047     {\cf19 else}\par
01048     \{\par
01049         {\cf20 // Non Anti-aliased Fill}\par
01050         {\cf17 const} {\cf18 int} idx_count = (points_count - 2)*3;\par
01051         {\cf17 const} {\cf18 int} vtx_count = points_count;\par
01052         PrimReserve(idx_count, vtx_count);\par
01053         {\cf19 for} ({\cf18 int} i = 0; i < vtx_count; i++)\par
01054         \{\par
01055             _VtxWritePtr[0].pos = points[i]; _VtxWritePtr[0].uv = uv; _VtxWritePtr[0].col = col;\par
01056             _VtxWritePtr++;\par
01057         \}\par
01058         {\cf19 for} ({\cf18 int} i = 2; i < points_count; i++)\par
01059         \{\par
01060             _IdxWritePtr[0] = (ImDrawIdx)(_VtxCurrentIdx); _IdxWritePtr[1] = (ImDrawIdx)(_VtxCurrentIdx + i - 1); _IdxWritePtr[2] = (ImDrawIdx)(_VtxCurrentIdx + i);\par
01061             _IdxWritePtr += 3;\par
01062         \}\par
01063         _VtxCurrentIdx += (ImDrawIdx)vtx_count;\par
01064     \}\par
01065 \}\par
01066 \par
01067 {\cf18 void} ImDrawList::_PathArcToFastEx({\cf17 const} ImVec2& center, {\cf18 float} radius, {\cf18 int} a_min_sample, {\cf18 int} a_max_sample, {\cf18 int} a_step)\par
01068 \{\par
01069     {\cf19 if} (radius < 0.5f)\par
01070     \{\par
01071         _Path.push_back(center);\par
01072         {\cf19 return};\par
01073     \}\par
01074 \par
01075     {\cf20 // Calculate arc auto segment step size}\par
01076     {\cf19 if} (a_step <= 0)\par
01077         a_step = IM_DRAWLIST_ARCFAST_SAMPLE_MAX / _CalcCircleAutoSegmentCount(radius);\par
01078 \par
01079     {\cf20 // Make sure we never do steps larger than one quarter of the circle}\par
01080     a_step = ImClamp(a_step, 1, IM_DRAWLIST_ARCFAST_TABLE_SIZE / 4);\par
01081 \par
01082     {\cf17 const} {\cf18 int} sample_range = ImAbs(a_max_sample - a_min_sample);\par
01083     {\cf17 const} {\cf18 int} a_next_step = a_step;\par
01084 \par
01085     {\cf18 int} samples = sample_range + 1;\par
01086     {\cf18 bool} extra_max_sample = {\cf17 false};\par
01087     {\cf19 if} (a_step > 1)\par
01088     \{\par
01089         samples            = sample_range / a_step + 1;\par
01090         {\cf17 const} {\cf18 int} overstep = sample_range % a_step;\par
01091 \par
01092         {\cf19 if} (overstep > 0)\par
01093         \{\par
01094             extra_max_sample = {\cf17 true};\par
01095             samples++;\par
01096 \par
01097             {\cf20 // When we have overstep to avoid awkwardly looking one long line and one tiny one at the end,}\par
01098             {\cf20 // distribute first step range evenly between them by reducing first step size.}\par
01099             {\cf19 if} (sample_range > 0)\par
01100                 a_step -= (a_step - overstep) / 2;\par
01101         \}\par
01102     \}\par
01103 \par
01104     _Path.resize(_Path.Size + samples);\par
01105     ImVec2* out_ptr = _Path.Data + (_Path.Size - samples);\par
01106 \par
01107     {\cf18 int} sample_index = a_min_sample;\par
01108     {\cf19 if} (sample_index < 0 || sample_index >= IM_DRAWLIST_ARCFAST_SAMPLE_MAX)\par
01109     \{\par
01110         sample_index = sample_index % IM_DRAWLIST_ARCFAST_SAMPLE_MAX;\par
01111         {\cf19 if} (sample_index < 0)\par
01112             sample_index += IM_DRAWLIST_ARCFAST_SAMPLE_MAX;\par
01113     \}\par
01114 \par
01115     {\cf19 if} (a_max_sample >= a_min_sample)\par
01116     \{\par
01117         {\cf19 for} ({\cf18 int} a = a_min_sample; a <= a_max_sample; a += a_step, sample_index += a_step, a_step = a_next_step)\par
01118         \{\par
01119             {\cf20 // a_step is clamped to IM_DRAWLIST_ARCFAST_SAMPLE_MAX, so we have guaranteed that it will not wrap over range twice or more}\par
01120             {\cf19 if} (sample_index >= IM_DRAWLIST_ARCFAST_SAMPLE_MAX)\par
01121                 sample_index -= IM_DRAWLIST_ARCFAST_SAMPLE_MAX;\par
01122 \par
01123             {\cf17 const} ImVec2 s = _Data->ArcFastVtx[sample_index];\par
01124             out_ptr->x = center.x + s.x * radius;\par
01125             out_ptr->y = center.y + s.y * radius;\par
01126             out_ptr++;\par
01127         \}\par
01128     \}\par
01129     {\cf19 else}\par
01130     \{\par
01131         {\cf19 for} ({\cf18 int} a = a_min_sample; a >= a_max_sample; a -= a_step, sample_index -= a_step, a_step = a_next_step)\par
01132         \{\par
01133             {\cf20 // a_step is clamped to IM_DRAWLIST_ARCFAST_SAMPLE_MAX, so we have guaranteed that it will not wrap over range twice or more}\par
01134             {\cf19 if} (sample_index < 0)\par
01135                 sample_index += IM_DRAWLIST_ARCFAST_SAMPLE_MAX;\par
01136 \par
01137             {\cf17 const} ImVec2 s = _Data->ArcFastVtx[sample_index];\par
01138             out_ptr->x = center.x + s.x * radius;\par
01139             out_ptr->y = center.y + s.y * radius;\par
01140             out_ptr++;\par
01141         \}\par
01142     \}\par
01143 \par
01144     {\cf19 if} (extra_max_sample)\par
01145     \{\par
01146         {\cf18 int} normalized_max_sample = a_max_sample % IM_DRAWLIST_ARCFAST_SAMPLE_MAX;\par
01147         {\cf19 if} (normalized_max_sample < 0)\par
01148             normalized_max_sample += IM_DRAWLIST_ARCFAST_SAMPLE_MAX;\par
01149 \par
01150         {\cf17 const} ImVec2 s = _Data->ArcFastVtx[normalized_max_sample];\par
01151         out_ptr->x = center.x + s.x * radius;\par
01152         out_ptr->y = center.y + s.y * radius;\par
01153         out_ptr++;\par
01154     \}\par
01155 \par
01156     IM_ASSERT_PARANOID(_Path.Data + _Path.Size == out_ptr);\par
01157 \}\par
01158 \par
01159 {\cf18 void} ImDrawList::_PathArcToN({\cf17 const} ImVec2& center, {\cf18 float} radius, {\cf18 float} a_min, {\cf18 float} a_max, {\cf18 int} num_segments)\par
01160 \{\par
01161     {\cf19 if} (radius < 0.5f)\par
01162     \{\par
01163         _Path.push_back(center);\par
01164         {\cf19 return};\par
01165     \}\par
01166 \par
01167     {\cf20 // Note that we are adding a point at both a_min and a_max.}\par
01168     {\cf20 // If you are trying to draw a full closed circle you don't want the overlapping points!}\par
01169     _Path.reserve(_Path.Size + (num_segments + 1));\par
01170     {\cf19 for} ({\cf18 int} i = 0; i <= num_segments; i++)\par
01171     \{\par
01172         {\cf17 const} {\cf18 float} a = a_min + ((float)i / ({\cf18 float})num_segments) * (a_max - a_min);\par
01173         _Path.push_back(ImVec2(center.x + ImCos(a) * radius, center.y + ImSin(a) * radius));\par
01174     \}\par
01175 \}\par
01176 \par
01177 {\cf20 // 0: East, 3: South, 6: West, 9: North, 12: East}\par
01178 {\cf18 void} ImDrawList::PathArcToFast({\cf17 const} ImVec2& center, {\cf18 float} radius, {\cf18 int} a_min_of_12, {\cf18 int} a_max_of_12)\par
01179 \{\par
01180     {\cf19 if} (radius < 0.5f)\par
01181     \{\par
01182         _Path.push_back(center);\par
01183         {\cf19 return};\par
01184     \}\par
01185     _PathArcToFastEx(center, radius, a_min_of_12 * IM_DRAWLIST_ARCFAST_SAMPLE_MAX / 12, a_max_of_12 * IM_DRAWLIST_ARCFAST_SAMPLE_MAX / 12, 0);\par
01186 \}\par
01187 \par
01188 {\cf18 void} ImDrawList::PathArcTo({\cf17 const} ImVec2& center, {\cf18 float} radius, {\cf18 float} a_min, {\cf18 float} a_max, {\cf18 int} num_segments)\par
01189 \{\par
01190     {\cf19 if} (radius < 0.5f)\par
01191     \{\par
01192         _Path.push_back(center);\par
01193         {\cf19 return};\par
01194     \}\par
01195 \par
01196     {\cf19 if} (num_segments > 0)\par
01197     \{\par
01198         _PathArcToN(center, radius, a_min, a_max, num_segments);\par
01199         {\cf19 return};\par
01200     \}\par
01201 \par
01202     {\cf20 // Automatic segment count}\par
01203     {\cf19 if} (radius <= _Data->ArcFastRadiusCutoff)\par
01204     \{\par
01205         {\cf17 const} {\cf18 bool} a_is_reverse = a_max < a_min;\par
01206 \par
01207         {\cf20 // We are going to use precomputed values for mid samples.}\par
01208         {\cf20 // Determine first and last sample in lookup table that belong to the arc.}\par
01209         {\cf17 const} {\cf18 float} a_min_sample_f = IM_DRAWLIST_ARCFAST_SAMPLE_MAX * a_min / (IM_PI * 2.0f);\par
01210         {\cf17 const} {\cf18 float} a_max_sample_f = IM_DRAWLIST_ARCFAST_SAMPLE_MAX * a_max / (IM_PI * 2.0f);\par
01211 \par
01212         {\cf17 const} {\cf18 int} a_min_sample = a_is_reverse ? (int)ImFloor(a_min_sample_f) : (int)ImCeil(a_min_sample_f);\par
01213         {\cf17 const} {\cf18 int} a_max_sample = a_is_reverse ? (int)ImCeil(a_max_sample_f) : (int)ImFloor(a_max_sample_f);\par
01214         {\cf17 const} {\cf18 int} a_mid_samples = a_is_reverse ? ImMax(a_min_sample - a_max_sample, 0) : ImMax(a_max_sample - a_min_sample, 0);\par
01215 \par
01216         {\cf17 const} {\cf18 float} a_min_segment_angle = a_min_sample * IM_PI * 2.0f / IM_DRAWLIST_ARCFAST_SAMPLE_MAX;\par
01217         {\cf17 const} {\cf18 float} a_max_segment_angle = a_max_sample * IM_PI * 2.0f / IM_DRAWLIST_ARCFAST_SAMPLE_MAX;\par
01218         {\cf17 const} {\cf18 bool} a_emit_start = ImAbs(a_min_segment_angle - a_min) >= 1e-5f;\par
01219         {\cf17 const} {\cf18 bool} a_emit_end = ImAbs(a_max - a_max_segment_angle) >= 1e-5f;\par
01220 \par
01221         _Path.reserve(_Path.Size + (a_mid_samples + 1 + (a_emit_start ? 1 : 0) + (a_emit_end ? 1 : 0)));\par
01222         {\cf19 if} (a_emit_start)\par
01223             _Path.push_back(ImVec2(center.x + ImCos(a_min) * radius, center.y + ImSin(a_min) * radius));\par
01224         {\cf19 if} (a_mid_samples > 0)\par
01225             _PathArcToFastEx(center, radius, a_min_sample, a_max_sample, 0);\par
01226         {\cf19 if} (a_emit_end)\par
01227             _Path.push_back(ImVec2(center.x + ImCos(a_max) * radius, center.y + ImSin(a_max) * radius));\par
01228     \}\par
01229     {\cf19 else}\par
01230     \{\par
01231         {\cf17 const} {\cf18 float} arc_length = ImAbs(a_max - a_min);\par
01232         {\cf17 const} {\cf18 int} circle_segment_count = _CalcCircleAutoSegmentCount(radius);\par
01233         {\cf17 const} {\cf18 int} arc_segment_count = ImMax(({\cf18 int})ImCeil(circle_segment_count * arc_length / (IM_PI * 2.0f)), ({\cf18 int})(2.0f * IM_PI / arc_length));\par
01234         _PathArcToN(center, radius, a_min, a_max, arc_segment_count);\par
01235     \}\par
01236 \}\par
01237 \par
01238 {\cf18 void} ImDrawList::PathEllipticalArcTo({\cf17 const} ImVec2& center, {\cf17 const} ImVec2& radius, {\cf18 float} rot, {\cf18 float} a_min, {\cf18 float} a_max, {\cf18 int} num_segments)\par
01239 \{\par
01240     {\cf19 if} (num_segments <= 0)\par
01241         num_segments = _CalcCircleAutoSegmentCount(ImMax(radius.x, radius.y)); {\cf20 // A bit pessimistic, maybe there's a better computation to do here.}\par
01242 \par
01243     _Path.reserve(_Path.Size + (num_segments + 1));\par
01244 \par
01245     {\cf17 const} {\cf18 float} cos_rot = ImCos(rot);\par
01246     {\cf17 const} {\cf18 float} sin_rot = ImSin(rot);\par
01247     {\cf19 for} ({\cf18 int} i = 0; i <= num_segments; i++)\par
01248     \{\par
01249         {\cf17 const} {\cf18 float} a = a_min + ((float)i / ({\cf18 float})num_segments) * (a_max - a_min);\par
01250         ImVec2 point(ImCos(a) * radius.x, ImSin(a) * radius.y);\par
01251         {\cf17 const} ImVec2 rel((point.x * cos_rot) - (point.y * sin_rot), (point.x * sin_rot) + (point.y * cos_rot));\par
01252         point.x = rel.x + center.x;\par
01253         point.y = rel.y + center.y;\par
01254         _Path.push_back(point);\par
01255     \}\par
01256 \}\par
01257 \par
01258 ImVec2 ImBezierCubicCalc({\cf17 const} ImVec2& p1, {\cf17 const} ImVec2& p2, {\cf17 const} ImVec2& p3, {\cf17 const} ImVec2& p4, {\cf18 float} t)\par
01259 \{\par
01260     {\cf18 float} u = 1.0f - t;\par
01261     {\cf18 float} w1 = u * u * u;\par
01262     {\cf18 float} w2 = 3 * u * u * t;\par
01263     {\cf18 float} w3 = 3 * u * t * t;\par
01264     {\cf18 float} w4 = t * t * t;\par
01265     {\cf19 return} ImVec2(w1 * p1.x + w2 * p2.x + w3 * p3.x + w4 * p4.x, w1 * p1.y + w2 * p2.y + w3 * p3.y + w4 * p4.y);\par
01266 \}\par
01267 \par
01268 ImVec2 ImBezierQuadraticCalc({\cf17 const} ImVec2& p1, {\cf17 const} ImVec2& p2, {\cf17 const} ImVec2& p3, {\cf18 float} t)\par
01269 \{\par
01270     {\cf18 float} u = 1.0f - t;\par
01271     {\cf18 float} w1 = u * u;\par
01272     {\cf18 float} w2 = 2 * u * t;\par
01273     {\cf18 float} w3 = t * t;\par
01274     {\cf19 return} ImVec2(w1 * p1.x + w2 * p2.x + w3 * p3.x, w1 * p1.y + w2 * p2.y + w3 * p3.y);\par
01275 \}\par
01276 \par
01277 {\cf20 // Closely mimics ImBezierCubicClosestPointCasteljau() in imgui.cpp}\par
01278 {\cf17 static} {\cf18 void} PathBezierCubicCurveToCasteljau(ImVector<ImVec2>* path, {\cf18 float} x1, {\cf18 float} y1, {\cf18 float} x2, {\cf18 float} y2, {\cf18 float} x3, {\cf18 float} y3, {\cf18 float} x4, {\cf18 float} y4, {\cf18 float} tess_tol, {\cf18 int} level)\par
01279 \{\par
01280     {\cf18 float} dx = x4 - x1;\par
01281     {\cf18 float} dy = y4 - y1;\par
01282     {\cf18 float} d2 = (x2 - x4) * dy - (y2 - y4) * dx;\par
01283     {\cf18 float} d3 = (x3 - x4) * dy - (y3 - y4) * dx;\par
01284     d2 = (d2 >= 0) ? d2 : -d2;\par
01285     d3 = (d3 >= 0) ? d3 : -d3;\par
01286     {\cf19 if} ((d2 + d3) * (d2 + d3) < tess_tol * (dx * dx + dy * dy))\par
01287     \{\par
01288         path->push_back(ImVec2(x4, y4));\par
01289     \}\par
01290     {\cf19 else} {\cf19 if} (level < 10)\par
01291     \{\par
01292         {\cf18 float} x12 = (x1 + x2) * 0.5f, y12 = (y1 + y2) * 0.5f;\par
01293         {\cf18 float} x23 = (x2 + x3) * 0.5f, y23 = (y2 + y3) * 0.5f;\par
01294         {\cf18 float} x34 = (x3 + x4) * 0.5f, y34 = (y3 + y4) * 0.5f;\par
01295         {\cf18 float} x123 = (x12 + x23) * 0.5f, y123 = (y12 + y23) * 0.5f;\par
01296         {\cf18 float} x234 = (x23 + x34) * 0.5f, y234 = (y23 + y34) * 0.5f;\par
01297         {\cf18 float} x1234 = (x123 + x234) * 0.5f, y1234 = (y123 + y234) * 0.5f;\par
01298         PathBezierCubicCurveToCasteljau(path, x1, y1, x12, y12, x123, y123, x1234, y1234, tess_tol, level + 1);\par
01299         PathBezierCubicCurveToCasteljau(path, x1234, y1234, x234, y234, x34, y34, x4, y4, tess_tol, level + 1);\par
01300     \}\par
01301 \}\par
01302 \par
01303 {\cf17 static} {\cf18 void} PathBezierQuadraticCurveToCasteljau(ImVector<ImVec2>* path, {\cf18 float} x1, {\cf18 float} y1, {\cf18 float} x2, {\cf18 float} y2, {\cf18 float} x3, {\cf18 float} y3, {\cf18 float} tess_tol, {\cf18 int} level)\par
01304 \{\par
01305     {\cf18 float} dx = x3 - x1, dy = y3 - y1;\par
01306     {\cf18 float} det = (x2 - x3) * dy - (y2 - y3) * dx;\par
01307     {\cf19 if} (det * det * 4.0f < tess_tol * (dx * dx + dy * dy))\par
01308     \{\par
01309         path->push_back(ImVec2(x3, y3));\par
01310     \}\par
01311     {\cf19 else} {\cf19 if} (level < 10)\par
01312     \{\par
01313         {\cf18 float} x12 = (x1 + x2) * 0.5f, y12 = (y1 + y2) * 0.5f;\par
01314         {\cf18 float} x23 = (x2 + x3) * 0.5f, y23 = (y2 + y3) * 0.5f;\par
01315         {\cf18 float} x123 = (x12 + x23) * 0.5f, y123 = (y12 + y23) * 0.5f;\par
01316         PathBezierQuadraticCurveToCasteljau(path, x1, y1, x12, y12, x123, y123, tess_tol, level + 1);\par
01317         PathBezierQuadraticCurveToCasteljau(path, x123, y123, x23, y23, x3, y3, tess_tol, level + 1);\par
01318     \}\par
