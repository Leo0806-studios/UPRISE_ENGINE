02257 {\cf20 // Helper to scale the ClipRect field of each ImDrawCmd.}\par
02258 {\cf20 // Use if your final output buffer is at a different scale than draw_data->DisplaySize,}\par
02259 {\cf20 // or if there is a difference between your window resolution and framebuffer resolution.}\par
02260 {\cf18 void} ImDrawData::ScaleClipRects({\cf17 const} ImVec2& fb_scale)\par
02261 \{\par
02262     {\cf19 for} (ImDrawList* draw_list : CmdLists)\par
02263         {\cf19 for} (ImDrawCmd& cmd : draw_list->CmdBuffer)\par
02264             cmd.ClipRect = ImVec4(cmd.ClipRect.x * fb_scale.x, cmd.ClipRect.y * fb_scale.y, cmd.ClipRect.z * fb_scale.x, cmd.ClipRect.w * fb_scale.y);\par
02265 \}\par
