04305 {\cf20 // FIXME: Cleanup and move code to ImDrawList.}\par
04306 {\cf18 void} ImGui::RenderRectFilledRangeH(ImDrawList* draw_list, {\cf17 const} ImRect& rect, ImU32 col, {\cf18 float} x_start_norm, {\cf18 float} x_end_norm, {\cf18 float} rounding)\par
04307 \{\par
04308     {\cf19 if} (x_end_norm == x_start_norm)\par
04309         {\cf19 return};\par
04310     {\cf19 if} (x_start_norm > x_end_norm)\par
04311         ImSwap(x_start_norm, x_end_norm);\par
04312 \par
04313     ImVec2 p0 = ImVec2(ImLerp(rect.Min.x, rect.Max.x, x_start_norm), rect.Min.y);\par
04314     ImVec2 p1 = ImVec2(ImLerp(rect.Min.x, rect.Max.x, x_end_norm), rect.Max.y);\par
04315     {\cf19 if} (rounding == 0.0f)\par
04316     \{\par
04317         draw_list->AddRectFilled(p0, p1, col, 0.0f);\par
04318         {\cf19 return};\par
04319     \}\par
04320 \par
04321     rounding = ImClamp(ImMin((rect.Max.x - rect.Min.x) * 0.5f, (rect.Max.y - rect.Min.y) * 0.5f) - 1.0f, 0.0f, rounding);\par
04322     {\cf17 const} {\cf18 float} inv_rounding = 1.0f / rounding;\par
04323     {\cf17 const} {\cf18 float} arc0_b = ImAcos01(1.0f - (p0.x - rect.Min.x) * inv_rounding);\par
04324     {\cf17 const} {\cf18 float} arc0_e = ImAcos01(1.0f - (p1.x - rect.Min.x) * inv_rounding);\par
04325     {\cf17 const} {\cf18 float} half_pi = IM_PI * 0.5f; {\cf20 // We will == compare to this because we know this is the exact value ImAcos01 can return.}\par
04326     {\cf17 const} {\cf18 float} x0 = ImMax(p0.x, rect.Min.x + rounding);\par
04327     {\cf19 if} (arc0_b == arc0_e)\par
04328     \{\par
04329         draw_list->PathLineTo(ImVec2(x0, p1.y));\par
04330         draw_list->PathLineTo(ImVec2(x0, p0.y));\par
04331     \}\par
04332     {\cf19 else} {\cf19 if} (arc0_b == 0.0f && arc0_e == half_pi)\par
04333     \{\par
04334         draw_list->PathArcToFast(ImVec2(x0, p1.y - rounding), rounding, 3, 6); {\cf20 // BL}\par
04335         draw_list->PathArcToFast(ImVec2(x0, p0.y + rounding), rounding, 6, 9); {\cf20 // TR}\par
04336     \}\par
04337     {\cf19 else}\par
04338     \{\par
04339         draw_list->PathArcTo(ImVec2(x0, p1.y - rounding), rounding, IM_PI - arc0_e, IM_PI - arc0_b); {\cf20 // BL}\par
04340         draw_list->PathArcTo(ImVec2(x0, p0.y + rounding), rounding, IM_PI + arc0_b, IM_PI + arc0_e); {\cf20 // TR}\par
04341     \}\par
04342     {\cf19 if} (p1.x > rect.Min.x + rounding)\par
04343     \{\par
04344         {\cf17 const} {\cf18 float} arc1_b = ImAcos01(1.0f - (rect.Max.x - p1.x) * inv_rounding);\par
04345         {\cf17 const} {\cf18 float} arc1_e = ImAcos01(1.0f - (rect.Max.x - p0.x) * inv_rounding);\par
04346         {\cf17 const} {\cf18 float} x1 = ImMin(p1.x, rect.Max.x - rounding);\par
04347         {\cf19 if} (arc1_b == arc1_e)\par
04348         \{\par
04349             draw_list->PathLineTo(ImVec2(x1, p0.y));\par
04350             draw_list->PathLineTo(ImVec2(x1, p1.y));\par
04351         \}\par
04352         {\cf19 else} {\cf19 if} (arc1_b == 0.0f && arc1_e == half_pi)\par
04353         \{\par
04354             draw_list->PathArcToFast(ImVec2(x1, p0.y + rounding), rounding, 9, 12); {\cf20 // TR}\par
04355             draw_list->PathArcToFast(ImVec2(x1, p1.y - rounding), rounding, 0, 3);  {\cf20 // BR}\par
04356         \}\par
04357         {\cf19 else}\par
04358         \{\par
04359             draw_list->PathArcTo(ImVec2(x1, p0.y + rounding), rounding, -arc1_e, -arc1_b); {\cf20 // TR}\par
04360             draw_list->PathArcTo(ImVec2(x1, p1.y - rounding), rounding, +arc1_b, +arc1_e); {\cf20 // BR}\par
04361         \}\par
04362     \}\par
04363     draw_list->PathFillConvex(col);\par
04364 \}\par
