03120 {\cf17 static} {\cf18 void} ImFontAtlasBuildRenderDefaultTexData(ImFontAtlas* atlas)\par
03121 \{\par
03122     ImFontAtlasCustomRect* r = atlas->GetCustomRectByIndex(atlas->PackIdMouseCursors);\par
03123     IM_ASSERT(r->IsPacked());\par
03124 \par
03125     {\cf17 const} {\cf18 int} w = atlas->TexWidth;\par
03126     {\cf19 if} (!(atlas->Flags & ImFontAtlasFlags_NoMouseCursors))\par
03127     \{\par
03128         {\cf20 // Render/copy pixels}\par
03129         IM_ASSERT(r->Width == FONT_ATLAS_DEFAULT_TEX_DATA_W * 2 + 1 && r->Height == FONT_ATLAS_DEFAULT_TEX_DATA_H);\par
03130         {\cf17 const} {\cf18 int} x_for_white = r->X;\par
03131         {\cf17 const} {\cf18 int} x_for_black = r->X + FONT_ATLAS_DEFAULT_TEX_DATA_W + 1;\par
03132         {\cf19 if} (atlas->TexPixelsAlpha8 != NULL)\par
03133         \{\par
03134             ImFontAtlasBuildRender8bppRectFromString(atlas, x_for_white, r->Y, FONT_ATLAS_DEFAULT_TEX_DATA_W, FONT_ATLAS_DEFAULT_TEX_DATA_H, FONT_ATLAS_DEFAULT_TEX_DATA_PIXELS, {\cf23 '.'}, 0xFF);\par
03135             ImFontAtlasBuildRender8bppRectFromString(atlas, x_for_black, r->Y, FONT_ATLAS_DEFAULT_TEX_DATA_W, FONT_ATLAS_DEFAULT_TEX_DATA_H, FONT_ATLAS_DEFAULT_TEX_DATA_PIXELS, {\cf23 'X'}, 0xFF);\par
03136         \}\par
03137         {\cf19 else}\par
03138         \{\par
03139             ImFontAtlasBuildRender32bppRectFromString(atlas, x_for_white, r->Y, FONT_ATLAS_DEFAULT_TEX_DATA_W, FONT_ATLAS_DEFAULT_TEX_DATA_H, FONT_ATLAS_DEFAULT_TEX_DATA_PIXELS, {\cf23 '.'}, IM_COL32_WHITE);\par
03140             ImFontAtlasBuildRender32bppRectFromString(atlas, x_for_black, r->Y, FONT_ATLAS_DEFAULT_TEX_DATA_W, FONT_ATLAS_DEFAULT_TEX_DATA_H, FONT_ATLAS_DEFAULT_TEX_DATA_PIXELS, {\cf23 'X'}, IM_COL32_WHITE);\par
03141         \}\par
03142     \}\par
03143     {\cf19 else}\par
03144     \{\par
03145         {\cf20 // Render 4 white pixels}\par
03146         IM_ASSERT(r->Width == 2 && r->Height == 2);\par
03147         {\cf17 const} {\cf18 int} offset = (int)r->X + ({\cf18 int})r->Y * w;\par
03148         {\cf19 if} (atlas->TexPixelsAlpha8 != NULL)\par
03149         \{\par
03150             atlas->TexPixelsAlpha8[offset] = atlas->TexPixelsAlpha8[offset + 1] = atlas->TexPixelsAlpha8[offset + w] = atlas->TexPixelsAlpha8[offset + w + 1] = 0xFF;\par
03151         \}\par
03152         {\cf19 else}\par
03153         \{\par
03154             atlas->TexPixelsRGBA32[offset] = atlas->TexPixelsRGBA32[offset + 1] = atlas->TexPixelsRGBA32[offset + w] = atlas->TexPixelsRGBA32[offset + w + 1] = IM_COL32_WHITE;\par
03155         \}\par
03156     \}\par
03157     atlas->TexUvWhitePixel = ImVec2((r->X + 0.5f) * atlas->TexUvScale.x, (r->Y + 0.5f) * atlas->TexUvScale.y);\par
03158 \}\par
03159 \par
03160 {\cf17 static} {\cf18 void} ImFontAtlasBuildRenderLinesTexData(ImFontAtlas* atlas)\par
03161 \{\par
03162     {\cf19 if} (atlas->Flags & ImFontAtlasFlags_NoBakedLines)\par
03163         {\cf19 return};\par
03164 \par
03165     {\cf20 // This generates a triangular shape in the texture, with the various line widths stacked on top of each other to allow interpolation between them}\par
03166     ImFontAtlasCustomRect* r = atlas->GetCustomRectByIndex(atlas->PackIdLines);\par
03167     IM_ASSERT(r->IsPacked());\par
03168     {\cf19 for} ({\cf18 unsigned} {\cf18 int} n = 0; n < IM_DRAWLIST_TEX_LINES_WIDTH_MAX + 1; n++) {\cf20 // +1 because of the zero-width row}\par
03169     \{\par
03170         {\cf20 // Each line consists of at least two empty pixels at the ends, with a line of solid pixels in the middle}\par
03171         {\cf18 unsigned} {\cf18 int} y = n;\par
03172         {\cf18 unsigned} {\cf18 int} line_width = n;\par
03173         {\cf18 unsigned} {\cf18 int} pad_left = (r->Width - line_width) / 2;\par
03174         {\cf18 unsigned} {\cf18 int} pad_right = r->Width - (pad_left + line_width);\par
03175 \par
03176         {\cf20 // Write each slice}\par
03177         IM_ASSERT(pad_left + line_width + pad_right == r->Width && y < r->Height); {\cf20 // Make sure we're inside the texture bounds before we start writing pixels}\par
03178         {\cf19 if} (atlas->TexPixelsAlpha8 != NULL)\par
03179         \{\par
03180             {\cf18 unsigned} {\cf18 char}* write_ptr = &atlas->TexPixelsAlpha8[r->X + ((r->Y + y) * atlas->TexWidth)];\par
03181             {\cf19 for} ({\cf18 unsigned} {\cf18 int} i = 0; i < pad_left; i++)\par
03182                 *(write_ptr + i) = 0x00;\par
03183 \par
03184             {\cf19 for} ({\cf18 unsigned} {\cf18 int} i = 0; i < line_width; i++)\par
03185                 *(write_ptr + pad_left + i) = 0xFF;\par
03186 \par
03187             {\cf19 for} ({\cf18 unsigned} {\cf18 int} i = 0; i < pad_right; i++)\par
03188                 *(write_ptr + pad_left + line_width + i) = 0x00;\par
03189         \}\par
03190         {\cf19 else}\par
03191         \{\par
03192             {\cf18 unsigned} {\cf18 int}* write_ptr = &atlas->TexPixelsRGBA32[r->X + ((r->Y + y) * atlas->TexWidth)];\par
03193             {\cf19 for} ({\cf18 unsigned} {\cf18 int} i = 0; i < pad_left; i++)\par
03194                 *(write_ptr + i) = IM_COL32(255, 255, 255, 0);\par
03195 \par
03196             {\cf19 for} ({\cf18 unsigned} {\cf18 int} i = 0; i < line_width; i++)\par
03197                 *(write_ptr + pad_left + i) = IM_COL32_WHITE;\par
03198 \par
03199             {\cf19 for} ({\cf18 unsigned} {\cf18 int} i = 0; i < pad_right; i++)\par
03200                 *(write_ptr + pad_left + line_width + i) = IM_COL32(255, 255, 255, 0);\par
03201         \}\par
03202 \par
03203         {\cf20 // Calculate UVs for this line}\par
03204         ImVec2 uv0 = ImVec2(({\cf18 float})(r->X + pad_left - 1), ({\cf18 float})(r->Y + y)) * atlas->TexUvScale;\par
03205         ImVec2 uv1 = ImVec2(({\cf18 float})(r->X + pad_left + line_width + 1), ({\cf18 float})(r->Y + y + 1)) * atlas->TexUvScale;\par
03206         {\cf18 float} half_v = (uv0.y + uv1.y) * 0.5f; {\cf20 // Calculate a constant V in the middle of the row to avoid sampling artifacts}\par
03207         atlas->TexUvLines[n] = ImVec4(uv0.x, half_v, uv1.x, half_v);\par
03208     \}\par
03209 \}\par
03210 \par
03211 {\cf20 // Note: this is called / shared by both the stb_truetype and the FreeType builder}\par
03212 {\cf18 void} ImFontAtlasBuildInit(ImFontAtlas* atlas)\par
03213 \{\par
03214     {\cf20 // Round font size}\par
03215     {\cf20 // - We started rounding in 1.90 WIP (18991) as our layout system currently doesn't support non-rounded font size well yet.}\par
03216     {\cf20 // - Note that using io.FontGlobalScale or SetWindowFontScale(), with are legacy-ish, partially supported features, can still lead to unrounded sizes.}\par
03217     {\cf20 // - We may support it better later and remove this rounding.}\par
03218     {\cf19 for} (ImFontConfig& cfg : atlas->ConfigData)\par
03219        cfg.SizePixels = ImTrunc(cfg.SizePixels);\par
03220 \par
03221     {\cf20 // Register texture region for mouse cursors or standard white pixels}\par
03222     {\cf19 if} (atlas->PackIdMouseCursors < 0)\par
03223     \{\par
03224         {\cf19 if} (!(atlas->Flags & ImFontAtlasFlags_NoMouseCursors))\par
03225             atlas->PackIdMouseCursors = atlas->AddCustomRectRegular(FONT_ATLAS_DEFAULT_TEX_DATA_W * 2 + 1, FONT_ATLAS_DEFAULT_TEX_DATA_H);\par
03226         {\cf19 else}\par
03227             atlas->PackIdMouseCursors = atlas->AddCustomRectRegular(2, 2);\par
03228     \}\par
03229 \par
03230     {\cf20 // Register texture region for thick lines}\par
03231     {\cf20 // The +2 here is to give space for the end caps, whilst height +1 is to accommodate the fact we have a zero-width row}\par
03232     {\cf19 if} (atlas->PackIdLines < 0)\par
03233     \{\par
03234         {\cf19 if} (!(atlas->Flags & ImFontAtlasFlags_NoBakedLines))\par
03235             atlas->PackIdLines = atlas->AddCustomRectRegular(IM_DRAWLIST_TEX_LINES_WIDTH_MAX + 2, IM_DRAWLIST_TEX_LINES_WIDTH_MAX + 1);\par
03236     \}\par
03237 \}\par
03238 \par
03239 {\cf20 // This is called/shared by both the stb_truetype and the FreeType builder.}\par
03240 {\cf18 void} ImFontAtlasBuildFinish(ImFontAtlas* atlas)\par
03241 \{\par
03242     {\cf20 // Render into our custom data blocks}\par
03243     IM_ASSERT(atlas->TexPixelsAlpha8 != NULL || atlas->TexPixelsRGBA32 != NULL);\par
03244     ImFontAtlasBuildRenderDefaultTexData(atlas);\par
03245     ImFontAtlasBuildRenderLinesTexData(atlas);\par
03246 \par
03247     {\cf20 // Register custom rectangle glyphs}\par
03248     {\cf19 for} ({\cf18 int} i = 0; i < atlas->CustomRects.Size; i++)\par
03249     \{\par
03250         {\cf17 const} ImFontAtlasCustomRect* r = &atlas->CustomRects[i];\par
03251         {\cf19 if} (r->Font == NULL || r->GlyphID == 0)\par
03252             {\cf19 continue};\par
03253 \par
03254         {\cf20 // Will ignore ImFontConfig settings: GlyphMinAdvanceX, GlyphMinAdvanceY, GlyphExtraSpacing, PixelSnapH}\par
03255         IM_ASSERT(r->Font->ContainerAtlas == atlas);\par
03256         ImVec2 uv0, uv1;\par
03257         atlas->CalcCustomRectUV(r, &uv0, &uv1);\par
03258         r->Font->AddGlyph(NULL, (ImWchar)r->GlyphID, r->GlyphOffset.x, r->GlyphOffset.y, r->GlyphOffset.x + r->Width, r->GlyphOffset.y + r->Height, uv0.x, uv0.y, uv1.x, uv1.y, r->GlyphAdvanceX);\par
03259     \}\par
03260 \par
03261     {\cf20 // Build all fonts lookup tables}\par
03262     {\cf19 for} (ImFont* font : atlas->Fonts)\par
03263         {\cf19 if} (font->DirtyLookupTables)\par
03264             font->BuildLookupTable();\par
03265 \par
03266     atlas->TexReady = {\cf17 true};\par
03267 \}\par
