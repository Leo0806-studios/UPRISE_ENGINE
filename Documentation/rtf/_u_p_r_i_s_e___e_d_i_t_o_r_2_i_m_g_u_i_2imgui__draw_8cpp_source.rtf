04082     {\cf18 unsigned} {\cf18 int} vtx_index = draw_list->_VtxCurrentIdx;\par
04083 \par
04084     {\cf17 const} ImU32 col_untinted = col | ~IM_COL32_A_MASK;\par
04085     {\cf17 const} {\cf18 char}* word_wrap_eol = NULL;\par
04086 \par
04087     {\cf19 while} (s < text_end)\par
04088     \{\par
04089         {\cf19 if} (word_wrap_enabled)\par
04090         \{\par
04091             {\cf20 // Calculate how far we can render. Requires two passes on the string data but keeps the code simple and not intrusive for what's essentially an uncommon feature.}\par
04092             {\cf19 if} (!word_wrap_eol)\par
04093                 word_wrap_eol = CalcWordWrapPositionA(scale, s, text_end, wrap_width - (x - start_x));\par
04094 \par
04095             {\cf19 if} (s >= word_wrap_eol)\par
