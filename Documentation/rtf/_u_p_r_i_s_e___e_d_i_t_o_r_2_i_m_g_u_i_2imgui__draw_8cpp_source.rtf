04297 {\cf17 static} {\cf17 inline} {\cf18 float} ImAcos01({\cf18 float} x)\par
04298 \{\par
04299     {\cf19 if} (x <= 0.0f) {\cf19 return} IM_PI * 0.5f;\par
04300     {\cf19 if} (x >= 1.0f) {\cf19 return} 0.0f;\par
04301     {\cf19 return} ImAcos(x);\par
04302     {\cf20 //return (-0.69813170079773212f * x * x - 0.87266462599716477f) * x + 1.5707963267948966f; // Cheap approximation, may be enough for what we do.}\par
04303 \}\par
