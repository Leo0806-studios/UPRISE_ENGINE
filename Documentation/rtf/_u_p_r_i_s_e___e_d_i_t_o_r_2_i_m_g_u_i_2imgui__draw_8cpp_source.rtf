01360 {\cf20     if (flags == ~0)                    \{ return ImDrawFlags_RoundCornersAll; \}}\par
01361 {\cf20     // - Legacy Support for hard coded 0x01 to 0x0F (matching 15 out of 16 old flags combinations). Read details in older version of this code.}\par
01362 {\cf20     if (flags >= 0x01 && flags <= 0x0F) \{ return (flags << 4); \}}\par
01363 {\cf20     // We cannot support hard coded 0x00 with 'float rounding > 0.0f' --> replace with ImDrawFlags_RoundCornersNone or use 'float rounding = 0.0f'}\par
01364 {\cf20 #endif}\par
01365 {\cf20     */}\par
01366     {\cf20 // If this assert triggers, please update your code replacing hardcoded values with new ImDrawFlags_RoundCorners* values.}\par
01367     {\cf20 // Note that ImDrawFlags_Closed (== 0x01) is an invalid flag for AddRect(), AddRectFilled(), PathRect() etc. anyway.}\par
01368     {\cf20 // See details in 1.82 Changelog as well as 2021/03/12 and 2023/09/08 entries in "API BREAKING CHANGES" section.}\par
01369     IM_ASSERT((flags & 0x0F) == 0 && {\cf22 "Misuse of legacy hardcoded ImDrawCornerFlags values!"});\par
01370 \par
01371     {\cf19 if} ((flags & ImDrawFlags_RoundCornersMask_) == 0)\par
01372         flags |= ImDrawFlags_RoundCornersAll;\par
01373 \par
01374     {\cf19 return} flags;\par
01375 \}\par
