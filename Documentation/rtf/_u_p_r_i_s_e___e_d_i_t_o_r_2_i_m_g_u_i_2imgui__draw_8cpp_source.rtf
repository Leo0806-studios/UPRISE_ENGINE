04261 {\cf18 void} ImGui::RenderCheckMark(ImDrawList* draw_list, ImVec2 pos, ImU32 col, {\cf18 float} sz)\par
04262 \{\par
04263     {\cf18 float} thickness = ImMax(sz / 5.0f, 1.0f);\par
04264     sz -= thickness * 0.5f;\par
04265     pos += ImVec2(thickness * 0.25f, thickness * 0.25f);\par
04266 \par
