04527     stb__barrier_out_e = output + olen;\par
04528     stb__barrier_out_b = output;\par
04529     i += 16;\par
04530 \par
04531     stb__dout = output;\par
04532     {\cf19 for} (;;) \{\par
04533         {\cf17 const} {\cf18 unsigned} {\cf18 char} *old_i = i;\par
04534         i = stb_decompress_token(i);\par
04535         {\cf19 if} (i == old_i) \{\par
04536             {\cf19 if} (*i == 0x05 && i[1] == 0xfa) \{\par
04537                 IM_ASSERT(stb__dout == output + olen);\par
04538                 {\cf19 if} (stb__dout != output + olen) {\cf19 return} 0;\par
04539                 {\cf19 if} (stb_adler32(1, output, olen) != ({\cf18 unsigned} {\cf18 int}) stb__in4(2))\par
04540                     {\cf19 return} 0;\par
04541                 {\cf19 return} olen;\par
04542             \} {\cf19 else} \{\par
04543                 IM_ASSERT(0); {\cf20 /* NOTREACHED */}\par
04544                 {\cf19 return} 0;\par
04545             \}\par
04546         \}\par
04547         IM_ASSERT(stb__dout <= output + olen);\par
04548         {\cf19 if} (stb__dout > output + olen)\par
04549             {\cf19 return} 0;\par
