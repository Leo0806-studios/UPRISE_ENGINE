04490 {\cf17 static} {\cf18 unsigned} {\cf18 int} stb_adler32({\cf18 unsigned} {\cf18 int} adler32, {\cf18 unsigned} {\cf18 char} *buffer, {\cf18 unsigned} {\cf18 int} buflen)\par
04491 \{\par
04492     {\cf17 const} {\cf18 unsigned} {\cf18 long} ADLER_MOD = 65521;\par
04493     {\cf18 unsigned} {\cf18 long} s1 = adler32 & 0xffff, s2 = adler32 >> 16;\par
04494     {\cf18 unsigned} {\cf18 long} blocklen = buflen % 5552;\par
04495 \par
04496     {\cf18 unsigned} {\cf18 long} i;\par
04497     {\cf19 while} (buflen) \{\par
04498         {\cf19 for} (i=0; i + 7 < blocklen; i += 8) \{\par
04499             s1 += buffer[0], s2 += s1;\par
04500             s1 += buffer[1], s2 += s1;\par
04501             s1 += buffer[2], s2 += s1;\par
04502             s1 += buffer[3], s2 += s1;\par
04503             s1 += buffer[4], s2 += s1;\par
04504             s1 += buffer[5], s2 += s1;\par
04505             s1 += buffer[6], s2 += s1;\par
04506             s1 += buffer[7], s2 += s1;\par
04507 \par
04508             buffer += 8;\par
04509         \}\par
04510 \par
04511         {\cf19 for} (; i < blocklen; ++i)\par
04512             s1 += *buffer++, s2 += s1;\par
04513 \par
04514         s1 %= ADLER_MOD, s2 %= ADLER_MOD;\par
04515         buflen -= blocklen;\par
04516         blocklen = 5552;\par
04517     \}\par
04518     {\cf19 return} ({\cf18 unsigned} {\cf18 int})(s2 << 16) + ({\cf18 unsigned} {\cf18 int})s1;\par
04519 \}\par
