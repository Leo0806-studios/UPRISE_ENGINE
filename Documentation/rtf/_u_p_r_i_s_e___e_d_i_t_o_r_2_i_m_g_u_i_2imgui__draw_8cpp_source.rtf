02753     {\cf18 int}                 SrcCount;           {\cf20 // Number of source fonts targeting this destination font.}\par
02754     {\cf18 int}                 GlyphsHighest;\par
02755     {\cf18 int}                 GlyphsCount;\par
02756     ImBitVector         GlyphsSet;          {\cf20 // This is used to resolve collision when multiple sources are merged into a same destination font.}\par
02757 \};\par
02758 \par
02759 {\cf17 static} {\cf18 void} UnpackBitVectorToFlatIndexList({\cf17 const} ImBitVector* in, ImVector<int>* out)\par
02760 \{\par
02761     IM_ASSERT({\cf17 sizeof}(in->Storage.Data[0]) == {\cf17 sizeof}({\cf18 int}));\par
02762     {\cf17 const} ImU32* it_begin = in->Storage.begin();\par
02763     {\cf17 const} ImU32* it_end = in->Storage.end();\par
02764     {\cf19 for} ({\cf17 const} ImU32* it = it_begin; it < it_end; it++)\par
02765         {\cf19 if} (ImU32 entries_32 = *it)\par
02766             {\cf19 for} (ImU32 bit_n = 0; bit_n < 32; bit_n++)\par
02767                 {\cf19 if} (entries_32 & ((ImU32)1 << bit_n))\par
02768                     out->push_back(({\cf18 int})(((it - it_begin) << 5) + bit_n));\par
02769 \}\par
02770 \par
02771 {\cf17 static} {\cf18 bool} ImFontAtlasBuildWithStbTruetype(ImFontAtlas* atlas)\par
02772 \{\par
02773     IM_ASSERT(atlas->ConfigData.Size > 0);\par
02774 \par
02775     ImFontAtlasBuildInit(atlas);\par
02776 \par
02777     {\cf20 // Clear atlas}\par
02778     atlas->TexID = (ImTextureID)NULL;\par
02779     atlas->TexWidth = atlas->TexHeight = 0;\par
02780     atlas->TexUvScale = ImVec2(0.0f, 0.0f);\par
02781     atlas->TexUvWhitePixel = ImVec2(0.0f, 0.0f);\par
02782     atlas->ClearTexData();\par
02783 \par
02784     {\cf20 // Temporary storage for building}\par
02785     ImVector<ImFontBuildSrcData> src_tmp_array;\par
02786     ImVector<ImFontBuildDstData> dst_tmp_array;\par
02787     src_tmp_array.resize(atlas->ConfigData.Size);\par
02788     dst_tmp_array.resize(atlas->Fonts.Size);\par
02789     memset(src_tmp_array.Data, 0, ({\cf18 size_t})src_tmp_array.size_in_bytes());\par
02790     memset(dst_tmp_array.Data, 0, ({\cf18 size_t})dst_tmp_array.size_in_bytes());\par
02791 \par
02792     {\cf20 // 1. Initialize font loading structure, check font data validity}\par
02793     {\cf19 for} ({\cf18 int} src_i = 0; src_i < atlas->ConfigData.Size; src_i++)\par
02794     \{\par
02795         ImFontBuildSrcData& src_tmp = src_tmp_array[src_i];\par
02796         ImFontConfig& cfg = atlas->ConfigData[src_i];\par
02797         IM_ASSERT(cfg.DstFont && (!cfg.DstFont->IsLoaded() || cfg.DstFont->ContainerAtlas == atlas));\par
02798 \par
02799         {\cf20 // Find index from cfg.DstFont (we allow the user to set cfg.DstFont. Also it makes casual debugging nicer than when storing indices)}\par
02800         src_tmp.DstIndex = -1;\par
02801         {\cf19 for} ({\cf18 int} output_i = 0; output_i < atlas->Fonts.Size && src_tmp.DstIndex == -1; output_i++)\par
02802             {\cf19 if} (cfg.DstFont == atlas->Fonts[output_i])\par
02803                 src_tmp.DstIndex = output_i;\par
02804         {\cf19 if} (src_tmp.DstIndex == -1)\par
02805         \{\par
02806             IM_ASSERT(src_tmp.DstIndex != -1); {\cf20 // cfg.DstFont not pointing within atlas->Fonts[] array?}\par
02807             {\cf19 return} {\cf17 false};\par
02808         \}\par
02809         {\cf20 // Initialize helper structure for font loading and verify that the TTF/OTF data is correct}\par
02810         {\cf17 const} {\cf18 int} font_offset = stbtt_GetFontOffsetForIndex(({\cf18 unsigned} {\cf18 char}*)cfg.FontData, cfg.FontNo);\par
02811         IM_ASSERT(font_offset >= 0 && {\cf22 "FontData is incorrect, or FontNo cannot be found."});\par
02812         {\cf19 if} (!stbtt_InitFont(&src_tmp.FontInfo, ({\cf18 unsigned} {\cf18 char}*)cfg.FontData, font_offset))\par
02813         \{\par
02814             IM_ASSERT(0 && {\cf22 "stbtt_InitFont(): failed to parse FontData. It is correct and complete? Check FontDataSize."});\par
02815             {\cf19 return} {\cf17 false};\par
02816         \}\par
02817 \par
02818         {\cf20 // Measure highest codepoints}\par
02819         ImFontBuildDstData& dst_tmp = dst_tmp_array[src_tmp.DstIndex];\par
02820         src_tmp.SrcRanges = cfg.GlyphRanges ? cfg.GlyphRanges : atlas->GetGlyphRangesDefault();\par
02821         {\cf19 for} ({\cf17 const} ImWchar* src_range = src_tmp.SrcRanges; src_range[0] && src_range[1]; src_range += 2)\par
02822         \{\par
02823             {\cf20 // Check for valid range. This may also help detect *some* dangling pointers, because a common}\par
02824             {\cf20 // user error is to setup ImFontConfig::GlyphRanges with a pointer to data that isn't persistent.}\par
02825             IM_ASSERT(src_range[0] <= src_range[1]);\par
02826             src_tmp.GlyphsHighest = ImMax(src_tmp.GlyphsHighest, ({\cf18 int})src_range[1]);\par
02827         \}\par
02828         dst_tmp.SrcCount++;\par
02829         dst_tmp.GlyphsHighest = ImMax(dst_tmp.GlyphsHighest, src_tmp.GlyphsHighest);\par
02830     \}\par
02831 \par
02832     {\cf20 // 2. For every requested codepoint, check for their presence in the font data, and handle redundancy or overlaps between source fonts to avoid unused glyphs.}\par
02833     {\cf18 int} total_glyphs_count = 0;\par
02834     {\cf19 for} ({\cf18 int} src_i = 0; src_i < src_tmp_array.Size; src_i++)\par
02835     \{\par
02836         ImFontBuildSrcData& src_tmp = src_tmp_array[src_i];\par
02837         ImFontBuildDstData& dst_tmp = dst_tmp_array[src_tmp.DstIndex];\par
02838         src_tmp.GlyphsSet.Create(src_tmp.GlyphsHighest + 1);\par
02839         {\cf19 if} (dst_tmp.GlyphsSet.Storage.empty())\par
02840             dst_tmp.GlyphsSet.Create(dst_tmp.GlyphsHighest + 1);\par
02841 \par
02842         {\cf19 for} ({\cf17 const} ImWchar* src_range = src_tmp.SrcRanges; src_range[0] && src_range[1]; src_range += 2)\par
02843             {\cf19 for} ({\cf18 unsigned} {\cf18 int} codepoint = src_range[0]; codepoint <= src_range[1]; codepoint++)\par
02844             \{\par
02845                 {\cf19 if} (dst_tmp.GlyphsSet.TestBit(codepoint))    {\cf20 // Don't overwrite existing glyphs. We could make this an option for MergeMode (e.g. MergeOverwrite==true)}\par
02846                     {\cf19 continue};\par
02847                 {\cf19 if} (!stbtt_FindGlyphIndex(&src_tmp.FontInfo, codepoint))    {\cf20 // It is actually in the font?}\par
02848                     {\cf19 continue};\par
02849 \par
02850                 {\cf20 // Add to avail set/counters}\par
02851                 src_tmp.GlyphsCount++;\par
02852                 dst_tmp.GlyphsCount++;\par
02853                 src_tmp.GlyphsSet.SetBit(codepoint);\par
02854                 dst_tmp.GlyphsSet.SetBit(codepoint);\par
02855                 total_glyphs_count++;\par
02856             \}\par
02857     \}\par
02858 \par
02859     {\cf20 // 3. Unpack our bit map into a flat list (we now have all the Unicode points that we know are requested _and_ available _and_ not overlapping another)}\par
02860     {\cf19 for} ({\cf18 int} src_i = 0; src_i < src_tmp_array.Size; src_i++)\par
02861     \{\par
02862         ImFontBuildSrcData& src_tmp = src_tmp_array[src_i];\par
02863         src_tmp.GlyphsList.reserve(src_tmp.GlyphsCount);\par
02864         UnpackBitVectorToFlatIndexList(&src_tmp.GlyphsSet, &src_tmp.GlyphsList);\par
02865         src_tmp.GlyphsSet.Clear();\par
02866         IM_ASSERT(src_tmp.GlyphsList.Size == src_tmp.GlyphsCount);\par
02867     \}\par
02868     {\cf19 for} ({\cf18 int} dst_i = 0; dst_i < dst_tmp_array.Size; dst_i++)\par
02869         dst_tmp_array[dst_i].GlyphsSet.Clear();\par
02870     dst_tmp_array.clear();\par
02871 \par
02872     {\cf20 // Allocate packing character data and flag packed characters buffer as non-packed (x0=y0=x1=y1=0)}\par
02873     {\cf20 // (We technically don't need to zero-clear buf_rects, but let's do it for the sake of sanity)}\par
02874     ImVector<stbrp_rect> buf_rects;\par
02875     ImVector<stbtt_packedchar> buf_packedchars;\par
02876     buf_rects.resize(total_glyphs_count);\par
02877     buf_packedchars.resize(total_glyphs_count);\par
02878     memset(buf_rects.Data, 0, ({\cf18 size_t})buf_rects.size_in_bytes());\par
02879     memset(buf_packedchars.Data, 0, ({\cf18 size_t})buf_packedchars.size_in_bytes());\par
02880 \par
02881     {\cf20 // 4. Gather glyphs sizes so we can pack them in our virtual canvas.}\par
02882     {\cf18 int} total_surface = 0;\par
02883     {\cf18 int} buf_rects_out_n = 0;\par
02884     {\cf18 int} buf_packedchars_out_n = 0;\par
02885     {\cf19 for} ({\cf18 int} src_i = 0; src_i < src_tmp_array.Size; src_i++)\par
02886     \{\par
02887         ImFontBuildSrcData& src_tmp = src_tmp_array[src_i];\par
02888         {\cf19 if} (src_tmp.GlyphsCount == 0)\par
02889             {\cf19 continue};\par
02890 \par
02891         src_tmp.Rects = &buf_rects[buf_rects_out_n];\par
02892         src_tmp.PackedChars = &buf_packedchars[buf_packedchars_out_n];\par
02893         buf_rects_out_n += src_tmp.GlyphsCount;\par
02894         buf_packedchars_out_n += src_tmp.GlyphsCount;\par
02895 \par
02896         {\cf20 // Convert our ranges in the format stb_truetype wants}\par
02897         ImFontConfig& cfg = atlas->ConfigData[src_i];\par
02898         src_tmp.PackRange.font_size = cfg.SizePixels * cfg.RasterizerDensity;\par
02899         src_tmp.PackRange.first_unicode_codepoint_in_range = 0;\par
02900         src_tmp.PackRange.array_of_unicode_codepoints = src_tmp.GlyphsList.Data;\par
02901         src_tmp.PackRange.num_chars = src_tmp.GlyphsList.Size;\par
02902         src_tmp.PackRange.chardata_for_range = src_tmp.PackedChars;\par
02903         src_tmp.PackRange.h_oversample = ({\cf18 unsigned} char)cfg.OversampleH;\par
02904         src_tmp.PackRange.v_oversample = ({\cf18 unsigned} char)cfg.OversampleV;\par
02905 \par
02906         {\cf20 // Gather the sizes of all rectangles we will need to pack (this loop is based on stbtt_PackFontRangesGatherRects)}\par
02907         {\cf17 const} {\cf18 float} scale = (cfg.SizePixels > 0.0f) ? stbtt_ScaleForPixelHeight(&src_tmp.FontInfo, cfg.SizePixels * cfg.RasterizerDensity) : stbtt_ScaleForMappingEmToPixels(&src_tmp.FontInfo, -cfg.SizePixels * cfg.RasterizerDensity);\par
02908         {\cf17 const} {\cf18 int} padding = atlas->TexGlyphPadding;\par
02909         {\cf19 for} ({\cf18 int} glyph_i = 0; glyph_i < src_tmp.GlyphsList.Size; glyph_i++)\par
02910         \{\par
02911             {\cf18 int} x0, y0, x1, y1;\par
02912             {\cf17 const} {\cf18 int} glyph_index_in_font = stbtt_FindGlyphIndex(&src_tmp.FontInfo, src_tmp.GlyphsList[glyph_i]);\par
02913             IM_ASSERT(glyph_index_in_font != 0);\par
02914             stbtt_GetGlyphBitmapBoxSubpixel(&src_tmp.FontInfo, glyph_index_in_font, scale * cfg.OversampleH, scale * cfg.OversampleV, 0, 0, &x0, &y0, &x1, &y1);\par
02915             src_tmp.Rects[glyph_i].w = (stbrp_coord)(x1 - x0 + padding + cfg.OversampleH - 1);\par
02916             src_tmp.Rects[glyph_i].h = (stbrp_coord)(y1 - y0 + padding + cfg.OversampleV - 1);\par
02917             total_surface += src_tmp.Rects[glyph_i].w * src_tmp.Rects[glyph_i].h;\par
02918         \}\par
02919     \}\par
02920 \par
02921     {\cf20 // We need a width for the skyline algorithm, any width!}\par
02922     {\cf20 // The exact width doesn't really matter much, but some API/GPU have texture size limitations and increasing width can decrease height.}\par
02923     {\cf20 // User can override TexDesiredWidth and TexGlyphPadding if they wish, otherwise we use a simple heuristic to select the width based on expected surface.}\par
02924     {\cf17 const} {\cf18 int} surface_sqrt = (int)ImSqrt(({\cf18 float})total_surface) + 1;\par
02925     atlas->TexHeight = 0;\par
02926     {\cf19 if} (atlas->TexDesiredWidth > 0)\par
02927         atlas->TexWidth = atlas->TexDesiredWidth;\par
02928     {\cf19 else}\par
02929         atlas->TexWidth = (surface_sqrt >= 4096 * 0.7f) ? 4096 : (surface_sqrt >= 2048 * 0.7f) ? 2048 : (surface_sqrt >= 1024 * 0.7f) ? 1024 : 512;\par
02930 \par
02931     {\cf20 // 5. Start packing}\par
02932     {\cf20 // Pack our extra data rectangles first, so it will be on the upper-left corner of our texture (UV will have small values).}\par
02933     {\cf17 const} {\cf18 int} TEX_HEIGHT_MAX = 1024 * 32;\par
02934     stbtt_pack_context spc = \{\};\par
02935     stbtt_PackBegin(&spc, NULL, atlas->TexWidth, TEX_HEIGHT_MAX, 0, atlas->TexGlyphPadding, NULL);\par
02936     ImFontAtlasBuildPackCustomRects(atlas, spc.pack_info);\par
02937 \par
02938     {\cf20 // 6. Pack each source font. No rendering yet, we are working with rectangles in an infinitely tall texture at this point.}\par
02939     {\cf19 for} ({\cf18 int} src_i = 0; src_i < src_tmp_array.Size; src_i++)\par
02940     \{\par
02941         ImFontBuildSrcData& src_tmp = src_tmp_array[src_i];\par
02942         {\cf19 if} (src_tmp.GlyphsCount == 0)\par
02943             {\cf19 continue};\par
02944 \par
02945         stbrp_pack_rects((stbrp_context*)spc.pack_info, src_tmp.Rects, src_tmp.GlyphsCount);\par
02946 \par
02947         {\cf20 // Extend texture height and mark missing glyphs as non-packed so we won't render them.}\par
02948         {\cf20 // FIXME: We are not handling packing failure here (would happen if we got off TEX_HEIGHT_MAX or if a single if larger than TexWidth?)}\par
02949         {\cf19 for} ({\cf18 int} glyph_i = 0; glyph_i < src_tmp.GlyphsCount; glyph_i++)\par
02950             {\cf19 if} (src_tmp.Rects[glyph_i].was_packed)\par
02951                 atlas->TexHeight = ImMax(atlas->TexHeight, src_tmp.Rects[glyph_i].y + src_tmp.Rects[glyph_i].h);\par
02952     \}\par
02953 \par
02954     {\cf20 // 7. Allocate texture}\par
02955     atlas->TexHeight = (atlas->Flags & ImFontAtlasFlags_NoPowerOfTwoHeight) ? (atlas->TexHeight + 1) : ImUpperPowerOfTwo(atlas->TexHeight);\par
02956     atlas->TexUvScale = ImVec2(1.0f / atlas->TexWidth, 1.0f / atlas->TexHeight);\par
02957     atlas->TexPixelsAlpha8 = ({\cf18 unsigned} {\cf18 char}*)IM_ALLOC(atlas->TexWidth * atlas->TexHeight);\par
02958     memset(atlas->TexPixelsAlpha8, 0, atlas->TexWidth * atlas->TexHeight);\par
02959     spc.pixels = atlas->TexPixelsAlpha8;\par
02960     spc.height = atlas->TexHeight;\par
02961 \par
02962     {\cf20 // 8. Render/rasterize font characters into the texture}\par
02963     {\cf19 for} ({\cf18 int} src_i = 0; src_i < src_tmp_array.Size; src_i++)\par
02964     \{\par
02965         ImFontConfig& cfg = atlas->ConfigData[src_i];\par
02966         ImFontBuildSrcData& src_tmp = src_tmp_array[src_i];\par
02967         {\cf19 if} (src_tmp.GlyphsCount == 0)\par
02968             {\cf19 continue};\par
02969 \par
02970         stbtt_PackFontRangesRenderIntoRects(&spc, &src_tmp.FontInfo, &src_tmp.PackRange, 1, src_tmp.Rects);\par
02971 \par
02972         {\cf20 // Apply multiply operator}\par
02973         {\cf19 if} (cfg.RasterizerMultiply != 1.0f)\par
02974         \{\par
02975             {\cf18 unsigned} {\cf18 char} multiply_table[256];\par
02976             ImFontAtlasBuildMultiplyCalcLookupTable(multiply_table, cfg.RasterizerMultiply);\par
02977             stbrp_rect* r = &src_tmp.Rects[0];\par
02978             {\cf19 for} ({\cf18 int} glyph_i = 0; glyph_i < src_tmp.GlyphsCount; glyph_i++, r++)\par
02979                 {\cf19 if} (r->was_packed)\par
02980                     ImFontAtlasBuildMultiplyRectAlpha8(multiply_table, atlas->TexPixelsAlpha8, r->x, r->y, r->w, r->h, atlas->TexWidth * 1);\par
02981         \}\par
02982         src_tmp.Rects = NULL;\par
02983     \}\par
02984 \par
02985     {\cf20 // End packing}\par
02986     stbtt_PackEnd(&spc);\par
02987     buf_rects.clear();\par
02988 \par
02989     {\cf20 // 9. Setup ImFont and glyphs for runtime}\par
02990     {\cf19 for} ({\cf18 int} src_i = 0; src_i < src_tmp_array.Size; src_i++)\par
02991     \{\par
02992         {\cf20 // When merging fonts with MergeMode=true:}\par
02993         {\cf20 // - We can have multiple input fonts writing into a same destination font.}\par
02994         {\cf20 // - dst_font->ConfigData is != from cfg which is our source configuration.}\par
02995         ImFontBuildSrcData& src_tmp = src_tmp_array[src_i];\par
02996         ImFontConfig& cfg = atlas->ConfigData[src_i];\par
02997         ImFont* dst_font = cfg.DstFont;\par
02998 \par
02999         {\cf17 const} {\cf18 float} font_scale = stbtt_ScaleForPixelHeight(&src_tmp.FontInfo, cfg.SizePixels);\par
03000         {\cf18 int} unscaled_ascent, unscaled_descent, unscaled_line_gap;\par
03001         stbtt_GetFontVMetrics(&src_tmp.FontInfo, &unscaled_ascent, &unscaled_descent, &unscaled_line_gap);\par
03002 \par
03003         {\cf17 const} {\cf18 float} ascent = ImCeil(unscaled_ascent * font_scale);\par
03004         {\cf17 const} {\cf18 float} descent = ImFloor(unscaled_descent * font_scale);\par
03005         ImFontAtlasBuildSetupFont(atlas, dst_font, &cfg, ascent, descent);\par
03006         {\cf17 const} {\cf18 float} font_off_x = cfg.GlyphOffset.x;\par
03007         {\cf17 const} {\cf18 float} font_off_y = cfg.GlyphOffset.y + IM_ROUND(dst_font->Ascent);\par
03008 \par
03009         {\cf17 const} {\cf18 float} inv_rasterization_scale = 1.0f / cfg.RasterizerDensity;\par
03010 \par
03011         {\cf19 for} ({\cf18 int} glyph_i = 0; glyph_i < src_tmp.GlyphsCount; glyph_i++)\par
03012         \{\par
03013             {\cf20 // Register glyph}\par
03014             {\cf17 const} {\cf18 int} codepoint = src_tmp.GlyphsList[glyph_i];\par
03015             {\cf17 const} stbtt_packedchar& pc = src_tmp.PackedChars[glyph_i];\par
03016             stbtt_aligned_quad q;\par
03017             {\cf18 float} unused_x = 0.0f, unused_y = 0.0f;\par
03018             stbtt_GetPackedQuad(src_tmp.PackedChars, atlas->TexWidth, atlas->TexHeight, glyph_i, &unused_x, &unused_y, &q, 0);\par
03019             {\cf18 float} x0 = q.x0 * inv_rasterization_scale + font_off_x;\par
03020             {\cf18 float} y0 = q.y0 * inv_rasterization_scale + font_off_y;\par
03021             {\cf18 float} x1 = q.x1 * inv_rasterization_scale + font_off_x;\par
03022             {\cf18 float} y1 = q.y1 * inv_rasterization_scale + font_off_y;\par
03023             dst_font->AddGlyph(&cfg, (ImWchar)codepoint, x0, y0, x1, y1, q.s0, q.t0, q.s1, q.t1, pc.xadvance * inv_rasterization_scale);\par
03024         \}\par
03025     \}\par
03026 \par
03027     {\cf20 // Cleanup}\par
03028     src_tmp_array.clear_destruct();\par
03029 \par
03030     ImFontAtlasBuildFinish(atlas);\par
03031     {\cf19 return} {\cf17 true};\par
03032 \}\par
03033 \par
03034 {\cf17 const} ImFontBuilderIO* ImFontAtlasGetBuilderForStbTruetype()\par
03035 \{\par
03036     {\cf17 static} ImFontBuilderIO io;\par
03037     io.FontBuilder_Build = ImFontAtlasBuildWithStbTruetype;\par
03038     {\cf19 return} &io;\par
03039 \}\par
