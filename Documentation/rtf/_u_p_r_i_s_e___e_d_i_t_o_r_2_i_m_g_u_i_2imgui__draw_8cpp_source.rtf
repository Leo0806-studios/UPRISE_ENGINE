01353 {\cf17 static} {\cf17 inline} ImDrawFlags FixRectCornerFlags(ImDrawFlags flags)\par
01354 \{\par
01355     {\cf20 /*}\par
01356 {\cf20     IM_STATIC_ASSERT(ImDrawFlags_RoundCornersTopLeft == (1 << 4));}\par
01357 {\cf20 #ifndef IMGUI_DISABLE_OBSOLETE_FUNCTIONS}\par
01358 {\cf20     // Obsoleted in 1.82 (from February 2021). This code was stripped/simplified and mostly commented in 1.90 (from September 2023)}\par
