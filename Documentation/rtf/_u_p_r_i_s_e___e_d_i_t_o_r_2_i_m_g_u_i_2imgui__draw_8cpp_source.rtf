04181                 {\cf20 // We are NOT calling PrimRectUV() here because non-inlined causes too much overhead in a debug builds. Inlined here:}\par
04182                 \{\par
04183                     vtx_write[0].pos.x = x1; vtx_write[0].pos.y = y1; vtx_write[0].col = glyph_col; vtx_write[0].uv.x = u1; vtx_write[0].uv.y = v1;\par
04184                     vtx_write[1].pos.x = x2; vtx_write[1].pos.y = y1; vtx_write[1].col = glyph_col; vtx_write[1].uv.x = u2; vtx_write[1].uv.y = v1;\par
04185                     vtx_write[2].pos.x = x2; vtx_write[2].pos.y = y2; vtx_write[2].col = glyph_col; vtx_write[2].uv.x = u2; vtx_write[2].uv.y = v2;\par
04186                     vtx_write[3].pos.x = x1; vtx_write[3].pos.y = y2; vtx_write[3].col = glyph_col; vtx_write[3].uv.x = u1; vtx_write[3].uv.y = v2;\par
04187                     idx_write[0] = (ImDrawIdx)(vtx_index); idx_write[1] = (ImDrawIdx)(vtx_index + 1); idx_write[2] = (ImDrawIdx)(vtx_index + 2);\par
04188                     idx_write[3] = (ImDrawIdx)(vtx_index); idx_write[4] = (ImDrawIdx)(vtx_index + 2); idx_write[5] = (ImDrawIdx)(vtx_index + 3);\par
04189                     vtx_write += 4;\par
04190                     vtx_index += 4;\par
04191                     idx_write += 6;\par
04192                 \}\par
04193             \}\par
04194         \}\par
04195         x += char_width;\par
04196     \}\par
04197 \par
04198     {\cf20 // Give back unused vertices (clipped ones, blanks) ~ this is essentially a PrimUnreserve() action.}\par
04199     draw_list->VtxBuffer.Size = (int)(vtx_write - draw_list->VtxBuffer.Data); {\cf20 // Same as calling shrink()}\par
04200     draw_list->IdxBuffer.Size = (int)(idx_write - draw_list->IdxBuffer.Data);\par
04201     draw_list->CmdBuffer[draw_list->CmdBuffer.Size - 1].ElemCount -= (idx_expected_size - draw_list->IdxBuffer.Size);\par
04202     draw_list->_VtxWritePtr = vtx_write;\par
04203     draw_list->_IdxWritePtr = idx_write;\par
04204     draw_list->_VtxCurrentIdx = vtx_index;\par
04205 \}\par
