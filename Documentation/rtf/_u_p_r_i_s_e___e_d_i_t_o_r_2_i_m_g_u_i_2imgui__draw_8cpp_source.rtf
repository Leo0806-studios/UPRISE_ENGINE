04521 {\cf17 static} {\cf18 unsigned} {\cf18 int} stb_decompress({\cf18 unsigned} {\cf18 char} *output, {\cf17 const} {\cf18 unsigned} {\cf18 char} *i, {\cf18 unsigned} {\cf18 int} {\cf20 /*length*/})\par
