04366 {\cf18 void} ImGui::RenderRectFilledWithHole(ImDrawList* draw_list, {\cf17 const} ImRect& outer, {\cf17 const} ImRect& inner, ImU32 col, {\cf18 float} rounding)\par
04367 \{\par
04368     {\cf17 const} {\cf18 bool} fill_L = (inner.Min.x > outer.Min.x);\par
04369     {\cf17 const} {\cf18 bool} fill_R = (inner.Max.x < outer.Max.x);\par
04370     {\cf17 const} {\cf18 bool} fill_U = (inner.Min.y > outer.Min.y);\par
04371     {\cf17 const} {\cf18 bool} fill_D = (inner.Max.y < outer.Max.y);\par
04372     {\cf19 if} (fill_L) draw_list->AddRectFilled(ImVec2(outer.Min.x, inner.Min.y), ImVec2(inner.Min.x, inner.Max.y), col, rounding, ImDrawFlags_RoundCornersNone | (fill_U ? 0 : ImDrawFlags_RoundCornersTopLeft)    | (fill_D ? 0 : ImDrawFlags_RoundCornersBottomLeft));\par
04373     {\cf19 if} (fill_R) draw_list->AddRectFilled(ImVec2(inner.Max.x, inner.Min.y), ImVec2(outer.Max.x, inner.Max.y), col, rounding, ImDrawFlags_RoundCornersNone | (fill_U ? 0 : ImDrawFlags_RoundCornersTopRight)   | (fill_D ? 0 : ImDrawFlags_RoundCornersBottomRight));\par
04374     {\cf19 if} (fill_U) draw_list->AddRectFilled(ImVec2(inner.Min.x, outer.Min.y), ImVec2(inner.Max.x, inner.Min.y), col, rounding, ImDrawFlags_RoundCornersNone | (fill_L ? 0 : ImDrawFlags_RoundCornersTopLeft)    | (fill_R ? 0 : ImDrawFlags_RoundCornersTopRight));\par
04375     {\cf19 if} (fill_D) draw_list->AddRectFilled(ImVec2(inner.Min.x, inner.Max.y), ImVec2(inner.Max.x, outer.Max.y), col, rounding, ImDrawFlags_RoundCornersNone | (fill_L ? 0 : ImDrawFlags_RoundCornersBottomLeft) | (fill_R ? 0 : ImDrawFlags_RoundCornersBottomRight));\par
04376     {\cf19 if} (fill_L && fill_U) draw_list->AddRectFilled(ImVec2(outer.Min.x, outer.Min.y), ImVec2(inner.Min.x, inner.Min.y), col, rounding, ImDrawFlags_RoundCornersTopLeft);\par
04377     {\cf19 if} (fill_R && fill_U) draw_list->AddRectFilled(ImVec2(inner.Max.x, outer.Min.y), ImVec2(outer.Max.x, inner.Min.y), col, rounding, ImDrawFlags_RoundCornersTopRight);\par
04378     {\cf19 if} (fill_L && fill_D) draw_list->AddRectFilled(ImVec2(outer.Min.x, inner.Max.y), ImVec2(inner.Min.x, outer.Max.y), col, rounding, ImDrawFlags_RoundCornersBottomLeft);\par
04379     {\cf19 if} (fill_R && fill_D) draw_list->AddRectFilled(ImVec2(inner.Max.x, inner.Max.y), ImVec2(outer.Max.x, outer.Max.y), col, rounding, ImDrawFlags_RoundCornersBottomRight);\par
04380 \}\par
04381 \par
04382 ImDrawFlags ImGui::CalcRoundingFlagsForRectInRect({\cf17 const} ImRect& r_in, {\cf17 const} ImRect& r_outer, {\cf18 float} threshold)\par
04383 \{\par
04384     {\cf18 bool} round_l = r_in.Min.x <= r_outer.Min.x + threshold;\par
04385     {\cf18 bool} round_r = r_in.Max.x >= r_outer.Max.x - threshold;\par
04386     {\cf18 bool} round_t = r_in.Min.y <= r_outer.Min.y + threshold;\par
04387     {\cf18 bool} round_b = r_in.Max.y >= r_outer.Max.y - threshold;\par
04388     {\cf19 return} ImDrawFlags_RoundCornersNone\par
04389         | ((round_t && round_l) ? ImDrawFlags_RoundCornersTopLeft : 0) | ((round_t && round_r) ? ImDrawFlags_RoundCornersTopRight : 0)\par
04390         | ((round_b && round_l) ? ImDrawFlags_RoundCornersBottomLeft : 0) | ((round_b && round_r) ? ImDrawFlags_RoundCornersBottomRight : 0);\par
04391 \}\par
04392 \par
04393 {\cf20 // Helper for ColorPicker4()}\par
04394 {\cf20 // NB: This is rather brittle and will show artifact when rounding this enabled if rounded corners overlap multiple cells. Caller currently responsible for avoiding that.}\par
04395 {\cf20 // Spent a non reasonable amount of time trying to getting this right for ColorButton with rounding+anti-aliasing+ImGuiColorEditFlags_HalfAlphaPreview flag + various grid sizes and offsets, and eventually gave up... probably more reasonable to disable rounding altogether.}\par
04396 {\cf20 // FIXME: uses ImGui::GetColorU32}\par
04397 {\cf18 void} ImGui::RenderColorRectWithAlphaCheckerboard(ImDrawList* draw_list, ImVec2 p_min, ImVec2 p_max, ImU32 col, {\cf18 float} grid_step, ImVec2 grid_off, {\cf18 float} rounding, ImDrawFlags flags)\par
04398 \{\par
04399     {\cf19 if} ((flags & ImDrawFlags_RoundCornersMask_) == 0)\par
04400         flags = ImDrawFlags_RoundCornersDefault_;\par
04401     {\cf19 if} (((col & IM_COL32_A_MASK) >> IM_COL32_A_SHIFT) < 0xFF)\par
04402     \{\par
04403         ImU32 col_bg1 = GetColorU32(ImAlphaBlendColors(IM_COL32(204, 204, 204, 255), col));\par
04404         ImU32 col_bg2 = GetColorU32(ImAlphaBlendColors(IM_COL32(128, 128, 128, 255), col));\par
04405         draw_list->AddRectFilled(p_min, p_max, col_bg1, rounding, flags);\par
04406 \par
04407         {\cf18 int} yi = 0;\par
04408         {\cf19 for} ({\cf18 float} y = p_min.y + grid_off.y; y < p_max.y; y += grid_step, yi++)\par
04409         \{\par
04410             {\cf18 float} y1 = ImClamp(y, p_min.y, p_max.y), y2 = ImMin(y + grid_step, p_max.y);\par
04411             {\cf19 if} (y2 <= y1)\par
04412                 {\cf19 continue};\par
04413             {\cf19 for} ({\cf18 float} x = p_min.x + grid_off.x + (yi & 1) * grid_step; x < p_max.x; x += grid_step * 2.0f)\par
04414             \{\par
04415                 {\cf18 float} x1 = ImClamp(x, p_min.x, p_max.x), x2 = ImMin(x + grid_step, p_max.x);\par
04416                 {\cf19 if} (x2 <= x1)\par
04417                     {\cf19 continue};\par
04418                 ImDrawFlags cell_flags = ImDrawFlags_RoundCornersNone;\par
04419                 {\cf19 if} (y1 <= p_min.y) \{ {\cf19 if} (x1 <= p_min.x) cell_flags |= ImDrawFlags_RoundCornersTopLeft; {\cf19 if} (x2 >= p_max.x) cell_flags |= ImDrawFlags_RoundCornersTopRight; \}\par
04420                 {\cf19 if} (y2 >= p_max.y) \{ {\cf19 if} (x1 <= p_min.x) cell_flags |= ImDrawFlags_RoundCornersBottomLeft; {\cf19 if} (x2 >= p_max.x) cell_flags |= ImDrawFlags_RoundCornersBottomRight; \}\par
04421 \par
04422                 {\cf20 // Combine flags}\par
04423                 cell_flags = (flags == ImDrawFlags_RoundCornersNone || cell_flags == ImDrawFlags_RoundCornersNone) ? ImDrawFlags_RoundCornersNone : (cell_flags & flags);\par
04424                 draw_list->AddRectFilled(ImVec2(x1, y1), ImVec2(x2, y2), col_bg2, rounding, cell_flags);\par
04425             \}\par
04426         \}\par
04427     \}\par
04428     {\cf19 else}\par
04429     \{\par
04430         draw_list->AddRectFilled(p_min, p_max, col, rounding, flags);\par
04431     \}\par
04432 \}\par
04433 \par
04434 {\cf20 //-----------------------------------------------------------------------------}\par
04435 {\cf20 // [SECTION] Decompression code}\par
04436 {\cf20 //-----------------------------------------------------------------------------}\par
04437 {\cf20 // Compressed with stb_compress() then converted to a C array and encoded as base85.}\par
04438 {\cf20 // Use the program in misc/fonts/binary_to_compressed_c.cpp to create the array from a TTF file.}\par
04439 {\cf20 // The purpose of encoding as base85 instead of "0x00,0x01,..." style is only save on _source code_ size.}\par
04440 {\cf20 // Decompression from stb.h (public domain) by Sean Barrett https://github.com/nothings/stb/blob/master/stb.h}\par
04441 {\cf20 //-----------------------------------------------------------------------------}\par
04442 \par
04443 {\cf17 static} {\cf18 unsigned} {\cf18 int} stb_decompress_length({\cf17 const} {\cf18 unsigned} {\cf18 char} *input)\par
04444 \{\par
04445     {\cf19 return} (input[8] << 24) + (input[9] << 16) + (input[10] << 8) + input[11];\par
04446 \}\par
04447 \par
04448 {\cf17 static} {\cf18 unsigned} {\cf18 char} *stb__barrier_out_e, *stb__barrier_out_b;\par
04449 {\cf17 static} {\cf17 const} {\cf18 unsigned} {\cf18 char} *stb__barrier_in_b;\par
04450 {\cf17 static} {\cf18 unsigned} {\cf18 char} *stb__dout;\par
04451 {\cf17 static} {\cf18 void} stb__match({\cf17 const} {\cf18 unsigned} {\cf18 char} *data, {\cf18 unsigned} {\cf18 int} length)\par
04452 \{\par
04453     {\cf20 // INVERSE of memmove... write each byte before copying the next...}\par
04454     IM_ASSERT(stb__dout + length <= stb__barrier_out_e);\par
04455     {\cf19 if} (stb__dout + length > stb__barrier_out_e) \{ stb__dout += length; {\cf19 return}; \}\par
04456     {\cf19 if} (data < stb__barrier_out_b) \{ stb__dout = stb__barrier_out_e+1; {\cf19 return}; \}\par
04457     {\cf19 while} (length--) *stb__dout++ = *data++;\par
04458 \}\par
04459 \par
04460 {\cf17 static} {\cf18 void} stb__lit({\cf17 const} {\cf18 unsigned} {\cf18 char} *data, {\cf18 unsigned} {\cf18 int} length)\par
04461 \{\par
04462     IM_ASSERT(stb__dout + length <= stb__barrier_out_e);\par
04463     {\cf19 if} (stb__dout + length > stb__barrier_out_e) \{ stb__dout += length; {\cf19 return}; \}\par
04464     {\cf19 if} (data < stb__barrier_in_b) \{ stb__dout = stb__barrier_out_e+1; {\cf19 return}; \}\par
04465     memcpy(stb__dout, data, length);\par
04466     stb__dout += length;\par
04467 \}\par
04468 \par
04469 {\cf21 #define stb__in2(x)   ((i[x] << 8) + i[(x)+1])}\par
04470 {\cf21 #define stb__in3(x)   ((i[x] << 16) + stb__in2((x)+1))}\par
04471 {\cf21 #define stb__in4(x)   ((i[x] << 24) + stb__in3((x)+1))}\par
04472 \par
04473 {\cf17 static} {\cf17 const} {\cf18 unsigned} {\cf18 char} *stb_decompress_token({\cf17 const} {\cf18 unsigned} {\cf18 char} *i)\par
04474 \{\par
04475     {\cf19 if} (*i >= 0x20) \{ {\cf20 // use fewer if's for cases that expand small}\par
04476         {\cf19 if} (*i >= 0x80)       stb__match(stb__dout-i[1]-1, i[0] - 0x80 + 1), i += 2;\par
04477         {\cf19 else} {\cf19 if} (*i >= 0x40)  stb__match(stb__dout-(stb__in2(0) - 0x4000 + 1), i[2]+1), i += 3;\par
04478         {\cf19 else} {\cf20 /* *i >= 0x20 */} stb__lit(i+1, i[0] - 0x20 + 1), i += 1 + (i[0] - 0x20 + 1);\par
04479     \} {\cf19 else} \{ {\cf20 // more ifs for cases that expand large, since overhead is amortized}\par
04480         {\cf19 if} (*i >= 0x18)       stb__match(stb__dout-(stb__in3(0) - 0x180000 + 1), i[3]+1), i += 4;\par
04481         {\cf19 else} {\cf19 if} (*i >= 0x10)  stb__match(stb__dout-(stb__in3(0) - 0x100000 + 1), stb__in2(3)+1), i += 5;\par
04482         {\cf19 else} {\cf19 if} (*i >= 0x08)  stb__lit(i+2, stb__in2(0) - 0x0800 + 1), i += 2 + (stb__in2(0) - 0x0800 + 1);\par
04483         {\cf19 else} {\cf19 if} (*i == 0x07)  stb__lit(i+3, stb__in2(1) + 1), i += 3 + (stb__in2(1) + 1);\par
04484         {\cf19 else} {\cf19 if} (*i == 0x06)  stb__match(stb__dout-(stb__in3(1)+1), i[4]+1), i += 5;\par
04485         {\cf19 else} {\cf19 if} (*i == 0x04)  stb__match(stb__dout-(stb__in3(1)+1), stb__in2(4)+1), i += 6;\par
04486     \}\par
04487     {\cf19 return} i;\par
04488 \}\par
