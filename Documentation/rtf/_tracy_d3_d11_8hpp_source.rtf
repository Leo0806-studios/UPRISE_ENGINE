70             desc.Query = D3D11_QUERY_TIMESTAMP_DISJOINT;\par
71             {\cf19 if} (FAILED(m_device->CreateQuery(&desc, &m_disjointQuery)))\par
72             \{\par
73                 TracyD3D11Panic({\cf22 "unable to create disjoint timestamp query."}, {\cf19 return});\par
74             \}\par
75         \}\par
76 \par
77         {\cf19 for} (ID3D11Query*& query : m_queries)\par
78         \{\par
79             D3D11_QUERY_DESC desc = \{ \};\par
80             desc.Query = D3D11_QUERY_TIMESTAMP;\par
81             {\cf19 if} (FAILED(m_device->CreateQuery(&desc, &query)))\par
82             \{\par
83                 TracyD3D11Panic({\cf22 "unable to create timestamp query."}, {\cf19 return});\par
84             \}\par
85         \}\par
86 \par
87         {\cf20 // Calibrate CPU and GPU timestamps}\par
88         int64_t tcpu = 0;\par
89         int64_t tgpu = 0;\par
90         {\cf19 for} ({\cf18 int} attempts = 0; attempts < 50; attempts++)\par
91         \{\par
92             m_immediateDevCtx->Begin(m_disjointQuery);\par
93             m_immediateDevCtx->End(m_queries[0]);\par
94             m_immediateDevCtx->End(m_disjointQuery);\par
95 \par
96             int64_t tcpu0 = Profiler::GetTime();\par
97             WaitForQuery(m_disjointQuery);\par
98             int64_t tcpu1 = Profiler::GetTime();\par
99 \par
100             D3D11_QUERY_DATA_TIMESTAMP_DISJOINT disjoint = \{ \};\par
101             {\cf19 if} (m_immediateDevCtx->GetData(m_disjointQuery, &disjoint, {\cf17 sizeof}(disjoint), 0) != S_OK)\par
102             \{\par
103                 TracyMessageLC({\cf22 "TracyD3D11: unable to query GPU timestamp; retrying..."}, tracy::Color::Tomato);\par
104                 {\cf19 continue};\par
105             \}\par
106 \par
107             {\cf19 if} (disjoint.Disjoint)\par
108                 {\cf19 continue};\par
109 \par
110             UINT64 timestamp = 0;\par
111             {\cf19 if} (m_immediateDevCtx->GetData(m_queries[0], &timestamp, {\cf17 sizeof}(timestamp), 0) != S_OK)\par
112                 {\cf19 continue};   {\cf20 // this should never happen, since the enclosing disjoint query succeeded}\par
113 \par
114             tcpu = tcpu0 + (tcpu1 - tcpu0) * 1 / 2;\par
115             tgpu = timestamp * (1000000000 / disjoint.Frequency);\par
116             {\cf19 break};\par
117         \}\par
118 \par
119         {\cf20 // ready to roll}\par
120         m_contextId = GetGpuCtxCounter().fetch_add(1);\par
121         m_immediateDevCtx->Begin(m_disjointQuery);\par
122         m_previousCheckpoint = m_nextCheckpoint = 0;\par
123 \par
124         {\cf17 auto}* item = Profiler::QueueSerial();\par
125         MemWrite( &item->hdr.type, QueueType::GpuNewContext );\par
126         MemWrite( &item->gpuNewContext.cpuTime, tcpu );\par
127         MemWrite( &item->gpuNewContext.gpuTime, tgpu );\par
128         MemWrite( &item->gpuNewContext.thread, uint32_t(0) );   {\cf20 // #TODO: why not GetThreadHandle()?}\par
129         MemWrite( &item->gpuNewContext.period, 1.0f );\par
130         MemWrite( &item->gpuNewContext.context, m_contextId);\par
131         MemWrite( &item->gpuNewContext.flags, uint8_t(0) );\par
132         MemWrite( &item->gpuNewContext.type, GpuContextType::Direct3D11 );\par
133 \par
134 {\cf21 #ifdef TRACY_ON_DEMAND}\par
135         GetProfiler().DeferItem( *item );\par
136 {\cf21 #endif}\par
137 \par
138         Profiler::QueueSerialFinish();\par
139     \}\par
140 \par
141     ~D3D11Ctx()\par
142     \{\par
143         {\cf20 // collect all pending timestamps before destroying everything}\par
144         {\cf19 do}\par
145         \{\par
146             Collect(BLOCK);\par
147         \} {\cf19 while} (m_previousCheckpoint != m_queryCounter);\par
148 \par
149         {\cf19 for} (ID3D11Query* query : m_queries)\par
150         \{\par
151             query->Release();\par
152         \}\par
153         m_immediateDevCtx->End(m_disjointQuery);\par
154         m_disjointQuery->Release();\par
155         m_immediateDevCtx->Release();\par
156         m_device->Release();\par
157     \}\par
158 \par
159     {\cf18 void} Name( {\cf17 const} {\cf18 char}* name, uint16_t len )\par
160     \{\par
161         {\cf17 auto} ptr = ({\cf18 char}*)tracy_malloc( len );\par
162         memcpy( ptr, name, len );\par
163 \par
164         {\cf17 auto} item = Profiler::QueueSerial();\par
165         MemWrite( &item->hdr.type, QueueType::GpuContextName );\par
166         MemWrite( &item->gpuContextNameFat.context, m_contextId );\par
167         MemWrite( &item->gpuContextNameFat.ptr, (uint64_t)ptr );\par
168         MemWrite( &item->gpuContextNameFat.size, len );\par
169 {\cf21 #ifdef TRACY_ON_DEMAND}\par
170         GetProfiler().DeferItem( *item );\par
171 {\cf21 #endif}\par
172         Profiler::QueueSerialFinish();\par
173     \}\par
174 \par
175     {\cf18 void} Collect(CollectMode mode = POLL)\par
176     \{\par
177         ZoneScopedC( Color::Red4 );\par
178 \par
179 {\cf21 #ifdef TRACY_ON_DEMAND}\par
180         {\cf19 if}( !GetProfiler().IsConnected() )\par
181         \{\par
182             m_previousCheckpoint = m_nextCheckpoint = m_queryCounter;\par
183             {\cf19 return};\par
184         \}\par
185 {\cf21 #endif}\par
186 \par
187         {\cf19 if} (m_previousCheckpoint == m_nextCheckpoint)\par
188         \{\par
189             uintptr_t nextCheckpoint = m_queryCounter;\par
190             {\cf19 if} (nextCheckpoint == m_nextCheckpoint)\par
191             \{\par
192                 {\cf19 return};\par
193             \}\par
194             m_nextCheckpoint = nextCheckpoint;\par
195             m_immediateDevCtx->End(m_disjointQuery);\par
196         \}\par
197 \par
198         {\cf19 if} (mode == CollectMode::BLOCK)\par
199         \{\par
200             WaitForQuery(m_disjointQuery);\par
201         \}\par
202 \par
203         D3D11_QUERY_DATA_TIMESTAMP_DISJOINT disjoint = \{ \};\par
204         {\cf19 if} (m_immediateDevCtx->GetData(m_disjointQuery, &disjoint, {\cf17 sizeof}(disjoint), D3D11_ASYNC_GETDATA_DONOTFLUSH) != S_OK)\par
205         \{\par
206             {\cf19 return};\par
207         \}\par
208 \par
209         {\cf19 if} (disjoint.Disjoint == TRUE)\par
210         \{\par
211             m_previousCheckpoint = m_nextCheckpoint;\par
212             TracyD3D11Panic({\cf22 "disjoint timestamps detected; dropping."});\par
213             {\cf19 return};\par
214         \}\par
215 \par
216         {\cf17 auto} begin = m_previousCheckpoint;\par
217         {\cf17 auto} end = m_nextCheckpoint;\par
218         {\cf19 for} ({\cf17 auto} i = begin; i != end; ++i)\par
219         \{\par
220             uint32_t k = RingIndex(i);\par
221             UINT64 timestamp = 0;\par
222             {\cf19 if} (m_immediateDevCtx->GetData(m_queries[k], &timestamp, {\cf17 sizeof}(timestamp), 0) != S_OK)\par
223             \{\par
224                 TracyD3D11Panic({\cf22 "timestamp expected to be ready, but it was not!"});\par
225                 {\cf19 break};\par
226             \}\par
227             timestamp *= (1000000000ull / disjoint.Frequency);\par
228             {\cf17 auto}* item = Profiler::QueueSerial();\par
229             MemWrite(&item->hdr.type, QueueType::GpuTime);\par
230             MemWrite(&item->gpuTime.gpuTime, {\cf17 static_cast<}int64_t{\cf17 >}(timestamp));\par
231             MemWrite(&item->gpuTime.queryId, {\cf17 static_cast<}uint16_t{\cf17 >}(k));\par
232             MemWrite(&item->gpuTime.context, m_contextId);\par
233             Profiler::QueueSerialFinish();\par
234         \}\par
235 \par
236         {\cf20 // disjoint timestamp queries should only be invoked once per frame or less}\par
237         {\cf20 // https://learn.microsoft.com/en-us/windows/win32/api/d3d11/ne-d3d11-d3d11_query}\par
238         m_immediateDevCtx->Begin(m_disjointQuery);\par
239         m_previousCheckpoint = m_nextCheckpoint;\par
240     \}\par
241 \par
242 {\cf17 private}:\par
243     tracy_force_inline uint32_t RingIndex(uintptr_t index)\par
244     \{\par
245         index %= MaxQueries;\par
246         {\cf19 return} {\cf17 static_cast<}uint32_t{\cf17 >}(index);\par
247     \}\par
248 \par
249     tracy_force_inline uint32_t RingCount(uintptr_t begin, uintptr_t end)\par
250     \{\par
251         {\cf20 // wrap-around safe: all unsigned}\par
252         uintptr_t count = end - begin;\par
253         {\cf19 return} {\cf17 static_cast<}uint32_t{\cf17 >}(count);\par
254     \}\par
255 \par
256     tracy_force_inline uint32_t NextQueryId()\par
257     \{\par
258         {\cf17 auto} {\cf18 id} = m_queryCounter++;\par
259         {\cf19 if} (RingCount(m_previousCheckpoint, {\cf18 id}) >= MaxQueries)\par
260         \{\par
261             TracyD3D11Panic({\cf22 "too many pending timestamp queries."});\par
262             {\cf20 // #TODO: return some sentinel value; ideally a "hidden" query index}\par
263         \}\par
264         {\cf19 return} RingIndex({\cf18 id});\par
265     \}\par
266 \par
267     tracy_force_inline ID3D11Query* GetQueryObjectFromId(uint32_t {\cf18 id})\par
268     \{\par
269         {\cf19 return} m_queries[id];\par
270     \}\par
271 \par
272     tracy_force_inline {\cf18 void} WaitForQuery(ID3D11Query* query)\par
273     \{\par
274         m_immediateDevCtx->Flush();\par
275         {\cf19 while} (m_immediateDevCtx->GetData(query, {\cf17 nullptr}, 0, 0) != S_OK)\par
276             YieldThread();  {\cf20 // busy-wait :-( attempt to reduce power usage with _mm_pause() & friends...}\par
277     \}\par
278 \par
279     tracy_force_inline uint8_t GetContextId(){\cf17  const}\par
280 {\cf17     }\{\par
281         {\cf19 return} m_contextId;\par
282     \}\par
283 \par
284     ID3D11Device* m_device = {\cf17 nullptr};\par
285     ID3D11DeviceContext* m_immediateDevCtx = {\cf17 nullptr};\par
286 \par
287     ID3D11Query* m_queries[MaxQueries];\par
288     ID3D11Query* m_disjointQuery = {\cf17 nullptr};\par
289 \par
290     uint8_t m_contextId = 255;  {\cf20 // NOTE: apparently, 255 means invalid id; is this documented anywhere?}\par
291 \par
292     uintptr_t m_queryCounter = 0;\par
293 \par
294     uintptr_t m_previousCheckpoint = 0;\par
295     uintptr_t m_nextCheckpoint = 0;\par
296 \};\par
