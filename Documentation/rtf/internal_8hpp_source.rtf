230 {\cf20 /* A growable vector of some struct.  This is used for more efficient}\par
231 {\cf20    allocation when we don't know the final size of some group of data}\par
232 {\cf20    that we want to represent as an array.  */}\par
233 \par
234 {\cf17 struct }backtrace_vector\par
235 \{\par
236   {\cf20 /* The base of the vector.  */}\par
237   {\cf18 void} *base;\par
238   {\cf20 /* The number of bytes in the vector.  */}\par
239   {\cf18 size_t} size;\par
240   {\cf20 /* The number of bytes available at the current allocation.  */}\par
241   {\cf18 size_t} alc;\par
242 \};\par
243 \par
244 {\cf20 /* Grow VEC by SIZE bytes.  Return a pointer to the newly allocated}\par
245 {\cf20    bytes.  Note that this may move the entire vector to a new memory}\par
246 {\cf20    location.  Returns NULL on failure.  */}\par
247 \par
248 {\cf17 extern} {\cf18 void} *backtrace_vector_grow ({\cf17 struct} backtrace_state *state, {\cf18 size_t} size,\par
249                     backtrace_error_callback error_callback,\par
250                     {\cf18 void} *data,\par
251                     {\cf17 struct} backtrace_vector *vec);\par
252 \par
253 {\cf20 /* Finish the current allocation on VEC.  Prepare to start a new}\par
254 {\cf20    allocation.  The finished allocation will never be freed.  Returns}\par
255 {\cf20    a pointer to the base of the finished entries, or NULL on}\par
256 {\cf20    failure.  */}\par
257 \par
258 {\cf17 extern} {\cf18 void}* backtrace_vector_finish ({\cf17 struct} backtrace_state *state,\par
259                       {\cf17 struct} backtrace_vector *vec,\par
260                       backtrace_error_callback error_callback,\par
261                       {\cf18 void} *data);\par
262 \par
263 {\cf20 /* Release any extra space allocated for VEC.  This may change}\par
264 {\cf20    VEC->base.  Returns 1 on success, 0 on failure.  */}\par
265 \par
266 {\cf17 extern} {\cf18 int} backtrace_vector_release ({\cf17 struct} backtrace_state *state,\par
267                      {\cf17 struct} backtrace_vector *vec,\par
268                      backtrace_error_callback error_callback,\par
269                      {\cf18 void} *data);\par
270 \par
271 {\cf20 /* Free the space managed by VEC.  This will reset VEC.  */}\par
272 \par
273 {\cf17 static} {\cf17 inline} {\cf18 void}\par
274 backtrace_vector_free ({\cf17 struct} backtrace_state *state,\par
275                {\cf17 struct} backtrace_vector *vec,\par
276                backtrace_error_callback error_callback, {\cf18 void} *data)\par
277 \{\par
278   vec->alc += vec->size;\par
279   vec->size = 0;\par
280   backtrace_vector_release (state, vec, error_callback, data);\par
281 \}\par
