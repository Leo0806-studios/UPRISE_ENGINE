70 {\cf20    they are not available.  */}\par
71 \par
72 {\cf21 #define __sync_bool_compare_and_swap(A, B, C) (abort(), 1)}\par
73 {\cf21 #define __sync_lock_test_and_set(A, B) (abort(), 0)}\par
74 {\cf21 #define __sync_lock_release(A) abort()}\par
75 \par
76 {\cf21 #endif }{\cf20 /* !defined (HAVE_SYNC_FUNCTIONS) */}{\cf21 }\par
77 \par
78 {\cf21 #ifdef HAVE_ATOMIC_FUNCTIONS}\par
79 \par
80 {\cf20 /* We have the atomic builtin functions.  */}\par
81 \par
82 {\cf21 #define backtrace_atomic_load_pointer(p) \\}\par
83 {\cf21     __atomic_load_n ((p), __ATOMIC_ACQUIRE)}\par
84 {\cf21 #define backtrace_atomic_load_int(p) \\}\par
85 {\cf21     __atomic_load_n ((p), __ATOMIC_ACQUIRE)}\par
86 {\cf21 #define backtrace_atomic_store_pointer(p, v) \\}\par
87 {\cf21     __atomic_store_n ((p), (v), __ATOMIC_RELEASE)}\par
88 {\cf21 #define backtrace_atomic_store_size_t(p, v) \\}\par
89 {\cf21     __atomic_store_n ((p), (v), __ATOMIC_RELEASE)}\par
90 {\cf21 #define backtrace_atomic_store_int(p, v) \\}\par
91 {\cf21     __atomic_store_n ((p), (v), __ATOMIC_RELEASE)}\par
92 \par
93 {\cf21 #else }{\cf20 /* !defined (HAVE_ATOMIC_FUNCTIONS) */}{\cf21 }\par
94 {\cf21 #ifdef HAVE_SYNC_FUNCTIONS}\par
95 \par
96 {\cf20 /* We have the sync functions but not the atomic functions.  Define}\par
97 {\cf20    the atomic ones in terms of the sync ones.  */}\par
98 \par
99 {\cf17 extern} {\cf18 void} *backtrace_atomic_load_pointer ({\cf18 void} *);\par
100 {\cf17 extern} {\cf18 int} backtrace_atomic_load_int ({\cf18 int} *);\par
101 {\cf17 extern} {\cf18 void} backtrace_atomic_store_pointer ({\cf18 void} *, {\cf18 void} *);\par
102 {\cf17 extern} {\cf18 void} backtrace_atomic_store_size_t ({\cf18 size_t} *, {\cf18 size_t});\par
103 {\cf17 extern} {\cf18 void} backtrace_atomic_store_int ({\cf18 int} *, {\cf18 int});\par
104 \par
105 {\cf21 #else }{\cf20 /* !defined (HAVE_SYNC_FUNCTIONS) */}{\cf21 }\par
106 \par
107 {\cf20 /* We have neither the sync nor the atomic functions.  These will}\par
108 {\cf20    never be called.  */}\par
109 \par
110 {\cf21 #define backtrace_atomic_load_pointer(p) (abort(), (void *) NULL)}\par
111 {\cf21 #define backtrace_atomic_load_int(p) (abort(), 0)}\par
112 {\cf21 #define backtrace_atomic_store_pointer(p, v) abort()}\par
113 {\cf21 #define backtrace_atomic_store_size_t(p, v) abort()}\par
114 {\cf21 #define backtrace_atomic_store_int(p, v) abort()}\par
115 \par
116 {\cf21 #endif }{\cf20 /* !defined (HAVE_SYNC_FUNCTIONS) */}{\cf21 }\par
117 {\cf21 #endif }{\cf20 /* !defined (HAVE_ATOMIC_FUNCTIONS) */}{\cf21 }\par
