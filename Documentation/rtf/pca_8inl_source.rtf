61         \}\par
62         {\cf19 if}(cnt > 0)\par
63             m /= {\cf17 static_cast<}T{\cf17 >}(cnt);\par
64 \par
65         {\cf19 return} m;\par
66     \}\par
67 \par
68     {\cf17 namespace }_internal_\par
69     \{\par
70 \par
71         {\cf17 template}<{\cf17 typename} T>\par
72         GLM_FUNC_QUALIFIER {\cf17 static} T transferSign(T {\cf17 const}& v, T {\cf17 const}& s)\par
73         \{\par
74             {\cf19 return} ((s) >= 0 ? glm::abs(v) : -glm::abs(v));\par
75         \}\par
76 \par
77         {\cf17 template}<{\cf17 typename} T>\par
78         GLM_FUNC_QUALIFIER {\cf17 static} T pythag(T {\cf17 const}& a, T {\cf17 const}& b) \{\par
79             {\cf17 static} {\cf17 const} T epsilon = {\cf17 static_cast<}T{\cf17 >}(0.0000001);\par
80             T absa = glm::abs(a);\par
81             T absb = glm::abs(b);\par
82             {\cf19 if}(absa > absb) \{\par
83                 absb /= absa;\par
84                 absb *= absb;\par
85                 {\cf19 return} absa * glm::sqrt({\cf17 static_cast<}T{\cf17 >}(1) + absb);\par
86             \}\par
87             {\cf19 if}(glm::equal<T>(absb, 0, epsilon)) {\cf19 return} {\cf17 static_cast<}T{\cf17 >}(0);\par
88             absa /= absb;\par
89             absa *= absa;\par
90             {\cf19 return} absb * glm::sqrt({\cf17 static_cast<}T{\cf17 >}(1) + absa);\par
91         \}\par
92 \par
93     \}\par
94 \par
95     {\cf17 template}<length_t D, {\cf17 typename} T, qualifier Q>\par
96     GLM_FUNC_QUALIFIER {\cf18 unsigned} {\cf18 int} findEigenvaluesSymReal\par
97     (\par
98         mat<D, D, T, Q> {\cf17 const}& covarMat,\par
99         vec<D, T, Q>& outEigenvalues,\par
100         mat<D, D, T, Q>& outEigenvectors\par
101     )\par
102     \{\par
103         {\cf17 using }_internal_::transferSign;\par
104         {\cf17 using }_internal_::pythag;\par
105 \par
106         T a[D * D]; {\cf20 // matrix -- input and workspace for algorithm (will be changed inplace)}\par
107         T d[D]; {\cf20 // diagonal elements}\par
108         T e[D]; {\cf20 // off-diagonal elements}\par
109 \par
110         {\cf19 for}(length_t r = 0; r < D; r++)\par
111             {\cf19 for}(length_t c = 0; c < D; c++)\par
112                 a[(r) * D + (c)] = covarMat[c][r];\par
113 \par
114         {\cf20 // 1. Householder reduction.}\par
115         length_t l, k, j, i;\par
116         T scale, hh, h, g, f;\par
117         {\cf17 static} {\cf17 const} T epsilon = {\cf17 static_cast<}T{\cf17 >}(0.0000001);\par
118 \par
119         {\cf19 for}(i = D; i >= 2; i--)\par
120         \{\par
121             l = i - 1;\par
122             h = scale = 0;\par
123             {\cf19 if}(l > 1)\par
124             \{\par
125                 {\cf19 for}(k = 1; k <= l; k++)\par
126                 \{\par
127                     scale += glm::abs(a[(i - 1) * D + (k - 1)]);\par
128                 \}\par
129                 {\cf19 if}(glm::equal<T>(scale, 0, epsilon))\par
130                 \{\par
131                     e[i - 1] = a[(i - 1) * D + (l - 1)];\par
132                 \}\par
133                 {\cf19 else}\par
134                 \{\par
135                     {\cf19 for}(k = 1; k <= l; k++)\par
136                     \{\par
137                         a[(i - 1) * D + (k - 1)] /= scale;\par
138                         h += a[(i - 1) * D + (k - 1)] * a[(i - 1) * D + (k - 1)];\par
139                     \}\par
140                     f = a[(i - 1) * D + (l - 1)];\par
141                     g = ((f >= 0) ? -glm::sqrt(h) : glm::sqrt(h));\par
142                     e[i - 1] = scale * g;\par
143                     h -= f * g;\par
144                     a[(i - 1) * D + (l - 1)] = f - g;\par
145                     f = 0;\par
146                     {\cf19 for}(j = 1; j <= l; j++)\par
147                     \{\par
148                         a[(j - 1) * D + (i - 1)] = a[(i - 1) * D + (j - 1)] / h;\par
149                         g = 0;\par
150                         {\cf19 for}(k = 1; k <= j; k++)\par
151                         \{\par
152                             g += a[(j - 1) * D + (k - 1)] * a[(i - 1) * D + (k - 1)];\par
153                         \}\par
154                         {\cf19 for}(k = j + 1; k <= l; k++)\par
155                         \{\par
156                             g += a[(k - 1) * D + (j - 1)] * a[(i - 1) * D + (k - 1)];\par
157                         \}\par
158                         e[j - 1] = g / h;\par
159                         f += e[j - 1] * a[(i - 1) * D + (j - 1)];\par
160                     \}\par
161                     hh = f / (h + h);\par
162                     {\cf19 for}(j = 1; j <= l; j++)\par
163                     \{\par
164                         f = a[(i - 1) * D + (j - 1)];\par
165                         e[j - 1] = g = e[j - 1] - hh * f;\par
166                         {\cf19 for}(k = 1; k <= j; k++)\par
167                         \{\par
168                             a[(j - 1) * D + (k - 1)] -= (f * e[k - 1] + g * a[(i - 1) * D + (k - 1)]);\par
169                         \}\par
170                     \}\par
171                 \}\par
172             \}\par
173             {\cf19 else}\par
174             \{\par
175                 e[i - 1] = a[(i - 1) * D + (l - 1)];\par
176             \}\par
177             d[i - 1] = h;\par
178         \}\par
179         d[0] = 0;\par
180         e[0] = 0;\par
181         {\cf19 for}(i = 1; i <= D; i++)\par
182         \{\par
183             l = i - 1;\par
184             {\cf19 if}(!glm::equal<T>(d[i - 1], 0, epsilon))\par
185             \{\par
186                 {\cf19 for}(j = 1; j <= l; j++)\par
187                 \{\par
188                     g = 0;\par
189                     {\cf19 for}(k = 1; k <= l; k++)\par
190                     \{\par
191                         g += a[(i - 1) * D + (k - 1)] * a[(k - 1) * D + (j - 1)];\par
192                     \}\par
193                     {\cf19 for}(k = 1; k <= l; k++)\par
194                     \{\par
195                         a[(k - 1) * D + (j - 1)] -= g * a[(k - 1) * D + (i - 1)];\par
196                     \}\par
197                 \}\par
198             \}\par
199             d[i - 1] = a[(i - 1) * D + (i - 1)];\par
200             a[(i - 1) * D + (i - 1)] = 1;\par
201             {\cf19 for}(j = 1; j <= l; j++)\par
202             \{\par
203                 a[(j - 1) * D + (i - 1)] = a[(i - 1) * D + (j - 1)] = 0;\par
204             \}\par
205         \}\par
206 \par
207         {\cf20 // 2. Calculation of eigenvalues and eigenvectors (QL algorithm)}\par
208         length_t m, iter;\par
209         T s, r, p, dd, c, b;\par
210         {\cf17 const} length_t MAX_ITER = 30;\par
211 \par
212         {\cf19 for}(i = 2; i <= D; i++)\par
213         \{\par
214             e[i - 2] = e[i - 1];\par
215         \}\par
216         e[D - 1] = 0;\par
217 \par
218         {\cf19 for}(l = 1; l <= D; l++)\par
219         \{\par
220             iter = 0;\par
221             {\cf19 do}\par
222             \{\par
223                 {\cf19 for}(m = l; m <= D - 1; m++)\par
224                 \{\par
225                     dd = glm::abs(d[m - 1]) + glm::abs(d[m - 1 + 1]);\par
226                     {\cf19 if}(glm::equal<T>(glm::abs(e[m - 1]) + dd, dd, epsilon))\par
227                         {\cf19 break};\par
228                 \}\par
229                 {\cf19 if}(m != l)\par
230                 \{\par
231                     {\cf19 if}(iter++ == MAX_ITER)\par
232                     \{\par
233                         {\cf19 return} 0; {\cf20 // Too many iterations in FindEigenvalues}\par
234                     \}\par
235                     g = (d[l - 1 + 1] - d[l - 1]) / (2 * e[l - 1]);\par
236                     r = pythag<T>(g, 1);\par
237                     g = d[m - 1] - d[l - 1] + e[l - 1] / (g + transferSign(r, g));\par
238                     s = c = 1;\par
239                     p = 0;\par
240                     {\cf19 for}(i = m - 1; i >= l; i--)\par
241                     \{\par
242                         f = s * e[i - 1];\par
243                         b = c * e[i - 1];\par
244                         e[i - 1 + 1] = r = pythag(f, g);\par
245                         {\cf19 if}(glm::equal<T>(r, 0, epsilon))\par
246                         \{\par
247                             d[i - 1 + 1] -= p;\par
248                             e[m - 1] = 0;\par
249                             {\cf19 break};\par
250                         \}\par
251                         s = f / r;\par
252                         c = g / r;\par
253                         g = d[i - 1 + 1] - p;\par
254                         r = (d[i - 1] - g) * s + 2 * c * b;\par
255                         d[i - 1 + 1] = g + (p = s * r);\par
256                         g = c * r - b;\par
257                         {\cf19 for}(k = 1; k <= D; k++)\par
258                         \{\par
259                             f = a[(k - 1) * D + (i - 1 + 1)];\par
260                             a[(k - 1) * D + (i - 1 + 1)] = s * a[(k - 1) * D + (i - 1)] + c * f;\par
261                             a[(k - 1) * D + (i - 1)] = c * a[(k - 1) * D + (i - 1)] - s * f;\par
262                         \}\par
263                     \}\par
264                     {\cf19 if}(glm::equal<T>(r, 0, epsilon) && (i >= l))\par
265                         {\cf19 continue};\par
266                     d[l - 1] -= p;\par
267                     e[l - 1] = g;\par
268                     e[m - 1] = 0;\par
269                 \}\par
270             \} {\cf19 while}(m != l);\par
271         \}\par
272 \par
273         {\cf20 // 3. output}\par
274         {\cf19 for}(i = 0; i < D; i++)\par
275             outEigenvalues[i] = d[i];\par
276         {\cf19 for}(i = 0; i < D; i++)\par
277             {\cf19 for}(j = 0; j < D; j++)\par
278                 outEigenvectors[i][j] = a[(j) * D + (i)];\par
279 \par
280         {\cf19 return} D;\par
281     \}\par
282 \par
283     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
284     GLM_FUNC_QUALIFIER {\cf18 void} sortEigenvalues(vec<2, T, Q>& eigenvalues, mat<2, 2, T, Q>& eigenvectors)\par
285     \{\par
286         {\cf19 if} (eigenvalues[0] < eigenvalues[1])\par
287         \{\par
288             std::swap(eigenvalues[0], eigenvalues[1]);\par
289             std::swap(eigenvectors[0], eigenvectors[1]);\par
290         \}\par
291     \}\par
292 \par
293     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
294     GLM_FUNC_QUALIFIER {\cf18 void} sortEigenvalues(vec<3, T, Q>& eigenvalues, mat<3, 3, T, Q>& eigenvectors)\par
295     \{\par
296         {\cf19 if} (eigenvalues[0] < eigenvalues[1])\par
297         \{\par
298             std::swap(eigenvalues[0], eigenvalues[1]);\par
299             std::swap(eigenvectors[0], eigenvectors[1]);\par
300         \}\par
301         {\cf19 if} (eigenvalues[0] < eigenvalues[2])\par
302         \{\par
303             std::swap(eigenvalues[0], eigenvalues[2]);\par
304             std::swap(eigenvectors[0], eigenvectors[2]);\par
305         \}\par
306         {\cf19 if} (eigenvalues[1] < eigenvalues[2])\par
307         \{\par
308             std::swap(eigenvalues[1], eigenvalues[2]);\par
309             std::swap(eigenvectors[1], eigenvectors[2]);\par
310         \}\par
311     \}\par
312 \par
313     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
314     GLM_FUNC_QUALIFIER {\cf18 void} sortEigenvalues(vec<4, T, Q>& eigenvalues, mat<4, 4, T, Q>& eigenvectors)\par
315     \{\par
316         {\cf19 if} (eigenvalues[0] < eigenvalues[2])\par
317         \{\par
318             std::swap(eigenvalues[0], eigenvalues[2]);\par
319             std::swap(eigenvectors[0], eigenvectors[2]);\par
320         \}\par
321         {\cf19 if} (eigenvalues[1] < eigenvalues[3])\par
322         \{\par
323             std::swap(eigenvalues[1], eigenvalues[3]);\par
324             std::swap(eigenvectors[1], eigenvectors[3]);\par
325         \}\par
326         {\cf19 if} (eigenvalues[0] < eigenvalues[1])\par
327         \{\par
328             std::swap(eigenvalues[0], eigenvalues[1]);\par
329             std::swap(eigenvectors[0], eigenvectors[1]);\par
330         \}\par
331         {\cf19 if} (eigenvalues[2] < eigenvalues[3])\par
332         \{\par
333             std::swap(eigenvalues[2], eigenvalues[3]);\par
334             std::swap(eigenvectors[2], eigenvectors[3]);\par
335         \}\par
336         {\cf19 if} (eigenvalues[1] < eigenvalues[2])\par
337         \{\par
338             std::swap(eigenvalues[1], eigenvalues[2]);\par
339             std::swap(eigenvectors[1], eigenvectors[2]);\par
340         \}\par
341     \}\par
