174     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
175     GLM_FUNC_QUALIFIER GLM_CONSTEXPR vec<3, T, Q> cross(vec<3, T, Q> {\cf17 const}& x, vec<3, T, Q> {\cf17 const}& y)\par
176     \{\par
