63             {\cf19 return} (tmp.x + tmp.y) + (tmp.z + tmp.w);\par
64         \}\par
65     \};\par
66 \par
67     {\cf17 template}<{\cf17 typename} T, qualifier Q, {\cf18 bool} Aligned>\par
68     {\cf17 struct }compute_cross\par
69     \{\par
70         GLM_FUNC_QUALIFIER GLM_CONSTEXPR {\cf17 static} vec<3, T, Q> call(vec<3, T, Q> {\cf17 const}& x, vec<3, T, Q> {\cf17 const}& y)\par
71         \{\par
72             GLM_STATIC_ASSERT(std::numeric_limits<T>::is_iec559, {\cf22 "'cross' accepts only floating-point inputs"});\par
73 \par
74             {\cf19 return} vec<3, T, Q>(\par
75                 x.y * y.z - y.y * x.z,\par
76                 x.z * y.x - y.z * x.x,\par
77                 x.x * y.y - y.x * x.y);\par
78         \}\par
79     \};\par
80 \par
81     {\cf17 template}<length_t L, {\cf17 typename} T, qualifier Q, {\cf18 bool} Aligned>\par
82     {\cf17 struct }compute_normalize\par
83     \{\par
84         GLM_FUNC_QUALIFIER {\cf17 static} vec<L, T, Q> call(vec<L, T, Q> {\cf17 const}& v)\par
85         \{\par
86             GLM_STATIC_ASSERT(std::numeric_limits<T>::is_iec559, {\cf22 "'normalize' accepts only floating-point inputs"});\par
87 \par
88             {\cf19 return} v * inversesqrt(dot(v, v));\par
89         \}\par
90     \};\par
91 \par
92     {\cf17 template}<length_t L, {\cf17 typename} T, qualifier Q, {\cf18 bool} Aligned>\par
93     {\cf17 struct }compute_faceforward\par
94     \{\par
95         GLM_FUNC_QUALIFIER {\cf17 static} vec<L, T, Q> call(vec<L, T, Q> {\cf17 const}& N, vec<L, T, Q> {\cf17 const}& I, vec<L, T, Q> {\cf17 const}& Nref)\par
96         \{\par
97             GLM_STATIC_ASSERT(std::numeric_limits<T>::is_iec559, {\cf22 "'normalize' accepts only floating-point inputs"});\par
98 \par
99             {\cf19 return} dot(Nref, I) < {\cf17 static_cast<}T{\cf17 >}(0) ? N : -N;\par
100         \}\par
101     \};\par
102 \par
103     {\cf17 template}<length_t L, {\cf17 typename} T, qualifier Q, {\cf18 bool} Aligned>\par
104     {\cf17 struct }compute_reflect\par
105     \{\par
106         GLM_FUNC_QUALIFIER {\cf17 static} vec<L, T, Q> call(vec<L, T, Q> {\cf17 const}& I, vec<L, T, Q> {\cf17 const}& N)\par
107         \{\par
108             {\cf19 return} I - N * dot(N, I) * {\cf17 static_cast<}T{\cf17 >}(2);\par
109         \}\par
110     \};\par
111 \par
112     {\cf17 template}<length_t L, {\cf17 typename} T, qualifier Q, {\cf18 bool} Aligned>\par
113     {\cf17 struct }compute_refract\par
114     \{\par
115         GLM_FUNC_QUALIFIER {\cf17 static} vec<L, T, Q> call(vec<L, T, Q> {\cf17 const}& I, vec<L, T, Q> {\cf17 const}& N, T eta)\par
116         \{\par
117             T {\cf17 const} dotValue(dot(N, I));\par
118             T {\cf17 const} k({\cf17 static_cast<}T{\cf17 >}(1) - eta * eta * ({\cf17 static_cast<}T{\cf17 >}(1) - dotValue * dotValue));\par
119             vec<L, T, Q> {\cf17 const} Result =\par
120                 (k >= {\cf17 static_cast<}T{\cf17 >}(0)) ? (eta * I - (eta * dotValue + std::sqrt(k)) * N) : vec<L, T, Q>(0);\par
121             {\cf19 return} Result;\par
122         \}\par
123     \};\par
