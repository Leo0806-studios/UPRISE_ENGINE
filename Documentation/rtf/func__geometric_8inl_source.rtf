205     GLM_FUNC_QUALIFIER vec<L, T, Q> faceforward(vec<L, T, Q> {\cf17 const}& N, vec<L, T, Q> {\cf17 const}& I, vec<L, T, Q> {\cf17 const}& Nref)\par
