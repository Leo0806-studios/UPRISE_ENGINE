223     {\cf20 // refract}\par
224     {\cf17 template}<{\cf17 typename} genType>\par
225     GLM_FUNC_QUALIFIER genType refract(genType {\cf17 const}& I, genType {\cf17 const}& N, genType eta)\par
226     \{\par
227         GLM_STATIC_ASSERT(std::numeric_limits<genType>::is_iec559, {\cf22 "'refract' accepts only floating-point inputs"});\par
228         genType {\cf17 const} dotValue(dot(N, I));\par
229         genType {\cf17 const} k({\cf17 static_cast<}genType{\cf17 >}(1) - eta * eta * ({\cf17 static_cast<}genType{\cf17 >}(1) - dotValue * dotValue));\par
230         {\cf19 return} (eta * I - (eta * dotValue + sqrt(k)) * N) * {\cf17 static_cast<}genType{\cf17 >}(k >= {\cf17 static_cast<}genType{\cf17 >}(0));\par
231     \}\par
