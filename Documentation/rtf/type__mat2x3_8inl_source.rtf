425             m1[0][0] * m2[0][0] + m1[1][0] * m2[0][1],\par
426             m1[0][1] * m2[0][0] + m1[1][1] * m2[0][1],\par
427             m1[0][2] * m2[0][0] + m1[1][2] * m2[0][1],\par
428             m1[0][0] * m2[1][0] + m1[1][0] * m2[1][1],\par
429             m1[0][1] * m2[1][0] + m1[1][1] * m2[1][1],\par
