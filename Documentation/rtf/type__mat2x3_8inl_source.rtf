487     \}\par
488 \par
489     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
490     GLM_FUNC_QUALIFIER GLM_CONSTEXPR mat<2, 3, T, Q> operator/(T scalar, mat<2, 3, T, Q> {\cf17 const}& m)\par
491     \{\par
492         {\cf19 return} mat<2, 3, T, Q>(\par
493             scalar / m[0],\par
494             scalar / m[1]);\par
495     \}\par
496 \par
497     {\cf20 // -- Boolean operators --}\par
498 \par
499     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
500     GLM_FUNC_QUALIFIER GLM_CONSTEXPR {\cf18 bool} operator==(mat<2, 3, T, Q> {\cf17 const}& m1, mat<2, 3, T, Q> {\cf17 const}& m2)\par
501     \{\par
502         {\cf19 return} (m1[0] == m2[0]) && (m1[1] == m2[1]);\par
503     \}\par
504 \par
505     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
506     GLM_FUNC_QUALIFIER GLM_CONSTEXPR {\cf18 bool} operator!=(mat<2, 3, T, Q> {\cf17 const}& m1, mat<2, 3, T, Q> {\cf17 const}& m2)\par
507     \{\par
508         {\cf19 return} (m1[0] != m2[0]) || (m1[1] != m2[1]);\par
509     \}\par
510 \} {\cf20 //namespace glm}\par
}
