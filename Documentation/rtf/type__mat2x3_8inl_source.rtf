435     \{\par
436         T SrcA00 = m1[0][0];\par
437         T SrcA01 = m1[0][1];\par
438         T SrcA02 = m1[0][2];\par
439         T SrcA10 = m1[1][0];\par
440         T SrcA11 = m1[1][1];\par
441         T SrcA12 = m1[1][2];\par
442 \par
443         T SrcB00 = m2[0][0];\par
444         T SrcB01 = m2[0][1];\par
445         T SrcB10 = m2[1][0];\par
446         T SrcB11 = m2[1][1];\par
447         T SrcB20 = m2[2][0];\par
448         T SrcB21 = m2[2][1];\par
449 \par
450         mat<3, 3, T, Q> Result;\par
451         Result[0][0] = SrcA00 * SrcB00 + SrcA10 * SrcB01;\par
452         Result[0][1] = SrcA01 * SrcB00 + SrcA11 * SrcB01;\par
453         Result[0][2] = SrcA02 * SrcB00 + SrcA12 * SrcB01;\par
454         Result[1][0] = SrcA00 * SrcB10 + SrcA10 * SrcB11;\par
455         Result[1][1] = SrcA01 * SrcB10 + SrcA11 * SrcB11;\par
456         Result[1][2] = SrcA02 * SrcB10 + SrcA12 * SrcB11;\par
457         Result[2][0] = SrcA00 * SrcB20 + SrcA10 * SrcB21;\par
458         Result[2][1] = SrcA01 * SrcB20 + SrcA11 * SrcB21;\par
459         Result[2][2] = SrcA02 * SrcB20 + SrcA12 * SrcB21;\par
460         {\cf19 return} Result;\par
461     \}\par
