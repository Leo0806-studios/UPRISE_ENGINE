00239 {\cf20 // Returns a rotation matrix for a rotation around an arbitrary axis.}\par
00240 {\cf17 template} <{\cf17 typename} TReal>\par
00241 AI_FORCE_INLINE\par
00242 aiMatrix3x3t<TReal>& aiMatrix3x3t<TReal>::Rotation( TReal a, {\cf17 const} aiVector3t<TReal>& axis, aiMatrix3x3t<TReal>& out) \{\par
00243   TReal c = std::cos( a), s = std::sin( a), t = 1 - c;\par
00244   TReal x = axis.x, y = axis.y, z = axis.z;\par
00245 \par
00246   {\cf20 // Many thanks to MathWorld and Wikipedia}\par
00247   out.a1 = t*x*x + c;   out.a2 = t*x*y - s*z; out.a3 = t*x*z + s*y;\par
00248   out.b1 = t*x*y + s*z; out.b2 = t*y*y + c;   out.b3 = t*y*z - s*x;\par
00249   out.c1 = t*x*z - s*y; out.c2 = t*y*z + s*x; out.c3 = t*z*z + c;\par
00250 \par
00251   {\cf19 return} out;\par
00252 \}\par
