00190 {\cf17 template} <{\cf17 typename} TReal>\par
00191 AI_FORCE_INLINE\par
00192 aiMatrix3x3t<TReal>& aiMatrix3x3t<TReal>::Inverse() \{\par
00193     {\cf20 // Compute the reciprocal determinant}\par
00194     TReal det = Determinant();\par
00195     {\cf19 if}(det == {\cf17 static_cast<}TReal{\cf17 >}(0.0))\par
00196     \{\par
00197         {\cf20 // Matrix not invertible. Setting all elements to nan is not really}\par
00198         {\cf20 // correct in a mathematical sense; but at least qnans are easy to}\par
00199         {\cf20 // spot. XXX we might throw an exception instead, which would}\par
00200         {\cf20 // be even much better to spot :/.}\par
00201         {\cf17 const} TReal nan = std::numeric_limits<TReal>::quiet_NaN();\par
00202         *{\cf17 this} = aiMatrix3x3t<TReal>( nan,nan,nan,nan,nan,nan,nan,nan,nan);\par
00203 \par
00204         {\cf19 return} *{\cf17 this};\par
00205     \}\par
00206 \par
00207     TReal invdet = {\cf17 static_cast<}TReal{\cf17 >}(1.0) / det;\par
00208 \par
00209     aiMatrix3x3t<TReal> res;\par
00210     res.a1 = invdet  * (b2 * c3 - b3 * c2);\par
00211     res.a2 = -invdet * (a2 * c3 - a3 * c2);\par
00212     res.a3 = invdet  * (a2 * b3 - a3 * b2);\par
00213     res.b1 = -invdet * (b1 * c3 - b3 * c1);\par
00214     res.b2 = invdet  * (a1 * c3 - a3 * c1);\par
00215     res.b3 = -invdet * (a1 * b3 - a3 * b1);\par
00216     res.c1 = invdet  * (b1 * c2 - b2 * c1);\par
00217     res.c2 = -invdet * (a1 * c2 - a2 * c1);\par
00218     res.c3 = invdet  * (a1 * b2 - a2 * b1);\par
00219     *{\cf17 this} = res;\par
00220 \par
00221     {\cf19 return} *{\cf17 this};\par
00222 \}\par
00223 \par
