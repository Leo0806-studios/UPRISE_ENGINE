00185 TReal aiMatrix3x3t<TReal>::Determinant(){\cf17  const }\{\par
00186     {\cf19 return} a1*b2*c3 - a1*b3*c2 + a2*b3*c1 - a2*b1*c3 + a3*b1*c2 - a3*b2*c1;\par
00187 \}\par
