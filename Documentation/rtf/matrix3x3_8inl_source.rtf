00274 {\cf17 template} <{\cf17 typename} TReal>\par
00275 AI_FORCE_INLINE aiMatrix3x3t<TReal>& aiMatrix3x3t<TReal>::FromToMatrix({\cf17 const} aiVector3t<TReal>& from,\par
00276         {\cf17 const} aiVector3t<TReal>& to, aiMatrix3x3t<TReal>& mtx) \{\par
00277     {\cf17 const} TReal e = from * to;\par
00278     {\cf17 const} TReal f = (e < 0)? -e:e;\par
00279 \par
00280     {\cf19 if} (f > {\cf17 static_cast<}TReal{\cf17 >}(1.0) - {\cf17 static_cast<}TReal{\cf17 >}(0.00001))     {\cf20 /* "from" and "to"-vector almost parallel */}\par
00281     \{\par
00282         aiVector3D u,v;     {\cf20 /* temporary storage vectors */}\par
00283         aiVector3D x;       {\cf20 /* vector most nearly orthogonal to "from" */}\par
00284 \par
00285         x.x = (from.x > 0.0)? from.x : -from.x;\par
00286         x.y = (from.y > 0.0)? from.y : -from.y;\par
00287         x.z = (from.z > 0.0)? from.z : -from.z;\par
00288 \par
00289         {\cf19 if} (x.x < x.y)\par
00290         \{\par
00291             {\cf19 if} (x.x < x.z)\par
00292             \{\par
00293                 x.x = {\cf17 static_cast<}TReal{\cf17 >}(1.0);\par
00294                 x.y = x.z = {\cf17 static_cast<}TReal{\cf17 >}(0.0);\par
00295             \}\par
00296             {\cf19 else}\par
00297             \{\par
00298                 x.z = {\cf17 static_cast<}TReal{\cf17 >}(1.0);\par
00299                 x.x = x.y = {\cf17 static_cast<}TReal{\cf17 >}(0.0);\par
00300             \}\par
00301         \}\par
00302         {\cf19 else}\par
00303         \{\par
00304             {\cf19 if} (x.y < x.z)\par
00305             \{\par
00306                 x.y = {\cf17 static_cast<}TReal{\cf17 >}(1.0);\par
00307                 x.x = x.z = {\cf17 static_cast<}TReal{\cf17 >}(0.0);\par
00308             \}\par
00309             {\cf19 else}\par
00310             \{\par
00311                 x.z = {\cf17 static_cast<}TReal{\cf17 >}(1.0);\par
00312                 x.x = x.y = {\cf17 static_cast<}TReal{\cf17 >}(0.0);\par
00313             \}\par
00314         \}\par
00315 \par
00316         u.x = x.x - from.x; u.y = x.y - from.y; u.z = x.z - from.z;\par
00317         v.x = x.x - to.x;   v.y = x.y - to.y;   v.z = x.z - to.z;\par
00318 \par
00319         {\cf17 const} TReal c1_ = {\cf17 static_cast<}TReal{\cf17 >}(2.0) / (u * u);\par
00320         {\cf17 const} TReal c2_ = {\cf17 static_cast<}TReal{\cf17 >}(2.0) / (v * v);\par
00321         {\cf17 const} TReal c3_ = c1_ * c2_  * (u * v);\par
00322 \par
00323         {\cf19 for} ({\cf18 unsigned} {\cf18 int} i = 0; i < 3; i++)\par
00324         \{\par
00325             {\cf19 for} ({\cf18 unsigned} {\cf18 int} j = 0; j < 3; j++)\par
00326             \{\par
00327                 mtx[i][j] =  - c1_ * u[i] * u[j] - c2_ * v[i] * v[j]\par
00328                     + c3_ * v[i] * u[j];\par
00329             \}\par
00330             mtx[i][i] += {\cf17 static_cast<}TReal{\cf17 >}(1.0);\par
00331         \}\par
00332     \}\par
00333     {\cf19 else}  {\cf20 /* the most common case, unless "from"="to", or "from"=-"to" */}\par
00334     \{\par
00335         {\cf17 const} aiVector3D v = from ^ to;\par
00336         {\cf20 /* ... use this hand optimized version (9 mults less) */}\par
00337         {\cf17 const} TReal h = {\cf17 static_cast<}TReal{\cf17 >}(1.0)/({\cf17 static_cast<}TReal{\cf17 >}(1.0) + e);      {\cf20 /* optimization by Gottfried Chen */}\par
00338         {\cf17 const} TReal hvx = h * v.x;\par
00339         {\cf17 const} TReal hvz = h * v.z;\par
00340         {\cf17 const} TReal hvxy = hvx * v.y;\par
00341         {\cf17 const} TReal hvxz = hvx * v.z;\par
00342         {\cf17 const} TReal hvyz = hvz * v.y;\par
00343         mtx[0][0] = e + hvx * v.x;\par
00344         mtx[0][1] = hvxy - v.z;\par
00345         mtx[0][2] = hvxz + v.y;\par
00346 \par
00347         mtx[1][0] = hvxy + v.z;\par
00348         mtx[1][1] = e + h * v.y * v.y;\par
00349         mtx[1][2] = hvyz - v.x;\par
00350 \par
00351         mtx[2][0] = hvxz - v.y;\par
00352         mtx[2][1] = hvyz + v.x;\par
00353         mtx[2][2] = e + hvz * v.z;\par
00354     \}\par
00355     {\cf19 return} mtx;\par
00356 \}\par
00357 \par
