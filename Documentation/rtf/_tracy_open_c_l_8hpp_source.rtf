76     {\cf17 class }OpenCLCtx\par
77     \{\par
78     {\cf17 public}:\par
79         {\cf17 enum} \{ QueryCount = 64 * 1024 \};\par
80 \par
81         OpenCLCtx(cl_context context, cl_device_id device)\par
82             : m_contextId(GetGpuCtxCounter().fetch_add(1, std::memory_order_relaxed))\par
83             , m_head(0)\par
84             , m_tail(0)\par
85         \{\par
86             int64_t tcpu, tgpu;\par
87             TRACY_CL_ASSERT(m_contextId != 255);\par
88 \par
89             cl_int err = CL_SUCCESS;\par
90             cl_command_queue queue = clCreateCommandQueue(context, device, CL_QUEUE_PROFILING_ENABLE, &err);\par
91             TRACY_CL_CHECK_ERROR(err)\par
92             uint32_t dummyValue = 42;\par
93             cl_mem dummyBuffer = clCreateBuffer(context, CL_MEM_WRITE_ONLY, {\cf17 sizeof}(uint32_t), {\cf17 nullptr}, &err);\par
94             TRACY_CL_CHECK_ERROR(err)\par
95             cl_event writeBufferEvent;\par
96             TRACY_CL_CHECK_ERROR(clEnqueueWriteBuffer(queue, dummyBuffer, CL_FALSE, 0, {\cf17 sizeof}(uint32_t), &dummyValue, 0, {\cf17 nullptr}, &writeBufferEvent));\par
97             TRACY_CL_CHECK_ERROR(clWaitForEvents(1, &writeBufferEvent));\par
98 \par
99             tcpu = Profiler::GetTime();\par
100 \par
101             cl_int eventStatus;\par
102             TRACY_CL_CHECK_ERROR(clGetEventInfo(writeBufferEvent, CL_EVENT_COMMAND_EXECUTION_STATUS, {\cf17 sizeof}(cl_int), &eventStatus, {\cf17 nullptr}));\par
103             TRACY_CL_ASSERT(eventStatus == CL_COMPLETE);\par
104             TRACY_CL_CHECK_ERROR(clGetEventProfilingInfo(writeBufferEvent, CL_PROFILING_COMMAND_END, {\cf17 sizeof}(cl_ulong), &tgpu, {\cf17 nullptr}));\par
105             TRACY_CL_CHECK_ERROR(clReleaseEvent(writeBufferEvent));\par
106             TRACY_CL_CHECK_ERROR(clReleaseMemObject(dummyBuffer));\par
107             TRACY_CL_CHECK_ERROR(clReleaseCommandQueue(queue));\par
108 \par
109             {\cf17 auto} item = Profiler::QueueSerial();\par
110             MemWrite(&item->hdr.type, QueueType::GpuNewContext);\par
111             MemWrite(&item->gpuNewContext.cpuTime, tcpu);\par
112             MemWrite(&item->gpuNewContext.gpuTime, tgpu);\par
113             memset(&item->gpuNewContext.thread, 0, {\cf17 sizeof}(item->gpuNewContext.thread));\par
114             MemWrite(&item->gpuNewContext.period, 1.0f);\par
115             MemWrite(&item->gpuNewContext.type, GpuContextType::OpenCL);\par
116             MemWrite(&item->gpuNewContext.context, (uint8_t) m_contextId);\par
117             MemWrite(&item->gpuNewContext.flags, (uint8_t)0);\par
118 {\cf21 #ifdef TRACY_ON_DEMAND}\par
119             GetProfiler().DeferItem(*item);\par
120 {\cf21 #endif}\par
121             Profiler::QueueSerialFinish();\par
122         \}\par
123 \par
124         {\cf18 void} Name( {\cf17 const} {\cf18 char}* name, uint16_t len )\par
125         \{\par
126             {\cf17 auto} ptr = ({\cf18 char}*)tracy_malloc( len );\par
127             memcpy( ptr, name, len );\par
128 \par
129             {\cf17 auto} item = Profiler::QueueSerial();\par
130             MemWrite( &item->hdr.type, QueueType::GpuContextName );\par
131             MemWrite( &item->gpuContextNameFat.context, (uint8_t)m_contextId );\par
132             MemWrite( &item->gpuContextNameFat.ptr, (uint64_t)ptr );\par
133             MemWrite( &item->gpuContextNameFat.size, len );\par
134 {\cf21 #ifdef TRACY_ON_DEMAND}\par
135             GetProfiler().DeferItem( *item );\par
136 {\cf21 #endif}\par
137             Profiler::QueueSerialFinish();\par
138         \}\par
139 \par
140         {\cf18 void} Collect()\par
141         \{\par
142             ZoneScopedC(Color::Red4);\par
143 \par
144             {\cf19 if} (m_tail == m_head) {\cf19 return};\par
145 \par
146 {\cf21 #ifdef TRACY_ON_DEMAND}\par
147             {\cf19 if} (!GetProfiler().IsConnected())\par
148             \{\par
149                 m_head = m_tail = 0;\par
150             \}\par
151 {\cf21 #endif}\par
152 \par
153             {\cf19 for} (; m_tail != m_head; m_tail = (m_tail + 1) % QueryCount)\par
154             \{\par
155                 EventInfo eventInfo = GetQuery(m_tail);\par
156                 cl_int eventStatus;\par
157                 cl_int err = clGetEventInfo(eventInfo.event, CL_EVENT_COMMAND_EXECUTION_STATUS, {\cf17 sizeof}(cl_int), &eventStatus, {\cf17 nullptr});\par
158                 {\cf19 if} (err != CL_SUCCESS)\par
159                 \{\par
160                     std::ostringstream oss;\par
161                     oss << {\cf22 "clGetEventInfo falied with error code "} << err << {\cf22 ", on event "} << eventInfo.event << {\cf22 ", skipping..."};\par
162                     {\cf17 auto} msg = oss.str();\par
163                     TracyMessage(msg.data(), msg.size());\par
164                     {\cf19 if} (eventInfo.event == {\cf17 nullptr}) \{\par
165                         TracyMessageL({\cf22 "A TracyCLZone must be paird with a TracyCLZoneSetEvent, check your code!"});\par
166                     \}\par
167                     assert({\cf17 false} && {\cf22 "clGetEventInfo failed, maybe a TracyCLZone is not paired with TracyCLZoneSetEvent"});\par
168                     {\cf19 continue};\par
169                 \}\par
170                 {\cf19 if} (eventStatus != CL_COMPLETE) {\cf19 return};\par
171 \par
172                 cl_int eventInfoQuery = (eventInfo.phase == EventPhase::Begin)\par
173                     ? CL_PROFILING_COMMAND_START\par
174                     : CL_PROFILING_COMMAND_END;\par
175 \par
176                 cl_ulong eventTimeStamp = 0;\par
177                 err = clGetEventProfilingInfo(eventInfo.event, eventInfoQuery, {\cf17 sizeof}(cl_ulong), &eventTimeStamp, {\cf17 nullptr});\par
178                 {\cf19 if} (err == CL_PROFILING_INFO_NOT_AVAILABLE)\par
179                 \{\par
180                     TracyMessageL({\cf22 "command queue is not created with CL_QUEUE_PROFILING_ENABLE flag, check your code!"});\par
181                     assert({\cf17 false} && {\cf22 "command queue is not created with CL_QUEUE_PROFILING_ENABLE flag"});\par
182                 \}\par
183                 {\cf19 else}\par
184                     TRACY_CL_CHECK_ERROR(err);\par
185 \par
186                 TRACY_CL_ASSERT(eventTimeStamp != 0);\par
187 \par
188                 {\cf17 auto} item = Profiler::QueueSerial();\par
189                 MemWrite(&item->hdr.type, QueueType::GpuTime);\par
190                 MemWrite(&item->gpuTime.gpuTime, (int64_t)eventTimeStamp);\par
191                 MemWrite(&item->gpuTime.queryId, (uint16_t)m_tail);\par
192                 MemWrite(&item->gpuTime.context, m_contextId);\par
193                 Profiler::QueueSerialFinish();\par
194 \par
195                 {\cf19 if} (eventInfo.phase == EventPhase::End)\par
196                 \{\par
197                     {\cf20 // Done with the event, so release it}\par
198                     TRACY_CL_CHECK_ERROR(clReleaseEvent(eventInfo.event));\par
199                 \}\par
200             \}\par
201         \}\par
202 \par
203         tracy_force_inline uint8_t GetId(){\cf17  const}\par
204 {\cf17         }\{\par
205             {\cf19 return} m_contextId;\par
206         \}\par
207 \par
208         tracy_force_inline {\cf18 unsigned} {\cf18 int} NextQueryId(EventInfo eventInfo)\par
209         \{\par
210             {\cf17 const} {\cf17 auto} {\cf18 id} = m_head;\par
211             m_head = (m_head + 1) % QueryCount;\par
212             TRACY_CL_ASSERT(m_head != m_tail);\par
213             m_query[id] = eventInfo;\par
214             {\cf19 return} id;\par
215         \}\par
216 \par
217         tracy_force_inline EventInfo& GetQuery({\cf18 unsigned} {\cf18 int} {\cf18 id})\par
218         \{\par
219             TRACY_CL_ASSERT({\cf18 id} < QueryCount);\par
220             {\cf19 return} m_query[id];\par
221         \}\par
222 \par
223     {\cf17 private}:\par
224 \par
225         {\cf18 unsigned} {\cf18 int} m_contextId;\par
226 \par
227         EventInfo m_query[QueryCount];\par
228         {\cf18 unsigned} {\cf18 int} m_head; {\cf20 // index at which a new event should be inserted}\par
229         {\cf18 unsigned} {\cf18 int} m_tail; {\cf20 // oldest event}\par
230 \par
231     \};\par
