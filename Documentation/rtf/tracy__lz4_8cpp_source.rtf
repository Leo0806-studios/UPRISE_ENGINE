02573         result = LZ4_decompress_fast(source, dest, originalSize);\par
02574         {\cf19 if} (result <= 0) {\cf19 return} result;\par
02575         lz4sd->prefixSize = (size_t)originalSize;\par
02576         lz4sd->prefixEnd = (BYTE*)dest + originalSize;\par
02577     \} {\cf19 else} {\cf19 if} (lz4sd->prefixEnd == (BYTE*)dest) \{\par
02578         DEBUGLOG(5, {\cf22 "continue using existing prefix"});\par
02579         result = LZ4_decompress_unsafe_generic(\par
02580                         ({\cf17 const} BYTE*)source, (BYTE*)dest, originalSize,\par
02581                         lz4sd->prefixSize,\par
02582                         lz4sd->externalDict, lz4sd->extDictSize);\par
02583         {\cf19 if} (result <= 0) {\cf19 return} result;\par
02584         lz4sd->prefixSize += (size_t)originalSize;\par
02585         lz4sd->prefixEnd  += originalSize;\par
02586     \} {\cf19 else} \{\par
02587         DEBUGLOG(5, {\cf22 "prefix becomes extDict"});\par
02588         lz4sd->extDictSize = lz4sd->prefixSize;\par
02589         lz4sd->externalDict = lz4sd->prefixEnd - lz4sd->extDictSize;\par
02590         result = LZ4_decompress_fast_extDict(source, dest, originalSize,\par
02591                                              lz4sd->externalDict, lz4sd->extDictSize);\par
02592         {\cf19 if} (result <= 0) {\cf19 return} result;\par
02593         lz4sd->prefixSize = (size_t)originalSize;\par
02594         lz4sd->prefixEnd  = (BYTE*)dest + originalSize;\par
02595     \}\par
02596 \par
02597     {\cf19 return} result;\par
02598 \}\par
