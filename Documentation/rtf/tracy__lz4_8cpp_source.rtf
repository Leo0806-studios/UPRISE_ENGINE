02612     {\cf19 if} (dictStart+dictSize == dest) \{\par
02613         {\cf19 if} (dictSize >= 64 KB - 1) \{\par
02614             {\cf19 return} LZ4_decompress_safe_withPrefix64k(source, dest, compressedSize, maxOutputSize);\par
02615         \}\par
02616         assert(dictSize >= 0);\par
02617         {\cf19 return} LZ4_decompress_safe_withSmallPrefix(source, dest, compressedSize, maxOutputSize, ({\cf18 size_t})dictSize);\par
02618     \}\par
02619     assert(dictSize >= 0);\par
02620     {\cf19 return} LZ4_decompress_safe_forceExtDict(source, dest, compressedSize, maxOutputSize, dictStart, ({\cf18 size_t})dictSize);\par
