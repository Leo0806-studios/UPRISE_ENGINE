02608 {\cf18 int} LZ4_decompress_safe_usingDict({\cf17 const} {\cf18 char}* source, {\cf18 char}* dest, {\cf18 int} compressedSize, {\cf18 int} maxOutputSize, {\cf17 const} {\cf18 char}* dictStart, {\cf18 int} dictSize)\par
