00063 {\cf20 /* LZ4_FORCE_MEMORY_ACCESS}\par
00064 {\cf20  * By default, access to unaligned memory is controlled by `memcpy()`, which is safe and portable.}\par
00065 {\cf20  * Unfortunately, on some target/compiler combinations, the generated assembly is sub-optimal.}\par
00066 {\cf20  * The below switch allow to select different access method for improved performance.}\par
00067 {\cf20  * Method 0 (default) : use `memcpy()`. Safe and portable.}\par
00068 {\cf20  * Method 1 : `__packed` statement. It depends on compiler extension (ie, not portable).}\par
00069 {\cf20  *            This method is safe if your compiler supports it, and *generally* as fast or faster than `memcpy`.}\par
00070 {\cf20  * Method 2 : direct access. This method is portable but violate C standard.}\par
00071 {\cf20  *            It can generate buggy code on targets which assembly generation depends on alignment.}\par
00072 {\cf20  *            But in some circumstances, it's the only known way to get the most performance (ie GCC + ARMv6)}\par
00073 {\cf20  * See https://fastcompression.blogspot.fr/2015/08/accessing-unaligned-memory.html for details.}\par
00074 {\cf20  * Prefer these methods in priority order (0 > 1 > 2)}\par
00075 {\cf20  */}\par
00076 {\cf21 #ifndef LZ4_FORCE_MEMORY_ACCESS   }{\cf20 /* can be defined externally */}{\cf21 }\par
00077 {\cf21 #  if defined(__GNUC__) && \\}\par
00078 {\cf21   ( defined(__ARM_ARCH_6__) || defined(__ARM_ARCH_6J__) || defined(__ARM_ARCH_6K__) \\}\par
00079 {\cf21   || defined(__ARM_ARCH_6Z__) || defined(__ARM_ARCH_6ZK__) || defined(__ARM_ARCH_6T2__) )}\par
00080 {\cf21 #    define LZ4_FORCE_MEMORY_ACCESS 2}\par
00081 {\cf21 #  elif (defined(__INTEL_COMPILER) && !defined(_WIN32)) || defined(__GNUC__)}\par
00082 {\cf21 #    define LZ4_FORCE_MEMORY_ACCESS 1}\par
00083 {\cf21 #  endif}\par
00084 {\cf21 #endif}\par
