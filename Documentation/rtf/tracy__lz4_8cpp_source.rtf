02624 \{\par
02625     {\cf19 if} (dictSize==0)\par
02626         {\cf19 return} LZ4_decompress_safe_partial(source, dest, compressedSize, targetOutputSize, dstCapacity);\par
02627     {\cf19 if} (dictStart+dictSize == dest) \{\par
02628         {\cf19 if} (dictSize >= 64 KB - 1) \{\par
02629             {\cf19 return} LZ4_decompress_safe_partial_withPrefix64k(source, dest, compressedSize, targetOutputSize, dstCapacity);\par
02630         \}\par
02631         assert(dictSize >= 0);\par
02632         {\cf19 return} LZ4_decompress_safe_partial_withSmallPrefix(source, dest, compressedSize, targetOutputSize, dstCapacity, ({\cf18 size_t})dictSize);\par
02633     \}\par
02634     assert(dictSize >= 0);\par
02635     {\cf19 return} LZ4_decompress_safe_partial_forceExtDict(source, dest, compressedSize, targetOutputSize, dstCapacity, dictStart, ({\cf18 size_t})dictSize);\par
02636 \}\par
02637 \par
02638 {\cf18 int} LZ4_decompress_fast_usingDict({\cf17 const} {\cf18 char}* source, {\cf18 char}* dest, {\cf18 int} originalSize, {\cf17 const} {\cf18 char}* dictStart, {\cf18 int} dictSize)\par
02639 \{\par
02640     {\cf19 if} (dictSize==0 || dictStart+dictSize == dest)\par
02641         {\cf19 return} LZ4_decompress_unsafe_generic(\par
02642                         ({\cf17 const} BYTE*)source, (BYTE*)dest, originalSize,\par
02643                         ({\cf18 size_t})dictSize, NULL, 0);\par
02644     assert(dictSize >= 0);\par
02645     {\cf19 return} LZ4_decompress_fast_extDict(source, dest, originalSize, dictStart, ({\cf18 size_t})dictSize);\par
02646 \}\par
