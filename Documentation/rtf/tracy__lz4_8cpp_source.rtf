00161 {\cf21 #  define LZ4_FORCE_O2  __attribute__((optimize("O2")))}\par
00162 {\cf21 #  undef LZ4_FORCE_INLINE}\par
00163 {\cf21 #  define LZ4_FORCE_INLINE  static __inline __attribute__((optimize("O2"),always_inline))}\par
00164 {\cf21 #else}\par
00165 {\cf21 #  define LZ4_FORCE_O2}\par
00166 {\cf21 #endif}\par
