172     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
173     GLM_FUNC_QUALIFIER mat<4, 4, T, Q> orientation\par
174     (\par
175         vec<3, T, Q> {\cf17 const}& Normal,\par
176         vec<3, T, Q> {\cf17 const}& Up\par
177     )\par
178     \{\par
179         {\cf19 if}(all(equal(Normal, Up, epsilon<T>())))\par
180             {\cf19 return} mat<4, 4, T, Q>({\cf17 static_cast<}T{\cf17 >}(1));\par
181 \par
182         vec<3, T, Q> RotationAxis = cross(Up, Normal);\par
183         T Angle = acos(dot(Normal, Up));\par
184 \par
185         {\cf19 return} rotate(Angle, RotationAxis);\par
186     \}\par
