198     \{\par
199         D3D12_STATE_SUBOBJECT* pSubobjectArrayLocation; {\cf20 // new location when flattened into array}\par
200                                                         {\cf20 // for repointing pointers in subobjects}\par
201     \} SUBOBJECT_WRAPPER;\par
202     D3D12_STATE_OBJECT_DESC m_Desc;\par
203     std::list<SUBOBJECT_WRAPPER>   m_SubobjectList; {\cf20 // Pointers to list nodes handed out so}\par
204                                                     {\cf20 // these can be edited live}\par
205     std::vector<D3D12_STATE_SUBOBJECT> m_SubobjectArray; {\cf20 // Built at the end, copying list contents}\par
206 \par
207     std::list<D3D12_SUBOBJECT_TO_EXPORTS_ASSOCIATION>\par
208         m_RepointedAssociations; {\cf20 // subobject type that contains pointers to other subobjects,}\par
209                                  {\cf20 // repointed to flattened array}\par
210 \par
211 {\cf21 #if defined(D3D12_SDK_VERSION) && (D3D12_SDK_VERSION >= 612)}\par
212     std::list<std::vector<D3D12_STATE_SUBOBJECT const*>>\par
213         m_RepointedSubobjectVectors;\par
