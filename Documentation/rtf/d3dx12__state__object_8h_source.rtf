174     D3D12_STATE_SUBOBJECT* TrackSubobject(D3D12_STATE_SUBOBJECT_TYPE Type, {\cf18 void}* pDesc)\par
175     \{\par
176         SUBOBJECT_WRAPPER Subobject;\par
177         Subobject.pSubobjectArrayLocation = {\cf17 nullptr};\par
178         Subobject.Type = Type;\par
179         Subobject.pDesc = pDesc;\par
180         m_SubobjectList.push_back(Subobject);\par
181         m_Desc.NumSubobjects++;\par
182         {\cf19 return} &m_SubobjectList.back();\par
183     \}\par
184     {\cf18 void} Init(D3D12_STATE_OBJECT_TYPE Type) {\cf17 noexcept}\par
185     \{\par
186         SetStateObjectType(Type);\par
187         m_Desc.pSubobjects = {\cf17 nullptr};\par
188         m_Desc.NumSubobjects = 0;\par
189         m_SubobjectList.clear();\par
190         m_SubobjectArray.clear();\par
191         m_RepointedAssociations.clear();\par
192 {\cf21 #if defined(D3D12_SDK_VERSION) && (D3D12_SDK_VERSION >= 612)}\par
193         m_RepointedSubobjectVectors.clear();\par
194         m_RepointedPrograms.clear();\par
195 {\cf21 #endif}\par
196     \}\par
