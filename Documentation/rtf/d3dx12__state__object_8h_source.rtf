65     CD3DX12_STATE_OBJECT_DESC& operator=(CD3DX12_STATE_OBJECT_DESC&& other) = {\cf19 default};\par
66     {\cf17 operator} {\cf17 const} D3D12_STATE_OBJECT_DESC& ()\par
67     \{\par
68         {\cf20 // Do final preparation work}\par
69         {\cf19 for} ({\cf17 auto}& ownedSubobject : m_OwnedSubobjectHelpers)\par
70         \{\par
71             ownedSubobject->Finalize();\par
72         \}\par
73 \par
74 {\cf21 #if defined(D3D12_SDK_VERSION) && (D3D12_SDK_VERSION >= 612)}\par
75         m_RepointedSubobjectVectors.clear();\par
76         m_RepointedPrograms.clear();\par
77 {\cf21 #endif}\par
78         m_RepointedAssociations.clear();\par
79         m_SubobjectArray.clear();\par
80         m_SubobjectArray.reserve(m_Desc.NumSubobjects);\par
81         {\cf20 // Flatten subobjects into an array (each flattened subobject still has a}\par
82         {\cf20 // member that's a pointer to its desc that's not flattened)}\par
83         {\cf19 for} ({\cf17 auto} Iter = m_SubobjectList.begin();\par
84             Iter != m_SubobjectList.end(); Iter++)\par
85         \{\par
86             m_SubobjectArray.push_back(*Iter);\par
87             {\cf20 // Store new location in array so we can redirect pointers contained in subobjects}\par
88             Iter->pSubobjectArrayLocation = &m_SubobjectArray.back();\par
89         \}\par
90         {\cf20 // For subobjects with pointer fields, create a new copy of those subobject definitions}\par
91         {\cf20 // with fixed pointers}\par
92         {\cf19 for} (UINT i = 0; i < m_Desc.NumSubobjects; i++)\par
93         \{\par
94             {\cf19 if} (m_SubobjectArray[i].Type == D3D12_STATE_SUBOBJECT_TYPE_SUBOBJECT_TO_EXPORTS_ASSOCIATION)\par
95             \{\par
96                 {\cf17 auto} pOriginalSubobjectAssociation =\par
97                     {\cf17 static_cast<}{\cf17 const }D3D12_SUBOBJECT_TO_EXPORTS_ASSOCIATION*{\cf17 >}(m_SubobjectArray[i].pDesc);\par
98                 D3D12_SUBOBJECT_TO_EXPORTS_ASSOCIATION Repointed = *pOriginalSubobjectAssociation;\par
99                 {\cf17 auto} pWrapper =\par
100                     {\cf17 static_cast<}{\cf17 const }SUBOBJECT_WRAPPER*{\cf17 >}(pOriginalSubobjectAssociation->pSubobjectToAssociate);\par
101                 Repointed.pSubobjectToAssociate = pWrapper->pSubobjectArrayLocation;\par
102                 m_RepointedAssociations.push_back(Repointed);\par
103                 m_SubobjectArray[i].pDesc = &m_RepointedAssociations.back();\par
104             \}\par
105 {\cf21 #if defined(D3D12_SDK_VERSION) && (D3D12_SDK_VERSION >= 612)}\par
106             {\cf19 else} {\cf19 if} (m_SubobjectArray[i].Type == D3D12_STATE_SUBOBJECT_TYPE_GENERIC_PROGRAM)\par
107             \{\par
108                 {\cf17 auto} originalGenericProgramDesc =\par
109                     {\cf17 static_cast<}{\cf17 const }D3D12_GENERIC_PROGRAM_DESC*{\cf17 >}(m_SubobjectArray[i].pDesc);\par
110                 D3D12_GENERIC_PROGRAM_DESC Repointed = *originalGenericProgramDesc;\par
111                 {\cf19 if} (originalGenericProgramDesc->NumSubobjects > 0)\par
112                 \{\par
113                     m_RepointedSubobjectVectors.emplace_back(std::vector<const D3D12_STATE_SUBOBJECT*>());\par
114                     std::vector<D3D12_STATE_SUBOBJECT const*>& repointedGenericProgramSubobjects = m_RepointedSubobjectVectors.back();\par
115                     repointedGenericProgramSubobjects.resize(originalGenericProgramDesc->NumSubobjects);\par
116                     {\cf19 for} (UINT s = 0; s < originalGenericProgramDesc->NumSubobjects; s++)\par
117                     \{\par
118                         {\cf17 auto} pWrapper =\par
119                             {\cf17 static_cast<}{\cf17 const }SUBOBJECT_WRAPPER*{\cf17 >}(originalGenericProgramDesc->ppSubobjects[s]);\par
120                         repointedGenericProgramSubobjects[s] = pWrapper->pSubobjectArrayLocation;\par
121                     \}\par
122                     {\cf20 // Below: using ugly way to get pointer in case .data() is not defined}\par
123                     Repointed.ppSubobjects = &repointedGenericProgramSubobjects[0];\par
124                 \}\par
125                 m_RepointedPrograms.push_back(Repointed);\par
126                 m_SubobjectArray[i].pDesc = &m_RepointedPrograms.back();\par
127             \}\par
128 {\cf21 #endif}\par
129         \}\par
130         {\cf20 // Below: using ugly way to get pointer in case .data() is not defined}\par
131         m_Desc.pSubobjects = m_Desc.NumSubobjects ? &m_SubobjectArray[0] : {\cf17 nullptr};\par
132         {\cf19 return} m_Desc;\par
133     \}\par
134     {\cf17 operator} {\cf17 const} D3D12_STATE_OBJECT_DESC* ()\par
135     \{\par
136         {\cf20 // Cast calls the above final preparation work}\par
137         {\cf19 return} &{\cf17 static_cast<}{\cf17 const }D3D12_STATE_OBJECT_DESC&{\cf17 >}(*this);\par
138     \}\par
139 \par
140     {\cf20 // CreateSubobject creates a sububject helper (e.g. CD3DX12_HIT_GROUP_SUBOBJECT)}\par
141     {\cf20 // whose lifetime is owned by this class.}\par
142     {\cf20 // e.g.}\par
143     {\cf20 //}\par
144     {\cf20 //    CD3DX12_STATE_OBJECT_DESC Collection1(D3D12_STATE_OBJECT_TYPE_COLLECTION);}\par
145     {\cf20 //    auto Lib0 = Collection1.CreateSubobject<CD3DX12_DXIL_LIBRARY_SUBOBJECT>();}\par
146     {\cf20 //    Lib0->SetDXILLibrary(&pMyAppDxilLibs[0]);}\par
147     {\cf20 //    Lib0->DefineExport(L"rayGenShader0"); // in practice these export listings might be}\par
148     {\cf20 //                                          // data/engine driven}\par
149     {\cf20 //    etc.}\par
150     {\cf20 //}\par
151     {\cf20 // Alternatively, users can instantiate sububject helpers explicitly, such as via local}\par
152     {\cf20 // variables instead, passing the state object desc that should point to it into the helper}\par
153     {\cf20 // constructor (or call mySubobjectHelper.AddToStateObject(Collection1)).}\par
154     {\cf20 // In this alternative scenario, the user must keep the subobject alive as long as the state}\par
155     {\cf20 // object it is associated with is alive, else its pointer references will be stale.}\par
156     {\cf20 // e.g.}\par
157     {\cf20 //}\par
158     {\cf20 //    CD3DX12_STATE_OBJECT_DESC RaytracingState2(D3D12_STATE_OBJECT_TYPE_RAYTRACING_PIPELINE);}\par
159     {\cf20 //    CD3DX12_DXIL_LIBRARY_SUBOBJECT LibA(RaytracingState2);}\par
160     {\cf20 //    LibA.SetDXILLibrary(&pMyAppDxilLibs[4]); // not manually specifying exports}\par
161     {\cf20 //                                             // - meaning all exports in the libraries}\par
162     {\cf20 //                                             // are exported}\par
163     {\cf20 //    etc.}\par
164 \par
165     {\cf17 template}<{\cf17 typename} T>\par
166     T* CreateSubobject()\par
167     \{\par
168         T* pSubobject = {\cf17 new} T(*{\cf17 this});\par
169         m_OwnedSubobjectHelpers.emplace_back(pSubobject);\par
170         {\cf19 return} pSubobject;\par
171     \}\par
