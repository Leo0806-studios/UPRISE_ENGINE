28696 {\cf20 // D3D12EnableExperimentalFeatures}\par
28697 {\cf20 //}\par
28698 {\cf20 // Pass in a list of feature GUIDs to be enabled together.}\par
28699 {\cf20 // }\par
28700 {\cf20 // If a particular feature requires some configuration information on enablement, it will have}\par
28701 {\cf20 // a configuration struct that can be passed alongside the GUID.}\par
28702 {\cf20 // }\par
28703 {\cf20 // Some features might use an interface IID as the GUID.  For these, once the feature is enabled via}\par
28704 {\cf20 // D3D12EnableExperimentalFeatures, D3D12GetDebugInterface can then be called with the IID to retrieve the interface}\par
28705 {\cf20 // for manipulating the feature.  This allows for control that might not cleanly be expressed by just }\par
28706 {\cf20 // the configuration struct that D3D12EnableExperimentalFeatures provides.}\par
28707 {\cf20 //}\par
28708 {\cf20 // If this method is called and a change to existing feature enablement is made, }\par
28709 {\cf20 // all current D3D12 devices are set to DEVICE_REMOVED state, since under the covers there is really only one}\par
28710 {\cf20 // singleton device for a process.  Removing the devices when configuration changes prevents}\par
28711 {\cf20 // mismatched expectations of how a device is supposed to work after it has been created from the app's point of view.}\par
28712 {\cf20 //}\par
28713 {\cf20 // The call returns E_NOINTERFACE if an unrecognized feature is passed in or Windows Developer mode is not on.}\par
28714 {\cf20 // The call returns E_INVALIDARG if the configuration of a feature is incorrect, the set of features passed}\par
28715 {\cf20 // in are known to be incompatible with each other, or other errors.}\par
28716 {\cf20 // Returns S_OK otherwise.}\par
28717 {\cf20 //}\par
28718 {\cf20 // --------------------------------------------------------------------------------------------------------------------------------}\par
28719 HRESULT WINAPI D3D12EnableExperimentalFeatures(\par
28720     UINT                                    NumFeatures,\par
28721     _In_count_(NumFeatures) {\cf17 const} IID*     pIIDs,\par
28722     _In_opt_count_(NumFeatures) {\cf18 void}*      pConfigurationStructs,\par
28723     _In_opt_count_(NumFeatures) UINT*      pConfigurationStructSizes);\par
28724 \par
