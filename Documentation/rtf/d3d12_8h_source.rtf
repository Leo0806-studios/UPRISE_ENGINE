3534 \par
3535 {\cf21 #define D3D12_MIP_FILTER_SHIFT  ( 0 )}\par
3536 \par
3537 {\cf21 #define D3D12_ANISOTROPIC_FILTERING_BIT ( 0x40 )}\par
3538 \par
3539 {\cf21 #define D3D12_ENCODE_BASIC_FILTER( min, mag, mip, reduction )                                                     \\}\par
3540 {\cf21                                    ( ( D3D12_FILTER ) (                                                           \\}\par
3541 {\cf21                                    ( ( ( min ) & D3D12_FILTER_TYPE_MASK ) << D3D12_MIN_FILTER_SHIFT ) |           \\}\par
3542 {\cf21                                    ( ( ( mag ) & D3D12_FILTER_TYPE_MASK ) << D3D12_MAG_FILTER_SHIFT ) |           \\}\par
3543 {\cf21                                    ( ( ( mip ) & D3D12_FILTER_TYPE_MASK ) << D3D12_MIP_FILTER_SHIFT ) |           \\}\par
3544 {\cf21                                    ( ( ( reduction ) & D3D12_FILTER_REDUCTION_TYPE_MASK ) << D3D12_FILTER_REDUCTION_TYPE_SHIFT ) ) ) }\par
3545 {\cf21 #define D3D12_ENCODE_ANISOTROPIC_FILTER( reduction )                                                  \\}\par
3546 {\cf21                                          ( ( D3D12_FILTER ) (                                         \\}\par
3547 {\cf21                                          D3D12_ANISOTROPIC_FILTERING_BIT |                            \\}\par
3548 {\cf21                                          D3D12_ENCODE_BASIC_FILTER( D3D12_FILTER_TYPE_LINEAR,         \\}\par
3549 {\cf21                                                                     D3D12_FILTER_TYPE_LINEAR,         \\}\par
3550 {\cf21                                                                     D3D12_FILTER_TYPE_LINEAR,         \\}\par
3551 {\cf21                                                                     reduction ) ) )                     }\par
3552 {\cf21 #define D3D12_ENCODE_MIN_MAG_ANISOTROPIC_MIP_POINT_FILTER( reduction )                                \\}\par
3553 {\cf21                                          ( ( D3D12_FILTER ) (                                         \\}\par
3554 {\cf21                                          D3D12_ANISOTROPIC_FILTERING_BIT |                            \\}\par
3555 {\cf21                                          D3D12_ENCODE_BASIC_FILTER( D3D12_FILTER_TYPE_LINEAR,         \\}\par
3556 {\cf21                                                                     D3D12_FILTER_TYPE_LINEAR,         \\}\par
3557 {\cf21                                                                     D3D12_FILTER_TYPE_POINT,          \\}\par
3558 {\cf21                                                                     reduction ) ) )                     }\par
3559 {\cf21 #define D3D12_DECODE_MIN_FILTER( D3D12Filter )                                                              \\}\par
3560 {\cf21                                  ( ( D3D12_FILTER_TYPE )                                                    \\}\par
3561 {\cf21                                  ( ( ( D3D12Filter ) >> D3D12_MIN_FILTER_SHIFT ) & D3D12_FILTER_TYPE_MASK ) ) }\par
3562 {\cf21 #define D3D12_DECODE_MAG_FILTER( D3D12Filter )                                                              \\}\par
3563 {\cf21                                  ( ( D3D12_FILTER_TYPE )                                                    \\}\par
3564 {\cf21                                  ( ( ( D3D12Filter ) >> D3D12_MAG_FILTER_SHIFT ) & D3D12_FILTER_TYPE_MASK ) ) }\par
3565 {\cf21 #define D3D12_DECODE_MIP_FILTER( D3D12Filter )                                                              \\}\par
3566 {\cf21                                  ( ( D3D12_FILTER_TYPE )                                                    \\}\par
3567 {\cf21                                  ( ( ( D3D12Filter ) >> D3D12_MIP_FILTER_SHIFT ) & D3D12_FILTER_TYPE_MASK ) ) }\par
3568 {\cf21 #define D3D12_DECODE_FILTER_REDUCTION( D3D12Filter )                                                        \\}\par
3569 {\cf21                                  ( ( D3D12_FILTER_REDUCTION_TYPE )                                                      \\}\par
3570 {\cf21                                  ( ( ( D3D12Filter ) >> D3D12_FILTER_REDUCTION_TYPE_SHIFT ) & D3D12_FILTER_REDUCTION_TYPE_MASK ) ) }\par
3571 {\cf21 #define D3D12_DECODE_IS_COMPARISON_FILTER( D3D12Filter )                                                    \\}\par
3572 {\cf21                                  ( D3D12_DECODE_FILTER_REDUCTION( D3D12Filter ) == D3D12_FILTER_REDUCTION_TYPE_COMPARISON ) }\par
3573 {\cf21 #define D3D12_DECODE_IS_ANISOTROPIC_FILTER( D3D12Filter )                                               \\}\par
3574 {\cf21                             ( ( ( D3D12Filter ) & D3D12_ANISOTROPIC_FILTERING_BIT ) &&                  \\}\par
3575 {\cf21                             ( D3D12_FILTER_TYPE_LINEAR == D3D12_DECODE_MIN_FILTER( D3D12Filter ) ) &&   \\}\par
3576 {\cf21                             ( D3D12_FILTER_TYPE_LINEAR == D3D12_DECODE_MAG_FILTER( D3D12Filter ) ) )      }\par
