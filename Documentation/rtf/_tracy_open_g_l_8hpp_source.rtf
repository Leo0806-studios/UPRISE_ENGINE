127     {\cf18 void} Name( {\cf17 const} {\cf18 char}* name, uint16_t len )\par
128     \{\par
129         {\cf17 auto} ptr = ({\cf18 char}*)tracy_malloc( len );\par
130         memcpy( ptr, name, len );\par
131 \par
132         TracyLfqPrepare( QueueType::GpuContextName );\par
133         MemWrite( &item->gpuContextNameFat.context, m_context );\par
134         MemWrite( &item->gpuContextNameFat.ptr, (uint64_t)ptr );\par
135         MemWrite( &item->gpuContextNameFat.size, len );\par
136 {\cf21 #ifdef TRACY_ON_DEMAND}\par
137         GetProfiler().DeferItem( *item );\par
138 {\cf21 #endif}\par
139         TracyLfqCommit;\par
140     \}\par
141 \par
142     {\cf18 void} Collect()\par
143     \{\par
144         ZoneScopedC( Color::Red4 );\par
145 \par
146         {\cf19 if}( m_tail == m_head ) {\cf19 return};\par
147 \par
148 {\cf21 #ifdef TRACY_ON_DEMAND}\par
149         {\cf19 if}( !GetProfiler().IsConnected() )\par
150         \{\par
151             m_head = m_tail = 0;\par
152             {\cf19 return};\par
153         \}\par
154 {\cf21 #endif}\par
155 \par
156         {\cf19 while}( m_tail != m_head )\par
157         \{\par
158             GLint available;\par
159             glGetQueryObjectiv( m_query[m_tail], GL_QUERY_RESULT_AVAILABLE, &available );\par
160             {\cf19 if}( !available ) {\cf19 return};\par
161 \par
162             uint64_t time;\par
163             glGetQueryObjectui64v( m_query[m_tail], GL_QUERY_RESULT, &time );\par
164 \par
165             TracyLfqPrepare( QueueType::GpuTime );\par
166             MemWrite( &item->gpuTime.gpuTime, (int64_t)time );\par
167             MemWrite( &item->gpuTime.queryId, (uint16_t)m_tail );\par
168             MemWrite( &item->gpuTime.context, m_context );\par
169             TracyLfqCommit;\par
170 \par
171             m_tail = ( m_tail + 1 ) % QueryCount;\par
172         \}\par
173     \}\par
174 \par
175 {\cf17 private}:\par
176     tracy_force_inline {\cf18 unsigned} {\cf18 int} NextQueryId()\par
177     \{\par
178         {\cf17 const} {\cf17 auto} {\cf18 id} = m_head;\par
179         m_head = ( m_head + 1 ) % QueryCount;\par
180         assert( m_head != m_tail );\par
181         {\cf19 return} id;\par
182     \}\par
183 \par
184     tracy_force_inline {\cf18 unsigned} {\cf18 int} TranslateOpenGlQueryId( {\cf18 unsigned} {\cf18 int} {\cf18 id} )\par
185     \{\par
186         {\cf19 return} m_query[id];\par
187     \}\par
188 \par
189     tracy_force_inline uint8_t GetId(){\cf17  const}\par
190 {\cf17     }\{\par
191         {\cf19 return} m_context;\par
192     \}\par
