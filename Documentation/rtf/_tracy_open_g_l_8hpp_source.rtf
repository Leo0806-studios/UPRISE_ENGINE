194     {\cf18 unsigned} {\cf18 int} m_query[QueryCount];\par
195     uint8_t m_context;\par
196 \par
197     {\cf18 unsigned} {\cf18 int} m_head;\par
198     {\cf18 unsigned} {\cf18 int} m_tail;\par
