92 {\cf17 public}:\par
93     GpuCtx()\par
94         : m_context( GetGpuCtxCounter().fetch_add( 1, std::memory_order_relaxed ) )\par
95         , m_head( 0 )\par
96         , m_tail( 0 )\par
97     \{\par
98         assert( m_context != 255 );\par
99 \par
100         glGenQueries( QueryCount, m_query );\par
101 \par
102         int64_t tgpu;\par
103         glGetInteger64v( GL_TIMESTAMP, &tgpu );\par
104         int64_t tcpu = Profiler::GetTime();\par
105 \par
106         GLint bits;\par
107         glGetQueryiv( GL_TIMESTAMP, GL_QUERY_COUNTER_BITS, &bits );\par
108 \par
109         {\cf17 const} {\cf18 float} period = 1.f;\par
110         {\cf17 const} {\cf17 auto} thread = GetThreadHandle();\par
111         TracyLfqPrepare( QueueType::GpuNewContext );\par
112         MemWrite( &item->gpuNewContext.cpuTime, tcpu );\par
113         MemWrite( &item->gpuNewContext.gpuTime, tgpu );\par
114         MemWrite( &item->gpuNewContext.thread, thread );\par
115         MemWrite( &item->gpuNewContext.period, period );\par
116         MemWrite( &item->gpuNewContext.context, m_context );\par
117         MemWrite( &item->gpuNewContext.flags, uint8_t( 0 ) );\par
118         MemWrite( &item->gpuNewContext.type, GpuContextType::OpenGl );\par
119 \par
120 {\cf21 #ifdef TRACY_ON_DEMAND}\par
121         GetProfiler().DeferItem( *item );\par
122 {\cf21 #endif}\par
123 \par
124         TracyLfqCommit;\par
125     \}\par
