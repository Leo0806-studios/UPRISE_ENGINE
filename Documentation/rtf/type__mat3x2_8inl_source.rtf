452     \{\par
453         {\cf17 const} T SrcA00 = m1[0][0];\par
454         {\cf17 const} T SrcA01 = m1[0][1];\par
455         {\cf17 const} T SrcA10 = m1[1][0];\par
456         {\cf17 const} T SrcA11 = m1[1][1];\par
457         {\cf17 const} T SrcA20 = m1[2][0];\par
458         {\cf17 const} T SrcA21 = m1[2][1];\par
459 \par
460         {\cf17 const} T SrcB00 = m2[0][0];\par
461         {\cf17 const} T SrcB01 = m2[0][1];\par
462         {\cf17 const} T SrcB02 = m2[0][2];\par
463         {\cf17 const} T SrcB10 = m2[1][0];\par
464         {\cf17 const} T SrcB11 = m2[1][1];\par
465         {\cf17 const} T SrcB12 = m2[1][2];\par
466 \par
467         mat<2, 2, T, Q> Result;\par
468         Result[0][0] = SrcA00 * SrcB00 + SrcA10 * SrcB01 + SrcA20 * SrcB02;\par
469         Result[0][1] = SrcA01 * SrcB00 + SrcA11 * SrcB01 + SrcA21 * SrcB02;\par
470         Result[1][0] = SrcA00 * SrcB10 + SrcA10 * SrcB11 + SrcA20 * SrcB12;\par
471         Result[1][1] = SrcA01 * SrcB10 + SrcA11 * SrcB11 + SrcA21 * SrcB12;\par
472         {\cf19 return} Result;\par
473     \}\par
