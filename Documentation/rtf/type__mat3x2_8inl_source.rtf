487     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
488     GLM_FUNC_QUALIFIER GLM_CONSTEXPR mat<4, 2, T, Q> operator*(mat<3, 2, T, Q> {\cf17 const}& m1, mat<4, 3, T, Q> {\cf17 const}& m2)\par
489     \{\par
490         {\cf19 return} mat<4, 2, T, Q>(\par
491             m1[0][0] * m2[0][0] + m1[1][0] * m2[0][1] + m1[2][0] * m2[0][2],\par
492             m1[0][1] * m2[0][0] + m1[1][1] * m2[0][1] + m1[2][1] * m2[0][2],\par
493             m1[0][0] * m2[1][0] + m1[1][0] * m2[1][1] + m1[2][0] * m2[1][2],\par
494             m1[0][1] * m2[1][0] + m1[1][1] * m2[1][1] + m1[2][1] * m2[1][2],\par
495             m1[0][0] * m2[2][0] + m1[1][0] * m2[2][1] + m1[2][0] * m2[2][2],\par
496             m1[0][1] * m2[2][0] + m1[1][1] * m2[2][1] + m1[2][1] * m2[2][2],\par
497             m1[0][0] * m2[3][0] + m1[1][0] * m2[3][1] + m1[2][0] * m2[3][2],\par
498             m1[0][1] * m2[3][0] + m1[1][1] * m2[3][1] + m1[2][1] * m2[3][2]);\par
499     \}\par
500 \par
501     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
502     GLM_FUNC_QUALIFIER GLM_CONSTEXPR mat<3, 2, T, Q> operator/(mat<3, 2, T, Q> {\cf17 const}& m, T scalar)\par
503     \{\par
504         {\cf19 return} mat<3, 2, T, Q>(\par
505             m[0] / scalar,\par
506             m[1] / scalar,\par
507             m[2] / scalar);\par
508     \}\par
509 \par
510     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
511     GLM_FUNC_QUALIFIER GLM_CONSTEXPR mat<3, 2, T, Q> operator/(T scalar, mat<3, 2, T, Q> {\cf17 const}& m)\par
512     \{\par
513         {\cf19 return} mat<3, 2, T, Q>(\par
514             scalar / m[0],\par
515             scalar / m[1],\par
516             scalar / m[2]);\par
517     \}\par
518 \par
519     {\cf20 // -- Boolean operators --}\par
520 \par
521     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
522     GLM_FUNC_QUALIFIER GLM_CONSTEXPR {\cf18 bool} operator==(mat<3, 2, T, Q> {\cf17 const}& m1, mat<3, 2, T, Q> {\cf17 const}& m2)\par
523     \{\par
524         {\cf19 return} (m1[0] == m2[0]) && (m1[1] == m2[1]) && (m1[2] == m2[2]);\par
525     \}\par
526 \par
527     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
528     GLM_FUNC_QUALIFIER GLM_CONSTEXPR {\cf18 bool} operator!=(mat<3, 2, T, Q> {\cf17 const}& m1, mat<3, 2, T, Q> {\cf17 const}& m2)\par
529     \{\par
530         {\cf19 return} (m1[0] != m2[0]) || (m1[1] != m2[1]) || (m1[2] != m2[2]);\par
531     \}\par
532 \} {\cf20 //namespace glm}\par
