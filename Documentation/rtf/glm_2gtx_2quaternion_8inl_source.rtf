62     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
63     GLM_FUNC_QUALIFIER T extractRealComponent(qua<T, Q> {\cf17 const}& q)\par
64     \{\par
65         T w = {\cf17 static_cast<}T{\cf17 >}(1) - q.x * q.x - q.y * q.y - q.z * q.z;\par
66         {\cf19 if}(w < T(0))\par
67             {\cf19 return} T(0);\par
68         {\cf19 else}\par
69             {\cf19 return} -sqrt(w);\par
70     \}\par
71 \par
72     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
73     GLM_FUNC_QUALIFIER GLM_CONSTEXPR T length2(qua<T, Q> {\cf17 const}& q)\par
74     \{\par
75         {\cf19 return} q.x * q.x + q.y * q.y + q.z * q.z + q.w * q.w;\par
76     \}\par
77 \par
78     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
79     GLM_FUNC_QUALIFIER qua<T, Q> shortMix(qua<T, Q> {\cf17 const}& x, qua<T, Q> {\cf17 const}& y, T {\cf17 const}& a)\par
80     \{\par
81         {\cf19 if}(a <= {\cf17 static_cast<}T{\cf17 >}(0)) {\cf19 return} x;\par
82         {\cf19 if}(a >= {\cf17 static_cast<}T{\cf17 >}(1)) {\cf19 return} y;\par
83 \par
84         T fCos = dot(x, y);\par
85         qua<T, Q> y2(y); {\cf20 //BUG!!! qua<T> y2;}\par
86         {\cf19 if}(fCos < {\cf17 static_cast<}T{\cf17 >}(0))\par
87         \{\par
88             y2 = -y;\par
89             fCos = -fCos;\par
90         \}\par
91 \par
92         {\cf20 //if(fCos > 1.0f) // problem}\par
93         T k0, k1;\par
94         {\cf19 if}(fCos > ({\cf17 static_cast<}T{\cf17 >}(1) - epsilon<T>()))\par
95         \{\par
96             k0 = {\cf17 static_cast<}T{\cf17 >}(1) - a;\par
97             k1 = {\cf17 static_cast<}T{\cf17 >}(0) + a; {\cf20 //BUG!!! 1.0f + a;}\par
98         \}\par
99         {\cf19 else}\par
100         \{\par
101             T fSin = sqrt(T(1) - fCos * fCos);\par
102             T fAngle = atan(fSin, fCos);\par
103             T fOneOverSin = {\cf17 static_cast<}T{\cf17 >}(1) / fSin;\par
104             k0 = sin(({\cf17 static_cast<}T{\cf17 >}(1) - a) * fAngle) * fOneOverSin;\par
105             k1 = sin(({\cf17 static_cast<}T{\cf17 >}(0) + a) * fAngle) * fOneOverSin;\par
106         \}\par
107 \par
108         {\cf19 return} qua<T, Q>::wxyz(\par
109             k0 * x.w + k1 * y2.w,\par
110             k0 * x.x + k1 * y2.x,\par
111             k0 * x.y + k1 * y2.y,\par
112             k0 * x.z + k1 * y2.z);\par
113     \}\par
114 \par
115     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
116     GLM_FUNC_QUALIFIER qua<T, Q> fastMix(qua<T, Q> {\cf17 const}& x, qua<T, Q> {\cf17 const}& y, T {\cf17 const}& a)\par
117     \{\par
118         {\cf19 return} glm::normalize(x * ({\cf17 static_cast<}T{\cf17 >}(1) - a) + (y * a));\par
119     \}\par
120 \par
121     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
122     GLM_FUNC_QUALIFIER qua<T, Q> rotation(vec<3, T, Q> {\cf17 const}& orig, vec<3, T, Q> {\cf17 const}& dest)\par
123     \{\par
124         T cosTheta = dot(orig, dest);\par
125         vec<3, T, Q> rotationAxis;\par
126 \par
127         {\cf19 if}(cosTheta >= {\cf17 static_cast<}T{\cf17 >}(1) - epsilon<T>()) \{\par
128             {\cf20 // orig and dest point in the same direction}\par
129             {\cf19 return} quat_identity<T,Q>();\par
130         \}\par
131 \par
132         {\cf19 if}(cosTheta < {\cf17 static_cast<}T{\cf17 >}(-1) + epsilon<T>())\par
133         \{\par
134             {\cf20 // special case when vectors in opposite directions :}\par
135             {\cf20 // there is no "ideal" rotation axis}\par
136             {\cf20 // So guess one; any will do as long as it's perpendicular to start}\par
137             {\cf20 // This implementation favors a rotation around the Up axis (Y),}\par
138             {\cf20 // since it's often what you want to do.}\par
139             rotationAxis = cross(vec<3, T, Q>(0, 0, 1), orig);\par
140             {\cf19 if}(length2(rotationAxis) < epsilon<T>()) {\cf20 // bad luck, they were parallel, try again!}\par
141                 rotationAxis = cross(vec<3, T, Q>(1, 0, 0), orig);\par
142 \par
143             rotationAxis = normalize(rotationAxis);\par
144             {\cf19 return} angleAxis(pi<T>(), rotationAxis);\par
145         \}\par
146 \par
147         {\cf20 // Implementation from Stan Melax's Game Programming Gems 1 article}\par
148         rotationAxis = cross(orig, dest);\par
149 \par
150         T s = sqrt((T(1) + cosTheta) * {\cf17 static_cast<}T{\cf17 >}(2));\par
151         T invs = {\cf17 static_cast<}T{\cf17 >}(1) / s;\par
152 \par
153         {\cf19 return} qua<T, Q>::wxyz(\par
154             s * {\cf17 static_cast<}T{\cf17 >}(0.5f),\par
155             rotationAxis.x * invs,\par
156             rotationAxis.y * invs,\par
157             rotationAxis.z * invs);\par
158     \}\par
159 \}{\cf20 //namespace glm}\par
}
