205 GLM_FUNC_QUALIFIER glm_vec4 glm_vec4_smoothstep(glm_vec4 edge0, glm_vec4 edge1, glm_vec4 x)\par
206 \{\par
207     glm_vec4 {\cf17 const} sub0 = glm_vec4_sub(x, edge0);\par
208     glm_vec4 {\cf17 const} sub1 = glm_vec4_sub(edge1, edge0);\par
209     glm_vec4 {\cf17 const} div0 = glm_vec4_div(sub0, sub1);\par
210     glm_vec4 {\cf17 const} clp0 = glm_vec4_clamp(div0, _mm_setzero_ps(), _mm_set1_ps(1.0f));\par
211     glm_vec4 {\cf17 const} mul0 = glm_vec4_mul(_mm_set1_ps(2.0f), clp0);\par
212     glm_vec4 {\cf17 const} sub2 = glm_vec4_sub(_mm_set1_ps(3.0f), mul0);\par
213     glm_vec4 {\cf17 const} mul1 = glm_vec4_mul(clp0, clp0);\par
214     glm_vec4 {\cf17 const} mul2 = glm_vec4_mul(mul1, sub2);\par
215     {\cf19 return} mul2;\par
216 \}\par
