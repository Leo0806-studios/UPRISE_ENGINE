218 {\cf20 // Agner Fog method}\par
219 GLM_FUNC_QUALIFIER glm_vec4 glm_vec4_nan(glm_vec4 x)\par
220 \{\par
221     glm_ivec4 {\cf17 const} t1 = _mm_castps_si128(x);                       {\cf20 // reinterpret as 32-bit integer}\par
222     glm_ivec4 {\cf17 const} t2 = _mm_sll_epi32(t1, _mm_cvtsi32_si128(1));   {\cf20 // shift out sign bit}\par
223     glm_ivec4 {\cf17 const} t3 = _mm_set1_epi32({\cf18 int}(0xFF000000));               {\cf20 // exponent mask}\par
224     glm_ivec4 {\cf17 const} t4 = _mm_and_si128(t2, t3);                     {\cf20 // exponent}\par
225     glm_ivec4 {\cf17 const} t5 = _mm_andnot_si128(t3, t2);                  {\cf20 // fraction}\par
226     glm_ivec4 {\cf17 const} Equal = _mm_cmpeq_epi32(t3, t4);\par
227     glm_ivec4 {\cf17 const} Nequal = _mm_cmpeq_epi32(t5, _mm_setzero_si128());\par
228     glm_ivec4 {\cf17 const} And = _mm_and_si128(Equal, Nequal);\par
229     {\cf19 return} _mm_castsi128_ps(And);                                   {\cf20 // exponent = all 1s and fraction != 0}\par
230 \}\par
231 \par
232 {\cf20 // Agner Fog method}\par
233 GLM_FUNC_QUALIFIER glm_vec4 glm_vec4_inf(glm_vec4 x)\par
234 \{\par
235     glm_ivec4 {\cf17 const} t1 = _mm_castps_si128(x);                                       {\cf20 // reinterpret as 32-bit integer}\par
236     glm_ivec4 {\cf17 const} t2 = _mm_sll_epi32(t1, _mm_cvtsi32_si128(1));                   {\cf20 // shift out sign bit}\par
237     {\cf19 return} _mm_castsi128_ps(_mm_cmpeq_epi32(t2, _mm_set1_epi32({\cf18 int}(0xFF000000))));      {\cf20 // exponent is all 1s, fraction is 0}\par
238 \}\par
