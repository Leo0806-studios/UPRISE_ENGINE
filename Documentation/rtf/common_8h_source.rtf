99 GLM_FUNC_QUALIFIER glm_vec4 glm_vec4_sign(glm_vec4 x)\par
100 \{\par
101     glm_vec4 {\cf17 const} zro0 = _mm_setzero_ps();\par
102     glm_vec4 {\cf17 const} cmp0 = _mm_cmplt_ps(x, zro0);\par
103     glm_vec4 {\cf17 const} cmp1 = _mm_cmpgt_ps(x, zro0);\par
104     glm_vec4 {\cf17 const} and0 = _mm_and_ps(cmp0, _mm_set1_ps(-1.0f));\par
105     glm_vec4 {\cf17 const} and1 = _mm_and_ps(cmp1, _mm_set1_ps(1.0f));\par
106     glm_vec4 {\cf17 const} or0 = _mm_or_ps(and0, and1);\par
107     {\cf19 return} or0;\par
108 \}\par
