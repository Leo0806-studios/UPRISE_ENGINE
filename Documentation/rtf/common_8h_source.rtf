87 GLM_FUNC_QUALIFIER glm_ivec4 glm_ivec4_abs(glm_ivec4 x)\par
88 \{\par
89 {\cf21 #   if GLM_ARCH & GLM_ARCH_SSSE3_BIT}\par
90         {\cf19 return} _mm_sign_epi32(x, x);\par
91 {\cf21 #   else}\par
92         glm_ivec4 {\cf17 const} sgn0 = _mm_srai_epi32(x, 31);\par
93         glm_ivec4 {\cf17 const} inv0 = _mm_xor_si128(x, sgn0);\par
94         glm_ivec4 {\cf17 const} sub0 = _mm_sub_epi32(inv0, sgn0);\par
95         {\cf19 return} sub0;\par
96 {\cf21 #   endif}\par
97 \}\par
