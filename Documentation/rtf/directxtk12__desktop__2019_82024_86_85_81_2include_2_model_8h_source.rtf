530             {\cf20 // Utility function for getting a GPU descriptor for a mesh part/material index. If there is no texture the}\par
531             {\cf20 // descriptor will be zero.}\par
532             D3D12_GPU_DESCRIPTOR_HANDLE __cdecl GetGpuTextureHandleForMaterialIndex(uint32_t materialIndex, _In_ ID3D12DescriptorHeap* heap, _In_ {\cf18 size_t} descriptorSize, _In_ {\cf18 size_t} descriptorOffset){\cf17  const}\par
533 {\cf17             }\{\par
534                 D3D12_GPU_DESCRIPTOR_HANDLE handle = \{\};\par
535 \par
536                 {\cf19 if} (materialIndex >= materials.size())\par
537                     {\cf19 return} handle;\par
538 \par
539                 {\cf17 const} {\cf18 int} textureIndex = materials[materialIndex].diffuseTextureIndex;\par
540                 {\cf19 if} (textureIndex == -1)\par
541                     {\cf19 return} handle;\par
542 \par
543 {\cf21             #if defined(_MSC_VER) || !defined(_WIN32)}\par
544                 handle = heap->GetGPUDescriptorHandleForHeapStart();\par
545 {\cf21             #else}\par
546                 std::ignore = heap->GetGPUDescriptorHandleForHeapStart(&handle);\par
547 {\cf21             #endif}\par
548                 handle.ptr += {\cf17 static_cast<}UINT64{\cf17 >}(descriptorSize * (UINT64(textureIndex) + UINT64(descriptorOffset)));\par
549 \par
550                 {\cf19 return} handle;\par
551             \}\par
