162             {\cf20 // Draw the mesh with a range of effects that mesh parts will index into.}\par
163             {\cf20 // Effects can be any IEffect pointer type (including smart pointer). Value or reference types will not compile.}\par
164             {\cf20 // The iterator passed to this method should have random access capabilities for best performance.}\par
165             {\cf17 template}<{\cf17 typename} TEffectIterator, {\cf17 typename} TEffectIteratorCategory = {\cf17 typename} TEffectIterator::iterator_category>\par
166             {\cf17 static} {\cf18 void} DrawMeshParts(\par
167                 _In_ ID3D12GraphicsCommandList* commandList,\par
168                 {\cf17 const} Collection& meshParts,\par
169                 TEffectIterator partEffects)\par
170             \{\par
171                 {\cf20 // This assert is here to prevent accidental use of containers that would cause undesirable performance penalties.}\par
172                 {\cf17 static_assert}(\par
173                     std::is_base_of<std::random_access_iterator_tag, TEffectIteratorCategory>::value,\par
174                     {\cf22 "Providing an iterator without random access capabilities -- such as from std::list -- is not supported."});\par
175 \par
176                 {\cf19 for} ({\cf17 const} {\cf17 auto}& it : meshParts)\par
177                 \{\par
178                     {\cf17 auto} part = it.get();\par
179                     assert(part != {\cf17 nullptr});\par
180 \par
181                     {\cf20 // Get the effect at the location specified by the part's material}\par
182                     TEffectIterator effect_iterator = partEffects;\par
183                     std::advance(effect_iterator, part->partIndex);\par
184 \par
185                     {\cf20 // Apply the effect and draw}\par
186                     (*effect_iterator)->Apply(commandList);\par
187                     part->Draw(commandList);\par
188                 \}\par
189             \}\par
190 \par
191             {\cf17 template}<{\cf17 typename} TEffectIterator, {\cf17 typename} TEffectIteratorCategory = {\cf17 typename} TEffectIterator::iterator_category>\par
192             {\cf17 static} {\cf18 void} XM_CALLCONV DrawMeshParts(\par
193                 _In_ ID3D12GraphicsCommandList* commandList,\par
194                 {\cf17 const} Collection& meshParts,\par
195                 FXMMATRIX world,\par
196                 TEffectIterator partEffects)\par
197             \{\par
198                 {\cf20 // This assert is here to prevent accidental use of containers that would cause undesirable performance penalties.}\par
199                 {\cf17 static_assert}(\par
200                     std::is_base_of<std::random_access_iterator_tag, TEffectIteratorCategory>::value,\par
201                     {\cf22 "Providing an iterator without random access capabilities -- such as from std::list -- is not supported."});\par
202 \par
203                 {\cf19 for} ({\cf17 const} {\cf17 auto}& it : meshParts)\par
204                 \{\par
205                     {\cf17 auto} part = it.get();\par
206                     assert(part != {\cf17 nullptr});\par
207 \par
208                     {\cf20 // Get the effect at the location specified by the part's material}\par
209                     TEffectIterator effect_iterator = partEffects;\par
210                     std::advance(effect_iterator, part->partIndex);\par
211 \par
212                     {\cf17 auto} imatrices = {\cf17 dynamic_cast<}IEffectMatrices*{\cf17 >}((*effect_iterator).get());\par
213                     {\cf19 if} (imatrices)\par
214                     \{\par
215                         imatrices->SetWorld(world);\par
216                     \}\par
217 \par
218                     {\cf20 // Apply the effect and draw}\par
219                     (*effect_iterator)->Apply(commandList);\par
220                     part->Draw(commandList);\par
221                 \}\par
222             \}\par
