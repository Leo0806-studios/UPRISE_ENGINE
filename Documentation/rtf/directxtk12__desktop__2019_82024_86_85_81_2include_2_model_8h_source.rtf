620         {\cf17 template}<{\cf17 typename} TEffectIterator, {\cf17 typename} TEffectIteratorCategory>\par
621         {\cf18 void} XM_CALLCONV ModelMeshPart::DrawSkinnedMeshParts(\par
622             _In_ ID3D12GraphicsCommandList* commandList,\par
623             {\cf17 const} ModelMesh& mesh,\par
624             {\cf17 const} ModelMeshPart::Collection& meshParts,\par
625             {\cf18 size_t} nbones,\par
626             _In_reads_(nbones) {\cf17 const} XMMATRIX* boneTransforms,\par
627             FXMMATRIX world,\par
628             TEffectIterator partEffects)\par
629         \{\par
630             {\cf20 // This assert is here to prevent accidental use of containers that would cause undesirable performance penalties.}\par
631             {\cf17 static_assert}(\par
632                 std::is_base_of<std::random_access_iterator_tag, TEffectIteratorCategory>::value,\par
633                 {\cf22 "Providing an iterator without random access capabilities -- such as from std::list -- is not supported."});\par
634 \par
635             assert(nbones > 0 && boneTransforms != {\cf17 nullptr});\par
636 \par
637             ModelBone::TransformArray temp;\par
638 \par
639             {\cf19 for} ({\cf17 const} {\cf17 auto}& mit : meshParts)\par
640             \{\par
641                 {\cf17 auto} part = mit.get();\par
642                 assert(part != {\cf17 nullptr});\par
643 \par
644                 {\cf20 // Get the effect at the location specified by the part's material}\par
645                 TEffectIterator effect_iterator = partEffects;\par
646                 std::advance(effect_iterator, part->partIndex);\par
647 \par
648                 {\cf17 auto} imatrices = {\cf17 dynamic_cast<}IEffectMatrices*{\cf17 >}((*effect_iterator).get());\par
649                 {\cf19 if} (imatrices)\par
650                 \{\par
651                     imatrices->SetWorld(world);\par
652                 \}\par
653 \par
654                 {\cf17 auto} iskinning = {\cf17 dynamic_cast<}IEffectSkinning*{\cf17 >}((*effect_iterator).get());\par
655                 {\cf19 if} (iskinning)\par
656                 \{\par
657                     {\cf19 if} (mesh.boneInfluences.empty())\par
658                     \{\par
659                         {\cf20 // Direct-mapping of vertex bone indices to our master bone array}\par
660                         iskinning->SetBoneTransforms(boneTransforms, nbones);\par
661                     \}\par
662                     {\cf19 else}\par
663                     \{\par
664                         {\cf19 if} (!temp)\par
665                         \{\par
666                             {\cf20 // Create the influence mapped bones on-demand.}\par
667                             temp = ModelBone::MakeArray(IEffectSkinning::MaxBones);\par
668 \par
669                             {\cf18 size_t} count = 0;\par
670                             {\cf19 for} ({\cf17 auto} it : mesh.boneInfluences)\par
671                             \{\par
672                                 ++count;\par
673                                 {\cf19 if} (count > IEffectSkinning::MaxBones)\par
674                                 \{\par
675                                     {\cf19 throw} std::runtime_error({\cf22 "Too many bones for skinning"});\par
676                                 \}\par
677 \par
678                                 {\cf19 if} (it >= nbones)\par
679                                 \{\par
680                                     {\cf19 throw} std::runtime_error({\cf22 "Invalid bone influence index"});\par
681                                 \}\par
682 \par
683                                 temp[count - 1] = boneTransforms[it];\par
684                             \}\par
685 \par
686                             assert(count == mesh.boneInfluences.size());\par
687                         \}\par
688 \par
689                         iskinning->SetBoneTransforms(temp.get(), mesh.boneInfluences.size());\par
690                     \}\par
691                 \}\par
692                 {\cf19 else} {\cf19 if} (imatrices)\par
693                 \{\par
694                     {\cf20 // Fallback for if we encounter a non-skinning effect in the model}\par
695                     XMMATRIX bm = (mesh.boneIndex != ModelBone::c_Invalid && mesh.boneIndex < nbones)\par
696                         ? boneTransforms[mesh.boneIndex] : XMMatrixIdentity();\par
697 \par
698                     imatrices->SetWorld(XMMatrixMultiply(bm, world));\par
699                 \}\par
700 \par
701                 {\cf20 // Apply the effect and draw}\par
702                 (*effect_iterator)->Apply(commandList);\par
703                 part->Draw(commandList);\par
704             \}\par
705         \}\par
