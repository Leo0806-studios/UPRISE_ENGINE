972 {\cf20 // PBR material support}\par
973 {\cf20 // --------------------}\par
974 {\cf20 // Properties defining PBR rendering techniques}\par
975 {\cf21 #define AI_MATKEY_USE_COLOR_MAP "$mat.useColorMap", 0, 0}\par
976 \par
977 {\cf20 // Metallic/Roughness Workflow}\par
978 {\cf20 // ---------------------------}\par
979 {\cf20 // Base RGBA color factor. Will be multiplied by final base color texture values if extant}\par
980 {\cf20 // Note: Importers may choose to copy this into AI_MATKEY_COLOR_DIFFUSE for compatibility}\par
981 {\cf20 // with renderers and formats that do not support Metallic/Roughness PBR}\par
982 {\cf21 #define AI_MATKEY_BASE_COLOR "$clr.base", 0, 0}\par
983 {\cf21 #define AI_MATKEY_BASE_COLOR_TEXTURE aiTextureType_BASE_COLOR, 0}\par
984 {\cf21 #define AI_MATKEY_USE_METALLIC_MAP "$mat.useMetallicMap", 0, 0}\par
985 {\cf20 // Metallic factor. 0.0 = Full Dielectric, 1.0 = Full Metal}\par
986 {\cf21 #define AI_MATKEY_METALLIC_FACTOR "$mat.metallicFactor", 0, 0}\par
987 {\cf21 #define AI_MATKEY_METALLIC_TEXTURE aiTextureType_METALNESS, 0}\par
988 {\cf21 #define AI_MATKEY_USE_ROUGHNESS_MAP "$mat.useRoughnessMap", 0, 0}\par
989 {\cf20 // Roughness factor. 0.0 = Perfectly Smooth, 1.0 = Completely Rough}\par
990 {\cf21 #define AI_MATKEY_ROUGHNESS_FACTOR "$mat.roughnessFactor", 0, 0}\par
991 {\cf21 #define AI_MATKEY_ROUGHNESS_TEXTURE aiTextureType_DIFFUSE_ROUGHNESS, 0}\par
992 {\cf20 // Anisotropy factor. 0.0 = isotropic, 1.0 = anisotropy along tangent direction,}\par
993 {\cf20 // -1.0 = anisotropy along bitangent direction}\par
994 {\cf21 #define AI_MATKEY_ANISOTROPY_FACTOR "$mat.anisotropyFactor", 0, 0}\par
995 \par
996 {\cf20 // Specular/Glossiness Workflow}\par
997 {\cf20 // ---------------------------}\par
998 {\cf20 // Diffuse/Albedo Color. Note: Pure Metals have a diffuse of \{0,0,0\}}\par
999 {\cf20 // AI_MATKEY_COLOR_DIFFUSE}\par
1000 {\cf20 // Specular Color.}\par
1001 {\cf20 // Note: Metallic/Roughness may also have a Specular Color}\par
1002 {\cf20 // AI_MATKEY_COLOR_SPECULAR}\par
1003 {\cf21 #define AI_MATKEY_SPECULAR_FACTOR "$mat.specularFactor", 0, 0}\par
1004 {\cf20 // Glossiness factor. 0.0 = Completely Rough, 1.0 = Perfectly Smooth}\par
1005 {\cf21 #define AI_MATKEY_GLOSSINESS_FACTOR "$mat.glossinessFactor", 0, 0}\par
1006 \par
1007 {\cf20 // Sheen}\par
1008 {\cf20 // -----}\par
1009 {\cf20 // Sheen base RGB color. Default \{0,0,0\}}\par
1010 {\cf21 #define AI_MATKEY_SHEEN_COLOR_FACTOR "$clr.sheen.factor", 0, 0}\par
1011 {\cf20 // Sheen Roughness Factor.}\par
1012 {\cf21 #define AI_MATKEY_SHEEN_ROUGHNESS_FACTOR "$mat.sheen.roughnessFactor", 0, 0}\par
1013 {\cf21 #define AI_MATKEY_SHEEN_COLOR_TEXTURE aiTextureType_SHEEN, 0}\par
1014 {\cf21 #define AI_MATKEY_SHEEN_ROUGHNESS_TEXTURE aiTextureType_SHEEN, 1}\par
1015 \par
1016 {\cf20 // Clearcoat}\par
1017 {\cf20 // ---------}\par
1018 {\cf20 // Clearcoat layer intensity. 0.0 = none (disabled)}\par
1019 {\cf21 #define AI_MATKEY_CLEARCOAT_FACTOR "$mat.clearcoat.factor", 0, 0}\par
1020 {\cf21 #define AI_MATKEY_CLEARCOAT_ROUGHNESS_FACTOR "$mat.clearcoat.roughnessFactor", 0, 0}\par
1021 {\cf21 #define AI_MATKEY_CLEARCOAT_TEXTURE aiTextureType_CLEARCOAT, 0}\par
1022 {\cf21 #define AI_MATKEY_CLEARCOAT_ROUGHNESS_TEXTURE aiTextureType_CLEARCOAT, 1}\par
1023 {\cf21 #define AI_MATKEY_CLEARCOAT_NORMAL_TEXTURE aiTextureType_CLEARCOAT, 2}\par
1024 \par
1025 {\cf20 // Transmission}\par
1026 {\cf20 // ------------}\par
1027 {\cf20 // https://github.com/KhronosGroup/glTF/tree/master/extensions/2.0/Khronos/KHR_materials_transmission}\par
1028 {\cf20 // Base percentage of light transmitted through the surface. 0.0 = Opaque, 1.0 = Fully transparent}\par
1029 {\cf21 #define AI_MATKEY_TRANSMISSION_FACTOR "$mat.transmission.factor", 0, 0}\par
1030 {\cf20 // Texture defining percentage of light transmitted through the surface.}\par
1031 {\cf20 // Multiplied by AI_MATKEY_TRANSMISSION_FACTOR}\par
1032 {\cf21 #define AI_MATKEY_TRANSMISSION_TEXTURE aiTextureType_TRANSMISSION, 0}\par
1033 \par
1034 {\cf20 // Volume}\par
1035 {\cf20 // ------------}\par
1036 {\cf20 // https://github.com/KhronosGroup/glTF/tree/main/extensions/2.0/Khronos/KHR_materials_volume}\par
1037 {\cf20 // The thickness of the volume beneath the surface. If the value is 0 the material is thin-walled. Otherwise the material is a volume boundary.}\par
1038 {\cf21 #define AI_MATKEY_VOLUME_THICKNESS_FACTOR "$mat.volume.thicknessFactor", 0, 0}\par
1039 {\cf20 // Texture that defines the thickness.}\par
1040 {\cf20 // Multiplied by AI_MATKEY_THICKNESS_FACTOR}\par
1041 {\cf21 #define AI_MATKEY_VOLUME_THICKNESS_TEXTURE aiTextureType_TRANSMISSION, 1}\par
1042 {\cf20 // Density of the medium given as the average distance that light travels in the medium before interacting with a particle.}\par
1043 {\cf21 #define AI_MATKEY_VOLUME_ATTENUATION_DISTANCE "$mat.volume.attenuationDistance", 0, 0}\par
1044 {\cf20 // The color that white light turns into due to absorption when reaching the attenuation distance.}\par
1045 {\cf21 #define AI_MATKEY_VOLUME_ATTENUATION_COLOR "$mat.volume.attenuationColor", 0, 0}\par
1046 \par
1047 {\cf20 // Emissive}\par
1048 {\cf20 // --------}\par
1049 {\cf21 #define AI_MATKEY_USE_EMISSIVE_MAP "$mat.useEmissiveMap", 0, 0}\par
1050 {\cf21 #define AI_MATKEY_EMISSIVE_INTENSITY "$mat.emissiveIntensity", 0, 0}\par
1051 {\cf21 #define AI_MATKEY_USE_AO_MAP "$mat.useAOMap", 0, 0}\par
