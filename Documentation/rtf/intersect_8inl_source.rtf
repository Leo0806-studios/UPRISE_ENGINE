3 {\cf17 namespace }glm\par
4 \{\par
5     {\cf17 template}<{\cf17 typename} genType>\par
6     GLM_FUNC_QUALIFIER {\cf18 bool} intersectRayPlane\par
7     (\par
8         genType {\cf17 const}& orig, genType {\cf17 const}& dir,\par
9         genType {\cf17 const}& planeOrig, genType {\cf17 const}& planeNormal,\par
10         {\cf17 typename} genType::value_type & intersectionDistance\par
11     )\par
12     \{\par
13         {\cf17 typename} genType::value_type d = glm::dot(dir, planeNormal);\par
14         {\cf17 typename} genType::value_type Epsilon = std::numeric_limits<typename genType::value_type>::epsilon();\par
15 \par
16         {\cf19 if}(glm::abs(d) > Epsilon)  {\cf20 // if dir and planeNormal are not perpendicular}\par
17         \{\par
18             {\cf17 typename} genType::value_type {\cf17 const} tmp_intersectionDistance =   glm::dot(planeOrig - orig, planeNormal) / d;\par
19             {\cf19 if} (tmp_intersectionDistance > {\cf17 static_cast<}typename genType::value_type{\cf17 >}(0)) \{ {\cf20 // allow only intersections}\par
20                 intersectionDistance = tmp_intersectionDistance;\par
21                 {\cf19 return} {\cf17 true};\par
22             \}\par
23         \}\par
24 \par
25         {\cf19 return} {\cf17 false};\par
26     \}\par
27 \par
28     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
29     GLM_FUNC_QUALIFIER {\cf18 bool} intersectRayTriangle\par
30     (\par
31         vec<3, T, Q> {\cf17 const}& orig, vec<3, T, Q> {\cf17 const}& dir,\par
32         vec<3, T, Q> {\cf17 const}& vert0, vec<3, T, Q> {\cf17 const}& vert1, vec<3, T, Q> {\cf17 const}& vert2,\par
33         vec<2, T, Q>& baryPosition, T& distance\par
34     )\par
35     \{\par
36         {\cf20 // find vectors for two edges sharing vert0}\par
37         vec<3, T, Q> {\cf17 const} edge1 = vert1 - vert0;\par
38         vec<3, T, Q> {\cf17 const} edge2 = vert2 - vert0;\par
39 \par
40         {\cf20 // begin calculating determinant - also used to calculate U parameter}\par
41         vec<3, T, Q> {\cf17 const} p = glm::cross(dir, edge2);\par
42 \par
43         {\cf20 // if determinant is near zero, ray lies in plane of triangle}\par
44         T {\cf17 const} det = glm::dot(edge1, p);\par
45 \par
46         vec<3, T, Q> Perpendicular(0);\par
47 \par
48         {\cf19 if} (det > {\cf17 static_cast<}T{\cf17 >}(0))\par
49         \{\par
50             {\cf20 // calculate distance from vert0 to ray origin}\par
51             vec<3, T, Q> {\cf17 const} dist = orig - vert0;\par
52 \par
53             {\cf20 // calculate U parameter and test bounds}\par
54             baryPosition.x = glm::dot(dist, p);\par
55             {\cf19 if}(baryPosition.x < {\cf17 static_cast<}T{\cf17 >}(0) || baryPosition.x > det)\par
56                 {\cf19 return} {\cf17 false};\par
57 \par
58             {\cf20 // prepare to test V parameter}\par
59             Perpendicular = glm::cross(dist, edge1);\par
60 \par
61             {\cf20 // calculate V parameter and test bounds}\par
62             baryPosition.y = glm::dot(dir, Perpendicular);\par
63             {\cf19 if}((baryPosition.y < {\cf17 static_cast<}T{\cf17 >}(0)) || ((baryPosition.x + baryPosition.y) > det))\par
64                 {\cf19 return} {\cf17 false};\par
65         \}\par
66         {\cf19 else} {\cf19 if}(det < {\cf17 static_cast<}T{\cf17 >}(0))\par
67         \{\par
68             {\cf20 // calculate distance from vert0 to ray origin}\par
69             vec<3, T, Q> {\cf17 const} dist = orig - vert0;\par
70 \par
71             {\cf20 // calculate U parameter and test bounds}\par
72             baryPosition.x = glm::dot(dist, p);\par
73             {\cf19 if}((baryPosition.x > {\cf17 static_cast<}T{\cf17 >}(0)) || (baryPosition.x < det))\par
74                 {\cf19 return} {\cf17 false};\par
75 \par
76             {\cf20 // prepare to test V parameter}\par
77             Perpendicular = glm::cross(dist, edge1);\par
78 \par
79             {\cf20 // calculate V parameter and test bounds}\par
80             baryPosition.y = glm::dot(dir, Perpendicular);\par
81             {\cf19 if}((baryPosition.y > {\cf17 static_cast<}T{\cf17 >}(0)) || (baryPosition.x + baryPosition.y < det))\par
82                 {\cf19 return} {\cf17 false};\par
83         \}\par
84         {\cf19 else}\par
85             {\cf19 return} {\cf17 false}; {\cf20 // ray is parallel to the plane of the triangle}\par
86 \par
87         T inv_det = {\cf17 static_cast<}T{\cf17 >}(1) / det;\par
88 \par
89         {\cf20 // calculate distance, ray intersects triangle}\par
90         distance = glm::dot(edge2, Perpendicular) * inv_det;\par
91         baryPosition *= inv_det;\par
92 \par
93         {\cf19 return} {\cf17 true};\par
94     \}\par
95 \par
96     {\cf17 template}<{\cf17 typename} genType>\par
97     GLM_FUNC_QUALIFIER {\cf18 bool} intersectLineTriangle\par
98     (\par
99         genType {\cf17 const}& orig, genType {\cf17 const}& dir,\par
100         genType {\cf17 const}& vert0, genType {\cf17 const}& vert1, genType {\cf17 const}& vert2,\par
101         genType & position\par
102     )\par
103     \{\par
104         {\cf17 typename} genType::value_type Epsilon = std::numeric_limits<typename genType::value_type>::epsilon();\par
105 \par
106         genType edge1 = vert1 - vert0;\par
107         genType edge2 = vert2 - vert0;\par
108 \par
109         genType Perpendicular = cross(dir, edge2);\par
110 \par
111         {\cf17 typename} genType::value_type det = dot(edge1, Perpendicular);\par
112 \par
113         {\cf19 if} (det > -Epsilon && det < Epsilon)\par
114             {\cf19 return} {\cf17 false};\par
115         {\cf17 typename} genType::value_type inv_det = {\cf17 typename} genType::value_type(1) / det;\par
116 \par
117         genType Tangent = orig - vert0;\par
118 \par
119         position.y = dot(Tangent, Perpendicular) * inv_det;\par
120         {\cf19 if} (position.y < {\cf17 typename} genType::value_type(0) || position.y > {\cf17 typename} genType::value_type(1))\par
121             {\cf19 return} {\cf17 false};\par
122 \par
123         genType Cotangent = cross(Tangent, edge1);\par
124 \par
125         position.z = dot(dir, Cotangent) * inv_det;\par
126         {\cf19 if} (position.z < {\cf17 typename} genType::value_type(0) || position.y + position.z > {\cf17 typename} genType::value_type(1))\par
127             {\cf19 return} {\cf17 false};\par
128 \par
129         position.x = dot(edge2, Cotangent) * inv_det;\par
130 \par
131         {\cf19 return} {\cf17 true};\par
132     \}\par
