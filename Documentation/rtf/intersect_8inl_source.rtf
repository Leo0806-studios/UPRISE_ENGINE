134     {\cf17 template}<{\cf17 typename} genType>\par
135     GLM_FUNC_QUALIFIER {\cf18 bool} intersectRaySphere\par
136     (\par
137         genType {\cf17 const}& rayStarting, genType {\cf17 const}& rayNormalizedDirection,\par
138         genType {\cf17 const}& sphereCenter, {\cf17 const} {\cf17 typename} genType::value_type sphereRadiusSquared,\par
139         {\cf17 typename} genType::value_type & intersectionDistance\par
140     )\par
141     \{\par
142         {\cf17 typename} genType::value_type Epsilon = std::numeric_limits<typename genType::value_type>::epsilon();\par
143         genType diff = sphereCenter - rayStarting;\par
144         {\cf17 typename} genType::value_type t0 = dot(diff, rayNormalizedDirection);\par
145         {\cf17 typename} genType::value_type dSquared = dot(diff, diff) - t0 * t0;\par
146         {\cf19 if}( dSquared > sphereRadiusSquared )\par
147         \{\par
148             {\cf19 return} {\cf17 false};\par
149         \}\par
150         {\cf17 typename} genType::value_type t1 = sqrt( sphereRadiusSquared - dSquared );\par
151         intersectionDistance = t0 > t1 + Epsilon ? t0 - t1 : t0 + t1;\par
152         {\cf19 return} intersectionDistance > Epsilon;\par
153     \}\par
154 \par
155     {\cf17 template}<{\cf17 typename} genType>\par
156     GLM_FUNC_QUALIFIER {\cf18 bool} intersectRaySphere\par
157     (\par
158         genType {\cf17 const}& rayStarting, genType {\cf17 const}& rayNormalizedDirection,\par
159         genType {\cf17 const}& sphereCenter, {\cf17 const} {\cf17 typename} genType::value_type sphereRadius,\par
160         genType & intersectionPosition, genType & intersectionNormal\par
161     )\par
162     \{\par
163         {\cf17 typename} genType::value_type distance;\par
164         {\cf19 if}( intersectRaySphere( rayStarting, rayNormalizedDirection, sphereCenter, sphereRadius * sphereRadius, distance ) )\par
165         \{\par
166             intersectionPosition = rayStarting + rayNormalizedDirection * distance;\par
167             intersectionNormal = (intersectionPosition - sphereCenter) / sphereRadius;\par
168             {\cf19 return} {\cf17 true};\par
169         \}\par
170         {\cf19 return} {\cf17 false};\par
171     \}\par
172 \par
173     {\cf17 template}<{\cf17 typename} genType>\par
174     GLM_FUNC_QUALIFIER {\cf18 bool} intersectLineSphere\par
175     (\par
176         genType {\cf17 const}& point0, genType {\cf17 const}& point1,\par
177         genType {\cf17 const}& sphereCenter, {\cf17 typename} genType::value_type sphereRadius,\par
178         genType & intersectionPoint1, genType & intersectionNormal1,\par
179         genType & intersectionPoint2, genType & intersectionNormal2\par
180     )\par
181     \{\par
182         {\cf17 typename} genType::value_type Epsilon = std::numeric_limits<typename genType::value_type>::epsilon();\par
183         genType dir = normalize(point1 - point0);\par
184         genType diff = sphereCenter - point0;\par
185         {\cf17 typename} genType::value_type t0 = dot(diff, dir);\par
186         {\cf17 typename} genType::value_type dSquared = dot(diff, diff) - t0 * t0;\par
187         {\cf19 if}( dSquared > sphereRadius * sphereRadius )\par
188         \{\par
189             {\cf19 return} {\cf17 false};\par
190         \}\par
191         {\cf17 typename} genType::value_type t1 = sqrt( sphereRadius * sphereRadius - dSquared );\par
192         {\cf19 if}( t0 < t1 + Epsilon )\par
193             t1 = -t1;\par
194         intersectionPoint1 = point0 + dir * (t0 - t1);\par
195         intersectionNormal1 = (intersectionPoint1 - sphereCenter) / sphereRadius;\par
196         intersectionPoint2 = point0 + dir * (t0 + t1);\par
197         intersectionNormal2 = (intersectionPoint2 - sphereCenter) / sphereRadius;\par
198         {\cf19 return} {\cf17 true};\par
199     \}\par
