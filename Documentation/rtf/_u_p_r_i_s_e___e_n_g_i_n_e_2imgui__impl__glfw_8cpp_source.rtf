00422 {\cf18 void} ImGui_ImplGlfw_KeyCallback(GLFWwindow* window, {\cf18 int} keycode, {\cf18 int} scancode, {\cf18 int} action, {\cf18 int} mods)\par
00423 \{\par
00424     ImGui_ImplGlfw_Data* bd = ImGui_ImplGlfw_GetBackendData();\par
00425     {\cf19 if} (bd->PrevUserCallbackKey != {\cf17 nullptr} && ImGui_ImplGlfw_ShouldChainCallback(window))\par
00426         bd->PrevUserCallbackKey(window, keycode, scancode, action, mods);\par
