00511 {\cf17 static} EM_BOOL ImGui_ImplEmscripten_WheelCallback({\cf18 int}, {\cf17 const} EmscriptenWheelEvent* ev, {\cf18 void}*)\par
00512 \{\par
00513     {\cf20 // Mimic Emscripten_HandleWheel() in SDL.}\par
00514     {\cf20 // Corresponding equivalent in GLFW JS emulation layer has incorrect quantizing preventing small values. See #6096}\par
00515     {\cf18 float} multiplier = 0.0f;\par
00516     {\cf19 if} (ev->deltaMode == DOM_DELTA_PIXEL)       \{ multiplier = 1.0f / 100.0f; \} {\cf20 // 100 pixels make up a step.}\par
00517     {\cf19 else} {\cf19 if} (ev->deltaMode == DOM_DELTA_LINE)   \{ multiplier = 1.0f / 3.0f; \}   {\cf20 // 3 lines make up a step.}\par
00518     {\cf19 else} {\cf19 if} (ev->deltaMode == DOM_DELTA_PAGE)   \{ multiplier = 80.0f; \}         {\cf20 // A page makes up 80 steps.}\par
00519     {\cf18 float} wheel_x = ev->deltaX * -multiplier;\par
00520     {\cf18 float} wheel_y = ev->deltaY * -multiplier;\par
00521     ImGuiIO& io = ImGui::GetIO();\par
00522     io.AddMouseWheelEvent(wheel_x, wheel_y);\par
00523     {\cf20 //IMGUI_DEBUG_LOG("[Emsc] mode %d dx: %.2f, dy: %.2f, dz: %.2f --> feed %.2f %.2f\\n", (int)ev->deltaMode, ev->deltaX, ev->deltaY, ev->deltaZ, wheel_x, wheel_y);}\par
00524     {\cf19 return} EM_TRUE;\par
00525 \}\par
00526 {\cf21 #endif}\par
