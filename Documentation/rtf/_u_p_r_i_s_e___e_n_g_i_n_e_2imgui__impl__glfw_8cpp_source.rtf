00786         {\cf20 // We cannot use bd->MouseWindow maintained from CursorEnter/Leave callbacks, because it is locked to the window capturing mouse.}\par
00787 {\cf21 #endif}\par
00788     \}\par
00789 \par
00790     {\cf19 if} (io.BackendFlags & ImGuiBackendFlags_HasMouseHoveredViewport)\par
00791         io.AddMouseViewportEvent(mouse_viewport_id);\par
00792 \}\par
