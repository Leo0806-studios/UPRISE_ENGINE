01354 {\cf17 static} ImGuiMouseSource GetMouseSourceFromMessageExtraInfo()\par
01355 \{\par
01356     LPARAM extra_info = ::GetMessageExtraInfo();\par
01357     {\cf19 if} ((extra_info & 0xFFFFFF80) == 0xFF515700)\par
01358         {\cf19 return} ImGuiMouseSource_Pen;\par
01359     {\cf19 if} ((extra_info & 0xFFFFFF80) == 0xFF515780)\par
01360         {\cf19 return} ImGuiMouseSource_TouchScreen;\par
01361     {\cf19 return} ImGuiMouseSource_Mouse;\par
01362 \}\par
01363 {\cf17 static} LRESULT CALLBACK ImGui_ImplGlfw_WndProc(HWND hWnd, UINT msg, WPARAM wParam, LPARAM lParam)\par
01364 \{\par
01365     ImGui_ImplGlfw_Data* bd = ImGui_ImplGlfw_GetBackendData();\par
01366     WNDPROC prev_wndproc = bd->PrevWndProc;\par
01367     ImGuiViewport* viewport = (ImGuiViewport*)::GetPropA(hWnd, {\cf22 "IMGUI_VIEWPORT"});\par
01368     {\cf19 if} (viewport != NULL)\par
01369         {\cf19 if} (ImGui_ImplGlfw_ViewportData* vd = (ImGui_ImplGlfw_ViewportData*)viewport->PlatformUserData)\par
01370             prev_wndproc = vd->PrevWndProc;\par
01371 \par
01372     {\cf19 switch} (msg)\par
01373     \{\par
01374         {\cf20 // GLFW doesn't allow to distinguish Mouse vs TouchScreen vs Pen.}\par
01375         {\cf20 // Add support for Win32 (based on imgui_impl_win32), because we rely on _TouchScreen info to trickle inputs differently.}\par
01376     {\cf19 case} WM_MOUSEMOVE: {\cf19 case} WM_NCMOUSEMOVE:\par
01377     {\cf19 case} WM_LBUTTONDOWN: {\cf19 case} WM_LBUTTONDBLCLK: {\cf19 case} WM_LBUTTONUP:\par
01378     {\cf19 case} WM_RBUTTONDOWN: {\cf19 case} WM_RBUTTONDBLCLK: {\cf19 case} WM_RBUTTONUP:\par
01379     {\cf19 case} WM_MBUTTONDOWN: {\cf19 case} WM_MBUTTONDBLCLK: {\cf19 case} WM_MBUTTONUP:\par
01380     {\cf19 case} WM_XBUTTONDOWN: {\cf19 case} WM_XBUTTONDBLCLK: {\cf19 case} WM_XBUTTONUP:\par
01381         ImGui::GetIO().AddMouseSourceEvent(GetMouseSourceFromMessageExtraInfo());\par
01382         {\cf19 break};\par
01383 \par
01384         {\cf20 // We have submitted https://github.com/glfw/glfw/pull/1568 to allow GLFW to support "transparent inputs".}\par
01385         {\cf20 // In the meanwhile we implement custom per-platform workarounds here (FIXME-VIEWPORT: Implement same work-around for Linux/OSX!)}\par
01386 {\cf21 #if !GLFW_HAS_MOUSE_PASSTHROUGH && GLFW_HAS_WINDOW_HOVERED}\par
01387     {\cf19 case} WM_NCHITTEST:\par
01388     \{\par
01389         {\cf20 // Let mouse pass-through the window. This will allow the backend to call io.AddMouseViewportEvent() properly (which is OPTIONAL).}\par
01390         {\cf20 // The ImGuiViewportFlags_NoInputs flag is set while dragging a viewport, as want to detect the window behind the one we are dragging.}\par
01391         {\cf20 // If you cannot easily access those viewport flags from your windowing/event code: you may manually synchronize its state e.g. in}\par
01392         {\cf20 // your main loop after calling UpdatePlatformWindows(). Iterate all viewports/platform windows and pass the flag to your windowing system.}\par
01393         {\cf19 if} (viewport && (viewport->Flags & ImGuiViewportFlags_NoInputs))\par
01394             {\cf19 return} HTTRANSPARENT;\par
01395         {\cf19 break};\par
01396     \}\par
01397 {\cf21 #endif}\par
01398     \}\par
01399     return ::CallWindowProcW(prev_wndproc, hWnd, msg, wParam, lParam);\par
