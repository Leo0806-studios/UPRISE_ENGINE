00389 {\cf17 static} {\cf18 int} ImGui_ImplGlfw_TranslateUntranslatedKey({\cf18 int} key, {\cf18 int} scancode)\par
00390 \{\par
00391 {\cf21 #if GLFW_HAS_GETKEYNAME && !defined(EMSCRIPTEN_USE_EMBEDDED_GLFW3)}\par
00392     {\cf20 // GLFW 3.1+ attempts to "untranslate" keys, which goes the opposite of what every other framework does, making using lettered shortcuts difficult.}\par
00393     {\cf20 // (It had reasons to do so: namely GLFW is/was more likely to be used for WASD-type game controls rather than lettered shortcuts, but IHMO the 3.1 change could have been done differently)}\par
00394     {\cf20 // See https://github.com/glfw/glfw/issues/1502 for details.}\par
00395     {\cf20 // Adding a workaround to undo this (so our keys are translated->untranslated->translated, likely a lossy process).}\par
00396     {\cf20 // This won't cover edge cases but this is at least going to cover common cases.}\par
00397     {\cf19 if} (key >= GLFW_KEY_KP_0 && key <= GLFW_KEY_KP_EQUAL)\par
00398         {\cf19 return} key;\par
00399     GLFWerrorfun prev_error_callback = glfwSetErrorCallback({\cf17 nullptr});\par
00400     {\cf17 const} {\cf18 char}* key_name = glfwGetKeyName(key, scancode);\par
00401     glfwSetErrorCallback(prev_error_callback);\par
00402 {\cf21 #if GLFW_HAS_GETERROR && !defined(EMSCRIPTEN_USE_EMBEDDED_GLFW3) }{\cf20 // Eat errors (see #5908)}\par
00403     (void)glfwGetError({\cf17 nullptr});\par
00404 {\cf21 #endif}\par
00405     {\cf19 if} (key_name && key_name[0] != 0 && key_name[1] == 0)\par
00406     \{\par
00407         {\cf17 const} {\cf18 char} char_names[] = {\cf22 "`-=[]\\\\,;\\'./"};\par
00408         {\cf17 const} {\cf18 int} char_keys[] = \{ GLFW_KEY_GRAVE_ACCENT, GLFW_KEY_MINUS, GLFW_KEY_EQUAL, GLFW_KEY_LEFT_BRACKET, GLFW_KEY_RIGHT_BRACKET, GLFW_KEY_BACKSLASH, GLFW_KEY_COMMA, GLFW_KEY_SEMICOLON, GLFW_KEY_APOSTROPHE, GLFW_KEY_PERIOD, GLFW_KEY_SLASH, 0 \};\par
00409         IM_ASSERT(IM_ARRAYSIZE(char_names) == IM_ARRAYSIZE(char_keys));\par
00410         {\cf19 if} (key_name[0] >= {\cf23 '0'} && key_name[0] <= {\cf23 '9'})               \{ key = GLFW_KEY_0 + (key_name[0] - {\cf23 '0'}); \}\par
00411         {\cf19 else} {\cf19 if} (key_name[0] >= {\cf23 'A'} && key_name[0] <= {\cf23 'Z'})          \{ key = GLFW_KEY_A + (key_name[0] - {\cf23 'A'}); \}\par
00412         {\cf19 else} {\cf19 if} (key_name[0] >= {\cf23 'a'} && key_name[0] <= {\cf23 'z'})          \{ key = GLFW_KEY_A + (key_name[0] - {\cf23 'a'}); \}\par
00413         {\cf19 else} {\cf19 if} ({\cf17 const} {\cf18 char}* p = strchr(char_names, key_name[0]))   \{ key = char_keys[p - char_names]; \}\par
00414     \}\par
00415     {\cf20 // if (action == GLFW_PRESS) printf("key %d scancode %d name '%s'\\n", key, scancode, key_name);}\par
00416 {\cf21 #else}\par
00417     IM_UNUSED(scancode);\par
00418 {\cf21 #endif}\par
00419     {\cf19 return} key;\par
00420 \}\par
