01049         \{\par
01050             {\cf18 bool} ignore_event = (ImGui::GetFrameCount() <= vd->IgnoreWindowPosEventFrame + 1);\par
01051             {\cf20 //data->IgnoreWindowPosEventFrame = -1;}\par
01052             {\cf19 if} (ignore_event)\par
01053                 {\cf19 return};\par
