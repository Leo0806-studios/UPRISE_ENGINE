00916 {\cf18 void} ImGui_ImplGlfw_NewFrame()\par
00917 \{\par
00918     ImGuiIO& io = ImGui::GetIO();\par
00919     ImGui_ImplGlfw_Data* bd = ImGui_ImplGlfw_GetBackendData();\par
00920     IM_ASSERT(bd != {\cf17 nullptr} && {\cf22 "Context or backend not initialized! Did you call ImGui_ImplGlfw_InitForXXX()?"});\par
00921 \par
00922     {\cf20 // Setup display size (every frame to accommodate for window resizing)}\par
00923     {\cf18 int} w, h;\par
00924     {\cf18 int} display_w, display_h;\par
00925     glfwGetWindowSize(bd->Window, &w, &h);\par
00926     glfwGetFramebufferSize(bd->Window, &display_w, &display_h);\par
00927     io.DisplaySize = ImVec2(({\cf18 float})w, ({\cf18 float})h);\par
00928     {\cf19 if} (w > 0 && h > 0)\par
00929         io.DisplayFramebufferScale = ImVec2(({\cf18 float})display_w / ({\cf18 float})w, ({\cf18 float})display_h / ({\cf18 float})h);\par
00930     {\cf19 if} (bd->WantUpdateMonitors)\par
00931         ImGui_ImplGlfw_UpdateMonitors();\par
00932 \par
00933     {\cf20 // Setup time step}\par
00934     {\cf20 // (Accept glfwGetTime() not returning a monotonically increasing value. Seems to happens on disconnecting peripherals and probably on VMs and Emscripten, see #6491, #6189, #6114, #3644)}\par
00935     {\cf18 double} current_time = glfwGetTime();\par
00936     {\cf19 if} (current_time <= bd->Time)\par
00937         current_time = bd->Time + 0.00001f;\par
00938     io.DeltaTime = bd->Time > 0.0 ? (float)(current_time - bd->Time) : (float)(1.0f / 60.0f);\par
00939     bd->Time = current_time;\par
00940 \par
00941     ImGui_ImplGlfw_UpdateMouseData();\par
00942     ImGui_ImplGlfw_UpdateMouseCursor();\par
00943 \par
00944     {\cf20 // Update game controllers (if enabled and available)}\par
00945     ImGui_ImplGlfw_UpdateGamepads();\par
00946 \}\par
