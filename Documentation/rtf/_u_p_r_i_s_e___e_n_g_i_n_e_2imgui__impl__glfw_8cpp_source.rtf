00874 {\cf17 static} {\cf18 void} ImGui_ImplGlfw_UpdateMonitors()\par
00875 \{\par
00876     ImGui_ImplGlfw_Data* bd = ImGui_ImplGlfw_GetBackendData();\par
00877     ImGuiPlatformIO& platform_io = ImGui::GetPlatformIO();\par
00878     bd->WantUpdateMonitors = {\cf17 false};\par
00879 \par
00880     {\cf18 int} monitors_count = 0;\par
00881     GLFWmonitor** glfw_monitors = glfwGetMonitors(&monitors_count);\par
00882     {\cf19 if} (monitors_count == 0) {\cf20 // Preserve existing monitor list if there are none. Happens on macOS sleeping (#5683)}\par
00883         {\cf19 return};\par
00884 \par
00885     platform_io.Monitors.resize(0);\par
00886     {\cf19 for} ({\cf18 int} n = 0; n < monitors_count; n++)\par
00887     \{\par
00888         ImGuiPlatformMonitor monitor;\par
00889         {\cf18 int} x, y;\par
00890         glfwGetMonitorPos(glfw_monitors[n], &x, &y);\par
00891         {\cf17 const} GLFWvidmode* vid_mode = glfwGetVideoMode(glfw_monitors[n]);\par
00892         {\cf19 if} (vid_mode == {\cf17 nullptr})\par
00893             {\cf19 continue}; {\cf20 // Failed to get Video mode (e.g. Emscripten does not support this function)}\par
00894         monitor.MainPos = monitor.WorkPos = ImVec2(({\cf18 float})x, ({\cf18 float})y);\par
00895         monitor.MainSize = monitor.WorkSize = ImVec2(({\cf18 float})vid_mode->width, ({\cf18 float})vid_mode->height);\par
00896 {\cf21 #if GLFW_HAS_MONITOR_WORK_AREA}\par
00897         {\cf18 int} w, h;\par
00898         glfwGetMonitorWorkarea(glfw_monitors[n], &x, &y, &w, &h);\par
00899         {\cf19 if} (w > 0 && h > 0) {\cf20 // Workaround a small GLFW issue reporting zero on monitor changes: https://github.com/glfw/glfw/pull/1761}\par
00900         \{\par
00901             monitor.WorkPos = ImVec2(({\cf18 float})x, ({\cf18 float})y);\par
00902             monitor.WorkSize = ImVec2(({\cf18 float})w, ({\cf18 float})h);\par
00903         \}\par
00904 {\cf21 #endif}\par
00905 {\cf21 #if GLFW_HAS_PER_MONITOR_DPI}\par
00906         {\cf20 // Warning: the validity of monitor DPI information on Windows depends on the application DPI awareness settings, which generally needs to be set in the manifest or at runtime.}\par
00907         {\cf18 float} x_scale, y_scale;\par
00908         glfwGetMonitorContentScale(glfw_monitors[n], &x_scale, &y_scale);\par
00909         monitor.DpiScale = x_scale;\par
00910 {\cf21 #endif}\par
00911         monitor.PlatformHandle = ({\cf18 void}*)glfw_monitors[n]; {\cf20 // [...] GLFW doc states: "guaranteed to be valid only until the monitor configuration changes"}\par
00912         platform_io.Monitors.push_back(monitor);\par
00913     \}\par
00914 \}\par
