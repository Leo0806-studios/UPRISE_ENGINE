00723 {\cf17 static} {\cf18 void} ImGui_ImplGlfw_UpdateMouseData()\par
00724 \{\par
00725     ImGui_ImplGlfw_Data* bd = ImGui_ImplGlfw_GetBackendData();\par
00726     ImGuiIO& io = ImGui::GetIO();\par
00727     ImGuiPlatformIO& platform_io = ImGui::GetPlatformIO();\par
00728 \par
00729     ImGuiID mouse_viewport_id = 0;\par
00730     {\cf17 const} ImVec2 mouse_pos_prev = io.MousePos;\par
00731     {\cf19 for} ({\cf18 int} n = 0; n < platform_io.Viewports.Size; n++)\par
00732     \{\par
00733         ImGuiViewport* viewport = platform_io.Viewports[n];\par
00734         GLFWwindow* window = (GLFWwindow*)viewport->PlatformHandle;\par
00735 \par
00736 {\cf21 #ifdef EMSCRIPTEN_USE_EMBEDDED_GLFW3}\par
00737         {\cf17 const} {\cf18 bool} is_window_focused = {\cf17 true};\par
00738 {\cf21 #else}\par
00739         {\cf17 const} {\cf18 bool} is_window_focused = glfwGetWindowAttrib(window, GLFW_FOCUSED) != 0;\par
00740 {\cf21 #endif}\par
00741         {\cf19 if} (is_window_focused)\par
00742         \{\par
00743             {\cf20 // (Optional) Set OS mouse position from Dear ImGui if requested (rarely used, only when ImGuiConfigFlags_NavEnableSetMousePos is enabled by user)}\par
00744             {\cf20 // When multi-viewports are enabled, all Dear ImGui positions are same as OS positions.}\par
00745             {\cf19 if} (io.WantSetMousePos)\par
00746                 glfwSetCursorPos(window, ({\cf18 double})(mouse_pos_prev.x - viewport->Pos.x), ({\cf18 double})(mouse_pos_prev.y - viewport->Pos.y));\par
00747 \par
00748             {\cf20 // (Optional) Fallback to provide mouse position when focused (ImGui_ImplGlfw_CursorPosCallback already provides this when hovered or captured)}\par
00749             {\cf19 if} (bd->MouseWindow == {\cf17 nullptr})\par
00750             \{\par
00751                 {\cf18 double} mouse_x, mouse_y;\par
00752                 glfwGetCursorPos(window, &mouse_x, &mouse_y);\par
00753                 {\cf19 if} (io.ConfigFlags & ImGuiConfigFlags_ViewportsEnable)\par
00754                 \{\par
00755                     {\cf20 // Single viewport mode: mouse position in client window coordinates (io.MousePos is (0,0) when the mouse is on the upper-left corner of the app window)}\par
00756                     {\cf20 // Multi-viewport mode: mouse position in OS absolute coordinates (io.MousePos is (0,0) when the mouse is on the upper-left of the primary monitor)}\par
00757                     {\cf18 int} window_x, window_y;\par
00758                     glfwGetWindowPos(window, &window_x, &window_y);\par
00759                     mouse_x += window_x;\par
00760                     mouse_y += window_y;\par
00761                 \}\par
00762                 bd->LastValidMousePos = ImVec2(({\cf18 float})mouse_x, ({\cf18 float})mouse_y);\par
00763                 io.AddMousePosEvent(({\cf18 float})mouse_x, ({\cf18 float})mouse_y);\par
00764             \}\par
00765         \}\par
00766 \par
00767         {\cf20 // (Optional) When using multiple viewports: call io.AddMouseViewportEvent() with the viewport the OS mouse cursor is hovering.}\par
00768         {\cf20 // If ImGuiBackendFlags_HasMouseHoveredViewport is not set by the backend, Dear imGui will ignore this field and infer the information using its flawed heuristic.}\par
00769         {\cf20 // - [X] GLFW >= 3.3 backend ON WINDOWS ONLY does correctly ignore viewports with the _NoInputs flag (since we implement hit via our WndProc hook)}\par
00770         {\cf20 //       On other platforms we rely on the library fallbacking to its own search when reporting a viewport with _NoInputs flag.}\par
00771         {\cf20 // - [!] GLFW <= 3.2 backend CANNOT correctly ignore viewports with the _NoInputs flag, and CANNOT reported Hovered Viewport because of mouse capture.}\par
00772         {\cf20 //       Some backend are not able to handle that correctly. If a backend report an hovered viewport that has the _NoInputs flag (e.g. when dragging a window}\par
00773         {\cf20 //       for docking, the viewport has the _NoInputs flag in order to allow us to find the viewport under), then Dear ImGui is forced to ignore the value reported}\par
00774         {\cf20 //       by the backend, and use its flawed heuristic to guess the viewport behind.}\par
00775         {\cf20 // - [X] GLFW backend correctly reports this regardless of another viewport behind focused and dragged from (we need this to find a useful drag and drop target).}\par
00776         {\cf20 // FIXME: This is currently only correct on Win32. See what we do below with the WM_NCHITTEST, missing an equivalent for other systems.}\par
00777         {\cf20 // See https://github.com/glfw/glfw/issues/1236 if you want to help in making this a GLFW feature.}\par
00778 {\cf21 #if GLFW_HAS_MOUSE_PASSTHROUGH}\par
00779         {\cf17 const} {\cf18 bool} window_no_input = (viewport->Flags & ImGuiViewportFlags_NoInputs) != 0;\par
00780         glfwSetWindowAttrib(window, GLFW_MOUSE_PASSTHROUGH, window_no_input);\par
00781 {\cf21 #endif}\par
00782 {\cf21 #if GLFW_HAS_MOUSE_PASSTHROUGH || GLFW_HAS_WINDOW_HOVERED}\par
00783         {\cf19 if} (glfwGetWindowAttrib(window, GLFW_HOVERED))\par
00784             mouse_viewport_id = viewport->ID;\par
