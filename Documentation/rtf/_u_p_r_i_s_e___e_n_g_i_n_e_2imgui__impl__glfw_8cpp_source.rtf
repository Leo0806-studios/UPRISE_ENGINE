01207 {\cf17 static} {\cf18 void} ImGui_ImplGlfw_SetWindowSize(ImGuiViewport* viewport, ImVec2 size)\par
01208 \{\par
01209     ImGui_ImplGlfw_ViewportData* vd = (ImGui_ImplGlfw_ViewportData*)viewport->PlatformUserData;\par
01210 {\cf21 #if __APPLE__ && !GLFW_HAS_OSX_WINDOW_POS_FIX}\par
01211     {\cf20 // Native OS windows are positioned from the bottom-left corner on macOS, whereas on other platforms they are}\par
01212     {\cf20 // positioned from the upper-left corner. GLFW makes an effort to convert macOS style coordinates, however it}\par
01213     {\cf20 // doesn't handle it when changing size. We are manually moving the window in order for changes of size to be based}\par
01214     {\cf20 // on the upper-left corner.}\par
01215     {\cf18 int} x, y, width, height;\par
01216     glfwGetWindowPos(vd->Window, &x, &y);\par
01217     glfwGetWindowSize(vd->Window, &width, &height);\par
01218     glfwSetWindowPos(vd->Window, x, y - height + size.y);\par
01219 {\cf21 #endif}\par
01220     vd->IgnoreWindowSizeEventFrame = ImGui::GetFrameCount();\par
01221     glfwSetWindowSize(vd->Window, ({\cf18 int})size.x, ({\cf18 int})size.y);\par
01222 \}\par
