00346 {\cf20 /* Add a single DWARF section to DWARF_SECTIONS, if we need the}\par
00347 {\cf20    section.  Returns 1 on success, 0 on failure.  */}\par
00348 \par
00349 {\cf17 static} {\cf18 int}\par
00350 macho_add_dwarf_section ({\cf17 struct} backtrace_state *state, {\cf18 int} descriptor,\par
00351              {\cf17 const} {\cf18 char} *sectname, uint32_t offset, uint64_t size,\par
00352              backtrace_error_callback error_callback, {\cf18 void} *data,\par
00353              {\cf17 struct} dwarf_sections *dwarf_sections)\par
00354 \{\par
00355   {\cf18 int} i;\par
00356 \par
00357   {\cf19 for} (i = 0; i < (int) DEBUG_MAX; ++i)\par
00358     \{\par
00359       {\cf19 if} (dwarf_section_names[i][0] != {\cf23 '\\0'}\par
00360       && strncmp (sectname, dwarf_section_names[i], MACH_O_NAMELEN) == 0)\par
00361     \{\par
00362       {\cf17 struct }backtrace_view section_view;\par
00363 \par
00364       {\cf20 /* FIXME: Perhaps it would be better to try to use a single}\par
00365 {\cf20          view to read all the DWARF data, as we try to do for}\par
00366 {\cf20          ELF.  */}\par
00367 \par
00368       {\cf19 if} (!backtrace_get_view (state, descriptor, offset, size,\par
00369                    error_callback, data, &section_view))\par
00370         {\cf19 return} 0;\par
00371       dwarf_sections->data[i] = ({\cf17 const} {\cf18 unsigned} {\cf18 char} *) section_view.data;\par
00372       dwarf_sections->size[i] = size;\par
00373       {\cf19 break};\par
00374     \}\par
00375     \}\par
00376   {\cf19 return} 1;\par
00377 \}\par
00378 \par
00379 {\cf20 /* Collect DWARF sections from a DWARF segment.  Returns 1 on success,}\par
00380 {\cf20    0 on failure.  */}\par
00381 \par
00382 {\cf17 static} {\cf18 int}\par
00383 macho_add_dwarf_segment ({\cf17 struct} backtrace_state *state, {\cf18 int} descriptor,\par
00384              off_t offset, {\cf18 unsigned} {\cf18 int} cmd, {\cf17 const} {\cf18 char} *psecs,\par
00385              {\cf18 size_t} sizesecs, {\cf18 unsigned} {\cf18 int} nsects,\par
00386              backtrace_error_callback error_callback, {\cf18 void} *data,\par
00387              {\cf17 struct} dwarf_sections *dwarf_sections)\par
00388 \{\par
00389   {\cf18 size_t} sec_header_size;\par
00390   {\cf18 size_t} secoffset;\par
00391   {\cf18 unsigned} {\cf18 int} i;\par
00392 \par
00393   {\cf19 switch} (cmd)\par
00394     \{\par
00395     {\cf19 case} MACH_O_LC_SEGMENT:\par
00396       sec_header_size = {\cf17 sizeof} ({\cf17 struct }macho_section);\par
00397       {\cf19 break};\par
00398     {\cf19 case} MACH_O_LC_SEGMENT_64:\par
00399       sec_header_size = {\cf17 sizeof} ({\cf17 struct }macho_section_64);\par
00400       {\cf19 break};\par
00401     {\cf19 default}:\par
00402       abort ();\par
00403     \}\par
00404 \par
00405   secoffset = 0;\par
00406   {\cf19 for} (i = 0; i < nsects; ++i)\par
00407     \{\par
00408       {\cf19 if} (secoffset + sec_header_size > sizesecs)\par
00409     \{\par
00410       error_callback (data, {\cf22 "section overflow withing segment"}, 0);\par
00411       {\cf19 return} 0;\par
00412     \}\par
00413 \par
00414       {\cf19 switch} (cmd)\par
00415     \{\par
00416     {\cf19 case} MACH_O_LC_SEGMENT:\par
00417       \{\par
00418         {\cf17 struct }macho_section section;\par
00419 \par
00420         memcpy (&section, psecs + secoffset, {\cf17 sizeof} section);\par
00421         macho_add_dwarf_section (state, descriptor, section.sectname,\par
00422                      offset + section.offset, section.size,\par
00423                      error_callback, data, dwarf_sections);\par
00424       \}\par
00425       {\cf19 break};\par
00426 \par
00427     {\cf19 case} MACH_O_LC_SEGMENT_64:\par
00428       \{\par
00429         {\cf17 struct }macho_section_64 section;\par
00430 \par
00431         memcpy (&section, psecs + secoffset, {\cf17 sizeof} section);\par
00432         macho_add_dwarf_section (state, descriptor, section.sectname,\par
00433                      offset + section.offset, section.size,\par
00434                      error_callback, data, dwarf_sections);\par
00435       \}\par
00436       {\cf19 break};\par
00437 \par
00438     {\cf19 default}:\par
00439       abort ();\par
00440     \}\par
00441 \par
00442       secoffset += sec_header_size;\par
00443     \}\par
00444 \par
00445   {\cf19 return} 1;\par
00446 \}\par
