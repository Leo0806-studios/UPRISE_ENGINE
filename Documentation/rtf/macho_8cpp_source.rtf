00463 \par
00464 {\cf20 /* Compare an address against a macho_symbol for bsearch.  We allocate}\par
00465 {\cf20    one extra entry in the array so that this can safely look at the}\par
00466 {\cf20    next entry.  */}\par
00467 \par
00468 {\cf17 static} {\cf18 int}\par
00469 macho_symbol_search ({\cf17 const} {\cf18 void} *vkey, {\cf17 const} {\cf18 void} *ventry)\par
00470 \{\par
00471   {\cf17 const} uintptr_t *key = ({\cf17 const} uintptr_t *) vkey;\par
00472   {\cf17 const} {\cf17 struct }macho_symbol *entry = ({\cf17 const} {\cf17 struct }macho_symbol *) ventry;\par
00473   uintptr_t addr;\par
00474 \par
00475   addr = *key;\par
00476   {\cf19 if} (addr < entry->address)\par
00477     {\cf19 return} -1;\par
00478   {\cf19 else} {\cf19 if} (entry->name[0] == {\cf23 '\\0'}\par
00479        && entry->address == ~(uintptr_t) 0)\par
00480     {\cf19 return} -1;\par
00481   {\cf19 else} {\cf19 if} ((entry + 1)->name[0] == {\cf23 '\\0'}\par
00482        && (entry + 1)->address == ~(uintptr_t) 0)\par
00483     {\cf19 return} -1;\par
00484   {\cf19 else} {\cf19 if} (addr >= (entry + 1)->address)\par
00485     {\cf19 return} 1;\par
00486   {\cf19 else}\par
00487     {\cf19 return} 0;\par
00488 \}\par
