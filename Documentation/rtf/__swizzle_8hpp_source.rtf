127     {\cf17 protected}:\par
128         {\cf17 template}<{\cf17 typename} U>\par
129         GLM_FUNC_QUALIFIER {\cf18 void} _apply_op(vec<N, T, Q> {\cf17 const}& that, {\cf17 const} U& op)\par
130         \{\par
131             {\cf20 // Make a copy of the data in this == &that.}\par
132             {\cf20 // The copier should optimize out the copy in cases where the function is}\par
133             {\cf20 // properly inlined and the copy is not necessary.}\par
134             T t[N];\par
135             {\cf19 for} ({\cf18 int} i = 0; i < N; ++i)\par
136                 t[i] = that[i];\par
137             {\cf19 for} ({\cf18 int} i = 0; i < N; ++i)\par
138                 op( (*{\cf17 this})[i], t[i] );\par
139         \}\par
140     \};\par
