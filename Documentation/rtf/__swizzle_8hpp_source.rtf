102         \{\par
103             _apply_op(that, op_plus());\par
104         \}\par
105 \par
106         GLM_FUNC_QUALIFIER {\cf18 void} operator *= (vec<N, T, Q> {\cf17 const}& that)\par
107         \{\par
108             _apply_op(that, op_mul());\par
109         \}\par
110 \par
111         GLM_FUNC_QUALIFIER {\cf18 void} operator /= (vec<N, T, Q> {\cf17 const}& that)\par
112         \{\par
