52 {\cf20             containing duplicate elements so that they cannot be used as r-values).}\par
53 {\cf20     */}\par
54     {\cf17 template}<{\cf18 int} N, {\cf17 typename} T, qualifier Q, {\cf18 int} E0, {\cf18 int} E1, {\cf18 int} E2, {\cf18 int} E3, {\cf18 int} DUPLICATE_ELEMENTS>\par
55     {\cf17 struct }_swizzle_base2 : {\cf17 public} _swizzle_base1<N, T, Q, E0,E1,E2,E3, detail::is_aligned<Q>::value>\par
56     \{\par
57         {\cf17 struct }op_equal\par
58         \{\par
59             GLM_FUNC_QUALIFIER {\cf18 void} operator() (T& e, T& t){\cf17  const}\{ e = t; \}\par
60         \};\par
61 \par
62         {\cf17 struct }op_minus\par
63         \{\par
64             GLM_FUNC_QUALIFIER {\cf18 void} operator() (T& e, T& t){\cf17  const}\{ e -= t; \}\par
65         \};\par
66 \par
67         {\cf17 struct }op_plus\par
68         \{\par
69             GLM_FUNC_QUALIFIER {\cf18 void} operator() (T& e, T& t){\cf17  const}\{ e += t; \}\par
70         \};\par
71 \par
72         {\cf17 struct }op_mul\par
73         \{\par
74             GLM_FUNC_QUALIFIER {\cf18 void} operator() (T& e, T& t){\cf17  const}\{ e *= t; \}\par
75         \};\par
76 \par
77         {\cf17 struct }op_div\par
78         \{\par
79             GLM_FUNC_QUALIFIER {\cf18 void} operator() (T& e, T& t){\cf17  const}\{ e /= t; \}\par
80         \};\par
81 \par
82     {\cf17 public}:\par
83         GLM_FUNC_QUALIFIER _swizzle_base2& operator= ({\cf17 const} T& t)\par
84         \{\par
85             {\cf19 for} ({\cf18 int} i = 0; i < N; ++i)\par
86                 (*{\cf17 this})[i] = t;\par
87             {\cf19 return} *{\cf17 this};\par
88         \}\par
