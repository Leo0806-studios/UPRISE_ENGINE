93             {\cf19 return} *{\cf17 this};\par
94         \}\par
95 \par
96         GLM_FUNC_QUALIFIER {\cf18 void} operator -= (vec<N, T, Q> {\cf17 const}& that)\par
97         \{\par
98             _apply_op(that, op_minus());\par
99         \}\par
100 \par
