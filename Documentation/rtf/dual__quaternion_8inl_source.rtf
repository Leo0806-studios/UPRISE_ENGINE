244     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
245     GLM_FUNC_QUALIFIER tdualquat<T, Q> inverse(tdualquat<T, Q> {\cf17 const}& q)\par
246     \{\par
247         {\cf17 const} glm::qua<T, Q> real = conjugate(q.real);\par
248         {\cf17 const} glm::qua<T, Q> dual = conjugate(q.dual);\par
249         {\cf19 return} tdualquat<T, Q>(real, dual + (real * (-2.0f * dot(real,dual))));\par
250     \}\par
