252     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
253     GLM_FUNC_QUALIFIER mat<2, 4, T, Q> mat2x4_cast(tdualquat<T, Q> {\cf17 const}& x)\par
254     \{\par
255         {\cf19 return} mat<2, 4, T, Q>( x[0].x, x[0].y, x[0].z, x[0].w, x[1].x, x[1].y, x[1].z, x[1].w );\par
256     \}\par
257 \par
258     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
259     GLM_FUNC_QUALIFIER mat<3, 4, T, Q> mat3x4_cast(tdualquat<T, Q> {\cf17 const}& x)\par
260     \{\par
261         qua<T, Q> r = x.real / length2(x.real);\par
262 \par
263         qua<T, Q> {\cf17 const} rr(r.w * x.real.w, r.x * x.real.x, r.y * x.real.y, r.z * x.real.z);\par
264         r *= {\cf17 static_cast<}T{\cf17 >}(2);\par
265 \par
266         T {\cf17 const} xy = r.x * x.real.y;\par
267         T {\cf17 const} xz = r.x * x.real.z;\par
268         T {\cf17 const} yz = r.y * x.real.z;\par
269         T {\cf17 const} wx = r.w * x.real.x;\par
270         T {\cf17 const} wy = r.w * x.real.y;\par
271         T {\cf17 const} wz = r.w * x.real.z;\par
272 \par
273         vec<4, T, Q> {\cf17 const} a(\par
274             rr.w + rr.x - rr.y - rr.z,\par
275             xy - wz,\par
276             xz + wy,\par
277             -(x.dual.w * r.x - x.dual.x * r.w + x.dual.y * r.z - x.dual.z * r.y));\par
278 \par
279         vec<4, T, Q> {\cf17 const} b(\par
280             xy + wz,\par
281             rr.w + rr.y - rr.x - rr.z,\par
282             yz - wx,\par
283             -(x.dual.w * r.y - x.dual.x * r.z - x.dual.y * r.w + x.dual.z * r.x));\par
284 \par
285         vec<4, T, Q> {\cf17 const} c(\par
286             xz - wy,\par
287             yz + wx,\par
288             rr.w + rr.z - rr.x - rr.y,\par
289             -(x.dual.w * r.z + x.dual.x * r.y - x.dual.y * r.x - x.dual.z * r.w));\par
290 \par
291         {\cf19 return} mat<3, 4, T, Q>(a, b, c);\par
292     \}\par
293 \par
294     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
295     GLM_FUNC_QUALIFIER tdualquat<T, Q> dualquat_cast(mat<2, 4, T, Q> {\cf17 const}& x)\par
296     \{\par
297         {\cf19 return} tdualquat<T, Q>(\par
298             qua<T, Q>::wxyz( x[0].w, x[0].x, x[0].y, x[0].z ),\par
299             qua<T, Q>::wxyz( x[1].w, x[1].x, x[1].y, x[1].z ));\par
300     \}\par
301 \par
302     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
303     GLM_FUNC_QUALIFIER tdualquat<T, Q> dualquat_cast(mat<3, 4, T, Q> {\cf17 const}& x)\par
304     \{\par
305         qua<T, Q> real;\par
306 \par
307         T {\cf17 const} trace = x[0].x + x[1].y + x[2].z;\par
308         {\cf19 if}(trace > {\cf17 static_cast<}T{\cf17 >}(0))\par
309         \{\par
310             T {\cf17 const} r = sqrt(T(1) + trace);\par
311             T {\cf17 const} invr = {\cf17 static_cast<}T{\cf17 >}(0.5) / r;\par
312             real.w = {\cf17 static_cast<}T{\cf17 >}(0.5) * r;\par
313             real.x = (x[2].y - x[1].z) * invr;\par
314             real.y = (x[0].z - x[2].x) * invr;\par
315             real.z = (x[1].x - x[0].y) * invr;\par
316         \}\par
317         {\cf19 else} {\cf19 if}(x[0].x > x[1].y && x[0].x > x[2].z)\par
318         \{\par
319             T {\cf17 const} r = sqrt(T(1) + x[0].x - x[1].y - x[2].z);\par
320             T {\cf17 const} invr = {\cf17 static_cast<}T{\cf17 >}(0.5) / r;\par
321             real.x = {\cf17 static_cast<}T{\cf17 >}(0.5)*r;\par
322             real.y = (x[1].x + x[0].y) * invr;\par
323             real.z = (x[0].z + x[2].x) * invr;\par
324             real.w = (x[2].y - x[1].z) * invr;\par
325         \}\par
326         {\cf19 else} {\cf19 if}(x[1].y > x[2].z)\par
327         \{\par
328             T {\cf17 const} r = sqrt(T(1) + x[1].y - x[0].x - x[2].z);\par
329             T {\cf17 const} invr = {\cf17 static_cast<}T{\cf17 >}(0.5) / r;\par
330             real.x = (x[1].x + x[0].y) * invr;\par
331             real.y = {\cf17 static_cast<}T{\cf17 >}(0.5) * r;\par
332             real.z = (x[2].y + x[1].z) * invr;\par
333             real.w = (x[0].z - x[2].x) * invr;\par
334         \}\par
335         {\cf19 else}\par
336         \{\par
337             T {\cf17 const} r = sqrt(T(1) + x[2].z - x[0].x - x[1].y);\par
338             T {\cf17 const} invr = {\cf17 static_cast<}T{\cf17 >}(0.5) / r;\par
339             real.x = (x[0].z + x[2].x) * invr;\par
340             real.y = (x[2].y + x[1].z) * invr;\par
341             real.z = {\cf17 static_cast<}T{\cf17 >}(0.5) * r;\par
342             real.w = (x[1].x - x[0].y) * invr;\par
343         \}\par
344 \par
345         qua<T, Q> dual;\par
346         dual.x =  {\cf17 static_cast<}T{\cf17 >}(0.5) * ( x[0].w * real.w + x[1].w * real.z - x[2].w * real.y);\par
347         dual.y =  {\cf17 static_cast<}T{\cf17 >}(0.5) * (-x[0].w * real.z + x[1].w * real.w + x[2].w * real.x);\par
348         dual.z =  {\cf17 static_cast<}T{\cf17 >}(0.5) * ( x[0].w * real.y - x[1].w * real.x + x[2].w * real.w);\par
349         dual.w = -{\cf17 static_cast<}T{\cf17 >}(0.5) * ( x[0].w * real.x + x[1].w * real.y + x[2].w * real.z);\par
350         {\cf19 return} tdualquat<T, Q>(real, dual);\par
351     \}\par
352 \}{\cf20 //namespace glm}\par
