232     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
233     GLM_FUNC_QUALIFIER tdualquat<T, Q> lerp(tdualquat<T, Q> {\cf17 const}& x, tdualquat<T, Q> {\cf17 const}& y, T {\cf17 const}& a)\par
234     \{\par
235         {\cf20 // Dual Quaternion Linear blend aka DLB:}\par
236         {\cf20 // Lerp is only defined in [0, 1]}\par
237         assert(a >= {\cf17 static_cast<}T{\cf17 >}(0));\par
238         assert(a <= {\cf17 static_cast<}T{\cf17 >}(1));\par
239         T {\cf17 const} k = dot(x.real,y.real) < {\cf17 static_cast<}T{\cf17 >}(0) ? -a : a;\par
240         T {\cf17 const} one(1);\par
241         {\cf19 return} tdualquat<T, Q>(x * (one - a) + y * k);\par
242     \}\par
