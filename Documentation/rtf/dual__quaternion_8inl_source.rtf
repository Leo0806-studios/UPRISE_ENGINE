60             T(+0.5) * ( p.x*q.w + p.y*q.z - p.z*q.y),\par
61             T(+0.5) * (-p.x*q.z + p.y*q.w + p.z*q.x),\par
62             T(+0.5) * ( p.x*q.y - p.y*q.x + p.z*q.w)))\par
63     \{\}\par
