418     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
419     GLM_FUNC_QUALIFIER GLM_CONSTEXPR mat<4, 4, T, Q> operator*(mat<2, 4, T, Q> {\cf17 const}& m1, mat<4, 2, T, Q> {\cf17 const}& m2)\par
420     \{\par
421         T SrcA00 = m1[0][0];\par
422         T SrcA01 = m1[0][1];\par
423         T SrcA02 = m1[0][2];\par
424         T SrcA03 = m1[0][3];\par
425         T SrcA10 = m1[1][0];\par
426         T SrcA11 = m1[1][1];\par
427         T SrcA12 = m1[1][2];\par
428         T SrcA13 = m1[1][3];\par
429 \par
430         T SrcB00 = m2[0][0];\par
431         T SrcB01 = m2[0][1];\par
432         T SrcB10 = m2[1][0];\par
433         T SrcB11 = m2[1][1];\par
434         T SrcB20 = m2[2][0];\par
435         T SrcB21 = m2[2][1];\par
436         T SrcB30 = m2[3][0];\par
437         T SrcB31 = m2[3][1];\par
438 \par
439         mat<4, 4, T, Q> Result;\par
440         Result[0][0] = SrcA00 * SrcB00 + SrcA10 * SrcB01;\par
441         Result[0][1] = SrcA01 * SrcB00 + SrcA11 * SrcB01;\par
442         Result[0][2] = SrcA02 * SrcB00 + SrcA12 * SrcB01;\par
443         Result[0][3] = SrcA03 * SrcB00 + SrcA13 * SrcB01;\par
444         Result[1][0] = SrcA00 * SrcB10 + SrcA10 * SrcB11;\par
445         Result[1][1] = SrcA01 * SrcB10 + SrcA11 * SrcB11;\par
446         Result[1][2] = SrcA02 * SrcB10 + SrcA12 * SrcB11;\par
447         Result[1][3] = SrcA03 * SrcB10 + SrcA13 * SrcB11;\par
448         Result[2][0] = SrcA00 * SrcB20 + SrcA10 * SrcB21;\par
449         Result[2][1] = SrcA01 * SrcB20 + SrcA11 * SrcB21;\par
450         Result[2][2] = SrcA02 * SrcB20 + SrcA12 * SrcB21;\par
451         Result[2][3] = SrcA03 * SrcB20 + SrcA13 * SrcB21;\par
452         Result[3][0] = SrcA00 * SrcB30 + SrcA10 * SrcB31;\par
453         Result[3][1] = SrcA01 * SrcB30 + SrcA11 * SrcB31;\par
454         Result[3][2] = SrcA02 * SrcB30 + SrcA12 * SrcB31;\par
455         Result[3][3] = SrcA03 * SrcB30 + SrcA13 * SrcB31;\par
456         {\cf19 return} Result;\par
457     \}\par
