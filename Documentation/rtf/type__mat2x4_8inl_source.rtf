478             m1[0][1] * m2[0][0] + m1[1][1] * m2[0][1],\par
479             m1[0][2] * m2[0][0] + m1[1][2] * m2[0][1],\par
480             m1[0][3] * m2[0][0] + m1[1][3] * m2[0][1],\par
481             m1[0][0] * m2[1][0] + m1[1][0] * m2[1][1],\par
482             m1[0][1] * m2[1][0] + m1[1][1] * m2[1][1],\par
483             m1[0][2] * m2[1][0] + m1[1][2] * m2[1][1],\par
484             m1[0][3] * m2[1][0] + m1[1][3] * m2[1][1],\par
485             m1[0][0] * m2[2][0] + m1[1][0] * m2[2][1],\par
486             m1[0][1] * m2[2][0] + m1[1][1] * m2[2][1],\par
487             m1[0][2] * m2[2][0] + m1[1][2] * m2[2][1],\par
488             m1[0][3] * m2[2][0] + m1[1][3] * m2[2][1]);\par
489     \}\par
490 \par
491     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
492     GLM_FUNC_QUALIFIER GLM_CONSTEXPR mat<2, 4, T, Q> operator/(mat<2, 4, T, Q> {\cf17 const}& m, T scalar)\par
493     \{\par
494         {\cf19 return} mat<2, 4, T, Q>(\par
495             m[0] / scalar,\par
496             m[1] / scalar);\par
497     \}\par
