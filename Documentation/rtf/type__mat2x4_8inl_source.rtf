461     \{\par
462         {\cf19 return} mat<2, 4, T, Q>(\par
463             m1[0][0] * m2[0][0] + m1[1][0] * m2[0][1],\par
464             m1[0][1] * m2[0][0] + m1[1][1] * m2[0][1],\par
465             m1[0][2] * m2[0][0] + m1[1][2] * m2[0][1],\par
466             m1[0][3] * m2[0][0] + m1[1][3] * m2[0][1],\par
467             m1[0][0] * m2[1][0] + m1[1][0] * m2[1][1],\par
468             m1[0][1] * m2[1][0] + m1[1][1] * m2[1][1],\par
469             m1[0][2] * m2[1][0] + m1[1][2] * m2[1][1],\par
470             m1[0][3] * m2[1][0] + m1[1][3] * m2[1][1]);\par
471     \}\par
