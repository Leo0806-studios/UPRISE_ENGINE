{\xe \v GetOrphanedScene\:Assimp::Importer}
{\xe \v Assimp::Importer\:GetOrphanedScene}
\pard\plain \s4\sb240\sa60\keepn\widctlpar\adjustright \b\f1\fs20\cgrid {
