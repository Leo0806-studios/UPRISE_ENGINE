00009      Shader::Shader({\cf17 const} {\cf18 char}* vertexPath, {\cf17 const} {\cf18 char}* fragmentPath)\par
00010     \{\par
00011         {\cf20 // 1. retrieve the vertex/fragment source code from filePath}\par
00012         std::string vertexCode;\par
00013         std::string fragmentCode;\par
00014         std::ifstream vShaderFile;\par
00015         std::ifstream fShaderFile;\par
00016         {\cf20 // ensure ifstream objects can throw exceptions:}\par
00017         vShaderFile.exceptions(std::ifstream::failbit | std::ifstream::badbit);\par
00018         fShaderFile.exceptions(std::ifstream::failbit | std::ifstream::badbit);\par
00019         {\cf19 try}\par
00020         \{\par
00021             {\cf20 // open files}\par
00022             vShaderFile.open(vertexPath);\par
00023             fShaderFile.open(fragmentPath);\par
00024             std::stringstream vShaderStream, fShaderStream;\par
00025             {\cf20 // read file's buffer contents into streams}\par
00026             vShaderStream << vShaderFile.rdbuf();\par
00027             fShaderStream << fShaderFile.rdbuf();\par
00028             {\cf20 // close file handlers}\par
00029             vShaderFile.close();\par
00030             fShaderFile.close();\par
00031             {\cf20 // convert stream into string}\par
00032             vertexCode = vShaderStream.str();\par
00033             fragmentCode = fShaderStream.str();\par
00034         \}\par
00035         {\cf19 catch} (std::ifstream::failure& e)\par
00036         \{\par
00037             std::cout << {\cf22 "ERROR::SHADER::FILE_NOT_SUCCESSFULLY_READ: "} << e.what() << std::endl;\par
00038         \}\par
00039         {\cf17 const} {\cf18 char}* vShaderCode = vertexCode.c_str();\par
00040         {\cf17 const} {\cf18 char}* fShaderCode = fragmentCode.c_str();\par
00041         {\cf20 // 2. compile shaders}\par
00042         {\cf18 unsigned} {\cf18 int} vertex, fragment;\par
00043         {\cf20 // vertex shader}\par
00044         vertex = glCreateShader(GL_VERTEX_SHADER);\par
00045         glShaderSource(vertex, 1, &vShaderCode, NULL);\par
00046         glCompileShader(vertex);\par
00047         checkCompileErrors(vertex, {\cf22 "VERTEX"});\par
00048         {\cf20 // fragment Shader}\par
00049         fragment = glCreateShader(GL_FRAGMENT_SHADER);\par
00050         glShaderSource(fragment, 1, &fShaderCode, NULL);\par
00051         glCompileShader(fragment);\par
00052         checkCompileErrors(fragment, {\cf22 "FRAGMENT"});\par
00053         {\cf20 // shader Program}\par
00054         ID = glCreateProgram();\par
00055         glAttachShader(ID, vertex);\par
00056         glAttachShader(ID, fragment);\par
00057         glLinkProgram(ID);\par
00058         checkCompileErrors(ID, {\cf22 "PROGRAM"});\par
00059         {\cf20 // delete the shaders as they're linked into our program now and no longer necessary}\par
00060         glDeleteShader(vertex);\par
00061         glDeleteShader(fragment);\par
00062 \par
00063     \}\par
