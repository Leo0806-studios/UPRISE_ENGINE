00069          {\cf20 // 2. compile shaders}\par
00070          {\cf18 unsigned} {\cf18 int} vertex, fragment;\par
00071          {\cf20 // vertex shader}\par
00072          vertex = glCreateShader(GL_VERTEX_SHADER);\par
00073          glShaderSource(vertex, 1, &vShaderCode, NULL);\par
