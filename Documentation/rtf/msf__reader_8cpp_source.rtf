00071     {\cf19 for} (uint32_t i = 0, j = 0; i < num_root_pages; i++)\par
00072     \{\par
00073         _file_stream.seekg(root_pages[i] * _page_size);\par
00074 \par
00075         {\cf19 if} (i == 0)\par
00076         \{\par
00077             _file_stream.read({\cf17 reinterpret_cast<}{\cf18 char} *{\cf17 >}(&j), {\cf17 sizeof}(j));\par
00078             _streams.reserve(j);\par
00079         \}\par
00080 \par
00081         {\cf19 for} (uint32_t k = i == 0, size; j > 0 && k < _page_size / 4; k++, j--)\par
00082         \{\par
00083             _file_stream.read({\cf17 reinterpret_cast<}{\cf18 char} *{\cf17 >}(&size), {\cf17 sizeof}(size));\par
00084             {\cf19 if} (0xFFFFFFFF == size)\par
00085                 size = 0;\par
00086             _streams.push_back(\{ size \});\par
00087         \}\par
00088 \par
00089         {\cf19 if} (j == 0)\par
00090         \{\par
00091             current_root_page = i;\par
00092             {\cf19 break};\par
00093         \}\par
00094     \}\par
00095 \par
00096     {\cf20 // Read content stream page indices (located directly after stream sizes)}\par
00097     {\cf19 for} (content_stream &stream : _streams)\par
00098     \{\par
00099         uint32_t num_pages = calc_page_count(stream.size, _page_size);\par
00100         {\cf19 if} (num_pages == 0)\par
00101             {\cf19 continue};\par
00102 \par
00103         stream.page_indices.resize(num_pages);\par
00104 \par
00105         {\cf19 for} (uint32_t num_pages_remaining = num_pages; num_pages_remaining > 0;)\par
00106         \{\par
00107             {\cf17 const} {\cf17 auto} page_off = {\cf17 static_cast<}uint32_t{\cf17 >}(_file_stream.tellg()) % _page_size;\par
00108             {\cf17 const} {\cf17 auto} page_size = std::min(num_pages_remaining * 4, _page_size - page_off);\par
00109 \par
00110             _file_stream.read({\cf17 reinterpret_cast<}{\cf18 char} *{\cf17 >}(stream.page_indices.data() + num_pages - num_pages_remaining), page_size);\par
00111 \par
00112             num_pages_remaining -= page_size / 4;\par
00113 \par
00114             {\cf20 // Advance to next root page}\par
00115             {\cf19 if} (page_off + page_size == _page_size)\par
00116                 _file_stream.seekg(root_pages[++current_root_page] * _page_size);\par
00117         \}\par
00118     \}\par
00119 \par
00120     _is_valid = _file_stream.good();\par
00121 \}\par
00122 \par
00123 std::vector<char> blink::msf_reader::stream({\cf18 size_t} index)\par
00124 \{\par
00125     {\cf17 const} content_stream &stream = _streams[index];\par
00126 \par
00127     {\cf18 size_t} offset = 0;\par
00128     std::vector<char> stream_data( {\cf20 // Allocate enough memory to hold all associated pages}\par
00129         stream.page_indices.size() * _page_size);\par
00130 \par
00131     {\cf20 // Iterate through all pages associated with this stream and read their data}\par
00132     {\cf19 for} (uint32_t page_index : stream.page_indices)\par
00133     \{\par
00134         _file_stream.seekg(page_index * _page_size);\par
00135         _file_stream.read(stream_data.data() + offset, _page_size);\par
00136 \par
00137         offset += _page_size;\par
00138     \}\par
00139 \par
00140     {\cf20 // Shrink result to the actual stream size}\par
00141     stream_data.resize(stream.size);\par
00142 \par
00143     {\cf19 return} stream_data;\par
00144 \}\par
