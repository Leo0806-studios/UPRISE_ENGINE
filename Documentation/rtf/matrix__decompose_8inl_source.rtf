58         {\cf19 if}(\par
59             epsilonNotEqual(LocalMatrix[0][3], {\cf17 static_cast<}T{\cf17 >}(0), epsilon<T>()) ||\par
60             epsilonNotEqual(LocalMatrix[1][3], {\cf17 static_cast<}T{\cf17 >}(0), epsilon<T>()) ||\par
61             epsilonNotEqual(LocalMatrix[2][3], {\cf17 static_cast<}T{\cf17 >}(0), epsilon<T>()))\par
62         \{\par
63             {\cf20 // rightHandSide is the right hand side of the equation.}\par
64             vec<4, T, Q> RightHandSide;\par
65             RightHandSide[0] = LocalMatrix[0][3];\par
66             RightHandSide[1] = LocalMatrix[1][3];\par
67             RightHandSide[2] = LocalMatrix[2][3];\par
68             RightHandSide[3] = LocalMatrix[3][3];\par
69 \par
70             {\cf20 // Solve the equation by inverting PerspectiveMatrix and multiplying}\par
71             {\cf20 // rightHandSide by the inverse.  (This is the easiest way, not}\par
72             {\cf20 // necessarily the best.)}\par
73             mat<4, 4, T, Q> InversePerspectiveMatrix = glm::inverse(PerspectiveMatrix);{\cf20 //   inverse(PerspectiveMatrix, inversePerspectiveMatrix);}\par
74             mat<4, 4, T, Q> TransposedInversePerspectiveMatrix = glm::transpose(InversePerspectiveMatrix);{\cf20 //   transposeMatrix4(inversePerspectiveMatrix, transposedInversePerspectiveMatrix);}\par
75 \par
76             Perspective = TransposedInversePerspectiveMatrix * RightHandSide;\par
77             {\cf20 //  v4MulPointByMatrix(rightHandSide, transposedInversePerspectiveMatrix, perspectivePoint);}\par
78 \par
79             {\cf20 // Clear the perspective partition}\par
80             LocalMatrix[0][3] = LocalMatrix[1][3] = LocalMatrix[2][3] = {\cf17 static_cast<}T{\cf17 >}(0);\par
81             LocalMatrix[3][3] = {\cf17 static_cast<}T{\cf17 >}(1);\par
82         \}\par
83         {\cf19 else}\par
84         \{\par
85             {\cf20 // No perspective.}\par
86             Perspective = vec<4, T, Q>(0, 0, 0, 1);\par
87         \}\par
88 \par
89         {\cf20 // Next take care of translation (easy).}\par
90         Translation = vec<3, T, Q>(LocalMatrix[3]);\par
91         LocalMatrix[3] = vec<4, T, Q>(0, 0, 0, LocalMatrix[3].w);\par
92 \par
93         vec<3, T, Q> Row[3], Pdum3;\par
94 \par
95         {\cf20 // Now get scale and shear.}\par
96         {\cf19 for}(length_t i = 0; i < 3; ++i)\par
97         {\cf19 for}(length_t j = 0; j < 3; ++j)\par
98             Row[i][j] = LocalMatrix[i][j];\par
99 \par
100         {\cf20 // Compute X scale factor and normalize first row.}\par
101         Scale.x = length(Row[0]);{\cf20 // v3Length(Row[0]);}\par
102 \par
103         Row[0] = detail::scale(Row[0], {\cf17 static_cast<}T{\cf17 >}(1));\par
104 \par
105         {\cf20 // Compute XY shear factor and make 2nd row orthogonal to 1st.}\par
106         Skew.z = dot(Row[0], Row[1]);\par
107         Row[1] = detail::combine(Row[1], Row[0], {\cf17 static_cast<}T{\cf17 >}(1), -Skew.z);\par
108 \par
109         {\cf20 // Now, compute Y scale and normalize 2nd row.}\par
110         Scale.y = length(Row[1]);\par
111         Row[1] = detail::scale(Row[1], {\cf17 static_cast<}T{\cf17 >}(1));\par
112         Skew.z /= Scale.y;\par
113 \par
114         {\cf20 // Compute XZ and YZ shears, orthogonalize 3rd row.}\par
115         Skew.y = glm::dot(Row[0], Row[2]);\par
116         Row[2] = detail::combine(Row[2], Row[0], {\cf17 static_cast<}T{\cf17 >}(1), -Skew.y);\par
117         Skew.x = glm::dot(Row[1], Row[2]);\par
118         Row[2] = detail::combine(Row[2], Row[1], {\cf17 static_cast<}T{\cf17 >}(1), -Skew.x);\par
119 \par
120         {\cf20 // Next, get Z scale and normalize 3rd row.}\par
121         Scale.z = length(Row[2]);\par
122         Row[2] = detail::scale(Row[2], {\cf17 static_cast<}T{\cf17 >}(1));\par
123         Skew.y /= Scale.z;\par
124         Skew.x /= Scale.z;\par
125 \par
126         {\cf20 // At this point, the matrix (in rows[]) is orthonormal.}\par
127         {\cf20 // Check for a coordinate system flip.  If the determinant}\par
128         {\cf20 // is -1, then negate the matrix and the scaling factors.}\par
129         Pdum3 = cross(Row[1], Row[2]); {\cf20 // v3Cross(row[1], row[2], Pdum3);}\par
130         {\cf19 if}(dot(Row[0], Pdum3) < 0)\par
131         \{\par
132             {\cf19 for}(length_t i = 0; i < 3; i++)\par
133             \{\par
134                 Scale[i] *= {\cf17 static_cast<}T{\cf17 >}(-1);\par
135                 Row[i] *= {\cf17 static_cast<}T{\cf17 >}(-1);\par
136             \}\par
137         \}\par
138 \par
139         {\cf20 // Now, get the rotations out, as described in the gem.}\par
140 \par
141         {\cf20 // FIXME - Add the ability to return either quaternions (which are}\par
142         {\cf20 // easier to recompose with) or Euler angles (rx, ry, rz), which}\par
143         {\cf20 // are easier for authors to deal with. The latter will only be useful}\par
144         {\cf20 // when we fix https://bugs.webkit.org/show_bug.cgi?id=23799, so I}\par
145         {\cf20 // will leave the Euler angle code here for now.}\par
146 \par
147         {\cf20 // ret.rotateY = asin(-Row[0][2]);}\par
148         {\cf20 // if (cos(ret.rotateY) != 0) \{}\par
149         {\cf20 //     ret.rotateX = atan2(Row[1][2], Row[2][2]);}\par
150         {\cf20 //     ret.rotateZ = atan2(Row[0][1], Row[0][0]);}\par
151         {\cf20 // \} else \{}\par
152         {\cf20 //     ret.rotateX = atan2(-Row[2][0], Row[1][1]);}\par
153         {\cf20 //     ret.rotateZ = 0;}\par
154         {\cf20 // \}}\par
155 \par
156         {\cf18 int} i, j, k = 0;\par
157         T root, trace = Row[0].x + Row[1].y + Row[2].z;\par
158         {\cf19 if}(trace > {\cf17 static_cast<}T{\cf17 >}(0))\par
159         \{\par
160             root = sqrt(trace + {\cf17 static_cast<}T{\cf17 >}(1.0));\par
161             Orientation.w = {\cf17 static_cast<}T{\cf17 >}(0.5) * root;\par
162             root = {\cf17 static_cast<}T{\cf17 >}(0.5) / root;\par
163             Orientation.x = root * (Row[1].z - Row[2].y);\par
164             Orientation.y = root * (Row[2].x - Row[0].z);\par
165             Orientation.z = root * (Row[0].y - Row[1].x);\par
166         \} {\cf20 // End if > 0}\par
167         {\cf19 else}\par
168         \{\par
169             {\cf17 static} {\cf18 int} Next[3] = \{1, 2, 0\};\par
170             i = 0;\par
171             {\cf19 if}(Row[1].y > Row[0].x) i = 1;\par
172             {\cf19 if}(Row[2].z > Row[i][i]) i = 2;\par
173             j = Next[i];\par
174             k = Next[j];\par
175 \par
176 {\cf21 #           ifdef GLM_FORCE_QUAT_DATA_WXYZ}\par
177                 {\cf18 int} off = 1;\par
178 {\cf21 #           else}\par
179                 {\cf18 int} off = 0;\par
180 {\cf21 #           endif}\par
181 \par
182             root = sqrt(Row[i][i] - Row[j][j] - Row[k][k] + {\cf17 static_cast<}T{\cf17 >}(1.0));\par
183 \par
184             Orientation[i + off] = {\cf17 static_cast<}T{\cf17 >}(0.5) * root;\par
185             root = {\cf17 static_cast<}T{\cf17 >}(0.5) / root;\par
186             Orientation[j + off] = root * (Row[i][j] + Row[j][i]);\par
187             Orientation[k + off] = root * (Row[i][k] + Row[k][i]);\par
188             Orientation.w = root * (Row[j][k] - Row[k][j]);\par
189         \} {\cf20 // End if <= 0}\par
190 \par
191         {\cf19 return} {\cf17 true};\par
192     \}\par
193 \par
194     {\cf20 // Recomposes a model matrix from a previously-decomposed matrix}\par
195     {\cf20 // http://www.opensource.apple.com/source/WebCore/WebCore-514/platform/graphics/transforms/TransformationMatrix.cpp}\par
196     {\cf20 // https://stackoverflow.com/a/75573092/1047040}\par
197     {\cf17 template} <{\cf17 typename} T, qualifier Q>\par
198     GLM_FUNC_DECL mat<4, 4, T, Q> recompose(\par
199         vec<3, T, Q> {\cf17 const}& scale, qua<T, Q> {\cf17 const}& orientation, vec<3, T, Q> {\cf17 const}& translation,\par
200         vec<3, T, Q> {\cf17 const}& skew, vec<4, T, Q> {\cf17 const}& perspective)\par
201     \{\par
202         glm::mat4 m = glm::mat4(1.f);\par
203 \par
204         m[0][3] = perspective.x;\par
205         m[1][3] = perspective.y;\par
206         m[2][3] = perspective.z;\par
207         m[3][3] = perspective.w;\par
208 \par
209         m *= glm::translate(translation);\par
210         m *= glm::mat4_cast(orientation);\par
211 \par
212         {\cf19 if} (abs(skew.x) > {\cf17 static_cast<}T{\cf17 >}(0)) \{\par
213             glm::mat4 tmp(1.f);\par
214             tmp[2][1] = skew.x;\par
215             m *= tmp;\par
216         \}\par
217 \par
218         {\cf19 if} (abs(skew.y) > {\cf17 static_cast<}T{\cf17 >}(0)) \{\par
219             glm::mat4 tmp(1.f);\par
220             tmp[2][0] = skew.y;\par
221             m *= tmp;\par
222         \}\par
223 \par
224         {\cf19 if} (abs(skew.z) > {\cf17 static_cast<}T{\cf17 >}(0)) \{\par
225             glm::mat4 tmp(1.f);\par
226             tmp[1][0] = skew.z;\par
227             m *= tmp;\par
228         \}\par
229 \par
230         m *= glm::scale(scale);\par
231 \par
232         {\cf19 return} m;\par
233     \}\par
234 \}{\cf20 //namespace glm}\par
}
