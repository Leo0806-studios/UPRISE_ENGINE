289     {\cf17 template}<{\cf17 typename} T>\par
290     GLM_FUNC_QUALIFIER vec<3, T, defaultp> sphericalRand(T Radius)\par
291     \{\par
292         assert(Radius > {\cf17 static_cast<}T{\cf17 >}(0));\par
293 \par
294         T theta = linearRand(T(0), T(6.283185307179586476925286766559f));\par
295         T phi = std::acos(linearRand(T(-1.0f), T(1.0f)));\par
296 \par
297         T x = std::sin(phi) * std::cos(theta);\par
298         T y = std::sin(phi) * std::sin(theta);\par
299         T z = std::cos(phi);\par
300 \par
301         {\cf19 return} vec<3, T, defaultp>(x, y, z) * Radius;\par
302     \}\par
