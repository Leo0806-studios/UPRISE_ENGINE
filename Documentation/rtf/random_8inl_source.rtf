218     {\cf17 template}<{\cf17 typename} genType>\par
219     GLM_FUNC_QUALIFIER genType gaussRand(genType Mean, genType Deviation)\par
220     \{\par
221         genType w, x1, x2;\par
222 \par
223         {\cf19 do}\par
224         \{\par
225             x1 = linearRand(genType(-1), genType(1));\par
226             x2 = linearRand(genType(-1), genType(1));\par
227 \par
228             w = x1 * x1 + x2 * x2;\par
229         \} {\cf19 while}(w > genType(1));\par
230 \par
231         {\cf19 return} {\cf17 static_cast<}genType{\cf17 >}(x2 * Deviation * Deviation * sqrt((genType(-2) * log(w)) / w) + Mean);\par
232     \}\par
