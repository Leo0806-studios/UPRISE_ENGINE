662         Alpha = ceil(Alpha * {\cf17 static_cast<}T{\cf17 >}(255.0)) / {\cf17 static_cast<}T{\cf17 >}(255.0);\par
663         {\cf19 return} vec<4, T, Q>(Color / Alpha, Alpha);\par
