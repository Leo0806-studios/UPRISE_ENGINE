632         {\cf18 float} {\cf17 const} MaxColor = max(Color.x, max(Color.y, Color.z));\par
633 \par
634         {\cf18 float} {\cf17 const} ExpSharedP = max(-15.f - 1.f, floor(log2(MaxColor))) + 1.0f + 15.f;\par
635         {\cf18 float} {\cf17 const} MaxShared = floor(MaxColor / pow(2.0f, (ExpSharedP - 15.f - 9.f)) + 0.5f);\par
636         {\cf18 float} {\cf17 const} ExpShared = equal(MaxShared, pow(2.0f, 9.0f), epsilon<float>()) ? ExpSharedP + 1.0f : ExpSharedP;\par
637 \par
638         uvec3 {\cf17 const} ColorComp(floor(Color / pow(2.f, (ExpShared - 15.f - 9.f)) + 0.5f));\par
639 \par
640         detail::u9u9u9e5 Unpack;\par
641         Unpack.data.x = ColorComp.x;\par
642         Unpack.data.y = ColorComp.y;\par
643         Unpack.data.z = ColorComp.z;\par
644         Unpack.data.w = uint(ExpShared);\par
645         {\cf19 return} Unpack.pack;\par
646     \}\par
