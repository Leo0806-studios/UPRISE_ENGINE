00237             det = neon::madd_lane(det, r2, m0, 2);\par
00238             det = neon::madd_lane(det, r3, m0, 3);\par
00239 \par
00240             float32x4_t rdet = vdupq_n_f32(1 / vgetq_lane_f32(det, 0));\par
00241 \par
00242             mat<4, 4, float, Q> r;\par
00243             r[0].data = vmulq_f32(r0, rdet);\par
00244             r[1].data = vmulq_f32(r1, rdet);\par
00245             r[2].data = vmulq_f32(r2, rdet);\par
00246             r[3].data = vmulq_f32(r3, rdet);\par
00247             {\cf19 return} r;\par
00248         \}\par
00249     \};\par
