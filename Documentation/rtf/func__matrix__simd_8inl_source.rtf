00124 {\cf17 namespace }detail\par
00125 \{\par
00126     {\cf17 template}<qualifier Q>\par
00127     {\cf17 struct }compute_inverse<4, 4, float, Q, true>\par
00128     \{\par
00129         GLM_FUNC_QUALIFIER {\cf17 static} mat<4, 4, float, Q> call(mat<4, 4, float, Q> {\cf17 const}& m)\par
00130         \{\par
00131             float32x4_t {\cf17 const}& m0 = m[0].data;\par
00132             float32x4_t {\cf17 const}& m1 = m[1].data;\par
00133             float32x4_t {\cf17 const}& m2 = m[2].data;\par
00134             float32x4_t {\cf17 const}& m3 = m[3].data;\par
00135 \par
00136             {\cf20 // m[2][2] * m[3][3] - m[3][2] * m[2][3];}\par
00137             {\cf20 // m[2][2] * m[3][3] - m[3][2] * m[2][3];}\par
00138             {\cf20 // m[1][2] * m[3][3] - m[3][2] * m[1][3];}\par
00139             {\cf20 // m[1][2] * m[2][3] - m[2][2] * m[1][3];}\par
00140 \par
00141             float32x4_t Fac0;\par
00142             \{\par
00143                 float32x4_t w0 = vcombine_f32(neon::dup_lane(m2, 2), neon::dup_lane(m1, 2));\par
00144                 float32x4_t w1 = neon::copy_lane(neon::dupq_lane(m3, 3), 3, m2, 3);\par
00145                 float32x4_t w2 = neon::copy_lane(neon::dupq_lane(m3, 2), 3, m2, 2);\par
00146                 float32x4_t w3 = vcombine_f32(neon::dup_lane(m2, 3), neon::dup_lane(m1, 3));\par
00147                 Fac0 = w0 * w1 -  w2 * w3;\par
00148             \}\par
00149 \par
00150             {\cf20 // m[2][1] * m[3][3] - m[3][1] * m[2][3];}\par
00151             {\cf20 // m[2][1] * m[3][3] - m[3][1] * m[2][3];}\par
00152             {\cf20 // m[1][1] * m[3][3] - m[3][1] * m[1][3];}\par
00153             {\cf20 // m[1][1] * m[2][3] - m[2][1] * m[1][3];}\par
00154 \par
00155             float32x4_t Fac1;\par
00156             \{\par
00157                 float32x4_t w0 = vcombine_f32(neon::dup_lane(m2, 1), neon::dup_lane(m1, 1));\par
00158                 float32x4_t w1 = neon::copy_lane(neon::dupq_lane(m3, 3), 3, m2, 3);\par
00159                 float32x4_t w2 = neon::copy_lane(neon::dupq_lane(m3, 1), 3, m2, 1);\par
00160                 float32x4_t w3 = vcombine_f32(neon::dup_lane(m2, 3), neon::dup_lane(m1, 3));\par
00161                 Fac1 = w0 * w1 - w2 * w3;\par
00162             \}\par
00163 \par
00164             {\cf20 // m[2][1] * m[3][2] - m[3][1] * m[2][2];}\par
00165             {\cf20 // m[2][1] * m[3][2] - m[3][1] * m[2][2];}\par
00166             {\cf20 // m[1][1] * m[3][2] - m[3][1] * m[1][2];}\par
00167             {\cf20 // m[1][1] * m[2][2] - m[2][1] * m[1][2];}\par
00168 \par
00169             float32x4_t Fac2;\par
00170             \{\par
00171                 float32x4_t w0 = vcombine_f32(neon::dup_lane(m2, 1), neon::dup_lane(m1, 1));\par
00172                 float32x4_t w1 = neon::copy_lane(neon::dupq_lane(m3, 2), 3, m2, 2);\par
00173                 float32x4_t w2 = neon::copy_lane(neon::dupq_lane(m3, 1), 3, m2, 1);\par
00174                 float32x4_t w3 = vcombine_f32(neon::dup_lane(m2, 2), neon::dup_lane(m1, 2));\par
00175                 Fac2 = w0 * w1 - w2 * w3;\par
00176             \}\par
00177 \par
00178             {\cf20 // m[2][0] * m[3][3] - m[3][0] * m[2][3];}\par
00179             {\cf20 // m[2][0] * m[3][3] - m[3][0] * m[2][3];}\par
00180             {\cf20 // m[1][0] * m[3][3] - m[3][0] * m[1][3];}\par
00181             {\cf20 // m[1][0] * m[2][3] - m[2][0] * m[1][3];}\par
00182 \par
00183             float32x4_t Fac3;\par
00184             \{\par
00185                 float32x4_t w0 = vcombine_f32(neon::dup_lane(m2, 0), neon::dup_lane(m1, 0));\par
00186                 float32x4_t w1 = neon::copy_lane(neon::dupq_lane(m3, 3), 3, m2, 3);\par
00187                 float32x4_t w2 = neon::copy_lane(neon::dupq_lane(m3, 0), 3, m2, 0);\par
00188                 float32x4_t w3 = vcombine_f32(neon::dup_lane(m2, 3), neon::dup_lane(m1, 3));\par
00189                 Fac3 = w0 * w1 - w2 * w3;\par
00190             \}\par
00191 \par
00192             {\cf20 // m[2][0] * m[3][2] - m[3][0] * m[2][2];}\par
00193             {\cf20 // m[2][0] * m[3][2] - m[3][0] * m[2][2];}\par
00194             {\cf20 // m[1][0] * m[3][2] - m[3][0] * m[1][2];}\par
00195             {\cf20 // m[1][0] * m[2][2] - m[2][0] * m[1][2];}\par
00196 \par
00197             float32x4_t Fac4;\par
00198             \{\par
00199                 float32x4_t w0 = vcombine_f32(neon::dup_lane(m2, 0), neon::dup_lane(m1, 0));\par
00200                 float32x4_t w1 = neon::copy_lane(neon::dupq_lane(m3, 2), 3, m2, 2);\par
00201                 float32x4_t w2 = neon::copy_lane(neon::dupq_lane(m3, 0), 3, m2, 0);\par
00202                 float32x4_t w3 = vcombine_f32(neon::dup_lane(m2, 2), neon::dup_lane(m1, 2));\par
00203                 Fac4 = w0 * w1 - w2 * w3;\par
00204             \}\par
00205 \par
00206             {\cf20 // m[2][0] * m[3][1] - m[3][0] * m[2][1];}\par
00207             {\cf20 // m[2][0] * m[3][1] - m[3][0] * m[2][1];}\par
00208             {\cf20 // m[1][0] * m[3][1] - m[3][0] * m[1][1];}\par
00209             {\cf20 // m[1][0] * m[2][1] - m[2][0] * m[1][1];}\par
00210 \par
00211             float32x4_t Fac5;\par
00212             \{\par
00213                 float32x4_t w0 = vcombine_f32(neon::dup_lane(m2, 0), neon::dup_lane(m1, 0));\par
00214                 float32x4_t w1 = neon::copy_lane(neon::dupq_lane(m3, 1), 3, m2, 1);\par
00215                 float32x4_t w2 = neon::copy_lane(neon::dupq_lane(m3, 0), 3, m2, 0);\par
00216                 float32x4_t w3 = vcombine_f32(neon::dup_lane(m2, 1), neon::dup_lane(m1, 1));\par
00217                 Fac5 = w0 * w1 - w2 * w3;\par
00218             \}\par
00219 \par
00220             float32x4_t Vec0 = neon::copy_lane(neon::dupq_lane(m0, 0), 0, m1, 0); {\cf20 // (m[1][0], m[0][0], m[0][0], m[0][0]);}\par
00221             float32x4_t Vec1 = neon::copy_lane(neon::dupq_lane(m0, 1), 0, m1, 1); {\cf20 // (m[1][1], m[0][1], m[0][1], m[0][1]);}\par
00222             float32x4_t Vec2 = neon::copy_lane(neon::dupq_lane(m0, 2), 0, m1, 2); {\cf20 // (m[1][2], m[0][2], m[0][2], m[0][2]);}\par
00223             float32x4_t Vec3 = neon::copy_lane(neon::dupq_lane(m0, 3), 0, m1, 3); {\cf20 // (m[1][3], m[0][3], m[0][3], m[0][3]);}\par
00224 \par
00225             float32x4_t Inv0 = Vec1 * Fac0 - Vec2 * Fac1 + Vec3 * Fac2;\par
00226             float32x4_t Inv1 = Vec0 * Fac0 - Vec2 * Fac3 + Vec3 * Fac4;\par
00227             float32x4_t Inv2 = Vec0 * Fac1 - Vec1 * Fac3 + Vec3 * Fac5;\par
00228             float32x4_t Inv3 = Vec0 * Fac2 - Vec1 * Fac4 + Vec2 * Fac5;\par
00229 \par
00230             float32x4_t r0 = float32x4_t\{-1, +1, -1, +1\} * Inv0;\par
00231             float32x4_t r1 = float32x4_t\{+1, -1, +1, -1\} * Inv1;\par
00232             float32x4_t r2 = float32x4_t\{-1, +1, -1, +1\} * Inv2;\par
00233             float32x4_t r3 = float32x4_t\{+1, -1, +1, -1\} * Inv3;\par
00234 \par
00235             float32x4_t det = neon::mul_lane(r0, m0, 0);\par
