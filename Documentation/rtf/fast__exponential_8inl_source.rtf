60 {\cf20         const float x2 = FloatPart * FloatPart;}\par
61 {\cf20         const float x3 = x2 * FloatPart;}\par
62 {\cf20         const float x4 = x3 * FloatPart;}\par
63 {\cf20         const float x5 = x4 * FloatPart;}\par
64 {\cf20         return z * (1.0f + FloatPart + (x2 * 0.5f) + (x3 * 0.1666666667f) + (x4 * 0.041666667f) + (x5 * 0.008333333333f));}\par
65 {\cf20     \}}\par
66 {\cf20 }\par
67 {\cf20     // Increase accuracy on number bigger that 1 and smaller than -1 but it's not enough for high and negative numbers}\par
68 {\cf20     GLM_FUNC_QUALIFIER float fastExp(float x)}\par
69 {\cf20     \{}\par
70 {\cf20         // This has a better looking and same performance in release mode than the following code. However, in debug mode it's slower.}\par
71 {\cf20         // return 1.0f + x * (1.0f + x * 0.5f * (1.0f + x * 0.3333333333f * (1.0f + x * 0.25 * (1.0f + x * 0.2f))));}\par
72 {\cf20         float x2 = x * x;}\par
73 {\cf20         float x3 = x2 * x;}\par
74 {\cf20         float x4 = x3 * x;}\par
75 {\cf20         float x5 = x4 * x;}\par
76 {\cf20         float x6 = x5 * x;}\par
77 {\cf20         float x7 = x6 * x;}\par
78 {\cf20         float x8 = x7 * x;}\par
79 {\cf20         return 1.0f + x + (x2 * 0.5f) + (x3 * 0.1666666667f) + (x4 * 0.041666667f) + (x5 * 0.008333333333f)+ (x6 * 0.00138888888888f) + (x7 * 0.000198412698f) + (x8 * 0.0000248015873f);;}\par
80 {\cf20     \}}\par
81 {\cf20     */}\par
82 \par
83     {\cf17 template}<length_t L, {\cf17 typename} T, qualifier Q>\par
84     GLM_FUNC_QUALIFIER vec<L, T, Q> fastExp(vec<L, T, Q> {\cf17 const}& x)\par
85     \{\par
86         {\cf19 return} detail::functor1<vec, L, T, T, Q>::call(fastExp, x);\par
87     \}\par
