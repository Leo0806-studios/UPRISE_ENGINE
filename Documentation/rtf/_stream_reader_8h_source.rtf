248     {\cf18 unsigned} {\cf18 int} SetReadLimit({\cf18 unsigned} {\cf18 int} _limit) \{\par
249         {\cf18 unsigned} {\cf18 int} prev = GetReadLimit();\par
250         {\cf19 if} (UINT_MAX == _limit) \{\par
251             mLimit = mEnd;\par
252             {\cf19 return} prev;\par
253         \}\par
254 \par
255         mLimit = mBuffer + _limit;\par
256         {\cf19 if} (mLimit > mEnd) \{\par
257             {\cf19 throw} DeadlyImportError({\cf22 "StreamReader: Invalid read limit"});\par
258         \}\par
259         {\cf19 return} prev;\par
260     \}\par
