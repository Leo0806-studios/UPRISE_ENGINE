214     {\cf18 void} SetPtr(int8_t *p) \{\par
215         mCurrent = p;\par
216         {\cf19 if} (mCurrent > mLimit || mCurrent < mBuffer) \{\par
217             {\cf19 throw} DeadlyImportError({\cf22 "End of file or read limit was reached"});\par
218         \}\par
