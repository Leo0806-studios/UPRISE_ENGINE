195     {\cf18 void} IncPtr(intptr_t plus) \{\par
196         mCurrent += plus;\par
197         {\cf19 if} (mCurrent > mLimit) \{\par
198             {\cf19 throw} DeadlyImportError({\cf22 "End of file or read limit was reached"});\par
