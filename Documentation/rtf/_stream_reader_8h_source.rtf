300 {\cf17 private}:\par
301     {\cf20 // ---------------------------------------------------------------------}\par
302     {\cf18 void} InternBegin() \{\par
303         {\cf19 if} ({\cf17 nullptr} == mStream) \{\par
304             {\cf19 throw} DeadlyImportError({\cf22 "StreamReader: Unable to open file"});\par
305         \}\par
306 \par
307         {\cf17 const} {\cf18 size_t} filesize = mStream->FileSize() - mStream->Tell();\par
308         {\cf19 if} (0 == filesize) \{\par
309             {\cf19 throw} DeadlyImportError({\cf22 "StreamReader: File is empty or EOF is already reached"});\par
310         \}\par
311 \par
312         mCurrent = mBuffer = {\cf17 new} int8_t[filesize];\par
313         {\cf17 const} {\cf18 size_t} read = mStream->Read(mCurrent, 1, filesize);\par
314         {\cf20 // (read < s) can only happen if the stream was opened in text mode, in which case FileSize() is not reliable}\par
315         ai_assert(read <= filesize);\par
316         mEnd = mLimit = &mBuffer[read - 1] + 1;\par
317     \}\par
318 \par
319 {\cf17 private}:\par
320     std::shared_ptr<IOStream> mStream;\par
321     int8_t *mBuffer;\par
322     int8_t *mCurrent;\par
323     int8_t *mEnd;\par
324     int8_t *mLimit;\par
325     {\cf18 bool} mLe;\par
326 \};\par
