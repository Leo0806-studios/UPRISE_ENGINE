278     {\cf17 template} <{\cf17 typename} T>\par
279     StreamReader &operator>>(T &f) \{\par
280         f = Get<T>();\par
281         {\cf19 return} *{\cf17 this};\par
282     \}\par
283 \par
284     {\cf20 // ---------------------------------------------------------------------}\par
286     {\cf17 template} <{\cf17 typename} T>\par
287     T Get() \{\par
288         {\cf19 if} (mCurrent + {\cf17 sizeof}(T) > mLimit) \{\par
289             {\cf19 throw} DeadlyImportError({\cf22 "End of file or stream limit was reached"});\par
290         \}\par
291 \par
292         T f;\par
293         ::memcpy(&f, mCurrent, {\cf17 sizeof}(T));\par
294         Intern::Getter<SwapEndianess, T, RuntimeSwitch>()(&f, mLe);\par
295         mCurrent += {\cf17 sizeof}(T);\par
296 \par
297         {\cf19 return} f;\par
298     \}\par
