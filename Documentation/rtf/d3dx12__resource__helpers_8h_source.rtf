399 \{\par
400     {\cf19 return} D3DX12ConditionallyExpandAPIDesc({\cf17 static_cast<}CD3DX12_RESOURCE_DESC1&{\cf17 >}(LclDesc), {\cf17 static_cast<}{\cf17 const }CD3DX12_RESOURCE_DESC1*{\cf17 >}(pDesc));\par
