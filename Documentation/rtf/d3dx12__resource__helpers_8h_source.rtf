404 {\cf20 //------------------------------------------------------------------------------------------------}\par
405 {\cf20 // The difference between D3DX12GetCopyableFootprints and ID3D12Device::GetCopyableFootprints}\par
406 {\cf20 // is that this one loses a lot of error checking by assuming the arguments are correct}\par
407 {\cf17 inline} {\cf18 bool} D3DX12GetCopyableFootprints(\par
408     _In_  {\cf17 const} D3D12_RESOURCE_DESC1& ResourceDesc,\par
409     _In_range_(0, D3D12_REQ_SUBRESOURCES) UINT FirstSubresource,\par
410     _In_range_(0, D3D12_REQ_SUBRESOURCES - FirstSubresource) UINT NumSubresources,\par
411     UINT64 BaseOffset,\par
412     _Out_writes_opt_(NumSubresources) D3D12_PLACED_SUBRESOURCE_FOOTPRINT* pLayouts,\par
413     _Out_writes_opt_(NumSubresources) UINT* pNumRows,\par
414     _Out_writes_opt_(NumSubresources) UINT64* pRowSizeInBytes,\par
415     _Out_opt_ UINT64* pTotalBytes)\par
416 \{\par
417     {\cf17 constexpr} UINT64 uint64_max = ~0ull;\par
418     UINT64 TotalBytes = uint64_max;\par
419     UINT uSubRes = 0;\par
420 \par
421     {\cf18 bool} bResourceOverflow = {\cf17 false};\par
422     TotalBytes = 0;\par
423 \par
424     {\cf17 const} DXGI_FORMAT Format = ResourceDesc.Format;\par
425 \par
426     CD3DX12_RESOURCE_DESC1 LresourceDesc;\par
427     {\cf17 const} CD3DX12_RESOURCE_DESC1& resourceDesc = *D3DX12ConditionallyExpandAPIDesc(LresourceDesc, &ResourceDesc);\par
428 \par
429     {\cf20 // Check if its a valid format}\par
430     D3DX12_ASSERT(D3D12_PROPERTY_LAYOUT_FORMAT_TABLE::FormatExists(Format));\par
431 \par
432     {\cf17 const} UINT WidthAlignment = D3D12_PROPERTY_LAYOUT_FORMAT_TABLE::GetWidthAlignment( Format );\par
433     {\cf17 const} UINT HeightAlignment = D3D12_PROPERTY_LAYOUT_FORMAT_TABLE::GetHeightAlignment( Format );\par
434     {\cf17 const} UINT16 DepthAlignment = UINT16( D3D12_PROPERTY_LAYOUT_FORMAT_TABLE::GetDepthAlignment( Format ) );\par
435 \par
436     {\cf19 for} (; uSubRes < NumSubresources; ++uSubRes)\par
437     \{\par
438         {\cf18 bool} bOverflow = {\cf17 false};\par
439         UINT Subresource = FirstSubresource + uSubRes;\par
440 \par
441         D3DX12_ASSERT(resourceDesc.MipLevels != 0);\par
442         UINT subresourceCount = resourceDesc.MipLevels * resourceDesc.ArraySize() * D3D12_PROPERTY_LAYOUT_FORMAT_TABLE::GetPlaneCount(resourceDesc.Format);\par
443 \par
444         {\cf19 if} (Subresource > subresourceCount)\par
445         \{\par
446             {\cf19 break};\par
447         \}\par
448 \par
449         TotalBytes = D3DX12Align< UINT64 >( TotalBytes, D3D12_TEXTURE_DATA_PLACEMENT_ALIGNMENT );\par
450 \par
451         UINT MipLevel, ArraySlice, PlaneSlice;\par
452         D3D12DecomposeSubresource(Subresource, resourceDesc.MipLevels, resourceDesc.ArraySize(), {\cf20 /*_Out_*/}MipLevel, {\cf20 /*_Out_*/}ArraySlice, {\cf20 /*_Out_*/}PlaneSlice);\par
453 \par
454         {\cf17 const} UINT64 Width = D3DX12AlignAtLeast<UINT64>(resourceDesc.Width >> MipLevel, WidthAlignment);\par
455         {\cf17 const} UINT Height =  D3DX12AlignAtLeast(resourceDesc.Height >> MipLevel, HeightAlignment);\par
456         {\cf17 const} UINT16 Depth = D3DX12AlignAtLeast<UINT16>(resourceDesc.Depth() >> MipLevel, DepthAlignment);\par
457 \par
458         {\cf20 // Adjust for the current PlaneSlice.  Most formats have only one plane.}\par
459         DXGI_FORMAT PlaneFormat;\par
460         UINT32 MinPlanePitchWidth, PlaneWidth, PlaneHeight;\par
461         D3D12_PROPERTY_LAYOUT_FORMAT_TABLE::GetPlaneSubsampledSizeAndFormatForCopyableLayout(PlaneSlice, Format, (UINT)Width, Height, {\cf20 /*_Out_*/} PlaneFormat, {\cf20 /*_Out_*/} MinPlanePitchWidth, {\cf20 /* _Out_ */} PlaneWidth, {\cf20 /*_Out_*/} PlaneHeight);\par
462 \par
463         D3D12_SUBRESOURCE_FOOTPRINT LocalPlacement;\par
464         {\cf17 auto}& Placement = pLayouts ? pLayouts[uSubRes].Footprint : LocalPlacement;\par
465         Placement.Format = PlaneFormat;\par
466         Placement.Width = PlaneWidth;\par
467         Placement.Height = PlaneHeight;\par
468         Placement.Depth = Depth;\par
469 \par
470         {\cf20 // Calculate row pitch}\par
471         UINT MinPlaneRowPitch = 0;\par
472         D3D12_PROPERTY_LAYOUT_FORMAT_TABLE::CalculateMinimumRowMajorRowPitch(PlaneFormat, MinPlanePitchWidth, MinPlaneRowPitch);\par
473 \par
474         {\cf20 // Formats with more than one plane choose a larger pitch alignment to ensure that each plane begins on the row}\par
475         {\cf20 // immediately following the previous plane while still adhering to subresource alignment restrictions.}\par
476         {\cf17 static_assert}(   D3D12_TEXTURE_DATA_PLACEMENT_ALIGNMENT >= D3D12_TEXTURE_DATA_PITCH_ALIGNMENT\par
477                         && ((D3D12_TEXTURE_DATA_PLACEMENT_ALIGNMENT % D3D12_TEXTURE_DATA_PITCH_ALIGNMENT) == 0),\par
478                         {\cf22 "D3D12_TEXTURE_DATA_PLACEMENT_ALIGNMENT  must be >= and evenly divisible by D3D12_TEXTURE_DATA_PITCH_ALIGNMENT."} );\par
479 \par
480         Placement.RowPitch = D3D12_PROPERTY_LAYOUT_FORMAT_TABLE::Planar(Format)\par
481             ? D3DX12Align< UINT >( MinPlaneRowPitch, D3D12_TEXTURE_DATA_PLACEMENT_ALIGNMENT )\par
482             : D3DX12Align< UINT >( MinPlaneRowPitch, D3D12_TEXTURE_DATA_PITCH_ALIGNMENT );\par
483 \par
484         {\cf19 if} (pRowSizeInBytes)\par
485         \{\par
486             UINT PlaneRowSize = 0;\par
487             D3D12_PROPERTY_LAYOUT_FORMAT_TABLE::CalculateMinimumRowMajorRowPitch(PlaneFormat, PlaneWidth, PlaneRowSize);\par
488 \par
489             pRowSizeInBytes[uSubRes] = PlaneRowSize;\par
490         \}\par
491 \par
492         {\cf20 // Number of rows (accounting for block compression and additional planes)}\par
493         UINT NumRows = 0;\par
494         {\cf19 if} (D3D12_PROPERTY_LAYOUT_FORMAT_TABLE::Planar(Format))\par
495         \{\par
496             NumRows = PlaneHeight;\par
497         \}\par
498         {\cf19 else}\par
499         \{\par
500             D3DX12_ASSERT(Height % HeightAlignment == 0);\par
501             NumRows = Height / HeightAlignment;\par
502         \}\par
503 \par
504         {\cf19 if} (pNumRows)\par
505         \{\par
506             pNumRows[uSubRes] = NumRows;\par
507         \}\par
508 \par
509             {\cf20 // Offsetting}\par
510             {\cf19 if} (pLayouts)\par
511             \{\par
512                 pLayouts[uSubRes].Offset = (bOverflow ? uint64_max : TotalBytes + BaseOffset);\par
513             \}\par
514 \par
515         {\cf17 const} UINT16 NumSlices = Depth;\par
516         {\cf17 const} UINT64 SubresourceSize = (NumRows * NumSlices - 1) * Placement.RowPitch + MinPlaneRowPitch;\par
517 \par
518         {\cf20 // uint64 addition with overflow checking}\par
519         TotalBytes = TotalBytes + SubresourceSize;\par
520         {\cf19 if}(TotalBytes < SubresourceSize)\par
521         \{\par
522             TotalBytes = uint64_max;\par
523         \}\par
524         bResourceOverflow  = bResourceOverflow  || bOverflow;\par
525     \}\par
526 \par
527     {\cf20 // Overflow error}\par
528     {\cf19 if} (bResourceOverflow)\par
529     \{\par
530         TotalBytes = uint64_max;\par
531     \}\par
532 \par
533 \par
534     {\cf19 if} (pLayouts)\par
535     \{\par
536         memset( pLayouts + uSubRes, -1, {\cf17 sizeof}( *pLayouts ) * (NumSubresources - uSubRes) );\par
537     \}\par
538     {\cf19 if} (pNumRows)\par
539     \{\par
540         memset(pNumRows + uSubRes, -1, {\cf17 sizeof}(*pNumRows) * (NumSubresources - uSubRes));\par
541     \}\par
542     {\cf19 if} (pRowSizeInBytes)\par
543     \{\par
544         memset(pRowSizeInBytes + uSubRes, -1, {\cf17 sizeof}(*pRowSizeInBytes) * (NumSubresources - uSubRes));\par
545     \}\par
546     {\cf19 if} (pTotalBytes)\par
547     \{\par
548         *pTotalBytes = TotalBytes;\par
549     \}\par
550     {\cf19 if}(TotalBytes == uint64_max)\par
551     \{\par
552         {\cf19 return} {\cf17 false};\par
553     \}\par
554     {\cf19 return} {\cf17 true};\par
555 \}\par
