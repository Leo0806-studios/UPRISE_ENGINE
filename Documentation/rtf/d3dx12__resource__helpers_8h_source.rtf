96 {\cf17 inline} UINT64 UpdateSubresources(\par
97     _In_ ID3D12GraphicsCommandList* pCmdList,\par
98     _In_ ID3D12Resource* pDestinationResource,\par
99     _In_ ID3D12Resource* pIntermediate,\par
100     _In_range_(0,D3D12_REQ_SUBRESOURCES) UINT FirstSubresource,\par
101     _In_range_(0,D3D12_REQ_SUBRESOURCES-FirstSubresource) UINT NumSubresources,\par
102     UINT64 RequiredSize,\par
103     _In_reads_(NumSubresources) {\cf17 const} D3D12_PLACED_SUBRESOURCE_FOOTPRINT* pLayouts,\par
104     _In_reads_(NumSubresources) {\cf17 const} UINT* pNumRows,\par
105     _In_reads_(NumSubresources) {\cf17 const} UINT64* pRowSizesInBytes,\par
106     _In_reads_(NumSubresources) {\cf17 const} D3D12_SUBRESOURCE_DATA* pSrcData) {\cf17 noexcept}\par
107 \{\par
108     {\cf20 // Minor validation}\par
109 {\cf21 #if defined(_MSC_VER) || !defined(_WIN32)}\par
110     {\cf17 const} {\cf17 auto} IntermediateDesc = pIntermediate->GetDesc();\par
111     {\cf17 const} {\cf17 auto} DestinationDesc = pDestinationResource->GetDesc();\par
112 {\cf21 #else}\par
113     D3D12_RESOURCE_DESC tmpDesc1, tmpDesc2;\par
114     {\cf17 const} {\cf17 auto}& IntermediateDesc = *pIntermediate->GetDesc(&tmpDesc1);\par
115     {\cf17 const} {\cf17 auto}& DestinationDesc = *pDestinationResource->GetDesc(&tmpDesc2);\par
116 {\cf21 #endif}\par
117     {\cf19 if} (IntermediateDesc.Dimension != D3D12_RESOURCE_DIMENSION_BUFFER ||\par
118         IntermediateDesc.Width < RequiredSize + pLayouts[0].Offset ||\par
119         RequiredSize > SIZE_T(-1) ||\par
120         (DestinationDesc.Dimension == D3D12_RESOURCE_DIMENSION_BUFFER &&\par
121             (FirstSubresource != 0 || NumSubresources != 1)))\par
122     \{\par
123         {\cf19 return} 0;\par
124     \}\par
125 \par
126     BYTE* pData;\par
127     HRESULT hr = pIntermediate->Map(0, {\cf17 nullptr}, {\cf17 reinterpret_cast<}{\cf18 void}**{\cf17 >}(&pData));\par
128     {\cf19 if} (FAILED(hr))\par
129     \{\par
130         {\cf19 return} 0;\par
131     \}\par
132 \par
133     {\cf19 for} (UINT i = 0; i < NumSubresources; ++i)\par
134     \{\par
135         {\cf19 if} (pRowSizesInBytes[i] > SIZE_T(-1)) {\cf19 return} 0;\par
136         D3D12_MEMCPY_DEST DestData = \{ pData + pLayouts[i].Offset, pLayouts[i].Footprint.RowPitch, SIZE_T(pLayouts[i].Footprint.RowPitch) * SIZE_T(pNumRows[i]) \};\par
137         MemcpySubresource(&DestData, &pSrcData[i], {\cf17 static_cast<}SIZE_T{\cf17 >}(pRowSizesInBytes[i]), pNumRows[i], pLayouts[i].Footprint.Depth);\par
138     \}\par
139     pIntermediate->Unmap(0, {\cf17 nullptr});\par
140 \par
141     {\cf19 if} (DestinationDesc.Dimension == D3D12_RESOURCE_DIMENSION_BUFFER)\par
142     \{\par
143         pCmdList->CopyBufferRegion(\par
144             pDestinationResource, 0, pIntermediate, pLayouts[0].Offset, pLayouts[0].Footprint.Width);\par
145     \}\par
146     {\cf19 else}\par
147     \{\par
148         {\cf19 for} (UINT i = 0; i < NumSubresources; ++i)\par
149         \{\par
150             {\cf17 const} CD3DX12_TEXTURE_COPY_LOCATION Dst(pDestinationResource, i + FirstSubresource);\par
151             {\cf17 const} CD3DX12_TEXTURE_COPY_LOCATION Src(pIntermediate, pLayouts[i]);\par
152             pCmdList->CopyTextureRegion(&Dst, 0, 0, 0, &Src, {\cf17 nullptr});\par
153         \}\par
154     \}\par
155     {\cf19 return} RequiredSize;\par
156 \}\par
