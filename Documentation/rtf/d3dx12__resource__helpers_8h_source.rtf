376 {\cf17 template}< {\cf17 typename} T >\par
377 {\cf17 inline} T D3DX12Align(T uValue, T uAlign)\par
378 \{\par
379     {\cf20 // Assert power of 2 alignment}\par
380     D3DX12_ASSERT(0 == (uAlign & (uAlign - 1)));\par
381     T uMask = uAlign - 1;\par
382     T uResult = (uValue + uMask) & ~uMask;\par
383     D3DX12_ASSERT(uResult >= uValue);\par
384     D3DX12_ASSERT(0 == (uResult % uAlign));\par
385     {\cf19 return} uResult;\par
386 \}\par
387 \par
