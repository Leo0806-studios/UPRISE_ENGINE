389 {\cf17 template}< {\cf17 typename} T >\par
390 {\cf17 inline} T D3DX12AlignAtLeast(T uValue, T uAlign)\par
391 \{\par
392     T aligned = D3DX12Align(uValue, uAlign);\par
393     {\cf19 return} aligned > uAlign ? aligned : uAlign;\par
394 \}\par
