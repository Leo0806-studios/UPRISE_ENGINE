266 {\cf17 struct }aiString \{\par
267 {\cf21 #ifdef __cplusplus}\par
269     aiString() AI_NO_EXCEPT\par
270             : length(0) \{\par
271         data[0] = {\cf23 '\\0'};\par
272 \par
273 {\cf21 #ifdef ASSIMP_BUILD_DEBUG}\par
274         {\cf20 // Debug build: overwrite the string on its full length with ESC (27)}\par
275         memset(data + 1, 27, MAXLEN - 1);\par
276 {\cf21 #endif}\par
277     \}\par
278 \par
280     aiString({\cf17 const} aiString &rOther) :\par
281             length(rOther.length) \{\par
282         {\cf20 // Crop the string to the maximum length}\par
283         length = length >= MAXLEN ? MAXLEN - 1 : length;\par
284         memcpy(data, rOther.data, length);\par
285         data[length] = {\cf23 '\\0'};\par
286     \}\par
287 \par
289     {\cf17 explicit} aiString({\cf17 const} std::string &pString) :\par
290             length((ai_uint32)pString.length()) \{\par
291         length = length >= MAXLEN ? MAXLEN - 1 : length;\par
292         memcpy(data, pString.c_str(), length);\par
293         data[length] = {\cf23 '\\0'};\par
294     \}\par
295 \par
297     {\cf18 void} Set({\cf17 const} std::string &pString) \{\par
298         {\cf19 if} (pString.length() > MAXLEN - 1) \{\par
299             {\cf19 return};\par
300         \}\par
301         length = (ai_uint32)pString.length();\par
302         memcpy(data, pString.c_str(), length);\par
303         data[length] = 0;\par
304     \}\par
305 \par
307     {\cf18 void} Set({\cf17 const} {\cf18 char} *sz) \{\par
308         ai_int32 len = (ai_uint32)::strlen(sz);\par
309         {\cf19 if} (len > (ai_int32)MAXLEN - 1) \{\par
310             len = (ai_int32) MAXLEN - 1;\par
311         \}\par
312         length = len;\par
313         memcpy(data, sz, len);\par
314         data[len] = 0;\par
315     \}\par
316 \par
318     aiString &operator=({\cf17 const} aiString &rOther) \{\par
319         {\cf19 if} ({\cf17 this} == &rOther) \{\par
320             {\cf19 return} *{\cf17 this};\par
321         \}\par
322 \par
323         length = rOther.length;\par
324         {\cf19 if} (length >(MAXLEN - 1)) \{\par
325             length = (ai_int32) MAXLEN - 1;\par
326         \}\par
327 \par
328         memcpy(data, rOther.data, length);\par
329         data[length] = {\cf23 '\\0'};\par
330         {\cf19 return} *{\cf17 this};\par
331     \}\par
332 \par
334     aiString &operator=({\cf17 const} {\cf18 char} *sz) \{\par
335         Set(sz);\par
336         {\cf19 return} *{\cf17 this};\par
337     \}\par
338 \par
340     aiString &operator=({\cf17 const} std::string &pString) \{\par
341         Set(pString);\par
342         {\cf19 return} *{\cf17 this};\par
343     \}\par
344 \par
346     {\cf18 bool} operator==({\cf17 const} aiString &other){\cf17  const }\{\par
347         {\cf19 return} (length == other.length && 0 == memcmp(data, other.data, length));\par
348     \}\par
349 \par
351     {\cf18 bool} operator!=({\cf17 const} aiString &other){\cf17  const }\{\par
352         {\cf19 return} (length != other.length || 0 != memcmp(data, other.data, length));\par
353     \}\par
354 \par
356     {\cf18 void} Append({\cf17 const} {\cf18 char} *app) \{\par
357         {\cf17 const} ai_uint32 len = (ai_uint32)::strlen(app);\par
358         {\cf19 if} (!len) \{\par
359             {\cf19 return};\par
360         \}\par
361         {\cf19 if} (length + len >= MAXLEN) \{\par
362             {\cf19 return};\par
363         \}\par
364 \par
365         memcpy(&data[length], app, len + 1);\par
366         length += len;\par
367     \}\par
368 \par
370     {\cf18 void} Clear() \{\par
371         length = 0;\par
372         data[0] = {\cf23 '\\0'};\par
373 \par
374 {\cf21 #ifdef ASSIMP_BUILD_DEBUG}\par
375         {\cf20 // Debug build: overwrite the string on its full length with ESC (27)}\par
376         memset(data + 1, 27, MAXLEN - 1);\par
377 {\cf21 #endif}\par
378     \}\par
379 \par
381     {\cf17 const} {\cf18 char} *C_Str(){\cf17  const }\{\par
382         {\cf19 return} data;\par
383     \}\par
384 \par
385 {\cf21 #endif }{\cf20 // !__cplusplus}\par
386 \par
390     ai_uint32 length;\par
391 \par
393     {\cf18 char} data[MAXLEN];\par
394 \}; {\cf20 // !struct aiString}\par
