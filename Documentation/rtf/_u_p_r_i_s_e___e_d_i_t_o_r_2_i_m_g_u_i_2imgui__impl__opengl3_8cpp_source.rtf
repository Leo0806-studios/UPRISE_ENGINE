00348         io.BackendFlags |= ImGuiBackendFlags_RendererHasVtxOffset;  {\cf20 // We can honor the ImDrawCmd::VtxOffset field, allowing for large meshes.}\par
00349 {\cf21 #endif}\par
00350     io.BackendFlags |= ImGuiBackendFlags_RendererHasViewports;  {\cf20 // We can create multi-viewports on the Renderer side (optional)}\par
