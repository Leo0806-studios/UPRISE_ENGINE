00334 {\cf20 #ifdef _WIN32}\par
00335 {\cf20     if (const char* vendor = (const char*)glGetString(GL_VENDOR))}\par
00336 {\cf20         if (strncmp(vendor, "Intel", 5) == 0)}\par
