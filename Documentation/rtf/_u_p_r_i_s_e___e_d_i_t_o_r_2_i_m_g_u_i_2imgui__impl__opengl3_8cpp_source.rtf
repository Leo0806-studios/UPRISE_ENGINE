00299     ImGui_ImplOpenGL3_Data* bd = IM_NEW(ImGui_ImplOpenGL3_Data)();\par
00300     io.BackendRendererUserData = ({\cf18 void}*)bd;\par
00301     io.BackendRendererName = {\cf22 "imgui_impl_opengl3"};\par
00302 \par
00303     {\cf20 // Query for GL version (e.g. 320 for GL 3.2)}\par
00304 {\cf21 #if defined(IMGUI_IMPL_OPENGL_ES2)}\par
00305     {\cf20 // GLES 2}\par
00306     bd->GlVersion = 200;\par
00307     bd->GlProfileIsES2 = {\cf17 true};\par
00308 {\cf21 #else}\par
00309     {\cf20 // Desktop or GLES 3}\par
00310     {\cf17 const} {\cf18 char}* gl_version_str = ({\cf17 const} {\cf18 char}*)glGetString(GL_VERSION);\par
00311     GLint major = 0;\par
00312     GLint minor = 0;\par
00313     glGetIntegerv(GL_MAJOR_VERSION, &major);\par
00314     glGetIntegerv(GL_MINOR_VERSION, &minor);\par
00315     {\cf19 if} (major == 0 && minor == 0)\par
00316         sscanf(gl_version_str, {\cf22 "%d.%d"}, &major, &minor); {\cf20 // Query GL_VERSION in desktop GL 2.x, the string will start with "<major>.<minor>"}\par
00317     bd->GlVersion = (GLuint)(major * 100 + minor * 10);\par
00318 {\cf21 #if defined(GL_CONTEXT_PROFILE_MASK)}\par
00319     {\cf19 if} (bd->GlVersion >= 320)\par
00320         glGetIntegerv(GL_CONTEXT_PROFILE_MASK, &bd->GlProfileMask);\par
