00343     printf({\cf22 "GlVersion = %d, \\"%s\\"\\nGlProfileIsCompat = %d\\nGlProfileMask = 0x%X\\nGlProfileIsES2 = %d, GlProfileIsES3 = %d\\nGL_VENDOR = '%s'\\nGL_RENDERER = '%s'\\n"}, bd->GlVersion, gl_version_str, bd->GlProfileIsCompat, bd->GlProfileMask, bd->GlProfileIsES2, bd->GlProfileIsES3, ({\cf17 const} {\cf18 char}*)glGetString(GL_VENDOR), ({\cf17 const} {\cf18 char}*)glGetString(GL_RENDERER)); {\cf20 // [DEBUG]}\par
00344 {\cf21 #endif}\par
