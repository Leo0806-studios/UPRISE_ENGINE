00367     strcpy(bd->GlslVersionString, glsl_version);\par
00368     strcat(bd->GlslVersionString, {\cf22 "\\n"});\par
00369 \par
00370     {\cf20 // Make an arbitrary GL call (we don't actually need the result)}\par
