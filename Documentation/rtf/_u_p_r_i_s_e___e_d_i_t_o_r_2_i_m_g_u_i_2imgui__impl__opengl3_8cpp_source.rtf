00272         glGetVertexAttribPointerv(index, GL_VERTEX_ATTRIB_ARRAY_POINTER, &Ptr);\par
00273     \}\par
00274     {\cf18 void} SetState(GLint index)\par
00275     \{\par
00276         glVertexAttribPointer(index, Size, Type, (GLboolean)Normalized, Stride, Ptr);\par
