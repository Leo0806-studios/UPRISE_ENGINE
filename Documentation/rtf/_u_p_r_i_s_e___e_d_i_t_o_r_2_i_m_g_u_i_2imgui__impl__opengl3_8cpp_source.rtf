00670 {\cf21 #endif }{\cf20 // IMGUI_IMPL_OPENGL_MAY_HAVE_POLYGON_MODE}\par
00671 \par
00672     glViewport(last_viewport[0], last_viewport[1], (GLsizei)last_viewport[2], (GLsizei)last_viewport[3]);\par
