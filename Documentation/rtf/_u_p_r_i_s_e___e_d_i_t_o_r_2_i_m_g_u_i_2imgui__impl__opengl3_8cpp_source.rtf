00759 {\cf18 bool}    ImGui_ImplOpenGL3_CreateDeviceObjects()\par
00760 \{\par
00761     ImGui_ImplOpenGL3_Data* bd = ImGui_ImplOpenGL3_GetBackendData();\par
00762 \par
00763     {\cf20 // Backup GL state}\par
00764     GLint last_texture, last_array_buffer;\par
00765     glGetIntegerv(GL_TEXTURE_BINDING_2D, &last_texture);\par
00766     glGetIntegerv(GL_ARRAY_BUFFER_BINDING, &last_array_buffer);\par
00767 {\cf21 #ifdef IMGUI_IMPL_OPENGL_MAY_HAVE_BIND_BUFFER_PIXEL_UNPACK}\par
00768     GLint last_pixel_unpack_buffer = 0;\par
00769     {\cf19 if} (bd->GlVersion >= 210) \{ glGetIntegerv(GL_PIXEL_UNPACK_BUFFER_BINDING, &last_pixel_unpack_buffer); glBindBuffer(GL_PIXEL_UNPACK_BUFFER, 0); \}\par
00770 {\cf21 #endif}\par
00771 {\cf21 #ifdef IMGUI_IMPL_OPENGL_USE_VERTEX_ARRAY}\par
00772     GLint last_vertex_array;\par
00773     glGetIntegerv(GL_VERTEX_ARRAY_BINDING, &last_vertex_array);\par
00774 {\cf21 #endif}\par
00775 \par
00776     {\cf20 // Parse GLSL version string}\par
00777     {\cf18 int} glsl_version = 130;\par
00778     sscanf(bd->GlslVersionString, {\cf22 "#version %d"}, &glsl_version);\par
00779 \par
00780     {\cf17 const} GLchar* vertex_shader_glsl_120 =\par
00781         {\cf22 "uniform mat4 ProjMtx;\\n"}\par
00782         {\cf22 "attribute vec2 Position;\\n"}\par
00783         {\cf22 "attribute vec2 UV;\\n"}\par
00784         {\cf22 "attribute vec4 Color;\\n"}\par
00785         {\cf22 "varying vec2 Frag_UV;\\n"}\par
00786         {\cf22 "varying vec4 Frag_Color;\\n"}\par
00787         {\cf22 "void main()\\n"}\par
00788         {\cf22 "\{\\n"}\par
00789         {\cf22 "    Frag_UV = UV;\\n"}\par
00790         {\cf22 "    Frag_Color = Color;\\n"}\par
00791         {\cf22 "    gl_Position = ProjMtx * vec4(Position.xy,0,1);\\n"}\par
00792         {\cf22 "\}\\n"};\par
00793 \par
00794     {\cf17 const} GLchar* vertex_shader_glsl_130 =\par
00795         {\cf22 "uniform mat4 ProjMtx;\\n"}\par
00796         {\cf22 "in vec2 Position;\\n"}\par
00797         {\cf22 "in vec2 UV;\\n"}\par
00798         {\cf22 "in vec4 Color;\\n"}\par
00799         {\cf22 "out vec2 Frag_UV;\\n"}\par
00800         {\cf22 "out vec4 Frag_Color;\\n"}\par
00801         {\cf22 "void main()\\n"}\par
00802         {\cf22 "\{\\n"}\par
00803         {\cf22 "    Frag_UV = UV;\\n"}\par
00804         {\cf22 "    Frag_Color = Color;\\n"}\par
00805         {\cf22 "    gl_Position = ProjMtx * vec4(Position.xy,0,1);\\n"}\par
00806         {\cf22 "\}\\n"};\par
00807 \par
00808     {\cf17 const} GLchar* vertex_shader_glsl_300_es =\par
00809         {\cf22 "precision highp float;\\n"}\par
00810         {\cf22 "layout (location = 0) in vec2 Position;\\n"}\par
00811         {\cf22 "layout (location = 1) in vec2 UV;\\n"}\par
00812         {\cf22 "layout (location = 2) in vec4 Color;\\n"}\par
00813         {\cf22 "uniform mat4 ProjMtx;\\n"}\par
00814         {\cf22 "out vec2 Frag_UV;\\n"}\par
00815         {\cf22 "out vec4 Frag_Color;\\n"}\par
00816         {\cf22 "void main()\\n"}\par
00817         {\cf22 "\{\\n"}\par
00818         {\cf22 "    Frag_UV = UV;\\n"}\par
00819         {\cf22 "    Frag_Color = Color;\\n"}\par
00820         {\cf22 "    gl_Position = ProjMtx * vec4(Position.xy,0,1);\\n"}\par
00821         {\cf22 "\}\\n"};\par
00822 \par
00823     {\cf17 const} GLchar* vertex_shader_glsl_410_core =\par
00824         {\cf22 "layout (location = 0) in vec2 Position;\\n"}\par
00825         {\cf22 "layout (location = 1) in vec2 UV;\\n"}\par
00826         {\cf22 "layout (location = 2) in vec4 Color;\\n"}\par
00827         {\cf22 "uniform mat4 ProjMtx;\\n"}\par
00828         {\cf22 "out vec2 Frag_UV;\\n"}\par
00829         {\cf22 "out vec4 Frag_Color;\\n"}\par
00830         {\cf22 "void main()\\n"}\par
00831         {\cf22 "\{\\n"}\par
00832         {\cf22 "    Frag_UV = UV;\\n"}\par
00833         {\cf22 "    Frag_Color = Color;\\n"}\par
00834         {\cf22 "    gl_Position = ProjMtx * vec4(Position.xy,0,1);\\n"}\par
00835         {\cf22 "\}\\n"};\par
00836 \par
00837     {\cf17 const} GLchar* fragment_shader_glsl_120 =\par
00838         {\cf22 "#ifdef GL_ES\\n"}\par
00839         {\cf22 "    precision mediump float;\\n"}\par
00840         {\cf22 "#endif\\n"}\par
00841         {\cf22 "uniform sampler2D Texture;\\n"}\par
00842         {\cf22 "varying vec2 Frag_UV;\\n"}\par
00843         {\cf22 "varying vec4 Frag_Color;\\n"}\par
00844         {\cf22 "void main()\\n"}\par
00845         {\cf22 "\{\\n"}\par
00846         {\cf22 "    gl_FragColor = Frag_Color * texture2D(Texture, Frag_UV.st);\\n"}\par
00847         {\cf22 "\}\\n"};\par
00848 \par
00849     {\cf17 const} GLchar* fragment_shader_glsl_130 =\par
00850         {\cf22 "uniform sampler2D Texture;\\n"}\par
00851         {\cf22 "in vec2 Frag_UV;\\n"}\par
00852         {\cf22 "in vec4 Frag_Color;\\n"}\par
00853         {\cf22 "out vec4 Out_Color;\\n"}\par
00854         {\cf22 "void main()\\n"}\par
00855         {\cf22 "\{\\n"}\par
00856         {\cf22 "    Out_Color = Frag_Color * texture(Texture, Frag_UV.st);\\n"}\par
00857         {\cf22 "\}\\n"};\par
00858 \par
00859     {\cf17 const} GLchar* fragment_shader_glsl_300_es =\par
00860         {\cf22 "precision mediump float;\\n"}\par
00861         {\cf22 "uniform sampler2D Texture;\\n"}\par
00862         {\cf22 "in vec2 Frag_UV;\\n"}\par
00863         {\cf22 "in vec4 Frag_Color;\\n"}\par
00864         {\cf22 "layout (location = 0) out vec4 Out_Color;\\n"}\par
00865         {\cf22 "void main()\\n"}\par
00866         {\cf22 "\{\\n"}\par
00867         {\cf22 "    Out_Color = Frag_Color * texture(Texture, Frag_UV.st);\\n"}\par
00868         {\cf22 "\}\\n"};\par
00869 \par
00870     {\cf17 const} GLchar* fragment_shader_glsl_410_core =\par
00871         {\cf22 "in vec2 Frag_UV;\\n"}\par
00872         {\cf22 "in vec4 Frag_Color;\\n"}\par
00873         {\cf22 "uniform sampler2D Texture;\\n"}\par
00874         {\cf22 "layout (location = 0) out vec4 Out_Color;\\n"}\par
00875         {\cf22 "void main()\\n"}\par
00876         {\cf22 "\{\\n"}\par
00877         {\cf22 "    Out_Color = Frag_Color * texture(Texture, Frag_UV.st);\\n"}\par
00878         {\cf22 "\}\\n"};\par
00879 \par
00880     {\cf20 // Select shaders matching our GLSL versions}\par
00881     {\cf17 const} GLchar* vertex_shader = {\cf17 nullptr};\par
00882     {\cf17 const} GLchar* fragment_shader = {\cf17 nullptr};\par
00883     {\cf19 if} (glsl_version < 130)\par
00884     \{\par
00885         vertex_shader = vertex_shader_glsl_120;\par
00886         fragment_shader = fragment_shader_glsl_120;\par
00887     \}\par
00888     {\cf19 else} {\cf19 if} (glsl_version >= 410)\par
00889     \{\par
00890         vertex_shader = vertex_shader_glsl_410_core;\par
00891         fragment_shader = fragment_shader_glsl_410_core;\par
00892     \}\par
00893     {\cf19 else} {\cf19 if} (glsl_version == 300)\par
00894     \{\par
00895         vertex_shader = vertex_shader_glsl_300_es;\par
00896         fragment_shader = fragment_shader_glsl_300_es;\par
00897     \}\par
00898     {\cf19 else}\par
00899     \{\par
00900         vertex_shader = vertex_shader_glsl_130;\par
00901         fragment_shader = fragment_shader_glsl_130;\par
00902     \}\par
00903 \par
00904     {\cf20 // Create shaders}\par
00905     {\cf17 const} GLchar* vertex_shader_with_version[2] = \{ bd->GlslVersionString, vertex_shader \};\par
00906     GLuint vert_handle = glCreateShader(GL_VERTEX_SHADER);\par
00907     glShaderSource(vert_handle, 2, vertex_shader_with_version, {\cf17 nullptr});\par
00908     glCompileShader(vert_handle);\par
00909     CheckShader(vert_handle, {\cf22 "vertex shader"});\par
00910 \par
00911     {\cf17 const} GLchar* fragment_shader_with_version[2] = \{ bd->GlslVersionString, fragment_shader \};\par
00912     GLuint frag_handle = glCreateShader(GL_FRAGMENT_SHADER);\par
00913     glShaderSource(frag_handle, 2, fragment_shader_with_version, {\cf17 nullptr});\par
00914     glCompileShader(frag_handle);\par
00915     CheckShader(frag_handle, {\cf22 "fragment shader"});\par
00916 \par
00917     {\cf20 // Link}\par
00918     bd->ShaderHandle = glCreateProgram();\par
00919     glAttachShader(bd->ShaderHandle, vert_handle);\par
00920     glAttachShader(bd->ShaderHandle, frag_handle);\par
00921     glLinkProgram(bd->ShaderHandle);\par
00922     CheckProgram(bd->ShaderHandle, {\cf22 "shader program"});\par
00923 \par
00924     glDetachShader(bd->ShaderHandle, vert_handle);\par
00925     glDetachShader(bd->ShaderHandle, frag_handle);\par
00926     glDeleteShader(vert_handle);\par
00927     glDeleteShader(frag_handle);\par
00928 \par
00929     bd->AttribLocationTex = glGetUniformLocation(bd->ShaderHandle, {\cf22 "Texture"});\par
00930     bd->AttribLocationProjMtx = glGetUniformLocation(bd->ShaderHandle, {\cf22 "ProjMtx"});\par
00931     bd->AttribLocationVtxPos = (GLuint)glGetAttribLocation(bd->ShaderHandle, {\cf22 "Position"});\par
00932     bd->AttribLocationVtxUV = (GLuint)glGetAttribLocation(bd->ShaderHandle, {\cf22 "UV"});\par
00933     bd->AttribLocationVtxColor = (GLuint)glGetAttribLocation(bd->ShaderHandle, {\cf22 "Color"});\par
00934 \par
00935     {\cf20 // Create buffers}\par
00936     glGenBuffers(1, &bd->VboHandle);\par
00937     glGenBuffers(1, &bd->ElementsHandle);\par
00938 \par
00939     ImGui_ImplOpenGL3_CreateFontsTexture();\par
00940 \par
00941     {\cf20 // Restore modified GL state}\par
00942     glBindTexture(GL_TEXTURE_2D, last_texture);\par
00943     glBindBuffer(GL_ARRAY_BUFFER, last_array_buffer);\par
00944 {\cf21 #ifdef IMGUI_IMPL_OPENGL_MAY_HAVE_BIND_BUFFER_PIXEL_UNPACK}\par
00945     {\cf19 if} (bd->GlVersion >= 210) \{ glBindBuffer(GL_PIXEL_UNPACK_BUFFER, last_pixel_unpack_buffer); \}\par
00946 {\cf21 #endif}\par
00947 {\cf21 #ifdef IMGUI_IMPL_OPENGL_USE_VERTEX_ARRAY}\par
00948     glBindVertexArray(last_vertex_array);\par
00949 {\cf21 #endif}\par
00950 \par
00951     {\cf19 return} {\cf17 true};\par
00952 \}\par
