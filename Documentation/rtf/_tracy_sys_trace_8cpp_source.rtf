01103 {\cf17 static} uint64_t* GetCallstackBlock( uint64_t cnt, RingBuffer& ring, uint64_t offset )\par
01104 \{\par
01105     {\cf17 auto} trace = (uint64_t*)tracy_malloc_fast( ( 1 + cnt ) * {\cf17 sizeof}( uint64_t ) );\par
01106     ring.Read( trace+1, offset, {\cf17 sizeof}( uint64_t ) * cnt );\par
01107 \par
01108 {\cf21 #if defined __x86_64__ || defined _M_X64}\par
01109     {\cf20 // remove non-canonical pointers}\par
01110     {\cf19 do}\par
01111     \{\par
01112         {\cf17 const} {\cf17 auto} test = (int64_t)trace[cnt];\par
01113         {\cf17 const} {\cf17 auto} m1 = test >> 63;\par
01114         {\cf17 const} {\cf17 auto} m2 = test >> 47;\par
01115         {\cf19 if}( m1 == m2 ) {\cf19 break};\par
01116     \}\par
01117     {\cf19 while}( --cnt > 0 );\par
01118     {\cf19 for}( uint64_t j=1; j<cnt; j++ )\par
01119     \{\par
01120         {\cf17 const} {\cf17 auto} test = (int64_t)trace[j];\par
01121         {\cf17 const} {\cf17 auto} m1 = test >> 63;\par
01122         {\cf17 const} {\cf17 auto} m2 = test >> 47;\par
01123         {\cf19 if}( m1 != m2 ) trace[j] = 0;\par
01124     \}\par
01125 {\cf21 #endif}\par
01126 \par
01127     {\cf19 for}( uint64_t j=1; j<=cnt; j++ )\par
01128     \{\par
01129         {\cf19 if}( trace[j] >= (uint64_t)-4095 )       {\cf20 // PERF_CONTEXT_MAX}\par
01130         \{\par
01131             memmove( trace+j, trace+j+1, {\cf17 sizeof}( uint64_t ) * ( cnt - j ) );\par
01132             cnt--;\par
01133         \}\par
01134     \}\par
01135 \par
01136     memcpy( trace, &cnt, {\cf17 sizeof}( uint64_t ) );\par
01137     {\cf19 return} trace;\par
01138 \}\par
