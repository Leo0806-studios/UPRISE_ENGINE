147 {\cf17 static} tracy_force_inline {\cf18 void} SendLuaCallstack( lua_State* L, uint32_t depth )\par
148 \{\par
149     assert( depth <= 64 );\par
150     lua_Debug dbg[64];\par
151     {\cf17 const} {\cf18 char}* func[64];\par
152     uint32_t fsz[64];\par
153     uint32_t ssz[64];\par
154 \par
155     uint8_t cnt;\par
156     uint16_t spaceNeeded = {\cf17 sizeof}( cnt );\par
157     {\cf19 for}( cnt=0; cnt<depth; cnt++ )\par
158     \{\par
159         {\cf19 if}( lua_getstack( L, cnt+1, dbg+cnt ) == 0 ) {\cf19 break};\par
160         lua_getinfo( L, {\cf22 "Snl"}, dbg+cnt );\par
161         func[cnt] = dbg[cnt].name ? dbg[cnt].name : dbg[cnt].short_src;\par
162         fsz[cnt] = uint32_t( strlen( func[cnt] ) );\par
163         ssz[cnt] = uint32_t( strlen( dbg[cnt].source ) );\par
164         spaceNeeded += fsz[cnt] + ssz[cnt];\par
165     \}\par
166     spaceNeeded += cnt * ( 4 + 2 + 2 );     {\cf20 // source line, function string length, source string length}\par
167 \par
168     {\cf17 auto} ptr = ({\cf18 char}*)tracy_malloc( spaceNeeded + 2 );\par
169     {\cf17 auto} dst = ptr;\par
170     memcpy( dst, &spaceNeeded, 2 ); dst += 2;\par
171     memcpy( dst, &cnt, 1 ); dst++;\par
172     {\cf19 for}( uint8_t i=0; i<cnt; i++ )\par
173     \{\par
174         {\cf17 const} uint32_t line = dbg[i].currentline;\par
175         memcpy( dst, &line, 4 ); dst += 4;\par
176         assert( fsz[i] <= (std::numeric_limits<uint16_t>::max)() );\par
177         memcpy( dst, fsz+i, 2 ); dst += 2;\par
178         memcpy( dst, func[i], fsz[i] ); dst += fsz[i];\par
179         assert( ssz[i] <= (std::numeric_limits<uint16_t>::max)() );\par
180         memcpy( dst, ssz+i, 2 ); dst += 2;\par
181         memcpy( dst, dbg[i].source, ssz[i] ), dst += ssz[i];\par
182     \}\par
183     assert( dst - ptr == spaceNeeded + 2 );\par
184 \par
185     TracyQueuePrepare( QueueType::CallstackAlloc );\par
186     MemWrite( &item->callstackAllocFat.ptr, (uint64_t)ptr );\par
187     MemWrite( &item->callstackAllocFat.nativePtr, (uint64_t)Callstack( depth ) );\par
188     TracyQueueCommit( callstackAllocFatThread );\par
189 \}\par
