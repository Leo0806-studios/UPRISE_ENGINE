02198 {\cf20 // Maximum column content width given current layout. Use column->MinX so this value on a per-column basis.}\par
02199 {\cf18 float} ImGui::TableGetMaxColumnWidth({\cf17 const} ImGuiTable* table, {\cf18 int} column_n)\par
02200 \{\par
02201     {\cf17 const} ImGuiTableColumn* column = &table->Columns[column_n];\par
02202     {\cf18 float} max_width = FLT_MAX;\par
02203     {\cf17 const} {\cf18 float} min_column_distance = table->MinColumnWidth + table->CellPaddingX * 2.0f + table->CellSpacingX1 + table->CellSpacingX2;\par
02204     {\cf19 if} (table->Flags & ImGuiTableFlags_ScrollX)\par
02205     \{\par
02206         {\cf20 // Frozen columns can't reach beyond visible width else scrolling will naturally break.}\par
02207         {\cf20 // (we use DisplayOrder as within a set of multiple frozen column reordering is possible)}\par
02208         {\cf19 if} (column->DisplayOrder < table->FreezeColumnsRequest)\par
02209         \{\par
02210             max_width = (table->InnerClipRect.Max.x - (table->FreezeColumnsRequest - column->DisplayOrder) * min_column_distance) - column->MinX;\par
02211             max_width = max_width - table->OuterPaddingX - table->CellPaddingX - table->CellSpacingX2;\par
02212         \}\par
02213     \}\par
02214     {\cf19 else} {\cf19 if} ((table->Flags & ImGuiTableFlags_NoKeepColumnsVisible) == 0)\par
02215     \{\par
02216         {\cf20 // If horizontal scrolling if disabled, we apply a final lossless shrinking of columns in order to make}\par
02217         {\cf20 // sure they are all visible. Because of this we also know that all of the columns will always fit in}\par
02218         {\cf20 // table->WorkRect and therefore in table->InnerRect (because ScrollX is off)}\par
02219         {\cf20 // FIXME-TABLE: This is solved incorrectly but also quite a difficult problem to fix as we also want ClipRect width to match.}\par
02220         {\cf20 // See "table_width_distrib" and "table_width_keep_visible" tests}\par
02221         max_width = table->WorkRect.Max.x - (table->ColumnsEnabledCount - column->IndexWithinEnabledSet - 1) * min_column_distance - column->MinX;\par
02222         {\cf20 //max_width -= table->CellSpacingX1;}\par
02223         max_width -= table->CellSpacingX2;\par
02224         max_width -= table->CellPaddingX * 2.0f;\par
02225         max_width -= table->OuterPaddingX;\par
02226     \}\par
02227     {\cf19 return} max_width;\par
02228 \}\par
02229 \par
02230 {\cf20 // Note this is meant to be stored in column->WidthAuto, please generally use the WidthAuto field}\par
02231 {\cf18 float} ImGui::TableGetColumnWidthAuto(ImGuiTable* table, ImGuiTableColumn* column)\par
02232 \{\par
02233     {\cf17 const} {\cf18 float} content_width_body = ImMax(column->ContentMaxXFrozen, column->ContentMaxXUnfrozen) - column->WorkMinX;\par
02234     {\cf17 const} {\cf18 float} content_width_headers = column->ContentMaxXHeadersIdeal - column->WorkMinX;\par
02235     {\cf18 float} width_auto = content_width_body;\par
02236     {\cf19 if} (!(column->Flags & ImGuiTableColumnFlags_NoHeaderWidth))\par
02237         width_auto = ImMax(width_auto, content_width_headers);\par
02238 \par
02239     {\cf20 // Non-resizable fixed columns preserve their requested width}\par
02240     {\cf19 if} ((column->Flags & ImGuiTableColumnFlags_WidthFixed) && column->InitStretchWeightOrWidth > 0.0f)\par
02241         {\cf19 if} (!(table->Flags & ImGuiTableFlags_Resizable) || (column->Flags & ImGuiTableColumnFlags_NoResize))\par
02242             width_auto = column->InitStretchWeightOrWidth;\par
02243 \par
02244     {\cf19 return} ImMax(width_auto, table->MinColumnWidth);\par
02245 \}\par
02246 \par
02247 {\cf20 // 'width' = inner column width, without padding}\par
02248 {\cf18 void} ImGui::TableSetColumnWidth({\cf18 int} column_n, {\cf18 float} width)\par
02249 \{\par
02250     ImGuiContext& g = *GImGui;\par
02251     ImGuiTable* table = g.CurrentTable;\par
02252     IM_ASSERT(table != NULL && table->IsLayoutLocked == {\cf17 false});\par
02253     IM_ASSERT(column_n >= 0 && column_n < table->ColumnsCount);\par
02254     ImGuiTableColumn* column_0 = &table->Columns[column_n];\par
02255     {\cf18 float} column_0_width = width;\par
02256 \par
02257     {\cf20 // Apply constraints early}\par
02258     {\cf20 // Compare both requested and actual given width to avoid overwriting requested width when column is stuck (minimum size, bounded)}\par
02259     IM_ASSERT(table->MinColumnWidth > 0.0f);\par
02260     {\cf17 const} {\cf18 float} min_width = table->MinColumnWidth;\par
02261     {\cf17 const} {\cf18 float} max_width = ImMax(min_width, TableGetMaxColumnWidth(table, column_n));\par
02262     column_0_width = ImClamp(column_0_width, min_width, max_width);\par
02263     {\cf19 if} (column_0->WidthGiven == column_0_width || column_0->WidthRequest == column_0_width)\par
02264         {\cf19 return};\par
02265 \par
02266     {\cf20 //IMGUI_DEBUG_PRINT("TableSetColumnWidth(%d, %.1f->%.1f)\\n", column_0_idx, column_0->WidthGiven, column_0_width);}\par
02267     ImGuiTableColumn* column_1 = (column_0->NextEnabledColumn != -1) ? &table->Columns[column_0->NextEnabledColumn] : NULL;\par
02268 \par
02269     {\cf20 // In this surprisingly not simple because of how we support mixing Fixed and multiple Stretch columns.}\par
02270     {\cf20 // - All fixed: easy.}\par
02271     {\cf20 // - All stretch: easy.}\par
02272     {\cf20 // - One or more fixed + one stretch: easy.}\par
02273     {\cf20 // - One or more fixed + more than one stretch: tricky.}\par
02274     {\cf20 // Qt when manual resize is enabled only supports a single _trailing_ stretch column, we support more cases here.}\par
02275 \par
02276     {\cf20 // When forwarding resize from Wn| to Fn+1| we need to be considerate of the _NoResize flag on Fn+1.}\par
02277     {\cf20 // FIXME-TABLE: Find a way to rewrite all of this so interactions feel more consistent for the user.}\par
02278     {\cf20 // Scenarios:}\par
02279     {\cf20 // - F1 F2 F3  resize from F1| or F2|   --> ok: alter ->WidthRequested of Fixed column. Subsequent columns will be offset.}\par
02280     {\cf20 // - F1 F2 F3  resize from F3|          --> ok: alter ->WidthRequested of Fixed column. If active, ScrollX extent can be altered.}\par
02281     {\cf20 // - F1 F2 W3  resize from F1| or F2|   --> ok: alter ->WidthRequested of Fixed column. If active, ScrollX extent can be altered, but it doesn't make much sense as the Stretch column will always be minimal size.}\par
02282     {\cf20 // - F1 F2 W3  resize from W3|          --> ok: no-op (disabled by Resize Rule 1)}\par
02283     {\cf20 // - W1 W2 W3  resize from W1| or W2|   --> ok}\par
02284     {\cf20 // - W1 W2 W3  resize from W3|          --> ok: no-op (disabled by Resize Rule 1)}\par
02285     {\cf20 // - W1 F2 F3  resize from F3|          --> ok: no-op (disabled by Resize Rule 1)}\par
02286     {\cf20 // - W1 F2     resize from F2|          --> ok: no-op (disabled by Resize Rule 1)}\par
02287     {\cf20 // - W1 W2 F3  resize from W1| or W2|   --> ok}\par
02288     {\cf20 // - W1 F2 W3  resize from W1| or F2|   --> ok}\par
02289     {\cf20 // - F1 W2 F3  resize from W2|          --> ok}\par
02290     {\cf20 // - F1 W3 F2  resize from W3|          --> ok}\par
02291     {\cf20 // - W1 F2 F3  resize from W1|          --> ok: equivalent to resizing |F2. F3 will not move.}\par
02292     {\cf20 // - W1 F2 F3  resize from F2|          --> ok}\par
02293     {\cf20 // All resizes from a Wx columns are locking other columns.}\par
02294 \par
02295     {\cf20 // Possible improvements:}\par
02296     {\cf20 // - W1 W2 W3  resize W1|               --> to not be stuck, both W2 and W3 would stretch down. Seems possible to fix. Would be most beneficial to simplify resize of all-weighted columns.}\par
02297     {\cf20 // - W3 F1 F2  resize W3|               --> to not be stuck past F1|, both F1 and F2 would need to stretch down, which would be lossy or ambiguous. Seems hard to fix.}\par
02298 \par
02299     {\cf20 // [Resize Rule 1] Can't resize from right of right-most visible column if there is any Stretch column. Implemented in TableUpdateLayout().}\par
02300 \par
02301     {\cf20 // If we have all Fixed columns OR resizing a Fixed column that doesn't come after a Stretch one, we can do an offsetting resize.}\par
02302     {\cf20 // This is the preferred resize path}\par
02303     {\cf19 if} (column_0->Flags & ImGuiTableColumnFlags_WidthFixed)\par
02304         {\cf19 if} (!column_1 || table->LeftMostStretchedColumn == -1 || table->Columns[table->LeftMostStretchedColumn].DisplayOrder >= column_0->DisplayOrder)\par
02305         \{\par
02306             column_0->WidthRequest = column_0_width;\par
02307             table->IsSettingsDirty = {\cf17 true};\par
02308             {\cf19 return};\par
02309         \}\par
02310 \par
02311     {\cf20 // We can also use previous column if there's no next one (this is used when doing an auto-fit on the right-most stretch column)}\par
02312     {\cf19 if} (column_1 == NULL)\par
02313         column_1 = (column_0->PrevEnabledColumn != -1) ? &table->Columns[column_0->PrevEnabledColumn] : NULL;\par
02314     {\cf19 if} (column_1 == NULL)\par
02315         {\cf19 return};\par
02316 \par
02317     {\cf20 // Resizing from right-side of a Stretch column before a Fixed column forward sizing to left-side of fixed column.}\par
02318     {\cf20 // (old_a + old_b == new_a + new_b) --> (new_a == old_a + old_b - new_b)}\par
02319     {\cf18 float} column_1_width = ImMax(column_1->WidthRequest - (column_0_width - column_0->WidthRequest), min_width);\par
02320     column_0_width = column_0->WidthRequest + column_1->WidthRequest - column_1_width;\par
02321     IM_ASSERT(column_0_width > 0.0f && column_1_width > 0.0f);\par
02322     column_0->WidthRequest = column_0_width;\par
02323     column_1->WidthRequest = column_1_width;\par
02324     {\cf19 if} ((column_0->Flags | column_1->Flags) & ImGuiTableColumnFlags_WidthStretch)\par
02325         TableUpdateColumnsWeightFromWidth(table);\par
02326     table->IsSettingsDirty = {\cf17 true};\par
02327 \}\par
02328 \par
02329 {\cf20 // Disable clipping then auto-fit, will take 2 frames}\par
02330 {\cf20 // (we don't take a shortcut for unclipped columns to reduce inconsistencies when e.g. resizing multiple columns)}\par
02331 {\cf18 void} ImGui::TableSetColumnWidthAutoSingle(ImGuiTable* table, {\cf18 int} column_n)\par
02332 \{\par
02333     {\cf20 // Single auto width uses auto-fit}\par
02334     ImGuiTableColumn* column = &table->Columns[column_n];\par
02335     {\cf19 if} (!column->IsEnabled)\par
02336         {\cf19 return};\par
02337     column->CannotSkipItemsQueue = (1 << 0);\par
02338     table->AutoFitSingleColumn = (ImGuiTableColumnIdx)column_n;\par
02339 \}\par
02340 \par
02341 {\cf18 void} ImGui::TableSetColumnWidthAutoAll(ImGuiTable* table)\par
02342 \{\par
02343     {\cf19 for} ({\cf18 int} column_n = 0; column_n < table->ColumnsCount; column_n++)\par
02344     \{\par
02345         ImGuiTableColumn* column = &table->Columns[column_n];\par
02346         {\cf19 if} (!column->IsEnabled && !(column->Flags & ImGuiTableColumnFlags_WidthStretch)) {\cf20 // Cannot reset weight of hidden stretch column}\par
02347             {\cf19 continue};\par
02348         column->CannotSkipItemsQueue = (1 << 0);\par
02349         column->AutoFitQueue = (1 << 1);\par
02350     \}\par
02351 \}\par
02352 \par
02353 {\cf18 void} ImGui::TableUpdateColumnsWeightFromWidth(ImGuiTable* table)\par
02354 \{\par
02355     IM_ASSERT(table->LeftMostStretchedColumn != -1 && table->RightMostStretchedColumn != -1);\par
02356 \par
02357     {\cf20 // Measure existing quantities}\par
02358     {\cf18 float} visible_weight = 0.0f;\par
02359     {\cf18 float} visible_width = 0.0f;\par
02360     {\cf19 for} ({\cf18 int} column_n = 0; column_n < table->ColumnsCount; column_n++)\par
02361     \{\par
02362         ImGuiTableColumn* column = &table->Columns[column_n];\par
02363         {\cf19 if} (!column->IsEnabled || !(column->Flags & ImGuiTableColumnFlags_WidthStretch))\par
02364             {\cf19 continue};\par
02365         IM_ASSERT(column->StretchWeight > 0.0f);\par
02366         visible_weight += column->StretchWeight;\par
02367         visible_width += column->WidthRequest;\par
02368     \}\par
02369     IM_ASSERT(visible_weight > 0.0f && visible_width > 0.0f);\par
02370 \par
02371     {\cf20 // Apply new weights}\par
02372     {\cf19 for} ({\cf18 int} column_n = 0; column_n < table->ColumnsCount; column_n++)\par
02373     \{\par
02374         ImGuiTableColumn* column = &table->Columns[column_n];\par
02375         {\cf19 if} (!column->IsEnabled || !(column->Flags & ImGuiTableColumnFlags_WidthStretch))\par
02376             {\cf19 continue};\par
02377         column->StretchWeight = (column->WidthRequest / visible_width) * visible_weight;\par
02378         IM_ASSERT(column->StretchWeight > 0.0f);\par
02379     \}\par
02380 \}\par
