00263 {\cf20 // Helper}\par
00264 {\cf17 inline} ImGuiTableFlags TableFixFlags(ImGuiTableFlags flags, ImGuiWindow* outer_window)\par
00265 \{\par
00266     {\cf20 // Adjust flags: set default sizing policy}\par
00267     {\cf19 if} ((flags & ImGuiTableFlags_SizingMask_) == 0)\par
00268         flags |= ((flags & ImGuiTableFlags_ScrollX) || (outer_window->Flags & ImGuiWindowFlags_AlwaysAutoResize)) ? ImGuiTableFlags_SizingFixedFit : ImGuiTableFlags_SizingStretchSame;\par
00269 \par
00270     {\cf20 // Adjust flags: enable NoKeepColumnsVisible when using ImGuiTableFlags_SizingFixedSame}\par
00271     {\cf19 if} ((flags & ImGuiTableFlags_SizingMask_) == ImGuiTableFlags_SizingFixedSame)\par
00272         flags |= ImGuiTableFlags_NoKeepColumnsVisible;\par
00273 \par
00274     {\cf20 // Adjust flags: enforce borders when resizable}\par
00275     {\cf19 if} (flags & ImGuiTableFlags_Resizable)\par
00276         flags |= ImGuiTableFlags_BordersInnerV;\par
00277 \par
00278     {\cf20 // Adjust flags: disable NoHostExtendX/NoHostExtendY if we have any scrolling going on}\par
00279     {\cf19 if} (flags & (ImGuiTableFlags_ScrollX | ImGuiTableFlags_ScrollY))\par
00280         flags &= ~(ImGuiTableFlags_NoHostExtendX | ImGuiTableFlags_NoHostExtendY);\par
00281 \par
00282     {\cf20 // Adjust flags: NoBordersInBodyUntilResize takes priority over NoBordersInBody}\par
00283     {\cf19 if} (flags & ImGuiTableFlags_NoBordersInBodyUntilResize)\par
00284         flags &= ~ImGuiTableFlags_NoBordersInBody;\par
00285 \par
00286     {\cf20 // Adjust flags: disable saved settings if there's nothing to save}\par
00287     {\cf19 if} ((flags & (ImGuiTableFlags_Resizable | ImGuiTableFlags_Hideable | ImGuiTableFlags_Reorderable | ImGuiTableFlags_Sortable)) == 0)\par
00288         flags |= ImGuiTableFlags_NoSavedSettings;\par
00289 \par
00290     {\cf20 // Inherit _NoSavedSettings from top-level window (child windows always have _NoSavedSettings set)}\par
00291     {\cf19 if} (outer_window->RootWindow->Flags & ImGuiWindowFlags_NoSavedSettings)\par
00292         flags |= ImGuiTableFlags_NoSavedSettings;\par
00293 \par
00294     {\cf19 return} flags;\par
00295 \}\par
