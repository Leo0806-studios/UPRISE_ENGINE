01832 {\cf18 void} ImGui::TableNextRow(ImGuiTableRowFlags row_flags, {\cf18 float} row_min_height)\par
01833 \{\par
01834     ImGuiContext& g = *GImGui;\par
01835     ImGuiTable* table = g.CurrentTable;\par
01836 \par
01837     {\cf19 if} (!table->IsLayoutLocked)\par
01838         TableUpdateLayout(table);\par
01839     {\cf19 if} (table->IsInsideRow)\par
01840         TableEndRow(table);\par
01841 \par
