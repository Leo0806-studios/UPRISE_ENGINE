03585 \par
03586 {\cf18 void} ImGui::TableSaveSettings(ImGuiTable* table)\par
03587 \{\par
03588     table->IsSettingsDirty = {\cf17 false};\par
03589     {\cf19 if} (table->Flags & ImGuiTableFlags_NoSavedSettings)\par
03590         {\cf19 return};\par
03591 \par
03592     {\cf20 // Bind or create settings data}\par
03593     ImGuiContext& g = *GImGui;\par
03594     ImGuiTableSettings* settings = TableGetBoundSettings(table);\par
03595     {\cf19 if} (settings == NULL)\par
03596     \{\par
03597         settings = TableSettingsCreate(table->ID, table->ColumnsCount);\par
03598         table->SettingsOffset = g.SettingsTables.offset_from_ptr(settings);\par
03599     \}\par
03600     settings->ColumnsCount = (ImGuiTableColumnIdx)table->ColumnsCount;\par
03601 \par
03602     {\cf20 // Serialize ImGuiTable/ImGuiTableColumn into ImGuiTableSettings/ImGuiTableColumnSettings}\par
03603     IM_ASSERT(settings->ID == table->ID);\par
03604     IM_ASSERT(settings->ColumnsCount == table->ColumnsCount && settings->ColumnsCountMax >= settings->ColumnsCount);\par
03605     ImGuiTableColumn* column = table->Columns.Data;\par
03606     ImGuiTableColumnSettings* column_settings = settings->GetColumnSettings();\par
03607 \par
03608     {\cf18 bool} save_ref_scale = {\cf17 false};\par
03609     settings->SaveFlags = ImGuiTableFlags_None;\par
03610     {\cf19 for} ({\cf18 int} n = 0; n < table->ColumnsCount; n++, column++, column_settings++)\par
03611     \{\par
03612         {\cf17 const} {\cf18 float} width_or_weight = (column->Flags & ImGuiTableColumnFlags_WidthStretch) ? column->StretchWeight : column->WidthRequest;\par
03613         column_settings->WidthOrWeight = width_or_weight;\par
03614         column_settings->Index = (ImGuiTableColumnIdx)n;\par
03615         column_settings->DisplayOrder = column->DisplayOrder;\par
03616         column_settings->SortOrder = column->SortOrder;\par
03617         column_settings->SortDirection = column->SortDirection;\par
