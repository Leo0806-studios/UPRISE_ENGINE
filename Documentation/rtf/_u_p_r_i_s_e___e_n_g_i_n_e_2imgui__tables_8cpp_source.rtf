02134     \{\par
02135         g.LastItemData.ID = 0;\par
02136         g.LastItemData.StatusFlags = 0;\par
02137     \}\par
02138 \par
02139     {\cf19 if} (table->Flags & ImGuiTableFlags_NoClip)\par
02140     \{\par
02141         {\cf20 // FIXME: if we end up drawing all borders/bg in EndTable, could remove this and just assert that channel hasn't changed.}\par
02142         table->DrawSplitter->SetCurrentChannel(window->DrawList, TABLE_DRAW_CHANNEL_NOCLIP);\par
02143         {\cf20 //IM_ASSERT(table->DrawSplitter._Current == TABLE_DRAW_CHANNEL_NOCLIP);}\par
02144     \}\par
