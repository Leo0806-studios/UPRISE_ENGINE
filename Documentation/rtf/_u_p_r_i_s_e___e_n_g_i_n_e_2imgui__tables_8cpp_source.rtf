01894 {\cf20 // [Internal] Called by TableNextRow()}\par
01895 {\cf18 void} ImGui::TableEndRow(ImGuiTable* table)\par
01896 \{\par
01897     ImGuiContext& g = *GImGui;\par
01898     ImGuiWindow* window = g.CurrentWindow;\par
01899     IM_ASSERT(window == table->InnerWindow);\par
01900     IM_ASSERT(table->IsInsideRow);\par
01901 \par
01902     {\cf19 if} (table->CurrentColumn != -1)\par
01903         TableEndCell(table);\par
01904 \par
01905     {\cf20 // Logging}\par
01906     {\cf19 if} (g.LogEnabled)\par
01907         LogRenderedText(NULL, {\cf22 "|"});\par
01908 \par
01909     {\cf20 // Position cursor at the bottom of our row so it can be used for e.g. clipping calculation. However it is}\par
01910     {\cf20 // likely that the next call to TableBeginCell() will reposition the cursor to take account of vertical padding.}\par
01911     window->DC.CursorPos.y = table->RowPosY2;\par
01912 \par
01913     {\cf20 // Row background fill}\par
01914     {\cf17 const} {\cf18 float} bg_y1 = table->RowPosY1;\par
01915     {\cf17 const} {\cf18 float} bg_y2 = table->RowPosY2;\par
01916     {\cf17 const} {\cf18 bool} unfreeze_rows_actual = (table->CurrentRow + 1 == table->FreezeRowsCount);\par
01917     {\cf17 const} {\cf18 bool} unfreeze_rows_request = (table->CurrentRow + 1 == table->FreezeRowsRequest);\par
01918     ImGuiTableInstanceData* table_instance = TableGetInstanceData(table, table->InstanceCurrent);\par
01919     {\cf19 if} ((table->RowFlags & ImGuiTableRowFlags_Headers) && (table->CurrentRow == 0 || (table->LastRowFlags & ImGuiTableRowFlags_Headers)))\par
01920         table_instance->LastTopHeadersRowHeight += bg_y2 - bg_y1;\par
01921 \par
01922     {\cf17 const} {\cf18 bool} is_visible = (bg_y2 >= table->InnerClipRect.Min.y && bg_y1 <= table->InnerClipRect.Max.y);\par
01923     {\cf19 if} (is_visible)\par
01924     \{\par
01925         {\cf20 // Update data for TableGetHoveredRow()}\par
01926         {\cf19 if} (table->HoveredColumnBody != -1 && g.IO.MousePos.y >= bg_y1 && g.IO.MousePos.y < bg_y2 && table_instance->HoveredRowNext < 0)\par
01927             table_instance->HoveredRowNext = table->CurrentRow;\par
01928 \par
01929         {\cf20 // Decide of background color for the row}\par
01930         ImU32 bg_col0 = 0;\par
01931         ImU32 bg_col1 = 0;\par
01932         {\cf19 if} (table->RowBgColor[0] != IM_COL32_DISABLE)\par
01933             bg_col0 = table->RowBgColor[0];\par
01934         {\cf19 else} {\cf19 if} (table->Flags & ImGuiTableFlags_RowBg)\par
01935             bg_col0 = GetColorU32((table->RowBgColorCounter & 1) ? ImGuiCol_TableRowBgAlt : ImGuiCol_TableRowBg);\par
01936         {\cf19 if} (table->RowBgColor[1] != IM_COL32_DISABLE)\par
01937             bg_col1 = table->RowBgColor[1];\par
01938 \par
01939         {\cf20 // Decide of top border color}\par
01940         ImU32 top_border_col = 0;\par
01941         {\cf17 const} {\cf18 float} border_size = TABLE_BORDER_SIZE;\par
01942         {\cf19 if} (table->CurrentRow > 0 && (table->Flags & ImGuiTableFlags_BordersInnerH))\par
01943             top_border_col = (table->LastRowFlags & ImGuiTableRowFlags_Headers) ? table->BorderColorStrong : table->BorderColorLight;\par
01944 \par
01945         {\cf17 const} {\cf18 bool} draw_cell_bg_color = table->RowCellDataCurrent >= 0;\par
01946         {\cf17 const} {\cf18 bool} draw_strong_bottom_border = unfreeze_rows_actual;\par
01947         {\cf19 if} ((bg_col0 | bg_col1 | top_border_col) != 0 || draw_strong_bottom_border || draw_cell_bg_color)\par
01948         \{\par
01949             {\cf20 // In theory we could call SetWindowClipRectBeforeSetChannel() but since we know TableEndRow() is}\par
01950             {\cf20 // always followed by a change of clipping rectangle we perform the smallest overwrite possible here.}\par
01951             {\cf19 if} ((table->Flags & ImGuiTableFlags_NoClip) == 0)\par
01952                 window->DrawList->_CmdHeader.ClipRect = table->Bg0ClipRectForDrawCmd.ToVec4();\par
01953             table->DrawSplitter->SetCurrentChannel(window->DrawList, TABLE_DRAW_CHANNEL_BG0);\par
01954         \}\par
01955 \par
01956         {\cf20 // Draw row background}\par
01957         {\cf20 // We soft/cpu clip this so all backgrounds and borders can share the same clipping rectangle}\par
01958         {\cf19 if} (bg_col0 || bg_col1)\par
01959         \{\par
01960             ImRect row_rect(table->WorkRect.Min.x, bg_y1, table->WorkRect.Max.x, bg_y2);\par
01961             row_rect.ClipWith(table->BgClipRect);\par
01962             {\cf19 if} (bg_col0 != 0 && row_rect.Min.y < row_rect.Max.y)\par
01963                 window->DrawList->AddRectFilled(row_rect.Min, row_rect.Max, bg_col0);\par
01964             {\cf19 if} (bg_col1 != 0 && row_rect.Min.y < row_rect.Max.y)\par
01965                 window->DrawList->AddRectFilled(row_rect.Min, row_rect.Max, bg_col1);\par
01966         \}\par
01967 \par
01968         {\cf20 // Draw cell background color}\par
01969         {\cf19 if} (draw_cell_bg_color)\par
01970         \{\par
01971             ImGuiTableCellData* cell_data_end = &table->RowCellData[table->RowCellDataCurrent];\par
01972             {\cf19 for} (ImGuiTableCellData* cell_data = &table->RowCellData[0]; cell_data <= cell_data_end; cell_data++)\par
01973             \{\par
01974                 {\cf20 // As we render the BG here we need to clip things (for layout we would not)}\par
01975                 {\cf20 // FIXME: This cancels the OuterPadding addition done by TableGetCellBgRect(), need to keep it while rendering correctly while scrolling.}\par
01976                 {\cf17 const} ImGuiTableColumn* column = &table->Columns[cell_data->Column];\par
01977                 ImRect cell_bg_rect = TableGetCellBgRect(table, cell_data->Column);\par
01978                 cell_bg_rect.ClipWith(table->BgClipRect);\par
01979                 cell_bg_rect.Min.x = ImMax(cell_bg_rect.Min.x, column->ClipRect.Min.x);     {\cf20 // So that first column after frozen one gets clipped when scrolling}\par
01980                 cell_bg_rect.Max.x = ImMin(cell_bg_rect.Max.x, column->MaxX);\par
01981                 {\cf19 if} (cell_bg_rect.Min.y < cell_bg_rect.Max.y)\par
01982                     window->DrawList->AddRectFilled(cell_bg_rect.Min, cell_bg_rect.Max, cell_data->BgColor);\par
01983             \}\par
01984         \}\par
01985 \par
01986         {\cf20 // Draw top border}\par
01987         {\cf19 if} (top_border_col && bg_y1 >= table->BgClipRect.Min.y && bg_y1 < table->BgClipRect.Max.y)\par
01988             window->DrawList->AddLine(ImVec2(table->BorderX1, bg_y1), ImVec2(table->BorderX2, bg_y1), top_border_col, border_size);\par
01989 \par
01990         {\cf20 // Draw bottom border at the row unfreezing mark (always strong)}\par
01991         {\cf19 if} (draw_strong_bottom_border && bg_y2 >= table->BgClipRect.Min.y && bg_y2 < table->BgClipRect.Max.y)\par
01992             window->DrawList->AddLine(ImVec2(table->BorderX1, bg_y2), ImVec2(table->BorderX2, bg_y2), table->BorderColorStrong, border_size);\par
01993     \}\par
01994 \par
01995     {\cf20 // End frozen rows (when we are past the last frozen row line, teleport cursor and alter clipping rectangle)}\par
01996     {\cf20 // We need to do that in TableEndRow() instead of TableBeginRow() so the list clipper can mark end of row and}\par
01997     {\cf20 // get the new cursor position.}\par
01998     {\cf19 if} (unfreeze_rows_request)\par
01999     \{\par
02000         {\cf19 for} ({\cf18 int} column_n = 0; column_n < table->ColumnsCount; column_n++)\par
02001             table->Columns[column_n].NavLayerCurrent = ImGuiNavLayer_Main;\par
02002         {\cf17 const} {\cf18 float} y0 = ImMax(table->RowPosY2 + 1, window->InnerClipRect.Min.y);\par
02003         table_instance->LastFrozenHeight = y0 - table->OuterRect.Min.y;\par
02004 \par
02005         {\cf19 if} (unfreeze_rows_actual)\par
02006         \{\par
02007             IM_ASSERT(table->IsUnfrozenRows == {\cf17 false});\par
02008             table->IsUnfrozenRows = {\cf17 true};\par
02009 \par
02010             {\cf20 // BgClipRect starts as table->InnerClipRect, reduce it now and make BgClipRectForDrawCmd == BgClipRect}\par
02011             table->BgClipRect.Min.y = table->Bg2ClipRectForDrawCmd.Min.y = ImMin(y0, window->InnerClipRect.Max.y);\par
02012             table->BgClipRect.Max.y = table->Bg2ClipRectForDrawCmd.Max.y = window->InnerClipRect.Max.y;\par
02013             table->Bg2DrawChannelCurrent = table->Bg2DrawChannelUnfrozen;\par
02014             IM_ASSERT(table->Bg2ClipRectForDrawCmd.Min.y <= table->Bg2ClipRectForDrawCmd.Max.y);\par
02015 \par
02016             {\cf18 float} row_height = table->RowPosY2 - table->RowPosY1;\par
02017             table->RowPosY2 = window->DC.CursorPos.y = table->WorkRect.Min.y + table->RowPosY2 - table->OuterRect.Min.y;\par
02018             table->RowPosY1 = table->RowPosY2 - row_height;\par
02019             {\cf19 for} ({\cf18 int} column_n = 0; column_n < table->ColumnsCount; column_n++)\par
02020             \{\par
02021                 ImGuiTableColumn* column = &table->Columns[column_n];\par
02022                 column->DrawChannelCurrent = column->DrawChannelUnfrozen;\par
02023                 column->ClipRect.Min.y = table->Bg2ClipRectForDrawCmd.Min.y;\par
02024             \}\par
02025 \par
02026             {\cf20 // Update cliprect ahead of TableBeginCell() so clipper can access to new ClipRect->Min.y}\par
02027             SetWindowClipRectBeforeSetChannel(window, table->Columns[0].ClipRect);\par
02028             table->DrawSplitter->SetCurrentChannel(window->DrawList, table->Columns[0].DrawChannelCurrent);\par
02029         \}\par
02030     \}\par
02031 \par
02032     {\cf19 if} (!(table->RowFlags & ImGuiTableRowFlags_Headers))\par
02033         table->RowBgColorCounter++;\par
02034     table->IsInsideRow = {\cf17 false};\par
02035 \}\par
