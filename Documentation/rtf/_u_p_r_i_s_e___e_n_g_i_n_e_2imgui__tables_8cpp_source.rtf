03427             {\cf19 if} (MenuItem(LocalizeGetMsg(ImGuiLocKey_TableSizeOne), NULL, {\cf17 false}, can_resize)) {\cf20 // "###SizeOne"}\par
03428                 TableSetColumnWidthAutoSingle(table, column_n);\par
03429         \}\par
03430 \par
