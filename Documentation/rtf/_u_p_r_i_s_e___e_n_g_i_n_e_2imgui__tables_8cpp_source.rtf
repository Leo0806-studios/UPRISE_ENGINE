00620 {\cf20 // For reference, the average total _allocation count_ for a table is:}\par
00621 {\cf20 // + 0 (for ImGuiTable instance, we are pooling allocations in g.Tables[])}\par
00622 {\cf20 // + 1 (for table->RawData allocated below)}\par
00623 {\cf20 // + 1 (for table->ColumnsNames, if names are used)}\par
00624 {\cf20 // Shared allocations for the maximum number of simultaneously nested tables (generally a very small number)}\par
00625 {\cf20 // + 1 (for table->Splitter._Channels)}\par
00626 {\cf20 // + 2 * active_channels_count (for ImDrawCmd and ImDrawIdx buffers inside channels)}\par
00627 {\cf20 // Where active_channels_count is variable but often == columns_count or == columns_count + 1, see TableSetupDrawChannels() for details.}\par
00628 {\cf20 // Unused channels don't perform their +2 allocations.}\par
00629 {\cf18 void} ImGui::TableBeginInitMemory(ImGuiTable* table, {\cf18 int} columns_count)\par
00630 \{\par
00631     {\cf20 // Allocate single buffer for our arrays}\par
00632     {\cf17 const} {\cf18 int} columns_bit_array_size = (int)ImBitArrayGetStorageSizeInBytes(columns_count);\par
