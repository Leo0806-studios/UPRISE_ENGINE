02869 {\cf18 void} ImGui::TableSortSpecsSanitize(ImGuiTable* table)\par
02870 \{\par
02871     IM_ASSERT(table->Flags & ImGuiTableFlags_Sortable);\par
02872 \par
02873     {\cf20 // Clear SortOrder from hidden column and verify that there's no gap or duplicate.}\par
02874     {\cf18 int} sort_order_count = 0;\par
02875     ImU64 sort_order_mask = 0x00;\par
02876     {\cf19 for} ({\cf18 int} column_n = 0; column_n < table->ColumnsCount; column_n++)\par
02877     \{\par
02878         ImGuiTableColumn* column = &table->Columns[column_n];\par
02879         {\cf19 if} (column->SortOrder != -1 && !column->IsEnabled)\par
02880             column->SortOrder = -1;\par
02881         {\cf19 if} (column->SortOrder == -1)\par
02882             {\cf19 continue};\par
02883         sort_order_count++;\par
02884         sort_order_mask |= ((ImU64)1 << column->SortOrder);\par
02885         IM_ASSERT(sort_order_count < ({\cf18 int}){\cf17 sizeof}(sort_order_mask) * 8);\par
02886     \}\par
02887 \par
02888     {\cf17 const} {\cf18 bool} need_fix_linearize = ((ImU64)1 << sort_order_count) != (sort_order_mask + 1);\par
02889     {\cf17 const} {\cf18 bool} need_fix_single_sort_order = (sort_order_count > 1) && !(table->Flags & ImGuiTableFlags_SortMulti);\par
02890     {\cf19 if} (need_fix_linearize || need_fix_single_sort_order)\par
02891     \{\par
02892         ImU64 fixed_mask = 0x00;\par
02893         {\cf19 for} ({\cf18 int} sort_n = 0; sort_n < sort_order_count; sort_n++)\par
02894         \{\par
02895             {\cf20 // Fix: Rewrite sort order fields if needed so they have no gap or duplicate.}\par
02896             {\cf20 // (e.g. SortOrder 0 disappeared, SortOrder 1..2 exists --> rewrite then as SortOrder 0..1)}\par
02897             {\cf18 int} column_with_smallest_sort_order = -1;\par
02898             {\cf19 for} ({\cf18 int} column_n = 0; column_n < table->ColumnsCount; column_n++)\par
02899                 {\cf19 if} ((fixed_mask & ((ImU64)1 << (ImU64)column_n)) == 0 && table->Columns[column_n].SortOrder != -1)\par
02900                     {\cf19 if} (column_with_smallest_sort_order == -1 || table->Columns[column_n].SortOrder < table->Columns[column_with_smallest_sort_order].SortOrder)\par
02901                         column_with_smallest_sort_order = column_n;\par
02902             IM_ASSERT(column_with_smallest_sort_order != -1);\par
02903             fixed_mask |= ((ImU64)1 << column_with_smallest_sort_order);\par
02904             table->Columns[column_with_smallest_sort_order].SortOrder = (ImGuiTableColumnIdx)sort_n;\par
02905 \par
02906             {\cf20 // Fix: Make sure only one column has a SortOrder if ImGuiTableFlags_MultiSortable is not set.}\par
02907             {\cf19 if} (need_fix_single_sort_order)\par
02908             \{\par
02909                 sort_order_count = 1;\par
02910                 {\cf19 for} ({\cf18 int} column_n = 0; column_n < table->ColumnsCount; column_n++)\par
02911                     {\cf19 if} (column_n != column_with_smallest_sort_order)\par
02912                         table->Columns[column_n].SortOrder = -1;\par
02913                 {\cf19 break};\par
02914             \}\par
02915         \}\par
02916     \}\par
02917 \par
02918     {\cf20 // Fallback default sort order (if no column with the ImGuiTableColumnFlags_DefaultSort flag)}\par
02919     {\cf19 if} (sort_order_count == 0 && !(table->Flags & ImGuiTableFlags_SortTristate))\par
02920         {\cf19 for} ({\cf18 int} column_n = 0; column_n < table->ColumnsCount; column_n++)\par
02921         \{\par
02922             ImGuiTableColumn* column = &table->Columns[column_n];\par
02923             {\cf19 if} (column->IsEnabled && !(column->Flags & ImGuiTableColumnFlags_NoSort))\par
02924             \{\par
02925                 sort_order_count = 1;\par
02926                 column->SortOrder = 0;\par
02927                 column->SortDirection = (ImU8)TableGetColumnAvailSortDirection(column, 0);\par
02928                 {\cf19 break};\par
02929             \}\par
02930         \}\par
02931 \par
02932     table->SortSpecsCount = (ImGuiTableColumnIdx)sort_order_count;\par
02933 \}\par
