01871     {\cf18 float} next_y1 = table->RowPosY2;\par
01872     {\cf19 if} (table->CurrentRow == 0 && table->FreezeRowsCount > 0)\par
01873         next_y1 = window->DC.CursorPos.y = table->OuterRect.Min.y;\par
