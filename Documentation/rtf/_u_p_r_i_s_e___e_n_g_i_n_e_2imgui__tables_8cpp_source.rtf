01875     table->RowPosY1 = table->RowPosY2 = next_y1;\par
01876     table->RowTextBaseline = 0.0f;\par
01877     table->RowIndentOffsetX = window->DC.Indent.x - table->HostIndentX; {\cf20 // Lock indent}\par
01878 \par
01879     window->DC.PrevLineTextBaseOffset = 0.0f;\par
01880     window->DC.CursorPosPrevLine = ImVec2(window->DC.CursorPos.x, window->DC.CursorPos.y + table->RowCellPaddingY); {\cf20 // This allows users to call SameLine() to share LineSize between columns.}\par
01881     window->DC.PrevLineSize = window->DC.CurrLineSize = ImVec2(0.0f, 0.0f); {\cf20 // This allows users to call SameLine() to share LineSize between columns, and to call it from first column too.}\par
01882     window->DC.IsSameLine = window->DC.IsSetPos = {\cf17 false};\par
01883     window->DC.CursorMaxPos.y = next_y1;\par
01884 \par
01885     {\cf20 // Making the header BG color non-transparent will allow us to overlay it multiple times when handling smooth dragging.}\par
01886     {\cf19 if} (table->RowFlags & ImGuiTableRowFlags_Headers)\par
01887     \{\par
01888         TableSetBgColor(ImGuiTableBgTarget_RowBg0, GetColorU32(ImGuiCol_TableHeaderBg));\par
