04058 {\cf18 float} ImGui::GetColumnNormFromOffset({\cf17 const} ImGuiOldColumns* columns, {\cf18 float} offset)\par
04059 \{\par
04060     {\cf19 return} offset / (columns->OffMaxX - columns->OffMinX);\par
04061 \}\par
04062 \par
04063 {\cf17 static} {\cf17 const} {\cf18 float} COLUMNS_HIT_RECT_HALF_THICKNESS = 4.0f;\par
04064 \par
04065 {\cf17 static} {\cf18 float} GetDraggedColumnOffset(ImGuiOldColumns* columns, {\cf18 int} column_index)\par
04066 \{\par
04067     {\cf20 // Active (dragged) column always follow mouse. The reason we need this is that dragging a column to the right edge of an auto-resizing}\par
04068     {\cf20 // window creates a feedback loop because we store normalized positions. So while dragging we enforce absolute positioning.}\par
04069     ImGuiContext& g = *GImGui;\par
04070     ImGuiWindow* window = g.CurrentWindow;\par
04071     IM_ASSERT(column_index > 0); {\cf20 // We are not supposed to drag column 0.}\par
04072     IM_ASSERT(g.ActiveId == columns->ID + ImGuiID(column_index));\par
04073 \par
04074     {\cf18 float} x = g.IO.MousePos.x - g.ActiveIdClickOffset.x + ImTrunc(COLUMNS_HIT_RECT_HALF_THICKNESS * g.CurrentDpiScale) - window->Pos.x;\par
04075     x = ImMax(x, ImGui::GetColumnOffset(column_index - 1) + g.Style.ColumnsMinSpacing);\par
04076     {\cf19 if} ((columns->Flags & ImGuiOldColumnFlags_NoPreserveWidths))\par
04077         x = ImMin(x, ImGui::GetColumnOffset(column_index + 1) - g.Style.ColumnsMinSpacing);\par
04078 \par
04079     {\cf19 return} x;\par
04080 \}\par
04081 \par
04082 {\cf18 float} ImGui::GetColumnOffset({\cf18 int} column_index)\par
04083 \{\par
04084     ImGuiWindow* window = GetCurrentWindowRead();\par
04085     ImGuiOldColumns* columns = window->DC.CurrentColumns;\par
04086     {\cf19 if} (columns == NULL)\par
04087         {\cf19 return} 0.0f;\par
04088 \par
04089     {\cf19 if} (column_index < 0)\par
04090         column_index = columns->Current;\par
04091     IM_ASSERT(column_index < columns->Columns.Size);\par
04092 \par
04093     {\cf17 const} {\cf18 float} t = columns->Columns[column_index].OffsetNorm;\par
04094     {\cf17 const} {\cf18 float} x_offset = ImLerp(columns->OffMinX, columns->OffMaxX, t);\par
04095     {\cf19 return} x_offset;\par
04096 \}\par
04097 \par
04098 {\cf17 static} {\cf18 float} GetColumnWidthEx(ImGuiOldColumns* columns, {\cf18 int} column_index, {\cf18 bool} before_resize = {\cf17 false})\par
04099 \{\par
04100     {\cf19 if} (column_index < 0)\par
04101         column_index = columns->Current;\par
04102 \par
04103     {\cf18 float} offset_norm;\par
04104     {\cf19 if} (before_resize)\par
04105         offset_norm = columns->Columns[column_index + 1].OffsetNormBeforeResize - columns->Columns[column_index].OffsetNormBeforeResize;\par
04106     {\cf19 else}\par
04107         offset_norm = columns->Columns[column_index + 1].OffsetNorm - columns->Columns[column_index].OffsetNorm;\par
04108     {\cf19 return} ImGui::GetColumnOffsetFromNorm(columns, offset_norm);\par
04109 \}\par
