02077 {\cf20 // [Public] Append into the next column, wrap and create a new row when already on last column}\par
02078 {\cf18 bool} ImGui::TableNextColumn()\par
02079 \{\par
02080     ImGuiContext& g = *GImGui;\par
02081     ImGuiTable* table = g.CurrentTable;\par
02082     {\cf19 if} (!table)\par
02083         {\cf19 return} {\cf17 false};\par
