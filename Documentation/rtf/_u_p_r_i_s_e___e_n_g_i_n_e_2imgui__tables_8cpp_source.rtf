04124 {\cf18 void} ImGui::SetColumnOffset({\cf18 int} column_index, {\cf18 float} offset)\par
04125 \{\par
04126     ImGuiContext& g = *GImGui;\par
04127     ImGuiWindow* window = g.CurrentWindow;\par
04128     ImGuiOldColumns* columns = window->DC.CurrentColumns;\par
04129     IM_ASSERT(columns != NULL);\par
04130 \par
04131     {\cf19 if} (column_index < 0)\par
04132         column_index = columns->Current;\par
04133     IM_ASSERT(column_index < columns->Columns.Size);\par
04134 \par
04135     {\cf17 const} {\cf18 bool} preserve_width = !(columns->Flags & ImGuiOldColumnFlags_NoPreserveWidths) && (column_index < columns->Count - 1);\par
04136     {\cf17 const} {\cf18 float} width = preserve_width ? GetColumnWidthEx(columns, column_index, columns->IsBeingResized) : 0.0f;\par
04137 \par
04138     {\cf19 if} (!(columns->Flags & ImGuiOldColumnFlags_NoForceWithinWindow))\par
04139         offset = ImMin(offset, columns->OffMaxX - g.Style.ColumnsMinSpacing * (columns->Count - column_index));\par
04140     columns->Columns[column_index].OffsetNorm = GetColumnNormFromOffset(columns, offset - columns->OffMinX);\par
04141 \par
04142     {\cf19 if} (preserve_width)\par
04143         SetColumnOffset(column_index + 1, offset + ImMax(g.Style.ColumnsMinSpacing, width));\par
04144 \}\par
