02711             {\cf17 const} {\cf18 bool} is_hovered = (table->HoveredColumnBorder == column_n);\par
02712             {\cf17 const} {\cf18 bool} is_resized = (table->ResizedColumn == column_n) && (table->InstanceInteracted == table->InstanceCurrent);\par
02713             {\cf17 const} {\cf18 bool} is_resizable = (column->Flags & (ImGuiTableColumnFlags_NoResize | ImGuiTableColumnFlags_NoDirectResize_)) == 0;\par
02714             {\cf17 const} {\cf18 bool} is_frozen_separator = (table->FreezeColumnsCount == order_n + 1);\par
02715             {\cf19 if} (column->MaxX > table->InnerClipRect.Max.x && !is_resized)\par
02716                 {\cf19 continue};\par
02717 \par
02718             {\cf20 // Decide whether right-most column is visible}\par
02719             {\cf19 if} (column->NextEnabledColumn == -1 && !is_resizable)\par
