01865     table->CurrentColumn = -1;\par
01866     table->RowBgColor[0] = table->RowBgColor[1] = IM_COL32_DISABLE;\par
01867     table->RowCellDataCurrent = -1;\par
01868     table->IsInsideRow = {\cf17 true};\par
01869 \par
