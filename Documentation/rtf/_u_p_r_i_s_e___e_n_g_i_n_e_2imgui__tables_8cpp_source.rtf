01792         ImGuiTableCellData* cell_data = &table->RowCellData[table->RowCellDataCurrent];\par
01793         cell_data->BgColor = color;\par
01794         cell_data->Column = (ImGuiTableColumnIdx)column_n;\par
01795         {\cf19 break};\par
01796     \}\par
01797     {\cf19 case} ImGuiTableBgTarget_RowBg0:\par
01798     {\cf19 case} ImGuiTableBgTarget_RowBg1:\par
01799     \{\par
01800         {\cf19 if} (table->RowPosY1 > table->InnerClipRect.Max.y) {\cf20 // Discard}\par
01801             {\cf19 return};\par
01802         IM_ASSERT(column_n == -1);\par
01803         {\cf18 int} bg_idx = (target == ImGuiTableBgTarget_RowBg1) ? 1 : 0;\par
01804         table->RowBgColor[bg_idx] = color;\par
01805         {\cf19 break};\par
01806     \}\par
01807     {\cf19 default}:\par
01808         IM_ASSERT(0);\par
01809     \}\par
01810 \}\par
