02694     inner_drawlist->PushClipRect(table->Bg0ClipRectForDrawCmd.Min, table->Bg0ClipRectForDrawCmd.Max, {\cf17 false});\par
02695 \par
02696     {\cf20 // Draw inner border and resizing feedback}\par
02697     ImGuiTableInstanceData* table_instance = TableGetInstanceData(table, table->InstanceCurrent);\par
02698     {\cf17 const} {\cf18 float} border_size = TABLE_BORDER_SIZE;\par
02699     {\cf17 const} {\cf18 float} draw_y1 = ImMax(table->InnerRect.Min.y, (table->FreezeRowsCount >= 1 ? table->InnerRect.Min.y : table->WorkRect.Min.y) + table->AngledHeadersHeight) + ((table->Flags & ImGuiTableFlags_BordersOuterH) ? 1.0f : 0.0f);\par
