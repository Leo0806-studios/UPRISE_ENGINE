03746 {\cf17 static} {\cf18 void} TableSettingsHandler_ReadLine(ImGuiContext*, ImGuiSettingsHandler*, {\cf18 void}* entry, {\cf17 const} {\cf18 char}* line)\par
03747 \{\par
03748     {\cf20 // "Column 0  UserID=0x42AD2D21 Width=100 Visible=1 Order=0 Sort=0v"}\par
03749     ImGuiTableSettings* settings = (ImGuiTableSettings*)entry;\par
03750     {\cf18 float} f = 0.0f;\par
03751     {\cf18 int} column_n = 0, r = 0, n = 0;\par
03752 \par
03753     {\cf19 if} (sscanf(line, {\cf22 "RefScale=%f"}, &f) == 1) \{ settings->RefScale = f; {\cf19 return}; \}\par
03754 \par
03755     {\cf19 if} (sscanf(line, {\cf22 "Column %d%n"}, &column_n, &r) == 1)\par
03756     \{\par
03757         {\cf19 if} (column_n < 0 || column_n >= settings->ColumnsCount)\par
03758             {\cf19 return};\par
03759         line = ImStrSkipBlank(line + r);\par
03760         {\cf18 char} c = 0;\par
03761         ImGuiTableColumnSettings* column = settings->GetColumnSettings() + column_n;\par
03762         column->Index = (ImGuiTableColumnIdx)column_n;\par
03763         {\cf19 if} (sscanf(line, {\cf22 "UserID=0x%08X%n"}, (ImU32*)&n, &r)==1) \{ line = ImStrSkipBlank(line + r); column->UserID = (ImGuiID)n; \}\par
03764         {\cf19 if} (sscanf(line, {\cf22 "Width=%d%n"}, &n, &r) == 1)            \{ line = ImStrSkipBlank(line + r); column->WidthOrWeight = (float)n; column->IsStretch = 0; settings->SaveFlags |= ImGuiTableFlags_Resizable; \}\par
03765         {\cf19 if} (sscanf(line, {\cf22 "Weight=%f%n"}, &f, &r) == 1)           \{ line = ImStrSkipBlank(line + r); column->WidthOrWeight = f; column->IsStretch = 1; settings->SaveFlags |= ImGuiTableFlags_Resizable; \}\par
03766         {\cf19 if} (sscanf(line, {\cf22 "Visible=%d%n"}, &n, &r) == 1)          \{ line = ImStrSkipBlank(line + r); column->IsEnabled = (ImU8)n; settings->SaveFlags |= ImGuiTableFlags_Hideable; \}\par
03767         {\cf19 if} (sscanf(line, {\cf22 "Order=%d%n"}, &n, &r) == 1)            \{ line = ImStrSkipBlank(line + r); column->DisplayOrder = (ImGuiTableColumnIdx)n; settings->SaveFlags |= ImGuiTableFlags_Reorderable; \}\par
03768         {\cf19 if} (sscanf(line, {\cf22 "Sort=%d%c%n"}, &n, &c, &r) == 2)       \{ line = ImStrSkipBlank(line + r); column->SortOrder = (ImGuiTableColumnIdx)n; column->SortDirection = (c == {\cf23 '^'}) ? ImGuiSortDirection_Descending : ImGuiSortDirection_Ascending; settings->SaveFlags |= ImGuiTableFlags_Sortable; \}\par
03769     \}\par
03770 \}\par
