04029 {\cf20 // [Internal] Small optimization to avoid calls to PopClipRect/SetCurrentChannel/PushClipRect in sequences,}\par
04030 {\cf20 // they would meddle many times with the underlying ImDrawCmd.}\par
04031 {\cf20 // Instead, we do a preemptive overwrite of clipping rectangle _without_ altering the command-buffer and let}\par
04032 {\cf20 // the subsequent single call to SetCurrentChannel() does it things once.}\par
04033 {\cf18 void} ImGui::SetWindowClipRectBeforeSetChannel(ImGuiWindow* window, {\cf17 const} ImRect& clip_rect)\par
04034 \{\par
04035     ImVec4 clip_rect_vec4 = clip_rect.ToVec4();\par
04036     window->ClipRect = clip_rect;\par
04037     window->DrawList->_CmdHeader.ClipRect = clip_rect_vec4;\par
04038     window->DrawList->_ClipRectStack.Data[window->DrawList->_ClipRectStack.Size - 1] = clip_rect_vec4;\par
04039 \}\par
