03193 {\cf20 // Unlike TableHeadersRow() it is not expected that you can reimplement or customize this with custom widgets.}\par
03194 {\cf20 // FIXME: No hit-testing/button on the angled header.}\par
03195 {\cf18 void} ImGui::TableAngledHeadersRow()\par
03196 \{\par
03197     ImGuiContext& g = *GImGui;\par
