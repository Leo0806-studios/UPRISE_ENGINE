02160 {\cf20 // [Internal] Called by TableNextRow()/TableSetColumnIndex()/TableNextColumn()}\par
02161 {\cf18 void} ImGui::TableEndCell(ImGuiTable* table)\par
02162 \{\par
02163     ImGuiTableColumn* column = &table->Columns[table->CurrentColumn];\par
02164     ImGuiWindow* window = table->InnerWindow;\par
