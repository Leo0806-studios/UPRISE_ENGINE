04220 {\cf18 void} ImGui::BeginColumns({\cf17 const} {\cf18 char}* str_id, {\cf18 int} columns_count, ImGuiOldColumnFlags flags)\par
04221 \{\par
04222     ImGuiContext& g = *GImGui;\par
04223     ImGuiWindow* window = GetCurrentWindow();\par
04224 \par
04225     IM_ASSERT(columns_count >= 1);\par
04226     IM_ASSERT(window->DC.CurrentColumns == NULL);   {\cf20 // Nested columns are currently not supported}\par
04227 \par
04228     {\cf20 // Acquire storage for the columns set}\par
04229     ImGuiID {\cf18 id} = GetColumnsID(str_id, columns_count);\par
04230     ImGuiOldColumns* columns = FindOrCreateColumns(window, {\cf18 id});\par
04231     IM_ASSERT(columns->ID == {\cf18 id});\par
04232     columns->Current = 0;\par
04233     columns->Count = columns_count;\par
04234     columns->Flags = flags;\par
04235     window->DC.CurrentColumns = columns;\par
04236     window->DC.NavIsScrollPushableX = {\cf17 false}; {\cf20 // Shortcut for NavUpdateCurrentWindowIsScrollPushableX();}\par
04237 \par
04238     columns->HostCursorPosY = window->DC.CursorPos.y;\par
04239     columns->HostCursorMaxPosX = window->DC.CursorMaxPos.x;\par
04240     columns->HostInitialClipRect = window->ClipRect;\par
04241     columns->HostBackupParentWorkRect = window->ParentWorkRect;\par
04242     window->ParentWorkRect = window->WorkRect;\par
04243 \par
04244     {\cf20 // Set state for first column}\par
04245     {\cf20 // We aim so that the right-most column will have the same clipping width as other after being clipped by parent ClipRect}\par
04246     {\cf17 const} {\cf18 float} column_padding = g.Style.ItemSpacing.x;\par
04247     {\cf17 const} {\cf18 float} half_clip_extend_x = ImTrunc(ImMax(window->WindowPadding.x * 0.5f, window->WindowBorderSize));\par
04248     {\cf17 const} {\cf18 float} max_1 = window->WorkRect.Max.x + column_padding - ImMax(column_padding - window->WindowPadding.x, 0.0f);\par
04249     {\cf17 const} {\cf18 float} max_2 = window->WorkRect.Max.x + half_clip_extend_x;\par
04250     columns->OffMinX = window->DC.Indent.x - column_padding + ImMax(column_padding - window->WindowPadding.x, 0.0f);\par
04251     columns->OffMaxX = ImMax(ImMin(max_1, max_2) - window->Pos.x, columns->OffMinX + 1.0f);\par
04252     columns->LineMinY = columns->LineMaxY = window->DC.CursorPos.y;\par
04253 \par
04254     {\cf20 // Clear data if columns count changed}\par
04255     {\cf19 if} (columns->Columns.Size != 0 && columns->Columns.Size != columns_count + 1)\par
04256         columns->Columns.resize(0);\par
04257 \par
04258     {\cf20 // Initialize default widths}\par
04259     columns->IsFirstFrame = (columns->Columns.Size == 0);\par
04260     {\cf19 if} (columns->Columns.Size == 0)\par
04261     \{\par
04262         columns->Columns.reserve(columns_count + 1);\par
04263         {\cf19 for} ({\cf18 int} n = 0; n < columns_count + 1; n++)\par
04264         \{\par
04265             ImGuiOldColumnData column;\par
04266             column.OffsetNorm = n / (float)columns_count;\par
04267             columns->Columns.push_back(column);\par
04268         \}\par
04269     \}\par
04270 \par
04271     {\cf19 for} ({\cf18 int} n = 0; n < columns_count; n++)\par
04272     \{\par
04273         {\cf20 // Compute clipping rectangle}\par
04274         ImGuiOldColumnData* column = &columns->Columns[n];\par
04275         {\cf18 float} clip_x1 = IM_ROUND(window->Pos.x + GetColumnOffset(n));\par
04276         {\cf18 float} clip_x2 = IM_ROUND(window->Pos.x + GetColumnOffset(n + 1) - 1.0f);\par
04277         column->ClipRect = ImRect(clip_x1, -FLT_MAX, clip_x2, +FLT_MAX);\par
04278         column->ClipRect.ClipWithFull(window->ClipRect);\par
04279     \}\par
04280 \par
04281     {\cf19 if} (columns->Count > 1)\par
04282     \{\par
04283         columns->Splitter.Split(window->DrawList, 1 + columns->Count);\par
04284         columns->Splitter.SetCurrentChannel(window->DrawList, 1);\par
04285         PushColumnClipRect(0);\par
04286     \}\par
04287 \par
04288     {\cf20 // We don't generally store Indent.x inside ColumnsOffset because it may be manipulated by the user.}\par
04289     {\cf18 float} offset_0 = GetColumnOffset(columns->Current);\par
04290     {\cf18 float} offset_1 = GetColumnOffset(columns->Current + 1);\par
04291     {\cf18 float} width = offset_1 - offset_0;\par
04292     PushItemWidth(width * 0.65f);\par
04293     window->DC.ColumnsOffset.x = ImMax(column_padding - window->WindowPadding.x, 0.0f);\par
04294     window->DC.CursorPos.x = IM_TRUNC(window->Pos.x + window->DC.Indent.x + window->DC.ColumnsOffset.x);\par
04295     window->WorkRect.Max.x = window->Pos.x + offset_1 - column_padding;\par
04296     window->WorkRect.Max.y = window->ContentRegionRect.Max.y;\par
04297 \}\par
04298 \par
04299 {\cf18 void} ImGui::NextColumn()\par
04300 \{\par
04301     ImGuiWindow* window = GetCurrentWindow();\par
04302     {\cf19 if} (window->SkipItems || window->DC.CurrentColumns == NULL)\par
04303         {\cf19 return};\par
04304 \par
04305     ImGuiContext& g = *GImGui;\par
04306     ImGuiOldColumns* columns = window->DC.CurrentColumns;\par
04307 \par
04308     {\cf19 if} (columns->Count == 1)\par
04309     \{\par
04310         window->DC.CursorPos.x = IM_TRUNC(window->Pos.x + window->DC.Indent.x + window->DC.ColumnsOffset.x);\par
04311         IM_ASSERT(columns->Current == 0);\par
04312         {\cf19 return};\par
04313     \}\par
04314 \par
04315     {\cf20 // Next column}\par
04316     {\cf19 if} (++columns->Current == columns->Count)\par
04317         columns->Current = 0;\par
04318 \par
04319     PopItemWidth();\par
04320 \par
04321     {\cf20 // Optimization: avoid PopClipRect() + SetCurrentChannel() + PushClipRect()}\par
04322     {\cf20 // (which would needlessly attempt to update commands in the wrong channel, then pop or overwrite them),}\par
04323     ImGuiOldColumnData* column = &columns->Columns[columns->Current];\par
04324     SetWindowClipRectBeforeSetChannel(window, column->ClipRect);\par
04325     columns->Splitter.SetCurrentChannel(window->DrawList, columns->Current + 1);\par
04326 \par
04327     {\cf17 const} {\cf18 float} column_padding = g.Style.ItemSpacing.x;\par
04328     columns->LineMaxY = ImMax(columns->LineMaxY, window->DC.CursorPos.y);\par
04329     {\cf19 if} (columns->Current > 0)\par
04330     \{\par
04331         {\cf20 // Columns 1+ ignore IndentX (by canceling it out)}\par
04332         {\cf20 // FIXME-COLUMNS: Unnecessary, could be locked?}\par
04333         window->DC.ColumnsOffset.x = GetColumnOffset(columns->Current) - window->DC.Indent.x + column_padding;\par
04334     \}\par
04335     {\cf19 else}\par
04336     \{\par
04337         {\cf20 // New row/line: column 0 honor IndentX.}\par
04338         window->DC.ColumnsOffset.x = ImMax(column_padding - window->WindowPadding.x, 0.0f);\par
04339         window->DC.IsSameLine = {\cf17 false};\par
04340         columns->LineMinY = columns->LineMaxY;\par
04341     \}\par
04342     window->DC.CursorPos.x = IM_TRUNC(window->Pos.x + window->DC.Indent.x + window->DC.ColumnsOffset.x);\par
04343     window->DC.CursorPos.y = columns->LineMinY;\par
04344     window->DC.CurrLineSize = ImVec2(0.0f, 0.0f);\par
04345     window->DC.CurrLineTextBaseOffset = 0.0f;\par
04346 \par
04347     {\cf20 // FIXME-COLUMNS: Share code with BeginColumns() - move code on columns setup.}\par
04348     {\cf18 float} offset_0 = GetColumnOffset(columns->Current);\par
04349     {\cf18 float} offset_1 = GetColumnOffset(columns->Current + 1);\par
04350     {\cf18 float} width = offset_1 - offset_0;\par
04351     PushItemWidth(width * 0.65f);\par
04352     window->WorkRect.Max.x = window->Pos.x + offset_1 - column_padding;\par
04353 \}\par
04354 \par
04355 {\cf18 void} ImGui::EndColumns()\par
04356 \{\par
04357     ImGuiContext& g = *GImGui;\par
04358     ImGuiWindow* window = GetCurrentWindow();\par
04359     ImGuiOldColumns* columns = window->DC.CurrentColumns;\par
04360     IM_ASSERT(columns != NULL);\par
04361 \par
04362     PopItemWidth();\par
04363     {\cf19 if} (columns->Count > 1)\par
04364     \{\par
04365         PopClipRect();\par
04366         columns->Splitter.Merge(window->DrawList);\par
04367     \}\par
04368 \par
04369     {\cf17 const} ImGuiOldColumnFlags flags = columns->Flags;\par
04370     columns->LineMaxY = ImMax(columns->LineMaxY, window->DC.CursorPos.y);\par
04371     window->DC.CursorPos.y = columns->LineMaxY;\par
04372     {\cf19 if} (!(flags & ImGuiOldColumnFlags_GrowParentContentsSize))\par
04373         window->DC.CursorMaxPos.x = columns->HostCursorMaxPosX;  {\cf20 // Restore cursor max pos, as columns don't grow parent}\par
04374 \par
04375     {\cf20 // Draw columns borders and handle resize}\par
04376     {\cf20 // The IsBeingResized flag ensure we preserve pre-resize columns width so back-and-forth are not lossy}\par
04377     {\cf18 bool} is_being_resized = {\cf17 false};\par
04378     {\cf19 if} (!(flags & ImGuiOldColumnFlags_NoBorder) && !window->SkipItems)\par
04379     \{\par
04380         {\cf20 // We clip Y boundaries CPU side because very long triangles are mishandled by some GPU drivers.}\par
04381         {\cf17 const} {\cf18 float} y1 = ImMax(columns->HostCursorPosY, window->ClipRect.Min.y);\par
04382         {\cf17 const} {\cf18 float} y2 = ImMin(window->DC.CursorPos.y, window->ClipRect.Max.y);\par
04383         {\cf18 int} dragging_column = -1;\par
04384         {\cf19 for} ({\cf18 int} n = 1; n < columns->Count; n++)\par
04385         \{\par
04386             ImGuiOldColumnData* column = &columns->Columns[n];\par
04387             {\cf18 float} x = window->Pos.x + GetColumnOffset(n);\par
04388             {\cf17 const} ImGuiID column_id = columns->ID + ImGuiID(n);\par
04389             {\cf17 const} {\cf18 float} column_hit_hw = ImTrunc(COLUMNS_HIT_RECT_HALF_THICKNESS * g.CurrentDpiScale);\par
04390             {\cf17 const} ImRect column_hit_rect(ImVec2(x - column_hit_hw, y1), ImVec2(x + column_hit_hw, y2));\par
04391             {\cf19 if} (!ItemAdd(column_hit_rect, column_id, NULL, ImGuiItemFlags_NoNav))\par
04392                 {\cf19 continue};\par
04393 \par
04394             {\cf18 bool} hovered = {\cf17 false}, held = {\cf17 false};\par
04395             {\cf19 if} (!(flags & ImGuiOldColumnFlags_NoResize))\par
04396             \{\par
04397                 ButtonBehavior(column_hit_rect, column_id, &hovered, &held);\par
04398                 {\cf19 if} (hovered || held)\par
04399                     g.MouseCursor = ImGuiMouseCursor_ResizeEW;\par
04400                 {\cf19 if} (held && !(column->Flags & ImGuiOldColumnFlags_NoResize))\par
04401                     dragging_column = n;\par
04402             \}\par
04403 \par
04404             {\cf20 // Draw column}\par
04405             {\cf17 const} ImU32 col = GetColorU32(held ? ImGuiCol_SeparatorActive : hovered ? ImGuiCol_SeparatorHovered : ImGuiCol_Separator);\par
04406             {\cf17 const} {\cf18 float} xi = IM_TRUNC(x);\par
04407             window->DrawList->AddLine(ImVec2(xi, y1 + 1.0f), ImVec2(xi, y2), col);\par
04408         \}\par
04409 \par
04410         {\cf20 // Apply dragging after drawing the column lines, so our rendered lines are in sync with how items were displayed during the frame.}\par
04411         {\cf19 if} (dragging_column != -1)\par
04412         \{\par
04413             {\cf19 if} (!columns->IsBeingResized)\par
04414                 {\cf19 for} ({\cf18 int} n = 0; n < columns->Count + 1; n++)\par
04415                     columns->Columns[n].OffsetNormBeforeResize = columns->Columns[n].OffsetNorm;\par
04416             columns->IsBeingResized = is_being_resized = {\cf17 true};\par
04417             {\cf18 float} x = GetDraggedColumnOffset(columns, dragging_column);\par
04418             SetColumnOffset(dragging_column, x);\par
04419         \}\par
04420     \}\par
04421     columns->IsBeingResized = is_being_resized;\par
04422 \par
04423     window->WorkRect = window->ParentWorkRect;\par
04424     window->ParentWorkRect = columns->HostBackupParentWorkRect;\par
04425     window->DC.CurrentColumns = NULL;\par
04426     window->DC.ColumnsOffset.x = 0.0f;\par
04427     window->DC.CursorPos.x = IM_TRUNC(window->Pos.x + window->DC.Indent.x + window->DC.ColumnsOffset.x);\par
04428     NavUpdateCurrentWindowIsScrollPushableX();\par
04429 \}\par
