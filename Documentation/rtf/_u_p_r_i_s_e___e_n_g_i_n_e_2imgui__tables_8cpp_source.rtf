00634     span_allocator.Reserve(0, columns_count * {\cf17 sizeof}(ImGuiTableColumn));\par
00635     span_allocator.Reserve(1, columns_count * {\cf17 sizeof}(ImGuiTableColumnIdx));\par
00636     span_allocator.Reserve(2, columns_count * {\cf17 sizeof}(ImGuiTableCellData), 4);\par
00637     {\cf19 for} ({\cf18 int} n = 3; n < 6; n++)\par
00638         span_allocator.Reserve(n, columns_bit_array_size);\par
00639     table->RawData = IM_ALLOC(span_allocator.GetArenaSizeInBytes());\par
00640     memset(table->RawData, 0, span_allocator.GetArenaSizeInBytes());\par
00641     span_allocator.SetArenaBasePtr(table->RawData);\par
00642     span_allocator.GetSpan(0, &table->Columns);\par
00643     span_allocator.GetSpan(1, &table->DisplayOrderToIndex);\par
00644     span_allocator.GetSpan(2, &table->RowCellData);\par
00645     table->EnabledMaskByDisplayOrder = (ImU32*)span_allocator.GetSpanPtrBegin(3);\par
00646     table->EnabledMaskByIndex = (ImU32*)span_allocator.GetSpanPtrBegin(4);\par
