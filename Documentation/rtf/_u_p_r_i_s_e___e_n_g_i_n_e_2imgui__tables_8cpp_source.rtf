02978 {\cf18 float} ImGui::TableGetHeaderRowHeight()\par
02979 \{\par
02980     {\cf20 // Caring for a minor edge case:}\par
02981     {\cf20 // Calculate row height, for the unlikely case that some labels may be taller than others.}\par
02982     {\cf20 // If we didn't do that, uneven header height would highlight but smaller one before the tallest wouldn't catch input for all height.}\par
02983     {\cf20 // In your custom header row you may omit this all together and just call TableNextRow() without a height...}\par
02984     ImGuiContext& g = *GImGui;\par
02985     ImGuiTable* table = g.CurrentTable;\par
02986     {\cf18 float} row_height = g.FontSize;\par
02987     {\cf19 for} ({\cf18 int} column_n = 0; column_n < table->ColumnsCount; column_n++)\par
02988         {\cf19 if} (IM_BITARRAY_TESTBIT(table->EnabledMaskByIndex, column_n))\par
02989             {\cf19 if} ((table->Columns[column_n].Flags & ImGuiTableColumnFlags_NoHeaderLabel) == 0)\par
02990                 row_height = ImMax(row_height, CalcTextSize(TableGetColumnName(table, column_n)).y);\par
02991     {\cf19 return} row_height + g.Style.CellPadding.y * 2.0f;\par
02992 \}\par
02993 \par
02994 {\cf18 float} ImGui::TableGetHeaderAngledMaxLabelWidth()\par
02995 \{\par
02996     ImGuiContext& g = *GImGui;\par
02997     ImGuiTable* table = g.CurrentTable;\par
02998     {\cf18 float} width = 0.0f;\par
02999     {\cf19 for} ({\cf18 int} column_n = 0; column_n < table->ColumnsCount; column_n++)\par
03000         {\cf19 if} (IM_BITARRAY_TESTBIT(table->EnabledMaskByIndex, column_n))\par
03001             {\cf19 if} (table->Columns[column_n].Flags & ImGuiTableColumnFlags_AngledHeader)\par
03002                 width = ImMax(width, CalcTextSize(TableGetColumnName(table, column_n), NULL, {\cf17 true}).x);\par
03003     {\cf19 return} width + g.Style.CellPadding.y * 2.0f; {\cf20 // Swap padding}\par
03004 \}\par
