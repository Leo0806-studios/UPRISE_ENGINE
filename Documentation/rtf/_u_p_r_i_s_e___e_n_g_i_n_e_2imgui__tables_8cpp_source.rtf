00332     {\cf17 const} ImRect outer_rect(outer_window->DC.CursorPos, outer_window->DC.CursorPos + actual_outer_size);\par
00333     {\cf17 const} {\cf18 bool} outer_window_is_measuring_size = (outer_window->AutoFitFramesX > 0) || (outer_window->AutoFitFramesY > 0); {\cf20 // Doesn't apply to AlwaysAutoResize windows!}\par
00334     {\cf19 if} (use_child_window && IsClippedEx(outer_rect, 0) && !outer_window_is_measuring_size)\par
00335     \{\par
00336         ItemSize(outer_rect);\par
00337         ItemAdd(outer_rect, {\cf18 id});\par
00338         {\cf19 return} {\cf17 false};\par
00339     \}\par
00340 \par
00341     {\cf20 // [DEBUG] Debug break requested by user}\par
00342     {\cf19 if} (g.DebugBreakInTable == {\cf18 id})\par
00343         IM_DEBUG_BREAK();\par
00344 \par
00345     {\cf20 // Acquire storage for the table}\par
00346     ImGuiTable* table = g.Tables.GetOrAddByKey({\cf18 id});\par
00347 \par
00348     {\cf20 // Acquire temporary buffers}\par
00349     {\cf17 const} {\cf18 int} table_idx = g.Tables.GetIndex(table);\par
00350     {\cf19 if} (++g.TablesTempDataStacked > g.TablesTempData.Size)\par
00351         g.TablesTempData.resize(g.TablesTempDataStacked, ImGuiTableTempData());\par
00352     ImGuiTableTempData* temp_data = table->TempData = &g.TablesTempData[g.TablesTempDataStacked - 1];\par
00353     temp_data->TableIndex = table_idx;\par
00354     table->DrawSplitter = &table->TempData->DrawSplitter;\par
00355     table->DrawSplitter->Clear();\par
00356 \par
00357     {\cf20 // Fix flags}\par
00358     table->IsDefaultSizingPolicy = (flags & ImGuiTableFlags_SizingMask_) == 0;\par
00359     flags = TableFixFlags(flags, outer_window);\par
00360 \par
00361     {\cf20 // Initialize}\par
