00708     {\cf19 if} (table->IsResetDisplayOrderRequest)\par
00709     \{\par
00710         {\cf19 for} ({\cf18 int} n = 0; n < table->ColumnsCount; n++)\par
00711             table->DisplayOrderToIndex[n] = table->Columns[n].DisplayOrder = (ImGuiTableColumnIdx)n;\par
