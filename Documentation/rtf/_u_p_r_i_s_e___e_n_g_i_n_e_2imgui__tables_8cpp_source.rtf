04111 {\cf18 float} ImGui::GetColumnWidth({\cf18 int} column_index)\par
04112 \{\par
04113     ImGuiContext& g = *GImGui;\par
04114     ImGuiWindow* window = g.CurrentWindow;\par
04115     ImGuiOldColumns* columns = window->DC.CurrentColumns;\par
04116     {\cf19 if} (columns == NULL)\par
04117         {\cf19 return} GetContentRegionAvail().x;\par
04118 \par
04119     {\cf19 if} (column_index < 0)\par
04120         column_index = columns->Current;\par
04121     {\cf19 return} GetColumnOffsetFromNorm(columns, columns->Columns[column_index + 1].OffsetNorm - columns->Columns[column_index].OffsetNorm);\par
04122 \}\par
