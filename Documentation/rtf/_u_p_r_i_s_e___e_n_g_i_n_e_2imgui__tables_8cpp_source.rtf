02119     window->DC.CursorPos.y = table->RowPosY1 + table->RowCellPaddingY;\par
02120     window->DC.CursorMaxPos.x = window->DC.CursorPos.x;\par
02121     window->DC.ColumnsOffset.x = start_x - window->Pos.x - window->DC.Indent.x; {\cf20 // FIXME-WORKRECT}\par
