04211     {\cf20 // Differentiate column ID with an arbitrary prefix for cases where users name their columns set the same as another widget.}\par
04212     {\cf20 // In addition, when an identifier isn't explicitly provided we include the number of columns in the hash to make it uniquer.}\par
04213     PushID(0x11223347 + (str_id ? 0 : columns_count));\par
04214     ImGuiID {\cf18 id} = window->GetID(str_id ? str_id : {\cf22 "columns"});\par
