02599     {\cf19 if} (merge_group_mask != 0)\par
02600     \{\par
02601         {\cf20 // We skip channel 0 (Bg0/Bg1) and 1 (Bg2 frozen) from the shuffling since they won't move - see channels allocation in TableSetupDrawChannels().}\par
02602         {\cf17 const} {\cf18 int} LEADING_DRAW_CHANNELS = 2;\par
02603         g.DrawChannelsTempMergeBuffer.resize(splitter->_Count - LEADING_DRAW_CHANNELS); {\cf20 // Use shared temporary storage so the allocation gets amortized}\par
02604         ImDrawChannel* dst_tmp = g.DrawChannelsTempMergeBuffer.Data;\par
02605         ImBitArraySetBitRange(remaining_mask, LEADING_DRAW_CHANNELS, splitter->_Count);\par
02606         ImBitArrayClearBit(remaining_mask, table->Bg2DrawChannelUnfrozen);\par
02607         IM_ASSERT(has_freeze_v == {\cf17 false} || table->Bg2DrawChannelUnfrozen != TABLE_DRAW_CHANNEL_BG2_FROZEN);\par
02608         {\cf18 int} remaining_count = splitter->_Count - (has_freeze_v ? LEADING_DRAW_CHANNELS + 1 : LEADING_DRAW_CHANNELS);\par
02609         {\cf20 //ImRect host_rect = (table->InnerWindow == table->OuterWindow) ? table->InnerClipRect : table->HostClipRect;}\par
02610         ImRect host_rect = table->HostClipRect;\par
02611         {\cf19 for} ({\cf18 int} merge_group_n = 0; merge_group_n < IM_ARRAYSIZE(merge_groups); merge_group_n++)\par
02612         \{\par
02613             {\cf19 if} ({\cf18 int} merge_channels_count = merge_groups[merge_group_n].ChannelsCount)\par
02614             \{\par
02615                 MergeGroup* merge_group = &merge_groups[merge_group_n];\par
02616                 ImRect merge_clip_rect = merge_group->ClipRect;\par
02617 \par
02618                 {\cf20 // Extend outer-most clip limits to match those of host, so draw calls can be merged even if}\par
02619                 {\cf20 // outer-most columns have some outer padding offsetting them from their parent ClipRect.}\par
02620                 {\cf20 // The principal cases this is dealing with are:}\par
02621                 {\cf20 // - On a same-window table (not scrolling = single group), all fitting columns ClipRect -> will extend and match host ClipRect -> will merge}\par
02622                 {\cf20 // - Columns can use padding and have left-most ClipRect.Min.x and right-most ClipRect.Max.x != from host ClipRect -> will extend and match host ClipRect -> will merge}\par
02623                 {\cf20 // FIXME-TABLE FIXME-WORKRECT: We are wasting a merge opportunity on tables without scrolling if column doesn't fit}\par
02624                 {\cf20 // within host clip rect, solely because of the half-padding difference between window->WorkRect and window->InnerClipRect.}\par
02625                 {\cf19 if} ((merge_group_n & 1) == 0 || !has_freeze_h)\par
02626                     merge_clip_rect.Min.x = ImMin(merge_clip_rect.Min.x, host_rect.Min.x);\par
02627                 {\cf19 if} ((merge_group_n & 2) == 0 || !has_freeze_v)\par
02628                     merge_clip_rect.Min.y = ImMin(merge_clip_rect.Min.y, host_rect.Min.y);\par
02629                 {\cf19 if} ((merge_group_n & 1) != 0)\par
02630                     merge_clip_rect.Max.x = ImMax(merge_clip_rect.Max.x, host_rect.Max.x);\par
02631                 {\cf19 if} ((merge_group_n & 2) != 0 && (table->Flags & ImGuiTableFlags_NoHostExtendY) == 0)\par
02632                     merge_clip_rect.Max.y = ImMax(merge_clip_rect.Max.y, host_rect.Max.y);\par
02633                 {\cf20 //GetForegroundDrawList()->AddRect(merge_group->ClipRect.Min, merge_group->ClipRect.Max, IM_COL32(255, 0, 0, 200), 0.0f, 0, 1.0f); // [DEBUG]}\par
02634                 {\cf20 //GetForegroundDrawList()->AddLine(merge_group->ClipRect.Min, merge_clip_rect.Min, IM_COL32(255, 100, 0, 200));}\par
02635                 {\cf20 //GetForegroundDrawList()->AddLine(merge_group->ClipRect.Max, merge_clip_rect.Max, IM_COL32(255, 100, 0, 200));}\par
02636                 remaining_count -= merge_group->ChannelsCount;\par
02637                 {\cf19 for} ({\cf18 int} n = 0; n < (size_for_masks_bitarrays_one >> 2); n++)\par
02638                     remaining_mask[n] &= ~merge_group->ChannelsMask[n];\par
02639                 {\cf19 for} ({\cf18 int} n = 0; n < splitter->_Count && merge_channels_count != 0; n++)\par
02640                 \{\par
02641                     {\cf20 // Copy + overwrite new clip rect}\par
02642                     {\cf19 if} (!IM_BITARRAY_TESTBIT(merge_group->ChannelsMask, n))\par
02643                         {\cf19 continue};\par
02644                     IM_BITARRAY_CLEARBIT(merge_group->ChannelsMask, n);\par
02645                     merge_channels_count--;\par
02646 \par
02647                     ImDrawChannel* channel = &splitter->_Channels[n];\par
02648                     IM_ASSERT(channel->_CmdBuffer.Size == 1 && merge_clip_rect.Contains(ImRect(channel->_CmdBuffer[0].ClipRect)));\par
02649                     channel->_CmdBuffer[0].ClipRect = merge_clip_rect.ToVec4();\par
02650                     memcpy(dst_tmp++, channel, {\cf17 sizeof}(ImDrawChannel));\par
02651                 \}\par
02652             \}\par
02653 \par
02654             {\cf20 // Make sure Bg2DrawChannelUnfrozen appears in the middle of our groups (whereas Bg0/Bg1 and Bg2 frozen are fixed to 0 and 1)}\par
02655             {\cf19 if} (merge_group_n == 1 && has_freeze_v)\par
02656                 memcpy(dst_tmp++, &splitter->_Channels[table->Bg2DrawChannelUnfrozen], {\cf17 sizeof}(ImDrawChannel));\par
02657         \}\par
02658 \par
02659         {\cf20 // Append unmergeable channels that we didn't reorder at the end of the list}\par
02660         {\cf19 for} ({\cf18 int} n = 0; n < splitter->_Count && remaining_count != 0; n++)\par
02661         \{\par
02662             {\cf19 if} (!IM_BITARRAY_TESTBIT(remaining_mask, n))\par
02663                 {\cf19 continue};\par
02664             ImDrawChannel* channel = &splitter->_Channels[n];\par
02665             memcpy(dst_tmp++, channel, {\cf17 sizeof}(ImDrawChannel));\par
02666             remaining_count--;\par
02667         \}\par
02668         IM_ASSERT(dst_tmp == g.DrawChannelsTempMergeBuffer.Data + g.DrawChannelsTempMergeBuffer.Size);\par
02669         memcpy(splitter->_Channels.Data + LEADING_DRAW_CHANNELS, g.DrawChannelsTempMergeBuffer.Data, (splitter->_Count - LEADING_DRAW_CHANNELS) * {\cf17 sizeof}(ImDrawChannel));\par
02670     \}\par
02671 \}\par
