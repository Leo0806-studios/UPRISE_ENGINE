00650 {\cf20 // Apply queued resizing/reordering/hiding requests}\par
00651 {\cf18 void} ImGui::TableBeginApplyRequests(ImGuiTable* table)\par
00652 \{\par
00653     {\cf20 // Handle resizing request}\par
00654     {\cf20 // (We process this in the TableBegin() of the first instance of each table)}\par
00655     {\cf20 // FIXME-TABLE: Contains columns if our work area doesn't allow for scrolling?}\par
00656     {\cf19 if} (table->InstanceCurrent == 0)\par
00657     \{\par
00658         {\cf19 if} (table->ResizedColumn != -1 && table->ResizedColumnNextWidth != FLT_MAX)\par
00659             TableSetColumnWidth(table->ResizedColumn, table->ResizedColumnNextWidth);\par
00660         table->LastResizedColumn = table->ResizedColumn;\par
00661         table->ResizedColumnNextWidth = FLT_MAX;\par
00662         table->ResizedColumn = -1;\par
00663 \par
00664         {\cf20 // Process auto-fit for single column, which is a special case for stretch columns and fixed columns with FixedSame policy.}\par
00665         {\cf20 // FIXME-TABLE: Would be nice to redistribute available stretch space accordingly to other weights, instead of giving it all to siblings.}\par
00666         {\cf19 if} (table->AutoFitSingleColumn != -1)\par
00667         \{\par
00668             TableSetColumnWidth(table->AutoFitSingleColumn, table->Columns[table->AutoFitSingleColumn].WidthAuto);\par
00669             table->AutoFitSingleColumn = -1;\par
00670         \}\par
00671     \}\par
00672 \par
00673     {\cf20 // Handle reordering request}\par
00674     {\cf20 // Note: we don't clear ReorderColumn after handling the request.}\par
00675     {\cf19 if} (table->InstanceCurrent == 0)\par
00676     \{\par
00677         {\cf19 if} (table->HeldHeaderColumn == -1 && table->ReorderColumn != -1)\par
00678             table->ReorderColumn = -1;\par
00679         table->HeldHeaderColumn = -1;\par
00680         {\cf19 if} (table->ReorderColumn != -1 && table->ReorderColumnDir != 0)\par
00681         \{\par
00682             {\cf20 // We need to handle reordering across hidden columns.}\par
00683             {\cf20 // In the configuration below, moving C to the right of E will lead to:}\par
00684             {\cf20 //    ... C [D] E  --->  ... [D] E  C   (Column name/index)}\par
00685             {\cf20 //    ... 2  3  4        ...  2  3  4   (Display order)}\par
00686             {\cf17 const} {\cf18 int} reorder_dir = table->ReorderColumnDir;\par
00687             IM_ASSERT(reorder_dir == -1 || reorder_dir == +1);\par
00688             IM_ASSERT(table->Flags & ImGuiTableFlags_Reorderable);\par
00689             ImGuiTableColumn* src_column = &table->Columns[table->ReorderColumn];\par
00690             ImGuiTableColumn* dst_column = &table->Columns[(reorder_dir == -1) ? src_column->PrevEnabledColumn : src_column->NextEnabledColumn];\par
00691             IM_UNUSED(dst_column);\par
00692             {\cf17 const} {\cf18 int} src_order = src_column->DisplayOrder;\par
00693             {\cf17 const} {\cf18 int} dst_order = dst_column->DisplayOrder;\par
00694             src_column->DisplayOrder = (ImGuiTableColumnIdx)dst_order;\par
00695             {\cf19 for} ({\cf18 int} order_n = src_order + reorder_dir; order_n != dst_order + reorder_dir; order_n += reorder_dir)\par
00696                 table->Columns[table->DisplayOrderToIndex[order_n]].DisplayOrder -= (ImGuiTableColumnIdx)reorder_dir;\par
00697             IM_ASSERT(dst_column->DisplayOrder == dst_order - reorder_dir);\par
00698 \par
00699             {\cf20 // Display order is stored in both columns->IndexDisplayOrder and table->DisplayOrder[]. Rebuild later from the former.}\par
00700             {\cf19 for} ({\cf18 int} column_n = 0; column_n < table->ColumnsCount; column_n++)\par
00701                 table->DisplayOrderToIndex[table->Columns[column_n].DisplayOrder] = (ImGuiTableColumnIdx)column_n;\par
00702             table->ReorderColumnDir = 0;\par
00703             table->IsSettingsDirty = {\cf17 true};\par
00704         \}\par
00705     \}\par
00706 \par
