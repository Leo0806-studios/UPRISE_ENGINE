03772 {\cf17 static} {\cf18 void} TableSettingsHandler_WriteAll(ImGuiContext* ctx, ImGuiSettingsHandler* handler, ImGuiTextBuffer* buf)\par
03773 \{\par
03774     ImGuiContext& g = *ctx;\par
03775     {\cf19 for} (ImGuiTableSettings* settings = g.SettingsTables.begin(); settings != NULL; settings = g.SettingsTables.next_chunk(settings))\par
03776     \{\par
03777         {\cf19 if} (settings->ID == 0) {\cf20 // Skip ditched settings}\par
03778             {\cf19 continue};\par
03779 \par
03780         {\cf20 // TableSaveSettings() may clear some of those flags when we establish that the data can be stripped}\par
03781         {\cf20 // (e.g. Order was unchanged)}\par
03782         {\cf17 const} {\cf18 bool} save_size    = (settings->SaveFlags & ImGuiTableFlags_Resizable) != 0;\par
03783         {\cf17 const} {\cf18 bool} save_visible = (settings->SaveFlags & ImGuiTableFlags_Hideable) != 0;\par
03784         {\cf17 const} {\cf18 bool} save_order   = (settings->SaveFlags & ImGuiTableFlags_Reorderable) != 0;\par
03785         {\cf17 const} {\cf18 bool} save_sort    = (settings->SaveFlags & ImGuiTableFlags_Sortable) != 0;\par
03786         {\cf19 if} (!save_size && !save_visible && !save_order && !save_sort)\par
03787             {\cf19 continue};\par
03788 \par
03789         buf->reserve(buf->size() + 30 + settings->ColumnsCount * 50); {\cf20 // ballpark reserve}\par
03790         buf->appendf({\cf22 "[%s][0x%08X,%d]\\n"}, handler->TypeName, settings->ID, settings->ColumnsCount);\par
03791         {\cf19 if} (settings->RefScale != 0.0f)\par
03792             buf->appendf({\cf22 "RefScale=%g\\n"}, settings->RefScale);\par
03793         ImGuiTableColumnSettings* column = settings->GetColumnSettings();\par
03794         {\cf19 for} ({\cf18 int} column_n = 0; column_n < settings->ColumnsCount; column_n++, column++)\par
03795         \{\par
03796             {\cf20 // "Column 0  UserID=0x42AD2D21 Width=100 Visible=1 Order=0 Sort=0v"}\par
03797             {\cf18 bool} save_column = column->UserID != 0 || save_size || save_visible || save_order || (save_sort && column->SortOrder != -1);\par
03798             {\cf19 if} (!save_column)\par
03799                 {\cf19 continue};\par
03800             buf->appendf({\cf22 "Column %-2d"}, column_n);\par
03801             {\cf19 if} (column->UserID != 0)                    \{ buf->appendf({\cf22 " UserID=%08X"}, column->UserID); \}\par
03802             {\cf19 if} (save_size && column->IsStretch)         \{ buf->appendf({\cf22 " Weight=%.4f"}, column->WidthOrWeight); \}\par
03803             {\cf19 if} (save_size && !column->IsStretch)        \{ buf->appendf({\cf22 " Width=%d"}, ({\cf18 int})column->WidthOrWeight); \}\par
03804             {\cf19 if} (save_visible)                           \{ buf->appendf({\cf22 " Visible=%d"}, column->IsEnabled); \}\par
03805             {\cf19 if} (save_order)                             \{ buf->appendf({\cf22 " Order=%d"}, column->DisplayOrder); \}\par
03806             {\cf19 if} (save_sort && column->SortOrder != -1)   \{ buf->appendf({\cf22 " Sort=%d%c"}, column->SortOrder, (column->SortDirection == ImGuiSortDirection_Ascending) ? {\cf23 'v'} : {\cf23 '^'}); \}\par
03807             buf->append({\cf22 "\\n"});\par
03808         \}\par
03809         buf->append({\cf22 "\\n"});\par
03810     \}\par
03811 \}\par
