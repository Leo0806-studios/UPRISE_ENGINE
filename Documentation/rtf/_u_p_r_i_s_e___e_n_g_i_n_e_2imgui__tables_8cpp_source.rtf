02935 {\cf18 void} ImGui::TableSortSpecsBuild(ImGuiTable* table)\par
02936 \{\par
02937     {\cf18 bool} dirty = table->IsSortSpecsDirty;\par
02938     {\cf19 if} (dirty)\par
02939     \{\par
02940         TableSortSpecsSanitize(table);\par
02941         table->SortSpecsMulti.resize(table->SortSpecsCount <= 1 ? 0 : table->SortSpecsCount);\par
02942         table->SortSpecs.SpecsDirty = {\cf17 true}; {\cf20 // Mark as dirty for user}\par
02943         table->IsSortSpecsDirty = {\cf17 false}; {\cf20 // Mark as not dirty for us}\par
02944     \}\par
02945 \par
02946     {\cf20 // Write output}\par
02947     {\cf20 // May be able to move all SortSpecs data from table (48 bytes) to ImGuiTableTempData if we decide to write it back on every BeginTable()}\par
02948     ImGuiTableColumnSortSpecs* sort_specs = (table->SortSpecsCount == 0) ? NULL : (table->SortSpecsCount == 1) ? &table->SortSpecsSingle : table->SortSpecsMulti.Data;\par
02949     {\cf19 if} (dirty && sort_specs != NULL)\par
02950         {\cf19 for} ({\cf18 int} column_n = 0; column_n < table->ColumnsCount; column_n++)\par
02951         \{\par
02952             ImGuiTableColumn* column = &table->Columns[column_n];\par
02953             {\cf19 if} (column->SortOrder == -1)\par
02954                 {\cf19 continue};\par
02955             IM_ASSERT(column->SortOrder < table->SortSpecsCount);\par
02956             ImGuiTableColumnSortSpecs* sort_spec = &sort_specs[column->SortOrder];\par
02957             sort_spec->ColumnUserID = column->UserID;\par
02958             sort_spec->ColumnIndex = (ImGuiTableColumnIdx)column_n;\par
02959             sort_spec->SortOrder = (ImGuiTableColumnIdx)column->SortOrder;\par
02960             sort_spec->SortDirection = (ImGuiSortDirection)column->SortDirection;\par
02961         \}\par
02962 \par
02963     table->SortSpecs.Specs = sort_specs;\par
02964     table->SortSpecs.SpecsCount = table->SortSpecsCount;\par
02965 \}\par
