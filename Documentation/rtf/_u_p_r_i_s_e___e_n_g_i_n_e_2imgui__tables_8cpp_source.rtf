03204     {\cf17 const} ImGuiID row_id = GetID({\cf22 "##AngledHeaders"});\par
03205     ImGuiTableInstanceData* table_instance = TableGetInstanceData(table, table->InstanceCurrent);\par
03206     {\cf18 int} highlight_column_n = table->HighlightColumnHeader;\par
03207     {\cf19 if} (highlight_column_n == -1 && table->HoveredColumnBody != -1)\par
03208         {\cf19 if} (table_instance->HoveredRowLast == 0 && table->HoveredColumnBorder == -1 && (g.ActiveId == 0 || g.ActiveId == row_id || (table->IsActiveIdInTable || g.DragDropActive)))\par
03209             highlight_column_n = table->HoveredColumnBody;\par
03210 \par
03211     {\cf20 // Build up request}\par
03212     ImU32 col_header_bg = GetColorU32(ImGuiCol_TableHeaderBg);\par
03213     ImU32 col_text = GetColorU32(ImGuiCol_Text);\par
03214     {\cf19 for} ({\cf18 int} order_n = 0; order_n < table->ColumnsCount; order_n++)\par
03215         {\cf19 if} (IM_BITARRAY_TESTBIT(table->EnabledMaskByDisplayOrder, order_n))\par
03216         \{\par
03217             {\cf17 const} {\cf18 int} column_n = table->DisplayOrderToIndex[order_n];\par
03218             ImGuiTableColumn* column = &table->Columns[column_n];\par
03219             {\cf19 if} ((column->Flags & ImGuiTableColumnFlags_AngledHeader) == 0) {\cf20 // Note: can't rely on ImGuiTableColumnFlags_IsVisible test here.}\par
03220                 {\cf19 continue};\par
03221             ImGuiTableHeaderData request = \{ (ImGuiTableColumnIdx)column_n, col_text, col_header_bg, (column_n == highlight_column_n) ? GetColorU32(ImGuiCol_Header) : 0 \};\par
03222             temp_data->AngledHeadersRequests.push_back(request);\par
03223         \}\par
