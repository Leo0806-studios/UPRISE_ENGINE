02686 {\cf18 void} ImGui::TableDrawBorders(ImGuiTable* table)\par
02687 \{\par
02688     ImGuiWindow* inner_window = table->InnerWindow;\par
02689     {\cf19 if} (!table->OuterWindow->ClipRect.Overlaps(table->OuterRect))\par
