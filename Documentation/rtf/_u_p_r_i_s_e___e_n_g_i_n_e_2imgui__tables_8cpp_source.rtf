03443     \{\par
03444         {\cf19 if} (MenuItem(LocalizeGetMsg(ImGuiLocKey_TableResetOrder), NULL, {\cf17 false}, !table->IsDefaultDisplayOrder))\par
03445             table->IsResetDisplayOrderRequest = {\cf17 true};\par
03446         want_separator = {\cf17 true};\par
03447     \}\par
03448 \par
03449     {\cf20 // Reset all (should work but seems unnecessary/noisy to expose?)}\par
03450     {\cf20 //if (MenuItem("Reset all"))}\par
03451     {\cf20 //    table->IsResetAllRequest = true;}\par
03452 \par
03453     {\cf20 // Sorting}\par
03454     {\cf20 // (modify TableOpenContextMenu() to add _Sortable flag if enabling this)}\par
03455 {\cf21 #if 0}\par
03456     {\cf19 if} ((flags_for_section_to_display & ImGuiTableFlags_Sortable) && column != NULL && (column->Flags & ImGuiTableColumnFlags_NoSort) == 0)\par
03457     \{\par
03458         {\cf19 if} (want_separator)\par
03459             Separator();\par
03460         want_separator = {\cf17 true};\par
03461 \par
03462         {\cf18 bool} append_to_sort_specs = g.IO.KeyShift;\par
03463         {\cf19 if} (MenuItem({\cf22 "Sort in Ascending Order"}, NULL, column->SortOrder != -1 && column->SortDirection == ImGuiSortDirection_Ascending, (column->Flags & ImGuiTableColumnFlags_NoSortAscending) == 0))\par
03464             TableSetColumnSortDirection(table, column_n, ImGuiSortDirection_Ascending, append_to_sort_specs);\par
03465         {\cf19 if} (MenuItem({\cf22 "Sort in Descending Order"}, NULL, column->SortOrder != -1 && column->SortDirection == ImGuiSortDirection_Descending, (column->Flags & ImGuiTableColumnFlags_NoSortDescending) == 0))\par
03466             TableSetColumnSortDirection(table, column_n, ImGuiSortDirection_Descending, append_to_sort_specs);\par
03467     \}\par
03468 {\cf21 #endif}\par
03469 \par
03470     {\cf20 // Hiding / Visibility}\par
03471     {\cf19 if} (flags_for_section_to_display & ImGuiTableFlags_Hideable)\par
03472     \{\par
03473         {\cf19 if} (want_separator)\par
