02382 {\cf20 //-------------------------------------------------------------------------}\par
02383 {\cf20 // [SECTION] Tables: Drawing}\par
02384 {\cf20 //-------------------------------------------------------------------------}\par
02385 {\cf20 // - TablePushBackgroundChannel() [Internal]}\par
02386 {\cf20 // - TablePopBackgroundChannel() [Internal]}\par
02387 {\cf20 // - TableSetupDrawChannels() [Internal]}\par
02388 {\cf20 // - TableMergeDrawChannels() [Internal]}\par
02389 {\cf20 // - TableGetColumnBorderCol() [Internal]}\par
02390 {\cf20 // - TableDrawBorders() [Internal]}\par
02391 {\cf20 //-------------------------------------------------------------------------}\par
02392 \par
02393 {\cf20 // Bg2 is used by Selectable (and possibly other widgets) to render to the background.}\par
02394 {\cf20 // Unlike our Bg0/1 channel which we uses for RowBg/CellBg/Borders and where we guarantee all shapes to be CPU-clipped, the Bg2 channel being widgets-facing will rely on regular ClipRect.}\par
02395 {\cf18 void} ImGui::TablePushBackgroundChannel()\par
02396 \{\par
02397     ImGuiContext& g = *GImGui;\par
02398     ImGuiWindow* window = g.CurrentWindow;\par
02399     ImGuiTable* table = g.CurrentTable;\par
02400 \par
02401     {\cf20 // Optimization: avoid SetCurrentChannel() + PushClipRect()}\par
02402     table->HostBackupInnerClipRect = window->ClipRect;\par
02403     SetWindowClipRectBeforeSetChannel(window, table->Bg2ClipRectForDrawCmd);\par
02404     table->DrawSplitter->SetCurrentChannel(window->DrawList, table->Bg2DrawChannelCurrent);\par
02405 \}\par
02406 \par
02407 {\cf18 void} ImGui::TablePopBackgroundChannel()\par
02408 \{\par
02409     ImGuiContext& g = *GImGui;\par
02410     ImGuiWindow* window = g.CurrentWindow;\par
02411     ImGuiTable* table = g.CurrentTable;\par
02412     ImGuiTableColumn* column = &table->Columns[table->CurrentColumn];\par
02413 \par
02414     {\cf20 // Optimization: avoid PopClipRect() + SetCurrentChannel()}\par
02415     SetWindowClipRectBeforeSetChannel(window, table->HostBackupInnerClipRect);\par
02416     table->DrawSplitter->SetCurrentChannel(window->DrawList, column->DrawChannelCurrent);\par
02417 \}\par
02418 \par
02419 {\cf20 // Allocate draw channels. Called by TableUpdateLayout()}\par
02420 {\cf20 // - We allocate them following storage order instead of display order so reordering columns won't needlessly}\par
02421 {\cf20 //   increase overall dormant memory cost.}\par
02422 {\cf20 // - We isolate headers draw commands in their own channels instead of just altering clip rects.}\par
02423 {\cf20 //   This is in order to facilitate merging of draw commands.}\par
02424 {\cf20 // - After crossing FreezeRowsCount, all columns see their current draw channel changed to a second set of channels.}\par
02425 {\cf20 // - We only use the dummy draw channel so we can push a null clipping rectangle into it without affecting other}\par
02426 {\cf20 //   channels, while simplifying per-row/per-cell overhead. It will be empty and discarded when merged.}\par
02427 {\cf20 // - We allocate 1 or 2 background draw channels. This is because we know TablePushBackgroundChannel() is only used for}\par
02428 {\cf20 //   horizontal spanning. If we allowed vertical spanning we'd need one background draw channel per merge group (1-4).}\par
02429 {\cf20 // Draw channel allocation (before merging):}\par
02430 {\cf20 // - NoClip                       --> 2+D+1 channels: bg0/1 + bg2 + foreground (same clip rect == always 1 draw call)}\par
02431 {\cf20 // - Clip                         --> 2+D+N channels}\par
02432 {\cf20 // - FreezeRows                   --> 2+D+N*2 (unless scrolling value is zero)}\par
02433 {\cf20 // - FreezeRows || FreezeColunns  --> 3+D+N*2 (unless scrolling value is zero)}\par
02434 {\cf20 // Where D is 1 if any column is clipped or hidden (dummy channel) otherwise 0.}\par
02435 {\cf18 void} ImGui::TableSetupDrawChannels(ImGuiTable* table)\par
02436 \{\par
02437     {\cf17 const} {\cf18 int} freeze_row_multiplier = (table->FreezeRowsCount > 0) ? 2 : 1;\par
02438     {\cf17 const} {\cf18 int} channels_for_row = (table->Flags & ImGuiTableFlags_NoClip) ? 1 : table->ColumnsEnabledCount;\par
02439     {\cf17 const} {\cf18 int} channels_for_bg = 1 + 1 * freeze_row_multiplier;\par
02440     {\cf17 const} {\cf18 int} channels_for_dummy = (table->ColumnsEnabledCount < table->ColumnsCount || (memcmp(table->VisibleMaskByIndex, table->EnabledMaskByIndex, ImBitArrayGetStorageSizeInBytes(table->ColumnsCount)) != 0)) ? +1 : 0;\par
02441     {\cf17 const} {\cf18 int} channels_total = channels_for_bg + (channels_for_row * freeze_row_multiplier) + channels_for_dummy;\par
02442     table->DrawSplitter->Split(table->InnerWindow->DrawList, channels_total);\par
02443     table->DummyDrawChannel = (ImGuiTableDrawChannelIdx)((channels_for_dummy > 0) ? channels_total - 1 : -1);\par
02444     table->Bg2DrawChannelCurrent = TABLE_DRAW_CHANNEL_BG2_FROZEN;\par
02445     table->Bg2DrawChannelUnfrozen = (ImGuiTableDrawChannelIdx)((table->FreezeRowsCount > 0) ? 2 + channels_for_row : TABLE_DRAW_CHANNEL_BG2_FROZEN);\par
02446 \par
02447     {\cf18 int} draw_channel_current = 2;\par
02448     {\cf19 for} ({\cf18 int} column_n = 0; column_n < table->ColumnsCount; column_n++)\par
02449     \{\par
02450         ImGuiTableColumn* column = &table->Columns[column_n];\par
02451         {\cf19 if} (column->IsVisibleX && column->IsVisibleY)\par
02452         \{\par
02453             column->DrawChannelFrozen = (ImGuiTableDrawChannelIdx)(draw_channel_current);\par
02454             column->DrawChannelUnfrozen = (ImGuiTableDrawChannelIdx)(draw_channel_current + (table->FreezeRowsCount > 0 ? channels_for_row + 1 : 0));\par
02455             {\cf19 if} (!(table->Flags & ImGuiTableFlags_NoClip))\par
02456                 draw_channel_current++;\par
02457         \}\par
02458         {\cf19 else}\par
02459         \{\par
02460             column->DrawChannelFrozen = column->DrawChannelUnfrozen = table->DummyDrawChannel;\par
02461         \}\par
02462         column->DrawChannelCurrent = column->DrawChannelFrozen;\par
02463     \}\par
02464 \par
02465     {\cf20 // Initial draw cmd starts with a BgClipRect that matches the one of its host, to facilitate merge draw commands by default.}\par
02466     {\cf20 // All our cell highlight are manually clipped with BgClipRect. When unfreezing it will be made smaller to fit scrolling rect.}\par
02467     {\cf20 // (This technically isn't part of setting up draw channels, but is reasonably related to be done here)}\par
02468     table->BgClipRect = table->InnerClipRect;\par
02469     table->Bg0ClipRectForDrawCmd = table->OuterWindow->ClipRect;\par
02470     table->Bg2ClipRectForDrawCmd = table->HostClipRect;\par
02471     IM_ASSERT(table->BgClipRect.Min.y <= table->BgClipRect.Max.y);\par
02472 \}\par
02473 \par
02474 {\cf20 // This function reorder draw channels based on matching clip rectangle, to facilitate merging them. Called by EndTable().}\par
02475 {\cf20 // For simplicity we call it TableMergeDrawChannels() but in fact it only reorder channels + overwrite ClipRect,}\par
02476 {\cf20 // actual merging is done by table->DrawSplitter.Merge() which is called right after TableMergeDrawChannels().}\par
02477 {\cf20 //}\par
02478 {\cf20 // Columns where the contents didn't stray off their local clip rectangle can be merged. To achieve}\par
02479 {\cf20 // this we merge their clip rect and make them contiguous in the channel list, so they can be merged}\par
02480 {\cf20 // by the call to DrawSplitter.Merge() following to the call to this function.}\par
02481 {\cf20 // We reorder draw commands by arranging them into a maximum of 4 distinct groups:}\par
02482 {\cf20 //}\par
02483 {\cf20 //   1 group:               2 groups:              2 groups:              4 groups:}\par
02484 {\cf20 //   [ 0. ] no freeze       [ 0. ] row freeze      [ 01 ] col freeze      [ 01 ] row+col freeze}\par
02485 {\cf20 //   [ .. ]  or no scroll   [ 2. ]  and v-scroll   [ .. ]  and h-scroll   [ 23 ]  and v+h-scroll}\par
02486 {\cf20 //}\par
02487 {\cf20 // Each column itself can use 1 channel (row freeze disabled) or 2 channels (row freeze enabled).}\par
02488 {\cf20 // When the contents of a column didn't stray off its limit, we move its channels into the corresponding group}\par
02489 {\cf20 // based on its position (within frozen rows/columns groups or not).}\par
02490 {\cf20 // At the end of the operation our 1-4 groups will each have a ImDrawCmd using the same ClipRect.}\par
02491 {\cf20 // This function assume that each column are pointing to a distinct draw channel,}\par
02492 {\cf20 // otherwise merge_group->ChannelsCount will not match set bit count of merge_group->ChannelsMask.}\par
02493 {\cf20 //}\par
02494 {\cf20 // Column channels will not be merged into one of the 1-4 groups in the following cases:}\par
02495 {\cf20 // - The contents stray off its clipping rectangle (we only compare the MaxX value, not the MinX value).}\par
02496 {\cf20 //   Direct ImDrawList calls won't be taken into account by default, if you use them make sure the ImGui:: bounds}\par
02497 {\cf20 //   matches, by e.g. calling SetCursorScreenPos().}\par
02498 {\cf20 // - The channel uses more than one draw command itself. We drop all our attempt at merging stuff here..}\par
02499 {\cf20 //   we could do better but it's going to be rare and probably not worth the hassle.}\par
02500 {\cf20 // Columns for which the draw channel(s) haven't been merged with other will use their own ImDrawCmd.}\par
02501 {\cf20 //}\par
02502 {\cf20 // This function is particularly tricky to understand.. take a breath.}\par
02503 {\cf18 void} ImGui::TableMergeDrawChannels(ImGuiTable* table)\par
02504 \{\par
02505     ImGuiContext& g = *GImGui;\par
02506     ImDrawListSplitter* splitter = table->DrawSplitter;\par
02507     {\cf17 const} {\cf18 bool} has_freeze_v = (table->FreezeRowsCount > 0);\par
02508     {\cf17 const} {\cf18 bool} has_freeze_h = (table->FreezeColumnsCount > 0);\par
02509     IM_ASSERT(splitter->_Current == 0);\par
02510 \par
02511     {\cf20 // Track which groups we are going to attempt to merge, and which channels goes into each group.}\par
02512     {\cf17 struct }MergeGroup\par
02513     \{\par
02514         ImRect          ClipRect;\par
02515         {\cf18 int}             ChannelsCount = 0;\par
02516         ImBitArrayPtr   ChannelsMask = NULL;\par
02517     \};\par
02518     {\cf18 int} merge_group_mask = 0x00;\par
02519     MergeGroup merge_groups[4];\par
02520 \par
02521     {\cf20 // Use a reusable temp buffer for the merge masks as they are dynamically sized.}\par
02522     {\cf17 const} {\cf18 int} max_draw_channels = (4 + table->ColumnsCount * 2);\par
02523     {\cf17 const} {\cf18 int} size_for_masks_bitarrays_one = (int)ImBitArrayGetStorageSizeInBytes(max_draw_channels);\par
02524     g.TempBuffer.reserve(size_for_masks_bitarrays_one * 5);\par
02525     memset(g.TempBuffer.Data, 0, size_for_masks_bitarrays_one * 5);\par
02526     {\cf19 for} ({\cf18 int} n = 0; n < IM_ARRAYSIZE(merge_groups); n++)\par
02527         merge_groups[n].ChannelsMask = (ImBitArrayPtr)({\cf18 void}*)(g.TempBuffer.Data + (size_for_masks_bitarrays_one * n));\par
02528     ImBitArrayPtr remaining_mask = (ImBitArrayPtr)({\cf18 void}*)(g.TempBuffer.Data + (size_for_masks_bitarrays_one * 4));\par
02529 \par
02530     {\cf20 // 1. Scan channels and take note of those which can be merged}\par
02531     {\cf19 for} ({\cf18 int} column_n = 0; column_n < table->ColumnsCount; column_n++)\par
02532     \{\par
02533         {\cf19 if} (!IM_BITARRAY_TESTBIT(table->VisibleMaskByIndex, column_n))\par
02534             {\cf19 continue};\par
02535         ImGuiTableColumn* column = &table->Columns[column_n];\par
02536 \par
02537         {\cf17 const} {\cf18 int} merge_group_sub_count = has_freeze_v ? 2 : 1;\par
02538         {\cf19 for} ({\cf18 int} merge_group_sub_n = 0; merge_group_sub_n < merge_group_sub_count; merge_group_sub_n++)\par
02539         \{\par
02540             {\cf17 const} {\cf18 int} channel_no = (merge_group_sub_n == 0) ? column->DrawChannelFrozen : column->DrawChannelUnfrozen;\par
02541 \par
02542             {\cf20 // Don't attempt to merge if there are multiple draw calls within the column}\par
02543             ImDrawChannel* src_channel = &splitter->_Channels[channel_no];\par
02544             {\cf19 if} (src_channel->_CmdBuffer.Size > 0 && src_channel->_CmdBuffer.back().ElemCount == 0 && src_channel->_CmdBuffer.back().UserCallback == NULL) {\cf20 // Equivalent of PopUnusedDrawCmd()}\par
02545                 src_channel->_CmdBuffer.pop_back();\par
02546             {\cf19 if} (src_channel->_CmdBuffer.Size != 1)\par
02547                 {\cf19 continue};\par
02548 \par
02549             {\cf20 // Find out the width of this merge group and check if it will fit in our column}\par
02550             {\cf20 // (note that we assume that rendering didn't stray on the left direction. we should need a CursorMinPos to detect it)}\par
02551             {\cf19 if} (!(column->Flags & ImGuiTableColumnFlags_NoClip))\par
02552             \{\par
02553                 {\cf18 float} content_max_x;\par
