03006 {\cf20 // [Public] This is a helper to output TableHeader() calls based on the column names declared in TableSetupColumn().}\par
03007 {\cf20 // The intent is that advanced users willing to create customized headers would not need to use this helper}\par
03008 {\cf20 // and can create their own! For example: TableHeader() may be preceded by Checkbox() or other custom widgets.}\par
03009 {\cf20 // See 'Demo->Tables->Custom headers' for a demonstration of implementing a custom version of this.}\par
03010 {\cf20 // This code is constructed to not make much use of internal functions, as it is intended to be a template to copy.}\par
03011 {\cf20 // FIXME-TABLE: TableOpenContextMenu() and TableGetHeaderRowHeight() are not public.}\par
03012 {\cf18 void} ImGui::TableHeadersRow()\par
03013 \{\par
03014     ImGuiContext& g = *GImGui;\par
03015     ImGuiTable* table = g.CurrentTable;\par
03016     IM_ASSERT(table != NULL && {\cf22 "Need to call TableHeadersRow() after BeginTable()!"});\par
03017 \par
03018     {\cf20 // Layout if not already done (this is automatically done by TableNextRow, we do it here solely to facilitate stepping in debugger as it is frequent to step in TableUpdateLayout)}\par
03019     {\cf19 if} (!table->IsLayoutLocked)\par
03020         TableUpdateLayout(table);\par
03021 \par
03022     {\cf20 // Open row}\par
03023     {\cf17 const} {\cf18 float} row_height = TableGetHeaderRowHeight();\par
03024     TableNextRow(ImGuiTableRowFlags_Headers, row_height);\par
03025     {\cf17 const} {\cf18 float} row_y1 = GetCursorScreenPos().y;\par
03026     {\cf19 if} (table->HostSkipItems) {\cf20 // Merely an optimization, you may skip in your own code.}\par
03027         {\cf19 return};\par
03028 \par
03029     {\cf17 const} {\cf18 int} columns_count = TableGetColumnCount();\par
03030     {\cf19 for} ({\cf18 int} column_n = 0; column_n < columns_count; column_n++)\par
03031     \{\par
03032         {\cf19 if} (!TableSetColumnIndex(column_n))\par
03033             {\cf19 continue};\par
03034 \par
03035         {\cf20 // Push an id to allow unnamed labels (generally accidental, but let's behave nicely with them)}\par
03036         {\cf20 // In your own code you may omit the PushID/PopID all-together, provided you know they won't collide.}\par
03037         {\cf17 const} {\cf18 char}* name = (TableGetColumnFlags(column_n) & ImGuiTableColumnFlags_NoHeaderLabel) ? {\cf22 ""} : TableGetColumnName(column_n);\par
03038         PushID(column_n);\par
03039         TableHeader(name);\par
03040         PopID();\par
03041     \}\par
03042 \par
03043     {\cf20 // Allow opening popup from the right-most section after the last column.}\par
03044     ImVec2 mouse_pos = ImGui::GetMousePos();\par
03045     {\cf19 if} (IsMouseReleased(1) && TableGetHoveredColumn() == columns_count)\par
03046         {\cf19 if} (mouse_pos.y >= row_y1 && mouse_pos.y < row_y1 + row_height)\par
03047             TableOpenContextMenu(columns_count); {\cf20 // Will open a non-column-specific popup.}\par
03048 \}\par
03049 \par
03050 {\cf20 // Emit a column header (text + optional sort order)}\par
03051 {\cf20 // We cpu-clip text here so that all columns headers can be merged into a same draw call.}\par
03052 {\cf20 // Note that because of how we cpu-clip and display sorting indicators, you _cannot_ use SameLine() after a TableHeader()}\par
03053 {\cf18 void} ImGui::TableHeader({\cf17 const} {\cf18 char}* label)\par
03054 \{\par
03055     ImGuiContext& g = *GImGui;\par
03056     ImGuiWindow* window = g.CurrentWindow;\par
03057     {\cf19 if} (window->SkipItems)\par
03058         {\cf19 return};\par
03059 \par
03060     ImGuiTable* table = g.CurrentTable;\par
03061     IM_ASSERT(table != NULL && {\cf22 "Need to call TableHeader() after BeginTable()!"});\par
03062     IM_ASSERT(table->CurrentColumn != -1);\par
03063     {\cf17 const} {\cf18 int} column_n = table->CurrentColumn;\par
03064     ImGuiTableColumn* column = &table->Columns[column_n];\par
03065 \par
03066     {\cf20 // Label}\par
03067     {\cf19 if} (label == NULL)\par
03068         label = {\cf22 ""};\par
03069     {\cf17 const} {\cf18 char}* label_end = FindRenderedTextEnd(label);\par
03070     ImVec2 label_size = CalcTextSize(label, label_end, {\cf17 true});\par
03071     ImVec2 label_pos = window->DC.CursorPos;\par
03072 \par
03073     {\cf20 // If we already got a row height, there's use that.}\par
03074     {\cf20 // FIXME-TABLE: Padding problem if the correct outer-padding CellBgRect strays off our ClipRect?}\par
03075     ImRect cell_r = TableGetCellBgRect(table, column_n);\par
03076     {\cf18 float} label_height = ImMax(label_size.y, table->RowMinHeight - table->RowCellPaddingY * 2.0f);\par
03077 \par
03078     {\cf20 // Calculate ideal size for sort order arrow}\par
03079     {\cf18 float} w_arrow = 0.0f;\par
03080     {\cf18 float} w_sort_text = 0.0f;\par
03081     {\cf18 bool} sort_arrow = {\cf17 false};\par
03082     {\cf18 char} sort_order_suf[4] = {\cf22 ""};\par
03083     {\cf17 const} {\cf18 float} ARROW_SCALE = 0.65f;\par
03084     {\cf19 if} ((table->Flags & ImGuiTableFlags_Sortable) && !(column->Flags & ImGuiTableColumnFlags_NoSort))\par
03085     \{\par
03086         w_arrow = ImTrunc(g.FontSize * ARROW_SCALE + g.Style.FramePadding.x);\par
03087         {\cf19 if} (column->SortOrder != -1)\par
03088             sort_arrow = {\cf17 true};\par
03089         {\cf19 if} (column->SortOrder > 0)\par
03090         \{\par
03091             ImFormatString(sort_order_suf, IM_ARRAYSIZE(sort_order_suf), {\cf22 "%d"}, column->SortOrder + 1);\par
03092             w_sort_text = g.Style.ItemInnerSpacing.x + CalcTextSize(sort_order_suf).x;\par
03093         \}\par
03094     \}\par
03095 \par
03096     {\cf20 // We feed our unclipped width to the column without writing on CursorMaxPos, so that column is still considered for merging.}\par
03097     {\cf18 float} max_pos_x = label_pos.x + label_size.x + w_sort_text + w_arrow;\par
03098     column->ContentMaxXHeadersUsed = ImMax(column->ContentMaxXHeadersUsed, sort_arrow ? cell_r.Max.x : ImMin(max_pos_x, cell_r.Max.x));\par
03099     column->ContentMaxXHeadersIdeal = ImMax(column->ContentMaxXHeadersIdeal, max_pos_x);\par
03100 \par
03101     {\cf20 // Keep header highlighted when context menu is open.}\par
03102     ImGuiID {\cf18 id} = window->GetID(label);\par
03103     ImRect bb(cell_r.Min.x, cell_r.Min.y, cell_r.Max.x, ImMax(cell_r.Max.y, cell_r.Min.y + label_height + g.Style.CellPadding.y * 2.0f));\par
03104     ItemSize(ImVec2(0.0f, label_height)); {\cf20 // Don't declare unclipped width, it'll be fed ContentMaxPosHeadersIdeal}\par
03105     {\cf19 if} (!ItemAdd(bb, {\cf18 id}))\par
03106         {\cf19 return};\par
03107 \par
03108     {\cf20 //GetForegroundDrawList()->AddRect(cell_r.Min, cell_r.Max, IM_COL32(255, 0, 0, 255)); // [DEBUG]}\par
03109     {\cf20 //GetForegroundDrawList()->AddRect(bb.Min, bb.Max, IM_COL32(255, 0, 0, 255)); // [DEBUG]}\par
03110 \par
03111     {\cf20 // Using AllowOverlap mode because we cover the whole cell, and we want user to be able to submit subsequent items.}\par
03112     {\cf17 const} {\cf18 bool} highlight = (table->HighlightColumnHeader == column_n);\par
03113     {\cf18 bool} hovered, held;\par
03114     {\cf18 bool} pressed = ButtonBehavior(bb, {\cf18 id}, &hovered, &held, ImGuiButtonFlags_AllowOverlap);\par
03115     {\cf19 if} (held || hovered || highlight)\par
03116     \{\par
03117         {\cf17 const} ImU32 col = GetColorU32(held ? ImGuiCol_HeaderActive : hovered ? ImGuiCol_HeaderHovered : ImGuiCol_Header);\par
03118         {\cf20 //RenderFrame(bb.Min, bb.Max, col, false, 0.0f);}\par
03119         TableSetBgColor(ImGuiTableBgTarget_CellBg, col, table->CurrentColumn);\par
03120     \}\par
03121     {\cf19 else}\par
03122     \{\par
03123         {\cf20 // Submit single cell bg color in the case we didn't submit a full header row}\par
03124         {\cf19 if} ((table->RowFlags & ImGuiTableRowFlags_Headers) == 0)\par
03125             TableSetBgColor(ImGuiTableBgTarget_CellBg, GetColorU32(ImGuiCol_TableHeaderBg), table->CurrentColumn);\par
03126     \}\par
03127     RenderNavHighlight(bb, {\cf18 id}, ImGuiNavHighlightFlags_Compact | ImGuiNavHighlightFlags_NoRounding);\par
03128     {\cf19 if} (held)\par
03129         table->HeldHeaderColumn = (ImGuiTableColumnIdx)column_n;\par
03130     window->DC.CursorPos.y -= g.Style.ItemSpacing.y * 0.5f;\par
03131 \par
03132     {\cf20 // Drag and drop to re-order columns.}\par
03133     {\cf20 // FIXME-TABLE: Scroll request while reordering a column and it lands out of the scrolling zone.}\par
03134     {\cf19 if} (held && (table->Flags & ImGuiTableFlags_Reorderable) && IsMouseDragging(0) && !g.DragDropActive)\par
03135     \{\par
03136         {\cf20 // While moving a column it will jump on the other side of the mouse, so we also test for MouseDelta.x}\par
03137         table->ReorderColumn = (ImGuiTableColumnIdx)column_n;\par
03138         table->InstanceInteracted = table->InstanceCurrent;\par
03139 \par
03140         {\cf20 // We don't reorder: through the frozen<>unfrozen line, or through a column that is marked with ImGuiTableColumnFlags_NoReorder.}\par
03141         {\cf19 if} (g.IO.MouseDelta.x < 0.0f && g.IO.MousePos.x < cell_r.Min.x)\par
03142             {\cf19 if} (ImGuiTableColumn* prev_column = (column->PrevEnabledColumn != -1) ? &table->Columns[column->PrevEnabledColumn] : NULL)\par
03143                 {\cf19 if} (!((column->Flags | prev_column->Flags) & ImGuiTableColumnFlags_NoReorder))\par
03144                     {\cf19 if} ((column->IndexWithinEnabledSet < table->FreezeColumnsRequest) == (prev_column->IndexWithinEnabledSet < table->FreezeColumnsRequest))\par
03145                         table->ReorderColumnDir = -1;\par
03146         {\cf19 if} (g.IO.MouseDelta.x > 0.0f && g.IO.MousePos.x > cell_r.Max.x)\par
03147             {\cf19 if} (ImGuiTableColumn* next_column = (column->NextEnabledColumn != -1) ? &table->Columns[column->NextEnabledColumn] : NULL)\par
03148                 {\cf19 if} (!((column->Flags | next_column->Flags) & ImGuiTableColumnFlags_NoReorder))\par
03149                     {\cf19 if} ((column->IndexWithinEnabledSet < table->FreezeColumnsRequest) == (next_column->IndexWithinEnabledSet < table->FreezeColumnsRequest))\par
03150                         table->ReorderColumnDir = +1;\par
03151     \}\par
03152 \par
03153     {\cf20 // Sort order arrow}\par
03154     {\cf17 const} {\cf18 float} ellipsis_max = ImMax(cell_r.Max.x - w_arrow - w_sort_text, label_pos.x);\par
03155     {\cf19 if} ((table->Flags & ImGuiTableFlags_Sortable) && !(column->Flags & ImGuiTableColumnFlags_NoSort))\par
03156     \{\par
03157         {\cf19 if} (column->SortOrder != -1)\par
03158         \{\par
03159             {\cf18 float} x = ImMax(cell_r.Min.x, cell_r.Max.x - w_arrow - w_sort_text);\par
03160             {\cf18 float} y = label_pos.y;\par
03161             {\cf19 if} (column->SortOrder > 0)\par
03162             \{\par
03163                 PushStyleColor(ImGuiCol_Text, GetColorU32(ImGuiCol_Text, 0.70f));\par
03164                 RenderText(ImVec2(x + g.Style.ItemInnerSpacing.x, y), sort_order_suf);\par
03165                 PopStyleColor();\par
03166                 x += w_sort_text;\par
03167             \}\par
03168             RenderArrow(window->DrawList, ImVec2(x, y), GetColorU32(ImGuiCol_Text), column->SortDirection == ImGuiSortDirection_Ascending ? ImGuiDir_Up : ImGuiDir_Down, ARROW_SCALE);\par
03169         \}\par
03170 \par
03171         {\cf20 // Handle clicking on column header to adjust Sort Order}\par
03172         {\cf19 if} (pressed && table->ReorderColumn != column_n)\par
03173         \{\par
03174             ImGuiSortDirection sort_direction = TableGetColumnNextSortDirection(column);\par
03175             TableSetColumnSortDirection(column_n, sort_direction, g.IO.KeyShift);\par
03176         \}\par
03177     \}\par
03178 \par
03179     {\cf20 // Render clipped label. Clipping here ensure that in the majority of situations, all our header cells will}\par
03180     {\cf20 // be merged into a single draw call.}\par
03181     {\cf20 //window->DrawList->AddCircleFilled(ImVec2(ellipsis_max, label_pos.y), 40, IM_COL32_WHITE);}\par
03182     RenderTextEllipsis(window->DrawList, label_pos, ImVec2(ellipsis_max, label_pos.y + label_height + g.Style.FramePadding.y), ellipsis_max, ellipsis_max, label, label_end, &label_size);\par
03183 \par
03184     {\cf17 const} {\cf18 bool} text_clipped = label_size.x > (ellipsis_max - label_pos.x);\par
03185     {\cf19 if} (text_clipped && hovered && g.ActiveId == 0)\par
03186         SetItemTooltip({\cf22 "%.*s"}, ({\cf18 int})(label_end - label), label);\par
03187 \par
03188     {\cf20 // We don't use BeginPopupContextItem() because we want the popup to stay up even after the column is hidden}\par
03189     {\cf19 if} (IsMouseReleased(1) && IsItemHovered())\par
03190         TableOpenContextMenu(column_n);\par
03191 \}\par
