03229 {\cf20 // Important: data must be fed left to right}\par
03230 {\cf18 void} ImGui::TableAngledHeadersRowEx(ImGuiID row_id, {\cf18 float} angle, {\cf18 float} max_label_width, {\cf17 const} ImGuiTableHeaderData* data, {\cf18 int} data_count)\par
03231 \{\par
03232     ImGuiContext& g = *GImGui;\par
03233     ImGuiTable* table = g.CurrentTable;\par
03234     ImGuiWindow* window = g.CurrentWindow;\par
03235     ImDrawList* draw_list = window->DrawList;\par
03236     IM_ASSERT(table != NULL && {\cf22 "Need to call TableHeadersRow() after BeginTable()!"});\par
03237     IM_ASSERT(table->CurrentRow == -1 && {\cf22 "Must be first row"});\par
03238 \par
03239     {\cf19 if} (max_label_width == 0.0f)\par
03240         max_label_width = TableGetHeaderAngledMaxLabelWidth();\par
03241 \par
03242     {\cf20 // Angle argument expressed in (-IM_PI/2 .. +IM_PI/2) as it is easier to think about for user.}\par
03243     {\cf17 const} {\cf18 bool} flip_label = (angle < 0.0f);\par
03244     angle -= IM_PI * 0.5f;\par
03245     {\cf17 const} {\cf18 float} cos_a = ImCos(angle);\par
03246     {\cf17 const} {\cf18 float} sin_a = ImSin(angle);\par
03247     {\cf17 const} {\cf18 float} label_cos_a = flip_label ? ImCos(angle + IM_PI) : cos_a;\par
03248     {\cf17 const} {\cf18 float} label_sin_a = flip_label ? ImSin(angle + IM_PI) : sin_a;\par
03249     {\cf17 const} ImVec2 unit_right = ImVec2(cos_a, sin_a);\par
03250 \par
03251     {\cf20 // Calculate our base metrics and set angled headers data _before_ the first call to TableNextRow()}\par
03252     {\cf20 // FIXME-STYLE: Would it be better for user to submit 'max_label_width' or 'row_height' ? One can be derived from the other.}\par
03253     {\cf17 const} {\cf18 float} header_height = g.FontSize + g.Style.CellPadding.x * 2.0f;\par
03254     {\cf17 const} {\cf18 float} row_height = ImTrunc(ImFabs(ImRotate(ImVec2(max_label_width, flip_label ? +header_height : -header_height), cos_a, sin_a).y));\par
03255     table->AngledHeadersHeight = row_height;\par
03256     table->AngledHeadersSlope = (sin_a != 0.0f) ? (cos_a / sin_a) : 0.0f;\par
03257     {\cf17 const} ImVec2 header_angled_vector = unit_right * (row_height / -sin_a); {\cf20 // vector from bottom-left to top-left, and from bottom-right to top-right}\par
03258 \par
03259     {\cf20 // Declare row, override and draw our own background}\par
03260     TableNextRow(ImGuiTableRowFlags_Headers, row_height);\par
03261     TableNextColumn();\par
03262     {\cf17 const} ImRect row_r(table->WorkRect.Min.x, table->BgClipRect.Min.y, table->WorkRect.Max.x, table->RowPosY2);\par
03263     table->DrawSplitter->SetCurrentChannel(draw_list, TABLE_DRAW_CHANNEL_BG0);\par
03264     {\cf18 float} clip_rect_min_x = table->BgClipRect.Min.x;\par
03265     {\cf19 if} (table->FreezeColumnsCount > 0)\par
03266         clip_rect_min_x = ImMax(clip_rect_min_x, table->Columns[table->FreezeColumnsCount - 1].MaxX);\par
03267     TableSetBgColor(ImGuiTableBgTarget_RowBg0, 0); {\cf20 // Cancel}\par
03268     PushClipRect(table->BgClipRect.Min, table->BgClipRect.Max, {\cf17 false}); {\cf20 // Span all columns}\par
03269     draw_list->AddRectFilled(ImVec2(table->BgClipRect.Min.x, row_r.Min.y), ImVec2(table->BgClipRect.Max.x, row_r.Max.y), GetColorU32(ImGuiCol_TableHeaderBg, 0.25f)); {\cf20 // FIXME-STYLE: Change row background with an arbitrary color.}\par
03270     PushClipRect(ImVec2(clip_rect_min_x, table->BgClipRect.Min.y), table->BgClipRect.Max, {\cf17 true}); {\cf20 // Span all columns}\par
03271 \par
03272     ButtonBehavior(row_r, row_id, NULL, NULL);\par
03273     KeepAliveID(row_id);\par
03274 \par
03275     {\cf17 const} {\cf18 float} ascent_scaled = g.Font->Ascent * g.FontScale; {\cf20 // FIXME: Standardize those scaling factors better}\par
03276     {\cf17 const} {\cf18 float} line_off_for_ascent_x = (ImMax((g.FontSize - ascent_scaled) * 0.5f, 0.0f) / -sin_a) * (flip_label ? -1.0f : 1.0f);\par
03277     {\cf17 const} ImVec2 padding = g.Style.CellPadding; {\cf20 // We will always use swapped component}\par
03278     {\cf17 const} ImVec2 align = g.Style.TableAngledHeadersTextAlign;\par
03279 \par
03280     {\cf20 // Draw background and labels in first pass, then all borders.}\par
03281     {\cf18 float} max_x = 0.0f;\par
03282     {\cf19 for} ({\cf18 int} pass = 0; pass < 2; pass++)\par
03283         {\cf19 for} ({\cf18 int} order_n = 0; order_n < data_count; order_n++)\par
03284         \{\par
03285             {\cf17 const} ImGuiTableHeaderData* request = &data[order_n];\par
03286             {\cf17 const} {\cf18 int} column_n = request->Index;\par
03287             ImGuiTableColumn* column = &table->Columns[column_n];\par
03288 \par
03289             ImVec2 bg_shape[4];\par
03290             bg_shape[0] = ImVec2(column->MaxX, row_r.Max.y);\par
03291             bg_shape[1] = ImVec2(column->MinX, row_r.Max.y);\par
03292             bg_shape[2] = bg_shape[1] + header_angled_vector;\par
03293             bg_shape[3] = bg_shape[0] + header_angled_vector;\par
03294             {\cf19 if} (pass == 0)\par
03295             \{\par
03296                 {\cf20 // Draw shape}\par
03297                 draw_list->AddQuadFilled(bg_shape[0], bg_shape[1], bg_shape[2], bg_shape[3], request->BgColor0);\par
03298                 draw_list->AddQuadFilled(bg_shape[0], bg_shape[1], bg_shape[2], bg_shape[3], request->BgColor1); {\cf20 // Optional highlight}\par
03299                 max_x = ImMax(max_x, bg_shape[3].x);\par
03300 \par
03301                 {\cf20 // Draw label}\par
03302                 {\cf20 // - First draw at an offset where RenderTextXXX() function won't meddle with applying current ClipRect, then transform to final offset.}\par
03303                 {\cf20 // - Handle multiple lines manually, as we want each lines to follow on the horizontal border, rather than see a whole block rotated.}\par
03304                 {\cf17 const} {\cf18 char}* label_name = TableGetColumnName(table, column_n);\par
03305                 {\cf17 const} {\cf18 char}* label_name_end = FindRenderedTextEnd(label_name);\par
03306                 {\cf17 const} {\cf18 float} line_off_step_x = (g.FontSize / -sin_a);\par
03307                 {\cf17 const} {\cf18 int} label_lines = ImTextCountLines(label_name, label_name_end);\par
03308 \par
03309                 {\cf20 // Left<>Right alignment}\par
03310                 {\cf18 float} line_off_curr_x = flip_label ? (label_lines - 1) * line_off_step_x : 0.0f;\par
03311                 {\cf18 float} line_off_for_align_x = ImMax((((column->MaxX - column->MinX) - padding.x * 2.0f) - (label_lines * line_off_step_x)), 0.0f) * align.x;\par
03312                 line_off_curr_x += line_off_for_align_x - line_off_for_ascent_x;\par
03313 \par
03314                 {\cf20 // Register header width}\par
03315                 column->ContentMaxXHeadersUsed = column->ContentMaxXHeadersIdeal = column->WorkMinX + ImCeil(label_lines * line_off_step_x - line_off_for_align_x);\par
03316 \par
03317                 {\cf19 while} (label_name < label_name_end)\par
03318                 \{\par
03319                     {\cf17 const} {\cf18 char}* label_name_eol = strchr(label_name, {\cf23 '\\n'});\par
03320                     {\cf19 if} (label_name_eol == NULL)\par
03321                         label_name_eol = label_name_end;\par
03322 \par
03323                     {\cf20 // FIXME: Individual line clipping for right-most column is broken for negative angles.}\par
03324                     ImVec2 label_size = CalcTextSize(label_name, label_name_eol);\par
03325                     {\cf18 float} clip_width = max_label_width - padding.y; {\cf20 // Using padding.y*2.0f would be symmetrical but hide more text.}\par
03326                     {\cf18 float} clip_height = ImMin(label_size.y, column->ClipRect.Max.x - column->WorkMinX - line_off_curr_x);\par
03327                     ImRect clip_r(window->ClipRect.Min, window->ClipRect.Min + ImVec2(clip_width, clip_height));\par
03328                     {\cf18 int} vtx_idx_begin = draw_list->_VtxCurrentIdx;\par
03329                     PushStyleColor(ImGuiCol_Text, request->TextColor);\par
03330                     RenderTextEllipsis(draw_list, clip_r.Min, clip_r.Max, clip_r.Max.x, clip_r.Max.x, label_name, label_name_eol, &label_size);\par
03331                     PopStyleColor();\par
03332                     {\cf18 int} vtx_idx_end = draw_list->_VtxCurrentIdx;\par
03333 \par
03334                     {\cf20 // Up<>Down alignment}\par
03335                     {\cf17 const} {\cf18 float} available_space = ImMax(clip_width - label_size.x + ImAbs(padding.x * cos_a) * 2.0f - ImAbs(padding.y * sin_a) * 2.0f, 0.0f);\par
03336                     {\cf17 const} {\cf18 float} vertical_offset = available_space * align.y * (flip_label ? -1.0f : 1.0f);\par
03337 \par
03338                     {\cf20 // Rotate and offset label}\par
03339                     ImVec2 pivot_in = ImVec2(window->ClipRect.Min.x - vertical_offset, window->ClipRect.Min.y + label_size.y);\par
03340                     ImVec2 pivot_out = ImVec2(column->WorkMinX, row_r.Max.y);\par
03341                     line_off_curr_x += flip_label ? -line_off_step_x : line_off_step_x;\par
03342                     pivot_out += unit_right * padding.y;\par
03343                     {\cf19 if} (flip_label)\par
03344                         pivot_out += unit_right * (clip_width - ImMax(0.0f, clip_width - label_size.x));\par
03345                     pivot_out.x += flip_label ? line_off_curr_x + line_off_step_x : line_off_curr_x;\par
03346                     ShadeVertsTransformPos(draw_list, vtx_idx_begin, vtx_idx_end, pivot_in, label_cos_a, label_sin_a, pivot_out); {\cf20 // Rotate and offset}\par
03347                     {\cf20 //if (g.IO.KeyShift) \{ ImDrawList* fg_dl = GetForegroundDrawList(); vtx_idx_begin = fg_dl->_VtxCurrentIdx; fg_dl->AddRect(clip_r.Min, clip_r.Max, IM_COL32(0, 255, 0, 255), 0.0f, 0, 1.0f); ShadeVertsTransformPos(fg_dl, vtx_idx_begin, fg_dl->_VtxCurrentIdx, pivot_in, label_cos_a, label_sin_a, pivot_out); \}}\par
03348 \par
03349                     label_name = label_name_eol + 1;\par
03350                 \}\par
03351             \}\par
03352             {\cf19 if} (pass == 1)\par
03353             \{\par
03354                 {\cf20 // Draw border}\par
03355                 draw_list->AddLine(bg_shape[0], bg_shape[3], TableGetColumnBorderCol(table, order_n, column_n));\par
03356             \}\par
03357         \}\par
03358     PopClipRect();\par
03359     PopClipRect();\par
03360     table->TempData->AngledHeadersExtraWidth = ImMax(0.0f, max_x - table->Columns[table->RightMostEnabledColumn].MaxX);\par
03361 \}\par
