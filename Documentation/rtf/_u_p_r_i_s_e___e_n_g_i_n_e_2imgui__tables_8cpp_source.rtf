04431 {\cf18 void} ImGui::Columns({\cf18 int} columns_count, {\cf17 const} {\cf18 char}* {\cf18 id}, {\cf18 bool} border)\par
04432 \{\par
04433     ImGuiWindow* window = GetCurrentWindow();\par
04434     IM_ASSERT(columns_count >= 1);\par
