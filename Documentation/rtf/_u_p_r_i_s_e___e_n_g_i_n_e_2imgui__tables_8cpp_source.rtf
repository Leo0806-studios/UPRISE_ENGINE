03432         {\cf19 if} (table->ColumnsEnabledFixedCount == table->ColumnsEnabledCount && (table->Flags & ImGuiTableFlags_SizingMask_) != ImGuiTableFlags_SizingFixedSame)\par
03433             size_all_desc = LocalizeGetMsg(ImGuiLocKey_TableSizeAllFit);        {\cf20 // "###SizeAll" All fixed}\par
