02103 {\cf20 // [Internal] Called by TableSetColumnIndex()/TableNextColumn()}\par
02104 {\cf20 // This is called very frequently, so we need to be mindful of unnecessary overhead.}\par
02105 {\cf20 // FIXME-TABLE FIXME-OPT: Could probably shortcut some things for non-active or clipped columns.}\par
02106 {\cf18 void} ImGui::TableBeginCell(ImGuiTable* table, {\cf18 int} column_n)\par
02107 \{\par
02108     ImGuiContext& g = *GImGui;\par
02109     ImGuiTableColumn* column = &table->Columns[column_n];\par
02110     ImGuiWindow* window = table->InnerWindow;\par
02111     table->CurrentColumn = column_n;\par
02112 \par
02113     {\cf20 // Start position is roughly ~~ CellRect.Min + CellPadding + Indent}\par
02114     {\cf18 float} start_x = column->WorkMinX;\par
