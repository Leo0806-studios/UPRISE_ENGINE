363     {\cf17 template} <{\cf17 typename} T>\par
364     {\cf17 inline} {\cf18 bool} Set({\cf17 const} std::string &key, {\cf17 const} T &value) \{\par
365         {\cf19 if} (key.empty()) \{\par
366             {\cf19 return} {\cf17 false};\par
367         \}\par
368 \par
369         {\cf18 bool} result = {\cf17 false};\par
370         {\cf19 for} ({\cf18 unsigned} {\cf18 int} i = 0; i < mNumProperties; ++i) \{\par
371             {\cf19 if} (key == mKeys[i].C_Str()) \{\par
372                 Set(i, key, value);\par
373                 result = {\cf17 true};\par
374                 {\cf19 break};\par
375             \}\par
376         \}\par
377 \par
378         {\cf19 return} result;\par
379     \}\par
