309     {\cf17 inline} {\cf18 void} Add({\cf17 const} std::string &key, {\cf17 const} T &value) \{\par
310         aiString *new_keys = {\cf17 new} aiString[mNumProperties + 1];\par
311         aiMetadataEntry *new_values = {\cf17 new} aiMetadataEntry[mNumProperties + 1];\par
