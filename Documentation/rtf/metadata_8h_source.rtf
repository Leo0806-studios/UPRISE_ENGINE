329     {\cf17 template} <{\cf17 typename} T>\par
330     {\cf17 inline} {\cf18 bool} Set({\cf18 unsigned} index, {\cf17 const} std::string &key, {\cf17 const} T &value) \{\par
331         {\cf20 // In range assertion}\par
332         {\cf19 if} (index >= mNumProperties) \{\par
333             {\cf19 return} {\cf17 false};\par
334         \}\par
335 \par
336         {\cf20 // Ensure that we have a valid key.}\par
337         {\cf19 if} (key.empty()) \{\par
338             {\cf19 return} {\cf17 false};\par
339         \}\par
340 \par
341         {\cf20 // Set metadata key}\par
342         mKeys[index] = key;\par
343 \par
344         {\cf20 // Set metadata type}\par
345         mValues[index].mType = GetAiType(value);\par
346 \par
347         {\cf20 // Copy the given value to the dynamic storage}\par
348         {\cf19 if} ({\cf17 nullptr} != mValues[index].mData && AI_AIMETADATA != mValues[index].mType) \{\par
349             ::memcpy(mValues[index].mData, &value, {\cf17 sizeof}(T));\par
350         \} {\cf19 else} {\cf19 if} ({\cf17 nullptr} != mValues[index].mData && AI_AIMETADATA == mValues[index].mType) \{\par
351             *{\cf17 static_cast<}T *{\cf17 >}(mValues[index].mData) = value;\par
352         \} {\cf19 else} \{\par
353             {\cf19 if} ({\cf17 nullptr} != mValues[index].mData) \{\par
354                 {\cf17 delete} {\cf17 static_cast<}T *{\cf17 >}(mValues[index].mData);\par
355                 mValues[index].mData = {\cf17 nullptr};\par
356             \}\par
357             mValues[index].mData = {\cf17 new} T(value);\par
358         \}\par
359 \par
360         {\cf19 return} {\cf17 true};\par
361     \}\par
