604     {\cf17 template}<{\cf17 typename} T>\par
605     GLM_FUNC_QUALIFIER mat<4, 4, T, defaultp> yawPitchRoll\par
606     (\par
607         T {\cf17 const}& yaw,\par
608         T {\cf17 const}& pitch,\par
609         T {\cf17 const}& roll\par
610     )\par
611     \{\par
612         T tmp_ch = glm::cos(yaw);\par
613         T tmp_sh = glm::sin(yaw);\par
614         T tmp_cp = glm::cos(pitch);\par
615         T tmp_sp = glm::sin(pitch);\par
616         T tmp_cb = glm::cos(roll);\par
617         T tmp_sb = glm::sin(roll);\par
618 \par
619         mat<4, 4, T, defaultp> Result;\par
620         Result[0][0] = tmp_ch * tmp_cb + tmp_sh * tmp_sp * tmp_sb;\par
621         Result[0][1] = tmp_sb * tmp_cp;\par
622         Result[0][2] = -tmp_sh * tmp_cb + tmp_ch * tmp_sp * tmp_sb;\par
623         Result[0][3] = {\cf17 static_cast<}T{\cf17 >}(0);\par
624         Result[1][0] = -tmp_ch * tmp_sb + tmp_sh * tmp_sp * tmp_cb;\par
625         Result[1][1] = tmp_cb * tmp_cp;\par
626         Result[1][2] = tmp_sb * tmp_sh + tmp_ch * tmp_sp * tmp_cb;\par
627         Result[1][3] = {\cf17 static_cast<}T{\cf17 >}(0);\par
628         Result[2][0] = tmp_sh * tmp_cp;\par
629         Result[2][1] = -tmp_sp;\par
630         Result[2][2] = tmp_ch * tmp_cp;\par
631         Result[2][3] = {\cf17 static_cast<}T{\cf17 >}(0);\par
632         Result[3][0] = {\cf17 static_cast<}T{\cf17 >}(0);\par
633         Result[3][1] = {\cf17 static_cast<}T{\cf17 >}(0);\par
634         Result[3][2] = {\cf17 static_cast<}T{\cf17 >}(0);\par
635         Result[3][3] = {\cf17 static_cast<}T{\cf17 >}(1);\par
636         {\cf19 return} Result;\par
637     \}\par
