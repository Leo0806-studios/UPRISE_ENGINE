534     {\cf17 template} <{\cf17 typename} T>\par
535     GLM_FUNC_QUALIFIER mat<4, 4, T, defaultp> eulerAngleZYX\par
536     (\par
537         T {\cf17 const} & t1,\par
538         T {\cf17 const} & t2,\par
539         T {\cf17 const} & t3\par
540     )\par
541     \{\par
542         T c1 = glm::cos(t1);\par
543         T s1 = glm::sin(t1);\par
544         T c2 = glm::cos(t2);\par
545         T s2 = glm::sin(t2);\par
546         T c3 = glm::cos(t3);\par
547         T s3 = glm::sin(t3);\par
548 \par
549         mat<4, 4, T, defaultp> Result;\par
550         Result[0][0] = c1 * c2;\par
551         Result[0][1] = c2 * s1;\par
552         Result[0][2] =-s2;\par
553         Result[0][3] = {\cf17 static_cast<}T{\cf17 >}(0);\par
554         Result[1][0] = c1 * s2 * s3 - c3 * s1;\par
555         Result[1][1] = c1 * c3 + s1 * s2 * s3;\par
556         Result[1][2] = c2 * s3;\par
557         Result[1][3] = {\cf17 static_cast<}T{\cf17 >}(0);\par
558         Result[2][0] = s1 * s3 + c1 * c3 * s2;\par
559         Result[2][1] = c3 * s1 * s2 - c1 * s3;\par
560         Result[2][2] = c2 * c3;\par
561         Result[2][3] = {\cf17 static_cast<}T{\cf17 >}(0);\par
562         Result[3][0] = {\cf17 static_cast<}T{\cf17 >}(0);\par
563         Result[3][1] = {\cf17 static_cast<}T{\cf17 >}(0);\par
564         Result[3][2] = {\cf17 static_cast<}T{\cf17 >}(0);\par
565         Result[3][3] = {\cf17 static_cast<}T{\cf17 >}(1);\par
566         {\cf19 return} Result;\par
567     \}\par
