696     {\cf17 template}<{\cf17 typename} T>\par
697     GLM_FUNC_QUALIFIER {\cf18 void} extractEulerAngleXYZ(mat<4, 4, T, defaultp> {\cf17 const}& M,\par
698                                             T & t1,\par
699                                             T & t2,\par
700                                             T & t3)\par
701     \{\par
702         T T1 = glm::atan2(M[2][1], M[2][2]);\par
703         T C2 = glm::sqrt(M[0][0]*M[0][0] + M[1][0]*M[1][0]);\par
704         T T2 = glm::atan2(-M[2][0], C2);\par
705         T S1 = glm::sin(T1);\par
706         T C1 = glm::cos(T1);\par
707         T T3 = glm::atan2(S1*M[0][2] - C1*M[0][1], C1*M[1][1] - S1*M[1][2  ]);\par
708         t1 = -T1;\par
709         t2 = -T2;\par
710         t3 = -T3;\par
711     \}\par
