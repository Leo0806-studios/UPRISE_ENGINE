569     {\cf17 template} <{\cf17 typename} T>\par
570     GLM_FUNC_QUALIFIER mat<4, 4, T, defaultp> eulerAngleZXY\par
571     (\par
572         T {\cf17 const} & t1,\par
573         T {\cf17 const} & t2,\par
574         T {\cf17 const} & t3\par
575     )\par
576     \{\par
577         T c1 = glm::cos(t1);\par
578         T s1 = glm::sin(t1);\par
579         T c2 = glm::cos(t2);\par
580         T s2 = glm::sin(t2);\par
581         T c3 = glm::cos(t3);\par
582         T s3 = glm::sin(t3);\par
583 \par
584         mat<4, 4, T, defaultp> Result;\par
585         Result[0][0] = c1 * c3 - s1 * s2 * s3;\par
586         Result[0][1] = c3 * s1 + c1 * s2 * s3;\par
587         Result[0][2] =-c2 * s3;\par
588         Result[0][3] = {\cf17 static_cast<}T{\cf17 >}(0);\par
589         Result[1][0] =-c2 * s1;\par
590         Result[1][1] = c1 * c2;\par
591         Result[1][2] = s2;\par
592         Result[1][3] = {\cf17 static_cast<}T{\cf17 >}(0);\par
593         Result[2][0] = c1 * s3 + c3 * s1 * s2;\par
594         Result[2][1] = s1 * s3 - c1 * c3 * s2;\par
595         Result[2][2] = c2 * c3;\par
596         Result[2][3] = {\cf17 static_cast<}T{\cf17 >}(0);\par
597         Result[3][0] = {\cf17 static_cast<}T{\cf17 >}(0);\par
598         Result[3][1] = {\cf17 static_cast<}T{\cf17 >}(0);\par
599         Result[3][2] = {\cf17 static_cast<}T{\cf17 >}(0);\par
600         Result[3][3] = {\cf17 static_cast<}T{\cf17 >}(1);\par
601         {\cf19 return} Result;\par
602     \}\par
