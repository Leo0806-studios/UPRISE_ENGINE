00339 {\cf18 void} blink::pdb_reader::read_name_hash_table(std::unordered_map<uint32_t, std::string> &names)\par
00340 \{\par
00341     stream_reader stream(this->stream({\cf22 "/names"}));\par
00342 \par
00343     {\cf19 if} (!is_valid() || stream.size() == 0)\par
00344         {\cf19 return};\par
00345 \par
00346     {\cf20 // Read names stream}\par
00347     {\cf17 const} pdb_names_header &header = stream.read<pdb_names_header>();\par
00348     {\cf19 if} (header.signature != 0xEFFEEFFE || header.version != 1)\par
00349         {\cf19 return};\par
00350 \par
00351     {\cf20 // Read the string table}\par
00352     stream.skip(header.names_map_offset);\par
00353 \par
00354     {\cf17 const} {\cf17 auto} size = stream.read<uint32_t>();\par
00355     names.reserve(size);\par
00356 \par
00357     {\cf19 for} (uint32_t i = 0; i < size; i++)\par
00358     \{\par
00359         {\cf17 const} {\cf17 auto} name_offset = stream.read<uint32_t>();\par
00360 \par
00361         {\cf20 // Skip empty entries}\par
00362         {\cf19 if} (name_offset == 0)\par
00363             {\cf19 continue};\par
00364 \par
00365         {\cf17 const} {\cf17 auto} pos = stream.tell();\par
00366         stream.seek({\cf17 sizeof}(header) + name_offset);\par
00367         {\cf17 const} std::string name(stream.read_string());\par
00368         stream.seek(pos); {\cf20 // Seek previous position in stream to read next name offset in the next iteration of this loop}\par
00369 \par
00370         names.insert(\{ i, name \});\par
00371     \}\par
00372 \}\par
