00130 blink::pdb_reader::pdb_reader({\cf17 const} std::string &path) : msf_reader(path)\par
00131 \{\par
00132     {\cf20 // PDB files should have 4 streams at the beginning that are always at the same index}\par
00133     _is_valid &= stream_count() > 4;\par
00134 \par
00135     {\cf19 if} (!is_valid())\par
00136         {\cf19 return};\par
00137 \par
00138     {\cf20 // Read PDB info stream}\par
00139     stream_reader pdb_stream(msf_reader::stream(1));\par
00140     {\cf19 if} (pdb_stream.size() == 0)\par
00141         {\cf19 return};\par
00142 \par
00143     {\cf17 const} pdb_header &header = pdb_stream.read<pdb_header>();\par
00144     _version = header.version;\par
00145     _timestamp = header.time_date_stamp;\par
00146     _guid = header.guid;\par
00147 \par
00148     {\cf20 // Read stream names from string hash map}\par
00149     pdb_stream.skip(header.names_map_offset);\par
00150 \par
00151     {\cf17 const} {\cf17 auto} count = pdb_stream.read<uint32_t>();\par
00152     {\cf17 const} {\cf17 auto} hash_table_size = pdb_stream.read<uint32_t>();\par
00153     _named_streams.reserve(count);\par
00154 \par
00155     {\cf17 const} {\cf17 auto} num_bitset_present = pdb_stream.read<uint32_t>();\par
00156     std::vector<uint32_t> bitset_present(num_bitset_present);\par
00157     pdb_stream.read(bitset_present.data(), num_bitset_present * {\cf17 sizeof}(uint32_t));\par
00158 \par
00159     {\cf17 const} {\cf17 auto} num_bitset_deleted = pdb_stream.read<uint32_t>();\par
00160     pdb_stream.skip(num_bitset_deleted * {\cf17 sizeof}(uint32_t));\par
00161 \par
00162     {\cf19 for} (uint32_t i = 0; i < hash_table_size; i++)\par
00163     \{\par
00164         {\cf19 if} ((bitset_present[i / 32] & (1 << (i % 32))) == 0)\par
00165             {\cf19 continue};\par
00166 \par
00167         {\cf17 const} {\cf17 auto} name_offset = pdb_stream.read<uint32_t>();\par
00168         {\cf17 const} {\cf17 auto} stream_index = pdb_stream.read<uint32_t>();\par
00169 \par
00170         {\cf17 const} {\cf17 auto} pos = pdb_stream.tell();\par
00171         pdb_stream.seek({\cf17 sizeof}(header) + name_offset); {\cf20 // Seek into the string table that stores the name}\par
00172         {\cf17 const} std::string name(pdb_stream.read_string());\par
00173         pdb_stream.seek(pos); {\cf20 // Seek previous position in stream to read next name offset in the next iteration of this loop}\par
00174 \par
00175         _named_streams.insert(\{ name, stream_index \});\par
00176     \}\par
00177 \}\par
00178 \par
00179 {\cf18 void} blink::pdb_reader::read_symbol_table(uint8_t *image_base, std::unordered_map<std::string, void *> &symbols)\par
00180 \{\par
00181     stream_reader stream(msf_reader::stream(3));\par
00182 \par
00183     {\cf17 const} pdb_dbi_header &header = stream.read<pdb_dbi_header>();\par
00184     {\cf19 if} (header.signature != 0xFFFFFFFF)\par
00185         {\cf19 return};\par
00186 \par
00187     {\cf20 // Find debug header stream (https://llvm.org/docs/PDB/DbiStream.html#optional-debug-header-stream)}\par
00188     stream.skip(header.module_info_size + header.section_contribution_size + header.section_map_size + header.file_info_size + header.ts_map_size + header.ec_info_size);\par
00189     {\cf17 const} pdb_dbi_debug_header &debug_header = stream.read<pdb_dbi_debug_header>();\par
00190 \par
00191     {\cf20 // Read section headers}\par
00192     stream_reader section_stream(msf_reader::stream(debug_header.section_header));\par
00193 \par
00194     {\cf17 const} {\cf18 size_t} num_sections = section_stream.size() / {\cf17 sizeof}(pdb_dbi_section_header);\par
00195     {\cf17 const} pdb_dbi_section_header *sections = section_stream.data<pdb_dbi_section_header>();\par
00196 \par
00197     {\cf20 // Read symbol table records in CodeView format}\par
00198     stream = msf_reader::stream(header.symbol_record_stream);\par
00199 \par
00200     parse_code_view_records(stream, stream.size(), [&](uint16_t tag) \{\par
00201         if (tag != 0x110E) {\cf20 // S_PUB32}\par
00202             return; {\cf20 // Skip all records that are not about public symbols}\par
00203 \par
00204         const struct PUBSYM32 \{\par
00205             uint32_t flags;\par
00206             uint32_t offset;\par
00207             uint16_t section;\par
00208             const char name[1];\par
00209         \} &sym = *stream.data<{\cf17 const} PUBSYM32>();\par
00210 \par
00211         {\cf19 if} (sym.section == 0 || sym.section > num_sections)\par
00212             symbols[sym.name] = {\cf17 reinterpret_cast<}{\cf18 void} *{\cf17 >}({\cf17 static_cast<}uintptr_t{\cf17 >}(sym.offset)); {\cf20 // Relative address}\par
00213         {\cf19 else}\par
00214             symbols[sym.name] = image_base + sections[sym.section - 1].virtual_address + sym.offset; {\cf20 // Absolute address}\par
00215     \}, 4);\par
00216 \}\par
00217 \par
00218 {\cf18 void} blink::pdb_reader::read_object_files(std::vector<std::filesystem::path> &object_files)\par
00219 \{\par
00220     stream_reader stream(msf_reader::stream(3));\par
00221 \par
00222     {\cf17 const} pdb_dbi_header &header = stream.read<pdb_dbi_header>();\par
00223     {\cf19 if} (header.signature != 0xFFFFFFFF)\par
00224         {\cf19 return};\par
00225 \par
00226     {\cf20 // Read module information stream (https://llvm.org/docs/PDB/DbiStream.html#dbi-mod-info-substream)}\par
00227     {\cf19 while} (stream.tell() < {\cf17 sizeof}(pdb_dbi_header) + header.module_info_size)\par
00228     \{\par
00229         {\cf17 const} pdb_dbi_module_info &info = stream.read<pdb_dbi_module_info>();\par
00230 \par
00231         {\cf17 const} {\cf17 auto} module_name = stream.read_string();\par
00232         {\cf17 const} {\cf17 auto} obj_file_name = stream.read_string(); {\cf20 // Contains the name of the ".lib" if this object file is part of a library}\par
00233 \par
00234         std::filesystem::path path(module_name);\par
00235 \par
00236         {\cf20 // Find absolute path to if necessary}\par
00237         {\cf19 if} (path.is_relative())\par
00238         \{\par
00239             {\cf19 if} (info.symbol_stream != 65535 {\cf20 /*-1*/})\par
00240             \{\par
00241                 std::filesystem::path cwd;\par
00242 \par
00243                 {\cf20 // Look up current working directory in symbol stream https://llvm.org/docs/PDB/ModiStream.html}\par
00244                 stream_reader stream(msf_reader::stream(info.symbol_stream));\par
00245                 stream.skip(4); {\cf20 // Skip 32-bit signature (this should be CV_SIGNATURE_C13, aka 4)}\par
00246 \par
00247                 parse_code_view_records(stream, info.symbol_byte_size - 4, [&](uint16_t tag) \{\par
00248                     if (tag == 0x113d) {\cf20 // S_ENVBLOCK}\par
00249                     \{\par
00250                         stream.skip(1);\par
00251                         while (stream.tell() < stream.size() && *stream.data() != {\cf22 '\\0'})\par
00252                         \{\par
00253                             const auto key = stream.read_string();\par
00254                             const std::string value(stream.read_string());\par
00255 \par
00256                             if (key == {\cf22 "cwd"})\par
00257                             \{\par
00258                                 cwd = value;\par
00259                                 return;\par
00260                             \}\par
00261                         \}\par
00262                     \}\par
00263                 \});\par
00264             \par
00265                 path = cwd / path;\par
00266             \}\par
00267         \}\par
00268 \par
00269         object_files.push_back( path.string() );\par
00270 \par
00271         stream.align(4);\par
00272     \}\par
00273 \}\par
00274 \par
00275 {\cf18 void} blink::pdb_reader::read_source_files(std::vector<std::vector<std::filesystem::path>> &source_files, source_file_map &file_map)\par
00276 \{\par
00277     stream_reader stream(msf_reader::stream(3));\par
00278 \par
00279     {\cf17 const} pdb_dbi_header &header = stream.read<pdb_dbi_header>();\par
00280     {\cf19 if} (header.signature != 0xFFFFFFFF)\par
00281         {\cf19 return};\par
00282 \par
00283     {\cf20 // Find file information stream (https://llvm.org/docs/PDB/DbiStream.html#file-info-substream)}\par
00284     stream.skip(header.module_info_size + header.section_contribution_size + header.section_map_size);\par
00285 \par
00286     {\cf17 const} uint16_t num_modules = stream.read<uint16_t>();\par
00287     stream.skip(2); {\cf20 // Skip old number of file names (see comment on counting the number below)}\par
00288 \par
00289     {\cf20 // Ignoring since it is not useful: const uint16_t *const module_file_offsets = stream.data<uint16_t>();}\par
00290     {\cf17 const} uint16_t *{\cf17 const} module_num_source_files = stream.data<uint16_t>(num_modules * {\cf17 sizeof}(uint16_t));\par
00291     {\cf17 const} uint32_t *{\cf17 const} file_name_offsets = stream.data<uint32_t>(num_modules * {\cf17 sizeof}(uint16_t) * 2);\par
00292 \par
00293     {\cf20 // Count number of source files instead of reading the value from the header, since there may be more source files that would fit into a 16-bit value}\par
00294     uint32_t num_source_files = 0;\par
00295     {\cf19 for} (uint16_t i = 0; i < num_modules; ++i)\par
00296         num_source_files += module_num_source_files[i];\par
00297 \par
00298     stream.skip(num_modules * {\cf17 sizeof}(uint16_t) * 2 + num_source_files * {\cf17 sizeof}(uint32_t));\par
00299     {\cf17 const} {\cf17 auto} offset = stream.tell();\par
00300 \par
00301     {\cf20 // Append source files to array}\par
00302     {\cf18 size_t} n = source_files.size();\par
00303     source_files.resize(n + num_modules);\par
00304 \par
00305     uint32_t file_name_offset_index = 0;\par
00306     {\cf19 for} (uint32_t k = 0; k < num_modules; ++k)\par
00307     \{\par
00308         uint16_t num_files = module_num_source_files[k];\par
00309         source_files[n + k].resize(num_files);\par
00310 \par
00311         {\cf19 for} (uint32_t i = 0; i < num_files; ++i)\par
00312         \{\par
00313             stream.seek(offset + file_name_offsets[file_name_offset_index]);\par
00314             source_file_indices indices;\par
00315             indices.module = n + k;\par
00316             indices.file = i;\par
00317             source_files[indices.module][indices.file] = stream.read_string();\par
00318             file_map.insert(std::make_pair(source_files[indices.module][indices.file], indices));\par
00319             file_name_offset_index += 1;\par
00320         \}\par
00321     \}\par
00322 \}\par
00323 \par
00324 {\cf18 void} blink::pdb_reader::read_link_info(std::filesystem::path &cwd, std::string &cmd)\par
00325 \{\par
00326     stream_reader stream(this->stream({\cf22 "/LinkInfo"}));\par
00327 \par
00328     {\cf19 if} (!is_valid() || stream.size() == 0)\par
00329         {\cf19 return};\par
00330 \par
00331     {\cf20 // See https://github.com/Microsoft/microsoft-pdb/blob/master/langapi/include/pdb.h#L500}\par
00332     stream.skip({\cf17 sizeof}(pdb_link_info_header));\par
00333 \par
00334     cwd = stream.read_string();\par
00335     cmd = stream.read_string();\par
00336     {\cf20 // Followed by another null-terminated string with all linked libraries}\par
00337 \}\par
