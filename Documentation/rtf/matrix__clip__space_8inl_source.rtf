485     {\cf17 template}<{\cf17 typename} T>\par
486     GLM_FUNC_QUALIFIER mat<4, 4, T, defaultp> infinitePerspectiveRH_NO(T fovy, T aspect, T zNear)\par
487     \{\par
488         T {\cf17 const} range = tan(fovy / {\cf17 static_cast<}T{\cf17 >}(2)) * zNear;\par
489         T {\cf17 const} left = -range * aspect;\par
490         T {\cf17 const} right = range * aspect;\par
491         T {\cf17 const} bottom = -range;\par
492         T {\cf17 const} top = range;\par
493 \par
494         mat<4, 4, T, defaultp> Result({\cf17 static_cast<}T{\cf17 >}(0));\par
495         Result[0][0] = ({\cf17 static_cast<}T{\cf17 >}(2) * zNear) / (right - left);\par
496         Result[1][1] = ({\cf17 static_cast<}T{\cf17 >}(2) * zNear) / (top - bottom);\par
497         Result[2][2] = - {\cf17 static_cast<}T{\cf17 >}(1);\par
498         Result[2][3] = - {\cf17 static_cast<}T{\cf17 >}(1);\par
499         Result[3][2] = - {\cf17 static_cast<}T{\cf17 >}(2) * zNear;\par
500         {\cf19 return} Result;\par
501     \}\par
