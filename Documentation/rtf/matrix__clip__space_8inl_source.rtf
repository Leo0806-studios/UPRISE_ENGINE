571     {\cf20 // Infinite projection matrix: http://www.terathon.com/gdc07_lengyel.pdf}\par
572     {\cf17 template}<{\cf17 typename} T>\par
573     GLM_FUNC_QUALIFIER mat<4, 4, T, defaultp> tweakedInfinitePerspective(T fovy, T aspect, T zNear, T ep)\par
574     \{\par
575         T {\cf17 const} range = tan(fovy / {\cf17 static_cast<}T{\cf17 >}(2)) * zNear;\par
576         T {\cf17 const} left = -range * aspect;\par
577         T {\cf17 const} right = range * aspect;\par
578         T {\cf17 const} bottom = -range;\par
579         T {\cf17 const} top = range;\par
580 \par
581         mat<4, 4, T, defaultp> Result({\cf17 static_cast<}T{\cf17 >}(0));\par
582         Result[0][0] = ({\cf17 static_cast<}T{\cf17 >}(2) * zNear) / (right - left);\par
583         Result[1][1] = ({\cf17 static_cast<}T{\cf17 >}(2) * zNear) / (top - bottom);\par
584         Result[2][2] = ep - {\cf17 static_cast<}T{\cf17 >}(1);\par
585         Result[2][3] = {\cf17 static_cast<}T{\cf17 >}(-1);\par
586         Result[3][2] = (ep - {\cf17 static_cast<}T{\cf17 >}(2)) * zNear;\par
587         {\cf19 return} Result;\par
588     \}\par
