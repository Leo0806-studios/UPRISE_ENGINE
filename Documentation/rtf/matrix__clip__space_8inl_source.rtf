424         Result[1][1] = h;\par
425         Result[2][2] = (zFar + zNear) / (zFar - zNear);\par
426         Result[2][3] = {\cf17 static_cast<}T{\cf17 >}(1);\par
427         Result[3][2] = - ({\cf17 static_cast<}T{\cf17 >}(2) * zFar * zNear) / (zFar - zNear);\par
428         {\cf19 return} Result;\par
429     \}\par
