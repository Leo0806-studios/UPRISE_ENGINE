296     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
297     {\cf17 template}<{\cf17 typename} U>\par
298     GLM_FUNC_QUALIFIER GLM_CONSTEXPR qua<T, Q> & qua<T, Q>::operator*=(qua<U, Q> {\cf17 const}& r)\par
299     \{\par
300         qua<T, Q> {\cf17 const} p(*{\cf17 this});\par
301         qua<T, Q> {\cf17 const} q(r);\par
302 \par
303         this->w = p.w * q.w - p.x * q.x - p.y * q.y - p.z * q.z;\par
304         this->x = p.w * q.x + p.x * q.w + p.y * q.z - p.z * q.y;\par
305         this->y = p.w * q.y + p.y * q.w + p.z * q.x - p.x * q.z;\par
306         this->z = p.w * q.z + p.z * q.w + p.x * q.y - p.y * q.x;\par
307         {\cf19 return} *{\cf17 this};\par
308     \}\par
