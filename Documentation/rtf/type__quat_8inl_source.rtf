181     {\cf20 //  valType const& yaw,}\par
182     {\cf20 //  valType const& roll}\par
183     {\cf20 //)}\par
184     {\cf20 //\{}\par
185     {\cf20 //  vec<3, valType> eulerAngle(pitch * valType(0.5), yaw * valType(0.5), roll * valType(0.5));}\par
186     {\cf20 //  vec<3, valType> c = glm::cos(eulerAngle * valType(0.5));}\par
187     {\cf20 //  vec<3, valType> s = glm::sin(eulerAngle * valType(0.5));}\par
188     {\cf20 //}\par
189     {\cf20 //  this->w = c.x * c.y * c.z + s.x * s.y * s.z;}\par
190     {\cf20 //  this->x = s.x * c.y * c.z - c.x * s.y * s.z;}\par
191     {\cf20 //  this->y = c.x * s.y * c.z + s.x * c.y * s.z;}\par
192     {\cf20 //  this->z = c.x * c.y * s.z - s.x * s.y * c.z;}\par
193     {\cf20 //\}}\par
