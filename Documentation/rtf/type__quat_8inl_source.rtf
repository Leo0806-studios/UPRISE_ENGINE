62     {\cf17 template}<{\cf17 typename} T, qualifier Q, {\cf18 bool} Aligned>\par
63     {\cf17 struct }compute_quat_mul_vec4\par
64     \{\par
65         GLM_FUNC_QUALIFIER GLM_CONSTEXPR {\cf17 static} vec<4, T, Q> call(qua<T, Q> {\cf17 const}& q, vec<4, T, Q> {\cf17 const}& v)\par
