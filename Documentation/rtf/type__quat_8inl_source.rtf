195     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
196     GLM_FUNC_QUALIFIER qua<T, Q>::qua(vec<3, T, Q> {\cf17 const}& u, vec<3, T, Q> {\cf17 const}& v)\par
197     \{\par
198         T norm_u_norm_v = sqrt(dot(u, u) * dot(v, v));\par
199         T real_part = norm_u_norm_v + dot(u, v);\par
200         vec<3, T, Q> t;\par
201 \par
202         {\cf19 if}(real_part < {\cf17 static_cast<}T{\cf17 >}(1.e-6f) * norm_u_norm_v)\par
203         \{\par
204             {\cf20 // If u and v are exactly opposite, rotate 180 degrees}\par
205             {\cf20 // around an arbitrary orthogonal axis. Axis normalisation}\par
206             {\cf20 // can happen later, when we normalise the quaternion.}\par
207             real_part = {\cf17 static_cast<}T{\cf17 >}(0);\par
208             t = abs(u.x) > abs(u.z) ? vec<3, T, Q>(-u.y, u.x, {\cf17 static_cast<}T{\cf17 >}(0)) : vec<3, T, Q>({\cf17 static_cast<}T{\cf17 >}(0), -u.z, u.y);\par
209         \}\par
210         {\cf19 else}\par
211         \{\par
212             {\cf20 // Otherwise, build quaternion the standard way.}\par
213             t = cross(u, v);\par
214         \}\par
215 \par
216         *{\cf17 this} = normalize(qua<T, Q>::wxyz(real_part, t.x, t.y, t.z));\par
217     \}\par
218 \par
219     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
220     GLM_FUNC_QUALIFIER GLM_CONSTEXPR qua<T, Q>::qua(vec<3, T, Q> {\cf17 const}& eulerAngle)\par
221     \{\par
222         vec<3, T, Q> c = glm::cos(eulerAngle * T(0.5));\par
223         vec<3, T, Q> s = glm::sin(eulerAngle * T(0.5));\par
224 \par
225         this->w = c.x * c.y * c.z + s.x * s.y * s.z;\par
226         this->x = s.x * c.y * c.z - c.x * s.y * s.z;\par
227         this->y = c.x * s.y * c.z + s.x * c.y * s.z;\par
228         this->z = c.x * c.y * s.z - s.x * s.y * c.z;\par
229     \}\par
