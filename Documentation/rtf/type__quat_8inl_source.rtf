359     GLM_FUNC_QUALIFIER GLM_CONSTEXPR vec<3, T, Q> operator*(qua<T, Q> {\cf17 const}& q, vec<3, T, Q> {\cf17 const}& v)\par
360     \{\par
361         vec<3, T, Q> {\cf17 const} QuatVector(q.x, q.y, q.z);\par
362         vec<3, T, Q> {\cf17 const} uv(glm::cross(QuatVector, v));\par
363         vec<3, T, Q> {\cf17 const} uuv(glm::cross(QuatVector, uv));\par
364 \par
365         {\cf19 return} v + ((uv * q.w) + uuv) * {\cf17 static_cast<}T{\cf17 >}(2);\par
366     \}\par
