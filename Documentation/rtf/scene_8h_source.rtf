410     {\cf17 const} aiTexture* GetEmbeddedTexture({\cf17 const} {\cf18 char}* filename){\cf17  const }\{\par
411         {\cf19 return} GetEmbeddedTextureAndIndex(filename).first;\par
412     \}\par
413 \par
415     std::pair<const aiTexture*, int> GetEmbeddedTextureAndIndex({\cf17 const} {\cf18 char}* filename){\cf17  const }\{\par
416         {\cf19 if} ({\cf17 nullptr}==filename) \{\par
417             {\cf19 return} std::make_pair({\cf17 nullptr}, -1);\par
418         \}\par
419         {\cf20 // lookup using texture ID (if referenced like: "*1", "*2", etc.)}\par
420         {\cf19 if} ({\cf23 '*'} == *filename) \{\par
421             {\cf18 int} index = std::atoi(filename + 1);\par
422             {\cf19 if} (0 > index || mNumTextures <= {\cf17 static_cast<}{\cf18 unsigned}{\cf17 >}(index)) \{\par
423                 {\cf19 return} std::make_pair({\cf17 nullptr}, -1);\par
424             \}\par
425             {\cf19 return} std::make_pair(mTextures[index], index);\par
426         \}\par
427         {\cf20 // lookup using filename}\par
428         {\cf17 const} {\cf18 char}* shortFilename = GetShortFilename(filename);\par
429         {\cf19 if} ({\cf17 nullptr} == shortFilename) \{\par
430             {\cf19 return} std::make_pair({\cf17 nullptr}, -1);\par
431         \}\par
432 \par
433         {\cf19 for} ({\cf18 unsigned} {\cf18 int} i = 0; i < mNumTextures; i++) \{\par
434             {\cf17 const} {\cf18 char}* shortTextureFilename = GetShortFilename(mTextures[i]->mFilename.C_Str());\par
435             {\cf19 if} (strcmp(shortTextureFilename, shortFilename) == 0) \{\par
436                 {\cf19 return} std::make_pair(mTextures[i], i);\par
437             \}\par
438         \}\par
439         {\cf19 return} std::make_pair({\cf17 nullptr}, -1);\par
440     \}\par
