400     {\cf17 static} {\cf17 const} {\cf18 char}* GetShortFilename({\cf17 const} {\cf18 char}* filename) \{\par
401         {\cf17 const} {\cf18 char}* lastSlash = strrchr(filename, {\cf23 '/'});\par
402         {\cf19 if} (lastSlash == {\cf17 nullptr}) \{\par
403             lastSlash = strrchr(filename, {\cf23 '\\\\'});\par
404         \}\par
405         {\cf17 const} {\cf18 char}* shortFilename = lastSlash != {\cf17 nullptr} ? lastSlash + 1 : filename;\par
406         {\cf19 return} shortFilename;\par
407     \}\par
