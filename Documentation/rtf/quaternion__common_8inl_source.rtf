132     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
133     GLM_FUNC_QUALIFIER vec<4, bool, Q> isinf(qua<T, Q> {\cf17 const}& q)\par
134     \{\par
135         GLM_STATIC_ASSERT(std::numeric_limits<T>::is_iec559 || GLM_CONFIG_UNRESTRICTED_FLOAT, {\cf22 "'isinf' only accept floating-point inputs"});\par
136 \par
137         {\cf19 return} vec<4, bool, Q>(isinf(q.x), isinf(q.y), isinf(q.z), isinf(q.w));\par
138     \}\par
