124     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
125     GLM_FUNC_QUALIFIER vec<4, bool, Q> isnan(qua<T, Q> {\cf17 const}& q)\par
126     \{\par
127         GLM_STATIC_ASSERT(std::numeric_limits<T>::is_iec559 || GLM_CONFIG_UNRESTRICTED_FLOAT, {\cf22 "'isnan' only accept floating-point inputs"});\par
128 \par
129         {\cf19 return} vec<4, bool, Q>(isnan(q.x), isnan(q.y), isnan(q.z), isnan(q.w));\par
130     \}\par
