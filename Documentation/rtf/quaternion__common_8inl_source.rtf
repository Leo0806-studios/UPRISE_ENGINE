2 \{\par
3     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
4     GLM_FUNC_QUALIFIER qua<T, Q> mix(qua<T, Q> {\cf17 const}& x, qua<T, Q> {\cf17 const}& y, T a)\par
5     \{\par
6         GLM_STATIC_ASSERT(std::numeric_limits<T>::is_iec559 || GLM_CONFIG_UNRESTRICTED_FLOAT, {\cf22 "'mix' only accept floating-point inputs"});\par
7 \par
8         T {\cf17 const} cosTheta = dot(x, y);\par
9 \par
10         {\cf20 // Perform a linear interpolation when cosTheta is close to 1 to avoid side effect of sin(angle) becoming a zero denominator}\par
11         {\cf19 if}(cosTheta > {\cf17 static_cast<}T{\cf17 >}(1) - epsilon<T>())\par
12         \{\par
13             {\cf20 // Linear interpolation}\par
14             {\cf19 return} qua<T, Q>::wxyz(\par
15                 mix(x.w, y.w, a),\par
16                 mix(x.x, y.x, a),\par
17                 mix(x.y, y.y, a),\par
18                 mix(x.z, y.z, a));\par
19         \}\par
20         {\cf19 else}\par
21         \{\par
22             {\cf20 // Essential Mathematics, page 467}\par
23             T angle = acos(cosTheta);\par
24             {\cf19 return} (sin(({\cf17 static_cast<}T{\cf17 >}(1) - a) * angle) * x + sin(a * angle) * y) / sin(angle);\par
25         \}\par
26     \}\par
27 \par
28     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
29     GLM_FUNC_QUALIFIER GLM_CONSTEXPR qua<T, Q> lerp(qua<T, Q> {\cf17 const}& x, qua<T, Q> {\cf17 const}& y, T a)\par
30     \{\par
31         GLM_STATIC_ASSERT(std::numeric_limits<T>::is_iec559 || GLM_CONFIG_UNRESTRICTED_FLOAT, {\cf22 "'lerp' only accept floating-point inputs"});\par
32 \par
33         {\cf20 // Lerp is only defined in [0, 1]}\par
34         assert(a >= {\cf17 static_cast<}T{\cf17 >}(0));\par
35         assert(a <= {\cf17 static_cast<}T{\cf17 >}(1));\par
36 \par
37         {\cf19 return} x * ({\cf17 static_cast<}T{\cf17 >}(1) - a) + (y * a);\par
38     \}\par
39 \par
40     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
41     GLM_FUNC_QUALIFIER qua<T, Q> slerp(qua<T, Q> {\cf17 const}& x, qua<T, Q> {\cf17 const}& y, T a)\par
42     \{\par
43         GLM_STATIC_ASSERT(std::numeric_limits<T>::is_iec559 || GLM_CONFIG_UNRESTRICTED_FLOAT, {\cf22 "'slerp' only accept floating-point inputs"});\par
44 \par
45         qua<T, Q> z = y;\par
46 \par
47         T cosTheta = dot(x, y);\par
48 \par
49         {\cf20 // If cosTheta < 0, the interpolation will take the long way around the sphere.}\par
50         {\cf20 // To fix this, one quat must be negated.}\par
51         {\cf19 if}(cosTheta < {\cf17 static_cast<}T{\cf17 >}(0))\par
52         \{\par
53             z = -y;\par
54             cosTheta = -cosTheta;\par
55         \}\par
56 \par
57         {\cf20 // Perform a linear interpolation when cosTheta is close to 1 to avoid side effect of sin(angle) becoming a zero denominator}\par
58         {\cf19 if}(cosTheta > {\cf17 static_cast<}T{\cf17 >}(1) - epsilon<T>())\par
59         \{\par
60             {\cf20 // Linear interpolation}\par
61             {\cf19 return} qua<T, Q>::wxyz(\par
62                 mix(x.w, z.w, a),\par
63                 mix(x.x, z.x, a),\par
64                 mix(x.y, z.y, a),\par
65                 mix(x.z, z.z, a));\par
66         \}\par
67         {\cf19 else}\par
68         \{\par
69             {\cf20 // Essential Mathematics, page 467}\par
70             T angle = acos(cosTheta);\par
71             {\cf19 return} (sin(({\cf17 static_cast<}T{\cf17 >}(1) - a) * angle) * x + sin(a * angle) * z) / sin(angle);\par
72         \}\par
73     \}\par
74 \par
75     {\cf17 template}<{\cf17 typename} T, {\cf17 typename} S, qualifier Q>\par
76     GLM_FUNC_QUALIFIER qua<T, Q> slerp(qua<T, Q> {\cf17 const}& x, qua<T, Q> {\cf17 const}& y, T a, S k)\par
77     \{\par
78         GLM_STATIC_ASSERT(std::numeric_limits<T>::is_iec559 || GLM_CONFIG_UNRESTRICTED_FLOAT, {\cf22 "'slerp' only accept floating-point inputs"});\par
79         GLM_STATIC_ASSERT(std::numeric_limits<S>::is_integer, {\cf22 "'slerp' only accept integer for spin count"});\par
80 \par
81         qua<T, Q> z = y;\par
82 \par
83         T cosTheta = dot(x, y);\par
84 \par
85         {\cf20 // If cosTheta < 0, the interpolation will take the long way around the sphere.}\par
86         {\cf20 // To fix this, one quat must be negated.}\par
87         {\cf19 if} (cosTheta < {\cf17 static_cast<}T{\cf17 >}(0))\par
88         \{\par
89             z = -y;\par
90             cosTheta = -cosTheta;\par
91         \}\par
92 \par
93         {\cf20 // Perform a linear interpolation when cosTheta is close to 1 to avoid side effect of sin(angle) becoming a zero denominator}\par
94         {\cf19 if} (cosTheta > {\cf17 static_cast<}T{\cf17 >}(1) - epsilon<T>())\par
95         \{\par
96             {\cf20 // Linear interpolation}\par
97             {\cf19 return} qua<T, Q>::wxyz(\par
98                 mix(x.w, z.w, a),\par
99                 mix(x.x, z.x, a),\par
100                 mix(x.y, z.y, a),\par
101                 mix(x.z, z.z, a));\par
102         \}\par
103         {\cf19 else}\par
104         \{\par
105             {\cf20 // Graphics Gems III, page 96}\par
106             T angle = acos(cosTheta);\par
107             T phi = angle + {\cf17 static_cast<}T{\cf17 >}(k) * glm::pi<T>();\par
108             {\cf19 return} (sin(angle - a * phi)* x + sin(a * phi) * z) / sin(angle);\par
109         \}\par
110     \}\par
111 \par
112     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
113     GLM_FUNC_QUALIFIER GLM_CONSTEXPR qua<T, Q> conjugate(qua<T, Q> {\cf17 const}& q)\par
114     \{\par
115         {\cf19 return} qua<T, Q>::wxyz(q.w, -q.x, -q.y, -q.z);\par
116     \}\par
117 \par
118     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
119     GLM_FUNC_QUALIFIER GLM_CONSTEXPR qua<T, Q> inverse(qua<T, Q> {\cf17 const}& q)\par
120     \{\par
121         {\cf19 return} conjugate(q) / dot(q, q);\par
122     \}\par
