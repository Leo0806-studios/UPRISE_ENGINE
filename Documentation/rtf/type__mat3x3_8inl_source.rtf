494         T {\cf17 const} SrcA20 = m1[2][0];\par
495         T {\cf17 const} SrcA21 = m1[2][1];\par
496         T {\cf17 const} SrcA22 = m1[2][2];\par
497 \par
498         T {\cf17 const} SrcB00 = m2[0][0];\par
499         T {\cf17 const} SrcB01 = m2[0][1];\par
500         T {\cf17 const} SrcB02 = m2[0][2];\par
501         T {\cf17 const} SrcB10 = m2[1][0];\par
502         T {\cf17 const} SrcB11 = m2[1][1];\par
503         T {\cf17 const} SrcB12 = m2[1][2];\par
504         T {\cf17 const} SrcB20 = m2[2][0];\par
505         T {\cf17 const} SrcB21 = m2[2][1];\par
506         T {\cf17 const} SrcB22 = m2[2][2];\par
507 \par
508         mat<3, 3, T, Q> Result;\par
509         Result[0][0] = SrcA00 * SrcB00 + SrcA10 * SrcB01 + SrcA20 * SrcB02;\par
510         Result[0][1] = SrcA01 * SrcB00 + SrcA11 * SrcB01 + SrcA21 * SrcB02;\par
511         Result[0][2] = SrcA02 * SrcB00 + SrcA12 * SrcB01 + SrcA22 * SrcB02;\par
512         Result[1][0] = SrcA00 * SrcB10 + SrcA10 * SrcB11 + SrcA20 * SrcB12;\par
513         Result[1][1] = SrcA01 * SrcB10 + SrcA11 * SrcB11 + SrcA21 * SrcB12;\par
514         Result[1][2] = SrcA02 * SrcB10 + SrcA12 * SrcB11 + SrcA22 * SrcB12;\par
515         Result[2][0] = SrcA00 * SrcB20 + SrcA10 * SrcB21 + SrcA20 * SrcB22;\par
516         Result[2][1] = SrcA01 * SrcB20 + SrcA11 * SrcB21 + SrcA21 * SrcB22;\par
517         Result[2][2] = SrcA02 * SrcB20 + SrcA12 * SrcB21 + SrcA22 * SrcB22;\par
518         {\cf19 return} Result;\par
519     \}\par
520 \par
521     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
522     GLM_FUNC_QUALIFIER GLM_CONSTEXPR mat<2, 3, T, Q> operator*(mat<3, 3, T, Q> {\cf17 const}& m1, mat<2, 3, T, Q> {\cf17 const}& m2)\par
523     \{\par
524         {\cf19 return} mat<2, 3, T, Q>(\par
525             m1[0][0] * m2[0][0] + m1[1][0] * m2[0][1] + m1[2][0] * m2[0][2],\par
526             m1[0][1] * m2[0][0] + m1[1][1] * m2[0][1] + m1[2][1] * m2[0][2],\par
527             m1[0][2] * m2[0][0] + m1[1][2] * m2[0][1] + m1[2][2] * m2[0][2],\par
528             m1[0][0] * m2[1][0] + m1[1][0] * m2[1][1] + m1[2][0] * m2[1][2],\par
529             m1[0][1] * m2[1][0] + m1[1][1] * m2[1][1] + m1[2][1] * m2[1][2],\par
530             m1[0][2] * m2[1][0] + m1[1][2] * m2[1][1] + m1[2][2] * m2[1][2]);\par
531     \}\par
532 \par
