175             {\cf20 // Version of Allocate that aligns to D3D12 constant buffer requirements}\par
176             {\cf17 template}<{\cf17 typename} T> GraphicsResource AllocateConstant()\par
177             \{\par
178                 {\cf17 constexpr} {\cf18 size_t} alignment = D3D12_CONSTANT_BUFFER_DATA_PLACEMENT_ALIGNMENT;\par
179                 {\cf17 constexpr} {\cf18 size_t} alignedSize = ({\cf17 sizeof}(T) + alignment - 1) & ~(alignment - 1);\par
180                 {\cf17 auto} alloc = AllocateImpl(alignedSize, alignment);\par
181 {\cf21 #ifdef USING_PIX_CUSTOM_MEMORY_EVENTS}\par
182                 {\cf20 // This cast is needed to capture the type information in the PDB}\par
183                 std::ignore = {\cf17 reinterpret_cast<}T*{\cf17 >}(ReportCustomMemoryAlloc(alloc.Memory(), alloc.Size(), TAG_CONSTANT));\par
184 {\cf21 #endif}\par
185                 {\cf19 return} alloc;\par
186             \}\par
187             {\cf17 template}<{\cf17 typename} T> GraphicsResource AllocateConstant({\cf17 const} T& setData)\par
188             \{\par
189                 GraphicsResource alloc = AllocateConstant<T>();\par
190                 memcpy(alloc.Memory(), &setData, {\cf17 sizeof}(T));\par
191                 {\cf19 return} alloc;\par
192             \}\par
