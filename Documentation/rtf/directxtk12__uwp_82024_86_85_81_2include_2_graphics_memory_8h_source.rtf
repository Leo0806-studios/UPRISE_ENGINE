161             {\cf20 // Make sure to keep the GraphicsResource handle alive as long as you need to access}\par
162             {\cf20 // the memory on the CPU. For example, do not simply cache GpuAddress() and discard}\par
163             {\cf20 // the GraphicsResource object, or your memory may be overwritten later.}\par
164             GraphicsResource __cdecl Allocate({\cf18 size_t} size, {\cf18 size_t} alignment = 16, uint32_t tag = TAG_GENERIC)\par
165             \{\par
166                 {\cf17 auto} alloc = AllocateImpl(size, alignment);\par
167 {\cf21 #ifdef USING_PIX_CUSTOM_MEMORY_EVENTS}\par
168                 std::ignore = ReportCustomMemoryAlloc(alloc.Memory(), alloc.Size(), tag);\par
