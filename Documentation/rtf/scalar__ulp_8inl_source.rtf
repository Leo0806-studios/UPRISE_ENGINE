74     \{\par
75         {\cf17 volatile} {\cf18 float} t;\par
76         {\cf18 int} hx, hy, ix, iy;\par
77 \par
78         GLM_GET_FLOAT_WORD(hx, x);\par
79         GLM_GET_FLOAT_WORD(hy, y);\par
80         ix = hx & 0x7fffffff;       {\cf20 // |x|}\par
81         iy = hy & 0x7fffffff;       {\cf20 // |y|}\par
82 \par
83         {\cf19 if}((ix > 0x7f800000) || {\cf20 // x is nan}\par
84             (iy > 0x7f800000))  {\cf20 // y is nan}\par
85             {\cf19 return} x + y;\par
86         {\cf19 if}(abs(y - x) <= epsilon<float>())\par
87             {\cf19 return} y;       {\cf20 // x=y, return y}\par
88         {\cf19 if}(ix == 0)\par
89         \{               {\cf20 // x == 0}\par
90             GLM_SET_FLOAT_WORD(x, (hy & 0x80000000) | 1);{\cf20 // return +-minsubnormal}\par
91             t = x * x;\par
92             {\cf19 if}(abs(t - x) <= epsilon<float>())\par
93                 {\cf19 return} t;\par
94             {\cf19 else}\par
95                 {\cf19 return} x;   {\cf20 // raise underflow flag}\par
96         \}\par
97         {\cf19 if}(hx >= 0)\par
98         \{                       {\cf20 // x > 0}\par
99             {\cf19 if}(hx > hy)         {\cf20 // x > y, x -= ulp}\par
100                 hx -= 1;\par
101             {\cf19 else}                {\cf20 // x < y, x += ulp}\par
102                 hx += 1;\par
103         \}\par
104         {\cf19 else}\par
105         \{                       {\cf20 // x < 0}\par
106             {\cf19 if}(hy >= 0 || hx > hy)  {\cf20 // x < y, x -= ulp}\par
107                 hx -= 1;\par
108             {\cf19 else}                {\cf20 // x > y, x += ulp}\par
109                 hx += 1;\par
110         \}\par
111         hy = hx & 0x7f800000;\par
112         {\cf19 if}(hy >= 0x7f800000)\par
113             {\cf19 return} x + x;       {\cf20 // overflow}\par
114         {\cf19 if}(hy < 0x00800000)     {\cf20 // underflow}\par
115         \{\par
116             t = x * x;\par
117             {\cf19 if}(abs(t - x) > epsilon<float>())\par
118             \{                   {\cf20 // raise underflow flag}\par
119                 GLM_SET_FLOAT_WORD(y, hx);\par
120                 {\cf19 return} y;\par
121             \}\par
122         \}\par
123         GLM_SET_FLOAT_WORD(x, hx);\par
124         {\cf19 return} x;\par
125     \}\par
