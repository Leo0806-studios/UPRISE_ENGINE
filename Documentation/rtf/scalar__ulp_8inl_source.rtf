127     GLM_FUNC_QUALIFIER {\cf18 double} nextafter({\cf18 double} x, {\cf18 double} y)\par
128     \{\par
129         {\cf17 volatile} {\cf18 double} t;\par
130         {\cf18 int} hx, hy, ix, iy;\par
131         {\cf18 unsigned} {\cf18 int} lx, ly;\par
132 \par
133         GLM_EXTRACT_WORDS(hx, lx, x);\par
134         GLM_EXTRACT_WORDS(hy, ly, y);\par
135         ix = hx & 0x7fffffff;                               {\cf20 // |x|}\par
136         iy = hy & 0x7fffffff;                               {\cf20 // |y|}\par
137 \par
138         {\cf19 if}(((ix >= 0x7ff00000) && ((ix - 0x7ff00000) | lx) != 0) || {\cf20 // x is nan}\par
139             ((iy >= 0x7ff00000) && ((iy - 0x7ff00000) | ly) != 0))  {\cf20 // y is nan}\par
140             {\cf19 return} x + y;\par
141         {\cf19 if}(abs(y - x) <= epsilon<double>())\par
142             {\cf19 return} y;                                   {\cf20 // x=y, return y}\par
143         {\cf19 if}((ix | lx) == 0)\par
144         \{                                                   {\cf20 // x == 0}\par
145             GLM_INSERT_WORDS(x, hy & 0x80000000, 1);        {\cf20 // return +-minsubnormal}\par
146             t = x * x;\par
147             {\cf19 if}(abs(t - x) <= epsilon<double>())\par
148                 {\cf19 return} t;\par
149             {\cf19 else}\par
150                 {\cf19 return} x;   {\cf20 // raise underflow flag}\par
151         \}\par
152         {\cf19 if}(hx >= 0) \{                             {\cf20 // x > 0}\par
153             {\cf19 if}(hx > hy || ((hx == hy) && (lx > ly))) \{    {\cf20 // x > y, x -= ulp}\par
154                 {\cf19 if}(lx == 0) hx -= 1;\par
155                 lx -= 1;\par
156             \}\par
157             {\cf19 else} \{                            {\cf20 // x < y, x += ulp}\par
158                 lx += 1;\par
159                 {\cf19 if}(lx == 0) hx += 1;\par
160             \}\par
161         \}\par
162         {\cf19 else} \{                                {\cf20 // x < 0}\par
163             {\cf19 if}(hy >= 0 || hx > hy || ((hx == hy) && (lx > ly)))\{{\cf20 // x < y, x -= ulp}\par
164                 {\cf19 if}(lx == 0) hx -= 1;\par
165                 lx -= 1;\par
166             \}\par
167             {\cf19 else} \{                            {\cf20 // x > y, x += ulp}\par
168                 lx += 1;\par
169                 {\cf19 if}(lx == 0) hx += 1;\par
170             \}\par
171         \}\par
172         hy = hx & 0x7ff00000;\par
173         {\cf19 if}(hy >= 0x7ff00000)\par
174             {\cf19 return} x + x;           {\cf20 // overflow}\par
175         {\cf19 if}(hy < 0x00100000)\par
176         \{                       {\cf20 // underflow}\par
177             t = x * x;\par
178             {\cf19 if}(abs(t - x) > epsilon<double>())\par
179             \{                   {\cf20 // raise underflow flag}\par
180                 GLM_INSERT_WORDS(y, hx, lx);\par
181                 {\cf19 return} y;\par
182             \}\par
183         \}\par
184         GLM_INSERT_WORDS(x, hx, lx);\par
185         {\cf19 return} x;\par
186     \}\par
