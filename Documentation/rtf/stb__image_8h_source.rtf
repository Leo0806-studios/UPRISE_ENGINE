4116 stbi_inline {\cf17 static} {\cf18 int} stbi__bit_reverse({\cf18 int} v, {\cf18 int} bits)\par
4117 \{\par
4118    STBI_ASSERT(bits <= 16);\par
4119    {\cf20 // to bit reverse n bits, reverse 16 and shift}\par
4120    {\cf20 // e.g. 11 bits, bit reverse and shift away 5}\par
4121    {\cf19 return} stbi__bitreverse16(v) >> (16-bits);\par
4122 \}\par
