3356 {\cf20 // use comparisons since in some cases we handle more than one case (e.g. SOF)}\par
3357 {\cf21 #define stbi__DNL(x)         ((x) == 0xdc)}\par
3358 {\cf21 #define stbi__SOI(x)         ((x) == 0xd8)}\par
3359 {\cf21 #define stbi__EOI(x)         ((x) == 0xd9)}\par
3360 {\cf21 #define stbi__SOF(x)         ((x) == 0xc0 || (x) == 0xc1 || (x) == 0xc2)}\par
3361 {\cf21 #define stbi__SOS(x)         ((x) == 0xda)}\par
3362 \par
3363 {\cf21 #define stbi__SOF_progressive(x)   ((x) == 0xc2)}\par
