6336 {\cf17 static} {\cf18 int} stbi__pic_is4(stbi__context *s,{\cf17 const} {\cf18 char} *str)\par
6337 \{\par
6338    {\cf18 int} i;\par
6339    {\cf19 for} (i=0; i<4; ++i)\par
6340       {\cf19 if} (stbi__get8(s) != (stbi_uc)str[i])\par
6341          {\cf19 return} 0;\par
6342 \par
6343    {\cf19 return} 1;\par
6344 \}\par
