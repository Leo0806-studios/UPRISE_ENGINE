5217                   {\cf19 if} (!stbi__compute_transparency16(z, tc16, s->img_out_n)) {\cf19 return} 0;\par
5218                \} {\cf19 else} \{\par
5219                   {\cf19 if} (!stbi__compute_transparency(z, tc, s->img_out_n)) {\cf19 return} 0;\par
