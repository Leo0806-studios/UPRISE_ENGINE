7581 {\cf17 static} {\cf18 int}      stbi__pnm_info(stbi__context *s, {\cf18 int} *x, {\cf18 int} *y, {\cf18 int} *comp)\par
7582 \{\par
7583    {\cf18 int} maxv, dummy;\par
7584    {\cf18 char} c, p, t;\par
7585 \par
7586    {\cf19 if} (!x) x = &dummy;\par
7587    {\cf19 if} (!y) y = &dummy;\par
7588    {\cf19 if} (!comp) comp = &dummy;\par
7589 \par
7590    stbi__rewind(s);\par
7591 \par
7592    {\cf20 // Get identifier}\par
7593    p = (char) stbi__get8(s);\par
7594    t = (char) stbi__get8(s);\par
7595    {\cf19 if} (p != {\cf23 'P'} || (t != {\cf23 '5'} && t != {\cf23 '6'})) \{\par
7596        stbi__rewind(s);\par
7597        {\cf19 return} 0;\par
7598    \}\par
7599 \par
7600    *comp = (t == {\cf23 '6'}) ? 3 : 1;  {\cf20 // '5' is 1-component .pgm; '6' is 3-component .ppm}\par
7601 \par
7602    c = (char) stbi__get8(s);\par
7603    stbi__pnm_skip_whitespace(s, &c);\par
7604 \par
7605    *x = stbi__pnm_getinteger(s, &c); {\cf20 // read width}\par
7606    {\cf19 if}(*x == 0)\par
7607        {\cf19 return} stbi__err({\cf22 "invalid width"}, {\cf22 "PPM image header had zero or overflowing width"});\par
7608    stbi__pnm_skip_whitespace(s, &c);\par
7609 \par
7610    *y = stbi__pnm_getinteger(s, &c); {\cf20 // read height}\par
7611    {\cf19 if} (*y == 0)\par
7612        {\cf19 return} stbi__err({\cf22 "invalid width"}, {\cf22 "PPM image header had zero or overflowing width"});\par
7613    stbi__pnm_skip_whitespace(s, &c);\par
7614 \par
7615    maxv = stbi__pnm_getinteger(s, &c);  {\cf20 // read max value}\par
7616    {\cf19 if} (maxv > 65535)\par
7617       {\cf19 return} stbi__err({\cf22 "max value > 65535"}, {\cf22 "PPM image supports only 8-bit and 16-bit images"});\par
7618    {\cf19 else} {\cf19 if} (maxv > 255)\par
7619       {\cf19 return} 16;\par
7620    {\cf19 else}\par
7621       {\cf19 return} 8;\par
7622 \}\par
7623 \par
7624 {\cf17 static} {\cf18 int} stbi__pnm_is16(stbi__context *s)\par
7625 \{\par
7626    {\cf19 if} (stbi__pnm_info(s, NULL, NULL, NULL) == 16)\par
7627        {\cf19 return} 1;\par
7628    {\cf19 return} 0;\par
7629 \}\par
