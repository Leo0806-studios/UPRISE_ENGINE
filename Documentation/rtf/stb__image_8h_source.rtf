6744          \} {\cf19 else} {\cf19 if} (code <= avail) \{\par
6745             {\cf19 if} (first) \{\par
6746                {\cf19 return} stbi__errpuc({\cf22 "no clear code"}, {\cf22 "Corrupt GIF"});\par
6747             \}\par
6748 \par
6749             {\cf19 if} (oldcode >= 0) \{\par
6750                p = &g->codes[avail++];\par
6751                {\cf19 if} (avail > 8192) \{\par
6752                   {\cf19 return} stbi__errpuc({\cf22 "too many codes"}, {\cf22 "Corrupt GIF"});\par
6753                \}\par
6754 \par
6755                p->prefix = (stbi__int16) oldcode;\par
6756                p->first = g->codes[oldcode].first;\par
6757                p->suffix = (code == avail) ? p->first : g->codes[code].first;\par
6758             \} {\cf19 else} {\cf19 if} (code == avail)\par
6759                {\cf19 return} stbi__errpuc({\cf22 "illegal code in raster"}, {\cf22 "Corrupt GIF"});\par
6760 \par
6761             stbi__out_gif_code(g, (stbi__uint16) code);\par
6762 \par
6763             {\cf19 if} ((avail & codemask) == 0 && avail <= 0x0FFF) \{\par
6764                codesize++;\par
6765                codemask = (1 << codesize) - 1;\par
6766             \}\par
6767 \par
6768             oldcode = code;\par
6769          \} {\cf19 else} \{\par
6770             {\cf19 return} stbi__errpuc({\cf22 "illegal code in raster"}, {\cf22 "Corrupt GIF"});\par
6771          \}\par
6772       \}\par
6773    \}\par
6774 \}\par
