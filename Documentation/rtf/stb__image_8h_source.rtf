1137 {\cf17 static} {\cf18 void} *stbi__load_main(stbi__context *s, {\cf18 int} *x, {\cf18 int} *y, {\cf18 int} *comp, {\cf18 int} req_comp, stbi__result_info *ri, {\cf18 int} bpc)\par
1138 \{\par
1139    memset(ri, 0, {\cf17 sizeof}(*ri)); {\cf20 // make sure it's initialized if we add new fields}\par
1140    ri->bits_per_channel = 8; {\cf20 // default is 8 so most paths don't have to be changed}\par
1141    ri->channel_order = STBI_ORDER_RGB; {\cf20 // all current input & output are this, but this is here so we can add BGR order}\par
1142    ri->num_channels = 0;\par
1143 \par
1144    {\cf20 // test the formats with a very explicit header first (at least a FOURCC}\par
1145    {\cf20 // or distinctive magic number first)}\par
1146 {\cf21    #ifndef STBI_NO_PNG}\par
1147    {\cf19 if} (stbi__png_test(s))  {\cf19 return} stbi__png_load(s,x,y,comp,req_comp, ri);\par
1148 {\cf21    #endif}\par
1149 {\cf21    #ifndef STBI_NO_BMP}\par
1150    {\cf19 if} (stbi__bmp_test(s))  {\cf19 return} stbi__bmp_load(s,x,y,comp,req_comp, ri);\par
1151 {\cf21    #endif}\par
1152 {\cf21    #ifndef STBI_NO_GIF}\par
1153    {\cf19 if} (stbi__gif_test(s))  {\cf19 return} stbi__gif_load(s,x,y,comp,req_comp, ri);\par
1154 {\cf21    #endif}\par
1155 {\cf21    #ifndef STBI_NO_PSD}\par
1156    {\cf19 if} (stbi__psd_test(s))  {\cf19 return} stbi__psd_load(s,x,y,comp,req_comp, ri, bpc);\par
1157 {\cf21    #else}\par
1158    STBI_NOTUSED(bpc);\par
1159 {\cf21    #endif}\par
1160 {\cf21    #ifndef STBI_NO_PIC}\par
1161    {\cf19 if} (stbi__pic_test(s))  {\cf19 return} stbi__pic_load(s,x,y,comp,req_comp, ri);\par
1162 {\cf21    #endif}\par
1163 \par
1164    {\cf20 // then the formats that can end up attempting to load with just 1 or 2}\par
1165    {\cf20 // bytes matching expectations; these are prone to false positives, so}\par
1166    {\cf20 // try them later}\par
1167 {\cf21    #ifndef STBI_NO_JPEG}\par
1168    {\cf19 if} (stbi__jpeg_test(s)) {\cf19 return} stbi__jpeg_load(s,x,y,comp,req_comp, ri);\par
1169 {\cf21    #endif}\par
1170 {\cf21    #ifndef STBI_NO_PNM}\par
1171    {\cf19 if} (stbi__pnm_test(s))  {\cf19 return} stbi__pnm_load(s,x,y,comp,req_comp, ri);\par
1172 {\cf21    #endif}\par
1173 \par
1174 {\cf21    #ifndef STBI_NO_HDR}\par
1175    {\cf19 if} (stbi__hdr_test(s)) \{\par
1176       {\cf18 float} *hdr = stbi__hdr_load(s, x,y,comp,req_comp, ri);\par
1177       {\cf19 return} stbi__hdr_to_ldr(hdr, *x, *y, req_comp ? req_comp : *comp);\par
1178    \}\par
1179 {\cf21    #endif}\par
1180 \par
1181 {\cf21    #ifndef STBI_NO_TGA}\par
1182    {\cf20 // test tga last because it's a crappy test!}\par
1183    {\cf19 if} (stbi__tga_test(s))\par
1184       {\cf19 return} stbi__tga_load(s,x,y,comp,req_comp, ri);\par
1185 {\cf21    #endif}\par
1186 \par
1187    {\cf19 return} stbi__errpuc({\cf22 "unknown image type"}, {\cf22 "Image not of any known type, or corrupt"});\par
1188 \}\par
