6691 {\cf17 static} stbi_uc *stbi__process_gif_raster(stbi__context *s, stbi__gif *g)\par
6692 \{\par
6693    stbi_uc lzw_cs;\par
6694    stbi__int32 len, init_code;\par
6695    stbi__uint32 first;\par
6696    stbi__int32 codesize, codemask, avail, oldcode, bits, valid_bits, clear;\par
6697    stbi__gif_lzw *p;\par
6698 \par
6699    lzw_cs = stbi__get8(s);\par
6700    {\cf19 if} (lzw_cs > 12) {\cf19 return} NULL;\par
6701    clear = 1 << lzw_cs;\par
6702    first = 1;\par
6703    codesize = lzw_cs + 1;\par
6704    codemask = (1 << codesize) - 1;\par
6705    bits = 0;\par
6706    valid_bits = 0;\par
6707    {\cf19 for} (init_code = 0; init_code < clear; init_code++) \{\par
6708       g->codes[init_code].prefix = -1;\par
6709       g->codes[init_code].first = (stbi_uc) init_code;\par
6710       g->codes[init_code].suffix = (stbi_uc) init_code;\par
6711    \}\par
6712 \par
6713    {\cf20 // support no starting clear code}\par
6714    avail = clear+2;\par
6715    oldcode = -1;\par
6716 \par
6717    len = 0;\par
