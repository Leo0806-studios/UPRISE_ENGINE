5369 {\cf20 // returns 0..31 for the highest set bit}\par
5370 {\cf17 static} {\cf18 int} stbi__high_bit({\cf18 unsigned} {\cf18 int} z)\par
5371 \{\par
5372    {\cf18 int} n=0;\par
5373    {\cf19 if} (z == 0) {\cf19 return} -1;\par
5374    {\cf19 if} (z >= 0x10000) \{ n += 16; z >>= 16; \}\par
5375    {\cf19 if} (z >= 0x00100) \{ n +=  8; z >>=  8; \}\par
5376    {\cf19 if} (z >= 0x00010) \{ n +=  4; z >>=  4; \}\par
5377    {\cf19 if} (z >= 0x00004) \{ n +=  2; z >>=  2; \}\par
5378    {\cf19 if} (z >= 0x00002) \{ n +=  1;{\cf20 /* >>=  1;*/} \}\par
