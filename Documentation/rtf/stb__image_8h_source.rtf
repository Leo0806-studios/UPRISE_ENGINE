5397    {\cf17 static} {\cf18 unsigned} {\cf18 int} mul_table[9] = \{\par
5398       0,\par
5399       0xff{\cf20 /*0b11111111*/}, 0x55{\cf20 /*0b01010101*/}, 0x49{\cf20 /*0b01001001*/}, 0x11{\cf20 /*0b00010001*/},\par
5400       0x21{\cf20 /*0b00100001*/}, 0x41{\cf20 /*0b01000001*/}, 0x81{\cf20 /*0b10000001*/}, 0x01{\cf20 /*0b00000001*/},\par
5401    \};\par
5402    {\cf17 static} {\cf18 unsigned} {\cf18 int} shift_table[9] = \{\par
5403       0, 0,0,1,0,2,4,6,0,\par
5404    \};\par
5405    {\cf19 if} (shift < 0)\par
5406       v <<= -shift;\par
