4778             cur[k] = STBI__BYTECAST(raw[k] + stbi__paeth(cur[k-filter_bytes], prior[k], prior[k-filter_bytes]));\par
4779          {\cf19 break};\par
4780       {\cf19 case} STBI__F_avg_first:\par
4781          memcpy(cur, raw, filter_bytes);\par
4782          {\cf19 for} (k = filter_bytes; k < nk; ++k)\par
4783             cur[k] = STBI__BYTECAST(raw[k] + (cur[k-filter_bytes] >> 1));\par
4784          {\cf19 break};\par
4785       \}\par
4786 \par
4787       raw += nk;\par
4788 \par
4789       {\cf20 // expand decoded bits in cur to dest, also adding an extra alpha channel if desired}\par
4790       {\cf19 if} (depth < 8) \{\par
4791          stbi_uc scale = (color == 0) ? stbi__depth_scale_table[depth] : 1; {\cf20 // scale grayscale values to 0..255 range}\par
4792          stbi_uc *in = cur;\par
4793          stbi_uc *out = dest;\par
4794          stbi_uc inb = 0;\par
4795          stbi__uint32 nsmp = x*img_n;\par
4796 \par
4797          {\cf20 // expand bits to bytes first}\par
4798          {\cf19 if} (depth == 4) \{\par
4799             {\cf19 for} (i=0; i < nsmp; ++i) \{\par
4800                {\cf19 if} ((i & 1) == 0) inb = *in++;\par
4801                *out++ = scale * (inb >> 4);\par
4802                inb <<= 4;\par
4803             \}\par
4804          \} {\cf19 else} {\cf19 if} (depth == 2) \{\par
4805             {\cf19 for} (i=0; i < nsmp; ++i) \{\par
4806                {\cf19 if} ((i & 3) == 0) inb = *in++;\par
4807                *out++ = scale * (inb >> 6);\par
4808                inb <<= 2;\par
4809             \}\par
4810          \} {\cf19 else} \{\par
4811             STBI_ASSERT(depth == 1);\par
4812             {\cf19 for} (i=0; i < nsmp; ++i) \{\par
4813                {\cf19 if} ((i & 7) == 0) inb = *in++;\par
4814                *out++ = scale * (inb >> 7);\par
4815                inb <<= 1;\par
4816             \}\par
4817          \}\par
4818 \par
4819          {\cf20 // insert alpha=255 values if desired}\par
4820          {\cf19 if} (img_n != out_n)\par
4821             stbi__create_png_alpha_expand8(dest, dest, x, img_n);\par
4822       \} {\cf19 else} {\cf19 if} (depth == 8) \{\par
4823          {\cf19 if} (img_n == out_n)\par
4824             memcpy(dest, cur, x*img_n);\par
4825          {\cf19 else}\par
4826             stbi__create_png_alpha_expand8(dest, cur, x, img_n);\par
4827       \} {\cf19 else} {\cf19 if} (depth == 16) \{\par
4828          {\cf20 // convert the image data from big-endian to platform-native}\par
4829          stbi__uint16 *dest16 = (stbi__uint16*)dest;\par
4830          stbi__uint32 nsmp = x*img_n;\par
4831 \par
4832          {\cf19 if} (img_n == out_n) \{\par
4833             {\cf19 for} (i = 0; i < nsmp; ++i, ++dest16, cur += 2)\par
4834                *dest16 = (cur[0] << 8) | cur[1];\par
4835          \} {\cf19 else} \{\par
4836             STBI_ASSERT(img_n+1 == out_n);\par
4837             {\cf19 if} (img_n == 1) \{\par
4838                {\cf19 for} (i = 0; i < x; ++i, dest16 += 2, cur += 2) \{\par
4839                   dest16[0] = (cur[0] << 8) | cur[1];\par
4840                   dest16[1] = 0xffff;\par
4841                \}\par
4842             \} {\cf19 else} \{\par
4843                STBI_ASSERT(img_n == 3);\par
4844                {\cf19 for} (i = 0; i < x; ++i, dest16 += 4, cur += 6) \{\par
4845                   dest16[0] = (cur[0] << 8) | cur[1];\par
4846                   dest16[1] = (cur[2] << 8) | cur[3];\par
4847                   dest16[2] = (cur[4] << 8) | cur[5];\par
4848                   dest16[3] = 0xffff;\par
4849                \}\par
4850             \}\par
4851          \}\par
4852       \}\par
4853    \}\par
4854 \par
4855    STBI_FREE(filter_buf);\par
4856    {\cf19 if} (!all_ok) {\cf19 return} 0;\par
4857 \par
4858    {\cf19 return} 1;\par
4859 \}\par
