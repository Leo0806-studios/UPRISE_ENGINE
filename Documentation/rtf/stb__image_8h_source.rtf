5144          \}\par
5145 \par
5146          {\cf19 case} STBI__PNG_TYPE({\cf23 't'},{\cf23 'R'},{\cf23 'N'},{\cf23 'S'}): \{\par
5147             {\cf19 if} (first) {\cf19 return} stbi__err({\cf22 "first not IHDR"}, {\cf22 "Corrupt PNG"});\par
5148             {\cf19 if} (z->idata) {\cf19 return} stbi__err({\cf22 "tRNS after IDAT"},{\cf22 "Corrupt PNG"});\par
5149             {\cf19 if} (pal_img_n) \{\par
5150                {\cf19 if} (scan == STBI__SCAN_header) \{ s->img_n = 4; {\cf19 return} 1; \}\par
5151                {\cf19 if} (pal_len == 0) {\cf19 return} stbi__err({\cf22 "tRNS before PLTE"},{\cf22 "Corrupt PNG"});\par
5152                {\cf19 if} (c.length > pal_len) {\cf19 return} stbi__err({\cf22 "bad tRNS len"},{\cf22 "Corrupt PNG"});\par
5153                pal_img_n = 4;\par
5154                {\cf19 for} (i=0; i < c.length; ++i)\par
