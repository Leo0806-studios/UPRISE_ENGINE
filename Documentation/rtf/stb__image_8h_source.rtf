4672 {\cf20 // adds an extra all-255 alpha channel}\par
4673 {\cf20 // dest == src is legal}\par
4674 {\cf20 // img_n must be 1 or 3}\par
4675 {\cf17 static} {\cf18 void} stbi__create_png_alpha_expand8(stbi_uc *dest, stbi_uc *src, stbi__uint32 x, {\cf18 int} img_n)\par
4676 \{\par
4677    {\cf18 int} i;\par
4678    {\cf20 // must process data backwards since we allow dest==src}\par
4679    {\cf19 if} (img_n == 1) \{\par
4680       {\cf19 for} (i=x-1; i >= 0; --i) \{\par
4681          dest[i*2+1] = 255;\par
4682          dest[i*2+0] = src[i];\par
4683       \}\par
4684    \} {\cf19 else} \{\par
4685       STBI_ASSERT(img_n == 3);\par
4686       {\cf19 for} (i=x-1; i >= 0; --i) \{\par
4687          dest[i*4+3] = 255;\par
4688          dest[i*4+2] = src[i*3+2];\par
4689          dest[i*4+1] = src[i*3+1];\par
4690          dest[i*4+0] = src[i*3+0];\par
4691       \}\par
4692    \}\par
