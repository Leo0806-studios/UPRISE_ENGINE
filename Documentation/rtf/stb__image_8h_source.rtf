4124 {\cf17 static} {\cf18 int} stbi__zbuild_huffman(stbi__zhuffman *z, {\cf17 const} stbi_uc *sizelist, {\cf18 int} num)\par
4125 \{\par
4126    {\cf18 int} i,k=0;\par
4127    {\cf18 int} code, next_code[16], sizes[17];\par
4128 \par
4129    {\cf20 // DEFLATE spec for generating codes}\par
4130    memset(sizes, 0, {\cf17 sizeof}(sizes));\par
4131    memset(z->fast, 0, {\cf17 sizeof}(z->fast));\par
4132    {\cf19 for} (i=0; i < num; ++i)\par
4133       ++sizes[sizelist[i]];\par
4134    sizes[0] = 0;\par
4135    {\cf19 for} (i=1; i < 16; ++i)\par
4136       {\cf19 if} (sizes[i] > (1 << i))\par
4137          {\cf19 return} stbi__err({\cf22 "bad sizes"}, {\cf22 "Corrupt PNG"});\par
4138    code = 0;\par
4139    {\cf19 for} (i=1; i < 16; ++i) \{\par
4140       next_code[i] = code;\par
4141       z->firstcode[i] = (stbi__uint16) code;\par
4142       z->firstsymbol[i] = (stbi__uint16) k;\par
4143       code = (code + sizes[i]);\par
4144       {\cf19 if} (sizes[i])\par
4145          {\cf19 if} (code-1 >= (1 << i)) {\cf19 return} stbi__err({\cf22 "bad codelengths"},{\cf22 "Corrupt PNG"});\par
4146       z->maxcode[i] = code << (16-i); {\cf20 // preshift for inner loop}\par
4147       code <<= 1;\par
