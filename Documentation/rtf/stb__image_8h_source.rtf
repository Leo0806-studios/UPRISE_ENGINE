5157                {\cf19 if} (!(s->img_n & 1)) {\cf19 return} stbi__err({\cf22 "tRNS with alpha"},{\cf22 "Corrupt PNG"});\par
5158                {\cf19 if} (c.length != (stbi__uint32) s->img_n*2) {\cf19 return} stbi__err({\cf22 "bad tRNS len"},{\cf22 "Corrupt PNG"});\par
5159                has_trans = 1;\par
5160                {\cf20 // non-paletted with tRNS = constant alpha. if header-scanning, we can stop now.}\par
5161                {\cf19 if} (scan == STBI__SCAN_header) \{ ++s->img_n; {\cf19 return} 1; \}\par
5162                {\cf19 if} (z->depth == 16) \{\par
5163                   {\cf19 for} (k = 0; k < s->img_n && k < 3; ++k) {\cf20 // extra loop test to suppress false GCC warning}\par
5164                      tc16[k] = (stbi__uint16)stbi__get16be(s); {\cf20 // copy the values as-is}\par
5165                \} {\cf19 else} \{\par
5166                   {\cf19 for} (k = 0; k < s->img_n && k < 3; ++k)\par
