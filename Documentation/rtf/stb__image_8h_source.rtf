5050          {\cf19 for} (i=0; i < pixel_count; ++i) \{\par
5051             stbi_uc a = p[3];\par
5052             stbi_uc t = p[0];\par
5053             {\cf19 if} (a) \{\par
5054                stbi_uc half = a / 2;\par
5055                p[0] = (p[2] * 255 + half) / a;\par
5056                p[1] = (p[1] * 255 + half) / a;\par
5057                p[2] = ( t   * 255 + half) / a;\par
5058             \} {\cf19 else} \{\par
5059                p[0] = p[2];\par
5060                p[2] = t;\par
5061             \}\par
5062             p += 4;\par
5063          \}\par
5064       \} {\cf19 else} \{\par
5065          {\cf20 // convert bgr to rgb}\par
5066          {\cf19 for} (i=0; i < pixel_count; ++i) \{\par
5067             stbi_uc t = p[0];\par
5068             p[0] = p[2];\par
5069             p[2] = t;\par
5070             p += 4;\par
5071          \}\par
5072       \}\par
5073    \}\par
5074 \}\par
5075 \par
5076 {\cf21 #define STBI__PNG_TYPE(a,b,c,d)  (((unsigned) (a) << 24) + ((unsigned) (b) << 16) + ((unsigned) (c) << 8) + (unsigned) (d))}\par
5077 \par
5078 {\cf17 static} {\cf18 int} stbi__parse_png_file(stbi__png *z, {\cf18 int} scan, {\cf18 int} req_comp)\par
5079 \{\par
5080    stbi_uc palette[1024], pal_img_n=0;\par
5081    stbi_uc has_trans=0, tc[3]=\{0\};\par
5082    stbi__uint16 tc16[3];\par
5083    stbi__uint32 ioff=0, idata_limit=0, i, pal_len=0;\par
5084    {\cf18 int} first=1,k,interlace=0, color=0, is_iphone=0;\par
5085    stbi__context *s = z->s;\par
5086 \par
5087    z->expanded = NULL;\par
5088    z->idata = NULL;\par
5089    z->out = NULL;\par
