7139       {\cf19 else} \{\par
7140          output[0] = input[0] * f1;\par
7141          output[1] = input[1] * f1;\par
7142          output[2] = input[2] * f1;\par
7143       \}\par
7144       {\cf19 if} (req_comp == 2) output[1] = 1;\par
7145       {\cf19 if} (req_comp == 4) output[3] = 1;\par
7146    \} {\cf19 else} \{\par
7147       {\cf19 switch} (req_comp) \{\par
7148          {\cf19 case} 4: output[3] = 1; {\cf20 /* fallthrough */}\par
7149          {\cf19 case} 3: output[0] = output[1] = output[2] = 0;\par
7150                  {\cf19 break};\par
7151          {\cf19 case} 2: output[1] = 1; {\cf20 /* fallthrough */}\par
7152          {\cf19 case} 1: output[0] = 0;\par
7153                  {\cf19 break};\par
7154       \}\par
