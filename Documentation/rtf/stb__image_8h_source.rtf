5382 {\cf17 static} {\cf18 int} stbi__bitcount({\cf18 unsigned} {\cf18 int} a)\par
5383 \{\par
5384    a = (a & 0x55555555) + ((a >>  1) & 0x55555555); {\cf20 // max 2}\par
5385    a = (a & 0x33333333) + ((a >>  2) & 0x33333333); {\cf20 // max 4}\par
5386    a = (a + (a >> 4)) & 0x0f0f0f0f; {\cf20 // max 8 per 4, now 8 bits}\par
5387    a = (a + (a >> 8)); {\cf20 // max 16 per 8 bits}\par
5388    a = (a + (a >> 16)); {\cf20 // max 32 per 8 bits}\par
5389    {\cf19 return} a & 0xff;\par
5390 \}\par
