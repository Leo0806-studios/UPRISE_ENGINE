3465 {\cf17 static} stbi_uc* stbi__resample_row_v_2(stbi_uc *out, stbi_uc *in_near, stbi_uc *in_far, {\cf18 int} w, {\cf18 int} hs)\par
3466 \{\par
3467    {\cf20 // need to generate two samples vertically for every one in input}\par
3468    {\cf18 int} i;\par
3469    STBI_NOTUSED(hs);\par
3470    {\cf19 for} (i=0; i < w; ++i)\par
3471       out[i] = stbi__div4(3*in_near[i] + in_far[i] + 2);\par
3472    {\cf19 return} out;\par
3473 \}\par
3474 \par
3475 {\cf17 static} stbi_uc*  stbi__resample_row_h_2(stbi_uc *out, stbi_uc *in_near, stbi_uc *in_far, {\cf18 int} w, {\cf18 int} hs)\par
3476 \{\par
3477    {\cf20 // need to generate two samples horizontally for every one in input}\par
3478    {\cf18 int} i;\par
3479    stbi_uc *input = in_near;\par
3480 \par
3481    {\cf19 if} (w == 1) \{\par
3482       {\cf20 // if only one sample, can't do any interpolation}\par
3483       out[0] = out[1] = input[0];\par
3484       {\cf19 return} out;\par
3485    \}\par
3486 \par
3487    out[0] = input[0];\par
3488    out[1] = stbi__div4(input[0]*3 + input[1] + 2);\par
3489    {\cf19 for} (i=1; i < w-1; ++i) \{\par
3490       {\cf18 int} n = 3*input[i]+2;\par
3491       out[i*2+0] = stbi__div4(n+input[i-1]);\par
3492       out[i*2+1] = stbi__div4(n+input[i+1]);\par
3493    \}\par
3494    out[i*2+0] = stbi__div4(input[w-2]*3 + input[w-1] + 2);\par
3495    out[i*2+1] = input[w-1];\par
3496 \par
3497    STBI_NOTUSED(in_far);\par
3498    STBI_NOTUSED(hs);\par
3499 \par
3500    {\cf19 return} out;\par
3501 \}\par
3502 \par
3503 {\cf21 #define stbi__div16(x) ((stbi_uc) ((x) >> 4))}\par
3504 \par
3505 {\cf17 static} stbi_uc *stbi__resample_row_hv_2(stbi_uc *out, stbi_uc *in_near, stbi_uc *in_far, {\cf18 int} w, {\cf18 int} hs)\par
3506 \{\par
3507    {\cf20 // need to generate 2x2 samples for every one in input}\par
3508    {\cf18 int} i,t0,t1;\par
3509    {\cf19 if} (w == 1) \{\par
3510       out[0] = out[1] = stbi__div4(3*in_near[0] + in_far[0] + 2);\par
3511       {\cf19 return} out;\par
3512    \}\par
3513 \par
3514    t1 = 3*in_near[0] + in_far[0];\par
3515    out[0] = stbi__div4(t1+2);\par
3516    {\cf19 for} (i=1; i < w; ++i) \{\par
3517       t0 = t1;\par
3518       t1 = 3*in_near[i]+in_far[i];\par
3519       out[i*2-1] = stbi__div16(3*t0 + t1 + 8);\par
3520       out[i*2  ] = stbi__div16(3*t1 + t0 + 8);\par
3521    \}\par
3522    out[w*2-1] = stbi__div4(t1+2);\par
3523 \par
3524    STBI_NOTUSED(hs);\par
3525 \par
3526    {\cf19 return} out;\par
3527 \}\par
3528 \par
3529 {\cf21 #if defined(STBI_SSE2) || defined(STBI_NEON)}\par
3530 {\cf17 static} stbi_uc *stbi__resample_row_hv_2_simd(stbi_uc *out, stbi_uc *in_near, stbi_uc *in_far, {\cf18 int} w, {\cf18 int} hs)\par
3531 \{\par
3532    {\cf20 // need to generate 2x2 samples for every one in input}\par
3533    {\cf18 int} i=0,t0,t1;\par
3534 \par
3535    {\cf19 if} (w == 1) \{\par
3536       out[0] = out[1] = stbi__div4(3*in_near[0] + in_far[0] + 2);\par
3537       {\cf19 return} out;\par
3538    \}\par
3539 \par
3540    t1 = 3*in_near[0] + in_far[0];\par
3541    {\cf20 // process groups of 8 pixels for as long as we can.}\par
3542    {\cf20 // note we can't handle the last pixel in a row in this loop}\par
3543    {\cf20 // because we need to handle the filter boundary conditions.}\par
3544    {\cf19 for} (; i < ((w-1) & ~7); i += 8) \{\par
3545 {\cf21 #if defined(STBI_SSE2)}\par
3546       {\cf20 // load and perform the vertical filtering pass}\par
3547       {\cf20 // this uses 3*x + y = 4*x + (y - x)}\par
3548       __m128i zero  = _mm_setzero_si128();\par
3549       __m128i farb  = _mm_loadl_epi64((__m128i *) (in_far + i));\par
3550       __m128i nearb = _mm_loadl_epi64((__m128i *) (in_near + i));\par
3551       __m128i farw  = _mm_unpacklo_epi8(farb, zero);\par
3552       __m128i nearw = _mm_unpacklo_epi8(nearb, zero);\par
3553       __m128i diff  = _mm_sub_epi16(farw, nearw);\par
3554       __m128i nears = _mm_slli_epi16(nearw, 2);\par
3555       __m128i curr  = _mm_add_epi16(nears, diff); {\cf20 // current row}\par
3556 \par
3557       {\cf20 // horizontal filter works the same based on shifted vers of current}\par
3558       {\cf20 // row. "prev" is current row shifted right by 1 pixel; we need to}\par
3559       {\cf20 // insert the previous pixel value (from t1).}\par
3560       {\cf20 // "next" is current row shifted left by 1 pixel, with first pixel}\par
3561       {\cf20 // of next block of 8 pixels added in.}\par
3562       __m128i prv0 = _mm_slli_si128(curr, 2);\par
3563       __m128i nxt0 = _mm_srli_si128(curr, 2);\par
3564       __m128i prev = _mm_insert_epi16(prv0, t1, 0);\par
3565       __m128i next = _mm_insert_epi16(nxt0, 3*in_near[i+8] + in_far[i+8], 7);\par
3566 \par
3567       {\cf20 // horizontal filter, polyphase implementation since it's convenient:}\par
3568       {\cf20 // even pixels = 3*cur + prev = cur*4 + (prev - cur)}\par
3569       {\cf20 // odd  pixels = 3*cur + next = cur*4 + (next - cur)}\par
3570       {\cf20 // note the shared term.}\par
3571       __m128i bias  = _mm_set1_epi16(8);\par
3572       __m128i curs = _mm_slli_epi16(curr, 2);\par
3573       __m128i prvd = _mm_sub_epi16(prev, curr);\par
3574       __m128i nxtd = _mm_sub_epi16(next, curr);\par
3575       __m128i curb = _mm_add_epi16(curs, bias);\par
3576       __m128i even = _mm_add_epi16(prvd, curb);\par
3577       __m128i odd  = _mm_add_epi16(nxtd, curb);\par
3578 \par
3579       {\cf20 // interleave even and odd pixels, then undo scaling.}\par
3580       __m128i int0 = _mm_unpacklo_epi16(even, odd);\par
3581       __m128i int1 = _mm_unpackhi_epi16(even, odd);\par
3582       __m128i de0  = _mm_srli_epi16(int0, 4);\par
3583       __m128i de1  = _mm_srli_epi16(int1, 4);\par
3584 \par
3585       {\cf20 // pack and write output}\par
3586       __m128i outv = _mm_packus_epi16(de0, de1);\par
3587       _mm_storeu_si128((__m128i *) (out + i*2), outv);\par
3588 {\cf21 #elif defined(STBI_NEON)}\par
3589       {\cf20 // load and perform the vertical filtering pass}\par
3590       {\cf20 // this uses 3*x + y = 4*x + (y - x)}\par
3591       uint8x8_t farb  = vld1_u8(in_far + i);\par
3592       uint8x8_t nearb = vld1_u8(in_near + i);\par
3593       int16x8_t diff  = vreinterpretq_s16_u16(vsubl_u8(farb, nearb));\par
3594       int16x8_t nears = vreinterpretq_s16_u16(vshll_n_u8(nearb, 2));\par
3595       int16x8_t curr  = vaddq_s16(nears, diff); {\cf20 // current row}\par
3596 \par
3597       {\cf20 // horizontal filter works the same based on shifted vers of current}\par
3598       {\cf20 // row. "prev" is current row shifted right by 1 pixel; we need to}\par
3599       {\cf20 // insert the previous pixel value (from t1).}\par
3600       {\cf20 // "next" is current row shifted left by 1 pixel, with first pixel}\par
3601       {\cf20 // of next block of 8 pixels added in.}\par
3602       int16x8_t prv0 = vextq_s16(curr, curr, 7);\par
3603       int16x8_t nxt0 = vextq_s16(curr, curr, 1);\par
3604       int16x8_t prev = vsetq_lane_s16(t1, prv0, 0);\par
3605       int16x8_t next = vsetq_lane_s16(3*in_near[i+8] + in_far[i+8], nxt0, 7);\par
3606 \par
3607       {\cf20 // horizontal filter, polyphase implementation since it's convenient:}\par
3608       {\cf20 // even pixels = 3*cur + prev = cur*4 + (prev - cur)}\par
3609       {\cf20 // odd  pixels = 3*cur + next = cur*4 + (next - cur)}\par
3610       {\cf20 // note the shared term.}\par
3611       int16x8_t curs = vshlq_n_s16(curr, 2);\par
3612       int16x8_t prvd = vsubq_s16(prev, curr);\par
3613       int16x8_t nxtd = vsubq_s16(next, curr);\par
3614       int16x8_t even = vaddq_s16(curs, prvd);\par
3615       int16x8_t odd  = vaddq_s16(curs, nxtd);\par
3616 \par
3617       {\cf20 // undo scaling and round, then store with even/odd phases interleaved}\par
3618       uint8x8x2_t o;\par
3619       o.val[0] = vqrshrun_n_s16(even, 4);\par
3620       o.val[1] = vqrshrun_n_s16(odd,  4);\par
3621       vst2_u8(out + i*2, o);\par
3622 {\cf21 #endif}\par
3623 \par
3624       {\cf20 // "previous" value for next iter}\par
3625       t1 = 3*in_near[i+7] + in_far[i+7];\par
3626    \}\par
3627 \par
3628    t0 = t1;\par
3629    t1 = 3*in_near[i] + in_far[i];\par
3630    out[i*2] = stbi__div16(3*t1 + t0 + 8);\par
3631 \par
3632    {\cf19 for} (++i; i < w; ++i) \{\par
3633       t0 = t1;\par
3634       t1 = 3*in_near[i]+in_far[i];\par
3635       out[i*2-1] = stbi__div16(3*t0 + t1 + 8);\par
3636       out[i*2  ] = stbi__div16(3*t1 + t0 + 8);\par
3637    \}\par
3638    out[w*2-1] = stbi__div4(t1+2);\par
3639 \par
3640    STBI_NOTUSED(hs);\par
3641 \par
3642    {\cf19 return} out;\par
3643 \}\par
3644 {\cf21 #endif}\par
3645 \par
3646 {\cf17 static} stbi_uc *stbi__resample_row_generic(stbi_uc *out, stbi_uc *in_near, stbi_uc *in_far, {\cf18 int} w, {\cf18 int} hs)\par
3647 \{\par
3648    {\cf20 // resample with nearest-neighbor}\par
3649    {\cf18 int} i,j;\par
3650    STBI_NOTUSED(in_far);\par
3651    {\cf19 for} (i=0; i < w; ++i)\par
3652       {\cf19 for} (j=0; j < hs; ++j)\par
3653          out[i*hs+j] = in_near[i];\par
3654    {\cf19 return} out;\par
3655 \}\par
3656 \par
3657 {\cf20 // this is a reduced-precision calculation of YCbCr-to-RGB introduced}\par
3658 {\cf20 // to make sure the code produces the same results in both SIMD and scalar}\par
3659 {\cf21 #define stbi__float2fixed(x)  (((int) ((x) * 4096.0f + 0.5f)) << 8)}\par
3660 {\cf17 static} {\cf18 void} stbi__YCbCr_to_RGB_row(stbi_uc *out, {\cf17 const} stbi_uc *y, {\cf17 const} stbi_uc *pcb, {\cf17 const} stbi_uc *pcr, {\cf18 int} count, {\cf18 int} step)\par
3661 \{\par
3662    {\cf18 int} i;\par
3663    {\cf19 for} (i=0; i < count; ++i) \{\par
3664       {\cf18 int} y_fixed = (y[i] << 20) + (1<<19); {\cf20 // rounding}\par
3665       {\cf18 int} r,g,b;\par
3666       {\cf18 int} cr = pcr[i] - 128;\par
3667       {\cf18 int} cb = pcb[i] - 128;\par
3668       r = y_fixed +  cr* stbi__float2fixed(1.40200f);\par
3669       g = y_fixed + (cr*-stbi__float2fixed(0.71414f)) + ((cb*-stbi__float2fixed(0.34414f)) & 0xffff0000);\par
3670       b = y_fixed                                     +   cb* stbi__float2fixed(1.77200f);\par
3671       r >>= 20;\par
3672       g >>= 20;\par
3673       b >>= 20;\par
3674       {\cf19 if} (({\cf18 unsigned}) r > 255) \{ {\cf19 if} (r < 0) r = 0; {\cf19 else} r = 255; \}\par
3675       {\cf19 if} (({\cf18 unsigned}) g > 255) \{ {\cf19 if} (g < 0) g = 0; {\cf19 else} g = 255; \}\par
3676       {\cf19 if} (({\cf18 unsigned}) b > 255) \{ {\cf19 if} (b < 0) b = 0; {\cf19 else} b = 255; \}\par
3677       out[0] = (stbi_uc)r;\par
3678       out[1] = (stbi_uc)g;\par
3679       out[2] = (stbi_uc)b;\par
3680       out[3] = 255;\par
3681       out += step;\par
3682    \}\par
3683 \}\par
3684 \par
3685 {\cf21 #if defined(STBI_SSE2) || defined(STBI_NEON)}\par
3686 {\cf17 static} {\cf18 void} stbi__YCbCr_to_RGB_simd(stbi_uc *out, stbi_uc {\cf17 const} *y, stbi_uc {\cf17 const} *pcb, stbi_uc {\cf17 const} *pcr, {\cf18 int} count, {\cf18 int} step)\par
3687 \{\par
3688    {\cf18 int} i = 0;\par
3689 \par
3690 {\cf21 #ifdef STBI_SSE2}\par
3691    {\cf20 // step == 3 is pretty ugly on the final interleave, and i'm not convinced}\par
3692    {\cf20 // it's useful in practice (you wouldn't use it for textures, for example).}\par
3693    {\cf20 // so just accelerate step == 4 case.}\par
3694    {\cf19 if} (step == 4) \{\par
3695       {\cf20 // this is a fairly straightforward implementation and not super-optimized.}\par
3696       __m128i signflip  = _mm_set1_epi8(-0x80);\par
3697       __m128i cr_const0 = _mm_set1_epi16(   ({\cf18 short}) ( 1.40200f*4096.0f+0.5f));\par
3698       __m128i cr_const1 = _mm_set1_epi16( - ({\cf18 short}) ( 0.71414f*4096.0f+0.5f));\par
3699       __m128i cb_const0 = _mm_set1_epi16( - ({\cf18 short}) ( 0.34414f*4096.0f+0.5f));\par
3700       __m128i cb_const1 = _mm_set1_epi16(   ({\cf18 short}) ( 1.77200f*4096.0f+0.5f));\par
3701       __m128i y_bias = _mm_set1_epi8(({\cf18 char}) ({\cf18 unsigned} {\cf18 char}) 128);\par
3702       __m128i xw = _mm_set1_epi16(255); {\cf20 // alpha channel}\par
3703 \par
3704       {\cf19 for} (; i+7 < count; i += 8) \{\par
3705          {\cf20 // load}\par
3706          __m128i y_bytes = _mm_loadl_epi64((__m128i *) (y+i));\par
3707          __m128i cr_bytes = _mm_loadl_epi64((__m128i *) (pcr+i));\par
3708          __m128i cb_bytes = _mm_loadl_epi64((__m128i *) (pcb+i));\par
3709          __m128i cr_biased = _mm_xor_si128(cr_bytes, signflip); {\cf20 // -128}\par
3710          __m128i cb_biased = _mm_xor_si128(cb_bytes, signflip); {\cf20 // -128}\par
3711 \par
3712          {\cf20 // unpack to short (and left-shift cr, cb by 8)}\par
3713          __m128i yw  = _mm_unpacklo_epi8(y_bias, y_bytes);\par
3714          __m128i crw = _mm_unpacklo_epi8(_mm_setzero_si128(), cr_biased);\par
3715          __m128i cbw = _mm_unpacklo_epi8(_mm_setzero_si128(), cb_biased);\par
3716 \par
3717          {\cf20 // color transform}\par
3718          __m128i yws = _mm_srli_epi16(yw, 4);\par
3719          __m128i cr0 = _mm_mulhi_epi16(cr_const0, crw);\par
3720          __m128i cb0 = _mm_mulhi_epi16(cb_const0, cbw);\par
3721          __m128i cb1 = _mm_mulhi_epi16(cbw, cb_const1);\par
3722          __m128i cr1 = _mm_mulhi_epi16(crw, cr_const1);\par
3723          __m128i rws = _mm_add_epi16(cr0, yws);\par
3724          __m128i gwt = _mm_add_epi16(cb0, yws);\par
3725          __m128i bws = _mm_add_epi16(yws, cb1);\par
3726          __m128i gws = _mm_add_epi16(gwt, cr1);\par
3727 \par
3728          {\cf20 // descale}\par
3729          __m128i rw = _mm_srai_epi16(rws, 4);\par
3730          __m128i bw = _mm_srai_epi16(bws, 4);\par
3731          __m128i gw = _mm_srai_epi16(gws, 4);\par
3732 \par
3733          {\cf20 // back to byte, set up for transpose}\par
3734          __m128i brb = _mm_packus_epi16(rw, bw);\par
3735          __m128i gxb = _mm_packus_epi16(gw, xw);\par
3736 \par
3737          {\cf20 // transpose to interleave channels}\par
3738          __m128i t0 = _mm_unpacklo_epi8(brb, gxb);\par
3739          __m128i t1 = _mm_unpackhi_epi8(brb, gxb);\par
3740          __m128i o0 = _mm_unpacklo_epi16(t0, t1);\par
3741          __m128i o1 = _mm_unpackhi_epi16(t0, t1);\par
3742 \par
3743          {\cf20 // store}\par
3744          _mm_storeu_si128((__m128i *) (out + 0), o0);\par
3745          _mm_storeu_si128((__m128i *) (out + 16), o1);\par
3746          out += 32;\par
3747       \}\par
3748    \}\par
3749 {\cf21 #endif}\par
3750 \par
3751 {\cf21 #ifdef STBI_NEON}\par
3752    {\cf20 // in this version, step=3 support would be easy to add. but is there demand?}\par
3753    {\cf19 if} (step == 4) \{\par
3754       {\cf20 // this is a fairly straightforward implementation and not super-optimized.}\par
3755       uint8x8_t signflip = vdup_n_u8(0x80);\par
3756       int16x8_t cr_const0 = vdupq_n_s16(   ({\cf18 short}) ( 1.40200f*4096.0f+0.5f));\par
3757       int16x8_t cr_const1 = vdupq_n_s16( - ({\cf18 short}) ( 0.71414f*4096.0f+0.5f));\par
3758       int16x8_t cb_const0 = vdupq_n_s16( - ({\cf18 short}) ( 0.34414f*4096.0f+0.5f));\par
3759       int16x8_t cb_const1 = vdupq_n_s16(   ({\cf18 short}) ( 1.77200f*4096.0f+0.5f));\par
3760 \par
3761       {\cf19 for} (; i+7 < count; i += 8) \{\par
3762          {\cf20 // load}\par
3763          uint8x8_t y_bytes  = vld1_u8(y + i);\par
3764          uint8x8_t cr_bytes = vld1_u8(pcr + i);\par
3765          uint8x8_t cb_bytes = vld1_u8(pcb + i);\par
3766          int8x8_t cr_biased = vreinterpret_s8_u8(vsub_u8(cr_bytes, signflip));\par
3767          int8x8_t cb_biased = vreinterpret_s8_u8(vsub_u8(cb_bytes, signflip));\par
3768 \par
3769          {\cf20 // expand to s16}\par
3770          int16x8_t yws = vreinterpretq_s16_u16(vshll_n_u8(y_bytes, 4));\par
3771          int16x8_t crw = vshll_n_s8(cr_biased, 7);\par
3772          int16x8_t cbw = vshll_n_s8(cb_biased, 7);\par
3773 \par
3774          {\cf20 // color transform}\par
3775          int16x8_t cr0 = vqdmulhq_s16(crw, cr_const0);\par
3776          int16x8_t cb0 = vqdmulhq_s16(cbw, cb_const0);\par
3777          int16x8_t cr1 = vqdmulhq_s16(crw, cr_const1);\par
3778          int16x8_t cb1 = vqdmulhq_s16(cbw, cb_const1);\par
3779          int16x8_t rws = vaddq_s16(yws, cr0);\par
3780          int16x8_t gws = vaddq_s16(vaddq_s16(yws, cb0), cr1);\par
3781          int16x8_t bws = vaddq_s16(yws, cb1);\par
3782 \par
3783          {\cf20 // undo scaling, round, convert to byte}\par
3784          uint8x8x4_t o;\par
3785          o.val[0] = vqrshrun_n_s16(rws, 4);\par
3786          o.val[1] = vqrshrun_n_s16(gws, 4);\par
3787          o.val[2] = vqrshrun_n_s16(bws, 4);\par
3788          o.val[3] = vdup_n_u8(255);\par
3789 \par
3790          {\cf20 // store, interleaving r/g/b/a}\par
3791          vst4_u8(out, o);\par
3792          out += 8*4;\par
3793       \}\par
3794    \}\par
3795 {\cf21 #endif}\par
3796 \par
3797    {\cf19 for} (; i < count; ++i) \{\par
3798       {\cf18 int} y_fixed = (y[i] << 20) + (1<<19); {\cf20 // rounding}\par
3799       {\cf18 int} r,g,b;\par
3800       {\cf18 int} cr = pcr[i] - 128;\par
3801       {\cf18 int} cb = pcb[i] - 128;\par
3802       r = y_fixed + cr* stbi__float2fixed(1.40200f);\par
3803       g = y_fixed + cr*-stbi__float2fixed(0.71414f) + ((cb*-stbi__float2fixed(0.34414f)) & 0xffff0000);\par
3804       b = y_fixed                                   +   cb* stbi__float2fixed(1.77200f);\par
3805       r >>= 20;\par
3806       g >>= 20;\par
3807       b >>= 20;\par
3808       {\cf19 if} (({\cf18 unsigned}) r > 255) \{ {\cf19 if} (r < 0) r = 0; {\cf19 else} r = 255; \}\par
3809       {\cf19 if} (({\cf18 unsigned}) g > 255) \{ {\cf19 if} (g < 0) g = 0; {\cf19 else} g = 255; \}\par
3810       {\cf19 if} (({\cf18 unsigned}) b > 255) \{ {\cf19 if} (b < 0) b = 0; {\cf19 else} b = 255; \}\par
3811       out[0] = (stbi_uc)r;\par
3812       out[1] = (stbi_uc)g;\par
3813       out[2] = (stbi_uc)b;\par
3814       out[3] = 255;\par
3815       out += step;\par
3816    \}\par
3817 \}\par
3818 {\cf21 #endif}\par
