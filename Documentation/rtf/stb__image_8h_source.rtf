4359 {\cf17 static} {\cf18 int} stbi__compute_huffman_codes(stbi__zbuf *a)\par
4360 \{\par
4361    {\cf17 static} {\cf17 const} stbi_uc length_dezigzag[19] = \{ 16,17,18,0,8,7,9,6,10,5,11,4,12,3,13,2,14,1,15 \};\par
4362    stbi__zhuffman z_codelength;\par
4363    stbi_uc lencodes[286+32+137];{\cf20 //padding for maximum single op}\par
4364    stbi_uc codelength_sizes[19];\par
4365    {\cf18 int} i,n;\par
4366 \par
4367    {\cf18 int} hlit  = stbi__zreceive(a,5) + 257;\par
4368    {\cf18 int} hdist = stbi__zreceive(a,5) + 1;\par
4369    {\cf18 int} hclen = stbi__zreceive(a,4) + 4;\par
4370    {\cf18 int} ntot  = hlit + hdist;\par
4371 \par
4372    memset(codelength_sizes, 0, {\cf17 sizeof}(codelength_sizes));\par
4373    {\cf19 for} (i=0; i < hclen; ++i) \{\par
4374       {\cf18 int} s = stbi__zreceive(a,3);\par
4375       codelength_sizes[length_dezigzag[i]] = (stbi_uc) s;\par
4376    \}\par
4377    {\cf19 if} (!stbi__zbuild_huffman(&z_codelength, codelength_sizes, 19)) {\cf19 return} 0;\par
4378 \par
4379    n = 0;\par
4380    {\cf19 while} (n < ntot) \{\par
4381       {\cf18 int} c = stbi__zhuffman_decode(a, &z_codelength);\par
4382       {\cf19 if} (c < 0 || c >= 19) {\cf19 return} stbi__err({\cf22 "bad codelengths"}, {\cf22 "Corrupt PNG"});\par
4383       {\cf19 if} (c < 16)\par
4384          lencodes[n++] = (stbi_uc) c;\par
4385       {\cf19 else} \{\par
4386          stbi_uc fill = 0;\par
4387          {\cf19 if} (c == 16) \{\par
4388             c = stbi__zreceive(a,2)+3;\par
4389             {\cf19 if} (n == 0) {\cf19 return} stbi__err({\cf22 "bad codelengths"}, {\cf22 "Corrupt PNG"});\par
4390             fill = lencodes[n-1];\par
4391          \} {\cf19 else} {\cf19 if} (c == 17) \{\par
4392             c = stbi__zreceive(a,3)+3;\par
4393          \} {\cf19 else} {\cf19 if} (c == 18) \{\par
4394             c = stbi__zreceive(a,7)+11;\par
4395          \} {\cf19 else} \{\par
4396             {\cf19 return} stbi__err({\cf22 "bad codelengths"}, {\cf22 "Corrupt PNG"});\par
4397          \}\par
4398          {\cf19 if} (ntot - n < c) {\cf19 return} stbi__err({\cf22 "bad codelengths"}, {\cf22 "Corrupt PNG"});\par
4399          memset(lencodes+n, fill, c);\par
4400          n += c;\par
4401       \}\par
4402    \}\par
4403    {\cf19 if} (n != ntot) {\cf19 return} stbi__err({\cf22 "bad codelengths"},{\cf22 "Corrupt PNG"});\par
4404    {\cf19 if} (!stbi__zbuild_huffman(&a->z_length, lencodes, hlit)) {\cf19 return} 0;\par
4405    {\cf19 if} (!stbi__zbuild_huffman(&a->z_distance, lencodes+hlit, hdist)) {\cf19 return} 0;\par
4406    {\cf19 return} 1;\par
4407 \}\par
