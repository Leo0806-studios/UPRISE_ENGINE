132 {\cf20 // DOCUMENTATION}\par
133 {\cf20 //}\par
134 {\cf20 // Limitations:}\par
135 {\cf20 //    - no 12-bit-per-channel JPEG}\par
136 {\cf20 //    - no JPEGs with arithmetic coding}\par
137 {\cf20 //    - GIF always returns *comp=4}\par
138 {\cf20 //}\par
139 {\cf20 // Basic usage (see HDR discussion below for HDR usage):}\par
140 {\cf20 //    int x,y,n;}\par
141 {\cf20 //    unsigned char *data = stbi_load(filename, &x, &y, &n, 0);}\par
142 {\cf20 //    // ... process data if not NULL ...}\par
143 {\cf20 //    // ... x = width, y = height, n = # 8-bit components per pixel ...}\par
144 {\cf20 //    // ... replace '0' with '1'..'4' to force that many components per pixel}\par
145 {\cf20 //    // ... but 'n' will always be the number that it would have been if you said 0}\par
146 {\cf20 //    stbi_image_free(data);}\par
147 {\cf20 //}\par
148 {\cf20 // Standard parameters:}\par
149 {\cf20 //    int *x                 -- outputs image width in pixels}\par
150 {\cf20 //    int *y                 -- outputs image height in pixels}\par
151 {\cf20 //    int *channels_in_file  -- outputs # of image components in image file}\par
152 {\cf20 //    int desired_channels   -- if non-zero, # of image components requested in result}\par
153 {\cf20 //}\par
154 {\cf20 // The return value from an image loader is an 'unsigned char *' which points}\par
155 {\cf20 // to the pixel data, or NULL on an allocation failure or if the image is}\par
156 {\cf20 // corrupt or invalid. The pixel data consists of *y scanlines of *x pixels,}\par
157 {\cf20 // with each pixel consisting of N interleaved 8-bit components; the first}\par
158 {\cf20 // pixel pointed to is top-left-most in the image. There is no padding between}\par
159 {\cf20 // image scanlines or between pixels, regardless of format. The number of}\par
160 {\cf20 // components N is 'desired_channels' if desired_channels is non-zero, or}\par
161 {\cf20 // *channels_in_file otherwise. If desired_channels is non-zero,}\par
162 {\cf20 // *channels_in_file has the number of components that _would_ have been}\par
163 {\cf20 // output otherwise. E.g. if you set desired_channels to 4, you will always}\par
164 {\cf20 // get RGBA output, but you can check *channels_in_file to see if it's trivially}\par
165 {\cf20 // opaque because e.g. there were only 3 channels in the source image.}\par
166 {\cf20 //}\par
167 {\cf20 // An output image with N components has the following components interleaved}\par
168 {\cf20 // in this order in each pixel:}\par
169 {\cf20 //}\par
170 {\cf20 //     N=#comp     components}\par
171 {\cf20 //       1           grey}\par
172 {\cf20 //       2           grey, alpha}\par
173 {\cf20 //       3           red, green, blue}\par
174 {\cf20 //       4           red, green, blue, alpha}\par
175 {\cf20 //}\par
176 {\cf20 // If image loading fails for any reason, the return value will be NULL,}\par
177 {\cf20 // and *x, *y, *channels_in_file will be unchanged. The function}\par
178 {\cf20 // stbi_failure_reason() can be queried for an extremely brief, end-user}\par
179 {\cf20 // unfriendly explanation of why the load failed. Define STBI_NO_FAILURE_STRINGS}\par
180 {\cf20 // to avoid compiling these strings at all, and STBI_FAILURE_USERMSG to get slightly}\par
181 {\cf20 // more user-friendly ones.}\par
182 {\cf20 //}\par
183 {\cf20 // Paletted PNG, BMP, GIF, and PIC images are automatically depalettized.}\par
184 {\cf20 //}\par
185 {\cf20 // To query the width, height and component count of an image without having to}\par
186 {\cf20 // decode the full file, you can use the stbi_info family of functions:}\par
187 {\cf20 //}\par
188 {\cf20 //   int x,y,n,ok;}\par
189 {\cf20 //   ok = stbi_info(filename, &x, &y, &n);}\par
190 {\cf20 //   // returns ok=1 and sets x, y, n if image is a supported format,}\par
191 {\cf20 //   // 0 otherwise.}\par
192 {\cf20 //}\par
193 {\cf20 // Note that stb_image pervasively uses ints in its public API for sizes,}\par
194 {\cf20 // including sizes of memory buffers. This is now part of the API and thus}\par
195 {\cf20 // hard to change without causing breakage. As a result, the various image}\par
196 {\cf20 // loaders all have certain limits on image size; these differ somewhat}\par
197 {\cf20 // by format but generally boil down to either just under 2GB or just under}\par
198 {\cf20 // 1GB. When the decoded image would be larger than this, stb_image decoding}\par
199 {\cf20 // will fail.}\par
200 {\cf20 //}\par
201 {\cf20 // Additionally, stb_image will reject image files that have any of their}\par
202 {\cf20 // dimensions set to a larger value than the configurable STBI_MAX_DIMENSIONS,}\par
203 {\cf20 // which defaults to 2**24 = 16777216 pixels. Due to the above memory limit,}\par
204 {\cf20 // the only way to have an image with such dimensions load correctly}\par
205 {\cf20 // is for it to have a rather extreme aspect ratio. Either way, the}\par
206 {\cf20 // assumption here is that such larger images are likely to be malformed}\par
207 {\cf20 // or malicious. If you do need to load an image with individual dimensions}\par
208 {\cf20 // larger than that, and it still fits in the overall size limit, you can}\par
209 {\cf20 // #define STBI_MAX_DIMENSIONS on your own to be something larger.}\par
210 {\cf20 //}\par
211 {\cf20 // ===========================================================================}\par
212 {\cf20 //}\par
213 {\cf20 // UNICODE:}\par
214 {\cf20 //}\par
215 {\cf20 //   If compiling for Windows and you wish to use Unicode filenames, compile}\par
216 {\cf20 //   with}\par
217 {\cf20 //       #define STBI_WINDOWS_UTF8}\par
218 {\cf20 //   and pass utf8-encoded filenames. Call stbi_convert_wchar_to_utf8 to convert}\par
219 {\cf20 //   Windows wchar_t filenames to utf8.}\par
220 {\cf20 //}\par
221 {\cf20 // ===========================================================================}\par
222 {\cf20 //}\par
223 {\cf20 // Philosophy}\par
224 {\cf20 //}\par
225 {\cf20 // stb libraries are designed with the following priorities:}\par
226 {\cf20 //}\par
227 {\cf20 //    1. easy to use}\par
228 {\cf20 //    2. easy to maintain}\par
229 {\cf20 //    3. good performance}\par
230 {\cf20 //}\par
231 {\cf20 // Sometimes I let "good performance" creep up in priority over "easy to maintain",}\par
232 {\cf20 // and for best performance I may provide less-easy-to-use APIs that give higher}\par
233 {\cf20 // performance, in addition to the easy-to-use ones. Nevertheless, it's important}\par
234 {\cf20 // to keep in mind that from the standpoint of you, a client of this library,}\par
235 {\cf20 // all you care about is #1 and #3, and stb libraries DO NOT emphasize #3 above all.}\par
236 {\cf20 //}\par
237 {\cf20 // Some secondary priorities arise directly from the first two, some of which}\par
238 {\cf20 // provide more explicit reasons why performance can't be emphasized.}\par
239 {\cf20 //}\par
240 {\cf20 //    - Portable ("ease of use")}\par
241 {\cf20 //    - Small source code footprint ("easy to maintain")}\par
242 {\cf20 //    - No dependencies ("ease of use")}\par
243 {\cf20 //}\par
244 {\cf20 // ===========================================================================}\par
245 {\cf20 //}\par
246 {\cf20 // I/O callbacks}\par
247 {\cf20 //}\par
248 {\cf20 // I/O callbacks allow you to read from arbitrary sources, like packaged}\par
249 {\cf20 // files or some other source. Data read from callbacks are processed}\par
250 {\cf20 // through a small internal buffer (currently 128 bytes) to try to reduce}\par
251 {\cf20 // overhead.}\par
252 {\cf20 //}\par
253 {\cf20 // The three functions you must define are "read" (reads some bytes of data),}\par
254 {\cf20 // "skip" (skips some bytes of data), "eof" (reports if the stream is at the end).}\par
255 {\cf20 //}\par
256 {\cf20 // ===========================================================================}\par
257 {\cf20 //}\par
258 {\cf20 // SIMD support}\par
259 {\cf20 //}\par
260 {\cf20 // The JPEG decoder will try to automatically use SIMD kernels on x86 when}\par
261 {\cf20 // supported by the compiler. For ARM Neon support, you must explicitly}\par
262 {\cf20 // request it.}\par
263 {\cf20 //}\par
264 {\cf20 // (The old do-it-yourself SIMD API is no longer supported in the current}\par
265 {\cf20 // code.)}\par
266 {\cf20 //}\par
267 {\cf20 // On x86, SSE2 will automatically be used when available based on a run-time}\par
268 {\cf20 // test; if not, the generic C versions are used as a fall-back. On ARM targets,}\par
269 {\cf20 // the typical path is to have separate builds for NEON and non-NEON devices}\par
270 {\cf20 // (at least this is true for iOS and Android). Therefore, the NEON support is}\par
271 {\cf20 // toggled by a build flag: define STBI_NEON to get NEON loops.}\par
272 {\cf20 //}\par
273 {\cf20 // If for some reason you do not want to use any of SIMD code, or if}\par
274 {\cf20 // you have issues compiling it, you can disable it entirely by}\par
275 {\cf20 // defining STBI_NO_SIMD.}\par
276 {\cf20 //}\par
277 {\cf20 // ===========================================================================}\par
278 {\cf20 //}\par
279 {\cf20 // HDR image support   (disable by defining STBI_NO_HDR)}\par
280 {\cf20 //}\par
281 {\cf20 // stb_image supports loading HDR images in general, and currently the Radiance}\par
282 {\cf20 // .HDR file format specifically. You can still load any file through the existing}\par
283 {\cf20 // interface; if you attempt to load an HDR file, it will be automatically remapped}\par
284 {\cf20 // to LDR, assuming gamma 2.2 and an arbitrary scale factor defaulting to 1;}\par
285 {\cf20 // both of these constants can be reconfigured through this interface:}\par
286 {\cf20 //}\par
287 {\cf20 //     stbi_hdr_to_ldr_gamma(2.2f);}\par
288 {\cf20 //     stbi_hdr_to_ldr_scale(1.0f);}\par
289 {\cf20 //}\par
290 {\cf20 // (note, do not use _inverse_ constants; stbi_image will invert them}\par
291 {\cf20 // appropriately).}\par
292 {\cf20 //}\par
293 {\cf20 // Additionally, there is a new, parallel interface for loading files as}\par
294 {\cf20 // (linear) floats to preserve the full dynamic range:}\par
295 {\cf20 //}\par
296 {\cf20 //    float *data = stbi_loadf(filename, &x, &y, &n, 0);}\par
297 {\cf20 //}\par
298 {\cf20 // If you load LDR images through this interface, those images will}\par
299 {\cf20 // be promoted to floating point values, run through the inverse of}\par
300 {\cf20 // constants corresponding to the above:}\par
301 {\cf20 //}\par
302 {\cf20 //     stbi_ldr_to_hdr_scale(1.0f);}\par
303 {\cf20 //     stbi_ldr_to_hdr_gamma(2.2f);}\par
304 {\cf20 //}\par
305 {\cf20 // Finally, given a filename (or an open file or memory block--see header}\par
306 {\cf20 // file for details) containing image data, you can query for the "most}\par
307 {\cf20 // appropriate" interface to use (that is, whether the image is HDR or}\par
308 {\cf20 // not), using:}\par
309 {\cf20 //}\par
310 {\cf20 //     stbi_is_hdr(char *filename);}\par
311 {\cf20 //}\par
312 {\cf20 // ===========================================================================}\par
313 {\cf20 //}\par
314 {\cf20 // iPhone PNG support:}\par
315 {\cf20 //}\par
316 {\cf20 // We optionally support converting iPhone-formatted PNGs (which store}\par
317 {\cf20 // premultiplied BGRA) back to RGB, even though they're internally encoded}\par
318 {\cf20 // differently. To enable this conversion, call}\par
319 {\cf20 // stbi_convert_iphone_png_to_rgb(1).}\par
320 {\cf20 //}\par
321 {\cf20 // Call stbi_set_unpremultiply_on_load(1) as well to force a divide per}\par
322 {\cf20 // pixel to remove any premultiplied alpha *only* if the image file explicitly}\par
323 {\cf20 // says there's premultiplied data (currently only happens in iPhone images,}\par
324 {\cf20 // and only if iPhone convert-to-rgb processing is on).}\par
325 {\cf20 //}\par
326 {\cf20 // ===========================================================================}\par
327 {\cf20 //}\par
328 {\cf20 // ADDITIONAL CONFIGURATION}\par
329 {\cf20 //}\par
330 {\cf20 //  - You can suppress implementation of any of the decoders to reduce}\par
331 {\cf20 //    your code footprint by #defining one or more of the following}\par
332 {\cf20 //    symbols before creating the implementation.}\par
333 {\cf20 //}\par
334 {\cf20 //        STBI_NO_JPEG}\par
335 {\cf20 //        STBI_NO_PNG}\par
336 {\cf20 //        STBI_NO_BMP}\par
337 {\cf20 //        STBI_NO_PSD}\par
338 {\cf20 //        STBI_NO_TGA}\par
339 {\cf20 //        STBI_NO_GIF}\par
340 {\cf20 //        STBI_NO_HDR}\par
341 {\cf20 //        STBI_NO_PIC}\par
342 {\cf20 //        STBI_NO_PNM   (.ppm and .pgm)}\par
343 {\cf20 //}\par
344 {\cf20 //  - You can request *only* certain decoders and suppress all other ones}\par
345 {\cf20 //    (this will be more forward-compatible, as addition of new decoders}\par
346 {\cf20 //    doesn't require you to disable them explicitly):}\par
347 {\cf20 //}\par
348 {\cf20 //        STBI_ONLY_JPEG}\par
349 {\cf20 //        STBI_ONLY_PNG}\par
350 {\cf20 //        STBI_ONLY_BMP}\par
351 {\cf20 //        STBI_ONLY_PSD}\par
352 {\cf20 //        STBI_ONLY_TGA}\par
353 {\cf20 //        STBI_ONLY_GIF}\par
354 {\cf20 //        STBI_ONLY_HDR}\par
355 {\cf20 //        STBI_ONLY_PIC}\par
356 {\cf20 //        STBI_ONLY_PNM   (.ppm and .pgm)}\par
357 {\cf20 //}\par
358 {\cf20 //   - If you use STBI_NO_PNG (or _ONLY_ without PNG), and you still}\par
359 {\cf20 //     want the zlib decoder to be available, #define STBI_SUPPORT_ZLIB}\par
360 {\cf20 //}\par
361 {\cf20 //  - If you define STBI_MAX_DIMENSIONS, stb_image will reject images greater}\par
362 {\cf20 //    than that size (in either width or height) without further processing.}\par
363 {\cf20 //    This is to let programs in the wild set an upper bound to prevent}\par
364 {\cf20 //    denial-of-service attacks on untrusted data, as one could generate a}\par
365 {\cf20 //    valid image of gigantic dimensions and force stb_image to allocate a}\par
366 {\cf20 //    huge block of memory and spend disproportionate time decoding it. By}\par
367 {\cf20 //    default this is set to (1 << 24), which is 16777216, but that's still}\par
368 {\cf20 //    very big.}\par
