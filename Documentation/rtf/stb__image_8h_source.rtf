6346 {\cf17 static} {\cf18 int} stbi__pic_test_core(stbi__context *s)\par
6347 \{\par
6348    {\cf18 int} i;\par
6349 \par
6350    {\cf19 if} (!stbi__pic_is4(s,{\cf22 "\\x53\\x80\\xF6\\x34"}))\par
6351       {\cf19 return} 0;\par
6352 \par
6353    {\cf19 for}(i=0;i<84;++i)\par
6354       stbi__get8(s);\par
6355 \par
6356    {\cf19 if} (!stbi__pic_is4(s,{\cf22 "PICT"}))\par
6357       {\cf19 return} 0;\par
6358 \par
6359    {\cf19 return} 1;\par
6360 \}\par
6361 \par
6362 {\cf17 typedef} {\cf17 struct}\par
6363 \{\par
6364    stbi_uc size,type,channel;\par
6365 \} stbi__pic_packet;\par
6366 \par
6367 {\cf17 static} stbi_uc *stbi__readval(stbi__context *s, {\cf18 int} channel, stbi_uc *dest)\par
6368 \{\par
6369    {\cf18 int} mask=0x80, i;\par
6370 \par
6371    {\cf19 for} (i=0; i<4; ++i, mask>>=1) \{\par
6372       {\cf19 if} (channel & mask) \{\par
6373          {\cf19 if} (stbi__at_eof(s)) {\cf19 return} stbi__errpuc({\cf22 "bad file"},{\cf22 "PIC file too short"});\par
6374          dest[i]=stbi__get8(s);\par
6375       \}\par
6376    \}\par
6377 \par
6378    {\cf19 return} dest;\par
6379 \}\par
6380 \par
6381 {\cf17 static} {\cf18 void} stbi__copyval({\cf18 int} channel,stbi_uc *dest,{\cf17 const} stbi_uc *src)\par
6382 \{\par
6383    {\cf18 int} mask=0x80,i;\par
6384 \par
6385    {\cf19 for} (i=0;i<4; ++i, mask>>=1)\par
6386       {\cf19 if} (channel&mask)\par
6387          dest[i]=src[i];\par
6388 \}\par
6389 \par
6390 {\cf17 static} stbi_uc *stbi__pic_load_core(stbi__context *s,{\cf18 int} width,{\cf18 int} height,{\cf18 int} *comp, stbi_uc *result)\par
6391 \{\par
6392    {\cf18 int} act_comp=0,num_packets=0,y,chained;\par
6393    stbi__pic_packet packets[10];\par
6394 \par
6395    {\cf20 // this will (should...) cater for even some bizarre stuff like having data}\par
6396     {\cf20 // for the same channel in multiple packets.}\par
6397    {\cf19 do} \{\par
6398       stbi__pic_packet *packet;\par
6399 \par
6400       {\cf19 if} (num_packets=={\cf17 sizeof}(packets)/{\cf17 sizeof}(packets[0]))\par
6401          {\cf19 return} stbi__errpuc({\cf22 "bad format"},{\cf22 "too many packets"});\par
6402 \par
6403       packet = &packets[num_packets++];\par
6404 \par
6405       chained = stbi__get8(s);\par
6406       packet->size    = stbi__get8(s);\par
6407       packet->type    = stbi__get8(s);\par
6408       packet->channel = stbi__get8(s);\par
6409 \par
6410       act_comp |= packet->channel;\par
6411 \par
6412       {\cf19 if} (stbi__at_eof(s))          {\cf19 return} stbi__errpuc({\cf22 "bad file"},{\cf22 "file too short (reading packets)"});\par
6413       {\cf19 if} (packet->size != 8)  {\cf19 return} stbi__errpuc({\cf22 "bad format"},{\cf22 "packet isn't 8bpp"});\par
6414    \} {\cf19 while} (chained);\par
6415 \par
6416    *comp = (act_comp & 0x10 ? 4 : 3); {\cf20 // has alpha channel?}\par
6417 \par
6418    {\cf19 for}(y=0; y<height; ++y) \{\par
6419       {\cf18 int} packet_idx;\par
6420 \par
6421       {\cf19 for}(packet_idx=0; packet_idx < num_packets; ++packet_idx) \{\par
6422          stbi__pic_packet *packet = &packets[packet_idx];\par
6423          stbi_uc *dest = result+y*width*4;\par
6424 \par
6425          {\cf19 switch} (packet->type) \{\par
6426             {\cf19 default}:\par
6427                {\cf19 return} stbi__errpuc({\cf22 "bad format"},{\cf22 "packet has bad compression type"});\par
6428 \par
6429             {\cf19 case} 0: \{{\cf20 //uncompressed}\par
6430                {\cf18 int} x;\par
6431 \par
6432                {\cf19 for}(x=0;x<width;++x, dest+=4)\par
6433                   {\cf19 if} (!stbi__readval(s,packet->channel,dest))\par
6434                      {\cf19 return} 0;\par
6435                {\cf19 break};\par
6436             \}\par
6437 \par
6438             {\cf19 case} 1:{\cf20 //Pure RLE}\par
6439                \{\par
6440                   {\cf18 int} left=width, i;\par
6441 \par
6442                   {\cf19 while} (left>0) \{\par
6443                      stbi_uc count,value[4];\par
6444 \par
6445                      count=stbi__get8(s);\par
6446                      {\cf19 if} (stbi__at_eof(s))   {\cf19 return} stbi__errpuc({\cf22 "bad file"},{\cf22 "file too short (pure read count)"});\par
6447 \par
6448                      {\cf19 if} (count > left)\par
6449                         count = (stbi_uc) left;\par
6450 \par
6451                      {\cf19 if} (!stbi__readval(s,packet->channel,value))  {\cf19 return} 0;\par
6452 \par
6453                      {\cf19 for}(i=0; i<count; ++i,dest+=4)\par
6454                         stbi__copyval(packet->channel,dest,value);\par
6455                      left -= count;\par
6456                   \}\par
6457                \}\par
6458                {\cf19 break};\par
6459 \par
6460             {\cf19 case} 2: \{{\cf20 //Mixed RLE}\par
6461                {\cf18 int} left=width;\par
6462                {\cf19 while} (left>0) \{\par
6463                   {\cf18 int} count = stbi__get8(s), i;\par
6464                   {\cf19 if} (stbi__at_eof(s))  {\cf19 return} stbi__errpuc({\cf22 "bad file"},{\cf22 "file too short (mixed read count)"});\par
6465 \par
6466                   {\cf19 if} (count >= 128) \{ {\cf20 // Repeated}\par
6467                      stbi_uc value[4];\par
6468 \par
6469                      {\cf19 if} (count==128)\par
6470                         count = stbi__get16be(s);\par
6471                      {\cf19 else}\par
6472                         count -= 127;\par
6473                      {\cf19 if} (count > left)\par
6474                         {\cf19 return} stbi__errpuc({\cf22 "bad file"},{\cf22 "scanline overrun"});\par
6475 \par
6476                      {\cf19 if} (!stbi__readval(s,packet->channel,value))\par
6477                         {\cf19 return} 0;\par
6478 \par
6479                      {\cf19 for}(i=0;i<count;++i, dest += 4)\par
6480                         stbi__copyval(packet->channel,dest,value);\par
6481                   \} {\cf19 else} \{ {\cf20 // Raw}\par
6482                      ++count;\par
6483                      {\cf19 if} (count>left) {\cf19 return} stbi__errpuc({\cf22 "bad file"},{\cf22 "scanline overrun"});\par
6484 \par
6485                      {\cf19 for}(i=0;i<count;++i, dest+=4)\par
6486                         {\cf19 if} (!stbi__readval(s,packet->channel,dest))\par
6487                            {\cf19 return} 0;\par
6488                   \}\par
6489                   left-=count;\par
6490                \}\par
6491                {\cf19 break};\par
6492             \}\par
6493          \}\par
6494       \}\par
6495    \}\par
6496 \par
6497    {\cf19 return} result;\par
6498 \}\par
6499 \par
6500 {\cf17 static} {\cf18 void} *stbi__pic_load(stbi__context *s,{\cf18 int} *px,{\cf18 int} *py,{\cf18 int} *comp,{\cf18 int} req_comp, stbi__result_info *ri)\par
6501 \{\par
6502    stbi_uc *result;\par
6503    {\cf18 int} i, x,y, internal_comp;\par
6504    STBI_NOTUSED(ri);\par
6505 \par
6506    {\cf19 if} (!comp) comp = &internal_comp;\par
6507 \par
6508    {\cf19 for} (i=0; i<92; ++i)\par
6509       stbi__get8(s);\par
6510 \par
6511    x = stbi__get16be(s);\par
6512    y = stbi__get16be(s);\par
6513 \par
6514    {\cf19 if} (y > STBI_MAX_DIMENSIONS) {\cf19 return} stbi__errpuc({\cf22 "too large"},{\cf22 "Very large image (corrupt?)"});\par
6515    {\cf19 if} (x > STBI_MAX_DIMENSIONS) {\cf19 return} stbi__errpuc({\cf22 "too large"},{\cf22 "Very large image (corrupt?)"});\par
6516 \par
6517    {\cf19 if} (stbi__at_eof(s))  {\cf19 return} stbi__errpuc({\cf22 "bad file"},{\cf22 "file too short (pic header)"});\par
6518    {\cf19 if} (!stbi__mad3sizes_valid(x, y, 4, 0)) {\cf19 return} stbi__errpuc({\cf22 "too large"}, {\cf22 "PIC image too large to decode"});\par
6519 \par
6520    stbi__get32be(s); {\cf20 //skip `ratio'}\par
6521    stbi__get16be(s); {\cf20 //skip `fields'}\par
6522    stbi__get16be(s); {\cf20 //skip `pad'}\par
6523 \par
6524    {\cf20 // intermediate buffer is RGBA}\par
6525    result = (stbi_uc *) stbi__malloc_mad3(x, y, 4, 0);\par
6526    {\cf19 if} (!result) {\cf19 return} stbi__errpuc({\cf22 "outofmem"}, {\cf22 "Out of memory"});\par
6527    memset(result, 0xff, x*y*4);\par
6528 \par
6529    {\cf19 if} (!stbi__pic_load_core(s,x,y,comp, result)) \{\par
6530       STBI_FREE(result);\par
6531       result=0;\par
6532    \}\par
6533    *px = x;\par
6534    *py = y;\par
6535    {\cf19 if} (req_comp == 0) req_comp = *comp;\par
6536    result=stbi__convert_format(result,4,req_comp,x,y);\par
6537 \par
6538    {\cf19 return} result;\par
6539 \}\par
