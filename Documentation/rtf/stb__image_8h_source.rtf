4657 {\cf17 static} {\cf18 int} stbi__paeth({\cf18 int} a, {\cf18 int} b, {\cf18 int} c)\par
4658 \{\par
4659    {\cf20 // This formulation looks very different from the reference in the PNG spec, but is}\par
4660    {\cf20 // actually equivalent and has favorable data dependencies and admits straightforward}\par
4661    {\cf20 // generation of branch-free code, which helps performance significantly.}\par
4662    {\cf18 int} thresh = c*3 - (a + b);\par
4663    {\cf18 int} lo = a < b ? a : b;\par
4664    {\cf18 int} hi = a < b ? b : a;\par
4665    {\cf18 int} t0 = (hi <= thresh) ? lo : c;\par
4666    {\cf18 int} t1 = (thresh <= lo) ? hi : t0;\par
4667    {\cf19 return} t1;\par
4668 \}\par
