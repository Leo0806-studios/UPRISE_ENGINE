3264 {\cf17 static} {\cf18 int} stbi__process_frame_header(stbi__jpeg *z, {\cf18 int} scan)\par
3265 \{\par
3266    stbi__context *s = z->s;\par
3267    {\cf18 int} Lf,p,i,q, h_max=1,v_max=1,c;\par
3268    Lf = stbi__get16be(s);         {\cf19 if} (Lf < 11) {\cf19 return} stbi__err({\cf22 "bad SOF len"},{\cf22 "Corrupt JPEG"}); {\cf20 // JPEG}\par
3269    p  = stbi__get8(s);            {\cf19 if} (p != 8) {\cf19 return} stbi__err({\cf22 "only 8-bit"},{\cf22 "JPEG format not supported: 8-bit only"}); {\cf20 // JPEG baseline}\par
3270    s->img_y = stbi__get16be(s);   {\cf19 if} (s->img_y == 0) {\cf19 return} stbi__err({\cf22 "no header height"}, {\cf22 "JPEG format not supported: delayed height"}); {\cf20 // Legal, but we don't handle it--but neither does IJG}\par
3271    s->img_x = stbi__get16be(s);   {\cf19 if} (s->img_x == 0) {\cf19 return} stbi__err({\cf22 "0 width"},{\cf22 "Corrupt JPEG"}); {\cf20 // JPEG requires}\par
3272    {\cf19 if} (s->img_y > STBI_MAX_DIMENSIONS) {\cf19 return} stbi__err({\cf22 "too large"},{\cf22 "Very large image (corrupt?)"});\par
3273    {\cf19 if} (s->img_x > STBI_MAX_DIMENSIONS) {\cf19 return} stbi__err({\cf22 "too large"},{\cf22 "Very large image (corrupt?)"});\par
3274    c = stbi__get8(s);\par
3275    {\cf19 if} (c != 3 && c != 1 && c != 4) {\cf19 return} stbi__err({\cf22 "bad component count"},{\cf22 "Corrupt JPEG"});\par
3276    s->img_n = c;\par
3277    {\cf19 for} (i=0; i < c; ++i) \{\par
3278       z->img_comp[i].data = NULL;\par
3279       z->img_comp[i].linebuf = NULL;\par
3280    \}\par
3281 \par
3282    {\cf19 if} (Lf != 8+3*s->img_n) {\cf19 return} stbi__err({\cf22 "bad SOF len"},{\cf22 "Corrupt JPEG"});\par
3283 \par
3284    z->rgb = 0;\par
3285    {\cf19 for} (i=0; i < s->img_n; ++i) \{\par
3286       {\cf17 static} {\cf17 const} {\cf18 unsigned} {\cf18 char} rgb[3] = \{ {\cf23 'R'}, {\cf23 'G'}, {\cf23 'B'} \};\par
3287       z->img_comp[i].id = stbi__get8(s);\par
3288       {\cf19 if} (s->img_n == 3 && z->img_comp[i].id == rgb[i])\par
3289          ++z->rgb;\par
3290       q = stbi__get8(s);\par
3291       z->img_comp[i].h = (q >> 4);  {\cf19 if} (!z->img_comp[i].h || z->img_comp[i].h > 4) {\cf19 return} stbi__err({\cf22 "bad H"},{\cf22 "Corrupt JPEG"});\par
3292       z->img_comp[i].v = q & 15;    {\cf19 if} (!z->img_comp[i].v || z->img_comp[i].v > 4) {\cf19 return} stbi__err({\cf22 "bad V"},{\cf22 "Corrupt JPEG"});\par
3293       z->img_comp[i].tq = stbi__get8(s);  {\cf19 if} (z->img_comp[i].tq > 3) {\cf19 return} stbi__err({\cf22 "bad TQ"},{\cf22 "Corrupt JPEG"});\par
3294    \}\par
3295 \par
3296    {\cf19 if} (scan != STBI__SCAN_load) {\cf19 return} 1;\par
3297 \par
3298    {\cf19 if} (!stbi__mad3sizes_valid(s->img_x, s->img_y, s->img_n, 0)) {\cf19 return} stbi__err({\cf22 "too large"}, {\cf22 "Image too large to decode"});\par
3299 \par
3300    {\cf19 for} (i=0; i < s->img_n; ++i) \{\par
3301       {\cf19 if} (z->img_comp[i].h > h_max) h_max = z->img_comp[i].h;\par
3302       {\cf19 if} (z->img_comp[i].v > v_max) v_max = z->img_comp[i].v;\par
3303    \}\par
3304 \par
3305    {\cf20 // check that plane subsampling factors are integer ratios; our resamplers can't deal with fractional ratios}\par
3306    {\cf20 // and I've never seen a non-corrupted JPEG file actually use them}\par
3307    {\cf19 for} (i=0; i < s->img_n; ++i) \{\par
3308       {\cf19 if} (h_max % z->img_comp[i].h != 0) {\cf19 return} stbi__err({\cf22 "bad H"},{\cf22 "Corrupt JPEG"});\par
3309       {\cf19 if} (v_max % z->img_comp[i].v != 0) {\cf19 return} stbi__err({\cf22 "bad V"},{\cf22 "Corrupt JPEG"});\par
3310    \}\par
3311 \par
3312    {\cf20 // compute interleaved mcu info}\par
3313    z->img_h_max = h_max;\par
3314    z->img_v_max = v_max;\par
3315    z->img_mcu_w = h_max * 8;\par
3316    z->img_mcu_h = v_max * 8;\par
3317    {\cf20 // these sizes can't be more than 17 bits}\par
3318    z->img_mcu_x = (s->img_x + z->img_mcu_w-1) / z->img_mcu_w;\par
3319    z->img_mcu_y = (s->img_y + z->img_mcu_h-1) / z->img_mcu_h;\par
3320 \par
3321    {\cf19 for} (i=0; i < s->img_n; ++i) \{\par
3322       {\cf20 // number of effective pixels (e.g. for non-interleaved MCU)}\par
3323       z->img_comp[i].x = (s->img_x * z->img_comp[i].h + h_max-1) / h_max;\par
3324       z->img_comp[i].y = (s->img_y * z->img_comp[i].v + v_max-1) / v_max;\par
3325       {\cf20 // to simplify generation, we'll allocate enough memory to decode}\par
3326       {\cf20 // the bogus oversized data from using interleaved MCUs and their}\par
3327       {\cf20 // big blocks (e.g. a 16x16 iMCU on an image of width 33); we won't}\par
3328       {\cf20 // discard the extra data until colorspace conversion}\par
3329       {\cf20 //}\par
3330       {\cf20 // img_mcu_x, img_mcu_y: <=17 bits; comp[i].h and .v are <=4 (checked earlier)}\par
3331       {\cf20 // so these muls can't overflow with 32-bit ints (which we require)}\par
3332       z->img_comp[i].w2 = z->img_mcu_x * z->img_comp[i].h * 8;\par
3333       z->img_comp[i].h2 = z->img_mcu_y * z->img_comp[i].v * 8;\par
3334       z->img_comp[i].coeff = 0;\par
3335       z->img_comp[i].raw_coeff = 0;\par
3336       z->img_comp[i].linebuf = NULL;\par
3337       z->img_comp[i].raw_data = stbi__malloc_mad2(z->img_comp[i].w2, z->img_comp[i].h2, 15);\par
3338       {\cf19 if} (z->img_comp[i].raw_data == NULL)\par
3339          {\cf19 return} stbi__free_jpeg_components(z, i+1, stbi__err({\cf22 "outofmem"}, {\cf22 "Out of memory"}));\par
3340       {\cf20 // align blocks for idct using mmx/sse}\par
3341       z->img_comp[i].data = (stbi_uc*) ((({\cf18 size_t}) z->img_comp[i].raw_data + 15) & ~15);\par
3342       {\cf19 if} (z->progressive) \{\par
3343          {\cf20 // w2, h2 are multiples of 8 (see above)}\par
3344          z->img_comp[i].coeff_w = z->img_comp[i].w2 / 8;\par
3345          z->img_comp[i].coeff_h = z->img_comp[i].h2 / 8;\par
3346          z->img_comp[i].raw_coeff = stbi__malloc_mad3(z->img_comp[i].w2, z->img_comp[i].h2, {\cf17 sizeof}({\cf18 short}), 15);\par
3347          {\cf19 if} (z->img_comp[i].raw_coeff == NULL)\par
3348             {\cf19 return} stbi__free_jpeg_components(z, i+1, stbi__err({\cf22 "outofmem"}, {\cf22 "Out of memory"}));\par
3349          z->img_comp[i].coeff = ({\cf18 short}*) ((({\cf18 size_t}) z->img_comp[i].raw_coeff + 15) & ~15);\par
3350       \}\par
3351    \}\par
3352 \par
3353    {\cf19 return} 1;\par
3354 \}\par
