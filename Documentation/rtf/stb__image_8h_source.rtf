3411 {\cf20 // decode image to YCbCr format}\par
3412 {\cf17 static} {\cf18 int} stbi__decode_jpeg_image(stbi__jpeg *j)\par
3413 \{\par
3414    {\cf18 int} m;\par
3415    {\cf19 for} (m = 0; m < 4; m++) \{\par
3416       j->img_comp[m].raw_data = NULL;\par
3417       j->img_comp[m].raw_coeff = NULL;\par
3418    \}\par
3419    j->restart_interval = 0;\par
3420    {\cf19 if} (!stbi__decode_jpeg_header(j, STBI__SCAN_load)) {\cf19 return} 0;\par
3421    m = stbi__get_marker(j);\par
3422    {\cf19 while} (!stbi__EOI(m)) \{\par
3423       {\cf19 if} (stbi__SOS(m)) \{\par
3424          {\cf19 if} (!stbi__process_scan_header(j)) {\cf19 return} 0;\par
3425          {\cf19 if} (!stbi__parse_entropy_coded_data(j)) {\cf19 return} 0;\par
3426          {\cf19 if} (j->marker == STBI__MARKER_none ) \{\par
3427          j->marker = stbi__skip_jpeg_junk_at_end(j);\par
3428             {\cf20 // if we reach eof without hitting a marker, stbi__get_marker() below will fail and we'll eventually return 0}\par
3429          \}\par
3430          m = stbi__get_marker(j);\par
3431          {\cf19 if} (STBI__RESTART(m))\par
3432             m = stbi__get_marker(j);\par
3433       \} {\cf19 else} {\cf19 if} (stbi__DNL(m)) \{\par
3434          {\cf18 int} Ld = stbi__get16be(j->s);\par
3435          stbi__uint32 NL = stbi__get16be(j->s);\par
3436          {\cf19 if} (Ld != 4) {\cf19 return} stbi__err({\cf22 "bad DNL len"}, {\cf22 "Corrupt JPEG"});\par
3437          {\cf19 if} (NL != j->s->img_y) {\cf19 return} stbi__err({\cf22 "bad DNL height"}, {\cf22 "Corrupt JPEG"});\par
3438          m = stbi__get_marker(j);\par
3439       \} {\cf19 else} \{\par
3440          {\cf19 if} (!stbi__process_marker(j, m)) {\cf19 return} 1;\par
3441          m = stbi__get_marker(j);\par
3442       \}\par
3443    \}\par
3444    {\cf19 if} (j->progressive)\par
3445       stbi__jpeg_finish(j);\par
3446    {\cf19 return} 1;\par
3447 \}\par
