4107 stbi_inline {\cf17 static} {\cf18 int} stbi__bitreverse16({\cf18 int} n)\par
4108 \{\par
4109   n = ((n & 0xAAAA) >>  1) | ((n & 0x5555) << 1);\par
4110   n = ((n & 0xCCCC) >>  2) | ((n & 0x3333) << 2);\par
4111   n = ((n & 0xF0F0) >>  4) | ((n & 0x0F0F) << 4);\par
4112   n = ((n & 0xFF00) >>  8) | ((n & 0x00FF) << 8);\par
4113   {\cf19 return} n;\par
4114 \}\par
