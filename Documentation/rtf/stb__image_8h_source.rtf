7574       {\cf19 if}((value > 214748364) || (value == 214748364 && *c > {\cf23 '7'}))\par
7575           {\cf19 return} stbi__err({\cf22 "integer parse overflow"}, {\cf22 "Parsing an integer in the PPM header overflowed a 32-bit int"});\par
7576    \}\par
7577 \par
7578    {\cf19 return} value;\par
7579 \}\par
