3141             {\cf19 if} (tc == 0) \{\par
3142                {\cf19 if} (!stbi__build_huffman(z->huff_dc+th, sizes)) {\cf19 return} 0;\par
3143                v = z->huff_dc[th].values;\par
3144             \} {\cf19 else} \{\par
3145                {\cf19 if} (!stbi__build_huffman(z->huff_ac+th, sizes)) {\cf19 return} 0;\par
3146                v = z->huff_ac[th].values;\par
3147             \}\par
3148             {\cf19 for} (i=0; i < n; ++i)\par
3149                v[i] = stbi__get8(z->s);\par
3150             {\cf19 if} (tc != 0)\par
3151                stbi__build_fast_ac(z->fast_ac[th], z->huff_ac + th);\par
3152             L -= n;\par
3153          \}\par
3154          {\cf19 return} L==0;\par
3155    \}\par
3156 \par
3157    {\cf20 // check for comment block or APP blocks}\par
3158    {\cf19 if} ((m >= 0xE0 && m <= 0xEF) || m == 0xFE) \{\par
3159       L = stbi__get16be(z->s);\par
3160       {\cf19 if} (L < 2) \{\par
3161          {\cf19 if} (m == 0xFE)\par
3162             {\cf19 return} stbi__err({\cf22 "bad COM len"},{\cf22 "Corrupt JPEG"});\par
3163          {\cf19 else}\par
3164             {\cf19 return} stbi__err({\cf22 "bad APP len"},{\cf22 "Corrupt JPEG"});\par
3165       \}\par
3166       L -= 2;\par
3167 \par
3168       {\cf19 if} (m == 0xE0 && L >= 5) \{ {\cf20 // JFIF APP0 segment}\par
3169          {\cf17 static} {\cf17 const} {\cf18 unsigned} {\cf18 char} tag[5] = \{{\cf23 'J'},{\cf23 'F'},{\cf23 'I'},{\cf23 'F'},{\cf23 '\\0'}\};\par
3170          {\cf18 int} ok = 1;\par
3171          {\cf18 int} i;\par
3172          {\cf19 for} (i=0; i < 5; ++i)\par
3173             {\cf19 if} (stbi__get8(z->s) != tag[i])\par
3174                ok = 0;\par
3175          L -= 5;\par
3176          {\cf19 if} (ok)\par
3177             z->jfif = 1;\par
3178       \} {\cf19 else} {\cf19 if} (m == 0xEE && L >= 12) \{ {\cf20 // Adobe APP14 segment}\par
3179          {\cf17 static} {\cf17 const} {\cf18 unsigned} {\cf18 char} tag[6] = \{{\cf23 'A'},{\cf23 'd'},{\cf23 'o'},{\cf23 'b'},{\cf23 'e'},{\cf23 '\\0'}\};\par
3180          {\cf18 int} ok = 1;\par
3181          {\cf18 int} i;\par
3182          {\cf19 for} (i=0; i < 6; ++i)\par
3183             {\cf19 if} (stbi__get8(z->s) != tag[i])\par
3184                ok = 0;\par
3185          L -= 6;\par
3186          {\cf19 if} (ok) \{\par
3187             stbi__get8(z->s); {\cf20 // version}\par
3188             stbi__get16be(z->s); {\cf20 // flags0}\par
3189             stbi__get16be(z->s); {\cf20 // flags1}\par
3190             z->app14_color_transform = stbi__get8(z->s); {\cf20 // color transform}\par
3191             L -= 6;\par
3192          \}\par
3193       \}\par
3194 \par
3195       stbi__skip(z->s, L);\par
3196       {\cf19 return} 1;\par
3197    \}\par
3198 \par
3199    {\cf19 return} stbi__err({\cf22 "unknown marker"},{\cf22 "Corrupt JPEG"});\par
3200 \}\par
