5263 {\cf17 static} {\cf18 void} *stbi__do_png(stbi__png *p, {\cf18 int} *x, {\cf18 int} *y, {\cf18 int} *n, {\cf18 int} req_comp, stbi__result_info *ri)\par
5264 \{\par
5265    {\cf18 void} *result=NULL;\par
5266    {\cf19 if} (req_comp < 0 || req_comp > 4) {\cf19 return} stbi__errpuc({\cf22 "bad req_comp"}, {\cf22 "Internal error"});\par
5267    {\cf19 if} (stbi__parse_png_file(p, STBI__SCAN_load, req_comp)) \{\par
5268       {\cf19 if} (p->depth <= 8)\par
5269          ri->bits_per_channel = 8;\par
5270       {\cf19 else} {\cf19 if} (p->depth == 16)\par
5271          ri->bits_per_channel = 16;\par
5272       {\cf19 else}\par
5273          {\cf19 return} stbi__errpuc({\cf22 "bad bits_per_channel"}, {\cf22 "PNG not supported: unsupported color depth"});\par
5274       result = p->out;\par
5275       p->out = NULL;\par
5276       {\cf19 if} (req_comp && req_comp != p->s->img_out_n) \{\par
5277          {\cf19 if} (ri->bits_per_channel == 8)\par
5278             result = stbi__convert_format(({\cf18 unsigned} {\cf18 char} *) result, p->s->img_out_n, req_comp, p->s->img_x, p->s->img_y);\par
5279          {\cf19 else}\par
5280             result = stbi__convert_format16((stbi__uint16 *) result, p->s->img_out_n, req_comp, p->s->img_x, p->s->img_y);\par
5281          p->s->img_out_n = req_comp;\par
5282          {\cf19 if} (result == NULL) {\cf19 return} result;\par
5283       \}\par
5284       *x = p->s->img_x;\par
5285       *y = p->s->img_y;\par
5286       {\cf19 if} (n) *n = p->s->img_n;\par
5287    \}\par
5288    STBI_FREE(p->out);      p->out      = NULL;\par
5289    STBI_FREE(p->expanded); p->expanded = NULL;\par
5290    STBI_FREE(p->idata);    p->idata    = NULL;\par
5291 \par
5292    {\cf19 return} result;\par
5293 \}\par
