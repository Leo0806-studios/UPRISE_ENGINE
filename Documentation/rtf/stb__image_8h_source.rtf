1260 {\cf17 static} {\cf18 unsigned} {\cf18 char} *stbi__load_and_postprocess_8bit(stbi__context *s, {\cf18 int} *x, {\cf18 int} *y, {\cf18 int} *comp, {\cf18 int} req_comp)\par
