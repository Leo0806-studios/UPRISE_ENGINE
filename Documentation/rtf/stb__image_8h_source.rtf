4762             cur[k] = STBI__BYTECAST(raw[k] + cur[k-filter_bytes]);\par
4763          {\cf19 break};\par
4764       {\cf19 case} STBI__F_up:\par
4765          {\cf19 for} (k = 0; k < nk; ++k)\par
4766             cur[k] = STBI__BYTECAST(raw[k] + prior[k]);\par
4767          {\cf19 break};\par
4768       {\cf19 case} STBI__F_avg:\par
4769          {\cf19 for} (k = 0; k < filter_bytes; ++k)\par
4770             cur[k] = STBI__BYTECAST(raw[k] + (prior[k]>>1));\par
4771          {\cf19 for} (k = filter_bytes; k < nk; ++k)\par
4772             cur[k] = STBI__BYTECAST(raw[k] + ((prior[k] + cur[k-filter_bytes])>>1));\par
4773          {\cf19 break};\par
4774       {\cf19 case} STBI__F_paeth:\par
4775          {\cf19 for} (k = 0; k < filter_bytes; ++k)\par
4776             cur[k] = STBI__BYTECAST(raw[k] + prior[k]); {\cf20 // prior[k] == stbi__paeth(0,prior[k],0)}\par
