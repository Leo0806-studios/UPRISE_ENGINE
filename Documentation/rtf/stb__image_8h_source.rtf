3120             {\cf19 for} (i=0; i < 64; ++i)\par
3121                z->dequant[t][stbi__jpeg_dezigzag[i]] = (stbi__uint16)(sixteen ? stbi__get16be(z->s) : stbi__get8(z->s));\par
3122             L -= (sixteen ? 129 : 65);\par
