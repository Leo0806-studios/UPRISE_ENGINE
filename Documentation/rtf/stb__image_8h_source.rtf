4753 \par
4754       {\cf20 // perform actual filtering}\par
4755       {\cf19 switch} (filter) \{\par
4756       {\cf19 case} STBI__F_none:\par
4757          memcpy(cur, raw, nk);\par
4758          {\cf19 break};\par
4759       {\cf19 case} STBI__F_sub:\par
4760          memcpy(cur, raw, filter_bytes);\par
