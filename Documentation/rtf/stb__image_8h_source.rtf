3449 {\cf20 // static jfif-centered resampling (across block boundaries)}\par
3450 \par
3451 {\cf17 typedef} stbi_uc *(*resample_row_func)(stbi_uc *out, stbi_uc *in0, stbi_uc *in1,\par
3452                                     {\cf18 int} w, {\cf18 int} hs);\par
3453 \par
3454 {\cf21 #define stbi__div4(x) ((stbi_uc) ((x) >> 2))}\par
3455 \par
3456 {\cf17 static} stbi_uc *resample_row_1(stbi_uc *out, stbi_uc *in_near, stbi_uc *in_far, {\cf18 int} w, {\cf18 int} hs)\par
3457 \{\par
3458    STBI_NOTUSED(out);\par
3459    STBI_NOTUSED(in_far);\par
3460    STBI_NOTUSED(w);\par
3461    STBI_NOTUSED(hs);\par
