1190 {\cf17 static} stbi_uc *stbi__convert_16_to_8(stbi__uint16 *orig, {\cf18 int} w, {\cf18 int} h, {\cf18 int} channels)\par
1191 \{\par
1192    {\cf18 int} i;\par
1193    {\cf18 int} img_len = w * h * channels;\par
1194    stbi_uc *reduced;\par
1195 \par
1196    reduced = (stbi_uc *) stbi__malloc(img_len);\par
1197    {\cf19 if} (reduced == NULL) {\cf19 return} stbi__errpuc({\cf22 "outofmem"}, {\cf22 "Out of memory"});\par
1198 \par
1199    {\cf19 for} (i = 0; i < img_len; ++i)\par
1200       reduced[i] = (stbi_uc)((orig[i] >> 8) & 0xFF); {\cf20 // top half of each byte is sufficient approx of 16->8 bit scaling}\par
1201 \par
1202    STBI_FREE(orig);\par
1203    {\cf19 return} reduced;\par
1204 \}\par
1205 \par
1206 {\cf17 static} stbi__uint16 *stbi__convert_8_to_16(stbi_uc *orig, {\cf18 int} w, {\cf18 int} h, {\cf18 int} channels)\par
1207 \{\par
1208    {\cf18 int} i;\par
1209    {\cf18 int} img_len = w * h * channels;\par
1210    stbi__uint16 *enlarged;\par
1211 \par
1212    enlarged = (stbi__uint16 *) stbi__malloc(img_len*2);\par
1213    {\cf19 if} (enlarged == NULL) {\cf19 return} (stbi__uint16 *) stbi__errpuc({\cf22 "outofmem"}, {\cf22 "Out of memory"});\par
1214 \par
1215    {\cf19 for} (i = 0; i < img_len; ++i)\par
1216       enlarged[i] = (stbi__uint16)((orig[i] << 8) + orig[i]); {\cf20 // replicate to high and low byte, maps 0->0, 255->0xffff}\par
1217 \par
1218    STBI_FREE(orig);\par
1219    {\cf19 return} enlarged;\par
1220 \}\par
