2137    c = ((j->code_buffer >> (32 - k)) & stbi__bmask[k]) + h->delta[k];\par
2138    {\cf19 if}(c < 0 || c >= 256) {\cf20 // symbol id out of bounds!}\par
2139        {\cf19 return} -1;\par
2140    STBI_ASSERT((((j->code_buffer) >> (32 - h->size[c])) & stbi__bmask[h->size[c]]) == h->code[c]);\par
2141 \par
2142    {\cf20 // convert the id to a symbol}\par
2143    j->code_bits -= k;\par
2144    j->code_buffer <<= k;\par
2145    {\cf19 return} h->values[c];\par
