3365 {\cf17 static} {\cf18 int} stbi__decode_jpeg_header(stbi__jpeg *z, {\cf18 int} scan)\par
3366 \{\par
3367    {\cf18 int} m;\par
3368    z->jfif = 0;\par
3369    z->app14_color_transform = -1; {\cf20 // valid values are 0,1,2}\par
3370    z->marker = STBI__MARKER_none; {\cf20 // initialize cached marker to empty}\par
3371    m = stbi__get_marker(z);\par
3372    {\cf19 if} (!stbi__SOI(m)) {\cf19 return} stbi__err({\cf22 "no SOI"},{\cf22 "Corrupt JPEG"});\par
3373    {\cf19 if} (scan == STBI__SCAN_type) {\cf19 return} 1;\par
3374    m = stbi__get_marker(z);\par
3375    {\cf19 while} (!stbi__SOF(m)) \{\par
3376       {\cf19 if} (!stbi__process_marker(z,m)) {\cf19 return} 0;\par
3377       m = stbi__get_marker(z);\par
3378       {\cf19 while} (m == STBI__MARKER_none) \{\par
3379          {\cf20 // some files have extra padding after their blocks, so ok, we'll scan}\par
3380          {\cf19 if} (stbi__at_eof(z->s)) {\cf19 return} stbi__err({\cf22 "no SOF"}, {\cf22 "Corrupt JPEG"});\par
3381          m = stbi__get_marker(z);\par
3382       \}\par
3383    \}\par
3384    z->progressive = stbi__SOF_progressive(m);\par
3385    {\cf19 if} (!stbi__process_frame_header(z, scan)) {\cf19 return} 0;\par
3386    {\cf19 return} 1;\par
3387 \}\par
