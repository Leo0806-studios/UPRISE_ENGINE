4438 {\cf17 static} {\cf18 int} stbi__parse_zlib_header(stbi__zbuf *a)\par
4439 \{\par
4440    {\cf18 int} cmf   = stbi__zget8(a);\par
4441    {\cf18 int} cm    = cmf & 15;\par
4442    {\cf20 /* int cinfo = cmf >> 4; */}\par
4443    {\cf18 int} flg   = stbi__zget8(a);\par
4444    {\cf19 if} (stbi__zeof(a)) {\cf19 return} stbi__err({\cf22 "bad zlib header"},{\cf22 "Corrupt PNG"}); {\cf20 // zlib spec}\par
4445    {\cf19 if} ((cmf*256+flg) % 31 != 0) {\cf19 return} stbi__err({\cf22 "bad zlib header"},{\cf22 "Corrupt PNG"}); {\cf20 // zlib spec}\par
4446    {\cf19 if} (flg & 32) {\cf19 return} stbi__err({\cf22 "no preset dict"},{\cf22 "Corrupt PNG"}); {\cf20 // preset dictionary not allowed in png}\par
4447    {\cf19 if} (cm != 8) {\cf19 return} stbi__err({\cf22 "bad compression"},{\cf22 "Corrupt PNG"}); {\cf20 // DEFLATE required for png}\par
4448    {\cf20 // window = 1 << (8 + cinfo)... but who cares, we fully buffer output}\par
4449    {\cf19 return} 1;\par
4450 \}\par
