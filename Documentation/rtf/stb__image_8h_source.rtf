990 {\cf20 // stb_image uses ints pervasively, including for offset calculations.}\par
991 {\cf20 // therefore the largest decoded image size we can support with the}\par
992 {\cf20 // current code, even on 64-bit targets, is INT_MAX. this is not a}\par
993 {\cf20 // significant limitation for the intended use case.}\par
994 {\cf20 //}\par
995 {\cf20 // we do, however, need to make sure our size calculations don't}\par
996 {\cf20 // overflow. hence a few helper functions for size calculations that}\par
997 {\cf20 // multiply integers together, making sure that they're non-negative}\par
998 {\cf20 // and no overflow occurs.}\par
999 \par
1000 {\cf20 // return 1 if the sum is valid, 0 on overflow.}\par
1001 {\cf20 // negative terms are considered invalid.}\par
1002 {\cf17 static} {\cf18 int} stbi__addsizes_valid({\cf18 int} a, {\cf18 int} b)\par
1003 \{\par
1004    {\cf19 if} (b < 0) {\cf19 return} 0;\par
1005    {\cf20 // now 0 <= b <= INT_MAX, hence also}\par
1006    {\cf20 // 0 <= INT_MAX - b <= INTMAX.}\par
1007    {\cf20 // And "a + b <= INT_MAX" (which might overflow) is the}\par
1008    {\cf20 // same as a <= INT_MAX - b (no overflow)}\par
1009    {\cf19 return} a <= INT_MAX - b;\par
1010 \}\par
1011 \par
1012 {\cf20 // returns 1 if the product is valid, 0 on overflow.}\par
1013 {\cf20 // negative factors are considered invalid.}\par
1014 {\cf17 static} {\cf18 int} stbi__mul2sizes_valid({\cf18 int} a, {\cf18 int} b)\par
1015 \{\par
1016    {\cf19 if} (a < 0 || b < 0) {\cf19 return} 0;\par
1017    {\cf19 if} (b == 0) {\cf19 return} 1; {\cf20 // mul-by-0 is always safe}\par
1018    {\cf20 // portable way to check for no overflows in a*b}\par
1019    {\cf19 return} a <= INT_MAX/b;\par
1020 \}\par
1021 \par
1022 {\cf21 #if !defined(STBI_NO_JPEG) || !defined(STBI_NO_PNG) || !defined(STBI_NO_TGA) || !defined(STBI_NO_HDR)}\par
1023 {\cf20 // returns 1 if "a*b + add" has no negative terms/factors and doesn't overflow}\par
1024 {\cf17 static} {\cf18 int} stbi__mad2sizes_valid({\cf18 int} a, {\cf18 int} b, {\cf18 int} add)\par
1025 \{\par
1026    {\cf19 return} stbi__mul2sizes_valid(a, b) && stbi__addsizes_valid(a*b, add);\par
1027 \}\par
1028 {\cf21 #endif}\par
1029 \par
1030 {\cf20 // returns 1 if "a*b*c + add" has no negative terms/factors and doesn't overflow}\par
1031 {\cf17 static} {\cf18 int} stbi__mad3sizes_valid({\cf18 int} a, {\cf18 int} b, {\cf18 int} c, {\cf18 int} add)\par
1032 \{\par
1033    {\cf19 return} stbi__mul2sizes_valid(a, b) && stbi__mul2sizes_valid(a*b, c) &&\par
1034       stbi__addsizes_valid(a*b*c, add);\par
1035 \}\par
1036 \par
1037 {\cf20 // returns 1 if "a*b*c*d + add" has no negative terms/factors and doesn't overflow}\par
1038 {\cf21 #if !defined(STBI_NO_LINEAR) || !defined(STBI_NO_HDR) || !defined(STBI_NO_PNM)}\par
1039 {\cf17 static} {\cf18 int} stbi__mad4sizes_valid({\cf18 int} a, {\cf18 int} b, {\cf18 int} c, {\cf18 int} d, {\cf18 int} add)\par
1040 \{\par
1041    {\cf19 return} stbi__mul2sizes_valid(a, b) && stbi__mul2sizes_valid(a*b, c) &&\par
1042       stbi__mul2sizes_valid(a*b*c, d) && stbi__addsizes_valid(a*b*c*d, add);\par
1043 \}\par
1044 {\cf21 #endif}\par
1045 \par
1046 {\cf21 #if !defined(STBI_NO_JPEG) || !defined(STBI_NO_PNG) || !defined(STBI_NO_TGA) || !defined(STBI_NO_HDR)}\par
1047 {\cf20 // mallocs with size overflow checking}\par
1048 {\cf17 static} {\cf18 void} *stbi__malloc_mad2({\cf18 int} a, {\cf18 int} b, {\cf18 int} add)\par
1049 \{\par
1050    {\cf19 if} (!stbi__mad2sizes_valid(a, b, add)) {\cf19 return} NULL;\par
1051    {\cf19 return} stbi__malloc(a*b + add);\par
1052 \}\par
1053 {\cf21 #endif}\par
1054 \par
1055 {\cf17 static} {\cf18 void} *stbi__malloc_mad3({\cf18 int} a, {\cf18 int} b, {\cf18 int} c, {\cf18 int} add)\par
1056 \{\par
1057    {\cf19 if} (!stbi__mad3sizes_valid(a, b, c, add)) {\cf19 return} NULL;\par
1058    {\cf19 return} stbi__malloc(a*b*c + add);\par
1059 \}\par
1060 \par
1061 {\cf21 #if !defined(STBI_NO_LINEAR) || !defined(STBI_NO_HDR) || !defined(STBI_NO_PNM)}\par
1062 {\cf17 static} {\cf18 void} *stbi__malloc_mad4({\cf18 int} a, {\cf18 int} b, {\cf18 int} c, {\cf18 int} d, {\cf18 int} add)\par
1063 \{\par
1064    {\cf19 if} (!stbi__mad4sizes_valid(a, b, c, d, add)) {\cf19 return} NULL;\par
1065    {\cf19 return} stbi__malloc(a*b*c*d + add);\par
1066 \}\par
1067 {\cf21 #endif}\par
1068 \par
1069 {\cf20 // returns 1 if the sum of two signed ints is valid (between -2^31 and 2^31-1 inclusive), 0 on overflow.}\par
1070 {\cf17 static} {\cf18 int} stbi__addints_valid({\cf18 int} a, {\cf18 int} b)\par
1071 \{\par
1072    {\cf19 if} ((a >= 0) != (b >= 0)) {\cf19 return} 1; {\cf20 // a and b have different signs, so no overflow}\par
1073    {\cf19 if} (a < 0 && b < 0) {\cf19 return} a >= INT_MIN - b; {\cf20 // same as a + b >= INT_MIN; INT_MIN - b cannot overflow since b < 0.}\par
1074    {\cf19 return} a <= INT_MAX - b;\par
1075 \}\par
1076 \par
1077 {\cf20 // returns 1 if the product of two ints fits in a signed short, 0 on overflow.}\par
1078 {\cf17 static} {\cf18 int} stbi__mul2shorts_valid({\cf18 int} a, {\cf18 int} b)\par
1079 \{\par
1080    {\cf19 if} (b == 0 || b == -1) {\cf19 return} 1; {\cf20 // multiplication by 0 is always 0; check for -1 so SHRT_MIN/b doesn't overflow}\par
1081    {\cf19 if} ((a >= 0) == (b >= 0)) {\cf19 return} a <= SHRT_MAX/b; {\cf20 // product is positive, so similar to mul2sizes_valid}\par
1082    {\cf19 if} (b < 0) {\cf19 return} a <= SHRT_MIN / b; {\cf20 // same as a * b >= SHRT_MIN}\par
1083    {\cf19 return} a >= SHRT_MIN / b;\par
1084 \}\par
1085 \par
