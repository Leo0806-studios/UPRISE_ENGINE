4228    {\cf20 // use jpeg approach, which requires MSbits at top}\par
4229    k = stbi__bit_reverse(a->code_buffer, 16);\par
4230    {\cf19 for} (s=STBI__ZFAST_BITS+1; ; ++s)\par
4231       {\cf19 if} (k < z->maxcode[s])\par
4232          {\cf19 break};\par
4233    {\cf19 if} (s >= 16) {\cf19 return} -1; {\cf20 // invalid code!}\par
4234    {\cf20 // code size is s, so:}\par
4235    b = (k >> (16-s)) - z->firstcode[s] + z->firstsymbol[s];\par
4236    {\cf19 if} (b >= STBI__ZNSYMS) {\cf19 return} -1; {\cf20 // some data was corrupt somewhere!}\par
4237    {\cf19 if} (z->size[b] != s) {\cf19 return} -1;  {\cf20 // was originally an assert, but report failure instead.}\par
