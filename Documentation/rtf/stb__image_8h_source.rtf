5136             {\cf19 if} (pal_len * 3 != c.length) {\cf19 return} stbi__err({\cf22 "invalid PLTE"},{\cf22 "Corrupt PNG"});\par
5137             {\cf19 for} (i=0; i < pal_len; ++i) \{\par
5138                palette[i*4+0] = stbi__get8(s);\par
5139                palette[i*4+1] = stbi__get8(s);\par
5140                palette[i*4+2] = stbi__get8(s);\par
