5171          \}\par
5172 \par
5173          {\cf19 case} STBI__PNG_TYPE({\cf23 'I'},{\cf23 'D'},{\cf23 'A'},{\cf23 'T'}): \{\par
5174             {\cf19 if} (first) {\cf19 return} stbi__err({\cf22 "first not IHDR"}, {\cf22 "Corrupt PNG"});\par
5175             {\cf19 if} (pal_img_n && !pal_len) {\cf19 return} stbi__err({\cf22 "no PLTE"},{\cf22 "Corrupt PNG"});\par
5176             {\cf19 if} (scan == STBI__SCAN_header) \{\par
5177                {\cf20 // header scan definitely stops at first IDAT}\par
5178                {\cf19 if} (pal_img_n)\par
5179                   s->img_n = pal_img_n;\par
5180                {\cf19 return} 1;\par
5181             \}\par
5182             {\cf19 if} (c.length > (1u << 30)) {\cf19 return} stbi__err({\cf22 "IDAT size limit"}, {\cf22 "IDAT section larger than 2^30 bytes"});\par
5183             {\cf19 if} (({\cf18 int})(ioff + c.length) < ({\cf18 int})ioff) {\cf19 return} 0;\par
5184             {\cf19 if} (ioff + c.length > idata_limit) \{\par
5185                stbi__uint32 idata_limit_old = idata_limit;\par
5186                stbi_uc *p;\par
5187                {\cf19 if} (idata_limit == 0) idata_limit = c.length > 4096 ? c.length : 4096;\par
5188                {\cf19 while} (ioff + c.length > idata_limit)\par
5189                   idata_limit *= 2;\par
5190                STBI_NOTUSED(idata_limit_old);\par
5191                p = (stbi_uc *) STBI_REALLOC_SIZED(z->idata, idata_limit_old, idata_limit); {\cf19 if} (p == NULL) {\cf19 return} stbi__err({\cf22 "outofmem"}, {\cf22 "Out of memory"});\par
