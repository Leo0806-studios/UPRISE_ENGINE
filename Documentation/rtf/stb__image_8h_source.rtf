3389 {\cf17 static} stbi_uc stbi__skip_jpeg_junk_at_end(stbi__jpeg *j)\par
3390 \{\par
3391    {\cf20 // some JPEGs have junk at end, skip over it but if we find what looks}\par
3392    {\cf20 // like a valid marker, resume there}\par
3393    {\cf19 while} (!stbi__at_eof(j->s)) \{\par
3394       stbi_uc x = stbi__get8(j->s);\par
3395       {\cf19 while} (x == 0xff) \{ {\cf20 // might be a marker}\par
3396          {\cf19 if} (stbi__at_eof(j->s)) {\cf19 return} STBI__MARKER_none;\par
3397          x = stbi__get8(j->s);\par
3398          {\cf19 if} (x != 0x00 && x != 0xff) \{\par
3399             {\cf20 // not a stuffed zero or lead-in to another marker, looks}\par
3400             {\cf20 // like an actual marker, return it}\par
3401             {\cf19 return} x;\par
3402          \}\par
3403          {\cf20 // stuffed zero has x=0 now which ends the loop, meaning we go}\par
3404          {\cf20 // back to regular scan loop.}\par
3405          {\cf20 // repeated 0xff keeps trying to read the next byte of the marker.}\par
3406       \}\par
3407    \}\par
3408    {\cf19 return} STBI__MARKER_none;\par
3409 \}\par
