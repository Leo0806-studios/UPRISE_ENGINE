2003 {\cf17 static} {\cf18 int} stbi__build_huffman(stbi__huffman *h, {\cf18 int} *count)\par
2004 \{\par
2005    {\cf18 int} i,j,k=0;\par
2006    {\cf18 unsigned} {\cf18 int} code;\par
2007    {\cf20 // build size list for each symbol (from JPEG spec)}\par
2008    {\cf19 for} (i=0; i < 16; ++i) \{\par
2009       {\cf19 for} (j=0; j < count[i]; ++j) \{\par
2010          h->size[k++] = (stbi_uc) (i+1);\par
2011          {\cf19 if}(k >= 257) {\cf19 return} stbi__err({\cf22 "bad size list"},{\cf22 "Corrupt JPEG"});\par
2012       \}\par
2013    \}\par
2014    h->size[k] = 0;\par
2015 \par
2016    {\cf20 // compute actual symbols (from jpeg spec)}\par
2017    code = 0;\par
2018    k = 0;\par
2019    {\cf19 for}(j=1; j <= 16; ++j) \{\par
2020       {\cf20 // compute delta to add to code to compute symbol id}\par
2021       h->delta[j] = k - code;\par
2022       {\cf19 if} (h->size[k] == j) \{\par
2023          {\cf19 while} (h->size[k] == j)\par
2024             h->code[k++] = (stbi__uint16) (code++);\par
2025          {\cf19 if} (code-1 >= (1u << j)) {\cf19 return} stbi__err({\cf22 "bad code lengths"},{\cf22 "Corrupt JPEG"});\par
2026       \}\par
2027       {\cf20 // compute largest code + 1 for this size, preshifted as needed later}\par
2028       h->maxcode[j] = code << (16-j);\par
2029       code <<= 1;\par
2030    \}\par
2031    h->maxcode[j] = 0xffffffff;\par
2032 \par
2033    {\cf20 // build non-spec acceleration table; 255 is flag for not-accelerated}\par
2034    memset(h->fast, 255, 1 << FAST_BITS);\par
2035    {\cf19 for} (i=0; i < k; ++i) \{\par
2036       {\cf18 int} s = h->size[i];\par
2037       {\cf19 if} (s <= FAST_BITS) \{\par
2038          {\cf18 int} c = h->code[i] << (FAST_BITS-s);\par
2039          {\cf18 int} m = 1 << (FAST_BITS-s);\par
2040          {\cf19 for} (j=0; j < m; ++j) \{\par
2041             h->fast[c+j] = (stbi_uc) i;\par
2042          \}\par
2043       \}\par
2044    \}\par
2045    {\cf19 return} 1;\par
2046 \}\par
