4699    stbi__context *s = a->s;\par
4700    stbi__uint32 i,j,stride = x*out_n*bytes;\par
4701    stbi__uint32 img_len, img_width_bytes;\par
4702    stbi_uc *filter_buf;\par
4703    {\cf18 int} all_ok = 1;\par
4704    {\cf18 int} k;\par
4705    {\cf18 int} img_n = s->img_n; {\cf20 // copy it into a local for later}\par
4706 \par
4707    {\cf18 int} output_bytes = out_n*bytes;\par
4708    {\cf18 int} filter_bytes = img_n*bytes;\par
4709    {\cf18 int} width = x;\par
4710 \par
4711    STBI_ASSERT(out_n == s->img_n || out_n == s->img_n+1);\par
4712    a->out = (stbi_uc *) stbi__malloc_mad3(x, y, output_bytes, 0); {\cf20 // extra bytes to write off the end into}\par
4713    {\cf19 if} (!a->out) {\cf19 return} stbi__err({\cf22 "outofmem"}, {\cf22 "Out of memory"});\par
4714 \par
4715    {\cf20 // note: error exits here don't need to clean up a->out individually,}\par
4716    {\cf20 // stbi__do_png always does on error.}\par
4717    {\cf19 if} (!stbi__mad3sizes_valid(img_n, x, depth, 7)) {\cf19 return} stbi__err({\cf22 "too large"}, {\cf22 "Corrupt PNG"});\par
4718    img_width_bytes = (((img_n * x * depth) + 7) >> 3);\par
4719    {\cf19 if} (!stbi__mad2sizes_valid(img_width_bytes, y, img_width_bytes)) {\cf19 return} stbi__err({\cf22 "too large"}, {\cf22 "Corrupt PNG"});\par
4720    img_len = (img_width_bytes + 1) * y;\par
4721 \par
4722    {\cf20 // we used to check for exact match between raw_len and img_len on non-interlaced PNGs,}\par
4723    {\cf20 // but issue #276 reported a PNG in the wild that had extra data at the end (all zeros),}\par
4724    {\cf20 // so just check for raw_len < img_len always.}\par
4725    {\cf19 if} (raw_len < img_len) {\cf19 return} stbi__err({\cf22 "not enough pixels"},{\cf22 "Corrupt PNG"});\par
4726 \par
4727    {\cf20 // Allocate two scan lines worth of filter workspace buffer.}\par
4728    filter_buf = (stbi_uc *) stbi__malloc_mad2(img_width_bytes, 2, 0);\par
4729    {\cf19 if} (!filter_buf) {\cf19 return} stbi__err({\cf22 "outofmem"}, {\cf22 "Out of memory"});\par
4730 \par
4731    {\cf20 // Filtering for low-bit-depth images}\par
4732    {\cf19 if} (depth < 8) \{\par
4733       filter_bytes = 1;\par
4734       width = img_width_bytes;\par
4735    \}\par
4736 \par
4737    {\cf19 for} (j=0; j < y; ++j) \{\par
4738       {\cf20 // cur/prior filter buffers alternate}\par
4739       stbi_uc *cur = filter_buf + (j & 1)*img_width_bytes;\par
4740       stbi_uc *prior = filter_buf + (~j & 1)*img_width_bytes;\par
4741       stbi_uc *dest = a->out + stride*j;\par
