4409 {\cf17 static} {\cf18 int} stbi__parse_uncompressed_block(stbi__zbuf *a)\par
4410 \{\par
4411    stbi_uc header[4];\par
4412    {\cf18 int} len,nlen,k;\par
4413    {\cf19 if} (a->num_bits & 7)\par
4414       stbi__zreceive(a, a->num_bits & 7); {\cf20 // discard}\par
4415    {\cf20 // drain the bit-packed data into header}\par
4416    k = 0;\par
4417    {\cf19 while} (a->num_bits > 0) \{\par
4418       header[k++] = (stbi_uc) (a->code_buffer & 255); {\cf20 // suppress MSVC run-time check}\par
4419       a->code_buffer >>= 8;\par
4420       a->num_bits -= 8;\par
4421    \}\par
4422    {\cf19 if} (a->num_bits < 0) {\cf19 return} stbi__err({\cf22 "zlib corrupt"},{\cf22 "Corrupt PNG"});\par
4423    {\cf20 // now fill header the normal way}\par
4424    {\cf19 while} (k < 4)\par
4425       header[k++] = stbi__zget8(a);\par
4426    len  = header[1] * 256 + header[0];\par
4427    nlen = header[3] * 256 + header[2];\par
4428    {\cf19 if} (nlen != (len ^ 0xffff)) {\cf19 return} stbi__err({\cf22 "zlib corrupt"},{\cf22 "Corrupt PNG"});\par
4429    {\cf19 if} (a->zbuffer + len > a->zbuffer_end) {\cf19 return} stbi__err({\cf22 "read past buffer"},{\cf22 "Corrupt PNG"});\par
4430    {\cf19 if} (a->zout + len > a->zout_end)\par
4431       {\cf19 if} (!stbi__zexpand(a, a->zout, len)) {\cf19 return} 0;\par
4432    memcpy(a->zout, a->zbuffer, len);\par
4433    a->zbuffer += len;\par
4434    a->zout += len;\par
4435    {\cf19 return} 1;\par
4436 \}\par
