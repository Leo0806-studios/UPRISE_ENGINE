3099 {\cf17 static} {\cf18 int} stbi__process_marker(stbi__jpeg *z, {\cf18 int} m)\par
3100 \{\par
3101    {\cf18 int} L;\par
3102    {\cf19 switch} (m) \{\par
3103       {\cf19 case} STBI__MARKER_none: {\cf20 // no marker found}\par
3104          {\cf19 return} stbi__err({\cf22 "expected marker"},{\cf22 "Corrupt JPEG"});\par
3105 \par
3106       {\cf19 case} 0xDD: {\cf20 // DRI - specify restart interval}\par
3107          {\cf19 if} (stbi__get16be(z->s) != 4) {\cf19 return} stbi__err({\cf22 "bad DRI len"},{\cf22 "Corrupt JPEG"});\par
3108          z->restart_interval = stbi__get16be(z->s);\par
