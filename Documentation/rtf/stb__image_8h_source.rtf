4309 {\cf17 static} {\cf18 int} stbi__parse_huffman_block(stbi__zbuf *a)\par
4310 \{\par
4311    {\cf18 char} *zout = a->zout;\par
4312    {\cf19 for}(;;) \{\par
4313       {\cf18 int} z = stbi__zhuffman_decode(a, &a->z_length);\par
4314       {\cf19 if} (z < 256) \{\par
4315          {\cf19 if} (z < 0) {\cf19 return} stbi__err({\cf22 "bad huffman code"},{\cf22 "Corrupt PNG"}); {\cf20 // error in huffman codes}\par
4316          {\cf19 if} (zout >= a->zout_end) \{\par
4317             {\cf19 if} (!stbi__zexpand(a, zout, 1)) {\cf19 return} 0;\par
4318             zout = a->zout;\par
4319          \}\par
4320          *zout++ = (char) z;\par
4321       \} {\cf19 else} \{\par
4322          stbi_uc *p;\par
4323          {\cf18 int} len,dist;\par
4324          {\cf19 if} (z == 256) \{\par
4325             a->zout = zout;\par
4326             {\cf19 if} (a->hit_zeof_once && a->num_bits < 16) \{\par
4327                {\cf20 // The first time we hit zeof, we inserted 16 extra zero bits into our bit}\par
4328                {\cf20 // buffer so the decoder can just do its speculative decoding. But if we}\par
4329                {\cf20 // actually consumed any of those bits (which is the case when num_bits < 16),}\par
4330                {\cf20 // the stream actually read past the end so it is malformed.}\par
4331                {\cf19 return} stbi__err({\cf22 "unexpected end"},{\cf22 "Corrupt PNG"});\par
4332             \}\par
4333             {\cf19 return} 1;\par
4334          \}\par
4335          {\cf19 if} (z >= 286) {\cf19 return} stbi__err({\cf22 "bad huffman code"},{\cf22 "Corrupt PNG"}); {\cf20 // per DEFLATE, length codes 286 and 287 must not appear in compressed data}\par
4336          z -= 257;\par
4337          len = stbi__zlength_base[z];\par
4338          {\cf19 if} (stbi__zlength_extra[z]) len += stbi__zreceive(a, stbi__zlength_extra[z]);\par
4339          z = stbi__zhuffman_decode(a, &a->z_distance);\par
4340          {\cf19 if} (z < 0 || z >= 30) {\cf19 return} stbi__err({\cf22 "bad huffman code"},{\cf22 "Corrupt PNG"}); {\cf20 // per DEFLATE, distance codes 30 and 31 must not appear in compressed data}\par
4341          dist = stbi__zdist_base[z];\par
4342          {\cf19 if} (stbi__zdist_extra[z]) dist += stbi__zreceive(a, stbi__zdist_extra[z]);\par
4343          {\cf19 if} (zout - a->zout_start < dist) {\cf19 return} stbi__err({\cf22 "bad dist"},{\cf22 "Corrupt PNG"});\par
4344          {\cf19 if} (len > a->zout_end - zout) \{\par
4345             {\cf19 if} (!stbi__zexpand(a, zout, len)) {\cf19 return} 0;\par
4346             zout = a->zout;\par
4347          \}\par
4348          p = (stbi_uc *) (zout - dist);\par
4349          {\cf19 if} (dist == 1) \{ {\cf20 // run of one byte; common in images.}\par
4350             stbi_uc v = *p;\par
4351             {\cf19 if} (len) \{ {\cf19 do} *zout++ = v; {\cf19 while} (--len); \}\par
4352          \} {\cf19 else} \{\par
4353             {\cf19 if} (len) \{ {\cf19 do} *zout++ = *p++; {\cf19 while} (--len); \}\par
4354          \}\par
4355       \}\par
4356    \}\par
4357 \}\par
