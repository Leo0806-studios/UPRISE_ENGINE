5096       stbi__pngchunk c = stbi__get_chunk_header(s);\par
5097       {\cf19 switch} (c.type) \{\par
5098          {\cf19 case} STBI__PNG_TYPE({\cf23 'C'},{\cf23 'g'},{\cf23 'B'},{\cf23 'I'}):\par
5099             is_iphone = 1;\par
5100             stbi__skip(s, c.length);\par
5101             {\cf19 break};\par
5102          {\cf19 case} STBI__PNG_TYPE({\cf23 'I'},{\cf23 'H'},{\cf23 'D'},{\cf23 'R'}): \{\par
5103             {\cf18 int} comp,filter;\par
5104             {\cf19 if} (!first) {\cf19 return} stbi__err({\cf22 "multiple IHDR"},{\cf22 "Corrupt PNG"});\par
5105             first = 0;\par
5106             {\cf19 if} (c.length != 13) {\cf19 return} stbi__err({\cf22 "bad IHDR len"},{\cf22 "Corrupt PNG"});\par
5107             s->img_x = stbi__get32be(s);\par
5108             s->img_y = stbi__get32be(s);\par
5109             {\cf19 if} (s->img_y > STBI_MAX_DIMENSIONS) {\cf19 return} stbi__err({\cf22 "too large"},{\cf22 "Very large image (corrupt?)"});\par
5110             {\cf19 if} (s->img_x > STBI_MAX_DIMENSIONS) {\cf19 return} stbi__err({\cf22 "too large"},{\cf22 "Very large image (corrupt?)"});\par
5111             z->depth = stbi__get8(s);  {\cf19 if} (z->depth != 1 && z->depth != 2 && z->depth != 4 && z->depth != 8 && z->depth != 16)  {\cf19 return} stbi__err({\cf22 "1/2/4/8/16-bit only"},{\cf22 "PNG not supported: 1/2/4/8/16-bit only"});\par
5112             color = stbi__get8(s);  {\cf19 if} (color > 6)         {\cf19 return} stbi__err({\cf22 "bad ctype"},{\cf22 "Corrupt PNG"});\par
5113             {\cf19 if} (color == 3 && z->depth == 16)                  {\cf19 return} stbi__err({\cf22 "bad ctype"},{\cf22 "Corrupt PNG"});\par
5114             {\cf19 if} (color == 3) pal_img_n = 3; {\cf19 else} {\cf19 if} (color & 1) {\cf19 return} stbi__err({\cf22 "bad ctype"},{\cf22 "Corrupt PNG"});\par
5115             comp  = stbi__get8(s);  {\cf19 if} (comp) {\cf19 return} stbi__err({\cf22 "bad comp method"},{\cf22 "Corrupt PNG"});\par
5116             filter= stbi__get8(s);  {\cf19 if} (filter) {\cf19 return} stbi__err({\cf22 "bad filter method"},{\cf22 "Corrupt PNG"});\par
5117             interlace = stbi__get8(s); {\cf19 if} (interlace>1) {\cf19 return} stbi__err({\cf22 "bad interlace method"},{\cf22 "Corrupt PNG"});\par
5118             {\cf19 if} (!s->img_x || !s->img_y) {\cf19 return} stbi__err({\cf22 "0-pixel image"},{\cf22 "Corrupt PNG"});\par
5119             {\cf19 if} (!pal_img_n) \{\par
5120                s->img_n = (color & 2 ? 3 : 1) + (color & 4 ? 1 : 0);\par
5121                {\cf19 if} ((1 << 30) / s->img_x / s->img_n < s->img_y) {\cf19 return} stbi__err({\cf22 "too large"}, {\cf22 "Image too large to decode"});\par
5122             \} {\cf19 else} \{\par
5123                {\cf20 // if paletted, then pal_n is our final components, and}\par
5124                {\cf20 // img_n is # components to decompress/filter.}\par
5125                s->img_n = 1;\par
5126                {\cf19 if} ((1 << 30) / s->img_x / 4 < s->img_y) {\cf19 return} stbi__err({\cf22 "too large"},{\cf22 "Corrupt PNG"});\par
5127             \}\par
5128             {\cf20 // even with SCAN_header, have to scan to see if we have a tRNS}\par
5129             {\cf19 break};\par
5130          \}\par
5131 \par
5132          {\cf19 case} STBI__PNG_TYPE({\cf23 'P'},{\cf23 'L'},{\cf23 'T'},{\cf23 'E'}):  \{\par
