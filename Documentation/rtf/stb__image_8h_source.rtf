1222 {\cf17 static} {\cf18 void} stbi__vertical_flip({\cf18 void} *image, {\cf18 int} w, {\cf18 int} h, {\cf18 int} bytes_per_pixel)\par
1223 \{\par
1224    {\cf18 int} row;\par
1225    {\cf18 size_t} bytes_per_row = (size_t)w * bytes_per_pixel;\par
1226    stbi_uc temp[2048];\par
1227    stbi_uc *bytes = (stbi_uc *)image;\par
1228 \par
1229    {\cf19 for} (row = 0; row < (h>>1); row++) \{\par
1230       stbi_uc *row0 = bytes + row*bytes_per_row;\par
1231       stbi_uc *row1 = bytes + (h - row - 1)*bytes_per_row;\par
1232       {\cf20 // swap row0 with row1}\par
1233       {\cf18 size_t} bytes_left = bytes_per_row;\par
1234       {\cf19 while} (bytes_left) \{\par
1235          {\cf18 size_t} bytes_copy = (bytes_left < {\cf17 sizeof}(temp)) ? bytes_left : {\cf17 sizeof}(temp);\par
1236          memcpy(temp, row0, bytes_copy);\par
1237          memcpy(row0, row1, bytes_copy);\par
1238          memcpy(row1, temp, bytes_copy);\par
1239          row0 += bytes_copy;\par
1240          row1 += bytes_copy;\par
1241          bytes_left -= bytes_copy;\par
1242       \}\par
1243    \}\par
1244 \}\par
1245 \par
1246 {\cf21 #ifndef STBI_NO_GIF}\par
1247 {\cf17 static} {\cf18 void} stbi__vertical_flip_slices({\cf18 void} *image, {\cf18 int} w, {\cf18 int} h, {\cf18 int} z, {\cf18 int} bytes_per_pixel)\par
1248 \{\par
1249    {\cf18 int} slice;\par
1250    {\cf18 int} slice_size = w * h * bytes_per_pixel;\par
1251 \par
1252    stbi_uc *bytes = (stbi_uc *)image;\par
1253    {\cf19 for} (slice = 0; slice < z; ++slice) \{\par
1254       stbi__vertical_flip(bytes, w, h, bytes_per_pixel);\par
1255       bytes += slice_size;\par
1256    \}\par
1257 \}\par
1258 {\cf21 #endif}\par
