3202 {\cf20 // after we see SOS}\par
3203 {\cf17 static} {\cf18 int} stbi__process_scan_header(stbi__jpeg *z)\par
3204 \{\par
3205    {\cf18 int} i;\par
3206    {\cf18 int} Ls = stbi__get16be(z->s);\par
3207    z->scan_n = stbi__get8(z->s);\par
3208    {\cf19 if} (z->scan_n < 1 || z->scan_n > 4 || z->scan_n > ({\cf18 int}) z->s->img_n) {\cf19 return} stbi__err({\cf22 "bad SOS component count"},{\cf22 "Corrupt JPEG"});\par
3209    {\cf19 if} (Ls != 6+2*z->scan_n) {\cf19 return} stbi__err({\cf22 "bad SOS len"},{\cf22 "Corrupt JPEG"});\par
3210    {\cf19 for} (i=0; i < z->scan_n; ++i) \{\par
3211       {\cf18 int} {\cf18 id} = stbi__get8(z->s), which;\par
3212       {\cf18 int} q = stbi__get8(z->s);\par
3213       {\cf19 for} (which = 0; which < z->s->img_n; ++which)\par
3214          {\cf19 if} (z->img_comp[which].id == {\cf18 id})\par
3215             {\cf19 break};\par
3216       {\cf19 if} (which == z->s->img_n) {\cf19 return} 0; {\cf20 // no match}\par
3217       z->img_comp[which].hd = q >> 4;   {\cf19 if} (z->img_comp[which].hd > 3) {\cf19 return} stbi__err({\cf22 "bad DC huff"},{\cf22 "Corrupt JPEG"});\par
3218       z->img_comp[which].ha = q & 15;   {\cf19 if} (z->img_comp[which].ha > 3) {\cf19 return} stbi__err({\cf22 "bad AC huff"},{\cf22 "Corrupt JPEG"});\par
3219       z->order[i] = which;\par
3220    \}\par
3221 \par
3222    \{\par
3223       {\cf18 int} aa;\par
3224       z->spec_start = stbi__get8(z->s);\par
3225       z->spec_end   = stbi__get8(z->s); {\cf20 // should be 63, but might be 0}\par
3226       aa = stbi__get8(z->s);\par
3227       z->succ_high = (aa >> 4);\par
3228       z->succ_low  = (aa & 15);\par
3229       {\cf19 if} (z->progressive) \{\par
3230          {\cf19 if} (z->spec_start > 63 || z->spec_end > 63  || z->spec_start > z->spec_end || z->succ_high > 13 || z->succ_low > 13)\par
3231             {\cf19 return} stbi__err({\cf22 "bad SOS"}, {\cf22 "Corrupt JPEG"});\par
3232       \} {\cf19 else} \{\par
3233          {\cf19 if} (z->spec_start != 0) {\cf19 return} stbi__err({\cf22 "bad SOS"},{\cf22 "Corrupt JPEG"});\par
3234          {\cf19 if} (z->succ_high != 0 || z->succ_low != 0) {\cf19 return} stbi__err({\cf22 "bad SOS"},{\cf22 "Corrupt JPEG"});\par
3235          z->spec_end = 63;\par
3236       \}\par
3237    \}\par
3238 \par
3239    {\cf19 return} 1;\par
3240 \}\par
