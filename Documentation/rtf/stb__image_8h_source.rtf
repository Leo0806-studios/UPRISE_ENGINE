6776 {\cf20 // this function is designed to support animated gifs, although stb_image doesn't support it}\par
6777 {\cf20 // two back is the image from two frames ago, used for a very specific disposal format}\par
6778 {\cf17 static} stbi_uc *stbi__gif_load_next(stbi__context *s, stbi__gif *g, {\cf18 int} *comp, {\cf18 int} req_comp, stbi_uc *two_back)\par
