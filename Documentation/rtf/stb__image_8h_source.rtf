5225                {\cf20 // pal_img_n == 3 or 4}\par
5226                s->img_n = pal_img_n; {\cf20 // record the actual colors we had}\par
5227                s->img_out_n = pal_img_n;\par
5228                {\cf19 if} (req_comp >= 3) s->img_out_n = req_comp;\par
