6078 {\cf20 // Photoshop PSD loader -- PD by Thatcher Ulrich, integration by Nicolas Schulz, tweaked by STB}\par
6079 \par
6080 {\cf21 #ifndef STBI_NO_PSD}\par
6081 {\cf17 static} {\cf18 int} stbi__psd_test(stbi__context *s)\par
6082 \{\par
6083    {\cf18 int} r = (stbi__get32be(s) == 0x38425053);\par
6084    stbi__rewind(s);\par
6085    {\cf19 return} r;\par
6086 \}\par
6087 \par
6088 {\cf17 static} {\cf18 int} stbi__psd_decode_rle(stbi__context *s, stbi_uc *p, {\cf18 int} pixelCount)\par
6089 \{\par
6090    {\cf18 int} count, nleft, len;\par
6091 \par
6092    count = 0;\par
6093    {\cf19 while} ((nleft = pixelCount - count) > 0) \{\par
6094       len = stbi__get8(s);\par
6095       {\cf19 if} (len == 128) \{\par
6096          {\cf20 // No-op.}\par
6097       \} {\cf19 else} {\cf19 if} (len < 128) \{\par
6098          {\cf20 // Copy next len+1 bytes literally.}\par
6099          len++;\par
6100          {\cf19 if} (len > nleft) {\cf19 return} 0; {\cf20 // corrupt data}\par
6101          count += len;\par
6102          {\cf19 while} (len) \{\par
6103             *p = stbi__get8(s);\par
6104             p += 4;\par
6105             len--;\par
6106          \}\par
6107       \} {\cf19 else} {\cf19 if} (len > 128) \{\par
6108          stbi_uc   val;\par
6109          {\cf20 // Next -len+1 bytes in the dest are replicated from next source byte.}\par
6110          {\cf20 // (Interpret len as a negative 8-bit int.)}\par
6111          len = 257 - len;\par
6112          {\cf19 if} (len > nleft) {\cf19 return} 0; {\cf20 // corrupt data}\par
6113          val = stbi__get8(s);\par
6114          count += len;\par
6115          {\cf19 while} (len) \{\par
6116             *p = val;\par
6117             p += 4;\par
6118             len--;\par
6119          \}\par
6120       \}\par
6121    \}\par
6122 \par
6123    {\cf19 return} 1;\par
6124 \}\par
6125 \par
6126 {\cf17 static} {\cf18 void} *stbi__psd_load(stbi__context *s, {\cf18 int} *x, {\cf18 int} *y, {\cf18 int} *comp, {\cf18 int} req_comp, stbi__result_info *ri, {\cf18 int} bpc)\par
6127 \{\par
6128    {\cf18 int} pixelCount;\par
6129    {\cf18 int} channelCount, compression;\par
6130    {\cf18 int} channel, i;\par
6131    {\cf18 int} bitdepth;\par
6132    {\cf18 int} w,h;\par
6133    stbi_uc *out;\par
6134    STBI_NOTUSED(ri);\par
6135 \par
6136    {\cf20 // Check identifier}\par
6137    {\cf19 if} (stbi__get32be(s) != 0x38425053)   {\cf20 // "8BPS"}\par
6138       {\cf19 return} stbi__errpuc({\cf22 "not PSD"}, {\cf22 "Corrupt PSD image"});\par
6139 \par
6140    {\cf20 // Check file type version.}\par
6141    {\cf19 if} (stbi__get16be(s) != 1)\par
6142       {\cf19 return} stbi__errpuc({\cf22 "wrong version"}, {\cf22 "Unsupported version of PSD image"});\par
6143 \par
6144    {\cf20 // Skip 6 reserved bytes.}\par
6145    stbi__skip(s, 6 );\par
6146 \par
6147    {\cf20 // Read the number of channels (R, G, B, A, etc).}\par
6148    channelCount = stbi__get16be(s);\par
6149    {\cf19 if} (channelCount < 0 || channelCount > 16)\par
6150       {\cf19 return} stbi__errpuc({\cf22 "wrong channel count"}, {\cf22 "Unsupported number of channels in PSD image"});\par
6151 \par
6152    {\cf20 // Read the rows and columns of the image.}\par
6153    h = stbi__get32be(s);\par
6154    w = stbi__get32be(s);\par
6155 \par
6156    {\cf19 if} (h > STBI_MAX_DIMENSIONS) {\cf19 return} stbi__errpuc({\cf22 "too large"},{\cf22 "Very large image (corrupt?)"});\par
6157    {\cf19 if} (w > STBI_MAX_DIMENSIONS) {\cf19 return} stbi__errpuc({\cf22 "too large"},{\cf22 "Very large image (corrupt?)"});\par
6158 \par
6159    {\cf20 // Make sure the depth is 8 bits.}\par
6160    bitdepth = stbi__get16be(s);\par
6161    {\cf19 if} (bitdepth != 8 && bitdepth != 16)\par
6162       {\cf19 return} stbi__errpuc({\cf22 "unsupported bit depth"}, {\cf22 "PSD bit depth is not 8 or 16 bit"});\par
6163 \par
6164    {\cf20 // Make sure the color mode is RGB.}\par
6165    {\cf20 // Valid options are:}\par
6166    {\cf20 //   0: Bitmap}\par
6167    {\cf20 //   1: Grayscale}\par
6168    {\cf20 //   2: Indexed color}\par
6169    {\cf20 //   3: RGB color}\par
6170    {\cf20 //   4: CMYK color}\par
6171    {\cf20 //   7: Multichannel}\par
6172    {\cf20 //   8: Duotone}\par
6173    {\cf20 //   9: Lab color}\par
6174    {\cf19 if} (stbi__get16be(s) != 3)\par
6175       {\cf19 return} stbi__errpuc({\cf22 "wrong color format"}, {\cf22 "PSD is not in RGB color format"});\par
6176 \par
6177    {\cf20 // Skip the Mode Data.  (It's the palette for indexed color; other info for other modes.)}\par
6178    stbi__skip(s,stbi__get32be(s) );\par
6179 \par
6180    {\cf20 // Skip the image resources.  (resolution, pen tool paths, etc)}\par
6181    stbi__skip(s, stbi__get32be(s) );\par
6182 \par
6183    {\cf20 // Skip the reserved data.}\par
6184    stbi__skip(s, stbi__get32be(s) );\par
6185 \par
6186    {\cf20 // Find out if the data is compressed.}\par
6187    {\cf20 // Known values:}\par
6188    {\cf20 //   0: no compression}\par
6189    {\cf20 //   1: RLE compressed}\par
6190    compression = stbi__get16be(s);\par
6191    {\cf19 if} (compression > 1)\par
6192       {\cf19 return} stbi__errpuc({\cf22 "bad compression"}, {\cf22 "PSD has an unknown compression format"});\par
6193 \par
6194    {\cf20 // Check size}\par
6195    {\cf19 if} (!stbi__mad3sizes_valid(4, w, h, 0))\par
6196       {\cf19 return} stbi__errpuc({\cf22 "too large"}, {\cf22 "Corrupt PSD"});\par
6197 \par
6198    {\cf20 // Create the destination image.}\par
6199 \par
6200    {\cf19 if} (!compression && bitdepth == 16 && bpc == 16) \{\par
6201       out = (stbi_uc *) stbi__malloc_mad3(8, w, h, 0);\par
6202       ri->bits_per_channel = 16;\par
6203    \} {\cf19 else}\par
6204       out = (stbi_uc *) stbi__malloc(4 * w*h);\par
6205 \par
6206    {\cf19 if} (!out) {\cf19 return} stbi__errpuc({\cf22 "outofmem"}, {\cf22 "Out of memory"});\par
6207    pixelCount = w*h;\par
6208 \par
6209    {\cf20 // Initialize the data to zero.}\par
6210    {\cf20 //memset( out, 0, pixelCount * 4 );}\par
6211 \par
6212    {\cf20 // Finally, the image data.}\par
6213    {\cf19 if} (compression) \{\par
6214       {\cf20 // RLE as used by .PSD and .TIFF}\par
6215       {\cf20 // Loop until you get the number of unpacked bytes you are expecting:}\par
6216       {\cf20 //     Read the next source byte into n.}\par
6217       {\cf20 //     If n is between 0 and 127 inclusive, copy the next n+1 bytes literally.}\par
6218       {\cf20 //     Else if n is between -127 and -1 inclusive, copy the next byte -n+1 times.}\par
6219       {\cf20 //     Else if n is 128, noop.}\par
6220       {\cf20 // Endloop}\par
6221 \par
6222       {\cf20 // The RLE-compressed data is preceded by a 2-byte data count for each row in the data,}\par
6223       {\cf20 // which we're going to just skip.}\par
6224       stbi__skip(s, h * channelCount * 2 );\par
6225 \par
6226       {\cf20 // Read the RLE data by channel.}\par
6227       {\cf19 for} (channel = 0; channel < 4; channel++) \{\par
6228          stbi_uc *p;\par
6229 \par
6230          p = out+channel;\par
6231          {\cf19 if} (channel >= channelCount) \{\par
6232             {\cf20 // Fill this channel with default data.}\par
6233             {\cf19 for} (i = 0; i < pixelCount; i++, p += 4)\par
6234                *p = (channel == 3 ? 255 : 0);\par
6235          \} {\cf19 else} \{\par
6236             {\cf20 // Read the RLE data.}\par
6237             {\cf19 if} (!stbi__psd_decode_rle(s, p, pixelCount)) \{\par
6238                STBI_FREE(out);\par
6239                {\cf19 return} stbi__errpuc({\cf22 "corrupt"}, {\cf22 "bad RLE data"});\par
6240             \}\par
6241          \}\par
6242       \}\par
6243 \par
6244    \} {\cf19 else} \{\par
6245       {\cf20 // We're at the raw image data.  It's each channel in order (Red, Green, Blue, Alpha, ...)}\par
6246       {\cf20 // where each channel consists of an 8-bit (or 16-bit) value for each pixel in the image.}\par
6247 \par
6248       {\cf20 // Read the data by channel.}\par
6249       {\cf19 for} (channel = 0; channel < 4; channel++) \{\par
6250          {\cf19 if} (channel >= channelCount) \{\par
6251             {\cf20 // Fill this channel with default data.}\par
6252             {\cf19 if} (bitdepth == 16 && bpc == 16) \{\par
6253                stbi__uint16 *q = ((stbi__uint16 *) out) + channel;\par
6254                stbi__uint16 val = channel == 3 ? 65535 : 0;\par
6255                {\cf19 for} (i = 0; i < pixelCount; i++, q += 4)\par
6256                   *q = val;\par
6257             \} {\cf19 else} \{\par
6258                stbi_uc *p = out+channel;\par
6259                stbi_uc val = channel == 3 ? 255 : 0;\par
6260                {\cf19 for} (i = 0; i < pixelCount; i++, p += 4)\par
6261                   *p = val;\par
6262             \}\par
6263          \} {\cf19 else} \{\par
6264             {\cf19 if} (ri->bits_per_channel == 16) \{    {\cf20 // output bpc}\par
6265                stbi__uint16 *q = ((stbi__uint16 *) out) + channel;\par
6266                {\cf19 for} (i = 0; i < pixelCount; i++, q += 4)\par
6267                   *q = (stbi__uint16) stbi__get16be(s);\par
6268             \} {\cf19 else} \{\par
6269                stbi_uc *p = out+channel;\par
6270                {\cf19 if} (bitdepth == 16) \{  {\cf20 // input bpc}\par
6271                   {\cf19 for} (i = 0; i < pixelCount; i++, p += 4)\par
6272                      *p = (stbi_uc) (stbi__get16be(s) >> 8);\par
6273                \} {\cf19 else} \{\par
6274                   {\cf19 for} (i = 0; i < pixelCount; i++, p += 4)\par
6275                      *p = stbi__get8(s);\par
6276                \}\par
6277             \}\par
6278          \}\par
6279       \}\par
6280    \}\par
6281 \par
6282    {\cf20 // remove weird white matte from PSD}\par
6283    {\cf19 if} (channelCount >= 4) \{\par
6284       {\cf19 if} (ri->bits_per_channel == 16) \{\par
6285          {\cf19 for} (i=0; i < w*h; ++i) \{\par
6286             stbi__uint16 *pixel = (stbi__uint16 *) out + 4*i;\par
6287             {\cf19 if} (pixel[3] != 0 && pixel[3] != 65535) \{\par
6288                {\cf18 float} a = pixel[3] / 65535.0f;\par
6289                {\cf18 float} ra = 1.0f / a;\par
6290                {\cf18 float} inv_a = 65535.0f * (1 - ra);\par
6291                pixel[0] = (stbi__uint16) (pixel[0]*ra + inv_a);\par
6292                pixel[1] = (stbi__uint16) (pixel[1]*ra + inv_a);\par
6293                pixel[2] = (stbi__uint16) (pixel[2]*ra + inv_a);\par
6294             \}\par
6295          \}\par
6296       \} {\cf19 else} \{\par
6297          {\cf19 for} (i=0; i < w*h; ++i) \{\par
6298             {\cf18 unsigned} {\cf18 char} *pixel = out + 4*i;\par
6299             {\cf19 if} (pixel[3] != 0 && pixel[3] != 255) \{\par
6300                {\cf18 float} a = pixel[3] / 255.0f;\par
6301                {\cf18 float} ra = 1.0f / a;\par
6302                {\cf18 float} inv_a = 255.0f * (1 - ra);\par
6303                pixel[0] = ({\cf18 unsigned} char) (pixel[0]*ra + inv_a);\par
6304                pixel[1] = ({\cf18 unsigned} char) (pixel[1]*ra + inv_a);\par
6305                pixel[2] = ({\cf18 unsigned} char) (pixel[2]*ra + inv_a);\par
6306             \}\par
6307          \}\par
6308       \}\par
6309    \}\par
6310 \par
6311    {\cf20 // convert to desired output format}\par
6312    {\cf19 if} (req_comp && req_comp != 4) \{\par
6313       {\cf19 if} (ri->bits_per_channel == 16)\par
6314          out = (stbi_uc *) stbi__convert_format16((stbi__uint16 *) out, 4, req_comp, w, h);\par
6315       {\cf19 else}\par
6316          out = stbi__convert_format(out, 4, req_comp, w, h);\par
6317       {\cf19 if} (out == NULL) {\cf19 return} out; {\cf20 // stbi__convert_format frees input on failure}\par
6318    \}\par
6319 \par
6320    {\cf19 if} (comp) *comp = 4;\par
6321    *y = h;\par
6322    *x = w;\par
6323 \par
6324    {\cf19 return} out;\par
6325 \}\par
6326 {\cf21 #endif}\par
