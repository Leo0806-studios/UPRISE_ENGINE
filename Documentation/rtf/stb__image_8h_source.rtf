1087 {\cf20 // stbi__errpf - error returning pointer to float}\par
1088 {\cf20 // stbi__errpuc - error returning pointer to unsigned char}\par
1089 \par
1090 {\cf21 #ifdef STBI_NO_FAILURE_STRINGS}\par
1091 {\cf21    #define stbi__err(x,y)  0}\par
1092 {\cf21 #elif defined(STBI_FAILURE_USERMSG)}\par
1093 {\cf21    #define stbi__err(x,y)  stbi__err(y)}\par
