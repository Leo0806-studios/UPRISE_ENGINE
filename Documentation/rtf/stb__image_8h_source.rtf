6719       {\cf19 if} (valid_bits < codesize) \{\par
6720          {\cf19 if} (len == 0) \{\par
6721             len = stbi__get8(s); {\cf20 // start new block}\par
6722             {\cf19 if} (len == 0)\par
6723                {\cf19 return} g->out;\par
6724          \}\par
6725          --len;\par
6726          bits |= (stbi__int32) stbi__get8(s) << valid_bits;\par
6727          valid_bits += 8;\par
6728       \} {\cf19 else} \{\par
6729          stbi__int32 code = bits & codemask;\par
6730          bits >>= codesize;\par
6731          valid_bits -= codesize;\par
6732          {\cf20 // @OPTIMIZE: is there some way we can accelerate the non-clear path?}\par
6733          {\cf19 if} (code == clear) \{  {\cf20 // clear code}\par
6734             codesize = lzw_cs + 1;\par
6735             codemask = (1 << codesize) - 1;\par
6736             avail = clear + 2;\par
6737             oldcode = -1;\par
6738             first = 0;\par
6739          \} {\cf19 else} {\cf19 if} (code == clear + 1) \{ {\cf20 // end of stream code}\par
6740             stbi__skip(s, len);\par
6741             {\cf19 while} ((len = stbi__get8(s)) > 0)\par
6742                stbi__skip(s,len);\par
