5790         {\cf19 return} 0;   {\cf20 // test width}\par
5791     \}\par
5792     tga_h = stbi__get16le(s);\par
5793     {\cf19 if}( tga_h < 1 ) \{\par
5794         stbi__rewind(s);\par
5795         {\cf19 return} 0;   {\cf20 // test height}\par
5796     \}\par
5797     tga_bits_per_pixel = stbi__get8(s); {\cf20 // bits per pixel}\par
5798     stbi__get8(s); {\cf20 // ignore alpha bits}\par
5799     {\cf19 if} (tga_colormap_bpp != 0) \{\par
5800         {\cf19 if}((tga_bits_per_pixel != 8) && (tga_bits_per_pixel != 16)) \{\par
5801             {\cf20 // when using a colormap, tga_bits_per_pixel is the size of the indexes}\par
5802             {\cf20 // I don't think anything but 8 or 16bit indexes makes sense}\par
5803             stbi__rewind(s);\par
5804             {\cf19 return} 0;\par
5805         \}\par
5806         tga_comp = stbi__tga_get_comp(tga_colormap_bpp, 0, NULL);\par
5807     \} {\cf19 else} \{\par
5808         tga_comp = stbi__tga_get_comp(tga_bits_per_pixel, (tga_image_type == 3) || (tga_image_type == 11), NULL);\par
5809     \}\par
5810     {\cf19 if}(!tga_comp) \{\par
5811       stbi__rewind(s);\par
5812       {\cf19 return} 0;\par
5813     \}\par
5814     {\cf19 if} (x) *x = tga_w;\par
5815     {\cf19 if} (y) *y = tga_h;\par
5816     {\cf19 if} (comp) *comp = tga_comp;\par
5817     {\cf19 return} 1;                   {\cf20 // seems to have passed everything}\par
5818 \}\par
5819 \par
5820 {\cf17 static} {\cf18 int} stbi__tga_test(stbi__context *s)\par
5821 \{\par
5822    {\cf18 int} res = 0;\par
5823    {\cf18 int} sz, tga_color_type;\par
5824    stbi__get8(s);      {\cf20 //   discard Offset}\par
5825    tga_color_type = stbi__get8(s);   {\cf20 //   color type}\par
5826    {\cf19 if} ( tga_color_type > 1 ) {\cf19 goto} errorEnd;   {\cf20 //   only RGB or indexed allowed}\par
5827    sz = stbi__get8(s);   {\cf20 //   image type}\par
5828    {\cf19 if} ( tga_color_type == 1 ) \{ {\cf20 // colormapped (paletted) image}\par
5829       {\cf19 if} (sz != 1 && sz != 9) {\cf19 goto} errorEnd; {\cf20 // colortype 1 demands image type 1 or 9}\par
5830       stbi__skip(s,4);       {\cf20 // skip index of first colormap entry and number of entries}\par
5831       sz = stbi__get8(s);    {\cf20 //   check bits per palette color entry}\par
5832       {\cf19 if} ( (sz != 8) && (sz != 15) && (sz != 16) && (sz != 24) && (sz != 32) ) {\cf19 goto} errorEnd;\par
5833       stbi__skip(s,4);       {\cf20 // skip image x and y origin}\par
5834    \} {\cf19 else} \{ {\cf20 // "normal" image w/o colormap}\par
5835       {\cf19 if} ( (sz != 2) && (sz != 3) && (sz != 10) && (sz != 11) ) {\cf19 goto} errorEnd; {\cf20 // only RGB or grey allowed, +/- RLE}\par
5836       stbi__skip(s,9); {\cf20 // skip colormap specification and image x/y origin}\par
5837    \}\par
5838    {\cf19 if} ( stbi__get16le(s) < 1 ) {\cf19 goto} errorEnd;      {\cf20 //   test width}\par
5839    {\cf19 if} ( stbi__get16le(s) < 1 ) {\cf19 goto} errorEnd;      {\cf20 //   test height}\par
5840    sz = stbi__get8(s);   {\cf20 //   bits per pixel}\par
5841    {\cf19 if} ( (tga_color_type == 1) && (sz != 8) && (sz != 16) ) {\cf19 goto} errorEnd; {\cf20 // for colormapped images, bpp is size of an index}\par
5842    {\cf19 if} ( (sz != 8) && (sz != 15) && (sz != 16) && (sz != 24) && (sz != 32) ) {\cf19 goto} errorEnd;\par
5843 \par
5844    res = 1; {\cf20 // if we got this far, everything's good and we can return 1 instead of 0}\par
5845 \par
5846 errorEnd:\par
5847    stbi__rewind(s);\par
5848    {\cf19 return} res;\par
5849 \}\par
5850 \par
5851 {\cf20 // read 16bit value and convert to 24bit RGB}\par
5852 {\cf17 static} {\cf18 void} stbi__tga_read_rgb16(stbi__context *s, stbi_uc* out)\par
5853 \{\par
5854    stbi__uint16 px = (stbi__uint16)stbi__get16le(s);\par
5855    stbi__uint16 fiveBitMask = 31;\par
5856    {\cf20 // we have 3 channels with 5bits each}\par
5857    {\cf18 int} r = (px >> 10) & fiveBitMask;\par
5858    {\cf18 int} g = (px >> 5) & fiveBitMask;\par
5859    {\cf18 int} b = px & fiveBitMask;\par
5860    {\cf20 // Note that this saves the data in RGB(A) order, so it doesn't need to be swapped later}\par
5861    out[0] = (stbi_uc)((r * 255)/31);\par
5862    out[1] = (stbi_uc)((g * 255)/31);\par
5863    out[2] = (stbi_uc)((b * 255)/31);\par
5864 \par
5865    {\cf20 // some people claim that the most significant bit might be used for alpha}\par
5866    {\cf20 // (possibly if an alpha-bit is set in the "image descriptor byte")}\par
5867    {\cf20 // but that only made 16bit test images completely translucent..}\par
5868    {\cf20 // so let's treat all 15 and 16bit TGAs as RGB with no alpha.}\par
5869 \}\par
5870 \par
5871 {\cf17 static} {\cf18 void} *stbi__tga_load(stbi__context *s, {\cf18 int} *x, {\cf18 int} *y, {\cf18 int} *comp, {\cf18 int} req_comp, stbi__result_info *ri)\par
5872 \{\par
5873    {\cf20 //   read in the TGA header stuff}\par
5874    {\cf18 int} tga_offset = stbi__get8(s);\par
5875    {\cf18 int} tga_indexed = stbi__get8(s);\par
5876    {\cf18 int} tga_image_type = stbi__get8(s);\par
5877    {\cf18 int} tga_is_RLE = 0;\par
5878    {\cf18 int} tga_palette_start = stbi__get16le(s);\par
5879    {\cf18 int} tga_palette_len = stbi__get16le(s);\par
5880    {\cf18 int} tga_palette_bits = stbi__get8(s);\par
5881    {\cf18 int} tga_x_origin = stbi__get16le(s);\par
5882    {\cf18 int} tga_y_origin = stbi__get16le(s);\par
5883    {\cf18 int} tga_width = stbi__get16le(s);\par
5884    {\cf18 int} tga_height = stbi__get16le(s);\par
5885    {\cf18 int} tga_bits_per_pixel = stbi__get8(s);\par
5886    {\cf18 int} tga_comp, tga_rgb16=0;\par
5887    {\cf18 int} tga_inverted = stbi__get8(s);\par
5888    {\cf20 // int tga_alpha_bits = tga_inverted & 15; // the 4 lowest bits - unused (useless?)}\par
5889    {\cf20 //   image data}\par
5890    {\cf18 unsigned} {\cf18 char} *tga_data;\par
5891    {\cf18 unsigned} {\cf18 char} *tga_palette = NULL;\par
5892    {\cf18 int} i, j;\par
5893    {\cf18 unsigned} {\cf18 char} raw_data[4] = \{0\};\par
5894    {\cf18 int} RLE_count = 0;\par
5895    {\cf18 int} RLE_repeating = 0;\par
5896    {\cf18 int} read_next_pixel = 1;\par
5897    STBI_NOTUSED(ri);\par
5898    STBI_NOTUSED(tga_x_origin); {\cf20 // @TODO}\par
5899    STBI_NOTUSED(tga_y_origin); {\cf20 // @TODO}\par
5900 \par
5901    {\cf19 if} (tga_height > STBI_MAX_DIMENSIONS) {\cf19 return} stbi__errpuc({\cf22 "too large"},{\cf22 "Very large image (corrupt?)"});\par
5902    {\cf19 if} (tga_width > STBI_MAX_DIMENSIONS) {\cf19 return} stbi__errpuc({\cf22 "too large"},{\cf22 "Very large image (corrupt?)"});\par
5903 \par
5904    {\cf20 //   do a tiny bit of precessing}\par
5905    {\cf19 if} ( tga_image_type >= 8 )\par
5906    \{\par
5907       tga_image_type -= 8;\par
5908       tga_is_RLE = 1;\par
5909    \}\par
5910    tga_inverted = 1 - ((tga_inverted >> 5) & 1);\par
5911 \par
5912    {\cf20 //   If I'm paletted, then I'll use the number of bits from the palette}\par
5913    {\cf19 if} ( tga_indexed ) tga_comp = stbi__tga_get_comp(tga_palette_bits, 0, &tga_rgb16);\par
5914    {\cf19 else} tga_comp = stbi__tga_get_comp(tga_bits_per_pixel, (tga_image_type == 3), &tga_rgb16);\par
5915 \par
5916    {\cf19 if}(!tga_comp) {\cf20 // shouldn't really happen, stbi__tga_test() should have ensured basic consistency}\par
5917       {\cf19 return} stbi__errpuc({\cf22 "bad format"}, {\cf22 "Can't find out TGA pixelformat"});\par
5918 \par
5919    {\cf20 //   tga info}\par
5920    *x = tga_width;\par
5921    *y = tga_height;\par
5922    {\cf19 if} (comp) *comp = tga_comp;\par
5923 \par
5924    {\cf19 if} (!stbi__mad3sizes_valid(tga_width, tga_height, tga_comp, 0))\par
5925       {\cf19 return} stbi__errpuc({\cf22 "too large"}, {\cf22 "Corrupt TGA"});\par
5926 \par
5927    tga_data = ({\cf18 unsigned} {\cf18 char}*)stbi__malloc_mad3(tga_width, tga_height, tga_comp, 0);\par
5928    {\cf19 if} (!tga_data) {\cf19 return} stbi__errpuc({\cf22 "outofmem"}, {\cf22 "Out of memory"});\par
5929 \par
5930    {\cf20 // skip to the data's starting position (offset usually = 0)}\par
5931    stbi__skip(s, tga_offset );\par
5932 \par
5933    {\cf19 if} ( !tga_indexed && !tga_is_RLE && !tga_rgb16 ) \{\par
5934       {\cf19 for} (i=0; i < tga_height; ++i) \{\par
5935          {\cf18 int} row = tga_inverted ? tga_height -i - 1 : i;\par
5936          stbi_uc *tga_row = tga_data + row*tga_width*tga_comp;\par
5937          stbi__getn(s, tga_row, tga_width * tga_comp);\par
5938       \}\par
5939    \} {\cf19 else}  \{\par
5940       {\cf20 //   do I need to load a palette?}\par
5941       {\cf19 if} ( tga_indexed)\par
5942       \{\par
5943          {\cf19 if} (tga_palette_len == 0) \{  {\cf20 /* you have to have at least one entry! */}\par
5944             STBI_FREE(tga_data);\par
5945             {\cf19 return} stbi__errpuc({\cf22 "bad palette"}, {\cf22 "Corrupt TGA"});\par
5946          \}\par
5947 \par
5948          {\cf20 //   any data to skip? (offset usually = 0)}\par
5949          stbi__skip(s, tga_palette_start );\par
5950          {\cf20 //   load the palette}\par
5951          tga_palette = ({\cf18 unsigned} {\cf18 char}*)stbi__malloc_mad2(tga_palette_len, tga_comp, 0);\par
5952          {\cf19 if} (!tga_palette) \{\par
5953             STBI_FREE(tga_data);\par
5954             {\cf19 return} stbi__errpuc({\cf22 "outofmem"}, {\cf22 "Out of memory"});\par
5955          \}\par
5956          {\cf19 if} (tga_rgb16) \{\par
5957             stbi_uc *pal_entry = tga_palette;\par
5958             STBI_ASSERT(tga_comp == STBI_rgb);\par
5959             {\cf19 for} (i=0; i < tga_palette_len; ++i) \{\par
5960                stbi__tga_read_rgb16(s, pal_entry);\par
5961                pal_entry += tga_comp;\par
5962             \}\par
5963          \} {\cf19 else} {\cf19 if} (!stbi__getn(s, tga_palette, tga_palette_len * tga_comp)) \{\par
5964                STBI_FREE(tga_data);\par
5965                STBI_FREE(tga_palette);\par
5966                {\cf19 return} stbi__errpuc({\cf22 "bad palette"}, {\cf22 "Corrupt TGA"});\par
5967          \}\par
5968       \}\par
5969       {\cf20 //   load the data}\par
5970       {\cf19 for} (i=0; i < tga_width * tga_height; ++i)\par
5971       \{\par
5972          {\cf20 //   if I'm in RLE mode, do I need to get a RLE stbi__pngchunk?}\par
5973          {\cf19 if} ( tga_is_RLE )\par
5974          \{\par
5975             {\cf19 if} ( RLE_count == 0 )\par
5976             \{\par
5977                {\cf20 //   yep, get the next byte as a RLE command}\par
5978                {\cf18 int} RLE_cmd = stbi__get8(s);\par
5979                RLE_count = 1 + (RLE_cmd & 127);\par
5980                RLE_repeating = RLE_cmd >> 7;\par
5981                read_next_pixel = 1;\par
5982             \} {\cf19 else} {\cf19 if} ( !RLE_repeating )\par
5983             \{\par
5984                read_next_pixel = 1;\par
5985             \}\par
5986          \} {\cf19 else}\par
5987          \{\par
5988             read_next_pixel = 1;\par
5989          \}\par
5990          {\cf20 //   OK, if I need to read a pixel, do it now}\par
5991          {\cf19 if} ( read_next_pixel )\par
5992          \{\par
5993             {\cf20 //   load however much data we did have}\par
5994             {\cf19 if} ( tga_indexed )\par
5995             \{\par
5996                {\cf20 // read in index, then perform the lookup}\par
5997                {\cf18 int} pal_idx = (tga_bits_per_pixel == 8) ? stbi__get8(s) : stbi__get16le(s);\par
5998                {\cf19 if} ( pal_idx >= tga_palette_len ) \{\par
5999                   {\cf20 // invalid index}\par
6000                   pal_idx = 0;\par
6001                \}\par
6002                pal_idx *= tga_comp;\par
6003                {\cf19 for} (j = 0; j < tga_comp; ++j) \{\par
6004                   raw_data[j] = tga_palette[pal_idx+j];\par
6005                \}\par
6006             \} {\cf19 else} {\cf19 if}(tga_rgb16) \{\par
6007                STBI_ASSERT(tga_comp == STBI_rgb);\par
6008                stbi__tga_read_rgb16(s, raw_data);\par
6009             \} {\cf19 else} \{\par
6010                {\cf20 //   read in the data raw}\par
6011                {\cf19 for} (j = 0; j < tga_comp; ++j) \{\par
6012                   raw_data[j] = stbi__get8(s);\par
6013                \}\par
6014             \}\par
6015             {\cf20 //   clear the reading flag for the next pixel}\par
6016             read_next_pixel = 0;\par
6017          \} {\cf20 // end of reading a pixel}\par
6018 \par
6019          {\cf20 // copy data}\par
6020          {\cf19 for} (j = 0; j < tga_comp; ++j)\par
6021            tga_data[i*tga_comp+j] = raw_data[j];\par
6022 \par
6023          {\cf20 //   in case we're in RLE mode, keep counting down}\par
6024          --RLE_count;\par
6025       \}\par
6026       {\cf20 //   do I need to invert the image?}\par
6027       {\cf19 if} ( tga_inverted )\par
6028       \{\par
6029          {\cf19 for} (j = 0; j*2 < tga_height; ++j)\par
6030          \{\par
6031             {\cf18 int} index1 = j * tga_width * tga_comp;\par
6032             {\cf18 int} index2 = (tga_height - 1 - j) * tga_width * tga_comp;\par
6033             {\cf19 for} (i = tga_width * tga_comp; i > 0; --i)\par
6034             \{\par
6035                {\cf18 unsigned} {\cf18 char} temp = tga_data[index1];\par
6036                tga_data[index1] = tga_data[index2];\par
6037                tga_data[index2] = temp;\par
6038                ++index1;\par
6039                ++index2;\par
6040             \}\par
6041          \}\par
6042       \}\par
6043       {\cf20 //   clear my palette, if I had one}\par
6044       {\cf19 if} ( tga_palette != NULL )\par
6045       \{\par
6046          STBI_FREE( tga_palette );\par
6047       \}\par
6048    \}\par
6049 \par
6050    {\cf20 // swap RGB - if the source data was RGB16, it already is in the right order}\par
6051    {\cf19 if} (tga_comp >= 3 && !tga_rgb16)\par
6052    \{\par
6053       {\cf18 unsigned} {\cf18 char}* tga_pixel = tga_data;\par
6054       {\cf19 for} (i=0; i < tga_width * tga_height; ++i)\par
6055       \{\par
6056          {\cf18 unsigned} {\cf18 char} temp = tga_pixel[0];\par
6057          tga_pixel[0] = tga_pixel[2];\par
6058          tga_pixel[2] = temp;\par
6059          tga_pixel += tga_comp;\par
6060       \}\par
6061    \}\par
6062 \par
6063    {\cf20 // convert to target component count}\par
6064    {\cf19 if} (req_comp && req_comp != tga_comp)\par
6065       tga_data = stbi__convert_format(tga_data, tga_comp, req_comp, tga_width, tga_height);\par
6066 \par
6067    {\cf20 //   the things I do to get rid of an error message, and yet keep}\par
6068    {\cf20 //   Microsoft's C compilers happy... [8^(}\par
6069    tga_palette_start = tga_palette_len = tga_palette_bits =\par
6070          tga_x_origin = tga_y_origin = 0;\par
6071    STBI_NOTUSED(tga_palette_start);\par
6072    {\cf20 //   OK, done}\par
6073    {\cf19 return} tga_data;\par
6074 \}\par
6075 {\cf21 #endif}\par
