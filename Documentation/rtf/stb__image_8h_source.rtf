2048 {\cf20 // build a table that decodes both magnitude and value of small ACs in}\par
2049 {\cf20 // one go.}\par
2050 {\cf17 static} {\cf18 void} stbi__build_fast_ac(stbi__int16 *fast_ac, stbi__huffman *h)\par
2051 \{\par
2052    {\cf18 int} i;\par
2053    {\cf19 for} (i=0; i < (1 << FAST_BITS); ++i) \{\par
2054       stbi_uc fast = h->fast[i];\par
2055       fast_ac[i] = 0;\par
2056       {\cf19 if} (fast < 255) \{\par
2057          {\cf18 int} rs = h->values[fast];\par
2058          {\cf18 int} run = (rs >> 4) & 15;\par
2059          {\cf18 int} magbits = rs & 15;\par
2060          {\cf18 int} len = h->size[fast];\par
2061 \par
2062          {\cf19 if} (magbits && len + magbits <= FAST_BITS) \{\par
2063             {\cf20 // magnitude code followed by receive_extend code}\par
2064             {\cf18 int} k = ((i << len) & ((1 << FAST_BITS) - 1)) >> (FAST_BITS - magbits);\par
2065             {\cf18 int} m = 1 << (magbits - 1);\par
