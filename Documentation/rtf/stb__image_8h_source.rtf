4861 {\cf17 static} {\cf18 int} stbi__create_png_image(stbi__png *a, stbi_uc *image_data, stbi__uint32 image_data_len, {\cf18 int} out_n, {\cf18 int} depth, {\cf18 int} color, {\cf18 int} interlaced)\par
4862 \{\par
4863    {\cf18 int} bytes = (depth == 16 ? 2 : 1);\par
4864    {\cf18 int} out_bytes = out_n * bytes;\par
4865    stbi_uc *{\cf17 final};\par
4866    {\cf18 int} p;\par
4867    {\cf19 if} (!interlaced)\par
4868       {\cf19 return} stbi__create_png_image_raw(a, image_data, image_data_len, out_n, a->s->img_x, a->s->img_y, depth, color);\par
4869 \par
4870    {\cf20 // de-interlacing}\par
4871    {\cf17 final} = (stbi_uc *) stbi__malloc_mad3(a->s->img_x, a->s->img_y, out_bytes, 0);\par
4872    {\cf19 if} (!{\cf17 final}) {\cf19 return} stbi__err({\cf22 "outofmem"}, {\cf22 "Out of memory"});\par
4873    {\cf19 for} (p=0; p < 7; ++p) \{\par
4874       {\cf18 int} xorig[] = \{ 0,4,0,2,0,1,0 \};\par
4875       {\cf18 int} yorig[] = \{ 0,0,4,0,2,0,1 \};\par
4876       {\cf18 int} xspc[]  = \{ 8,8,4,4,2,2,1 \};\par
4877       {\cf18 int} yspc[]  = \{ 8,8,8,4,4,2,2 \};\par
4878       {\cf18 int} i,j,x,y;\par
4879       {\cf20 // pass1_x[4] = 0, pass1_x[5] = 1, pass1_x[12] = 1}\par
4880       x = (a->s->img_x - xorig[p] + xspc[p]-1) / xspc[p];\par
4881       y = (a->s->img_y - yorig[p] + yspc[p]-1) / yspc[p];\par
4882       {\cf19 if} (x && y) \{\par
4883          stbi__uint32 img_len = ((((a->s->img_n * x * depth) + 7) >> 3) + 1) * y;\par
4884          {\cf19 if} (!stbi__create_png_image_raw(a, image_data, image_data_len, out_n, x, y, depth, color)) \{\par
4885             STBI_FREE({\cf17 final});\par
4886             {\cf19 return} 0;\par
4887          \}\par
4888          {\cf19 for} (j=0; j < y; ++j) \{\par
4889             {\cf19 for} (i=0; i < x; ++i) \{\par
4890                {\cf18 int} out_y = j*yspc[p]+yorig[p];\par
4891                {\cf18 int} out_x = i*xspc[p]+xorig[p];\par
4892                memcpy({\cf17 final} + out_y*a->s->img_x*out_bytes + out_x*out_bytes,\par
4893                       a->out + (j*x+i)*out_bytes, out_bytes);\par
4894             \}\par
4895          \}\par
4896          STBI_FREE(a->out);\par
4897          image_data += img_len;\par
4898          image_data_len -= img_len;\par
4899       \}\par
4900    \}\par
4901    a->out = {\cf17 final};\par
4902 \par
4903    {\cf19 return} 1;\par
4904 \}\par
