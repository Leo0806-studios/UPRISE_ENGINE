7272                   {\cf20 // Dump}\par
7273                   {\cf19 if} ((count == 0) || (count > nleft)) \{ STBI_FREE(hdr_data); STBI_FREE(scanline); {\cf19 return} stbi__errpf({\cf22 "corrupt"}, {\cf22 "bad RLE data in HDR"}); \}\par
7274                   {\cf19 for} (z = 0; z < count; ++z)\par
7275                      scanline[i++ * 4 + k] = stbi__get8(s);\par
7276                \}\par
7277             \}\par
7278          \}\par
