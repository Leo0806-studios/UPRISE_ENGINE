3110 \par
3111       {\cf19 case} 0xDB: {\cf20 // DQT - define quantization table}\par
3112          L = stbi__get16be(z->s)-2;\par
3113          {\cf19 while} (L > 0) \{\par
3114             {\cf18 int} q = stbi__get8(z->s);\par
3115             {\cf18 int} p = q >> 4, sixteen = (p != 0);\par
3116             {\cf18 int} t = q & 15,i;\par
3117             {\cf19 if} (p != 0 && p != 1) {\cf19 return} stbi__err({\cf22 "bad DQT type"},{\cf22 "Corrupt JPEG"});\par
3118             {\cf19 if} (t > 3) {\cf19 return} stbi__err({\cf22 "bad DQT table"},{\cf22 "Corrupt JPEG"});\par
