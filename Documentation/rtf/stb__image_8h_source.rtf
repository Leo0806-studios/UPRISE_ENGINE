4743       {\cf18 int} filter = *raw++;\par
4744 \par
4745       {\cf20 // check filter type}\par
4746       {\cf19 if} (filter > 4) \{\par
4747          all_ok = stbi__err({\cf22 "invalid filter"},{\cf22 "Corrupt PNG"});\par
4748          {\cf19 break};\par
4749       \}\par
4750 \par
4751       {\cf20 // if first row, use special filter that doesn't sample previous row}\par
