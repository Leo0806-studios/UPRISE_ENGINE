2105    {\cf20 // if the code is <= FAST_BITS}\par
2106    c = (j->code_buffer >> (32 - FAST_BITS)) & ((1 << FAST_BITS)-1);\par
2107    k = h->fast[c];\par
2108    {\cf19 if} (k < 255) \{\par
2109       {\cf18 int} s = h->size[k];\par
2110       {\cf19 if} (s > j->code_bits)\par
2111          {\cf19 return} -1;\par
2112       j->code_buffer <<= s;\par
2113       j->code_bits -= s;\par
2114       {\cf19 return} h->values[k];\par
2115    \}\par
2116 \par
2117    {\cf20 // naive test is to shift the code_buffer down so k bits are}\par
2118    {\cf20 // valid, then test against maxcode. To speed this up, we've}\par
2119    {\cf20 // preshifted maxcode left so that it has (16-k) 0s at the}\par
2120    {\cf20 // end; in other words, regardless of the number of bits, it}\par
2121    {\cf20 // wants to be compared against something shifted to have 16;}\par
2122    {\cf20 // that way we don't need to shift inside the loop.}\par
