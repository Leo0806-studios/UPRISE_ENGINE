6669 \par
6670    c = &g->color_table[g->codes[code].suffix * 4];\par
6671    {\cf19 if} (c[3] > 128) \{ {\cf20 // don't render transparent pixels;}\par
6672       p[0] = c[2];\par
6673       p[1] = c[1];\par
6674       p[2] = c[0];\par
6675       p[3] = c[3];\par
6676    \}\par
6677    g->cur_x += 4;\par
6678 \par
6679    {\cf19 if} (g->cur_x >= g->max_x) \{\par
