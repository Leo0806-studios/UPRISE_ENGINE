01177     version = ({\cf17 const} {\cf18 char}*) glGetString(GL_VERSION);\par
01178     {\cf19 if} (!version) {\cf19 return};\par
01179 \par
01180     {\cf19 for} (i = 0;  prefixes[i];  i++) \{\par
01181         {\cf17 const} {\cf18 size_t} length = strlen(prefixes[i]);\par
01182         {\cf19 if} (strncmp(version, prefixes[i], length) == 0) \{\par
01183             version += length;\par
01184             {\cf19 break};\par
01185         \}\par
01186     \}\par
01187 \par
01188 {\cf20 /* PR #18 */}\par
