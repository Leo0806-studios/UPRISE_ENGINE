01161 {\cf17 static} {\cf18 void} find_coreGL({\cf18 void}) \{\par
01162 \par
01163     {\cf20 /* Thank you @elmindreda}\par
01164 {\cf20      * https://github.com/elmindreda/greg/blob/master/templates/greg.c.in#L176}\par
01165 {\cf20      * https://github.com/glfw/glfw/blob/master/src/context.c#L36}\par
