01167     {\cf18 int} i, major, minor;\par
01168 \par
01169     {\cf17 const} {\cf18 char}* version;\par
01170     {\cf17 const} {\cf18 char}* prefixes[] = \{\par
01171         {\cf22 "OpenGL ES-CM "},\par
01172         {\cf22 "OpenGL ES-CL "},\par
01173         {\cf22 "OpenGL ES "},\par
01174         NULL\par
