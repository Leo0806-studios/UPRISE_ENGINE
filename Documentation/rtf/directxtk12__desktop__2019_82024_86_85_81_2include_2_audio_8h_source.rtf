593         \{\par
594             Velocity.x = vel.x;\par
595             Velocity.y = vel.y;\par
596             Velocity.z = vel.z;\par
597         \}\par
598 \par
599         {\cf18 void} XM_CALLCONV SetOrientation(FXMVECTOR forward, FXMVECTOR up) {\cf17 noexcept}\par
600         \{\par
601             XMStoreFloat3({\cf17 reinterpret_cast<}XMFLOAT3*{\cf17 >}(&OrientFront), forward);\par
602             XMStoreFloat3({\cf17 reinterpret_cast<}XMFLOAT3*{\cf17 >}(&OrientTop), up);\par
603         \}\par
604         {\cf18 void} __cdecl SetOrientation({\cf17 const} XMFLOAT3& forward, {\cf17 const} XMFLOAT3& up) {\cf17 noexcept}\par
605         \{\par
606             OrientFront.x = forward.x;  OrientTop.x = up.x;\par
607             OrientFront.y = forward.y;  OrientTop.y = up.y;\par
608             OrientFront.z = forward.z;  OrientTop.z = up.z;\par
609         \}\par
610 \par
611         {\cf18 void} XM_CALLCONV SetOrientationFromQuaternion(FXMVECTOR quat) {\cf17 noexcept}\par
612         \{\par
613             {\cf17 const} XMVECTOR forward = XMVector3Rotate(g_XMIdentityR2, quat);\par
614             XMStoreFloat3({\cf17 reinterpret_cast<}XMFLOAT3*{\cf17 >}(&OrientFront), forward);\par
615 \par
616             {\cf17 const} XMVECTOR up = XMVector3Rotate(g_XMIdentityR1, quat);\par
617             XMStoreFloat3({\cf17 reinterpret_cast<}XMFLOAT3*{\cf17 >}(&OrientTop), up);\par
618         \}\par
619 \par
620         {\cf20 // Updates velocity and orientation by tracking changes in position over time.}\par
621         {\cf18 void} XM_CALLCONV Update(FXMVECTOR newPos, XMVECTOR upDir, {\cf18 float} dt) {\cf17 noexcept}\par
622         \{\par
623             {\cf19 if} (dt > 0.f)\par
624             \{\par
625                 {\cf17 const} XMVECTOR lastPos = XMLoadFloat3({\cf17 reinterpret_cast<}{\cf17 const }XMFLOAT3*{\cf17 >}(&Position));\par
626 \par
627                 XMVECTOR vDelta = XMVectorSubtract(newPos, lastPos);\par
628                 {\cf17 const} XMVECTOR vt = XMVectorReplicate(dt);\par
629                 XMVECTOR v = XMVectorDivide(vDelta, vt);\par
630                 XMStoreFloat3({\cf17 reinterpret_cast<}XMFLOAT3*{\cf17 >}(&Velocity), v);\par
631 \par
632                 vDelta = XMVector3Normalize(vDelta);\par
633                 XMStoreFloat3({\cf17 reinterpret_cast<}XMFLOAT3*{\cf17 >}(&OrientFront), vDelta);\par
634 \par
635                 v = XMVector3Cross(upDir, vDelta);\par
636                 v = XMVector3Normalize(v);\par
637 \par
638                 v = XMVector3Cross(vDelta, v);\par
639                 v = XMVector3Normalize(v);\par
640                 XMStoreFloat3({\cf17 reinterpret_cast<}XMFLOAT3*{\cf17 >}(&OrientTop), v);\par
641 \par
642                 XMStoreFloat3({\cf17 reinterpret_cast<}XMFLOAT3*{\cf17 >}(&Position), newPos);\par
643             \}\par
644         \}\par
645 \par
646         {\cf18 void} __cdecl SetOmnidirectional() noexcept\par
647         \{\par
648             pCone = {\cf17 nullptr};\par
649         \}\par
