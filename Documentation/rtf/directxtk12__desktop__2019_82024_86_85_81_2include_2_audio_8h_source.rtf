462     {\cf17 struct }AudioListener : {\cf17 public} X3DAUDIO_LISTENER\par
463     \{\par
464         X3DAUDIO_CONE   ListenerCone;\par
465 \par
466         AudioListener() noexcept :\par
467             X3DAUDIO_LISTENER\{\},\par
468             ListenerCone\{\}\par
469         \{\par
470             OrientFront.z = -1.f;\par
471 \par
472             OrientTop.y = 1.f;\par
473         \}\par
474 \par
475         {\cf18 void} XM_CALLCONV SetPosition(FXMVECTOR v) {\cf17 noexcept}\par
476         \{\par
477             XMStoreFloat3({\cf17 reinterpret_cast<}XMFLOAT3*{\cf17 >}(&Position), v);\par
478         \}\par
479         {\cf18 void} __cdecl SetPosition({\cf17 const} XMFLOAT3& pos) {\cf17 noexcept}\par
480         \{\par
481             Position.x = pos.x;\par
482             Position.y = pos.y;\par
483             Position.z = pos.z;\par
484         \}\par
485 \par
486         {\cf18 void} XM_CALLCONV SetVelocity(FXMVECTOR v) {\cf17 noexcept}\par
487         \{\par
488             XMStoreFloat3({\cf17 reinterpret_cast<}XMFLOAT3*{\cf17 >}(&Velocity), v);\par
489         \}\par
490         {\cf18 void} __cdecl SetVelocity({\cf17 const} XMFLOAT3& vel) {\cf17 noexcept}\par
491         \{\par
492             Velocity.x = vel.x;\par
493             Velocity.y = vel.y;\par
494             Velocity.z = vel.z;\par
495         \}\par
496 \par
497         {\cf18 void} XM_CALLCONV SetOrientation(FXMVECTOR forward, FXMVECTOR up) {\cf17 noexcept}\par
498         \{\par
499             XMStoreFloat3({\cf17 reinterpret_cast<}XMFLOAT3*{\cf17 >}(&OrientFront), forward);\par
500             XMStoreFloat3({\cf17 reinterpret_cast<}XMFLOAT3*{\cf17 >}(&OrientTop), up);\par
501         \}\par
502         {\cf18 void} __cdecl SetOrientation({\cf17 const} XMFLOAT3& forward, {\cf17 const} XMFLOAT3& up) {\cf17 noexcept}\par
503         \{\par
504             OrientFront.x = forward.x;  OrientTop.x = up.x;\par
505             OrientFront.y = forward.y;  OrientTop.y = up.y;\par
506             OrientFront.z = forward.z;  OrientTop.z = up.z;\par
507         \}\par
508 \par
509         {\cf18 void} XM_CALLCONV SetOrientationFromQuaternion(FXMVECTOR quat) {\cf17 noexcept}\par
510         \{\par
511             {\cf17 const} XMVECTOR forward = XMVector3Rotate(g_XMIdentityR2, quat);\par
512             XMStoreFloat3({\cf17 reinterpret_cast<}XMFLOAT3*{\cf17 >}(&OrientFront), forward);\par
513 \par
514             {\cf17 const} XMVECTOR up = XMVector3Rotate(g_XMIdentityR1, quat);\par
515             XMStoreFloat3({\cf17 reinterpret_cast<}XMFLOAT3*{\cf17 >}(&OrientTop), up);\par
516         \}\par
517 \par
518         {\cf20 // Updates velocity and orientation by tracking changes in position over time.}\par
519         {\cf18 void} XM_CALLCONV Update(FXMVECTOR newPos, XMVECTOR upDir, {\cf18 float} dt) {\cf17 noexcept}\par
520         \{\par
521             {\cf19 if} (dt > 0.f)\par
522             \{\par
523                 {\cf17 const} XMVECTOR lastPos = XMLoadFloat3({\cf17 reinterpret_cast<}{\cf17 const }XMFLOAT3*{\cf17 >}(&Position));\par
524 \par
525                 XMVECTOR vDelta = XMVectorSubtract(newPos, lastPos);\par
526                 {\cf17 const} XMVECTOR vt = XMVectorReplicate(dt);\par
527                 XMVECTOR v = XMVectorDivide(vDelta, vt);\par
528                 XMStoreFloat3({\cf17 reinterpret_cast<}XMFLOAT3*{\cf17 >}(&Velocity), v);\par
529 \par
530                 vDelta = XMVector3Normalize(vDelta);\par
531                 XMStoreFloat3({\cf17 reinterpret_cast<}XMFLOAT3*{\cf17 >}(&OrientFront), vDelta);\par
532 \par
533                 v = XMVector3Cross(upDir, vDelta);\par
534                 v = XMVector3Normalize(v);\par
535 \par
536                 v = XMVector3Cross(vDelta, v);\par
537                 v = XMVector3Normalize(v);\par
538                 XMStoreFloat3({\cf17 reinterpret_cast<}XMFLOAT3*{\cf17 >}(&OrientTop), v);\par
539 \par
540                 XMStoreFloat3({\cf17 reinterpret_cast<}XMFLOAT3*{\cf17 >}(&Position), newPos);\par
541             \}\par
