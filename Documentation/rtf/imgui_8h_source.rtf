749     {\cf20 // Popups, Modals}\par
750     {\cf20 //  - They block normal mouse hovering detection (and therefore most mouse interactions) behind them.}\par
751     {\cf20 //  - If not modal: they can be closed by clicking anywhere outside them, or by pressing ESCAPE.}\par
752     {\cf20 //  - Their visibility state (~bool) is held internally instead of being held by the programmer as we are used to with regular Begin*() calls.}\par
753     {\cf20 //  - The 3 properties above are related: we need to retain popup visibility state in the library because popups may be closed as any time.}\par
754     {\cf20 //  - You can bypass the hovering restriction by using ImGuiHoveredFlags_AllowWhenBlockedByPopup when calling IsItemHovered() or IsWindowHovered().}\par
755     {\cf20 //  - IMPORTANT: Popup identifiers are relative to the current ID stack, so OpenPopup and BeginPopup generally needs to be at the same level of the stack.}\par
756     {\cf20 //    This is sometimes leading to confusing mistakes. May rework this in the future.}\par
757     {\cf20 //  - BeginPopup(): query popup state, if open start appending into the window. Call EndPopup() afterwards if returned true. ImGuiWindowFlags are forwarded to the window.}\par
758     {\cf20 //  - BeginPopupModal(): block every interaction behind the window, cannot be closed by user, add a dimming background, has a title bar.}\par
759     IMGUI_API {\cf18 bool}          BeginPopup({\cf17 const} {\cf18 char}* str_id, ImGuiWindowFlags flags = 0);                         {\cf20 // return true if the popup is open, and you can start outputting to it.}\par
760     IMGUI_API {\cf18 bool}          BeginPopupModal({\cf17 const} {\cf18 char}* name, {\cf18 bool}* p_open = NULL, ImGuiWindowFlags flags = 0); {\cf20 // return true if the modal is open, and you can start outputting to it.}\par
761     IMGUI_API {\cf18 void}          EndPopup();                                                                         {\cf20 // only call EndPopup() if BeginPopupXXX() returns true!}\par
