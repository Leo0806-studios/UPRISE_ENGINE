2725 {\cf20 // Helper: Manually clip large list of items.}\par
2726 {\cf20 // If you have lots evenly spaced items and you have random access to the list, you can perform coarse}\par
2727 {\cf20 // clipping based on visibility to only submit items that are in view.}\par
2728 {\cf20 // The clipper calculates the range of visible items and advance the cursor to compensate for the non-visible items we have skipped.}\par
2729 {\cf20 // (Dear ImGui already clip items based on their bounds but: it needs to first layout the item to do so, and generally}\par
2730 {\cf20 //  fetching/submitting your own data incurs additional cost. Coarse clipping using ImGuiListClipper allows you to easily}\par
2731 {\cf20 //  scale using lists with tens of thousands of items without a problem)}\par
2732 {\cf20 // Usage:}\par
2733 {\cf20 //   ImGuiListClipper clipper;}\par
2734 {\cf20 //   clipper.Begin(1000);         // We have 1000 elements, evenly spaced.}\par
2735 {\cf20 //   while (clipper.Step())}\par
2736 {\cf20 //       for (int i = clipper.DisplayStart; i < clipper.DisplayEnd; i++)}\par
2737 {\cf20 //           ImGui::Text("line number %d", i);}\par
2738 {\cf20 // Generally what happens is:}\par
2739 {\cf20 // - Clipper lets you process the first element (DisplayStart = 0, DisplayEnd = 1) regardless of it being visible or not.}\par
2740 {\cf20 // - User code submit that one element.}\par
2741 {\cf20 // - Clipper can measure the height of the first element}\par
2742 {\cf20 // - Clipper calculate the actual range of elements to display based on the current clipping rectangle, position the cursor before the first visible element.}\par
2743 {\cf20 // - User code submit visible elements.}\par
2744 {\cf20 // - The clipper also handles various subtleties related to keyboard/gamepad navigation, wrapping etc.}\par
2745 {\cf17 struct }ImGuiListClipper\par
2746 \{\par
2747     ImGuiContext*   Ctx;                {\cf20 // Parent UI context}\par
2748     {\cf18 int}             DisplayStart;       {\cf20 // First item to display, updated by each call to Step()}\par
2749     {\cf18 int}             DisplayEnd;         {\cf20 // End of items to display (exclusive)}\par
2750     {\cf18 int}             ItemsCount;         {\cf20 // [Internal] Number of items}\par
2751     {\cf18 float}           ItemsHeight;        {\cf20 // [Internal] Height of item after a first step and item submission can calculate it}\par
2752     {\cf18 float}           StartPosY;          {\cf20 // [Internal] Cursor position at the time of Begin() or after table frozen rows are all processed}\par
2753     {\cf18 double}          StartSeekOffsetY;   {\cf20 // [Internal] Account for frozen rows in a table and initial loss of precision in very large windows.}\par
2754     {\cf18 void}*           TempData;           {\cf20 // [Internal] Internal data}\par
2755 \par
2756     {\cf20 // items_count: Use INT_MAX if you don't know how many items you have (in which case the cursor won't be advanced in the final step, and you can call SeekCursorForItem() manually if you need)}\par
2757     {\cf20 // items_height: Use -1.0f to be calculated automatically on first step. Otherwise pass in the distance between your items, typically GetTextLineHeightWithSpacing() or GetFrameHeightWithSpacing().}\par
2758     IMGUI_API ImGuiListClipper();\par
2759     IMGUI_API ~ImGuiListClipper();\par
2760     IMGUI_API {\cf18 void}  Begin({\cf18 int} items_count, {\cf18 float} items_height = -1.0f);\par
2761     IMGUI_API {\cf18 void}  End();             {\cf20 // Automatically called on the last call of Step() that returns false.}\par
2762     IMGUI_API {\cf18 bool}  Step();            {\cf20 // Call until it returns false. The DisplayStart/DisplayEnd fields will be set and you can process/draw those items.}\par
2763 \par
2764     {\cf20 // Call IncludeItemByIndex() or IncludeItemsByIndex() *BEFORE* first call to Step() if you need a range of items to not be clipped, regardless of their visibility.}\par
2765     {\cf20 // (Due to alignment / padding of certain items it is possible that an extra item may be included on either end of the display range).}\par
2766     {\cf17 inline} {\cf18 void}     IncludeItemByIndex({\cf18 int} item_index)                  \{ IncludeItemsByIndex(item_index, item_index + 1); \}\par
2767     IMGUI_API {\cf18 void}  IncludeItemsByIndex({\cf18 int} item_begin, {\cf18 int} item_end);  {\cf20 // item_end is exclusive e.g. use (42, 42+1) to make item 42 never clipped.}\par
2768 \par
2769     {\cf20 // Seek cursor toward given item. This is automatically called while stepping.}\par
2770     {\cf20 // - The only reason to call this is: you can use ImGuiListClipper::Begin(INT_MAX) if you don't know item count ahead of time.}\par
2771     {\cf20 // - In this case, after all steps are done, you'll want to call SeekCursorForItem(item_count).}\par
2772     IMGUI_API {\cf18 void}  SeekCursorForItem({\cf18 int} item_index);\par
2773 \par
2774 {\cf21 #ifndef IMGUI_DISABLE_OBSOLETE_FUNCTIONS}\par
2775     {\cf17 inline} {\cf18 void} IncludeRangeByIndices({\cf18 int} item_begin, {\cf18 int} item_end)      \{ IncludeItemsByIndex(item_begin, item_end); \} {\cf20 // [renamed in 1.89.9]}\par
2776     {\cf17 inline} {\cf18 void} ForceDisplayRangeByIndices({\cf18 int} item_begin, {\cf18 int} item_end) \{ IncludeItemsByIndex(item_begin, item_end); \} {\cf20 // [renamed in 1.89.6]}\par
2777     {\cf20 //inline ImGuiListClipper(int items_count, float items_height = -1.0f) \{ memset(this, 0, sizeof(*this)); ItemsCount = -1; Begin(items_count, items_height); \} // [removed in 1.79]}\par
2778 {\cf21 #endif}\par
2779 \};\par
