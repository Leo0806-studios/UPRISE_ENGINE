2048 {\cf20 // Enum for ImGui::TableSetBgColor()}\par
2049 {\cf20 // Background colors are rendering in 3 layers:}\par
2050 {\cf20 //  - Layer 0: draw with RowBg0 color if set, otherwise draw with ColumnBg0 if set.}\par
2051 {\cf20 //  - Layer 1: draw with RowBg1 color if set, otherwise draw with ColumnBg1 if set.}\par
2052 {\cf20 //  - Layer 2: draw with CellBg color if set.}\par
2053 {\cf20 // The purpose of the two row/columns layers is to let you decide if a background color change should override or blend with the existing color.}\par
2054 {\cf20 // When using ImGuiTableFlags_RowBg on the table, each row has the RowBg0 color automatically set for odd/even rows.}\par
2055 {\cf20 // If you set the color of RowBg0 target, your color will override the existing RowBg0 color.}\par
2056 {\cf20 // If you set the color of RowBg1 or ColumnBg1 target, your color will blend over the RowBg0 color.}\par
2057 {\cf17 enum} ImGuiTableBgTarget_\par
2058 \{\par
2059     ImGuiTableBgTarget_None                     = 0,\par
2060     ImGuiTableBgTarget_RowBg0                   = 1,        {\cf20 // Set row background color 0 (generally used for background, automatically set when ImGuiTableFlags_RowBg is used)}\par
2061     ImGuiTableBgTarget_RowBg1                   = 2,        {\cf20 // Set row background color 1 (generally used for selection marking)}\par
2062     ImGuiTableBgTarget_CellBg                   = 3,        {\cf20 // Set cell background color (top-most color)}\par
2063 \};\par
