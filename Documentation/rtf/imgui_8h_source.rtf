2701     IMGUI_API {\cf18 float}     GetFloat(ImGuiID key, {\cf18 float} default_val = 0.0f) {\cf17 const};\par
2702     IMGUI_API {\cf18 void}      SetFloat(ImGuiID key, {\cf18 float} val);\par
