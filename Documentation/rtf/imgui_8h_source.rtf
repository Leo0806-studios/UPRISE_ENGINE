2119 {\cf20 // ImVector<>}\par
2120 {\cf20 // Lightweight std::vector<>-like class to avoid dragging dependencies (also, some implementations of STL with debug enabled are absurdly slow, we bypass it so our code runs fast in debug).}\par
2121 {\cf20 //-----------------------------------------------------------------------------}\par
2122 {\cf20 // - You generally do NOT need to care or use this ever. But we need to make it available in imgui.h because some of our public structures are relying on it.}\par
2123 {\cf20 // - We use std-like naming convention here, which is a little unusual for this codebase.}\par
2124 {\cf20 // - Important: clear() frees memory, resize(0) keep the allocated buffer. We use resize(0) a lot to intentionally recycle allocated buffers across frames and amortize our costs.}\par
2125 {\cf20 // - Important: our implementation does NOT call C++ constructors/destructors, we treat everything as raw data! This is intentional but be extra mindful of that,}\par
2126 {\cf20 //   Do NOT use this class as a std::vector replacement in your own code! Many of the structures used by dear imgui can be safely initialized by a zero-memset.}\par
2127 {\cf20 //-----------------------------------------------------------------------------}\par
2128 \par
2129 IM_MSVC_RUNTIME_CHECKS_OFF\par
2130 {\cf17 template}<{\cf17 typename} T>\par
2131 {\cf17 struct }ImVector\par
2132 \{\par
2133     {\cf18 int}                 Size;\par
2134     {\cf18 int}                 Capacity;\par
2135     T*                  Data;\par
2136 \par
2137     {\cf20 // Provide standard typedefs but we don't use them ourselves.}\par
2138     {\cf17 typedef} T                   value_type;\par
2139     {\cf17 typedef} value_type*         iterator;\par
2140     {\cf17 typedef} {\cf17 const} value_type*   const_iterator;\par
2141 \par
2142     {\cf20 // Constructors, destructor}\par
2143     {\cf17 inline} ImVector()                                       \{ Size = Capacity = 0; Data = NULL; \}\par
2144     {\cf17 inline} ImVector({\cf17 const} ImVector<T>& src)                 \{ Size = Capacity = 0; Data = NULL; operator=(src); \}\par
2145     {\cf17 inline} ImVector<T>& operator=({\cf17 const} ImVector<T>& src)   \{ clear(); resize(src.Size); {\cf19 if} (src.Data) memcpy(Data, src.Data, ({\cf18 size_t})Size * {\cf17 sizeof}(T)); {\cf19 return} *{\cf17 this}; \}\par
2146     {\cf17 inline} ~ImVector()                                      \{ {\cf19 if} (Data) IM_FREE(Data); \} {\cf20 // Important: does not destruct anything}\par
2147 \par
2148     {\cf17 inline} {\cf18 void}         clear()                             \{ {\cf19 if} (Data) \{ Size = Capacity = 0; IM_FREE(Data); Data = NULL; \} \}  {\cf20 // Important: does not destruct anything}\par
2149     {\cf17 inline} {\cf18 void}         clear_delete()                      \{ {\cf19 for} ({\cf18 int} n = 0; n < Size; n++) IM_DELETE(Data[n]); clear(); \}     {\cf20 // Important: never called automatically! always explicit.}\par
2150     {\cf17 inline} {\cf18 void}         clear_destruct()                    \{ {\cf19 for} ({\cf18 int} n = 0; n < Size; n++) Data[n].~T(); clear(); \}           {\cf20 // Important: never called automatically! always explicit.}\par
2151 \par
2152     {\cf17 inline} {\cf18 bool}         empty(){\cf17  const                       }\{ {\cf19 return} Size == 0; \}\par
2153     {\cf17 inline} {\cf18 int}          size(){\cf17  const                        }\{ {\cf19 return} Size; \}\par
2154     {\cf17 inline} {\cf18 int}          size_in_bytes(){\cf17  const               }\{ {\cf19 return} Size * (int){\cf17 sizeof}(T); \}\par
2155     {\cf17 inline} {\cf18 int}          max_size(){\cf17  const                    }\{ {\cf19 return} 0x7FFFFFFF / (int){\cf17 sizeof}(T); \}\par
2156     {\cf17 inline} {\cf18 int}          capacity(){\cf17  const                    }\{ {\cf19 return} Capacity; \}\par
2157     {\cf17 inline} T&           operator[]({\cf18 int} i)                   \{ IM_ASSERT(i >= 0 && i < Size); {\cf19 return} Data[i]; \}\par
2158     {\cf17 inline} {\cf17 const} T&     operator[]({\cf18 int} i){\cf17  const             }\{ IM_ASSERT(i >= 0 && i < Size); {\cf19 return} Data[i]; \}\par
2159 \par
2160     {\cf17 inline} T*           begin()                             \{ {\cf19 return} Data; \}\par
2161     {\cf17 inline} {\cf17 const} T*     begin(){\cf17  const                       }\{ {\cf19 return} Data; \}\par
2162     {\cf17 inline} T*           end()                               \{ {\cf19 return} Data + Size; \}\par
2163     {\cf17 inline} {\cf17 const} T*     end(){\cf17  const                         }\{ {\cf19 return} Data + Size; \}\par
2164     {\cf17 inline} T&           front()                             \{ IM_ASSERT(Size > 0); {\cf19 return} Data[0]; \}\par
2165     {\cf17 inline} {\cf17 const} T&     front(){\cf17  const                       }\{ IM_ASSERT(Size > 0); {\cf19 return} Data[0]; \}\par
2166     {\cf17 inline} T&           back()                              \{ IM_ASSERT(Size > 0); {\cf19 return} Data[Size - 1]; \}\par
2167     {\cf17 inline} {\cf17 const} T&     back(){\cf17  const                        }\{ IM_ASSERT(Size > 0); {\cf19 return} Data[Size - 1]; \}\par
2168     {\cf17 inline} {\cf18 void}         swap(ImVector<T>& rhs)              \{ {\cf18 int} rhs_size = rhs.Size; rhs.Size = Size; Size = rhs_size; {\cf18 int} rhs_cap = rhs.Capacity; rhs.Capacity = Capacity; Capacity = rhs_cap; T* rhs_data = rhs.Data; rhs.Data = Data; Data = rhs_data; \}\par
2169 \par
2170     {\cf17 inline} {\cf18 int}          _grow_capacity({\cf18 int} sz){\cf17  const        }\{ {\cf18 int} new_capacity = Capacity ? (Capacity + Capacity / 2) : 8; {\cf19 return} new_capacity > sz ? new_capacity : sz; \}\par
2171     {\cf17 inline} {\cf18 void}         resize({\cf18 int} new_size)                \{ {\cf19 if} (new_size > Capacity) reserve(_grow_capacity(new_size)); Size = new_size; \}\par
2172     {\cf17 inline} {\cf18 void}         resize({\cf18 int} new_size, {\cf17 const} T& v)    \{ {\cf19 if} (new_size > Capacity) reserve(_grow_capacity(new_size)); {\cf19 if} (new_size > Size) {\cf19 for} ({\cf18 int} n = Size; n < new_size; n++) memcpy(&Data[n], &v, {\cf17 sizeof}(v)); Size = new_size; \}\par
2173     {\cf17 inline} {\cf18 void}         shrink({\cf18 int} new_size)                \{ IM_ASSERT(new_size <= Size); Size = new_size; \} {\cf20 // Resize a vector to a smaller size, guaranteed not to cause a reallocation}\par
2174     {\cf17 inline} {\cf18 void}         reserve({\cf18 int} new_capacity)           \{ {\cf19 if} (new_capacity <= Capacity) {\cf19 return}; T* new_data = (T*)IM_ALLOC(({\cf18 size_t})new_capacity * {\cf17 sizeof}(T)); {\cf19 if} (Data) \{ memcpy(new_data, Data, ({\cf18 size_t})Size * {\cf17 sizeof}(T)); IM_FREE(Data); \} Data = new_data; Capacity = new_capacity; \}\par
2175     {\cf17 inline} {\cf18 void}         reserve_discard({\cf18 int} new_capacity)   \{ {\cf19 if} (new_capacity <= Capacity) {\cf19 return}; {\cf19 if} (Data) IM_FREE(Data); Data = (T*)IM_ALLOC(({\cf18 size_t})new_capacity * {\cf17 sizeof}(T)); Capacity = new_capacity; \}\par
2176 \par
2177     {\cf20 // NB: It is illegal to call push_back/push_front/insert with a reference pointing inside the ImVector data itself! e.g. v.push_back(v[10]) is forbidden.}\par
2178     {\cf17 inline} {\cf18 void}         push_back({\cf17 const} T& v)               \{ {\cf19 if} (Size == Capacity) reserve(_grow_capacity(Size + 1)); memcpy(&Data[Size], &v, {\cf17 sizeof}(v)); Size++; \}\par
2179     {\cf17 inline} {\cf18 void}         pop_back()                          \{ IM_ASSERT(Size > 0); Size--; \}\par
2180     {\cf17 inline} {\cf18 void}         push_front({\cf17 const} T& v)              \{ {\cf19 if} (Size == 0) push_back(v); {\cf19 else} insert(Data, v); \}\par
2181     {\cf17 inline} T*           erase({\cf17 const} T* it)                  \{ IM_ASSERT(it >= Data && it < Data + Size); {\cf17 const} ptrdiff_t off = it - Data; memmove(Data + off, Data + off + 1, (({\cf18 size_t})Size - ({\cf18 size_t})off - 1) * {\cf17 sizeof}(T)); Size--; {\cf19 return} Data + off; \}\par
2182     {\cf17 inline} T*           erase({\cf17 const} T* it, {\cf17 const} T* it_last)\{ IM_ASSERT(it >= Data && it < Data + Size && it_last >= it && it_last <= Data + Size); {\cf17 const} ptrdiff_t count = it_last - it; {\cf17 const} ptrdiff_t off = it - Data; memmove(Data + off, Data + off + count, (({\cf18 size_t})Size - ({\cf18 size_t})off - ({\cf18 size_t})count) * {\cf17 sizeof}(T)); Size -= (int)count; {\cf19 return} Data + off; \}\par
2183     {\cf17 inline} T*           erase_unsorted({\cf17 const} T* it)         \{ IM_ASSERT(it >= Data && it < Data + Size);  {\cf17 const} ptrdiff_t off = it - Data; {\cf19 if} (it < Data + Size - 1) memcpy(Data + off, Data + Size - 1, {\cf17 sizeof}(T)); Size--; {\cf19 return} Data + off; \}\par
2184     {\cf17 inline} T*           insert({\cf17 const} T* it, {\cf17 const} T& v)     \{ IM_ASSERT(it >= Data && it <= Data + Size); {\cf17 const} ptrdiff_t off = it - Data; {\cf19 if} (Size == Capacity) reserve(_grow_capacity(Size + 1)); {\cf19 if} (off < ({\cf18 int})Size) memmove(Data + off + 1, Data + off, (({\cf18 size_t})Size - ({\cf18 size_t})off) * {\cf17 sizeof}(T)); memcpy(&Data[off], &v, {\cf17 sizeof}(v)); Size++; {\cf19 return} Data + off; \}\par
2185     {\cf17 inline} {\cf18 bool}         contains({\cf17 const} T& v){\cf17  const          }\{ {\cf17 const} T* data = Data;  {\cf17 const} T* data_end = Data + Size; {\cf19 while} (data < data_end) {\cf19 if} (*data++ == v) {\cf19 return} {\cf17 true}; {\cf19 return} {\cf17 false}; \}\par
2186     {\cf17 inline} T*           find({\cf17 const} T& v)                    \{ T* data = Data;  {\cf17 const} T* data_end = Data + Size; {\cf19 while} (data < data_end) {\cf19 if} (*data == v) {\cf19 break}; {\cf19 else} ++data; {\cf19 return} data; \}\par
2187     {\cf17 inline} {\cf17 const} T*     find({\cf17 const} T& v){\cf17  const              }\{ {\cf17 const} T* data = Data;  {\cf17 const} T* data_end = Data + Size; {\cf19 while} (data < data_end) {\cf19 if} (*data == v) {\cf19 break}; {\cf19 else} ++data; {\cf19 return} data; \}\par
2188     {\cf17 inline} {\cf18 int}          find_index({\cf17 const} T& v){\cf17  const        }\{ {\cf17 const} T* data_end = Data + Size; {\cf17 const} T* it = find(v); {\cf19 if} (it == data_end) {\cf19 return} -1; {\cf17 const} ptrdiff_t off = it - Data; {\cf19 return} ({\cf18 int})off; \}\par
2189     {\cf17 inline} {\cf18 bool}         find_erase({\cf17 const} T& v)              \{ {\cf17 const} T* it = find(v); {\cf19 if} (it < Data + Size) \{ erase(it); {\cf19 return} {\cf17 true}; \} {\cf19 return} {\cf17 false}; \}\par
2190     {\cf17 inline} {\cf18 bool}         find_erase_unsorted({\cf17 const} T& v)     \{ {\cf17 const} T* it = find(v); {\cf19 if} (it < Data + Size) \{ erase_unsorted(it); {\cf19 return} {\cf17 true}; \} {\cf19 return} {\cf17 false}; \}\par
2191     {\cf17 inline} {\cf18 int}          index_from_ptr({\cf17 const} T* it){\cf17  const   }\{ IM_ASSERT(it >= Data && it < Data + Size); {\cf17 const} ptrdiff_t off = it - Data; {\cf19 return} ({\cf18 int})off; \}\par
2192 \};\par
