3029 {\cf20 // Typically, 1 command = 1 GPU draw call (unless command is a callback)}\par
3030 {\cf20 // - VtxOffset: When 'io.BackendFlags & ImGuiBackendFlags_RendererHasVtxOffset' is enabled,}\par
3031 {\cf20 //   this fields allow us to render meshes larger than 64K vertices while keeping 16-bit indices.}\par
3032 {\cf20 //   Backends made for <1.71. will typically ignore the VtxOffset fields.}\par
3033 {\cf20 // - The ClipRect/TextureId/VtxOffset fields must be contiguous as we memcmp() them together (this is asserted for).}\par
3034 {\cf17 struct }ImDrawCmd\par
3035 \{\par
3036     ImVec4          ClipRect;           {\cf20 // 4*4  // Clipping rectangle (x1, y1, x2, y2). Subtract ImDrawData->DisplayPos to get clipping rectangle in "viewport" coordinates}\par
3037     ImTextureID     TextureId;          {\cf20 // 4-8  // User-provided texture ID. Set by user in ImfontAtlas::SetTexID() for fonts or passed to Image*() functions. Ignore if never using images or multiple fonts atlas.}\par
3038     {\cf18 unsigned} {\cf18 int}    VtxOffset;          {\cf20 // 4    // Start offset in vertex buffer. ImGuiBackendFlags_RendererHasVtxOffset: always 0, otherwise may be >0 to support meshes larger than 64K vertices with 16-bit indices.}\par
3039     {\cf18 unsigned} {\cf18 int}    IdxOffset;          {\cf20 // 4    // Start offset in index buffer.}\par
3040     {\cf18 unsigned} {\cf18 int}    ElemCount;          {\cf20 // 4    // Number of indices (multiple of 3) to be rendered as triangles. Vertices are stored in the callee ImDrawList's vtx_buffer[] array, indices in idx_buffer[].}\par
3041     ImDrawCallback  UserCallback;       {\cf20 // 4-8  // If != NULL, call the function instead of rendering the vertices. clip_rect and texture_id will be set normally.}\par
3042     {\cf18 void}*           UserCallbackData;   {\cf20 // 4-8  // The draw callback code can access this.}\par
3043 \par
3044     ImDrawCmd() \{ memset({\cf17 this}, 0, {\cf17 sizeof}(*{\cf17 this})); \} {\cf20 // Also ensure our padding fields are zeroed}\par
3045 \par
3046     {\cf20 // Since 1.83: returns ImTextureID associated with this draw call. Warning: DO NOT assume this is always same as 'TextureId' (we will change this function for an upcoming feature)}\par
