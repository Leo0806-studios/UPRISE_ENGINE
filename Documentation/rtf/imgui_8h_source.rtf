2952 {\cf20 // Optional helper to store multi-selection state + apply multi-selection requests.}\par
2953 {\cf20 // - Used by our demos and provided as a convenience to easily implement basic multi-selection.}\par
2954 {\cf20 // - Iterate selection with 'void* it = NULL; ImGuiID id; while (selection.GetNextSelectedItem(&it, &id)) \{ ... \}'}\par
2955 {\cf20 //   Or you can check 'if (Contains(id)) \{ ... \}' for each possible object if their number is not too high to iterate.}\par
2956 {\cf20 // - USING THIS IS NOT MANDATORY. This is only a helper and not a required API.}\par
2957 {\cf20 // To store a multi-selection, in your application you could:}\par
2958 {\cf20 // - Use this helper as a convenience. We use our simple key->value ImGuiStorage as a std::set<ImGuiID> replacement.}\par
2959 {\cf20 // - Use your own external storage: e.g. std::set<MyObjectId>, std::vector<MyObjectId>, interval trees, intrusively stored selection etc.}\par
2960 {\cf20 // In ImGuiSelectionBasicStorage we:}\par
2961 {\cf20 // - always use indices in the multi-selection API (passed to SetNextItemSelectionUserData(), retrieved in ImGuiMultiSelectIO)}\par
2962 {\cf20 // - use the AdapterIndexToStorageId() indirection layer to abstract how persistent selection data is derived from an index.}\par
2963 {\cf20 // - use decently optimized logic to allow queries and insertion of very large selection sets.}\par
2964 {\cf20 // - do not preserve selection order.}\par
2965 {\cf20 // Many combinations are possible depending on how you prefer to store your items and how you prefer to store your selection.}\par
2966 {\cf20 // Large applications are likely to eventually want to get rid of this indirection layer and do their own thing.}\par
2967 {\cf20 // See https://github.com/ocornut/imgui/wiki/Multi-Select for details and pseudo-code using this helper.}\par
2968 {\cf17 struct }ImGuiSelectionBasicStorage\par
2969 \{\par
2970     {\cf20 // Members}\par
2971     {\cf18 int}             Size;           {\cf20 //          // Number of selected items, maintained by this helper.}\par
2972     {\cf18 bool}            PreserveOrder;  {\cf20 // = false  // GetNextSelectedItem() will return ordered selection (currently implemented by two additional sorts of selection. Could be improved)}\par
2973     {\cf18 void}*           UserData;       {\cf20 // = NULL   // User data for use by adapter function        // e.g. selection.UserData = (void*)my_items;}\par
2974     ImGuiID         (*AdapterIndexToStorageId)(ImGuiSelectionBasicStorage* self, {\cf18 int} idx);      {\cf20 // e.g. selection.AdapterIndexToStorageId = [](ImGuiSelectionBasicStorage* self, int idx) \{ return ((MyItems**)self->UserData)[idx]->ID; \};}\par
2975     {\cf18 int}             _SelectionOrder;{\cf20 // [Internal] Increasing counter to store selection order}\par
2976     ImGuiStorage    _Storage;       {\cf20 // [Internal] Selection set. Think of this as similar to e.g. std::set<ImGuiID>. Prefer not accessing directly: iterate with GetNextSelectedItem().}\par
2977 \par
2978     {\cf20 // Methods}\par
2979     ImGuiSelectionBasicStorage();\par
2980     IMGUI_API {\cf18 void}  ApplyRequests(ImGuiMultiSelectIO* ms_io);   {\cf20 // Apply selection requests coming from BeginMultiSelect() and EndMultiSelect() functions. It uses 'items_count' passed to BeginMultiSelect()}\par
2981     IMGUI_API {\cf18 bool}  Contains(ImGuiID {\cf18 id}) {\cf17 const};                 {\cf20 // Query if an item id is in selection.}\par
2982     IMGUI_API {\cf18 void}  Clear();                                    {\cf20 // Clear selection}\par
2983     IMGUI_API {\cf18 void}  Swap(ImGuiSelectionBasicStorage& r);        {\cf20 // Swap two selections}\par
2984     IMGUI_API {\cf18 void}  SetItemSelected(ImGuiID {\cf18 id}, {\cf18 bool} selected); {\cf20 // Add/remove an item from selection (generally done by ApplyRequests() function)}\par
2985     IMGUI_API {\cf18 bool}  GetNextSelectedItem({\cf18 void}** opaque_it, ImGuiID* out_id); {\cf20 // Iterate selection with 'void* it = NULL; ImGuiId id; while (selection.GetNextSelectedItem(&it, &id)) \{ ... \}'}\par
2986     {\cf17 inline} ImGuiID  GetStorageIdFromIndex({\cf18 int} idx)              \{ {\cf19 return} AdapterIndexToStorageId({\cf17 this}, idx); \}  {\cf20 // Convert index to item id based on provided adapter.}\par
2987 \};\par
