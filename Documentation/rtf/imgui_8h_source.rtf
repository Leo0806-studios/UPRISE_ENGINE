372     {\cf20 // Child Windows}\par
373     {\cf20 // - Use child windows to begin into a self-contained independent scrolling/clipping regions within a host window. Child windows can embed their own child.}\par
374     {\cf20 // - Before 1.90 (November 2023), the "ImGuiChildFlags child_flags = 0" parameter was "bool border = false".}\par
375     {\cf20 //   This API is backward compatible with old code, as we guarantee that ImGuiChildFlags_Border == true.}\par
376     {\cf20 //   Consider updating your old code:}\par
377     {\cf20 //      BeginChild("Name", size, false)   -> Begin("Name", size, 0); or Begin("Name", size, ImGuiChildFlags_None);}\par
378     {\cf20 //      BeginChild("Name", size, true)    -> Begin("Name", size, ImGuiChildFlags_Border);}\par
379     {\cf20 // - Manual sizing (each axis can use a different setting e.g. ImVec2(0.0f, 400.0f)):}\par
380     {\cf20 //     == 0.0f: use remaining parent window size for this axis.}\par
381     {\cf20 //      > 0.0f: use specified size for this axis.}\par
382     {\cf20 //      < 0.0f: right/bottom-align to specified distance from available content boundaries.}\par
383     {\cf20 // - Specifying ImGuiChildFlags_AutoResizeX or ImGuiChildFlags_AutoResizeY makes the sizing automatic based on child contents.}\par
384     {\cf20 //   Combining both ImGuiChildFlags_AutoResizeX _and_ ImGuiChildFlags_AutoResizeY defeats purpose of a scrolling region and is NOT recommended.}\par
385     {\cf20 // - BeginChild() returns false to indicate the window is collapsed or fully clipped, so you may early out and omit submitting}\par
386     {\cf20 //   anything to the window. Always call a matching EndChild() for each BeginChild() call, regardless of its return value.}\par
387     {\cf20 //   [Important: due to legacy reason, Begin/End and BeginChild/EndChild are inconsistent with all other functions}\par
388     {\cf20 //    such as BeginMenu/EndMenu, BeginPopup/EndPopup, etc. where the EndXXX call should only be called if the corresponding}\par
389     {\cf20 //    BeginXXX function returned true. Begin and BeginChild are the only odd ones out. Will be fixed in a future update.]}\par
390     IMGUI_API {\cf18 bool}          BeginChild({\cf17 const} {\cf18 char}* str_id, {\cf17 const} ImVec2& size = ImVec2(0, 0), ImGuiChildFlags child_flags = 0, ImGuiWindowFlags window_flags = 0);\par
391     IMGUI_API {\cf18 bool}          BeginChild(ImGuiID {\cf18 id}, {\cf17 const} ImVec2& size = ImVec2(0, 0), ImGuiChildFlags child_flags = 0, ImGuiWindowFlags window_flags = 0);\par
