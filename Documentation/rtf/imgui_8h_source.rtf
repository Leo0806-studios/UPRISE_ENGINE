2855 {\cf20 // [SECTION] Multi-Select API flags and structures (ImGuiMultiSelectFlags, ImGuiSelectionRequestType, ImGuiSelectionRequest, ImGuiMultiSelectIO, ImGuiSelectionBasicStorage)}\par
2856 {\cf20 //-----------------------------------------------------------------------------}\par
2857 \par
2858 {\cf20 // Multi-selection system}\par
2859 {\cf20 // Documentation at: https://github.com/ocornut/imgui/wiki/Multi-Select}\par
2860 {\cf20 // - Refer to 'Demo->Widgets->Selection State & Multi-Select' for demos using this.}\par
2861 {\cf20 // - This system implements standard multi-selection idioms (CTRL+Mouse/Keyboard, SHIFT+Mouse/Keyboard, etc)}\par
2862 {\cf20 //   with support for clipper (skipping non-visible items), box-select and many other details.}\par
2863 {\cf20 // - Selectable(), Checkbox() are supported but custom widgets may use it as well.}\par
2864 {\cf20 // - TreeNode() is technically supported but... using this correctly is more complicated: you need some sort of linear/random access to your tree,}\par
2865 {\cf20 //   which is suited to advanced trees setups also implementing filters and clipper. We will work toward simplifying and demoing it.}\par
2866 {\cf20 // - In the spirit of Dear ImGui design, your code owns actual selection data.}\par
2867 {\cf20 //   This is designed to allow all kinds of selection storage you may use in your application e.g. set/map/hash.}\par
2868 {\cf20 // About ImGuiSelectionBasicStorage:}\par
2869 {\cf20 // - This is an optional helper to store a selection state and apply selection requests.}\par
2870 {\cf20 // - It is used by our demos and provided as a convenience to quickly implement multi-selection.}\par
2871 {\cf20 // Usage:}\par
2872 {\cf20 // - Identify submitted items with SetNextItemSelectionUserData(), most likely using an index into your current data-set.}\par
2873 {\cf20 // - Store and maintain actual selection data using persistent object identifiers.}\par
2874 {\cf20 // - Usage flow:}\par
2875 {\cf20 //     BEGIN - (1) Call BeginMultiSelect() and retrieve the ImGuiMultiSelectIO* result.}\par
2876 {\cf20 //           - (2) Honor request list (SetAll/SetRange requests) by updating your selection data. Same code as Step 6.}\par
2877 {\cf20 //           - (3) [If using clipper] You need to make sure RangeSrcItem is always submitted. Calculate its index and pass to clipper.IncludeItemByIndex(). If storing indices in ImGuiSelectionUserData, a simple clipper.IncludeItemByIndex(ms_io->RangeSrcItem) call will work.}\par
2878 {\cf20 //     LOOP  - (4) Submit your items with SetNextItemSelectionUserData() + Selectable()/TreeNode() calls.}\par
2879 {\cf20 //     END   - (5) Call EndMultiSelect() and retrieve the ImGuiMultiSelectIO* result.}\par
2880 {\cf20 //           - (6) Honor request list (SetAll/SetRange requests) by updating your selection data. Same code as Step 2.}\par
2881 {\cf20 //     If you submit all items (no clipper), Step 2 and 3 are optional and will be handled by each item themselves. It is fine to always honor those steps.}\par
2882 {\cf20 // About ImGuiSelectionUserData:}\par
2883 {\cf20 // - This can store an application-defined identifier (e.g. index or pointer) submitted via SetNextItemSelectionUserData().}\par
2884 {\cf20 // - In return we store them into RangeSrcItem/RangeFirstItem/RangeLastItem and other fields in ImGuiMultiSelectIO.}\par
2885 {\cf20 // - Most applications will store an object INDEX, hence the chosen name and type. Storing an index is natural, because}\par
2886 {\cf20 //   SetRange requests will give you two end-points and you will need to iterate/interpolate between them to update your selection.}\par
2887 {\cf20 // - However it is perfectly possible to store a POINTER or another IDENTIFIER inside ImGuiSelectionUserData.}\par
2888 {\cf20 //   Our system never assume that you identify items by indices, it never attempts to interpolate between two values.}\par
2889 {\cf20 // - If you enable ImGuiMultiSelectFlags_NoRangeSelect then it is guaranteed that you will never have to interpolate}\par
2890 {\cf20 //   between two ImGuiSelectionUserData, which may be a convenient way to use part of the feature with less code work.}\par
2891 {\cf20 // - As most users will want to store an index, for convenience and to reduce confusion we use ImS64 instead of void*,}\par
2892 {\cf20 //   being syntactically easier to downcast. Feel free to reinterpret_cast and store a pointer inside.}\par
2893 \par
2894 {\cf20 // Flags for BeginMultiSelect()}\par
2895 {\cf17 enum} ImGuiMultiSelectFlags_\par
2896 \{\par
2897     ImGuiMultiSelectFlags_None                  = 0,\par
2898     ImGuiMultiSelectFlags_SingleSelect          = 1 << 0,   {\cf20 // Disable selecting more than one item. This is available to allow single-selection code to share same code/logic if desired. It essentially disables the main purpose of BeginMultiSelect() tho!}\par
2899     ImGuiMultiSelectFlags_NoSelectAll           = 1 << 1,   {\cf20 // Disable CTRL+A shortcut to select all.}\par
2900     ImGuiMultiSelectFlags_NoRangeSelect         = 1 << 2,   {\cf20 // Disable Shift+selection mouse/keyboard support (useful for unordered 2D selection). With BoxSelect is also ensure contiguous SetRange requests are not combined into one. This allows not handling interpolation in SetRange requests.}\par
2901     ImGuiMultiSelectFlags_NoAutoSelect          = 1 << 3,   {\cf20 // Disable selecting items when navigating (useful for e.g. supporting range-select in a list of checkboxes).}\par
2902     ImGuiMultiSelectFlags_NoAutoClear           = 1 << 4,   {\cf20 // Disable clearing selection when navigating or selecting another one (generally used with ImGuiMultiSelectFlags_NoAutoSelect. useful for e.g. supporting range-select in a list of checkboxes).}\par
2903     ImGuiMultiSelectFlags_NoAutoClearOnReselect = 1 << 5,   {\cf20 // Disable clearing selection when clicking/selecting an already selected item.}\par
2904     ImGuiMultiSelectFlags_BoxSelect1d           = 1 << 6,   {\cf20 // Enable box-selection with same width and same x pos items (e.g. full row Selectable()). Box-selection works better with little bit of spacing between items hit-box in order to be able to aim at empty space.}\par
2905     ImGuiMultiSelectFlags_BoxSelect2d           = 1 << 7,   {\cf20 // Enable box-selection with varying width or varying x pos items support (e.g. different width labels, or 2D layout/grid). This is slower: alters clipping logic so that e.g. horizontal movements will update selection of normally clipped items.}\par
2906     ImGuiMultiSelectFlags_BoxSelectNoScroll     = 1 << 8,   {\cf20 // Disable scrolling when box-selecting near edges of scope.}\par
2907     ImGuiMultiSelectFlags_ClearOnEscape         = 1 << 9,   {\cf20 // Clear selection when pressing Escape while scope is focused.}\par
2908     ImGuiMultiSelectFlags_ClearOnClickVoid      = 1 << 10,  {\cf20 // Clear selection when clicking on empty location within scope.}\par
2909     ImGuiMultiSelectFlags_ScopeWindow           = 1 << 11,  {\cf20 // Scope for _BoxSelect and _ClearOnClickVoid is whole window (Default). Use if BeginMultiSelect() covers a whole window or used a single time in same window.}\par
2910     ImGuiMultiSelectFlags_ScopeRect             = 1 << 12,  {\cf20 // Scope for _BoxSelect and _ClearOnClickVoid is rectangle encompassing BeginMultiSelect()/EndMultiSelect(). Use if BeginMultiSelect() is called multiple times in same window.}\par
2911     ImGuiMultiSelectFlags_SelectOnClick         = 1 << 13,  {\cf20 // Apply selection on mouse down when clicking on unselected item. (Default)}\par
2912     ImGuiMultiSelectFlags_SelectOnClickRelease  = 1 << 14,  {\cf20 // Apply selection on mouse release when clicking an unselected item. Allow dragging an unselected item without altering selection.}\par
2913     {\cf20 //ImGuiMultiSelectFlags_RangeSelect2d       = 1 << 15,  // Shift+Selection uses 2d geometry instead of linear sequence, so possible to use Shift+up/down to select vertically in grid. Analogous to what BoxSelect does.}\par
2914     ImGuiMultiSelectFlags_NavWrapX              = 1 << 16,  {\cf20 // [Temporary] Enable navigation wrapping on X axis. Provided as a convenience because we don't have a design for the general Nav API for this yet. When the more general feature be public we may obsolete this flag in favor of new one.}\par
2915 \};\par
2916 \par
2917 {\cf20 // Main IO structure returned by BeginMultiSelect()/EndMultiSelect().}\par
2918 {\cf20 // This mainly contains a list of selection requests.}\par
2919 {\cf20 // - Use 'Demo->Tools->Debug Log->Selection' to see requests as they happen.}\par
2920 {\cf20 // - Some fields are only useful if your list is dynamic and allows deletion (getting post-deletion focus/state right is shown in the demo)}\par
2921 {\cf20 // - Below: who reads/writes each fields? 'r'=read, 'w'=write, 'ms'=multi-select code, 'app'=application/user code.}\par
2922 {\cf17 struct }ImGuiMultiSelectIO\par
2923 \{\par
2924     {\cf20 //------------------------------------------// BeginMultiSelect / EndMultiSelect}\par
2925     ImVector<ImGuiSelectionRequest> Requests;   {\cf20 //  ms:w, app:r     /  ms:w  app:r   // Requests to apply to your selection data.}\par
2926     ImGuiSelectionUserData      RangeSrcItem;   {\cf20 //  ms:w  app:r     /                // (If using clipper) Begin: Source item (often the first selected item) must never be clipped: use clipper.IncludeItemByIndex() to ensure it is submitted.}\par
2927     ImGuiSelectionUserData      NavIdItem;      {\cf20 //  ms:w, app:r     /                // (If using deletion) Last known SetNextItemSelectionUserData() value for NavId (if part of submitted items).}\par
