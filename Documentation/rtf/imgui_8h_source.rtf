2690     {\cf20 // [Internal]}\par
2691     ImVector<ImGuiStoragePair>      Data;\par
2692 \par
2693     {\cf20 // - Get***() functions find pair, never add/allocate. Pairs are sorted so a query is O(log N)}\par
2694     {\cf20 // - Set***() functions find pair, insertion on demand if missing.}\par
2695     {\cf20 // - Sorted insertion is costly, paid once. A typical frame shouldn't need to insert any new pair.}\par
2696     {\cf18 void}                Clear() \{ Data.clear(); \}\par
2697     IMGUI_API {\cf18 int}       GetInt(ImGuiID key, {\cf18 int} default_val = 0) {\cf17 const};\par
2698     IMGUI_API {\cf18 void}      SetInt(ImGuiID key, {\cf18 int} val);\par
2699     IMGUI_API {\cf18 bool}      GetBool(ImGuiID key, {\cf18 bool} default_val = {\cf17 false}) {\cf17 const};\par
