3622 {\cf20 //-----------------------------------------------------------------------------}\par
3623 {\cf20 // [SECTION] Platform Dependent Interfaces (for e.g. multi-viewport support)}\par
3624 {\cf20 //-----------------------------------------------------------------------------}\par
3625 {\cf20 // [BETA] (Optional) This is completely optional, for advanced users!}\par
3626 {\cf20 // If you are new to Dear ImGui and trying to integrate it into your engine, you can probably ignore this for now.}\par
3627 {\cf20 //}\par
3628 {\cf20 // This feature allows you to seamlessly drag Dear ImGui windows outside of your application viewport.}\par
3629 {\cf20 // This is achieved by creating new Platform/OS windows on the fly, and rendering into them.}\par
3630 {\cf20 // Dear ImGui manages the viewport structures, and the backend create and maintain one Platform/OS window for each of those viewports.}\par
3631 {\cf20 //}\par
3632 {\cf20 // See Glossary https://github.com/ocornut/imgui/wiki/Glossary for details about some of the terminology.}\par
3633 {\cf20 // See Thread https://github.com/ocornut/imgui/issues/1542 for gifs, news and questions about this evolving feature.}\par
3634 {\cf20 //}\par
3635 {\cf20 // About the coordinates system:}\par
3636 {\cf20 // - When multi-viewports are enabled, all Dear ImGui coordinates become absolute coordinates (same as OS coordinates!)}\par
3637 {\cf20 // - So e.g. ImGui::SetNextWindowPos(ImVec2(0,0)) will position a window relative to your primary monitor!}\par
3638 {\cf20 // - If you want to position windows relative to your main application viewport, use ImGui::GetMainViewport()->Pos as a base position.}\par
3639 {\cf20 //}\par
3640 {\cf20 // Steps to use multi-viewports in your application, when using a default backend from the examples/ folder:}\par
3641 {\cf20 // - Application:  Enable feature with 'io.ConfigFlags |= ImGuiConfigFlags_ViewportsEnable'.}\par
3642 {\cf20 // - Backend:      The backend initialization will setup all necessary ImGuiPlatformIO's functions and update monitors info every frame.}\par
3643 {\cf20 // - Application:  In your main loop, call ImGui::UpdatePlatformWindows(), ImGui::RenderPlatformWindowsDefault() after EndFrame() or Render().}\par
3644 {\cf20 // - Application:  Fix absolute coordinates used in ImGui::SetWindowPos() or ImGui::SetNextWindowPos() calls.}\par
3645 {\cf20 //}\par
3646 {\cf20 // Steps to use multi-viewports in your application, when using a custom backend:}\par
3647 {\cf20 // - Important:    THIS IS NOT EASY TO DO and comes with many subtleties not described here!}\par
3648 {\cf20 //                 It's also an experimental feature, so some of the requirements may evolve.}\par
3649 {\cf20 //                 Consider using default backends if you can. Either way, carefully follow and refer to examples/ backends for details.}\par
3650 {\cf20 // - Application:  Enable feature with 'io.ConfigFlags |= ImGuiConfigFlags_ViewportsEnable'.}\par
3651 {\cf20 // - Backend:      Hook ImGuiPlatformIO's Platform_* and Renderer_* callbacks (see below).}\par
3652 {\cf20 //                 Set 'io.BackendFlags |= ImGuiBackendFlags_PlatformHasViewports' and 'io.BackendFlags |= ImGuiBackendFlags_PlatformHasViewports'.}\par
3653 {\cf20 //                 Update ImGuiPlatformIO's Monitors list every frame.}\par
3654 {\cf20 //                 Update MousePos every frame, in absolute coordinates.}\par
3655 {\cf20 // - Application:  In your main loop, call ImGui::UpdatePlatformWindows(), ImGui::RenderPlatformWindowsDefault() after EndFrame() or Render().}\par
3656 {\cf20 //                 You may skip calling RenderPlatformWindowsDefault() if its API is not convenient for your needs. Read comments below.}\par
3657 {\cf20 // - Application:  Fix absolute coordinates used in ImGui::SetWindowPos() or ImGui::SetNextWindowPos() calls.}\par
3658 {\cf20 //}\par
3659 {\cf20 // About ImGui::RenderPlatformWindowsDefault():}\par
3660 {\cf20 // - This function is a mostly a _helper_ for the common-most cases, and to facilitate using default backends.}\par
3661 {\cf20 // - You can check its simple source code to understand what it does.}\par
3662 {\cf20 //   It basically iterates secondary viewports and call 4 functions that are setup in ImGuiPlatformIO, if available:}\par
3663 {\cf20 //     Platform_RenderWindow(), Renderer_RenderWindow(), Platform_SwapBuffers(), Renderer_SwapBuffers()}\par
3664 {\cf20 //   Those functions pointers exists only for the benefit of RenderPlatformWindowsDefault().}\par
3665 {\cf20 // - If you have very specific rendering needs (e.g. flipping multiple swap-chain simultaneously, unusual sync/threading issues, etc.),}\par
3666 {\cf20 //   you may be tempted to ignore RenderPlatformWindowsDefault() and write customized code to perform your renderingg.}\par
3667 {\cf20 //   You may decide to setup the platform_io's *RenderWindow and *SwapBuffers pointers and call your functions through those pointers,}\par
3668 {\cf20 //   or you may decide to never setup those pointers and call your code directly. They are a convenience, not an obligatory interface.}\par
3669 {\cf20 //-----------------------------------------------------------------------------}\par
3670 \par
3671 {\cf20 // (Optional) Access via ImGui::GetPlatformIO()}\par
3672 {\cf17 struct }ImGuiPlatformIO\par
3673 \{\par
3674     {\cf20 //------------------------------------------------------------------}\par
3675     {\cf20 // Input - Backend interface/functions + Monitor List}\par
3676     {\cf20 //------------------------------------------------------------------}\par
3677 \par
3678     {\cf20 // (Optional) Platform functions (e.g. Win32, GLFW, SDL2)}\par
3679     {\cf20 // For reference, the second column shows which function are generally calling the Platform Functions:}\par
3680     {\cf20 //   N = ImGui::NewFrame()                        ~ beginning of the dear imgui frame: read info from platform/OS windows (latest size/position)}\par
3681     {\cf20 //   F = ImGui::Begin(), ImGui::EndFrame()        ~ during the dear imgui frame}\par
3682     {\cf20 //   U = ImGui::UpdatePlatformWindows()           ~ after the dear imgui frame: create and update all platform/OS windows}\par
3683     {\cf20 //   R = ImGui::RenderPlatformWindowsDefault()    ~ render}\par
3684     {\cf20 //   D = ImGui::DestroyPlatformWindows()          ~ shutdown}\par
3685     {\cf20 // The general idea is that NewFrame() we will read the current Platform/OS state, and UpdatePlatformWindows() will write to it.}\par
3686     {\cf20 //}\par
3687     {\cf20 // The functions are designed so we can mix and match 2 imgui_impl_xxxx files, one for the Platform (~window/input handling), one for Renderer.}\par
3688     {\cf20 // Custom engine backends will often provide both Platform and Renderer interfaces and so may not need to use all functions.}\par
3689     {\cf20 // Platform functions are typically called before their Renderer counterpart, apart from Destroy which are called the other way.}\par
3690 \par
3691     {\cf20 // Platform function --------------------------------------------------- Called by -----}\par
3692     void    (*Platform_CreateWindow)(ImGuiViewport* vp);                    {\cf20 // . . U . .  // Create a new platform window for the given viewport}\par
3693     void    (*Platform_DestroyWindow)(ImGuiViewport* vp);                   {\cf20 // N . U . D  //}\par
3694     void    (*Platform_ShowWindow)(ImGuiViewport* vp);                      {\cf20 // . . U . .  // Newly created windows are initially hidden so SetWindowPos/Size/Title can be called on them before showing the window}\par
3695     void    (*Platform_SetWindowPos)(ImGuiViewport* vp, ImVec2 pos);        {\cf20 // . . U . .  // Set platform window position (given the upper-left corner of client area)}\par
3696     ImVec2  (*Platform_GetWindowPos)(ImGuiViewport* vp);                    {\cf20 // N . . . .  //}\par
3697     void    (*Platform_SetWindowSize)(ImGuiViewport* vp, ImVec2 size);      {\cf20 // . . U . .  // Set platform window client area size (ignoring OS decorations such as OS title bar etc.)}\par
3698     ImVec2  (*Platform_GetWindowSize)(ImGuiViewport* vp);                   {\cf20 // N . . . .  // Get platform window client area size}\par
3699     void    (*Platform_SetWindowFocus)(ImGuiViewport* vp);                  {\cf20 // N . . . .  // Move window to front and set input focus}\par
3700     bool    (*Platform_GetWindowFocus)(ImGuiViewport* vp);                  {\cf20 // . . U . .  //}\par
3701     bool    (*Platform_GetWindowMinimized)(ImGuiViewport* vp);              {\cf20 // N . . . .  // Get platform window minimized state. When minimized, we generally won't attempt to get/set size and contents will be culled more easily}\par
3702     void    (*Platform_SetWindowTitle)(ImGuiViewport* vp, {\cf17 const} {\cf18 char}* str); {\cf20 // . . U . .  // Set platform window title (given an UTF-8 string)}\par
3703     void    (*Platform_SetWindowAlpha)(ImGuiViewport* vp, {\cf18 float} alpha);     {\cf20 // . . U . .  // (Optional) Setup global transparency (not per-pixel transparency)}\par
3704     void    (*Platform_UpdateWindow)(ImGuiViewport* vp);                    {\cf20 // . . U . .  // (Optional) Called by UpdatePlatformWindows(). Optional hook to allow the platform backend from doing general book-keeping every frame.}\par
3705     void    (*Platform_RenderWindow)(ImGuiViewport* vp, {\cf18 void}* render_arg);  {\cf20 // . . . R .  // (Optional) Main rendering (platform side! This is often unused, or just setting a "current" context for OpenGL bindings). 'render_arg' is the value passed to RenderPlatformWindowsDefault().}\par
3706     void    (*Platform_SwapBuffers)(ImGuiViewport* vp, {\cf18 void}* render_arg);   {\cf20 // . . . R .  // (Optional) Call Present/SwapBuffers (platform side! This is often unused!). 'render_arg' is the value passed to RenderPlatformWindowsDefault().}\par
3707     float   (*Platform_GetWindowDpiScale)(ImGuiViewport* vp);               {\cf20 // N . . . .  // (Optional) [BETA] FIXME-DPI: DPI handling: Return DPI scale for this viewport. 1.0f = 96 DPI.}\par
3708     void    (*Platform_OnChangedViewport)(ImGuiViewport* vp);               {\cf20 // . F . . .  // (Optional) [BETA] FIXME-DPI: DPI handling: Called during Begin() every time the viewport we are outputting into changes, so backend has a chance to swap fonts to adjust style.}\par
3709     ImVec4  (*Platform_GetWindowWorkAreaInsets)(ImGuiViewport* vp);         {\cf20 // N . . . .  // (Optional) [BETA] Get initial work area inset for the viewport (won't be covered by main menu bar, dockspace over viewport etc.). Default to (0,0),(0,0). 'safeAreaInsets' in iOS land, 'DisplayCutout' in Android land.}\par
3710     int     (*Platform_CreateVkSurface)(ImGuiViewport* vp, ImU64 vk_inst, {\cf17 const} {\cf18 void}* vk_allocators, ImU64* out_vk_surface); {\cf20 // (Optional) For a Vulkan Renderer to call into Platform code (since the surface creation needs to tie them both).}\par
3711 \par
3712     {\cf20 // (Optional) Renderer functions (e.g. DirectX, OpenGL, Vulkan)}\par
3713     void    (*Renderer_CreateWindow)(ImGuiViewport* vp);                    {\cf20 // . . U . .  // Create swap chain, frame buffers etc. (called after Platform_CreateWindow)}\par
3714     void    (*Renderer_DestroyWindow)(ImGuiViewport* vp);                   {\cf20 // N . U . D  // Destroy swap chain, frame buffers etc. (called before Platform_DestroyWindow)}\par
3715     void    (*Renderer_SetWindowSize)(ImGuiViewport* vp, ImVec2 size);      {\cf20 // . . U . .  // Resize swap chain, frame buffers etc. (called after Platform_SetWindowSize)}\par
3716     void    (*Renderer_RenderWindow)(ImGuiViewport* vp, {\cf18 void}* render_arg);  {\cf20 // . . . R .  // (Optional) Clear framebuffer, setup render target, then render the viewport->DrawData. 'render_arg' is the value passed to RenderPlatformWindowsDefault().}\par
3717     void    (*Renderer_SwapBuffers)(ImGuiViewport* vp, {\cf18 void}* render_arg);   {\cf20 // . . . R .  // (Optional) Call Present/SwapBuffers. 'render_arg' is the value passed to RenderPlatformWindowsDefault().}\par
3718 \par
