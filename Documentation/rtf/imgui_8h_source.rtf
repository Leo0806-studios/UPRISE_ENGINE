357     {\cf20 // Windows}\par
358     {\cf20 // - Begin() = push window to the stack and start appending to it. End() = pop window from the stack.}\par
359     {\cf20 // - Passing 'bool* p_open != NULL' shows a window-closing widget in the upper-right corner of the window,}\par
360     {\cf20 //   which clicking will set the boolean to false when clicked.}\par
361     {\cf20 // - You may append multiple times to the same window during the same frame by calling Begin()/End() pairs multiple times.}\par
362     {\cf20 //   Some information such as 'flags' or 'p_open' will only be considered by the first call to Begin().}\par
363     {\cf20 // - Begin() return false to indicate the window is collapsed or fully clipped, so you may early out and omit submitting}\par
364     {\cf20 //   anything to the window. Always call a matching End() for each Begin() call, regardless of its return value!}\par
365     {\cf20 //   [Important: due to legacy reason, Begin/End and BeginChild/EndChild are inconsistent with all other functions}\par
366     {\cf20 //    such as BeginMenu/EndMenu, BeginPopup/EndPopup, etc. where the EndXXX call should only be called if the corresponding}\par
367     {\cf20 //    BeginXXX function returned true. Begin and BeginChild are the only odd ones out. Will be fixed in a future update.]}\par
368     {\cf20 // - Note that the bottom of window stack always contains a window called "Debug".}\par
369     IMGUI_API {\cf18 bool}          Begin({\cf17 const} {\cf18 char}* name, {\cf18 bool}* p_open = NULL, ImGuiWindowFlags flags = 0);\par
370     IMGUI_API {\cf18 void}          End();\par
