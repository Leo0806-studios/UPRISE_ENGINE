510     {\cf20 // ID stack/scopes}\par
511     {\cf20 // Read the FAQ (docs/FAQ.md or http://dearimgui.com/faq) for more details about how ID are handled in dear imgui.}\par
512     {\cf20 // - Those questions are answered and impacted by understanding of the ID stack system:}\par
513     {\cf20 //   - "Q: Why is my widget not reacting when I click on it?"}\par
514     {\cf20 //   - "Q: How can I have widgets with an empty label?"}\par
515     {\cf20 //   - "Q: How can I have multiple widgets with the same label?"}\par
516     {\cf20 // - Short version: ID are hashes of the entire ID stack. If you are creating widgets in a loop you most likely}\par
517     {\cf20 //   want to push a unique identifier (e.g. object pointer, loop index) to uniquely differentiate them.}\par
518     {\cf20 // - You can also use the "Label##foobar" syntax within widget label to distinguish them from each others.}\par
519     {\cf20 // - In this header file we use the "label"/"name" terminology to denote a string that will be displayed + used as an ID,}\par
520     {\cf20 //   whereas "str_id" denote a string that is only used as an ID and not normally displayed.}\par
521     IMGUI_API {\cf18 void}          PushID({\cf17 const} {\cf18 char}* str_id);                                     {\cf20 // push string into the ID stack (will hash string).}\par
522     IMGUI_API {\cf18 void}          PushID({\cf17 const} {\cf18 char}* str_id_begin, {\cf17 const} {\cf18 char}* str_id_end);       {\cf20 // push string into the ID stack (will hash string).}\par
523     IMGUI_API {\cf18 void}          PushID({\cf17 const} {\cf18 void}* ptr_id);                                     {\cf20 // push pointer into the ID stack (will hash pointer).}\par
524     IMGUI_API {\cf18 void}          PushID({\cf18 int} int_id);                                             {\cf20 // push integer into the ID stack (will hash integer).}\par
525     IMGUI_API {\cf18 void}          PopID();                                                        {\cf20 // pop from the ID stack.}\par
526     IMGUI_API ImGuiID       GetID({\cf17 const} {\cf18 char}* str_id);                                      {\cf20 // calculate unique ID (hash of whole ID stack + given parameter). e.g. if you want to query into ImGuiStorage yourself}\par
527     IMGUI_API ImGuiID       GetID({\cf17 const} {\cf18 char}* str_id_begin, {\cf17 const} {\cf18 char}* str_id_end);\par
528     IMGUI_API ImGuiID       GetID({\cf17 const} {\cf18 void}* ptr_id);\par
529     IMGUI_API ImGuiID       GetID({\cf18 int} int_id);\par
