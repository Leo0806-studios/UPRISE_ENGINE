1929 {\cf20 // Flags for ImGui::BeginTable()}\par
1930 {\cf20 // - Important! Sizing policies have complex and subtle side effects, much more so than you would expect.}\par
1931 {\cf20 //   Read comments/demos carefully + experiment with live demos to get acquainted with them.}\par
1932 {\cf20 // - The DEFAULT sizing policies are:}\par
1933 {\cf20 //    - Default to ImGuiTableFlags_SizingFixedFit    if ScrollX is on, or if host window has ImGuiWindowFlags_AlwaysAutoResize.}\par
1934 {\cf20 //    - Default to ImGuiTableFlags_SizingStretchSame if ScrollX is off.}\par
1935 {\cf20 // - When ScrollX is off:}\par
1936 {\cf20 //    - Table defaults to ImGuiTableFlags_SizingStretchSame -> all Columns defaults to ImGuiTableColumnFlags_WidthStretch with same weight.}\par
1937 {\cf20 //    - Columns sizing policy allowed: Stretch (default), Fixed/Auto.}\par
1938 {\cf20 //    - Fixed Columns (if any) will generally obtain their requested width (unless the table cannot fit them all).}\par
1939 {\cf20 //    - Stretch Columns will share the remaining width according to their respective weight.}\par
1940 {\cf20 //    - Mixed Fixed/Stretch columns is possible but has various side-effects on resizing behaviors.}\par
1941 {\cf20 //      The typical use of mixing sizing policies is: any number of LEADING Fixed columns, followed by one or two TRAILING Stretch columns.}\par
1942 {\cf20 //      (this is because the visible order of columns have subtle but necessary effects on how they react to manual resizing).}\par
1943 {\cf20 // - When ScrollX is on:}\par
1944 {\cf20 //    - Table defaults to ImGuiTableFlags_SizingFixedFit -> all Columns defaults to ImGuiTableColumnFlags_WidthFixed}\par
1945 {\cf20 //    - Columns sizing policy allowed: Fixed/Auto mostly.}\par
1946 {\cf20 //    - Fixed Columns can be enlarged as needed. Table will show a horizontal scrollbar if needed.}\par
1947 {\cf20 //    - When using auto-resizing (non-resizable) fixed columns, querying the content width to use item right-alignment e.g. SetNextItemWidth(-FLT_MIN) doesn't make sense, would create a feedback loop.}\par
1948 {\cf20 //    - Using Stretch columns OFTEN DOES NOT MAKE SENSE if ScrollX is on, UNLESS you have specified a value for 'inner_width' in BeginTable().}\par
1949 {\cf20 //      If you specify a value for 'inner_width' then effectively the scrolling space is known and Stretch or mixed Fixed/Stretch columns become meaningful again.}\par
1950 {\cf20 // - Read on documentation at the top of imgui_tables.cpp for details.}\par
1951 {\cf17 enum} ImGuiTableFlags_\par
1952 \{\par
1953     {\cf20 // Features}\par
1954     ImGuiTableFlags_None                       = 0,\par
1955     ImGuiTableFlags_Resizable                  = 1 << 0,   {\cf20 // Enable resizing columns.}\par
1956     ImGuiTableFlags_Reorderable                = 1 << 1,   {\cf20 // Enable reordering columns in header row (need calling TableSetupColumn() + TableHeadersRow() to display headers)}\par
1957     ImGuiTableFlags_Hideable                   = 1 << 2,   {\cf20 // Enable hiding/disabling columns in context menu.}\par
1958     ImGuiTableFlags_Sortable                   = 1 << 3,   {\cf20 // Enable sorting. Call TableGetSortSpecs() to obtain sort specs. Also see ImGuiTableFlags_SortMulti and ImGuiTableFlags_SortTristate.}\par
1959     ImGuiTableFlags_NoSavedSettings            = 1 << 4,   {\cf20 // Disable persisting columns order, width and sort settings in the .ini file.}\par
1960     ImGuiTableFlags_ContextMenuInBody          = 1 << 5,   {\cf20 // Right-click on columns body/contents will display table context menu. By default it is available in TableHeadersRow().}\par
1961     {\cf20 // Decorations}\par
1962     ImGuiTableFlags_RowBg                      = 1 << 6,   {\cf20 // Set each RowBg color with ImGuiCol_TableRowBg or ImGuiCol_TableRowBgAlt (equivalent of calling TableSetBgColor with ImGuiTableBgFlags_RowBg0 on each row manually)}\par
1963     ImGuiTableFlags_BordersInnerH              = 1 << 7,   {\cf20 // Draw horizontal borders between rows.}\par
1964     ImGuiTableFlags_BordersOuterH              = 1 << 8,   {\cf20 // Draw horizontal borders at the top and bottom.}\par
1965     ImGuiTableFlags_BordersInnerV              = 1 << 9,   {\cf20 // Draw vertical borders between columns.}\par
1966     ImGuiTableFlags_BordersOuterV              = 1 << 10,  {\cf20 // Draw vertical borders on the left and right sides.}\par
1967     ImGuiTableFlags_BordersH                   = ImGuiTableFlags_BordersInnerH | ImGuiTableFlags_BordersOuterH, {\cf20 // Draw horizontal borders.}\par
1968     ImGuiTableFlags_BordersV                   = ImGuiTableFlags_BordersInnerV | ImGuiTableFlags_BordersOuterV, {\cf20 // Draw vertical borders.}\par
1969     ImGuiTableFlags_BordersInner               = ImGuiTableFlags_BordersInnerV | ImGuiTableFlags_BordersInnerH, {\cf20 // Draw inner borders.}\par
1970     ImGuiTableFlags_BordersOuter               = ImGuiTableFlags_BordersOuterV | ImGuiTableFlags_BordersOuterH, {\cf20 // Draw outer borders.}\par
1971     ImGuiTableFlags_Borders                    = ImGuiTableFlags_BordersInner | ImGuiTableFlags_BordersOuter,   {\cf20 // Draw all borders.}\par
1972     ImGuiTableFlags_NoBordersInBody            = 1 << 11,  {\cf20 // [ALPHA] Disable vertical borders in columns Body (borders will always appear in Headers). -> May move to style}\par
1973     ImGuiTableFlags_NoBordersInBodyUntilResize = 1 << 12,  {\cf20 // [ALPHA] Disable vertical borders in columns Body until hovered for resize (borders will always appear in Headers). -> May move to style}\par
1974     {\cf20 // Sizing Policy (read above for defaults)}\par
1975     ImGuiTableFlags_SizingFixedFit             = 1 << 13,  {\cf20 // Columns default to _WidthFixed or _WidthAuto (if resizable or not resizable), matching contents width.}\par
1976     ImGuiTableFlags_SizingFixedSame            = 2 << 13,  {\cf20 // Columns default to _WidthFixed or _WidthAuto (if resizable or not resizable), matching the maximum contents width of all columns. Implicitly enable ImGuiTableFlags_NoKeepColumnsVisible.}\par
1977     ImGuiTableFlags_SizingStretchProp          = 3 << 13,  {\cf20 // Columns default to _WidthStretch with default weights proportional to each columns contents widths.}\par
1978     ImGuiTableFlags_SizingStretchSame          = 4 << 13,  {\cf20 // Columns default to _WidthStretch with default weights all equal, unless overridden by TableSetupColumn().}\par
1979     {\cf20 // Sizing Extra Options}\par
1980     ImGuiTableFlags_NoHostExtendX              = 1 << 16,  {\cf20 // Make outer width auto-fit to columns, overriding outer_size.x value. Only available when ScrollX/ScrollY are disabled and Stretch columns are not used.}\par
1981     ImGuiTableFlags_NoHostExtendY              = 1 << 17,  {\cf20 // Make outer height stop exactly at outer_size.y (prevent auto-extending table past the limit). Only available when ScrollX/ScrollY are disabled. Data below the limit will be clipped and not visible.}\par
1982     ImGuiTableFlags_NoKeepColumnsVisible       = 1 << 18,  {\cf20 // Disable keeping column always minimally visible when ScrollX is off and table gets too small. Not recommended if columns are resizable.}\par
1983     ImGuiTableFlags_PreciseWidths              = 1 << 19,  {\cf20 // Disable distributing remainder width to stretched columns (width allocation on a 100-wide table with 3 columns: Without this flag: 33,33,34. With this flag: 33,33,33). With larger number of columns, resizing will appear to be less smooth.}\par
1984     {\cf20 // Clipping}\par
1985     ImGuiTableFlags_NoClip                     = 1 << 20,  {\cf20 // Disable clipping rectangle for every individual columns (reduce draw command count, items will be able to overflow into other columns). Generally incompatible with TableSetupScrollFreeze().}\par
1986     {\cf20 // Padding}\par
1987     ImGuiTableFlags_PadOuterX                  = 1 << 21,  {\cf20 // Default if BordersOuterV is on. Enable outermost padding. Generally desirable if you have headers.}\par
1988     ImGuiTableFlags_NoPadOuterX                = 1 << 22,  {\cf20 // Default if BordersOuterV is off. Disable outermost padding.}\par
1989     ImGuiTableFlags_NoPadInnerX                = 1 << 23,  {\cf20 // Disable inner padding between columns (double inner padding if BordersOuterV is on, single inner padding if BordersOuterV is off).}\par
1990     {\cf20 // Scrolling}\par
1991     ImGuiTableFlags_ScrollX                    = 1 << 24,  {\cf20 // Enable horizontal scrolling. Require 'outer_size' parameter of BeginTable() to specify the container size. Changes default sizing policy. Because this creates a child window, ScrollY is currently generally recommended when using ScrollX.}\par
1992     ImGuiTableFlags_ScrollY                    = 1 << 25,  {\cf20 // Enable vertical scrolling. Require 'outer_size' parameter of BeginTable() to specify the container size.}\par
1993     {\cf20 // Sorting}\par
1994     ImGuiTableFlags_SortMulti                  = 1 << 26,  {\cf20 // Hold shift when clicking headers to sort on multiple column. TableGetSortSpecs() may return specs where (SpecsCount > 1).}\par
1995     ImGuiTableFlags_SortTristate               = 1 << 27,  {\cf20 // Allow no sorting, disable default sorting. TableGetSortSpecs() may return specs where (SpecsCount == 0).}\par
1996     {\cf20 // Miscellaneous}\par
1997     ImGuiTableFlags_HighlightHoveredColumn     = 1 << 28,  {\cf20 // Highlight column headers when hovered (may evolve into a fuller highlight)}\par
1998 \par
1999     {\cf20 // [Internal] Combinations and masks}\par
2000     ImGuiTableFlags_SizingMask_                = ImGuiTableFlags_SizingFixedFit | ImGuiTableFlags_SizingFixedSame | ImGuiTableFlags_SizingStretchProp | ImGuiTableFlags_SizingStretchSame,\par
2001 \};\par
