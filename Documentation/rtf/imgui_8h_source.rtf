2104 {\cf20 // IM_MALLOC(), IM_FREE(), IM_NEW(), IM_PLACEMENT_NEW(), IM_DELETE()}\par
2105 {\cf20 // We call C++ constructor on own allocated memory via the placement "new(ptr) Type()" syntax.}\par
2106 {\cf20 // Defining a custom placement new() with a custom parameter allows us to bypass including <new> which on some platforms complains when user has disabled exceptions.}\par
2107 {\cf20 //-----------------------------------------------------------------------------}\par
2108 \par
2109 {\cf17 struct }ImNewWrapper \{\};\par
2110 {\cf17 inline} {\cf18 void}* {\cf17 operator} {\cf17 new}(size_t, ImNewWrapper, {\cf18 void}* ptr) \{ {\cf19 return} ptr; \}\par
2111 {\cf17 inline} {\cf18 void}  {\cf17 operator} {\cf17 delete}({\cf18 void}*, ImNewWrapper, {\cf18 void}*)   \{\} {\cf20 // This is only required so we can use the symmetrical new()}\par
2112 {\cf21 #define IM_ALLOC(_SIZE)                     ImGui::MemAlloc(_SIZE)}\par
2113 {\cf21 #define IM_FREE(_PTR)                       ImGui::MemFree(_PTR)}\par
2114 {\cf21 #define IM_PLACEMENT_NEW(_PTR)              new(ImNewWrapper(), _PTR)}\par
2115 {\cf21 #define IM_NEW(_TYPE)                       new(ImNewWrapper(), ImGui::MemAlloc(sizeof(_TYPE))) _TYPE}\par
2116 {\cf17 template}<{\cf17 typename} T> {\cf18 void} IM_DELETE(T* p)   \{ {\cf19 if} (p) \{ p->~T(); ImGui::MemFree(p); \} \}\par
