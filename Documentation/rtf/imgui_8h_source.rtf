3343 {\cf20 // Helper to build glyph ranges from text/string data. Feed your application strings/characters to it then call BuildRanges().}\par
3344 {\cf20 // This is essentially a tightly packed of vector of 64k booleans = 8KB storage.}\par
3345 {\cf17 struct }ImFontGlyphRangesBuilder\par
3346 \{\par
3347     ImVector<ImU32> UsedChars;            {\cf20 // Store 1-bit per Unicode code point (0=unused, 1=used)}\par
3348 \par
3349     ImFontGlyphRangesBuilder()              \{ Clear(); \}\par
3350     {\cf17 inline} {\cf18 void}     Clear()                 \{ {\cf18 int} size_in_bytes = (IM_UNICODE_CODEPOINT_MAX + 1) / 8; UsedChars.resize(size_in_bytes / ({\cf18 int}){\cf17 sizeof}(ImU32)); memset(UsedChars.Data, 0, ({\cf18 size_t})size_in_bytes); \}\par
3351     {\cf17 inline} {\cf18 bool}     GetBit({\cf18 size_t} n){\cf17  const  }\{ {\cf18 int} off = (int)(n >> 5); ImU32 mask = 1u << (n & 31); {\cf19 return} (UsedChars[off] & mask) != 0; \}  {\cf20 // Get bit n in the array}\par
3352     {\cf17 inline} {\cf18 void}     SetBit({\cf18 size_t} n)        \{ {\cf18 int} off = (int)(n >> 5); ImU32 mask = 1u << (n & 31); UsedChars[off] |= mask; \}               {\cf20 // Set bit n in the array}\par
3353     {\cf17 inline} {\cf18 void}     AddChar(ImWchar c)      \{ SetBit(c); \}                      {\cf20 // Add character}\par
