3012 {\cf20 // ImDrawCallback: Draw callbacks for advanced uses [configurable type: override in imconfig.h]}\par
3013 {\cf20 // NB: You most likely do NOT need to use draw callbacks just to create your own widget or customized UI rendering,}\par
3014 {\cf20 // you can poke into the draw list for that! Draw callback may be useful for example to:}\par
3015 {\cf20 //  A) Change your GPU render state,}\par
3016 {\cf20 //  B) render a complex 3D scene inside a UI element without an intermediate texture/render target, etc.}\par
3017 {\cf20 // The expected behavior from your rendering function is 'if (cmd.UserCallback != NULL) \{ cmd.UserCallback(parent_list, cmd); \} else \{ RenderTriangles() \}'}\par
3018 {\cf20 // If you want to override the signature of ImDrawCallback, you can simply use e.g. '#define ImDrawCallback MyDrawCallback' (in imconfig.h) + update rendering backend accordingly.}\par
3019 {\cf21 #ifndef ImDrawCallback}\par
3020 {\cf17 typedef} void (*ImDrawCallback)({\cf17 const} ImDrawList* parent_list, {\cf17 const} ImDrawCmd* cmd);\par
3021 {\cf21 #endif}\par
