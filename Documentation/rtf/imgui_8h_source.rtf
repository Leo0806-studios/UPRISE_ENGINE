3130 {\cf20 // Draw command list}\par
3131 {\cf20 // This is the low-level list of polygons that ImGui:: functions are filling. At the end of the frame,}\par
3132 {\cf20 // all command lists are passed to your ImGuiIO::RenderDrawListFn function for rendering.}\par
3133 {\cf20 // Each dear imgui window contains its own ImDrawList. You can use ImGui::GetWindowDrawList() to}\par
3134 {\cf20 // access the current window draw list and draw custom primitives.}\par
3135 {\cf20 // You can interleave normal ImGui:: calls and adding primitives to the current draw list.}\par
3136 {\cf20 // In single viewport mode, top-left is == GetMainViewport()->Pos (generally 0,0), bottom-right is == GetMainViewport()->Pos+Size (generally io.DisplaySize).}\par
3137 {\cf20 // You are totally free to apply whatever transformation matrix to want to the data (depending on the use of the transformation you may want to apply it to ClipRect as well!)}\par
3138 {\cf20 // Important: Primitives are always added to the list and not culled (culling is done at higher-level by ImGui:: functions), if you use this API a lot consider coarse culling your drawn objects.}\par
3139 {\cf17 struct }ImDrawList\par
3140 \{\par
3141     {\cf20 // This is what you have to render}\par
3142     ImVector<ImDrawCmd>     CmdBuffer;          {\cf20 // Draw commands. Typically 1 command = 1 GPU draw call, unless the command is a callback.}\par
3143     ImVector<ImDrawIdx>     IdxBuffer;          {\cf20 // Index buffer. Each command consume ImDrawCmd::ElemCount of those}\par
3144     ImVector<ImDrawVert>    VtxBuffer;          {\cf20 // Vertex buffer.}\par
3145     ImDrawListFlags         Flags;              {\cf20 // Flags, you may poke into these to adjust anti-aliasing settings per-primitive.}\par
3146 \par
3147     {\cf20 // [Internal, used while building lists]}\par
3148     {\cf18 unsigned} {\cf18 int}            _VtxCurrentIdx;     {\cf20 // [Internal] generally == VtxBuffer.Size unless we are past 64K vertices, in which case this gets reset to 0.}\par
3149     ImDrawListSharedData*   _Data;              {\cf20 // Pointer to shared draw data (you can use ImGui::GetDrawListSharedData() to get the one from current ImGui context)}\par
3150     ImDrawVert*             _VtxWritePtr;       {\cf20 // [Internal] point within VtxBuffer.Data after each add command (to avoid using the ImVector<> operators too much)}\par
3151     ImDrawIdx*              _IdxWritePtr;       {\cf20 // [Internal] point within IdxBuffer.Data after each add command (to avoid using the ImVector<> operators too much)}\par
3152     ImVector<ImVec2>        _Path;              {\cf20 // [Internal] current path building}\par
3153     ImDrawCmdHeader         _CmdHeader;         {\cf20 // [Internal] template of active commands. Fields should match those of CmdBuffer.back().}\par
3154     ImDrawListSplitter      _Splitter;          {\cf20 // [Internal] for channels api (note: prefer using your own persistent instance of ImDrawListSplitter!)}\par
3155     ImVector<ImVec4>        _ClipRectStack;     {\cf20 // [Internal]}\par
3156     ImVector<ImTextureID>   _TextureIdStack;    {\cf20 // [Internal]}\par
3157     {\cf18 float}                   _FringeScale;       {\cf20 // [Internal] anti-alias fringe is scaled by this value, this helps to keep things sharp while zooming at vertex buffer content}\par
3158     {\cf17 const} {\cf18 char}*             _OwnerName;         {\cf20 // Pointer to owner window's name for debugging}\par
3159 \par
3160     {\cf20 // If you want to create ImDrawList instances, pass them ImGui::GetDrawListSharedData() or create and use your own ImDrawListSharedData (so you can use ImDrawList without ImGui)}\par
3161     ImDrawList(ImDrawListSharedData* shared_data) \{ memset({\cf17 this}, 0, {\cf17 sizeof}(*{\cf17 this})); _Data = shared_data; \}\par
3162 \par
3163     ~ImDrawList() \{ _ClearFreeMemory(); \}\par
