3720     {\cf20 // - Updated by: app/backend. Update every frame to dynamically support changing monitor or DPI configuration.}\par
3721     {\cf20 // - Used by: dear imgui to query DPI info, clamp popups/tooltips within same monitor and not have them straddle monitors.}\par
3722     ImVector<ImGuiPlatformMonitor>  Monitors;\par
