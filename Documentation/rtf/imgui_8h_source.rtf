2507 {\cf20 // Shared state of InputText(), passed as an argument to your callback when a ImGuiInputTextFlags_Callback* flag is used.}\par
2508 {\cf20 // The callback function should return 0 by default.}\par
2509 {\cf20 // Callbacks (follow a flag name and see comments in ImGuiInputTextFlags_ declarations for more details)}\par
2510 {\cf20 // - ImGuiInputTextFlags_CallbackEdit:        Callback on buffer edit (note that InputText() already returns true on edit, the callback is useful mainly to manipulate the underlying buffer while focus is active)}\par
2511 {\cf20 // - ImGuiInputTextFlags_CallbackAlways:      Callback on each iteration}\par
2512 {\cf20 // - ImGuiInputTextFlags_CallbackCompletion:  Callback on pressing TAB}\par
2513 {\cf20 // - ImGuiInputTextFlags_CallbackHistory:     Callback on pressing Up/Down arrows}\par
2514 {\cf20 // - ImGuiInputTextFlags_CallbackCharFilter:  Callback on character inputs to replace or discard them. Modify 'EventChar' to replace or discard, or return 1 in callback to discard.}\par
2515 {\cf20 // - ImGuiInputTextFlags_CallbackResize:      Callback on buffer capacity changes request (beyond 'buf_size' parameter value), allowing the string to grow.}\par
2516 {\cf17 struct }ImGuiInputTextCallbackData\par
2517 \{\par
2518     ImGuiContext*       Ctx;            {\cf20 // Parent UI context}\par
2519     ImGuiInputTextFlags EventFlag;      {\cf20 // One ImGuiInputTextFlags_Callback*    // Read-only}\par
2520     ImGuiInputTextFlags Flags;          {\cf20 // What user passed to InputText()      // Read-only}\par
2521     {\cf18 void}*               UserData;       {\cf20 // What user passed to InputText()      // Read-only}\par
2522 \par
2523     {\cf20 // Arguments for the different callback events}\par
2524     {\cf20 // - During Resize callback, Buf will be same as your input buffer.}\par
2525     {\cf20 // - However, during Completion/History/Always callback, Buf always points to our own internal data (it is not the same as your buffer)! Changes to it will be reflected into your own buffer shortly after the callback.}\par
2526     {\cf20 // - To modify the text buffer in a callback, prefer using the InsertChars() / DeleteChars() function. InsertChars() will take care of calling the resize callback if necessary.}\par
2527     {\cf20 // - If you know your edits are not going to resize the underlying buffer allocation, you may modify the contents of 'Buf[]' directly. You need to update 'BufTextLen' accordingly (0 <= BufTextLen < BufSize) and set 'BufDirty'' to true so InputText can update its internal state.}\par
2528     ImWchar             EventChar;      {\cf20 // Character input                      // Read-write   // [CharFilter] Replace character with another one, or set to zero to drop. return 1 is equivalent to setting EventChar=0;}\par
2529     ImGuiKey            EventKey;       {\cf20 // Key pressed (Up/Down/TAB)            // Read-only    // [Completion,History]}\par
2530     {\cf18 char}*               Buf;            {\cf20 // Text buffer                          // Read-write   // [Resize] Can replace pointer / [Completion,History,Always] Only write to pointed data, don't replace the actual pointer!}\par
2531     {\cf18 int}                 BufTextLen;     {\cf20 // Text length (in bytes)               // Read-write   // [Resize,Completion,History,Always] Exclude zero-terminator storage. In C land: == strlen(some_text), in C++ land: string.length()}\par
2532     {\cf18 int}                 BufSize;        {\cf20 // Buffer size (in bytes) = capacity+1  // Read-only    // [Resize,Completion,History,Always] Include zero-terminator storage. In C land == ARRAYSIZE(my_char_array), in C++ land: string.capacity()+1}\par
2533     {\cf18 bool}                BufDirty;       {\cf20 // Set if you modify Buf/BufTextLen!    // Write        // [Completion,History,Always]}\par
2534     {\cf18 int}                 CursorPos;      {\cf20 //                                      // Read-write   // [Completion,History,Always]}\par
2535     {\cf18 int}                 SelectionStart; {\cf20 //                                      // Read-write   // [Completion,History,Always] == to SelectionEnd when no selection)}\par
2536     {\cf18 int}                 SelectionEnd;   {\cf20 //                                      // Read-write   // [Completion,History,Always]}\par
2537 \par
2538     {\cf20 // Helper functions for text manipulation.}\par
2539     {\cf20 // Use those function to benefit from the CallbackResize behaviors. Calling those function reset the selection.}\par
2540     IMGUI_API ImGuiInputTextCallbackData();\par
2541     IMGUI_API {\cf18 void}      DeleteChars({\cf18 int} pos, {\cf18 int} bytes_count);\par
2542     IMGUI_API {\cf18 void}      InsertChars({\cf18 int} pos, {\cf17 const} {\cf18 char}* text, {\cf17 const} {\cf18 char}* text_end = NULL);\par
2543     {\cf18 void}                SelectAll()             \{ SelectionStart = 0; SelectionEnd = BufTextLen; \}\par
2544     {\cf18 void}                ClearSelection()        \{ SelectionStart = SelectionEnd = BufTextLen; \}\par
2545     {\cf18 bool}                HasSelection(){\cf17  const    }\{ {\cf19 return} SelectionStart != SelectionEnd; \}\par
2546 \};\par
