00122 {\cf20 // Implementation helpers of EnsureReadable(address).}\par
00123 {\cf20 // This is so far only needed on Android, where it is common for libraries to be mapped}\par
00124 {\cf20 // with only executable, not readable, permissions. Typical example (line from /proc/self/maps):}\par
00125 {\cf20 /*}\par
00126 {\cf20 746b63b000-746b6dc000 --xp 00042000 07:48 35                             /apex/com.android.runtime/lib64/bionic/libc.so}\par
00127 {\cf20 */}\par
00128 {\cf20 // See https://github.com/wolfpld/tracy/issues/125 .}\par
00129 {\cf20 // To work around this, we parse /proc/self/maps and we use mprotect to set read permissions}\par
00130 {\cf20 // on any mappings that contain symbols addresses hit by HandleSymbolCodeQuery.}\par
00131 \par
00132 {\cf17 namespace }\{\par
00133 {\cf20 // Holds some information about a single memory mapping.}\par
00134 {\cf17 struct }MappingInfo \{\par
00135     {\cf20 // Start of address range. Inclusive.}\par
00136     uintptr_t start_address;\par
00137     {\cf20 // End of address range. Exclusive, so the mapping is the half-open interval}\par
00138     {\cf20 // [start, end) and its length in bytes is `end - start`. As in /proc/self/maps.}\par
00139     uintptr_t end_address;\par
00140     {\cf20 // Read/Write/Executable permissions.}\par
00141     {\cf18 bool} perm_r, perm_w, perm_x;\par
00142 \};\par
00143 \}  {\cf20 // anonymous namespace}\par
00144 \par
00145    {\cf20 // Internal implementation helper for LookUpMapping(address).}\par
00146    {\cf20 //}\par
00147    {\cf20 // Parses /proc/self/maps returning a vector<MappingInfo>.}\par
00148    {\cf20 // /proc/self/maps is assumed to be sorted by ascending address, so the resulting}\par
00149    {\cf20 // vector is sorted by ascending address too.}\par
00150 {\cf17 static} std::vector<MappingInfo> ParseMappings()\par
00151 \{\par
00152     std::vector<MappingInfo> result;\par
00153     FILE* file = fopen( {\cf22 "/proc/self/maps"}, {\cf22 "r"} );\par
00154     {\cf19 if}( !file ) {\cf19 return} result;\par
00155     {\cf18 char} line[1024];\par
00156     {\cf19 while}( fgets( line, {\cf17 sizeof}( line ), file ) )\par
00157     \{\par
00158         uintptr_t start_addr;\par
00159         uintptr_t end_addr;\par
00160         {\cf19 if}( sscanf( line, {\cf22 "%lx-%lx"}, &start_addr, &end_addr ) != 2 ) {\cf19 continue};\par
00161         {\cf18 char}* first_space = strchr( line, {\cf23 ' '} );\par
00162         {\cf19 if}( !first_space ) {\cf19 continue};\par
00163         {\cf18 char}* perm = first_space + 1;\par
00164         {\cf18 char}* second_space = strchr( perm, {\cf23 ' '} );\par
00165         {\cf19 if}( !second_space || second_space - perm != 4 ) {\cf19 continue};\par
00166         result.emplace_back();\par
00167         {\cf17 auto}& mapping = result.back();\par
00168         mapping.start_address = start_addr;\par
00169         mapping.end_address = end_addr;\par
00170         mapping.perm_r = perm[0] == {\cf23 'r'};\par
00171         mapping.perm_w = perm[1] == {\cf23 'w'};\par
00172         mapping.perm_x = perm[2] == {\cf23 'x'};\par
00173     \}\par
00174     fclose( file );\par
00175     {\cf19 return} result;\par
00176 \}\par
00177 \par
00178 {\cf20 // Internal implementation helper for LookUpMapping(address).}\par
00179 {\cf20 //}\par
00180 {\cf20 // Takes as input an `address` and a known vector `mappings`, assumed to be}\par
00181 {\cf20 // sorted by increasing addresses, as /proc/self/maps seems to be.}\par
00182 {\cf20 // Returns a pointer to the MappingInfo describing the mapping that this}\par
00183 {\cf20 // address belongs to, or nullptr if the address isn't in `mappings`.}\par
00184 {\cf17 static} MappingInfo* LookUpMapping(std::vector<MappingInfo>& mappings, uintptr_t address)\par
00185 \{\par
00186     {\cf20 // Comparison function for std::lower_bound. Returns true if all addresses in `m1`}\par
00187     {\cf20 // are lower than `addr`.}\par
00188     {\cf17 auto} Compare = []( {\cf17 const} MappingInfo& m1, uintptr_t addr ) \{\par
00189         {\cf20 // '<=' because the address ranges are half-open intervals, [start, end).}\par
00190         {\cf19 return} m1.end_address <= addr;\par
00191     \};\par
00192     {\cf17 auto} iter = std::lower_bound( mappings.begin(), mappings.end(), address, Compare );\par
00193     {\cf19 if}( iter == mappings.end() || iter->start_address > address) \{\par
00194         {\cf19 return} {\cf17 nullptr};\par
00195     \}\par
00196     {\cf19 return} &*iter;\par
00197 \}\par
00198 \par
00199 {\cf20 // Internal implementation helper for EnsureReadable(address).}\par
00200 {\cf20 //}\par
00201 {\cf20 // Takes as input an `address` and returns a pointer to a MappingInfo}\par
00202 {\cf20 // describing the mapping that this address belongs to, or nullptr if}\par
00203 {\cf20 // the address isn't in any known mapping.}\par
00204 {\cf20 //}\par
00205 {\cf20 // This function is stateful and not reentrant (assumes to be called from}\par
00206 {\cf20 // only one thread). It holds a vector of mappings parsed from /proc/self/maps.}\par
00207 {\cf20 //}\par
00208 {\cf20 // Attempts to react to mappings changes by re-parsing /proc/self/maps.}\par
00209 {\cf17 static} MappingInfo* LookUpMapping(uintptr_t address)\par
00210 \{\par
00211     {\cf20 // Static state managed by this function. Not constant, we mutate that state as}\par
00212     {\cf20 // we turn some mappings readable. Initially parsed once here, updated as needed below.}\par
00213     {\cf17 static} std::vector<MappingInfo> s_mappings = ParseMappings();\par
00214     MappingInfo* mapping = LookUpMapping( s_mappings, address );\par
00215     {\cf19 if}( mapping ) {\cf19 return} mapping;\par
00216 \par
00217     {\cf20 // This address isn't in any known mapping. Try parsing again, maybe}\par
00218     {\cf20 // mappings changed.}\par
00219     s_mappings = ParseMappings();\par
00220     {\cf19 return} LookUpMapping( s_mappings, address );\par
00221 \}\par
00222 \par
00223 {\cf20 // Internal implementation helper for EnsureReadable(address).}\par
00224 {\cf20 //}\par
00225 {\cf20 // Attempts to make the specified `mapping` readable if it isn't already.}\par
00226 {\cf20 // Returns true if and only if the mapping is readable.}\par
00227 {\cf17 static} {\cf18 bool} EnsureReadable( MappingInfo& mapping )\par
00228 \{\par
00229     {\cf19 if}( mapping.perm_r )\par
00230     \{\par
00231         {\cf20 // The mapping is already readable.}\par
00232         {\cf19 return} {\cf17 true};\par
00233     \}\par
00234     {\cf18 int} prot = PROT_READ;\par
00235     {\cf19 if}( mapping.perm_w ) prot |= PROT_WRITE;\par
00236     {\cf19 if}( mapping.perm_x ) prot |= PROT_EXEC;\par
00237     {\cf19 if}( mprotect( {\cf17 reinterpret_cast<}{\cf18 void}*{\cf17 >}( mapping.start_address ),\par
00238         mapping.end_address - mapping.start_address, prot ) == -1 )\par
00239     \{\par
00240         {\cf20 // Failed to make the mapping readable. Shouldn't happen, hasn't}\par
00241         {\cf20 // been observed yet. If it happened in practice, we should consider}\par
00242         {\cf20 // adding a bool to MappingInfo to track this to avoid retrying mprotect}\par
00243         {\cf20 // everytime on such mappings.}\par
00244         {\cf19 return} {\cf17 false};\par
00245     \}\par
00246     {\cf20 // The mapping is now readable. Update `mapping` so the next call will be fast.}\par
00247     mapping.perm_r = {\cf17 true};\par
00248     {\cf19 return} {\cf17 true};\par
00249 \}\par
00250 \par
00251 {\cf20 // Attempts to set the read permission on the entire mapping containing the}\par
00252 {\cf20 // specified address. Returns true if and only if the mapping is now readable.}\par
00253 {\cf17 static} {\cf18 bool} EnsureReadable( uintptr_t address )\par
00254 \{\par
00255     MappingInfo* mapping = LookUpMapping(address);\par
00256     {\cf19 return} mapping && EnsureReadable( *mapping );\par
00257 \}\par
