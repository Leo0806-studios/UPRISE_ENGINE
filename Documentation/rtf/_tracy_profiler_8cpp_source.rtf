03600 {\cf18 void} Profiler::ReportTopology()\par
03601 \{\par
03602 {\cf21 #ifndef TRACY_DELAYED_INIT}\par
03603     {\cf17 struct }CpuData\par
03604     \{\par
03605         uint32_t package;\par
03606         uint32_t core;\par
03607         uint32_t thread;\par
03608     \};\par
03609 \par
03610 {\cf21 #if defined _WIN32}\par
03611 {\cf21 #  ifdef TRACY_UWP}\par
03612     t_GetLogicalProcessorInformationEx _GetLogicalProcessorInformationEx = &::GetLogicalProcessorInformationEx;\par
03613 {\cf21 #  else}\par
03614     t_GetLogicalProcessorInformationEx _GetLogicalProcessorInformationEx = (t_GetLogicalProcessorInformationEx)GetProcAddress( GetModuleHandleA( {\cf22 "kernel32.dll"} ), {\cf22 "GetLogicalProcessorInformationEx"} );\par
03615 {\cf21 #  endif}\par
03616     {\cf19 if}( !_GetLogicalProcessorInformationEx ) {\cf19 return};\par
03617 \par
03618     DWORD psz = 0;\par
03619     _GetLogicalProcessorInformationEx( RelationProcessorPackage, {\cf17 nullptr}, &psz );\par
03620     {\cf17 auto} packageInfo = (SYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX*)tracy_malloc( psz );\par
03621     {\cf17 auto} res = _GetLogicalProcessorInformationEx( RelationProcessorPackage, packageInfo, &psz );\par
03622     assert( res );\par
03623 \par
03624     DWORD csz = 0;\par
03625     _GetLogicalProcessorInformationEx( RelationProcessorCore, {\cf17 nullptr}, &csz );\par
03626     {\cf17 auto} coreInfo = (SYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX*)tracy_malloc( csz );\par
03627     res = _GetLogicalProcessorInformationEx( RelationProcessorCore, coreInfo, &csz );\par
03628     assert( res );\par
03629 \par
03630     SYSTEM_INFO sysinfo;\par
03631     GetSystemInfo( &sysinfo );\par
03632     {\cf17 const} uint32_t numcpus = sysinfo.dwNumberOfProcessors;\par
03633 \par
03634     {\cf17 auto} cpuData = (CpuData*)tracy_malloc( {\cf17 sizeof}( CpuData ) * numcpus );\par
03635     {\cf19 for}( uint32_t i=0; i<numcpus; i++ ) cpuData[i].thread = i;\par
03636 \par
03637     {\cf18 int} idx = 0;\par
03638     {\cf17 auto} ptr = packageInfo;\par
03639     {\cf19 while}( ({\cf18 char}*)ptr < (({\cf18 char}*)packageInfo) + psz )\par
03640     \{\par
03641         assert( ptr->Relationship == RelationProcessorPackage );\par
03642         {\cf20 // FIXME account for GroupCount}\par
03643         {\cf17 auto} mask = ptr->Processor.GroupMask[0].Mask;\par
03644         {\cf18 int} core = 0;\par
03645         {\cf19 while}( mask != 0 )\par
03646         \{\par
03647             {\cf19 if}( mask & 1 ) cpuData[core].package = idx;\par
03648             core++;\par
03649             mask >>= 1;\par
03650         \}\par
03651         ptr = (SYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX*)((({\cf18 char}*)ptr) + ptr->Size);\par
03652         idx++;\par
03653     \}\par
03654 \par
03655     idx = 0;\par
03656     ptr = coreInfo;\par
03657     {\cf19 while}( ({\cf18 char}*)ptr < (({\cf18 char}*)coreInfo) + csz )\par
03658     \{\par
03659         assert( ptr->Relationship == RelationProcessorCore );\par
03660         {\cf20 // FIXME account for GroupCount}\par
03661         {\cf17 auto} mask = ptr->Processor.GroupMask[0].Mask;\par
03662         {\cf18 int} core = 0;\par
03663         {\cf19 while}( mask != 0 )\par
03664         \{\par
03665             {\cf19 if}( mask & 1 ) cpuData[core].core = idx;\par
03666             core++;\par
03667             mask >>= 1;\par
03668         \}\par
03669         ptr = (SYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX*)((({\cf18 char}*)ptr) + ptr->Size);\par
03670         idx++;\par
03671     \}\par
03672 \par
03673     {\cf19 for}( uint32_t i=0; i<numcpus; i++ )\par
03674     \{\par
03675         {\cf17 auto}& data = cpuData[i];\par
03676 \par
03677         TracyLfqPrepare( QueueType::CpuTopology );\par
03678         MemWrite( &item->cpuTopology.package, data.package );\par
03679         MemWrite( &item->cpuTopology.core, data.core );\par
03680         MemWrite( &item->cpuTopology.thread, data.thread );\par
03681 \par
03682 {\cf21 #ifdef TRACY_ON_DEMAND}\par
03683         DeferItem( *item );\par
03684 {\cf21 #endif}\par
03685 \par
03686         TracyLfqCommit;\par
03687     \}\par
03688 \par
03689     tracy_free( cpuData );\par
03690     tracy_free( coreInfo );\par
03691     tracy_free( packageInfo );\par
03692 {\cf21 #elif defined __linux__}\par
03693     {\cf17 const} {\cf18 int} numcpus = std::thread::hardware_concurrency();\par
03694     {\cf17 auto} cpuData = (CpuData*)tracy_malloc( {\cf17 sizeof}( CpuData ) * numcpus );\par
03695     memset( cpuData, 0, {\cf17 sizeof}( CpuData ) * numcpus );\par
03696 \par
03697     {\cf17 const} {\cf18 char}* basePath = {\cf22 "/sys/devices/system/cpu/cpu"};\par
03698     {\cf19 for}( {\cf18 int} i=0; i<numcpus; i++ )\par
03699     \{\par
03700         {\cf18 char} path[1024];\par
03701         sprintf( path, {\cf22 "%s%i/topology/physical_package_id"}, basePath, i );\par
03702         {\cf18 char} buf[1024];\par
03703         FILE* f = fopen( path, {\cf22 "rb"} );\par
03704         {\cf19 if}( !f )\par
03705         \{\par
03706             tracy_free( cpuData );\par
03707             {\cf19 return};\par
03708         \}\par
03709         {\cf17 auto} read = fread( buf, 1, 1024, f );\par
03710         buf[read] = {\cf23 '\\0'};\par
03711         fclose( f );\par
03712         cpuData[i].package = uint32_t( atoi( buf ) );\par
03713         cpuData[i].thread = i;\par
03714         sprintf( path, {\cf22 "%s%i/topology/core_id"}, basePath, i );\par
03715         f = fopen( path, {\cf22 "rb"} );\par
03716         read = fread( buf, 1, 1024, f );\par
03717         buf[read] = {\cf23 '\\0'};\par
03718         fclose( f );\par
03719         cpuData[i].core = uint32_t( atoi( buf ) );\par
03720     \}\par
03721 \par
03722     {\cf19 for}( {\cf18 int} i=0; i<numcpus; i++ )\par
03723     \{\par
03724         {\cf17 auto}& data = cpuData[i];\par
03725 \par
03726         TracyLfqPrepare( QueueType::CpuTopology );\par
03727         MemWrite( &item->cpuTopology.package, data.package );\par
03728         MemWrite( &item->cpuTopology.core, data.core );\par
03729         MemWrite( &item->cpuTopology.thread, data.thread );\par
03730 \par
03731 {\cf21 #ifdef TRACY_ON_DEMAND}\par
03732         DeferItem( *item );\par
03733 {\cf21 #endif}\par
03734 \par
03735         TracyLfqCommit;\par
03736     \}\par
03737 \par
03738     tracy_free( cpuData );\par
03739 {\cf21 #endif}\par
03740 {\cf21 #endif}\par
03741 \}\par
