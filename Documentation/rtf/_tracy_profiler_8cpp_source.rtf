03346 {\cf18 bool} Profiler::HandleServerQuery()\par
03347 \{\par
03348     ServerQueryPacket payload;\par
03349     {\cf19 if}( !m_sock->Read( &payload, {\cf17 sizeof}( payload ), 10 ) ) {\cf19 return} {\cf17 false};\par
03350 \par
03351     uint8_t type;\par
03352     uint64_t ptr;\par
03353     memcpy( &type, &payload.type, {\cf17 sizeof}( payload.type ) );\par
03354     memcpy( &ptr, &payload.ptr, {\cf17 sizeof}( payload.ptr ) );\par
03355 \par
03356     {\cf19 switch}( type )\par
03357     \{\par
03358     {\cf19 case} ServerQueryString:\par
03359         SendString( ptr, ({\cf17 const} {\cf18 char}*)ptr, QueueType::StringData );\par
03360         {\cf19 break};\par
03361     {\cf19 case} ServerQueryThreadString:\par
03362         {\cf19 if}( ptr == m_mainThread )\par
03363         \{\par
03364             SendString( ptr, {\cf22 "Main thread"}, 11, QueueType::ThreadName );\par
03365         \}\par
03366         {\cf19 else}\par
03367         \{\par
03368             SendString( ptr, GetThreadName( ptr ), QueueType::ThreadName );\par
03369         \}\par
03370         {\cf19 break};\par
03371     {\cf19 case} ServerQuerySourceLocation:\par
03372         SendSourceLocation( ptr );\par
03373         {\cf19 break};\par
03374     {\cf19 case} ServerQueryPlotName:\par
03375         SendString( ptr, ({\cf17 const} {\cf18 char}*)ptr, QueueType::PlotName );\par
03376         {\cf19 break};\par
03377     {\cf19 case} ServerQueryTerminate:\par
03378         {\cf19 return} {\cf17 false};\par
03379     {\cf19 case} ServerQueryCallstackFrame:\par
03380         QueueCallstackFrame( ptr );\par
03381         {\cf19 break};\par
03382     {\cf19 case} ServerQueryFrameName:\par
03383         SendString( ptr, ({\cf17 const} {\cf18 char}*)ptr, QueueType::FrameName );\par
03384         {\cf19 break};\par
03385     {\cf19 case} ServerQueryDisconnect:\par
03386         HandleDisconnect();\par
03387         {\cf19 return} {\cf17 false};\par
03388 {\cf21 #ifdef TRACY_HAS_SYSTEM_TRACING}\par
03389     {\cf19 case} ServerQueryExternalName:\par
03390         QueueExternalName( ptr );\par
03391         {\cf19 break};\par
03392 {\cf21 #endif}\par
03393     {\cf19 case} ServerQueryParameter:\par
03394         HandleParameter( ptr );\par
03395         {\cf19 break};\par
03396     {\cf19 case} ServerQuerySymbol:\par
03397         QueueSymbolQuery( ptr );\par
03398         {\cf19 break};\par
03399 {\cf21 #ifndef TRACY_NO_CODE_TRANSFER}\par
03400     {\cf19 case} ServerQuerySymbolCode:\par
03401         HandleSymbolCodeQuery( ptr, payload.extra );\par
03402         {\cf19 break};\par
03403 {\cf21 #endif}\par
03404     {\cf19 case} ServerQuerySourceCode:\par
03405         QueueSourceCodeQuery( uint32_t( ptr ) );\par
03406         {\cf19 break};\par
03407     {\cf19 case} ServerQueryDataTransfer:\par
03408         {\cf19 if}( m_queryData )\par
03409         \{\par
03410             assert( !m_queryImage );\par
03411             m_queryImage = m_queryData;\par
03412         \}\par
03413         m_queryDataPtr = m_queryData = ({\cf18 char}*)tracy_malloc( ptr + 11 );\par
03414         AckServerQuery();\par
03415         {\cf19 break};\par
03416     {\cf19 case} ServerQueryDataTransferPart:\par
03417         memcpy( m_queryDataPtr, &ptr, 8 );\par
03418         memcpy( m_queryDataPtr+8, &payload.extra, 4 );\par
