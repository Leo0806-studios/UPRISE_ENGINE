03755 {\cf18 void} Profiler::CutCallstack( {\cf18 void}* callstack, {\cf17 const} {\cf18 char}* skipBefore )\par
03756 \{\par
03757 {\cf21 #ifdef TRACY_HAS_CALLSTACK}\par
03758     {\cf17 auto} data = (uintptr_t*)callstack;\par
03759     {\cf17 const} {\cf17 auto} sz = *data++;\par
03760     uintptr_t i;\par
03761     {\cf19 for}( i=0; i<sz; i++ )\par
03762     \{\par
03763         {\cf17 auto} name = DecodeCallstackPtrFast( uint64_t( data[i] ) );\par
03764         {\cf17 const} {\cf18 bool} found = strcmp( name, skipBefore ) == 0;\par
03765         {\cf19 if}( found )\par
03766         \{\par
03767             i++;\par
03768             {\cf19 break};\par
03769         \}\par
03770     \}\par
03771 \par
03772     {\cf19 if}( i != sz )\par
03773     \{\par
03774         memmove( data, data + i, ( sz - i ) * {\cf17 sizeof}( uintptr_t* ) );\par
03775         *--data = sz - i;\par
03776     \}\par
03777 {\cf21 #endif}\par
