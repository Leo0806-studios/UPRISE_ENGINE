03548 {\cf18 void} Profiler::CalibrateDelay()\par
03549 \{\par
03550     {\cf17 constexpr} {\cf18 int} Iterations = 50000;\par
03551 \par
03552     {\cf17 auto} mindiff = std::numeric_limits<int64_t>::max();\par
03553     {\cf19 for}( {\cf18 int} i=0; i<Iterations * 10; i++ )\par
03554     \{\par
03555         {\cf17 const} {\cf17 auto} t0i = GetTime();\par
03556         {\cf17 const} {\cf17 auto} t1i = GetTime();\par
03557         {\cf17 const} {\cf17 auto} dti = t1i - t0i;\par
03558         {\cf19 if}( dti > 0 && dti < mindiff ) mindiff = dti;\par
03559     \}\par
03560     m_resolution = mindiff;\par
03561 \par
03562 {\cf21 #ifdef TRACY_DELAYED_INIT}\par
03563     m_delay = m_resolution;\par
03564 {\cf21 #else}\par
03565     {\cf17 constexpr} {\cf18 int} Events = Iterations * 2;   {\cf20 // start + end}\par
03566     {\cf17 static_assert}( Events < QueuePrealloc, {\cf22 "Delay calibration loop will allocate memory in queue"} );\par
03567 \par
03568     {\cf17 static} {\cf17 const} tracy::SourceLocationData __tracy_source_location \{ {\cf17 nullptr}, TracyFunction,  TracyFile, (uint32_t)TracyLine, 0 \};\par
03569     {\cf17 const} {\cf17 auto} t0 = GetTime();\par
03570     {\cf19 for}( {\cf18 int} i=0; i<Iterations; i++ )\par
03571     \{\par
03572         \{\par
03573             TracyLfqPrepare( QueueType::ZoneBegin );\par
03574             MemWrite( &item->zoneBegin.time, Profiler::GetTime() );\par
03575             MemWrite( &item->zoneBegin.srcloc, (uint64_t)&__tracy_source_location );\par
03576             TracyLfqCommit;\par
03577         \}\par
03578         \{\par
03579             TracyLfqPrepare( QueueType::ZoneEnd );\par
03580             MemWrite( &item->zoneEnd.time, GetTime() );\par
03581             TracyLfqCommit;\par
03582         \}\par
03583     \}\par
03584     {\cf17 const} {\cf17 auto} t1 = GetTime();\par
03585     {\cf17 const} {\cf17 auto} dt = t1 - t0;\par
03586     m_delay = dt / Events;\par
03587 \par
03588     moodycamel::ConsumerToken token( GetQueue() );\par
03589     {\cf18 int} left = Events;\par
03590     {\cf19 while}( left != 0 )\par
03591     \{\par
03592         {\cf17 const} {\cf17 auto} sz = GetQueue().try_dequeue_bulk_single( token, []({\cf17 const} uint64_t&)\{\}, [](QueueItem* item, {\cf18 size_t} sz)\{\} );\par
03593         assert( sz > 0 );\par
03594         left -= (int)sz;\par
03595     \}\par
03596     assert( GetQueue().size_approx() == 0 );\par
03597 {\cf21 #endif}\par
03598 \}\par
