00331 {\cf17 static} {\cf18 bool} CheckHardwareSupportsInvariantTSC()\par
00332 \{\par
00333     {\cf17 const} {\cf18 char}* noCheck = GetEnvVar( {\cf22 "TRACY_NO_INVARIANT_CHECK"} );\par
00334     {\cf19 if}( noCheck && noCheck[0] == {\cf23 '1'} ) {\cf19 return} {\cf17 true};\par
