03517 {\cf18 void} Profiler::CalibrateTimer()\par
03518 \{\par
03519     m_timerMul = 1.;\par
03520 \par
03521 {\cf21 #ifdef TRACY_HW_TIMER}\par
03522 \par
03523 {\cf21 #  if !defined TRACY_TIMER_QPC && defined TRACY_TIMER_FALLBACK}\par
03524     {\cf17 const} {\cf18 bool} needCalibration = HardwareSupportsInvariantTSC();\par
03525 {\cf21 #  else}\par
03526     {\cf17 const} {\cf18 bool} needCalibration = {\cf17 true};\par
03527 {\cf21 #  endif}\par
03528     {\cf19 if}( needCalibration )\par
03529     \{\par
03530         std::atomic_signal_fence( std::memory_order_acq_rel );\par
03531         {\cf17 const} {\cf17 auto} t0 = std::chrono::high_resolution_clock::now();\par
03532         {\cf17 const} {\cf17 auto} r0 = GetTime();\par
03533         std::atomic_signal_fence( std::memory_order_acq_rel );\par
03534         std::this_thread::sleep_for( std::chrono::milliseconds( 200 ) );\par
03535         std::atomic_signal_fence( std::memory_order_acq_rel );\par
03536         {\cf17 const} {\cf17 auto} t1 = std::chrono::high_resolution_clock::now();\par
03537         {\cf17 const} {\cf17 auto} r1 = GetTime();\par
03538         std::atomic_signal_fence( std::memory_order_acq_rel );\par
03539 \par
03540         {\cf17 const} {\cf17 auto} dt = std::chrono::duration_cast<std::chrono::nanoseconds>( t1 - t0 ).count();\par
03541         {\cf17 const} {\cf17 auto} dr = r1 - r0;\par
03542 \par
03543         m_timerMul = double( dt ) / double( dr );\par
03544     \}\par
03545 {\cf21 #endif}\par
03546 \}\par
