03202 {\cf18 void} Profiler::HandleSymbolQueueItem( {\cf17 const} SymbolQueueItem& si )\par
03203 \{\par
03204     {\cf19 switch}( si.type )\par
03205     \{\par
03206     {\cf19 case} SymbolQueueItemType::CallstackFrame:\par
03207     \{\par
03208         {\cf17 const} {\cf17 auto} frameData = DecodeCallstackPtr( si.ptr );\par
03209         {\cf17 auto} data = tracy_malloc_fast( {\cf17 sizeof}( CallstackEntry ) * frameData.size );\par
03210         memcpy( data, frameData.data, {\cf17 sizeof}( CallstackEntry ) * frameData.size );\par
03211         TracyLfqPrepare( QueueType::CallstackFrameSize );\par
03212         MemWrite( &item->callstackFrameSizeFat.ptr, si.ptr );\par
03213         MemWrite( &item->callstackFrameSizeFat.size, frameData.size );\par
03214         MemWrite( &item->callstackFrameSizeFat.data, (uint64_t)data );\par
03215         MemWrite( &item->callstackFrameSizeFat.imageName, (uint64_t)frameData.imageName );\par
03216         TracyLfqCommit;\par
03217         {\cf19 break};\par
03218     \}\par
03219     {\cf19 case} SymbolQueueItemType::SymbolQuery:\par
03220     \{\par
03221 {\cf21 #ifdef __ANDROID__}\par
03222         {\cf20 // On Android it's common for code to be in mappings that are only executable}\par
03223         {\cf20 // but not readable.}\par
03224         {\cf19 if}( !EnsureReadable( si.ptr ) )\par
03225         \{\par
03226             TracyLfqPrepare( QueueType::AckServerQueryNoop );\par
03227             TracyLfqCommit;\par
03228             {\cf19 break};\par
03229         \}\par
03230 {\cf21 #endif}\par
03231         {\cf17 const} {\cf17 auto} sym = DecodeSymbolAddress( si.ptr );\par
03232         TracyLfqPrepare( QueueType::SymbolInformation );\par
03233         MemWrite( &item->symbolInformationFat.line, sym.line );\par
03234         MemWrite( &item->symbolInformationFat.symAddr, si.ptr );\par
03235         MemWrite( &item->symbolInformationFat.fileString, (uint64_t)sym.file );\par
03236         MemWrite( &item->symbolInformationFat.needFree, (uint8_t)sym.needFree );\par
03237         TracyLfqCommit;\par
03238         {\cf19 break};\par
03239     \}\par
03240 {\cf21 #ifdef TRACY_HAS_SYSTEM_TRACING}\par
03241     {\cf19 case} SymbolQueueItemType::ExternalName:\par
03242     \{\par
03243         {\cf17 const} {\cf18 char}* threadName;\par
03244         {\cf17 const} {\cf18 char}* name;\par
03245         SysTraceGetExternalName( si.ptr, threadName, name );\par
03246         TracyLfqPrepare( QueueType::ExternalNameMetadata );\par
03247         MemWrite( &item->externalNameMetadata.thread, si.ptr );\par
03248         MemWrite( &item->externalNameMetadata.name, (uint64_t)name );\par
03249         MemWrite( &item->externalNameMetadata.threadName, (uint64_t)threadName );\par
03250         TracyLfqCommit;\par
03251         {\cf19 break};\par
03252     \}\par
03253 {\cf21 #endif}\par
03254     {\cf19 case} SymbolQueueItemType::KernelCode:\par
03255     \{\par
03256 {\cf21 #ifdef _WIN32}\par
03257         {\cf17 auto} mod = GetKernelModulePath( si.ptr );\par
03258         {\cf19 if}( mod )\par
03259         \{\par
03260             {\cf17 auto} fn = DecodeCallstackPtrFast( si.ptr );\par
03261             {\cf19 if}( *fn )\par
03262             \{\par
03263                 {\cf17 auto} hnd = LoadLibraryExA( mod, {\cf17 nullptr}, DONT_RESOLVE_DLL_REFERENCES );\par
03264                 {\cf19 if}( hnd )\par
03265                 \{\par
03266                     {\cf17 auto} ptr = ({\cf17 const} {\cf18 void}*)GetProcAddress( hnd, fn );\par
03267                     {\cf19 if}( ptr )\par
03268                     \{\par
03269                         {\cf17 auto} buf = ({\cf18 char}*)tracy_malloc( si.extra );\par
03270                         memcpy( buf, ptr, si.extra );\par
03271                         FreeLibrary( hnd );\par
03272                         TracyLfqPrepare( QueueType::SymbolCodeMetadata );\par
03273                         MemWrite( &item->symbolCodeMetadata.symbol, si.ptr );\par
03274                         MemWrite( &item->symbolCodeMetadata.ptr, (uint64_t)buf );\par
03275                         MemWrite( &item->symbolCodeMetadata.size, (uint32_t)si.extra );\par
03276                         TracyLfqCommit;\par
03277                         {\cf19 break};\par
03278                     \}\par
03279                     FreeLibrary( hnd );\par
03280                 \}\par
03281             \}\par
03282         \}\par
03283 {\cf21 #endif}\par
03284         TracyLfqPrepare( QueueType::AckSymbolCodeNotAvailable );\par
03285         TracyLfqCommit;\par
03286         {\cf19 break};\par
03287     \}\par
03288     {\cf19 case} SymbolQueueItemType::SourceCode:\par
03289         HandleSourceCodeQuery( ({\cf18 char}*)si.ptr, ({\cf18 char}*)si.extra, si.id );\par
03290         {\cf19 break};\par
03291     {\cf19 default}:\par
03292         assert( {\cf17 false} );\par
03293         {\cf19 break};\par
03294     \}\par
03295 \}\par
03296 \par
03297 {\cf18 void} Profiler::SymbolWorker()\par
03298 \{\par
03299 {\cf21 #if defined __linux__ && !defined TRACY_NO_CRASH_HANDLER}\par
03300     s_symbolTid = syscall( SYS_gettid );\par
03301 {\cf21 #endif}\par
03302 \par
03303     ThreadExitHandler threadExitHandler;\par
03304     SetThreadName( {\cf22 "Tracy Symbol Worker"} );\par
03305 {\cf21 #ifdef TRACY_USE_RPMALLOC}\par
03306     InitRpmalloc();\par
03307 {\cf21 #endif}\par
03308     InitCallstack();\par
03309     {\cf19 while}( m_timeBegin.load( std::memory_order_relaxed ) == 0 ) std::this_thread::sleep_for( std::chrono::milliseconds( 10 ) );\par
03310 \par
03311     {\cf19 for}(;;)\par
03312     \{\par
03313         {\cf17 const} {\cf17 auto} shouldExit = ShouldExit();\par
03314 {\cf21 #ifdef TRACY_ON_DEMAND}\par
03315         {\cf19 if}( !IsConnected() )\par
03316         \{\par
03317             {\cf19 if}( shouldExit )\par
03318             \{\par
03319                 s_symbolThreadGone.store( {\cf17 true}, std::memory_order_release );\par
03320                 {\cf19 return};\par
03321             \}\par
03322             {\cf19 while}( m_symbolQueue.front() ) m_symbolQueue.pop();\par
03323             std::this_thread::sleep_for( std::chrono::milliseconds( 20 ) );\par
03324             {\cf19 continue};\par
03325         \}\par
03326 {\cf21 #endif}\par
03327         {\cf17 auto} si = m_symbolQueue.front();\par
03328         {\cf19 if}( si )\par
03329         \{\par
03330             HandleSymbolQueueItem( *si );\par
03331             m_symbolQueue.pop();\par
03332         \}\par
03333         {\cf19 else}\par
03334         \{\par
03335             {\cf19 if}( shouldExit )\par
03336             \{\par
03337                 s_symbolThreadGone.store( {\cf17 true}, std::memory_order_release );\par
03338                 {\cf19 return};\par
03339             \}\par
03340             std::this_thread::sleep_for( std::chrono::milliseconds( 20 ) );\par
03341         \}\par
03342     \}\par
03343 \}\par
03344 {\cf21 #endif}\par
