2970 {\cf17 template}<{\cf17 typename} StringType>\par
2971 {\cf17 inline} {\cf18 void} replace_substring(StringType& s, {\cf17 const} StringType& f,\par
2972                               {\cf17 const} StringType& t)\par
2973 \{\par
2974     JSON_ASSERT(!f.empty());\par
2975     {\cf19 for} ({\cf17 auto} pos = s.find(f);                {\cf20 // find first occurrence of f}\par
2976             pos != StringType::npos;          {\cf20 // make sure f was found}\par
2977             s.replace(pos, f.size(), t),      {\cf20 // replace with t, and}\par
2978             pos = s.find(f, pos + t.size()))  {\cf20 // find next occurrence of f}\par
2979     \{\}\par
2980 \}\par
2981 \par
2989 {\cf17 template}<{\cf17 typename} StringType>\par
2990 {\cf17 inline} StringType escape(StringType s)\par
2991 \{\par
2992     replace_substring(s, StringType\{{\cf22 "~"}\}, StringType\{{\cf22 "~0"}\});\par
2993     replace_substring(s, StringType\{{\cf22 "/"}\}, StringType\{{\cf22 "~1"}\});\par
2994     {\cf19 return} s;\par
2995 \}\par
2996 \par
3004 {\cf17 template}<{\cf17 typename} StringType>\par
3005 {\cf17 static} {\cf18 void} unescape(StringType& s)\par
3006 \{\par
3007     replace_substring(s, StringType\{{\cf22 "~1"}\}, StringType\{{\cf22 "/"}\});\par
3008     replace_substring(s, StringType\{{\cf22 "~0"}\}, StringType\{{\cf22 "~"}\});\par
3009 \}\par
3010 \par
