9340         {\cf19 while} ({\cf17 true})\par
9341         \{\par
9342             get();\par
9343             {\cf19 if} (JSON_HEDLEY_UNLIKELY(!unexpect_eof(input_format_t::bson, {\cf22 "cstring"})))\par
