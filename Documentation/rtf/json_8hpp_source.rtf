3190 {\cf17 template} <{\cf18 size_t} N>\par
3191 {\cf17 using }make_index_sequence = make_integer_sequence<size_t, N>;\par
3192 \par
3193 {\cf20 // index_sequence_for}\par
3194 {\cf20 //}\par
3195 {\cf20 // Converts a typename pack into an index sequence of the same length, and}\par
