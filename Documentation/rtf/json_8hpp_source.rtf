17833 JSON_HEDLEY_NON_NULL(1)\par
17834 JSON_HEDLEY_RETURNS_NON_NULL\par
17835 inline {\cf18 char}* append_exponent({\cf18 char}* buf, {\cf18 int} e)\par
17836 \{\par
17837     JSON_ASSERT(e > -1000);\par
17838     JSON_ASSERT(e <  1000);\par
17839 \par
17840     {\cf19 if} (e < 0)\par
17841     \{\par
17842         e = -e;\par
17843         *buf++ = {\cf23 '-'};\par
17844     \}\par
17845     {\cf19 else}\par
17846     \{\par
17847         *buf++ = {\cf23 '+'};\par
17848     \}\par
17849 \par
17850     {\cf17 auto} k = {\cf17 static_cast<}std::uint32_t{\cf17 >}(e);\par
17851     {\cf19 if} (k < 10)\par
17852     \{\par
17853         {\cf20 // Always print at least two digits in the exponent.}\par
17854         {\cf20 // This is for compatibility with printf("%g").}\par
17855         *buf++ = {\cf23 '0'};\par
17856         *buf++ = {\cf17 static_cast<}{\cf18 char}{\cf17 >}({\cf23 '0'} + k);\par
17857     \}\par
17858     {\cf19 else} {\cf19 if} (k < 100)\par
17859     \{\par
17860         *buf++ = {\cf17 static_cast<}{\cf18 char}{\cf17 >}({\cf23 '0'} + k / 10);\par
17861         k %= 10;\par
17862         *buf++ = {\cf17 static_cast<}{\cf18 char}{\cf17 >}({\cf23 '0'} + k);\par
17863     \}\par
17864     {\cf19 else}\par
17865     \{\par
17866         *buf++ = {\cf17 static_cast<}{\cf18 char}{\cf17 >}({\cf23 '0'} + k / 100);\par
17867         k %= 100;\par
17868         *buf++ = {\cf17 static_cast<}{\cf18 char}{\cf17 >}({\cf23 '0'} + k / 10);\par
17869         k %= 10;\par
17870         *buf++ = {\cf17 static_cast<}{\cf18 char}{\cf17 >}({\cf23 '0'} + k);\par
17871     \}\par
17872 \par
17873     {\cf19 return} buf;\par
17874 \}\par
17875 \par
17885 JSON_HEDLEY_NON_NULL(1)\par
17886 JSON_HEDLEY_RETURNS_NON_NULL\par
17887 inline {\cf18 char}* format_buffer({\cf18 char}* buf, {\cf18 int} len, {\cf18 int} decimal_exponent,\par
17888                            {\cf18 int} min_exp, {\cf18 int} max_exp)\par
17889 \{\par
17890     JSON_ASSERT(min_exp < 0);\par
17891     JSON_ASSERT(max_exp > 0);\par
17892 \par
17893     {\cf17 const} {\cf18 int} k = len;\par
17894     {\cf17 const} {\cf18 int} n = len + decimal_exponent;\par
17895 \par
17896     {\cf20 // v = buf * 10^(n-k)}\par
17897     {\cf20 // k is the length of the buffer (number of decimal digits)}\par
17898     {\cf20 // n is the position of the decimal point relative to the start of the buffer.}\par
17899 \par
17900     {\cf19 if} (k <= n && n <= max_exp)\par
17901     \{\par
17902         {\cf20 // digits[000]}\par
17903         {\cf20 // len <= max_exp + 2}\par
17904 \par
17905         std::memset(buf + k, {\cf23 '0'}, {\cf17 static_cast<}{\cf18 size_t}{\cf17 >}(n) - {\cf17 static_cast<}{\cf18 size_t}{\cf17 >}(k));\par
17906         {\cf20 // Make it look like a floating-point number (#362, #378)}\par
17907         buf[n + 0] = {\cf23 '.'};\par
17908         buf[n + 1] = {\cf23 '0'};\par
17909         {\cf19 return} buf + ({\cf17 static_cast<}{\cf18 size_t}{\cf17 >}(n) + 2);\par
17910     \}\par
17911 \par
17912     {\cf19 if} (0 < n && n <= max_exp)\par
17913     \{\par
17914         {\cf20 // dig.its}\par
17915         {\cf20 // len <= max_digits10 + 1}\par
17916 \par
17917         JSON_ASSERT(k > n);\par
17918 \par
17919         std::memmove(buf + ({\cf17 static_cast<}{\cf18 size_t}{\cf17 >}(n) + 1), buf + n, {\cf17 static_cast<}{\cf18 size_t}{\cf17 >}(k) - {\cf17 static_cast<}{\cf18 size_t}{\cf17 >}(n));\par
17920         buf[n] = {\cf23 '.'};\par
17921         {\cf19 return} buf + ({\cf17 static_cast<}{\cf18 size_t}{\cf17 >}(k) + 1U);\par
17922     \}\par
17923 \par
17924     {\cf19 if} (min_exp < n && n <= 0)\par
17925     \{\par
17926         {\cf20 // 0.[000]digits}\par
17927         {\cf20 // len <= 2 + (-min_exp - 1) + max_digits10}\par
17928 \par
17929         std::memmove(buf + (2 + {\cf17 static_cast<}{\cf18 size_t}{\cf17 >}(-n)), buf, {\cf17 static_cast<}{\cf18 size_t}{\cf17 >}(k));\par
17930         buf[0] = {\cf23 '0'};\par
17931         buf[1] = {\cf23 '.'};\par
17932         std::memset(buf + 2, {\cf23 '0'}, {\cf17 static_cast<}{\cf18 size_t}{\cf17 >}(-n));\par
17933         {\cf19 return} buf + (2U + {\cf17 static_cast<}{\cf18 size_t}{\cf17 >}(-n) + {\cf17 static_cast<}{\cf18 size_t}{\cf17 >}(k));\par
17934     \}\par
17935 \par
17936     {\cf19 if} (k == 1)\par
17937     \{\par
17938         {\cf20 // dE+123}\par
17939         {\cf20 // len <= 1 + 5}\par
17940 \par
17941         buf += 1;\par
17942     \}\par
17943     {\cf19 else}\par
17944     \{\par
17945         {\cf20 // d.igitsE+123}\par
17946         {\cf20 // len <= max_digits10 + 1 + 5}\par
17947 \par
17948         std::memmove(buf + 2, buf + 1, {\cf17 static_cast<}{\cf18 size_t}{\cf17 >}(k) - 1);\par
17949         buf[1] = {\cf23 '.'};\par
17950         buf += 1 + {\cf17 static_cast<}{\cf18 size_t}{\cf17 >}(k);\par
17951     \}\par
17952 \par
17953     *buf++ = {\cf23 'e'};\par
17954     {\cf19 return} append_exponent(buf, n - 1);\par
17955 \}\par
17956 \par
17957 \}  {\cf20 // namespace dtoa_impl}\par
