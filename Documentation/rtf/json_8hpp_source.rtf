17969 {\cf17 template}<{\cf17 typename} FloatType>\par
17970 JSON_HEDLEY_NON_NULL(1, 2)\par
17971 JSON_HEDLEY_RETURNS_NON_NULL\par
17972 {\cf18 char}* to_chars({\cf18 char}* first, const {\cf18 char}* last, FloatType value)\par
17973 \{\par
17974     {\cf17 static_cast<}{\cf18 void}{\cf17 >}(last); {\cf20 // maybe unused - fix warning}\par
17975     JSON_ASSERT(std::isfinite(value));\par
17976 \par
17977     {\cf20 // Use signbit(value) instead of (value < 0) since signbit works for -0.}\par
17978     {\cf19 if} (std::signbit(value))\par
17979     \{\par
17980         value = -value;\par
17981         *first++ = {\cf23 '-'};\par
17982     \}\par
17983 \par
17984 {\cf21 #ifdef __GNUC__}\par
17985 {\cf21 #pragma GCC diagnostic push}\par
17986 {\cf21 #pragma GCC diagnostic ignored "-Wfloat-equal"}\par
17987 {\cf21 #endif}\par
17988     {\cf19 if} (value == 0) {\cf20 // +-0}\par
17989     \{\par
17990         *first++ = {\cf23 '0'};\par
17991         {\cf20 // Make it look like a floating-point number (#362, #378)}\par
17992         *first++ = {\cf23 '.'};\par
17993         *first++ = {\cf23 '0'};\par
17994         {\cf19 return} first;\par
17995     \}\par
17996 {\cf21 #ifdef __GNUC__}\par
17997 {\cf21 #pragma GCC diagnostic pop}\par
17998 {\cf21 #endif}\par
17999 \par
18000     JSON_ASSERT(last - first >= std::numeric_limits<FloatType>::max_digits10);\par
18001 \par
18002     {\cf20 // Compute v = buffer * 10^decimal_exponent.}\par
18003     {\cf20 // The decimal digits are stored in the buffer, which needs to be interpreted}\par
18004     {\cf20 // as an unsigned decimal integer.}\par
18005     {\cf20 // len is the length of the buffer, i.e. the number of decimal digits.}\par
18006     {\cf18 int} len = 0;\par
18007     {\cf18 int} decimal_exponent = 0;\par
18008     dtoa_impl::grisu2(first, len, decimal_exponent, value);\par
18009 \par
18010     JSON_ASSERT(len <= std::numeric_limits<FloatType>::max_digits10);\par
18011 \par
18012     {\cf20 // Format the buffer like printf("%.*g", prec, value)}\par
18013     {\cf17 constexpr} {\cf18 int} kMinExp = -4;\par
18014     {\cf20 // Use digits10 here to increase compatibility with version 2.}\par
18015     {\cf17 constexpr} {\cf18 int} kMaxExp = std::numeric_limits<FloatType>::digits10;\par
18016 \par
18017     JSON_ASSERT(last - first >= kMaxExp + 2);\par
18018     JSON_ASSERT(last - first >= 2 + (-kMinExp - 1) + std::numeric_limits<FloatType>::max_digits10);\par
18019     JSON_ASSERT(last - first >= std::numeric_limits<FloatType>::max_digits10 + 6);\par
18020 \par
18021     {\cf19 return} dtoa_impl::format_buffer(first, len, decimal_exponent, kMinExp, kMaxExp);\par
18022 \}\par
18023 \par
