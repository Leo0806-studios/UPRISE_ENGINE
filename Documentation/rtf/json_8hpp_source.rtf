12593                     {\cf19 return} sax->parse_error(m_lexer.get_position(),\par
12594                                             m_lexer.get_token_string(),\par
12595                                             parse_error::create(101, m_lexer.get_position(), exception_message(token_type::value_string, {\cf22 "object key"}), {\cf17 nullptr}));\par
