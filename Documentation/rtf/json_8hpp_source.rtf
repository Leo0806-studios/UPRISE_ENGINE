3102 {\cf20 // integer_sequence}\par
3103 {\cf20 //}\par
3104 {\cf20 // Class template representing a compile-time integer sequence. An instantiation}\par
3105 {\cf20 // of `integer_sequence<T, Ints...>` has a sequence of integers encoded in its}\par
3106 {\cf20 // type through its template arguments (which is a common need when}\par
3107 {\cf20 // working with C++11 variadic templates). `absl::integer_sequence` is designed}\par
3108 {\cf20 // to be a drop-in replacement for C++14's `std::integer_sequence`.}\par
3109 {\cf20 //}\par
3110 {\cf20 // Example:}\par
3111 {\cf20 //}\par
3112 {\cf20 //   template< class T, T... Ints >}\par
3113 {\cf20 //   void user_function(integer_sequence<T, Ints...>);}\par
3114 {\cf20 //}\par
3115 {\cf20 //   int main()}\par
3116 {\cf20 //   \{}\par
3117 {\cf20 //     // user_function's `T` will be deduced to `int` and `Ints...`}\par
3118 {\cf20 //     // will be deduced to `0, 1, 2, 3, 4`.}\par
3119 {\cf20 //     user_function(make_integer_sequence<int, 5>());}\par
3120 {\cf20 //   \}}\par
3121 {\cf17 template} <{\cf17 typename} T, T... Ints>\par
3122 {\cf17 struct }integer_sequence\par
3123 \{\par
3124     {\cf17 using }value_type = T;\par
3125     {\cf17 static} {\cf17 constexpr} std::size_t size() noexcept\par
3126     \{\par
3127         {\cf19 return} {\cf17 sizeof}...(Ints);\par
3128     \}\par
3129 \};\par
3130 \par
3131 {\cf20 // index_sequence}\par
3132 {\cf20 //}\par
3133 {\cf20 // A helper template for an `integer_sequence` of `size_t`,}\par
3134 {\cf20 // `absl::index_sequence` is designed to be a drop-in replacement for C++14's}\par
3135 {\cf20 // `std::index_sequence`.}\par
3136 {\cf17 template} <{\cf18 size_t}... Ints>\par
3137 {\cf17 using }index_sequence = integer_sequence<size_t, Ints...>;\par
3138 \par
3139 {\cf17 namespace }utility_internal\par
3140 \{\par
3141 \par
3142 {\cf17 template} <{\cf17 typename} Seq, {\cf18 size_t} SeqSize, {\cf18 size_t} Rem>\par
3143 {\cf17 struct }Extend;\par
3144 \par
3145 {\cf20 // Note that SeqSize == sizeof...(Ints). It's passed explicitly for efficiency.}\par
3146 {\cf17 template} <{\cf17 typename} T, T... Ints, {\cf18 size_t} SeqSize>\par
3147 {\cf17 struct }Extend<integer_sequence<T, Ints...>, SeqSize, 0>\par
3148 \{\par
3149     {\cf17 using }type = integer_sequence < T, Ints..., (Ints + SeqSize)... >;\par
3150 \};\par
3151 \par
3152 {\cf17 template} <{\cf17 typename} T, T... Ints, {\cf18 size_t} SeqSize>\par
3153 {\cf17 struct }Extend<integer_sequence<T, Ints...>, SeqSize, 1>\par
3154 \{\par
3155     {\cf17 using }type = integer_sequence < T, Ints..., (Ints + SeqSize)..., 2 * SeqSize >;\par
3156 \};\par
3157 \par
3158 {\cf20 // Recursion helper for 'make_integer_sequence<T, N>'.}\par
3159 {\cf20 // 'Gen<T, N>::type' is an alias for 'integer_sequence<T, 0, 1, ... N-1>'.}\par
3160 {\cf17 template} <{\cf17 typename} T, {\cf18 size_t} N>\par
3161 {\cf17 struct }Gen\par
3162 \{\par
3163     {\cf17 using }type =\par
3164         {\cf17 typename} Extend < {\cf17 typename} Gen < T, N / 2 >::type, N / 2, N % 2 >::type;\par
3165 \};\par
3166 \par
3167 {\cf17 template} <{\cf17 typename} T>\par
3168 {\cf17 struct }Gen<T, 0>\par
3169 \{\par
3170     {\cf17 using }type = integer_sequence<T>;\par
3171 \};\par
3172 \par
3173 \}  {\cf20 // namespace utility_internal}\par
