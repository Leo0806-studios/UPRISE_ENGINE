16543     CharType ubjson_prefix({\cf17 const} BasicJsonType& j, {\cf17 const} {\cf18 bool} use_bjdata) {\cf17 const} {\cf17 noexcept}\par
16544     \{\par
16545         {\cf19 switch} (j.type())\par
16546         \{\par
16547             {\cf19 case} value_t::null:\par
16548                 {\cf19 return} {\cf23 'Z'};\par
16549 \par
16550             {\cf19 case} value_t::boolean:\par
16551                 {\cf19 return} j.m_data.m_value.boolean ? {\cf23 'T'} : {\cf23 'F'};\par
16552 \par
16553             {\cf19 case} value_t::number_integer:\par
16554             \{\par
16555                 {\cf19 if} ((std::numeric_limits<std::int8_t>::min)() <= j.m_data.m_value.number_integer && j.m_data.m_value.number_integer <= (std::numeric_limits<std::int8_t>::max)())\par
16556                 \{\par
16557                     {\cf19 return} {\cf23 'i'};\par
16558                 \}\par
16559                 {\cf19 if} ((std::numeric_limits<std::uint8_t>::min)() <= j.m_data.m_value.number_integer && j.m_data.m_value.number_integer <= (std::numeric_limits<std::uint8_t>::max)())\par
16560                 \{\par
16561                     {\cf19 return} {\cf23 'U'};\par
16562                 \}\par
16563                 {\cf19 if} ((std::numeric_limits<std::int16_t>::min)() <= j.m_data.m_value.number_integer && j.m_data.m_value.number_integer <= (std::numeric_limits<std::int16_t>::max)())\par
16564                 \{\par
16565                     {\cf19 return} {\cf23 'I'};\par
16566                 \}\par
16567                 {\cf19 if} (use_bjdata && ((std::numeric_limits<std::uint16_t>::min)() <= j.m_data.m_value.number_integer && j.m_data.m_value.number_integer <= (std::numeric_limits<std::uint16_t>::max)()))\par
16568                 \{\par
16569                     {\cf19 return} {\cf23 'u'};\par
16570                 \}\par
16571                 {\cf19 if} ((std::numeric_limits<std::int32_t>::min)() <= j.m_data.m_value.number_integer && j.m_data.m_value.number_integer <= (std::numeric_limits<std::int32_t>::max)())\par
16572                 \{\par
16573                     {\cf19 return} {\cf23 'l'};\par
16574                 \}\par
16575                 {\cf19 if} (use_bjdata && ((std::numeric_limits<std::uint32_t>::min)() <= j.m_data.m_value.number_integer && j.m_data.m_value.number_integer <= (std::numeric_limits<std::uint32_t>::max)()))\par
16576                 \{\par
16577                     {\cf19 return} {\cf23 'm'};\par
16578                 \}\par
16579                 {\cf19 if} ((std::numeric_limits<std::int64_t>::min)() <= j.m_data.m_value.number_integer && j.m_data.m_value.number_integer <= (std::numeric_limits<std::int64_t>::max)())\par
16580                 \{\par
16581                     {\cf19 return} {\cf23 'L'};\par
16582                 \}\par
16583                 {\cf20 // anything else is treated as high-precision number}\par
16584                 {\cf19 return} {\cf23 'H'}; {\cf20 // LCOV_EXCL_LINE}\par
16585             \}\par
16586 \par
16587             {\cf19 case} value_t::number_unsigned:\par
16588             \{\par
16589                 {\cf19 if} (j.m_data.m_value.number_unsigned <= {\cf17 static_cast<}std::uint64_t{\cf17 >}((std::numeric_limits<std::int8_t>::max)()))\par
16590                 \{\par
16591                     {\cf19 return} {\cf23 'i'};\par
16592                 \}\par
16593                 {\cf19 if} (j.m_data.m_value.number_unsigned <= {\cf17 static_cast<}std::uint64_t{\cf17 >}((std::numeric_limits<std::uint8_t>::max)()))\par
16594                 \{\par
16595                     {\cf19 return} {\cf23 'U'};\par
16596                 \}\par
16597                 {\cf19 if} (j.m_data.m_value.number_unsigned <= {\cf17 static_cast<}std::uint64_t{\cf17 >}((std::numeric_limits<std::int16_t>::max)()))\par
16598                 \{\par
16599                     {\cf19 return} {\cf23 'I'};\par
16600                 \}\par
16601                 {\cf19 if} (use_bjdata && j.m_data.m_value.number_unsigned <= {\cf17 static_cast<}std::uint64_t{\cf17 >}((std::numeric_limits<std::uint16_t>::max)()))\par
16602                 \{\par
16603                     {\cf19 return} {\cf23 'u'};\par
16604                 \}\par
16605                 {\cf19 if} (j.m_data.m_value.number_unsigned <= {\cf17 static_cast<}std::uint64_t{\cf17 >}((std::numeric_limits<std::int32_t>::max)()))\par
16606                 \{\par
16607                     {\cf19 return} {\cf23 'l'};\par
16608                 \}\par
16609                 {\cf19 if} (use_bjdata && j.m_data.m_value.number_unsigned <= {\cf17 static_cast<}std::uint64_t{\cf17 >}((std::numeric_limits<std::uint32_t>::max)()))\par
16610                 \{\par
16611                     {\cf19 return} {\cf23 'm'};\par
16612                 \}\par
16613                 {\cf19 if} (j.m_data.m_value.number_unsigned <= {\cf17 static_cast<}std::uint64_t{\cf17 >}((std::numeric_limits<std::int64_t>::max)()))\par
16614                 \{\par
16615                     {\cf19 return} {\cf23 'L'};\par
16616                 \}\par
16617                 {\cf19 if} (use_bjdata && j.m_data.m_value.number_unsigned <= (std::numeric_limits<std::uint64_t>::max)())\par
16618                 \{\par
16619                     {\cf19 return} {\cf23 'M'};\par
16620                 \}\par
16621                 {\cf20 // anything else is treated as high-precision number}\par
16622                 {\cf19 return} {\cf23 'H'}; {\cf20 // LCOV_EXCL_LINE}\par
16623             \}\par
16624 \par
16625             {\cf19 case} value_t::number_float:\par
16626                 {\cf19 return} get_ubjson_float_prefix(j.m_data.m_value.number_float);\par
16627 \par
16628             {\cf19 case} value_t::string:\par
16629                 {\cf19 return} {\cf23 'S'};\par
16630 \par
16631             {\cf19 case} value_t::array: {\cf20 // fallthrough}\par
16632             {\cf19 case} value_t::binary:\par
16633                 {\cf19 return} {\cf23 '['};\par
16634 \par
16635             {\cf19 case} value_t::object:\par
16636                 {\cf19 return} {\cf23 '\{'};\par
16637 \par
16638             {\cf19 case} value_t::discarded:\par
16639             {\cf19 default}:  {\cf20 // discarded values}\par
16640                 {\cf19 return} {\cf23 'N'};\par
16641         \}\par
16642     \}\par
