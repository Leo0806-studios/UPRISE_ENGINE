16800     {\cf18 void} write_compact_float({\cf17 const} number_float_t n, detail::input_format_t format)\par
16801     \{\par
16802 {\cf21 #ifdef __GNUC__}\par
16803 {\cf21 #pragma GCC diagnostic push}\par
16804 {\cf21 #pragma GCC diagnostic ignored "-Wfloat-equal"}\par
16805 {\cf21 #endif}\par
16806         {\cf19 if} ({\cf17 static_cast<}{\cf18 double}{\cf17 >}(n) >= {\cf17 static_cast<}{\cf18 double}{\cf17 >}(std::numeric_limits<float>::lowest()) &&\par
16807                 {\cf17 static_cast<}{\cf18 double}{\cf17 >}(n) <= {\cf17 static_cast<}{\cf18 double}{\cf17 >}((std::numeric_limits<float>::max)()) &&\par
16808                 {\cf17 static_cast<}{\cf18 double}{\cf17 >}({\cf17 static_cast<}{\cf18 float}{\cf17 >}(n)) == {\cf17 static_cast<}{\cf18 double}{\cf17 >}(n))\par
16809         \{\par
16810             oa->write_character(format == detail::input_format_t::cbor\par
16811                                 ? get_cbor_float_prefix({\cf17 static_cast<}{\cf18 float}{\cf17 >}(n))\par
16812                                 : get_msgpack_float_prefix(static_cast<float>(n)));\par
16813             write_number({\cf17 static_cast<}{\cf18 float}{\cf17 >}(n));\par
16814         \}\par
16815         {\cf19 else}\par
16816         \{\par
16817             oa->write_character(format == detail::input_format_t::cbor\par
16818                                 ? get_cbor_float_prefix(n)\par
16819                                 : get_msgpack_float_prefix(n));\par
16820             write_number(n);\par
16821         \}\par
16822 {\cf21 #ifdef __GNUC__}\par
16823 {\cf21 #pragma GCC diagnostic pop}\par
16824 {\cf21 #endif}\par
16825     \}\par
