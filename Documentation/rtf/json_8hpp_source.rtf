17793 {\cf17 template}<{\cf17 typename} FloatType>\par
17794 JSON_HEDLEY_NON_NULL(1)\par
17795 void grisu2({\cf18 char}* buf, {\cf18 int}& len, {\cf18 int}& decimal_exponent, FloatType value)\par
17796 \{\par
17797     {\cf17 static_assert}(diyfp::kPrecision >= std::numeric_limits<FloatType>::digits + 3,\par
17798                   {\cf22 "internal error: not enough precision"});\par
17799 \par
17800     JSON_ASSERT(std::isfinite(value));\par
17801     JSON_ASSERT(value > 0);\par
17802 \par
17803     {\cf20 // If the neighbors (and boundaries) of 'value' are always computed for double-precision}\par
17804     {\cf20 // numbers, all float's can be recovered using strtod (and strtof). However, the resulting}\par
17805     {\cf20 // decimal representations are not exactly "short".}\par
17806     {\cf20 //}\par
17807     {\cf20 // The documentation for 'std::to_chars' (https://en.cppreference.com/w/cpp/utility/to_chars)}\par
17808     {\cf20 // says "value is converted to a string as if by std::sprintf in the default ("C") locale"}\par
17809     {\cf20 // and since sprintf promotes floats to doubles, I think this is exactly what 'std::to_chars'}\par
17810     {\cf20 // does.}\par
17811     {\cf20 // On the other hand, the documentation for 'std::to_chars' requires that "parsing the}\par
17812     {\cf20 // representation using the corresponding std::from_chars function recovers value exactly". That}\par
17813     {\cf20 // indicates that single precision floating-point numbers should be recovered using}\par
17814     {\cf20 // 'std::strtof'.}\par
17815     {\cf20 //}\par
17816     {\cf20 // NB: If the neighbors are computed for single-precision numbers, there is a single float}\par
17817     {\cf20 //     (7.0385307e-26f) which can't be recovered using strtod. The resulting double precision}\par
17818     {\cf20 //     value is off by 1 ulp.}\par
17819 {\cf21 #if 0 }{\cf20 // NOLINT(readability-avoid-unconditional-preprocessor-if)}\par
17820     {\cf17 const} boundaries w = compute_boundaries({\cf17 static_cast<}{\cf18 double}{\cf17 >}(value));\par
17821 {\cf21 #else}\par
17822     {\cf17 const} boundaries w = compute_boundaries(value);\par
17823 {\cf21 #endif}\par
17824 \par
17825     grisu2(buf, len, decimal_exponent, w.minus, w.w, w.plus);\par
17826 \}\par
