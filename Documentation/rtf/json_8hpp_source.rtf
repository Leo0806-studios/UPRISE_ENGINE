16657     {\cf18 bool} write_bjdata_ndarray({\cf17 const} {\cf17 typename} BasicJsonType::object_t& value, {\cf17 const} {\cf18 bool} use_count, {\cf17 const} {\cf18 bool} use_type)\par
16658     \{\par
16659         std::map<string_t, CharType> bjdtype = \{\{{\cf22 "uint8"}, {\cf23 'U'}\},  \{{\cf22 "int8"}, {\cf23 'i'}\},  \{{\cf22 "uint16"}, {\cf23 'u'}\}, \{{\cf22 "int16"}, {\cf23 'I'}\},\par
16660             \{{\cf22 "uint32"}, {\cf23 'm'}\}, \{{\cf22 "int32"}, {\cf23 'l'}\}, \{{\cf22 "uint64"}, {\cf23 'M'}\}, \{{\cf22 "int64"}, {\cf23 'L'}\}, \{{\cf22 "single"}, {\cf23 'd'}\}, \{{\cf22 "double"}, {\cf23 'D'}\}, \{{\cf22 "char"}, {\cf23 'C'}\}\par
16661         \};\par
16662 \par
16663         string_t key = {\cf22 "_ArrayType_"};\par
16664         {\cf17 auto} it = bjdtype.find({\cf17 static_cast<}string_t{\cf17 >}(value.at(key)));\par
16665         {\cf19 if} (it == bjdtype.end())\par
16666         \{\par
16667             {\cf19 return} {\cf17 true};\par
16668         \}\par
16669         CharType dtype = it->second;\par
16670 \par
16671         key = {\cf22 "_ArraySize_"};\par
16672         std::size_t len = (value.at(key).empty() ? 0 : 1);\par
16673         {\cf19 for} ({\cf17 const} {\cf17 auto}& el : value.at(key))\par
16674         \{\par
16675             len *= {\cf17 static_cast<}std::size_t{\cf17 >}(el.m_data.m_value.number_unsigned);\par
16676         \}\par
16677 \par
16678         key = {\cf22 "_ArrayData_"};\par
16679         {\cf19 if} (value.at(key).size() != len)\par
16680         \{\par
16681             {\cf19 return} {\cf17 true};\par
16682         \}\par
