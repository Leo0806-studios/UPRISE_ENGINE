12516                             {\cf19 return} sax->parse_error(m_lexer.get_position(),\par
12517                                                     m_lexer.get_token_string(),\par
12518                                                     parse_error::create(101, m_lexer.get_position(),\par
12519                                                             {\cf22 "attempting to parse an empty input; check that your input string or stream contains the expected JSON"}, {\cf17 nullptr}));\par
12520                         \}\par
12521 \par
12522                         {\cf19 return} sax->parse_error(m_lexer.get_position(),\par
12523                                                 m_lexer.get_token_string(),\par
12524                                                 parse_error::create(101, m_lexer.get_position(), exception_message(token_type::literal_or_value, {\cf22 "value"}), {\cf17 nullptr}));\par
12525                     \}\par
12526                     {\cf19 case} token_type::uninitialized:\par
12527                     {\cf19 case} token_type::end_array:\par
12528                     {\cf19 case} token_type::end_object:\par
12529                     {\cf19 case} token_type::name_separator:\par
12530                     {\cf19 case} token_type::value_separator:\par
12531                     {\cf19 case} token_type::literal_or_value:\par
12532                     {\cf19 default}: {\cf20 // the last token was unexpected}\par
12533                     \{\par
12534                         {\cf19 return} sax->parse_error(m_lexer.get_position(),\par
12535                                                 m_lexer.get_token_string(),\par
12536                                                 parse_error::create(101, m_lexer.get_position(), exception_message(token_type::literal_or_value, {\cf22 "value"}), {\cf17 nullptr}));\par
12537                     \}\par
12538                 \}\par
12539             \}\par
12540             {\cf19 else}\par
12541             \{\par
12542                 skip_to_state_evaluation = {\cf17 false};\par
12543             \}\par
12544 \par
12545             {\cf20 // we reached this line after we successfully parsed a value}\par
12546             {\cf19 if} (states.empty())\par
12547             \{\par
12548                 {\cf20 // empty stack: we reached the end of the hierarchy: done}\par
12549                 {\cf19 return} {\cf17 true};\par
12550             \}\par
12551 \par
12552             {\cf19 if} (states.back())  {\cf20 // array}\par
