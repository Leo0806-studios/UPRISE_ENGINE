24318                 {\cf20 // We now reached the end of at least one array}\par
24319                 {\cf20 // in a second pass, traverse the remaining elements}\par
24320 \par
24321                 {\cf20 // remove my remaining elements}\par
24322                 {\cf17 const} {\cf17 auto} end_index = {\cf17 static_cast<}difference_type{\cf17 >}(result.size());\par
24323                 {\cf19 while} (i < source.size())\par
24324                 \{\par
24325                     {\cf20 // add operations in reverse order to avoid invalid}\par
24326                     {\cf20 // indices}\par
24327                     result.insert(result.begin() + end_index, object(\par
24328                     \{\par
24329                         \{{\cf22 "op"}, {\cf22 "remove"}\},\par
24330                         \{{\cf22 "path"}, detail::concat(path, {\cf23 '/'}, std::to_string(i))\}\par
24331                     \}));\par
24332                     ++i;\par
24333                 \}\par
24334 \par
24335                 {\cf20 // add other remaining elements}\par
24336                 {\cf19 while} (i < target.size())\par
24337                 \{\par
24338                     result.push_back(\par
24339                     \{\par
24340                         \{{\cf22 "op"}, {\cf22 "add"}\},\par
24341                         \{{\cf22 "path"}, detail::concat(path, {\cf22 "/-"})\},\par
24342                         \{{\cf22 "value"}, target[i]\}\par
24343                     \});\par
24344                     ++i;\par
24345                 \}\par
24346 \par
24347                 {\cf19 break};\par
24348             \}\par
24349 \par
24350             {\cf19 case} value_t::object:\par
24351             \{\par
24352                 {\cf20 // first pass: traverse this object's elements}\par
24353                 {\cf19 for} ({\cf17 auto} it = source.cbegin(); it != source.cend(); ++it)\par
24354                 \{\par
24355                     {\cf20 // escape the key name to be used in a JSON patch}\par
24356                     {\cf17 const} {\cf17 auto} path_key = detail::concat(path, {\cf23 '/'}, detail::escape(it.key()));\par
24357 \par
24358                     {\cf19 if} (target.find(it.key()) != target.end())\par
24359                     \{\par
24360                         {\cf20 // recursive call to compare object values at key it}\par
24361                         {\cf17 auto} temp_diff = diff(it.value(), target[it.key()], path_key);\par
24362                         result.insert(result.end(), temp_diff.begin(), temp_diff.end());\par
24363                     \}\par
24364                     {\cf19 else}\par
24365                     \{\par
24366                         {\cf20 // found a key that is not in o -> remove it}\par
24367                         result.push_back({\cf18 object}(\par
24368                         \{\par
24369                             \{{\cf22 "op"}, {\cf22 "remove"}\}, \{{\cf22 "path"}, path_key\}\par
24370                         \}));\par
24371                     \}\par
24372                 \}\par
24373 \par
24374                 {\cf20 // second pass: traverse other object's elements}\par
24375                 {\cf19 for} ({\cf17 auto} it = target.cbegin(); it != target.cend(); ++it)\par
24376                 \{\par
24377                     {\cf19 if} (source.find(it.key()) == source.end())\par
24378                     \{\par
24379                         {\cf20 // found a key that is not in this -> add it}\par
24380                         {\cf17 const} {\cf17 auto} path_key = detail::concat(path, {\cf23 '/'}, detail::escape(it.key()));\par
24381                         result.push_back(\par
24382                         \{\par
24383                             \{{\cf22 "op"}, {\cf22 "add"}\}, \{{\cf22 "path"}, path_key\},\par
24384                             \{{\cf22 "value"}, it.value()\}\par
24385                         \});\par
24386                     \}\par
24387                 \}\par
24388 \par
24389                 {\cf19 break};\par
24390             \}\par
24391 \par
24392             {\cf19 case} value_t::null:\par
24393             {\cf19 case} value_t::string:\par
24394             {\cf19 case} value_t::boolean:\par
24395             {\cf19 case} value_t::number_integer:\par
24396             {\cf19 case} value_t::number_unsigned:\par
24397             {\cf19 case} value_t::number_float:\par
24398             {\cf19 case} value_t::binary:\par
24399             {\cf19 case} value_t::discarded:\par
24400             {\cf19 default}:\par
24401             \{\par
24402                 {\cf20 // both primitive type: replace value}\par
24403                 result.push_back(\par
24404                 \{\par
24405                     \{{\cf22 "op"}, {\cf22 "replace"}\}, \{{\cf22 "path"}, path\}, \{{\cf22 "value"}, target\}\par
24406                 \});\par
24407                 {\cf19 break};\par
24408             \}\par
24409         \}\par
24410 \par
24411         {\cf19 return} result;\par
