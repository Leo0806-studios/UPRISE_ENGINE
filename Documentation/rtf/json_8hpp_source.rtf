17494 {\cf17 inline} {\cf18 void} grisu2_digit_gen({\cf18 char}* buffer, {\cf18 int}& length, {\cf18 int}& decimal_exponent,\par
17495                              diyfp M_minus, diyfp w, diyfp M_plus)\par
17496 \{\par
17497     {\cf17 static_assert}(kAlpha >= -60, {\cf22 "internal error"});\par
17498     {\cf17 static_assert}(kGamma <= -32, {\cf22 "internal error"});\par
17499 \par
17500     {\cf20 // Generates the digits (and the exponent) of a decimal floating-point}\par
17501     {\cf20 // number V = buffer * 10^decimal_exponent in the range [M-, M+]. The diyfp's}\par
17502     {\cf20 // w, M- and M+ share the same exponent e, which satisfies alpha <= e <= gamma.}\par
17503     {\cf20 //}\par
17504     {\cf20 //               <--------------------------- delta ---->}\par
17505     {\cf20 //                                  <---- dist --------->}\par
17506     {\cf20 // --------------[------------------+-------------------]--------------}\par
17507     {\cf20 //               M-                 w                   M+}\par
17508     {\cf20 //}\par
17509     {\cf20 // Grisu2 generates the digits of M+ from left to right and stops as soon as}\par
17510     {\cf20 // V is in [M-,M+].}\par
17511 \par
17512     JSON_ASSERT(M_plus.e >= kAlpha);\par
17513     JSON_ASSERT(M_plus.e <= kGamma);\par
17514 \par
17515     std::uint64_t delta = diyfp::sub(M_plus, M_minus).f; {\cf20 // (significand of (M+ - M-), implicit exponent is e)}\par
17516     std::uint64_t dist  = diyfp::sub(M_plus, w      ).f; {\cf20 // (significand of (M+ - w ), implicit exponent is e)}\par
17517 \par
17518     {\cf20 // Split M+ = f * 2^e into two parts p1 and p2 (note: e < 0):}\par
17519     {\cf20 //}\par
17520     {\cf20 //      M+ = f * 2^e}\par
17521     {\cf20 //         = ((f div 2^-e) * 2^-e + (f mod 2^-e)) * 2^e}\par
17522     {\cf20 //         = ((p1        ) * 2^-e + (p2        )) * 2^e}\par
17523     {\cf20 //         = p1 + p2 * 2^e}\par
17524 \par
17525     {\cf17 const} diyfp one(std::uint64_t\{1\} << -M_plus.e, M_plus.e);\par
17526 \par
17527     {\cf17 auto} p1 = {\cf17 static_cast<}std::uint32_t{\cf17 >}(M_plus.f >> -one.e); {\cf20 // p1 = f div 2^-e (Since -e >= 32, p1 fits into a 32-bit int.)}\par
17528     std::uint64_t p2 = M_plus.f & (one.f - 1);                    {\cf20 // p2 = f mod 2^-e}\par
17529 \par
17530     {\cf20 // 1)}\par
17531     {\cf20 //}\par
17532     {\cf20 // Generate the digits of the integral part p1 = d[n-1]...d[1]d[0]}\par
17533 \par
17534     JSON_ASSERT(p1 > 0);\par
17535 \par
17536     std::uint32_t pow10\{\};\par
17537     {\cf17 const} {\cf18 int} k = find_largest_pow10(p1, pow10);\par
17538 \par
17539     {\cf20 //      10^(k-1) <= p1 < 10^k, pow10 = 10^(k-1)}\par
17540     {\cf20 //}\par
17541     {\cf20 //      p1 = (p1 div 10^(k-1)) * 10^(k-1) + (p1 mod 10^(k-1))}\par
17542     {\cf20 //         = (d[k-1]         ) * 10^(k-1) + (p1 mod 10^(k-1))}\par
17543     {\cf20 //}\par
17544     {\cf20 //      M+ = p1                                             + p2 * 2^e}\par
17545     {\cf20 //         = d[k-1] * 10^(k-1) + (p1 mod 10^(k-1))          + p2 * 2^e}\par
17546     {\cf20 //         = d[k-1] * 10^(k-1) + ((p1 mod 10^(k-1)) * 2^-e + p2) * 2^e}\par
17547     {\cf20 //         = d[k-1] * 10^(k-1) + (                         rest) * 2^e}\par
17548     {\cf20 //}\par
17549     {\cf20 // Now generate the digits d[n] of p1 from left to right (n = k-1,...,0)}\par
17550     {\cf20 //}\par
17551     {\cf20 //      p1 = d[k-1]...d[n] * 10^n + d[n-1]...d[0]}\par
17552     {\cf20 //}\par
17553     {\cf20 // but stop as soon as}\par
17554     {\cf20 //}\par
17555     {\cf20 //      rest * 2^e = (d[n-1]...d[0] * 2^-e + p2) * 2^e <= delta * 2^e}\par
17556 \par
17557     {\cf18 int} n = k;\par
17558     {\cf19 while} (n > 0)\par
17559     \{\par
17560         {\cf20 // Invariants:}\par
17561         {\cf20 //      M+ = buffer * 10^n + (p1 + p2 * 2^e)    (buffer = 0 for n = k)}\par
17562         {\cf20 //      pow10 = 10^(n-1) <= p1 < 10^n}\par
17563         {\cf20 //}\par
17564         {\cf17 const} std::uint32_t d = p1 / pow10;  {\cf20 // d = p1 div 10^(n-1)}\par
17565         {\cf17 const} std::uint32_t r = p1 % pow10;  {\cf20 // r = p1 mod 10^(n-1)}\par
17566         {\cf20 //}\par
17567         {\cf20 //      M+ = buffer * 10^n + (d * 10^(n-1) + r) + p2 * 2^e}\par
17568         {\cf20 //         = (buffer * 10 + d) * 10^(n-1) + (r + p2 * 2^e)}\par
17569         {\cf20 //}\par
17570         JSON_ASSERT(d <= 9);\par
17571         buffer[length++] = {\cf17 static_cast<}{\cf18 char}{\cf17 >}({\cf23 '0'} + d); {\cf20 // buffer := buffer * 10 + d}\par
17572         {\cf20 //}\par
17573         {\cf20 //      M+ = buffer * 10^(n-1) + (r + p2 * 2^e)}\par
17574         {\cf20 //}\par
17575         p1 = r;\par
17576         n--;\par
17577         {\cf20 //}\par
17578         {\cf20 //      M+ = buffer * 10^n + (p1 + p2 * 2^e)}\par
17579         {\cf20 //      pow10 = 10^n}\par
17580         {\cf20 //}\par
17581 \par
17582         {\cf20 // Now check if enough digits have been generated.}\par
17583         {\cf20 // Compute}\par
17584         {\cf20 //}\par
17585         {\cf20 //      p1 + p2 * 2^e = (p1 * 2^-e + p2) * 2^e = rest * 2^e}\par
17586         {\cf20 //}\par
17587         {\cf20 // Note:}\par
17588         {\cf20 // Since rest and delta share the same exponent e, it suffices to}\par
17589         {\cf20 // compare the significands.}\par
17590         {\cf17 const} std::uint64_t rest = (std::uint64_t\{p1\} << -one.e) + p2;\par
17591         {\cf19 if} (rest <= delta)\par
17592         \{\par
17593             {\cf20 // V = buffer * 10^n, with M- <= V <= M+.}\par
17594 \par
17595             decimal_exponent += n;\par
17596 \par
17597             {\cf20 // We may now just stop. But instead look if the buffer could be}\par
17598             {\cf20 // decremented to bring V closer to w.}\par
17599             {\cf20 //}\par
17600             {\cf20 // pow10 = 10^n is now 1 ulp in the decimal representation V.}\par
17601             {\cf20 // The rounding procedure works with diyfp's with an implicit}\par
17602             {\cf20 // exponent of e.}\par
17603             {\cf20 //}\par
17604             {\cf20 //      10^n = (10^n * 2^-e) * 2^e = ulp * 2^e}\par
17605             {\cf20 //}\par
17606             {\cf17 const} std::uint64_t ten_n = std::uint64_t\{pow10\} << -one.e;\par
17607             grisu2_round(buffer, length, dist, delta, rest, ten_n);\par
17608 \par
17609             {\cf19 return};\par
17610         \}\par
17611 \par
17612         pow10 /= 10;\par
17613         {\cf20 //}\par
17614         {\cf20 //      pow10 = 10^(n-1) <= p1 < 10^n}\par
17615         {\cf20 // Invariants restored.}\par
17616     \}\par
17617 \par
17618     {\cf20 // 2)}\par
17619     {\cf20 //}\par
17620     {\cf20 // The digits of the integral part have been generated:}\par
17621     {\cf20 //}\par
17622     {\cf20 //      M+ = d[k-1]...d[1]d[0] + p2 * 2^e}\par
17623     {\cf20 //         = buffer            + p2 * 2^e}\par
17624     {\cf20 //}\par
17625     {\cf20 // Now generate the digits of the fractional part p2 * 2^e.}\par
17626     {\cf20 //}\par
17627     {\cf20 // Note:}\par
17628     {\cf20 // No decimal point is generated: the exponent is adjusted instead.}\par
17629     {\cf20 //}\par
17630     {\cf20 // p2 actually represents the fraction}\par
17631     {\cf20 //}\par
17632     {\cf20 //      p2 * 2^e}\par
17633     {\cf20 //          = p2 / 2^-e}\par
17634     {\cf20 //          = d[-1] / 10^1 + d[-2] / 10^2 + ...}\par
17635     {\cf20 //}\par
17636     {\cf20 // Now generate the digits d[-m] of p1 from left to right (m = 1,2,...)}\par
17637     {\cf20 //}\par
17638     {\cf20 //      p2 * 2^e = d[-1]d[-2]...d[-m] * 10^-m}\par
17639     {\cf20 //                      + 10^-m * (d[-m-1] / 10^1 + d[-m-2] / 10^2 + ...)}\par
17640     {\cf20 //}\par
17641     {\cf20 // using}\par
17642     {\cf20 //}\par
17643     {\cf20 //      10^m * p2 = ((10^m * p2) div 2^-e) * 2^-e + ((10^m * p2) mod 2^-e)}\par
17644     {\cf20 //                = (                   d) * 2^-e + (                   r)}\par
17645     {\cf20 //}\par
17646     {\cf20 // or}\par
17647     {\cf20 //      10^m * p2 * 2^e = d + r * 2^e}\par
17648     {\cf20 //}\par
17649     {\cf20 // i.e.}\par
17650     {\cf20 //}\par
17651     {\cf20 //      M+ = buffer + p2 * 2^e}\par
17652     {\cf20 //         = buffer + 10^-m * (d + r * 2^e)}\par
17653     {\cf20 //         = (buffer * 10^m + d) * 10^-m + 10^-m * r * 2^e}\par
17654     {\cf20 //}\par
17655     {\cf20 // and stop as soon as 10^-m * r * 2^e <= delta * 2^e}\par
17656 \par
17657     JSON_ASSERT(p2 > delta);\par
17658 \par
17659     {\cf18 int} m = 0;\par
17660     {\cf19 for} (;;)\par
17661     \{\par
17662         {\cf20 // Invariant:}\par
17663         {\cf20 //      M+ = buffer * 10^-m + 10^-m * (d[-m-1] / 10 + d[-m-2] / 10^2 + ...) * 2^e}\par
17664         {\cf20 //         = buffer * 10^-m + 10^-m * (p2                                 ) * 2^e}\par
17665         {\cf20 //         = buffer * 10^-m + 10^-m * (1/10 * (10 * p2)                   ) * 2^e}\par
17666         {\cf20 //         = buffer * 10^-m + 10^-m * (1/10 * ((10*p2 div 2^-e) * 2^-e + (10*p2 mod 2^-e)) * 2^e}\par
17667         {\cf20 //}\par
17668         JSON_ASSERT(p2 <= (std::numeric_limits<std::uint64_t>::max)() / 10);\par
17669         p2 *= 10;\par
17670         {\cf17 const} std::uint64_t d = p2 >> -one.e;     {\cf20 // d = (10 * p2) div 2^-e}\par
17671         {\cf17 const} std::uint64_t r = p2 & (one.f - 1); {\cf20 // r = (10 * p2) mod 2^-e}\par
17672         {\cf20 //}\par
17673         {\cf20 //      M+ = buffer * 10^-m + 10^-m * (1/10 * (d * 2^-e + r) * 2^e}\par
17674         {\cf20 //         = buffer * 10^-m + 10^-m * (1/10 * (d + r * 2^e))}\par
17675         {\cf20 //         = (buffer * 10 + d) * 10^(-m-1) + 10^(-m-1) * r * 2^e}\par
17676         {\cf20 //}\par
17677         JSON_ASSERT(d <= 9);\par
17678         buffer[length++] = {\cf17 static_cast<}{\cf18 char}{\cf17 >}({\cf23 '0'} + d); {\cf20 // buffer := buffer * 10 + d}\par
17679         {\cf20 //}\par
17680         {\cf20 //      M+ = buffer * 10^(-m-1) + 10^(-m-1) * r * 2^e}\par
17681         {\cf20 //}\par
17682         p2 = r;\par
17683         m++;\par
17684         {\cf20 //}\par
17685         {\cf20 //      M+ = buffer * 10^-m + 10^-m * p2 * 2^e}\par
17686         {\cf20 // Invariant restored.}\par
17687 \par
17688         {\cf20 // Check if enough digits have been generated.}\par
17689         {\cf20 //}\par
17690         {\cf20 //      10^-m * p2 * 2^e <= delta * 2^e}\par
17691         {\cf20 //              p2 * 2^e <= 10^m * delta * 2^e}\par
17692         {\cf20 //                    p2 <= 10^m * delta}\par
17693         delta *= 10;\par
17694         dist  *= 10;\par
17695         {\cf19 if} (p2 <= delta)\par
17696         \{\par
17697             {\cf19 break};\par
17698         \}\par
17699     \}\par
17700 \par
17701     {\cf20 // V = buffer * 10^-m, with M- <= V <= M+.}\par
17702 \par
17703     decimal_exponent -= m;\par
17704 \par
17705     {\cf20 // 1 ulp in the decimal representation is now 10^-m.}\par
17706     {\cf20 // Since delta and dist are now scaled by 10^m, we need to do the}\par
17707     {\cf20 // same with ulp in order to keep the units in sync.}\par
17708     {\cf20 //}\par
17709     {\cf20 //      10^m * 10^-m = 1 = 2^-e * 2^e = ten_m * 2^e}\par
17710     {\cf20 //}\par
17711     {\cf17 const} std::uint64_t ten_m = one.f;\par
17712     grisu2_round(buffer, length, dist, delta, p2, ten_m);\par
17713 \par
17714     {\cf20 // By construction this algorithm generates the shortest possible decimal}\par
17715     {\cf20 // number (Loitsch, Theorem 6.2) which rounds back to w.}\par
17716     {\cf20 // For an input number of precision p, at least}\par
17717     {\cf20 //}\par
17718     {\cf20 //      N = 1 + ceil(p * log_10(2))}\par
17719     {\cf20 //}\par
17720     {\cf20 // decimal digits are sufficient to identify all binary floating-point}\par
17721     {\cf20 // numbers (Matula, "In-and-Out conversions").}\par
17722     {\cf20 // This implies that the algorithm does not produce more than N decimal}\par
17723     {\cf20 // digits.}\par
17724     {\cf20 //}\par
17725     {\cf20 //      N = 17 for p = 53 (IEEE double precision)}\par
17726     {\cf20 //      N = 9  for p = 24 (IEEE single precision)}\par
17727 \}\par
17728 \par
17734 JSON_HEDLEY_NON_NULL(1)\par
17735 inline {\cf18 void} grisu2({\cf18 char}* buf, {\cf18 int}& len, {\cf18 int}& decimal_exponent,\par
17736                    diyfp m_minus, diyfp v, diyfp m_plus)\par
17737 \{\par
17738     JSON_ASSERT(m_plus.e == m_minus.e);\par
17739     JSON_ASSERT(m_plus.e == v.e);\par
17740 \par
17741     {\cf20 //  --------(-----------------------+-----------------------)--------    (A)}\par
17742     {\cf20 //          m-                      v                       m+}\par
17743     {\cf20 //}\par
17744     {\cf20 //  --------------------(-----------+-----------------------)--------    (B)}\par
17745     {\cf20 //                      m-          v                       m+}\par
17746     {\cf20 //}\par
17747     {\cf20 // First scale v (and m- and m+) such that the exponent is in the range}\par
17748     {\cf20 // [alpha, gamma].}\par
17749 \par
17750     {\cf17 const} cached_power cached = get_cached_power_for_binary_exponent(m_plus.e);\par
17751 \par
17752     {\cf17 const} diyfp c_minus_k(cached.f, cached.e); {\cf20 // = c ~= 10^-k}\par
17753 \par
17754     {\cf20 // The exponent of the products is = v.e + c_minus_k.e + q and is in the range [alpha,gamma]}\par
17755     {\cf17 const} diyfp w       = diyfp::mul(v,       c_minus_k);\par
17756     {\cf17 const} diyfp w_minus = diyfp::mul(m_minus, c_minus_k);\par
17757     {\cf17 const} diyfp w_plus  = diyfp::mul(m_plus,  c_minus_k);\par
17758 \par
17759     {\cf20 //  ----(---+---)---------------(---+---)---------------(---+---)----}\par
17760     {\cf20 //          w-                      w                       w+}\par
17761     {\cf20 //          = c*m-                  = c*v                   = c*m+}\par
17762     {\cf20 //}\par
17763     {\cf20 // diyfp::mul rounds its result and c_minus_k is approximated too. w, w- and}\par
17764     {\cf20 // w+ are now off by a small amount.}\par
17765     {\cf20 // In fact:}\par
17766     {\cf20 //}\par
17767     {\cf20 //      w - v * 10^k < 1 ulp}\par
17768     {\cf20 //}\par
17769     {\cf20 // To account for this inaccuracy, add resp. subtract 1 ulp.}\par
17770     {\cf20 //}\par
17771     {\cf20 //  --------+---[---------------(---+---)---------------]---+--------}\par
17772     {\cf20 //          w-  M-                  w                   M+  w+}\par
17773     {\cf20 //}\par
17774     {\cf20 // Now any number in [M-, M+] (bounds included) will round to w when input,}\par
17775     {\cf20 // regardless of how the input rounding algorithm breaks ties.}\par
17776     {\cf20 //}\par
17777     {\cf20 // And digit_gen generates the shortest possible such number in [M-, M+].}\par
17778     {\cf20 // Note that this does not mean that Grisu2 always generates the shortest}\par
17779     {\cf20 // possible number in the interval (m-, m+).}\par
17780     {\cf17 const} diyfp M_minus(w_minus.f + 1, w_minus.e);\par
17781     {\cf17 const} diyfp M_plus (w_plus.f  - 1, w_plus.e );\par
17782 \par
17783     decimal_exponent = -cached.k; {\cf20 // = -(-k) = k}\par
17784 \par
17785     grisu2_digit_gen(buf, len, decimal_exponent, M_minus, w, M_plus);\par
17786 \}\par
