16964 {\cf17 struct }diyfp {\cf20 // f * 2^e}\par
16965 \{\par
16966     {\cf17 static} {\cf17 constexpr} {\cf18 int} kPrecision = 64; {\cf20 // = q}\par
16967 \par
16968     std::uint64_t f = 0;\par
16969     {\cf18 int} e = 0;\par
16970 \par
16971     {\cf17 constexpr} diyfp(std::uint64_t f_, {\cf18 int} e_) noexcept : f(f_), e(e_) \{\}\par
16972 \par
16977     {\cf17 static} diyfp sub({\cf17 const} diyfp& x, {\cf17 const} diyfp& y) {\cf17 noexcept}\par
16978     \{\par
16979         JSON_ASSERT(x.e == y.e);\par
16980         JSON_ASSERT(x.f >= y.f);\par
16981 \par
16982         {\cf19 return} \{x.f - y.f, x.e\};\par
16983     \}\par
16984 \par
16989     {\cf17 static} diyfp mul({\cf17 const} diyfp& x, {\cf17 const} diyfp& y) {\cf17 noexcept}\par
16990     \{\par
16991         {\cf17 static_assert}(kPrecision == 64, {\cf22 "internal error"});\par
16992 \par
16993         {\cf20 // Computes:}\par
16994         {\cf20 //  f = round((x.f * y.f) / 2^q)}\par
16995         {\cf20 //  e = x.e + y.e + q}\par
16996 \par
16997         {\cf20 // Emulate the 64-bit * 64-bit multiplication:}\par
16998         {\cf20 //}\par
16999         {\cf20 // p = u * v}\par
17000         {\cf20 //   = (u_lo + 2^32 u_hi) (v_lo + 2^32 v_hi)}\par
17001         {\cf20 //   = (u_lo v_lo         ) + 2^32 ((u_lo v_hi         ) + (u_hi v_lo         )) + 2^64 (u_hi v_hi         )}\par
17002         {\cf20 //   = (p0                ) + 2^32 ((p1                ) + (p2                )) + 2^64 (p3                )}\par
17003         {\cf20 //   = (p0_lo + 2^32 p0_hi) + 2^32 ((p1_lo + 2^32 p1_hi) + (p2_lo + 2^32 p2_hi)) + 2^64 (p3                )}\par
17004         {\cf20 //   = (p0_lo             ) + 2^32 (p0_hi + p1_lo + p2_lo                      ) + 2^64 (p1_hi + p2_hi + p3)}\par
17005         {\cf20 //   = (p0_lo             ) + 2^32 (Q                                          ) + 2^64 (H                 )}\par
17006         {\cf20 //   = (p0_lo             ) + 2^32 (Q_lo + 2^32 Q_hi                           ) + 2^64 (H                 )}\par
17007         {\cf20 //}\par
17008         {\cf20 // (Since Q might be larger than 2^32 - 1)}\par
17009         {\cf20 //}\par
17010         {\cf20 //   = (p0_lo + 2^32 Q_lo) + 2^64 (Q_hi + H)}\par
17011         {\cf20 //}\par
17012         {\cf20 // (Q_hi + H does not overflow a 64-bit int)}\par
17013         {\cf20 //}\par
17014         {\cf20 //   = p_lo + 2^64 p_hi}\par
17015 \par
17016         {\cf17 const} std::uint64_t u_lo = x.f & 0xFFFFFFFFu;\par
17017         {\cf17 const} std::uint64_t u_hi = x.f >> 32u;\par
17018         {\cf17 const} std::uint64_t v_lo = y.f & 0xFFFFFFFFu;\par
17019         {\cf17 const} std::uint64_t v_hi = y.f >> 32u;\par
17020 \par
17021         {\cf17 const} std::uint64_t p0 = u_lo * v_lo;\par
17022         {\cf17 const} std::uint64_t p1 = u_lo * v_hi;\par
17023         {\cf17 const} std::uint64_t p2 = u_hi * v_lo;\par
17024         {\cf17 const} std::uint64_t p3 = u_hi * v_hi;\par
17025 \par
17026         {\cf17 const} std::uint64_t p0_hi = p0 >> 32u;\par
17027         {\cf17 const} std::uint64_t p1_lo = p1 & 0xFFFFFFFFu;\par
17028         {\cf17 const} std::uint64_t p1_hi = p1 >> 32u;\par
17029         {\cf17 const} std::uint64_t p2_lo = p2 & 0xFFFFFFFFu;\par
17030         {\cf17 const} std::uint64_t p2_hi = p2 >> 32u;\par
17031 \par
17032         std::uint64_t Q = p0_hi + p1_lo + p2_lo;\par
17033 \par
17034         {\cf20 // The full product might now be computed as}\par
17035         {\cf20 //}\par
17036         {\cf20 // p_hi = p3 + p2_hi + p1_hi + (Q >> 32)}\par
17037         {\cf20 // p_lo = p0_lo + (Q << 32)}\par
17038         {\cf20 //}\par
17039         {\cf20 // But in this particular case here, the full p_lo is not required.}\par
17040         {\cf20 // Effectively we only need to add the highest bit in p_lo to p_hi (and}\par
17041         {\cf20 // Q_hi + 1 does not overflow).}\par
17042 \par
17043         Q += std::uint64_t\{1\} << (64u - 32u - 1u); {\cf20 // round, ties up}\par
17044 \par
17045         {\cf17 const} std::uint64_t h = p3 + p2_hi + p1_hi + (Q >> 32u);\par
17046 \par
17047         {\cf19 return} \{h, x.e + y.e + 64\};\par
17048     \}\par
17049 \par
17054     {\cf17 static} diyfp normalize(diyfp x) {\cf17 noexcept}\par
17055     \{\par
17056         JSON_ASSERT(x.f != 0);\par
17057 \par
17058         {\cf19 while} ((x.f >> 63u) == 0)\par
17059         \{\par
17060             x.f <<= 1u;\par
17061             x.e--;\par
17062         \}\par
17063 \par
17064         {\cf19 return} x;\par
17065     \}\par
17066 \par
17071     {\cf17 static} diyfp normalize_to({\cf17 const} diyfp& x, {\cf17 const} {\cf18 int} target_exponent) {\cf17 noexcept}\par
17072     \{\par
17073         {\cf17 const} {\cf18 int} delta = x.e - target_exponent;\par
17074 \par
17075         JSON_ASSERT(delta >= 0);\par
17076         JSON_ASSERT(((x.f << delta) >> delta) == x.f);\par
17077 \par
17078         {\cf19 return} \{x.f << delta, target_exponent\};\par
17079     \}\par
17080 \};\par
