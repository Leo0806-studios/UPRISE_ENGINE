9249     bool sax_parse(const input_format_t format,\par
9250                    json_sax_t* sax_,\par
9251                    const {\cf18 bool} strict = true,\par
9252                    const cbor_tag_handler_t tag_handler = cbor_tag_handler_t::error)\par
9253     \{\par
9254         sax = sax_;\par
9255         {\cf18 bool} result = {\cf17 false};\par
9256 \par
9257         {\cf19 switch} (format)\par
9258         \{\par
9259             {\cf19 case} input_format_t::bson:\par
9260                 result = parse_bson_internal();\par
9261                 {\cf19 break};\par
9262 \par
9263             {\cf19 case} input_format_t::cbor:\par
9264                 result = parse_cbor_internal({\cf17 true}, tag_handler);\par
9265                 {\cf19 break};\par
9266 \par
9267             {\cf19 case} input_format_t::msgpack:\par
9268                 result = parse_msgpack_internal();\par
9269                 {\cf19 break};\par
9270 \par
9271             {\cf19 case} input_format_t::ubjson:\par
9272             {\cf19 case} input_format_t::bjdata:\par
9273                 result = parse_ubjson_internal();\par
9274                 {\cf19 break};\par
9275 \par
9276             {\cf19 case} input_format_t::json: {\cf20 // LCOV_EXCL_LINE}\par
9277             {\cf19 default}:            {\cf20 // LCOV_EXCL_LINE}\par
9278                 JSON_ASSERT({\cf17 false}); {\cf20 // NOLINT(cert-dcl03-c,hicpp-static-assert,misc-static-assert) LCOV_EXCL_LINE}\par
9279         \}\par
9280 \par
9281         {\cf20 // strict mode: next byte must be EOF}\par
9282         {\cf19 if} (result && strict)\par
9283         \{\par
9284             {\cf19 if} (input_format == input_format_t::ubjson || input_format == input_format_t::bjdata)\par
9285             \{\par
9286                 get_ignore_noop();\par
9287             \}\par
9288             {\cf19 else}\par
9289             \{\par
9290                 get();\par
9291             \}\par
9292 \par
9293             {\cf19 if} (JSON_HEDLEY_UNLIKELY(current != char_traits<char_type>::eof()))\par
9294             \{\par
9295                 {\cf19 return} sax->parse_error(chars_read, get_token_string(), parse_error::create(110, chars_read,\par
9296                                         exception_message(input_format, concat({\cf22 "expected end of input; last byte: 0x"}, get_token_string()), {\cf22 "value"}), {\cf17 nullptr}));\par
