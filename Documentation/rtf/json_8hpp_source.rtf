24120                     parent.erase(it);\par
24121                 \}\par
24122                 {\cf19 else}\par
24123                 \{\par
24124                     JSON_THROW(out_of_range::create(403, detail::concat({\cf22 "key '"}, last_path, {\cf22 "' not found"}), {\cf17 this}));\par
24125                 \}\par
24126             \}\par
24127             {\cf19 else} {\cf19 if} (parent.is_array())\par
24128             \{\par
24129                 {\cf20 // note erase performs range check}\par
24130                 parent.erase(json_pointer::template array_index<basic_json_t>(last_path));\par
