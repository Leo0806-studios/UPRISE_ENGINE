17453 {\cf17 inline} {\cf18 void} grisu2_round({\cf18 char}* buf, {\cf18 int} len, std::uint64_t dist, std::uint64_t delta,\par
17454                          std::uint64_t rest, std::uint64_t ten_k)\par
17455 \{\par
17456     JSON_ASSERT(len >= 1);\par
17457     JSON_ASSERT(dist <= delta);\par
17458     JSON_ASSERT(rest <= delta);\par
17459     JSON_ASSERT(ten_k > 0);\par
17460 \par
17461     {\cf20 //               <--------------------------- delta ---->}\par
17462     {\cf20 //                                  <---- dist --------->}\par
17463     {\cf20 // --------------[------------------+-------------------]--------------}\par
17464     {\cf20 //               M-                 w                   M+}\par
17465     {\cf20 //}\par
17466     {\cf20 //                                  ten_k}\par
17467     {\cf20 //                                <------>}\par
17468     {\cf20 //                                       <---- rest ---->}\par
17469     {\cf20 // --------------[------------------+----+--------------]--------------}\par
17470     {\cf20 //                                  w    V}\par
17471     {\cf20 //                                       = buf * 10^k}\par
17472     {\cf20 //}\par
17473     {\cf20 // ten_k represents a unit-in-the-last-place in the decimal representation}\par
17474     {\cf20 // stored in buf.}\par
17475     {\cf20 // Decrement buf by ten_k while this takes buf closer to w.}\par
17476 \par
17477     {\cf20 // The tests are written in this order to avoid overflow in unsigned}\par
17478     {\cf20 // integer arithmetic.}\par
17479 \par
17480     {\cf19 while} (rest < dist\par
17481             && delta - rest >= ten_k\par
17482             && (rest + ten_k < dist || dist - rest > rest + ten_k - dist))\par
17483     \{\par
17484         JSON_ASSERT(buf[len - 1] != {\cf23 '0'});\par
17485         buf[len - 1]--;\par
17486         rest += ten_k;\par
17487     \}\par
17488 \}\par
