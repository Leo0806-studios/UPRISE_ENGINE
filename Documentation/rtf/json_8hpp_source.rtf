3177 {\cf20 // make_integer_sequence}\par
3178 {\cf20 //}\par
3179 {\cf20 // This template alias is equivalent to}\par
3180 {\cf20 // `integer_sequence<int, 0, 1, ..., N-1>`, and is designed to be a drop-in}\par
3181 {\cf20 // replacement for C++14's `std::make_integer_sequence`.}\par
3182 {\cf17 template} <{\cf17 typename} T, T N>\par
3183 {\cf17 using }make_integer_sequence = {\cf17 typename} utility_internal::Gen<T, N>::type;\par
3184 \par
3185 {\cf20 // make_index_sequence}\par
3186 {\cf20 //}\par
3187 {\cf20 // This template alias is equivalent to `index_sequence<0, 1, ..., N-1>`,}\par
3188 {\cf20 // and is designed to be a drop-in replacement for C++14's}\par
