16828     {\cf20 // The following to_char_type functions are implement the conversion}\par
16829     {\cf20 // between uint8_t and CharType. In case CharType is not unsigned,}\par
16830     {\cf20 // such a conversion is required to allow values greater than 128.}\par
16831     {\cf20 // See <https://github.com/nlohmann/json/issues/1286> for a discussion.}\par
16832     {\cf17 template} < {\cf17 typename} C = CharType,\par
16833                enable_if_t < std::is_signed<C>::value && std::is_signed<char>::value > * = {\cf17 nullptr} >\par
