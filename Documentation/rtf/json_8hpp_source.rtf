12345   {\cf17 private}:\par
12346     {\cf17 template}<{\cf17 typename} SAX>\par
12347     JSON_HEDLEY_NON_NULL(2)\par
12348     bool sax_parse_internal(SAX* sax)\par
12349     \{\par
12350         {\cf20 // stack to remember the hierarchy of structured values we are parsing}\par
12351         {\cf20 // true = array; false = object}\par
12352         std::vector<bool> states;\par
12353         {\cf20 // value to avoid a goto (see comment where set to true)}\par
12354         {\cf18 bool} skip_to_state_evaluation = {\cf17 false};\par
12355 \par
12356         {\cf19 while} ({\cf17 true})\par
12357         \{\par
12358             {\cf19 if} (!skip_to_state_evaluation)\par
12359             \{\par
12360                 {\cf20 // invariant: get_token() was called before each iteration}\par
12361                 {\cf19 switch} (last_token)\par
12362                 \{\par
12363                     {\cf19 case} token_type::begin_object:\par
12364                     \{\par
12365                         {\cf19 if} (JSON_HEDLEY_UNLIKELY(!sax->start_object({\cf17 static_cast<}std::size_t{\cf17 >}(-1))))\par
12366                         \{\par
12367                             {\cf19 return} {\cf17 false};\par
12368                         \}\par
12369 \par
12370                         {\cf20 // closing \} -> we are done}\par
12371                         {\cf19 if} (get_token() == token_type::end_object)\par
12372                         \{\par
12373                             {\cf19 if} (JSON_HEDLEY_UNLIKELY(!sax->end_object()))\par
12374                             \{\par
12375                                 {\cf19 return} {\cf17 false};\par
12376                             \}\par
12377                             {\cf19 break};\par
12378                         \}\par
12379 \par
12380                         {\cf20 // parse key}\par
12381                         {\cf19 if} (JSON_HEDLEY_UNLIKELY(last_token != token_type::value_string))\par
12382                         \{\par
12383                             {\cf19 return} sax->parse_error(m_lexer.get_position(),\par
12384                                                     m_lexer.get_token_string(),\par
12385                                                     parse_error::create(101, m_lexer.get_position(), exception_message(token_type::value_string, {\cf22 "object key"}), {\cf17 nullptr}));\par
12386                         \}\par
12387                         {\cf19 if} (JSON_HEDLEY_UNLIKELY(!sax->key(m_lexer.get_string())))\par
12388                         \{\par
12389                             {\cf19 return} {\cf17 false};\par
12390                         \}\par
12391 \par
12392                         {\cf20 // parse separator (:)}\par
12393                         {\cf19 if} (JSON_HEDLEY_UNLIKELY(get_token() != token_type::name_separator))\par
12394                         \{\par
12395                             {\cf19 return} sax->parse_error(m_lexer.get_position(),\par
12396                                                     m_lexer.get_token_string(),\par
12397                                                     parse_error::create(101, m_lexer.get_position(), exception_message(token_type::name_separator, {\cf22 "object separator"}), {\cf17 nullptr}));\par
12398                         \}\par
12399 \par
12400                         {\cf20 // remember we are now inside an object}\par
12401                         states.push_back({\cf17 false});\par
12402 \par
12403                         {\cf20 // parse values}\par
12404                         get_token();\par
12405                         {\cf19 continue};\par
12406                     \}\par
12407 \par
12408                     {\cf19 case} token_type::begin_array:\par
12409                     \{\par
12410                         {\cf19 if} (JSON_HEDLEY_UNLIKELY(!sax->start_array({\cf17 static_cast<}std::size_t{\cf17 >}(-1))))\par
12411                         \{\par
12412                             {\cf19 return} {\cf17 false};\par
12413                         \}\par
12414 \par
12415                         {\cf20 // closing ] -> we are done}\par
12416                         {\cf19 if} (get_token() == token_type::end_array)\par
12417                         \{\par
12418                             {\cf19 if} (JSON_HEDLEY_UNLIKELY(!sax->end_array()))\par
12419                             \{\par
12420                                 {\cf19 return} {\cf17 false};\par
12421                             \}\par
12422                             {\cf19 break};\par
12423                         \}\par
12424 \par
12425                         {\cf20 // remember we are now inside an array}\par
12426                         states.push_back({\cf17 true});\par
12427 \par
12428                         {\cf20 // parse values (no need to call get_token)}\par
12429                         {\cf19 continue};\par
12430                     \}\par
12431 \par
12432                     {\cf19 case} token_type::value_float:\par
12433                     \{\par
12434                         {\cf17 const} {\cf17 auto} res = m_lexer.get_number_float();\par
12435 \par
12436                         {\cf19 if} (JSON_HEDLEY_UNLIKELY(!std::isfinite(res)))\par
12437                         \{\par
12438                             {\cf19 return} sax->parse_error(m_lexer.get_position(),\par
12439                                                     m_lexer.get_token_string(),\par
12440                                                     out_of_range::create(406, concat({\cf22 "number overflow parsing '"}, m_lexer.get_token_string(), {\cf23 '\\''}), {\cf17 nullptr}));\par
12441                         \}\par
12442 \par
12443                         {\cf19 if} (JSON_HEDLEY_UNLIKELY(!sax->number_float(res, m_lexer.get_string())))\par
12444                         \{\par
12445                             {\cf19 return} {\cf17 false};\par
12446                         \}\par
12447 \par
12448                         {\cf19 break};\par
12449                     \}\par
12450 \par
12451                     {\cf19 case} token_type::literal_false:\par
12452                     \{\par
12453                         {\cf19 if} (JSON_HEDLEY_UNLIKELY(!sax->boolean({\cf17 false})))\par
12454                         \{\par
12455                             {\cf19 return} {\cf17 false};\par
12456                         \}\par
12457                         {\cf19 break};\par
12458                     \}\par
12459 \par
12460                     {\cf19 case} token_type::literal_null:\par
12461                     \{\par
12462                         {\cf19 if} (JSON_HEDLEY_UNLIKELY(!sax->null()))\par
12463                         \{\par
12464                             {\cf19 return} {\cf17 false};\par
12465                         \}\par
12466                         {\cf19 break};\par
12467                     \}\par
12468 \par
12469                     {\cf19 case} token_type::literal_true:\par
12470                     \{\par
12471                         {\cf19 if} (JSON_HEDLEY_UNLIKELY(!sax->boolean({\cf17 true})))\par
12472                         \{\par
12473                             {\cf19 return} {\cf17 false};\par
12474                         \}\par
12475                         {\cf19 break};\par
12476                     \}\par
12477 \par
12478                     {\cf19 case} token_type::value_integer:\par
12479                     \{\par
12480                         {\cf19 if} (JSON_HEDLEY_UNLIKELY(!sax->number_integer(m_lexer.get_number_integer())))\par
