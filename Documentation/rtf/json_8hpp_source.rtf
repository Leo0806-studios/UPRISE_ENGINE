24241                         {\cf20 // check if "value" matches the one at "path"}\par
24242                         {\cf20 // the "path" location must exist - use at()}\par
24243                         success = (result.at(ptr) == get_value({\cf22 "test"}, {\cf22 "value"}, {\cf17 false}));\par
24244                     \}\par
24245                     JSON_INTERNAL_CATCH (out_of_range&)\par
24246                     \{\par
24247                         {\cf20 // ignore out of range errors: success remains false}\par
24248                     \}\par
24249 \par
24250                     {\cf20 // throw an exception if test fails}\par
24251                     {\cf19 if} (JSON_HEDLEY_UNLIKELY(!success))\par
24252                     \{\par
24253                         JSON_THROW(other_error::create(501, detail::concat({\cf22 "unsuccessful: "}, val.dump()), &val));\par
24254                     \}\par
24255 \par
24256                     {\cf19 break};\par
24257                 \}\par
24258 \par
24259                 {\cf19 case} patch_operations::invalid:\par
24260                 {\cf19 default}:\par
24261                 \{\par
24262                     {\cf20 // op must be "add", "remove", "replace", "move", "copy", or}\par
24263                     {\cf20 // "test"}\par
24264                     JSON_THROW(parse_error::create(105, 0, detail::concat({\cf22 "operation value '"}, op, {\cf22 "' is invalid"}), &val));\par
24265                 \}\par
24266             \}\par
24267         \}\par
24268     \}\par
