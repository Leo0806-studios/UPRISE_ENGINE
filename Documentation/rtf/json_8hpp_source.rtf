12486 \par
12487                     {\cf19 case} token_type::value_string:\par
12488                     \{\par
12489                         {\cf19 if} (JSON_HEDLEY_UNLIKELY(!sax->string(m_lexer.get_string())))\par
12490                         \{\par
12491                             {\cf19 return} {\cf17 false};\par
12492                         \}\par
12493                         {\cf19 break};\par
12494                     \}\par
12495 \par
12496                     {\cf19 case} token_type::value_unsigned:\par
12497                     \{\par
12498                         {\cf19 if} (JSON_HEDLEY_UNLIKELY(!sax->number_unsigned(m_lexer.get_number_unsigned())))\par
12499                         \{\par
12500                             {\cf19 return} {\cf17 false};\par
12501                         \}\par
12502                         {\cf19 break};\par
12503                     \}\par
12504 \par
12505                     {\cf19 case} token_type::parse_error:\par
12506                     \{\par
