9319             {\cf19 return} {\cf17 false};\par
9320         \}\par
9321 \par
9322         {\cf19 if} (JSON_HEDLEY_UNLIKELY(!parse_bson_element_list({\cf20 /*is_array*/}{\cf17 false})))\par
