24424     {\cf18 void} merge_patch({\cf17 const} basic_json& apply_patch)\par
24425     \{\par
24426         {\cf19 if} (apply_patch.is_object())\par
24427         \{\par
24428             {\cf19 if} (!is_object())\par
24429             \{\par
24430                 *{\cf17 this} = object();\par
24431             \}\par
24432             {\cf19 for} ({\cf17 auto} it = apply_patch.begin(); it != apply_patch.end(); ++it)\par
24433             \{\par
24434                 {\cf19 if} (it.value().is_null())\par
24435                 \{\par
24436                     erase(it.key());\par
24437                 \}\par
24438                 {\cf19 else}\par
24439                 \{\par
24440                     operator[](it.key()).merge_patch(it.value());\par
24441                 \}\par
24442             \}\par
24443         \}\par
24444         {\cf19 else}\par
24445         \{\par
24446             *{\cf17 this} = apply_patch;\par
24447         \}\par
24448     \}\par
