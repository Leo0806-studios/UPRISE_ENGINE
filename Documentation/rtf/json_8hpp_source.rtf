6318 {\cf17 struct }wide_string_input_helper<BaseInputAdapter, 4>\par
6319 \{\par
6320     {\cf20 // UTF-32}\par
6321     {\cf17 static} {\cf18 void} fill_buffer(BaseInputAdapter& input,\par
6322                             std::array<std::char_traits<char>::int_type, 4>& utf8_bytes,\par
6323                             {\cf18 size_t}& utf8_bytes_index,\par
6324                             {\cf18 size_t}& utf8_bytes_filled)\par
6325     \{\par
6326         utf8_bytes_index = 0;\par
6327 \par
6328         {\cf19 if} (JSON_HEDLEY_UNLIKELY(input.empty()))\par
6329         \{\par
6330             utf8_bytes[0] = std::char_traits<char>::eof();\par
6331             utf8_bytes_filled = 1;\par
6332         \}\par
6333         {\cf19 else}\par
6334         \{\par
6335             {\cf20 // get the current character}\par
6336             {\cf17 const} {\cf17 auto} wc = input.get_character();\par
6337 \par
6338             {\cf20 // UTF-32 to UTF-8 encoding}\par
6339             {\cf19 if} (wc < 0x80)\par
6340             \{\par
6341                 utf8_bytes[0] = {\cf17 static_cast<}std::char_traits<char>::int_type{\cf17 >}(wc);\par
6342                 utf8_bytes_filled = 1;\par
6343             \}\par
6344             {\cf19 else} {\cf19 if} (wc <= 0x7FF)\par
6345             \{\par
6346                 utf8_bytes[0] = {\cf17 static_cast<}std::char_traits<char>::int_type{\cf17 >}(0xC0u | (({\cf17 static_cast<}{\cf18 unsigned} {\cf18 int}{\cf17 >}(wc) >> 6u) & 0x1Fu));\par
6347                 utf8_bytes[1] = {\cf17 static_cast<}std::char_traits<char>::int_type{\cf17 >}(0x80u | ({\cf17 static_cast<}{\cf18 unsigned} {\cf18 int}{\cf17 >}(wc) & 0x3Fu));\par
6348                 utf8_bytes_filled = 2;\par
6349             \}\par
6350             {\cf19 else} {\cf19 if} (wc <= 0xFFFF)\par
6351             \{\par
6352                 utf8_bytes[0] = {\cf17 static_cast<}std::char_traits<char>::int_type{\cf17 >}(0xE0u | (({\cf17 static_cast<}{\cf18 unsigned} {\cf18 int}{\cf17 >}(wc) >> 12u) & 0x0Fu));\par
6353                 utf8_bytes[1] = {\cf17 static_cast<}std::char_traits<char>::int_type{\cf17 >}(0x80u | (({\cf17 static_cast<}{\cf18 unsigned} {\cf18 int}{\cf17 >}(wc) >> 6u) & 0x3Fu));\par
6354                 utf8_bytes[2] = {\cf17 static_cast<}std::char_traits<char>::int_type{\cf17 >}(0x80u | ({\cf17 static_cast<}{\cf18 unsigned} {\cf18 int}{\cf17 >}(wc) & 0x3Fu));\par
6355                 utf8_bytes_filled = 3;\par
6356             \}\par
6357             {\cf19 else} {\cf19 if} (wc <= 0x10FFFF)\par
6358             \{\par
6359                 utf8_bytes[0] = {\cf17 static_cast<}std::char_traits<char>::int_type{\cf17 >}(0xF0u | (({\cf17 static_cast<}{\cf18 unsigned} {\cf18 int}{\cf17 >}(wc) >> 18u) & 0x07u));\par
6360                 utf8_bytes[1] = {\cf17 static_cast<}std::char_traits<char>::int_type{\cf17 >}(0x80u | (({\cf17 static_cast<}{\cf18 unsigned} {\cf18 int}{\cf17 >}(wc) >> 12u) & 0x3Fu));\par
6361                 utf8_bytes[2] = {\cf17 static_cast<}std::char_traits<char>::int_type{\cf17 >}(0x80u | (({\cf17 static_cast<}{\cf18 unsigned} {\cf18 int}{\cf17 >}(wc) >> 6u) & 0x3Fu));\par
6362                 utf8_bytes[3] = {\cf17 static_cast<}std::char_traits<char>::int_type{\cf17 >}(0x80u | ({\cf17 static_cast<}{\cf18 unsigned} {\cf18 int}{\cf17 >}(wc) & 0x3Fu));\par
6363                 utf8_bytes_filled = 4;\par
6364             \}\par
6365             {\cf19 else}\par
6366             \{\par
6367                 {\cf20 // unknown character}\par
6368                 utf8_bytes[0] = {\cf17 static_cast<}std::char_traits<char>::int_type{\cf17 >}(wc);\par
6369                 utf8_bytes_filled = 1;\par
6370             \}\par
6371         \}\par
6372     \}\par
6373 \};\par
