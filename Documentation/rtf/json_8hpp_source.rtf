17095 {\cf17 template}<{\cf17 typename} FloatType>\par
17096 boundaries compute_boundaries(FloatType value)\par
17097 \{\par
17098     JSON_ASSERT(std::isfinite(value));\par
17099     JSON_ASSERT(value > 0);\par
17100 \par
17101     {\cf20 // Convert the IEEE representation into a diyfp.}\par
17102     {\cf20 //}\par
17103     {\cf20 // If v is denormal:}\par
17104     {\cf20 //      value = 0.F * 2^(1 - bias) = (          F) * 2^(1 - bias - (p-1))}\par
17105     {\cf20 // If v is normalized:}\par
17106     {\cf20 //      value = 1.F * 2^(E - bias) = (2^(p-1) + F) * 2^(E - bias - (p-1))}\par
17107 \par
17108     {\cf17 static_assert}(std::numeric_limits<FloatType>::is_iec559,\par
17109                   {\cf22 "internal error: dtoa_short requires an IEEE-754 floating-point implementation"});\par
17110 \par
17111     {\cf17 constexpr} {\cf18 int}      kPrecision = std::numeric_limits<FloatType>::digits; {\cf20 // = p (includes the hidden bit)}\par
17112     {\cf17 constexpr} {\cf18 int}      kBias      = std::numeric_limits<FloatType>::max_exponent - 1 + (kPrecision - 1);\par
17113     {\cf17 constexpr} {\cf18 int}      kMinExp    = 1 - kBias;\par
17114     {\cf17 constexpr} std::uint64_t kHiddenBit = std::uint64_t\{1\} << (kPrecision - 1); {\cf20 // = 2^(p-1)}\par
17115 \par
17116     {\cf17 using }bits_type = {\cf17 typename} std::conditional<kPrecision == 24, std::uint32_t, std::uint64_t >::type;\par
17117 \par
17118     {\cf17 const} {\cf17 auto} bits = {\cf17 static_cast<}std::uint64_t{\cf17 >}(reinterpret_bits<bits_type>(value));\par
17119     {\cf17 const} std::uint64_t E = bits >> (kPrecision - 1);\par
17120     {\cf17 const} std::uint64_t F = bits & (kHiddenBit - 1);\par
17121 \par
17122     {\cf17 const} {\cf18 bool} is_denormal = E == 0;\par
17123     {\cf17 const} diyfp v = is_denormal\par
17124                     ? diyfp(F, kMinExp)\par
17125                     : diyfp(F + kHiddenBit, {\cf17 static_cast<}{\cf18 int}{\cf17 >}(E) - kBias);\par
17126 \par
17127     {\cf20 // Compute the boundaries m- and m+ of the floating-point value}\par
17128     {\cf20 // v = f * 2^e.}\par
17129     {\cf20 //}\par
17130     {\cf20 // Determine v- and v+, the floating-point predecessor and successor if v,}\par
17131     {\cf20 // respectively.}\par
17132     {\cf20 //}\par
17133     {\cf20 //      v- = v - 2^e        if f != 2^(p-1) or e == e_min                (A)}\par
17134     {\cf20 //         = v - 2^(e-1)    if f == 2^(p-1) and e > e_min                (B)}\par
17135     {\cf20 //}\par
17136     {\cf20 //      v+ = v + 2^e}\par
17137     {\cf20 //}\par
17138     {\cf20 // Let m- = (v- + v) / 2 and m+ = (v + v+) / 2. All real numbers _strictly_}\par
17139     {\cf20 // between m- and m+ round to v, regardless of how the input rounding}\par
17140     {\cf20 // algorithm breaks ties.}\par
17141     {\cf20 //}\par
17142     {\cf20 //      ---+-------------+-------------+-------------+-------------+---  (A)}\par
17143     {\cf20 //         v-            m-            v             m+            v+}\par
17144     {\cf20 //}\par
17145     {\cf20 //      -----------------+------+------+-------------+-------------+---  (B)}\par
17146     {\cf20 //                       v-     m-     v             m+            v+}\par
17147 \par
17148     {\cf17 const} {\cf18 bool} lower_boundary_is_closer = F == 0 && E > 1;\par
17149     {\cf17 const} diyfp m_plus = diyfp(2 * v.f + 1, v.e - 1);\par
17150     {\cf17 const} diyfp m_minus = lower_boundary_is_closer\par
17151                           ? diyfp(4 * v.f - 1, v.e - 2)  {\cf20 // (B)}\par
17152                           : diyfp(2 * v.f - 1, v.e - 1); {\cf20 // (A)}\par
17153 \par
17154     {\cf20 // Determine the normalized w+ = m+.}\par
17155     {\cf17 const} diyfp w_plus = diyfp::normalize(m_plus);\par
17156 \par
17157     {\cf20 // Determine w- = m- such that e_(w-) = e_(w+).}\par
17158     {\cf17 const} diyfp w_minus = diyfp::normalize_to(m_minus, w_plus.e);\par
17159 \par
17160     {\cf19 return} \{diyfp::normalize(v), w_minus, w_plus\};\par
17161 \}\par
17162 \par
17163 {\cf20 // Given normalized diyfp w, Grisu needs to find a (normalized) cached}\par
17164 {\cf20 // power-of-ten c, such that the exponent of the product c * w = f * 2^e lies}\par
17165 {\cf20 // within a certain range [alpha, gamma] (Definition 3.2 from [1])}\par
17166 {\cf20 //}\par
17167 {\cf20 //      alpha <= e = e_c + e_w + q <= gamma}\par
17168 {\cf20 //}\par
17169 {\cf20 // or}\par
17170 {\cf20 //}\par
17171 {\cf20 //      f_c * f_w * 2^alpha <= f_c 2^(e_c) * f_w 2^(e_w) * 2^q}\par
17172 {\cf20 //                          <= f_c * f_w * 2^gamma}\par
17173 {\cf20 //}\par
17174 {\cf20 // Since c and w are normalized, i.e. 2^(q-1) <= f < 2^q, this implies}\par
17175 {\cf20 //}\par
17176 {\cf20 //      2^(q-1) * 2^(q-1) * 2^alpha <= c * w * 2^q < 2^q * 2^q * 2^gamma}\par
17177 {\cf20 //}\par
17178 {\cf20 // or}\par
17179 {\cf20 //}\par
17180 {\cf20 //      2^(q - 2 + alpha) <= c * w < 2^(q + gamma)}\par
17181 {\cf20 //}\par
17182 {\cf20 // The choice of (alpha,gamma) determines the size of the table and the form of}\par
17183 {\cf20 // the digit generation procedure. Using (alpha,gamma)=(-60,-32) works out well}\par
17184 {\cf20 // in practice:}\par
17185 {\cf20 //}\par
17186 {\cf20 // The idea is to cut the number c * w = f * 2^e into two parts, which can be}\par
17187 {\cf20 // processed independently: An integral part p1, and a fractional part p2:}\par
17188 {\cf20 //}\par
17189 {\cf20 //      f * 2^e = ( (f div 2^-e) * 2^-e + (f mod 2^-e) ) * 2^e}\par
17190 {\cf20 //              = (f div 2^-e) + (f mod 2^-e) * 2^e}\par
17191 {\cf20 //              = p1 + p2 * 2^e}\par
17192 {\cf20 //}\par
17193 {\cf20 // The conversion of p1 into decimal form requires a series of divisions and}\par
17194 {\cf20 // modulos by (a power of) 10. These operations are faster for 32-bit than for}\par
17195 {\cf20 // 64-bit integers, so p1 should ideally fit into a 32-bit integer. This can be}\par
17196 {\cf20 // achieved by choosing}\par
17197 {\cf20 //}\par
17198 {\cf20 //      -e >= 32   or   e <= -32 := gamma}\par
17199 {\cf20 //}\par
17200 {\cf20 // In order to convert the fractional part}\par
17201 {\cf20 //}\par
17202 {\cf20 //      p2 * 2^e = p2 / 2^-e = d[-1] / 10^1 + d[-2] / 10^2 + ...}\par
17203 {\cf20 //}\par
17204 {\cf20 // into decimal form, the fraction is repeatedly multiplied by 10 and the digits}\par
17205 {\cf20 // d[-i] are extracted in order:}\par
17206 {\cf20 //}\par
17207 {\cf20 //      (10 * p2) div 2^-e = d[-1]}\par
17208 {\cf20 //      (10 * p2) mod 2^-e = d[-2] / 10^1 + ...}\par
17209 {\cf20 //}\par
17210 {\cf20 // The multiplication by 10 must not overflow. It is sufficient to choose}\par
17211 {\cf20 //}\par
17212 {\cf20 //      10 * p2 < 16 * p2 = 2^4 * p2 <= 2^64.}\par
17213 {\cf20 //}\par
17214 {\cf20 // Since p2 = f mod 2^-e < 2^-e,}\par
17215 {\cf20 //}\par
17216 {\cf20 //      -e <= 60   or   e >= -60 := alpha}\par
17217 \par
17218 {\cf17 constexpr} {\cf18 int} kAlpha = -60;\par
17219 {\cf17 constexpr} {\cf18 int} kGamma = -32;\par
17220 \par
17221 {\cf17 struct }cached_power {\cf20 // c = f * 2^e ~= 10^k}\par
17222 \{\par
17223     std::uint64_t f;\par
17224     {\cf18 int} e;\par
17225     {\cf18 int} k;\par
17226 \};\par
17227 \par
17235 {\cf17 inline} cached_power get_cached_power_for_binary_exponent({\cf18 int} e)\par
17236 \{\par
17237     {\cf20 // Now}\par
17238     {\cf20 //}\par
17239     {\cf20 //      alpha <= e_c + e + q <= gamma                                    (1)}\par
17240     {\cf20 //      ==> f_c * 2^alpha <= c * 2^e * 2^q}\par
17241     {\cf20 //}\par
17242     {\cf20 // and since the c's are normalized, 2^(q-1) <= f_c,}\par
17243     {\cf20 //}\par
17244     {\cf20 //      ==> 2^(q - 1 + alpha) <= c * 2^(e + q)}\par
17245     {\cf20 //      ==> 2^(alpha - e - 1) <= c}\par
17246     {\cf20 //}\par
17247     {\cf20 // If c were an exact power of ten, i.e. c = 10^k, one may determine k as}\par
17248     {\cf20 //}\par
17249     {\cf20 //      k = ceil( log_10( 2^(alpha - e - 1) ) )}\par
17250     {\cf20 //        = ceil( (alpha - e - 1) * log_10(2) )}\par
17251     {\cf20 //}\par
17252     {\cf20 // From the paper:}\par
17253     {\cf20 // "In theory the result of the procedure could be wrong since c is rounded,}\par
17254     {\cf20 //  and the computation itself is approximated [...]. In practice, however,}\par
17255     {\cf20 //  this simple function is sufficient."}\par
17256     {\cf20 //}\par
17257     {\cf20 // For IEEE double precision floating-point numbers converted into}\par
17258     {\cf20 // normalized diyfp's w = f * 2^e, with q = 64,}\par
17259     {\cf20 //}\par
17260     {\cf20 //      e >= -1022      (min IEEE exponent)}\par
17261     {\cf20 //           -52        (p - 1)}\par
17262     {\cf20 //           -52        (p - 1, possibly normalize denormal IEEE numbers)}\par
17263     {\cf20 //           -11        (normalize the diyfp)}\par
17264     {\cf20 //         = -1137}\par
17265     {\cf20 //}\par
17266     {\cf20 // and}\par
17267     {\cf20 //}\par
17268     {\cf20 //      e <= +1023      (max IEEE exponent)}\par
17269     {\cf20 //           -52        (p - 1)}\par
17270     {\cf20 //           -11        (normalize the diyfp)}\par
17271     {\cf20 //         = 960}\par
17272     {\cf20 //}\par
17273     {\cf20 // This binary exponent range [-1137,960] results in a decimal exponent}\par
17274     {\cf20 // range [-307,324]. One does not need to store a cached power for each}\par
17275     {\cf20 // k in this range. For each such k it suffices to find a cached power}\par
17276     {\cf20 // such that the exponent of the product lies in [alpha,gamma].}\par
17277     {\cf20 // This implies that the difference of the decimal exponents of adjacent}\par
17278     {\cf20 // table entries must be less than or equal to}\par
17279     {\cf20 //}\par
17280     {\cf20 //      floor( (gamma - alpha) * log_10(2) ) = 8.}\par
17281     {\cf20 //}\par
17282     {\cf20 // (A smaller distance gamma-alpha would require a larger table.)}\par
17283 \par
17284     {\cf20 // NB:}\par
17285     {\cf20 // Actually this function returns c, such that -60 <= e_c + e + 64 <= -34.}\par
17286 \par
17287     {\cf17 constexpr} {\cf18 int} kCachedPowersMinDecExp = -300;\par
17288     {\cf17 constexpr} {\cf18 int} kCachedPowersDecStep = 8;\par
17289 \par
