16837     \}\par
16838 \par
16839     {\cf17 template} < {\cf17 typename} C = CharType,\par
16840                enable_if_t < std::is_signed<C>::value && std::is_unsigned<char>::value > * = {\cf17 nullptr} >\par
16841     {\cf17 static} CharType to_char_type(std::uint8_t x) {\cf17 noexcept}\par
16842     \{\par
16843         {\cf17 static_assert}({\cf17 sizeof}(std::uint8_t) == {\cf17 sizeof}(CharType), {\cf22 "size of CharType must be equal to std::uint8_t"});\par
16844         {\cf17 static_assert}(std::is_trivial<CharType>::value, {\cf22 "CharType must be trivial"});\par
16845         CharType result;\par
16846         std::memcpy(&result, &x, {\cf17 sizeof}(x));\par
16847         {\cf19 return} result;\par
16848     \}\par
16849 \par
16850     {\cf17 template}<{\cf17 typename} C = CharType,\par
16851              enable_if_t<std::is_unsigned<C>::value>* = {\cf17 nullptr}>\par
16852     {\cf17 static} {\cf17 constexpr} CharType to_char_type(std::uint8_t x) {\cf17 noexcept}\par
16853     \{\par
16854         {\cf19 return} x;\par
16855     \}\par
