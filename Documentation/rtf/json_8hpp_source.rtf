24132         \};\par
24133 \par
24134         {\cf20 // type check: top level value must be an array}\par
24135         {\cf19 if} (JSON_HEDLEY_UNLIKELY(!json_patch.is_array()))\par
24136         \{\par
24137             JSON_THROW(parse_error::create(104, 0, {\cf22 "JSON patch must be an array of objects"}, &json_patch));\par
24138         \}\par
24139 \par
24140         {\cf20 // iterate and apply the operations}\par
24141         {\cf19 for} ({\cf17 const} {\cf17 auto}& val : json_patch)\par
24142         \{\par
24143             {\cf20 // wrapper to get a value for an operation}\par
24144             {\cf17 const} {\cf17 auto} get_value = [&val]({\cf17 const} std::string & op,\par
24145                                           {\cf17 const} std::string & member,\par
24146                                           {\cf18 bool} string_type) -> basic_json &\par
24147             \{\par
24148                 {\cf20 // find value}\par
24149                 {\cf17 auto} it = val.m_data.m_value.object->find(member);\par
24150 \par
24151                 {\cf20 // context-sensitive error message}\par
24152                 {\cf17 const} {\cf17 auto} error_msg = (op == {\cf22 "op"}) ? {\cf22 "operation"} : detail::concat({\cf22 "operation '"}, op, {\cf23 '\\''});\par
24153 \par
24154                 {\cf20 // check if desired value is present}\par
24155                 {\cf19 if} (JSON_HEDLEY_UNLIKELY(it == val.m_data.m_value.object->end()))\par
24156                 \{\par
24157                     {\cf20 // NOLINTNEXTLINE(performance-inefficient-string-concatenation)}\par
24158                     JSON_THROW(parse_error::create(105, 0, detail::concat(error_msg, {\cf22 " must have member '"}, member, {\cf22 "'"}), &val));\par
24159                 \}\par
24160 \par
24161                 {\cf20 // check if result is of type string}\par
24162                 {\cf19 if} (JSON_HEDLEY_UNLIKELY(string_type && !it->second.is_string()))\par
24163                 \{\par
24164                     {\cf20 // NOLINTNEXTLINE(performance-inefficient-string-concatenation)}\par
24165                     JSON_THROW(parse_error::create(105, 0, detail::concat(error_msg, {\cf22 " must have string member '"}, member, {\cf22 "'"}), &val));\par
24166                 \}\par
24167 \par
24168                 {\cf20 // no error: return value}\par
24169                 {\cf19 return} it->second;\par
24170             \};\par
24171 \par
24172             {\cf20 // type check: every element of the array must be an object}\par
24173             {\cf19 if} (JSON_HEDLEY_UNLIKELY(!val.is_object()))\par
24174             \{\par
24175                 JSON_THROW(parse_error::create(104, 0, {\cf22 "JSON patch must be an array of objects"}, &val));\par
24176             \}\par
24177 \par
24178             {\cf20 // collect mandatory members}\par
24179             {\cf17 const} {\cf17 auto} op = get_value({\cf22 "op"}, {\cf22 "op"}, {\cf17 true}).template get<std::string>();\par
24180             {\cf17 const} {\cf17 auto} path = get_value(op, {\cf22 "path"}, {\cf17 true}).template get<std::string>();\par
24181             json_pointer ptr(path);\par
24182 \par
24183             {\cf19 switch} (get_op(op))\par
24184             \{\par
24185                 {\cf19 case} patch_operations::add:\par
24186                 \{\par
24187                     operation_add(ptr, get_value({\cf22 "add"}, {\cf22 "value"}, {\cf17 false}));\par
24188                     {\cf19 break};\par
24189                 \}\par
24190 \par
24191                 {\cf19 case} patch_operations::remove:\par
24192                 \{\par
24193                     operation_remove(ptr);\par
24194                     {\cf19 break};\par
24195                 \}\par
24196 \par
24197                 {\cf19 case} patch_operations::replace:\par
24198                 \{\par
24199                     {\cf20 // the "path" location must exist - use at()}\par
24200                     result.at(ptr) = get_value({\cf22 "replace"}, {\cf22 "value"}, {\cf17 false});\par
24201                     {\cf19 break};\par
24202                 \}\par
24203 \par
24204                 {\cf19 case} patch_operations::move:\par
24205                 \{\par
24206                     {\cf17 const} {\cf17 auto} from_path = get_value({\cf22 "move"}, {\cf22 "from"}, {\cf17 true}).template get<std::string>();\par
24207                     json_pointer from_ptr(from_path);\par
24208 \par
24209                     {\cf20 // the "from" location must exist - use at()}\par
24210                     basic_json {\cf17 const} v = result.at(from_ptr);\par
24211 \par
24212                     {\cf20 // The move operation is functionally identical to a}\par
24213                     {\cf20 // "remove" operation on the "from" location, followed}\par
24214                     {\cf20 // immediately by an "add" operation at the target}\par
24215                     {\cf20 // location with the value that was just removed.}\par
24216                     operation_remove(from_ptr);\par
24217                     operation_add(ptr, v);\par
24218                     {\cf19 break};\par
24219                 \}\par
24220 \par
24221                 {\cf19 case} patch_operations::copy:\par
24222                 \{\par
24223                     {\cf17 const} {\cf17 auto} from_path = get_value({\cf22 "copy"}, {\cf22 "from"}, {\cf17 true}).template get<std::string>();\par
24224                     {\cf17 const} json_pointer from_ptr(from_path);\par
24225 \par
24226                     {\cf20 // the "from" location must exist - use at()}\par
24227                     basic_json {\cf17 const} v = result.at(from_ptr);\par
24228 \par
24229                     {\cf20 // The copy is functionally identical to an "add"}\par
24230                     {\cf20 // operation at the target location using the value}\par
24231                     {\cf20 // specified in the "from" member.}\par
24232                     operation_add(ptr, v);\par
24233                     {\cf19 break};\par
24234                 \}\par
24235 \par
24236                 {\cf19 case} patch_operations::test:\par
24237                 \{\par
24238                     {\cf18 bool} success = {\cf17 false};\par
