24001     {\cf18 void} patch_inplace({\cf17 const} basic_json& json_patch)\par
24002     \{\par
24003         basic_json& result = *{\cf17 this};\par
24004         {\cf20 // the valid JSON Patch operations}\par
24005         {\cf17 enum class} patch_operations \{add, remove, replace, move, copy, test, invalid\};\par
24006 \par
24007         {\cf17 const} {\cf17 auto} get_op = []({\cf17 const} std::string & op)\par
24008         \{\par
24009             {\cf19 if} (op == {\cf22 "add"})\par
24010             \{\par
24011                 {\cf19 return} patch_operations::add;\par
24012             \}\par
24013             {\cf19 if} (op == {\cf22 "remove"})\par
24014             \{\par
24015                 {\cf19 return} patch_operations::remove;\par
24016             \}\par
24017             {\cf19 if} (op == {\cf22 "replace"})\par
24018             \{\par
24019                 {\cf19 return} patch_operations::replace;\par
24020             \}\par
24021             {\cf19 if} (op == {\cf22 "move"})\par
24022             \{\par
24023                 {\cf19 return} patch_operations::move;\par
24024             \}\par
24025             {\cf19 if} (op == {\cf22 "copy"})\par
24026             \{\par
24027                 {\cf19 return} patch_operations::copy;\par
24028             \}\par
24029             {\cf19 if} (op == {\cf22 "test"})\par
24030             \{\par
24031                 {\cf19 return} patch_operations::test;\par
24032             \}\par
24033 \par
24034             {\cf19 return} patch_operations::invalid;\par
24035         \};\par
24036 \par
24037         {\cf20 // wrapper for "add" operation; add value at ptr}\par
24038         {\cf17 const} {\cf17 auto} operation_add = [&result](json_pointer & ptr, basic_json val)\par
24039         \{\par
24040             {\cf20 // adding to the root of the target document means replacing it}\par
24041             {\cf19 if} (ptr.empty())\par
24042             \{\par
24043                 result = val;\par
24044                 {\cf19 return};\par
24045             \}\par
24046 \par
24047             {\cf20 // make sure the top element of the pointer exists}\par
24048             json_pointer {\cf17 const} top_pointer = ptr.top();\par
24049             {\cf19 if} (top_pointer != ptr)\par
24050             \{\par
24051                 result.at(top_pointer);\par
24052             \}\par
24053 \par
24054             {\cf20 // get reference to parent of JSON pointer ptr}\par
24055             {\cf17 const} {\cf17 auto} last_path = ptr.back();\par
24056             ptr.pop_back();\par
24057             {\cf20 // parent must exist when performing patch add per RFC6902 specs}\par
24058             basic_json& parent = result.at(ptr);\par
24059 \par
24060             {\cf19 switch} (parent.m_data.m_type)\par
24061             \{\par
24062                 {\cf19 case} value_t::null:\par
24063                 {\cf19 case} value_t::object:\par
24064                 \{\par
24065                     {\cf20 // use operator[] to add value}\par
24066                     parent[last_path] = val;\par
24067                     {\cf19 break};\par
24068                 \}\par
24069 \par
24070                 {\cf19 case} value_t::array:\par
24071                 \{\par
24072                     {\cf19 if} (last_path == {\cf22 "-"})\par
24073                     \{\par
24074                         {\cf20 // special case: append to back}\par
24075                         parent.push_back(val);\par
24076                     \}\par
24077                     {\cf19 else}\par
24078                     \{\par
24079                         {\cf17 const} {\cf17 auto} idx = json_pointer::template array_index<basic_json_t>(last_path);\par
24080                         {\cf19 if} (JSON_HEDLEY_UNLIKELY(idx > parent.size()))\par
24081                         \{\par
24082                             {\cf20 // avoid undefined behavior}\par
24083                             JSON_THROW(out_of_range::create(401, detail::concat({\cf22 "array index "}, std::to_string(idx), {\cf22 " is out of range"}), &parent));\par
24084                         \}\par
24085 \par
24086                         {\cf20 // default case: insert add offset}\par
24087                         parent.insert(parent.begin() + {\cf17 static_cast<}difference_type{\cf17 >}(idx), val);\par
24088                     \}\par
24089                     {\cf19 break};\par
24090                 \}\par
24091 \par
24092                 {\cf20 // if there exists a parent it cannot be primitive}\par
24093                 {\cf19 case} value_t::string: {\cf20 // LCOV_EXCL_LINE}\par
24094                 {\cf19 case} value_t::boolean: {\cf20 // LCOV_EXCL_LINE}\par
24095                 {\cf19 case} value_t::number_integer: {\cf20 // LCOV_EXCL_LINE}\par
24096                 {\cf19 case} value_t::number_unsigned: {\cf20 // LCOV_EXCL_LINE}\par
24097                 {\cf19 case} value_t::number_float: {\cf20 // LCOV_EXCL_LINE}\par
24098                 {\cf19 case} value_t::binary: {\cf20 // LCOV_EXCL_LINE}\par
24099                 {\cf19 case} value_t::discarded: {\cf20 // LCOV_EXCL_LINE}\par
24100                 {\cf19 default}:            {\cf20 // LCOV_EXCL_LINE}\par
24101                     JSON_ASSERT({\cf17 false}); {\cf20 // NOLINT(cert-dcl03-c,hicpp-static-assert,misc-static-assert) LCOV_EXCL_LINE}\par
24102             \}\par
24103         \};\par
24104 \par
24105         {\cf20 // wrapper for "remove" operation; remove value at ptr}\par
24106         {\cf17 const} {\cf17 auto} operation_remove = [{\cf17 this}, & result](json_pointer & ptr)\par
24107         \{\par
24108             {\cf20 // get reference to parent of JSON pointer ptr}\par
24109             {\cf17 const} {\cf17 auto} last_path = ptr.back();\par
24110             ptr.pop_back();\par
24111             basic_json& parent = result.at(ptr);\par
