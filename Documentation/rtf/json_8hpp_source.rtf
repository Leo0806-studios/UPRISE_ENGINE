6277 {\cf20 // General-purpose iterator-based adapter. It might not be as fast as}\par
6278 {\cf20 // theoretically possible for some containers, but it is extremely versatile.}\par
6279 {\cf17 template}<{\cf17 typename} IteratorType>\par
6280 {\cf17 class }iterator_input_adapter\par
6281 \{\par
6282   {\cf17 public}:\par
6283     {\cf17 using }char_type = {\cf17 typename} std::iterator_traits<IteratorType>::value_type;\par
6284 \par
6285     iterator_input_adapter(IteratorType first, IteratorType last)\par
