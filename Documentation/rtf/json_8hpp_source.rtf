16770     {\cf20 /*}\par
16771 {\cf20     @brief write a number to output input}\par
16772 {\cf20     @param[in] n number of type @a NumberType}\par
16773 {\cf20     @param[in] OutputIsLittleEndian Set to true if output data is}\par
16774 {\cf20                                  required to be little endian}\par
16775 {\cf20     @tparam NumberType the type of the number}\par
16776 {\cf20 }\par
16777 {\cf20     @note This function needs to respect the system's endianness, because bytes}\par
16778 {\cf20           in CBOR, MessagePack, and UBJSON are stored in network order (big}\par
16779 {\cf20           endian) and therefore need reordering on little endian systems.}\par
16780 {\cf20           On the other hand, BSON and BJData use little endian and should reorder}\par
16781 {\cf20           on big endian systems.}\par
16782 {\cf20     */}\par
16783     {\cf17 template}<{\cf17 typename} NumberType>\par
16784     {\cf18 void} write_number({\cf17 const} NumberType n, {\cf17 const} {\cf18 bool} OutputIsLittleEndian = {\cf17 false})\par
16785     \{\par
16786         {\cf20 // step 1: write number to array of length NumberType}\par
16787         std::array<CharType, {\cf17 sizeof}(NumberType)> vec\{\};\par
16788         std::memcpy(vec.data(), &n, {\cf17 sizeof}(NumberType));\par
16789 \par
16790         {\cf20 // step 2: write array to output (with possible reordering)}\par
16791         {\cf19 if} (is_little_endian != OutputIsLittleEndian)\par
16792         \{\par
16793             {\cf20 // reverse byte order prior to conversion if necessary}\par
16794             std::reverse(vec.begin(), vec.end());\par
16795         \}\par
16796 \par
16797         oa->write_characters(vec.data(), {\cf17 sizeof}(NumberType));\par
16798     \}\par
