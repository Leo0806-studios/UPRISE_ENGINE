6376 {\cf17 struct }wide_string_input_helper<BaseInputAdapter, 2>\par
6377 \{\par
6378     {\cf20 // UTF-16}\par
6379     {\cf17 static} {\cf18 void} fill_buffer(BaseInputAdapter& input,\par
6380                             std::array<std::char_traits<char>::int_type, 4>& utf8_bytes,\par
6381                             {\cf18 size_t}& utf8_bytes_index,\par
6382                             {\cf18 size_t}& utf8_bytes_filled)\par
6383     \{\par
6384         utf8_bytes_index = 0;\par
6385 \par
6386         {\cf19 if} (JSON_HEDLEY_UNLIKELY(input.empty()))\par
6387         \{\par
6388             utf8_bytes[0] = std::char_traits<char>::eof();\par
6389             utf8_bytes_filled = 1;\par
6390         \}\par
6391         {\cf19 else}\par
6392         \{\par
6393             {\cf20 // get the current character}\par
6394             {\cf17 const} {\cf17 auto} wc = input.get_character();\par
6395 \par
6396             {\cf20 // UTF-16 to UTF-8 encoding}\par
6397             {\cf19 if} (wc < 0x80)\par
6398             \{\par
6399                 utf8_bytes[0] = {\cf17 static_cast<}std::char_traits<char>::int_type{\cf17 >}(wc);\par
6400                 utf8_bytes_filled = 1;\par
6401             \}\par
6402             {\cf19 else} {\cf19 if} (wc <= 0x7FF)\par
6403             \{\par
6404                 utf8_bytes[0] = {\cf17 static_cast<}std::char_traits<char>::int_type{\cf17 >}(0xC0u | (({\cf17 static_cast<}{\cf18 unsigned} {\cf18 int}{\cf17 >}(wc) >> 6u)));\par
6405                 utf8_bytes[1] = {\cf17 static_cast<}std::char_traits<char>::int_type{\cf17 >}(0x80u | ({\cf17 static_cast<}{\cf18 unsigned} {\cf18 int}{\cf17 >}(wc) & 0x3Fu));\par
6406                 utf8_bytes_filled = 2;\par
6407             \}\par
6408             {\cf19 else} {\cf19 if} (0xD800 > wc || wc >= 0xE000)\par
6409             \{\par
6410                 utf8_bytes[0] = {\cf17 static_cast<}std::char_traits<char>::int_type{\cf17 >}(0xE0u | (({\cf17 static_cast<}{\cf18 unsigned} {\cf18 int}{\cf17 >}(wc) >> 12u)));\par
6411                 utf8_bytes[1] = {\cf17 static_cast<}std::char_traits<char>::int_type{\cf17 >}(0x80u | (({\cf17 static_cast<}{\cf18 unsigned} {\cf18 int}{\cf17 >}(wc) >> 6u) & 0x3Fu));\par
6412                 utf8_bytes[2] = {\cf17 static_cast<}std::char_traits<char>::int_type{\cf17 >}(0x80u | ({\cf17 static_cast<}{\cf18 unsigned} {\cf18 int}{\cf17 >}(wc) & 0x3Fu));\par
6413                 utf8_bytes_filled = 3;\par
6414             \}\par
6415             {\cf19 else}\par
6416             \{\par
6417                 {\cf19 if} (JSON_HEDLEY_UNLIKELY(!input.empty()))\par
6418                 \{\par
6419                     {\cf17 const} {\cf17 auto} wc2 = {\cf17 static_cast<}{\cf18 unsigned} {\cf18 int}{\cf17 >}(input.get_character());\par
6420                     {\cf17 const} {\cf17 auto} charcode = 0x10000u + ((({\cf17 static_cast<}{\cf18 unsigned} {\cf18 int}{\cf17 >}(wc) & 0x3FFu) << 10u) | (wc2 & 0x3FFu));\par
6421                     utf8_bytes[0] = {\cf17 static_cast<}std::char_traits<char>::int_type{\cf17 >}(0xF0u | (charcode >> 18u));\par
6422                     utf8_bytes[1] = {\cf17 static_cast<}std::char_traits<char>::int_type{\cf17 >}(0x80u | ((charcode >> 12u) & 0x3Fu));\par
6423                     utf8_bytes[2] = {\cf17 static_cast<}std::char_traits<char>::int_type{\cf17 >}(0x80u | ((charcode >> 6u) & 0x3Fu));\par
6424                     utf8_bytes[3] = {\cf17 static_cast<}std::char_traits<char>::int_type{\cf17 >}(0x80u | (charcode & 0x3Fu));\par
6425                     utf8_bytes_filled = 4;\par
6426                 \}\par
6427                 {\cf19 else}\par
6428                 \{\par
6429                     utf8_bytes[0] = {\cf17 static_cast<}std::char_traits<char>::int_type{\cf17 >}(wc);\par
6430                     utf8_bytes_filled = 1;\par
6431                 \}\par
6432             \}\par
6433         \}\par
6434     \}\par
6435 \};\par
