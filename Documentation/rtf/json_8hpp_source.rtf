6292         \{\par
6293             {\cf17 auto} result = char_traits<char_type>::to_int_type(*current);\par
6294             std::advance(current, 1);\par
6295             {\cf19 return} result;\par
6296         \}\par
6297 \par
6298         {\cf19 return} char_traits<char_type>::eof();\par
6299     \}\par
6300 \par
6301   {\cf17 private}:\par
6302     IteratorType current;\par
6303     IteratorType end;\par
