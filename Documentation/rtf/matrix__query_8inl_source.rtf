96     {\cf17 template}<length_t C, length_t R, {\cf17 typename} T, qualifier Q>\par
97     GLM_FUNC_QUALIFIER {\cf18 bool} isOrthogonal(mat<C, R, T, Q> {\cf17 const}& m, T {\cf17 const}& epsilon)\par
98     \{\par
99         {\cf18 bool} result = {\cf17 true};\par
100         {\cf19 for}(length_t i(0); result && i < m.length(); ++i)\par
101         \{\par
102             result = isNormalized(m[i], epsilon);\par
103             {\cf19 for}(length_t j(i + 1); result && j < m.length(); ++j)\par
104                 result = abs(dot(m[i], m[j])) <= epsilon;\par
105         \}\par
106 \par
107         {\cf19 if}(result)\par
108         \{\par
109             mat<C, R, T, Q> tmp = transpose(m);\par
110             {\cf19 for}(length_t i(0); result && i < m.length(); ++i)\par
111             \{\par
