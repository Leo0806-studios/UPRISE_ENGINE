00142      {\cf18 void} Model::processNode(aiNode* node, {\cf17 const} aiScene* scene)\par
00143     \{\par
00144         {\cf20 //TrPr(ctx, __func__)}\par
00145         {\cf20 // process all the node’s meshes (if any)}\par
00146         {\cf19 for} ({\cf18 unsigned} {\cf18 int} i = 0; i < node->mNumMeshes; i++)\par
00147         \{\par
00148             aiMesh* mesh = scene->mMeshes[node->mMeshes[i]];\par
00149             meshes.push_back(processMesh(mesh, scene));\par
00150         \}\par
00151         {\cf20 // then do the same for each of its children}\par
00152         {\cf19 for} ({\cf18 unsigned} {\cf18 int} i = 0; i < node->mNumChildren; i++)\par
00153         \{\par
00154             processNode(node->mChildren[i], scene);\par
00155         \}\par
00156         {\cf20 //TrPrE(ctx);}\par
00157     \}\par
