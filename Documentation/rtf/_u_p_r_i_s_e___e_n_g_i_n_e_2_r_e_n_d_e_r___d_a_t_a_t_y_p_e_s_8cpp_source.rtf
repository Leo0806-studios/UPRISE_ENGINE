00121      {\cf18 void} Model::loadModel({\cf18 string} path)\par
00122     \{\par
00123         TracyCZoneN(ctux, {\cf22 "loading"}, {\cf17 true});\par
00124         Assimp::Importer {\cf17 import};\par
00125 \par
00126         {\cf17 const} aiScene * scene = {\cf17 import}.ReadFile(path, aiProcess_Triangulate |\par
00127             aiProcess_FlipUVs);\par
00128         {\cf19 if} (!scene || scene->mFlags & AI_SCENE_FLAGS_INCOMPLETE ||\par
00129             !scene->mRootNode)\par
00130         \{\par
00131             cout << {\cf22 "ERROR::ASSIMP::"} << {\cf17 import}.GetErrorString() << endl;\par
00132             TracyCZoneEnd(ctux);\par
00133 \par
00134             {\cf19 return};\par
00135         \}\par
00136         directory = path.substr(0, path.find_last_of({\cf23 '\\\\'}));\par
00137         processNode(scene->mRootNode, scene);\par
00138         TracyCZoneEnd(ctux);\par
00139 \par
