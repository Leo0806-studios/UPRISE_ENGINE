00062             shader.setFloat(({\cf22 "material."} + name + number).c_str(), i);\par
00063             glBindTexture(GL_TEXTURE_2D, textures[i].{\cf18 id});\par
00064         \}\par
00065         glActiveTexture(GL_TEXTURE0);\par
00066         {\cf20 // draw mesh}\par
00067         glBindVertexArray(VAO);\par
00068         glDrawElements(GL_TRIANGLES, indices.size(), GL_UNSIGNED_INT, 0);\par
00069         glBindVertexArray(0);\par
00070     \}\par
00071 \par
00072      {\cf18 void} Mesh::setupMesh()\par
00073     \{\par
00074         glGenVertexArrays(1, &VAO);\par
00075         glGenBuffers(1, &VBO);\par
00076         glGenBuffers(1, &EBO);\par
00077         glBindVertexArray(VAO);\par
00078         glBindBuffer(GL_ARRAY_BUFFER, VBO);\par
00079         glBufferData(GL_ARRAY_BUFFER, vertices.size() * {\cf17 sizeof}(Vertex),\par
00080             &vertices[0], GL_STATIC_DRAW);\par
00081         glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, EBO);\par
00082         glBufferData(GL_ELEMENT_ARRAY_BUFFER, indices.size() *\par
00083             {\cf17 sizeof}({\cf18 unsigned} {\cf18 int}), &indices[0], GL_STATIC_DRAW);\par
00084         {\cf20 // vertex positions}\par
00085         glEnableVertexAttribArray(0);\par
00086         glVertexAttribPointer(0, 3, GL_FLOAT, GL_FALSE, {\cf17 sizeof}(Vertex),\par
00087             ({\cf18 void}*)0);\par
00088         {\cf20 // vertex normals}\par
00089         glEnableVertexAttribArray(1);\par
00090         glVertexAttribPointer(1, 3, GL_FLOAT, GL_FALSE, {\cf17 sizeof}(Vertex),\par
00091             ({\cf18 void}*)offsetof(Vertex, Normal));\par
00092         {\cf20 // vertex texture coords}\par
00093         glEnableVertexAttribArray(2);\par
00094         glVertexAttribPointer(2, 2, GL_FLOAT, GL_FALSE, {\cf17 sizeof}(Vertex),\par
00095             ({\cf18 void}*)offsetof(Vertex, TexCoords));\par
00096         glBindVertexArray(0);\par
00097     \}\par
