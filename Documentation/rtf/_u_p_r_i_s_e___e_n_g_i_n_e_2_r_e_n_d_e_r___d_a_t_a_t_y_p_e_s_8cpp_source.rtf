00270      {\cf18 unsigned} {\cf18 int} Model::TextureFromFile({\cf17 const} {\cf18 char}* path, {\cf17 const} {\cf18 string}& directory, {\cf18 bool} gamma)\par
00271     \{\par
00272         {\cf20 //TrPr(ctx, __func__)}\par
00273         {\cf18 string} filename = string(path);\par
00274         filename = directory + {\cf23 '\\\\'} + filename;\par
00275 \par
00276         {\cf18 unsigned} {\cf18 int} textureID;\par
00277         glGenTextures(1, &textureID);\par
00278 \par
00279         {\cf18 int} width, height, nrComponents;\par
00280         {\cf18 unsigned} {\cf18 char}* data = stbi_load(filename.c_str(), &width, &height, &nrComponents, 0);\par
00281         {\cf19 if} (data)\par
00282         \{\par
00283             GLenum format;\par
00284             {\cf19 if} (nrComponents == 1)\par
00285                 format = GL_RED;\par
00286             {\cf19 else} {\cf19 if} (nrComponents == 3)\par
00287                 format = GL_RGB;\par
00288             {\cf19 else} {\cf19 if} (nrComponents == 4)\par
00289                 format = GL_RGBA;\par
00290 \par
00291             glBindTexture(GL_TEXTURE_2D, textureID);\par
00292             glTexImage2D(GL_TEXTURE_2D, 0, format, width, height, 0, format, GL_UNSIGNED_BYTE, data);\par
00293             glGenerateMipmap(GL_TEXTURE_2D);\par
00294 \par
00295             glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_REPEAT);\par
00296             glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_REPEAT);\par
00297             glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR_MIPMAP_LINEAR);\par
00298             glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);\par
00299 \par
00300             stbi_image_free(data);\par
00301         \}\par
00302         {\cf19 else}\par
00303         \{\par
00304             std::cout << {\cf22 "Texture failed to load at path: "} << path << std::endl;\par
00305             stbi_image_free(data);\par
00306         \}\par
00307         {\cf20 //TrPrE(ctx);}\par
00308         {\cf19 return} textureID;\par
00309     \}\par
