00159      Mesh Model::processMesh(aiMesh* mesh, {\cf17 const} aiScene* scene)\par
00160     \{\par
00161         {\cf20 //TrPr(ctx, __func__)}\par
00162         {\cf20 //ZoneNamed(procces_mesh, true);}\par
00163         vector<Vertex> vertices;\par
00164         vertices.reserve(mesh->mNumVertices);\par
00165         vector<unsigned int> indices;\par
00166         vector<Texture> textures;\par
00167         Vertex vertex;\par
00168 \par
00169         {\cf19 for} ({\cf18 unsigned} {\cf18 int} i = 0; i < mesh->mNumVertices; i++)\par
00170         \{\par
00171             {\cf20 //ZoneNamed(gather_verts, true);}\par
00172 \par
00173             {\cf20 // process vertex positions, normals and texture coordinates}\par
00174             {\cf20 //[...]}\par
00175             {\cf20 //DATATYPES::TS_P_Vector3 vector;}\par
00176             {\cf20 //vector = mesh->mVertices[i];}\par
00177 \par
00178             vertex.Position = mesh->mVertices[i];\par
00179             {\cf20 //vector.x = mesh->mVertices[i].x;}\par
00180             {\cf20 //vector.y = mesh->mVertices[i].y;}\par
00181             {\cf20 //vector.z = mesh->mVertices[i].z;}\par
00182             {\cf20 //vertex.Position = vector;}\par
00183             {\cf20 //vector = mesh->mNormals[i];}\par
00184             {\cf20 //vector.x = mesh->mNormals[i].x;}\par
00185             {\cf20 //vector.y = mesh->mNormals[i].y;}\par
00186             {\cf20 //vector.z = mesh->mNormals[i].z;}\par
00187             vertex.Normal = mesh->mNormals[i];\par
00188             {\cf19 if} (mesh->mTextureCoords[0]) {\cf20 // does the mesh contain texture coordinates?}\par
00189             \{\par
00190                 glm::vec2 vec;\par
00191                 vec.x = mesh->mTextureCoords[0][i].x;\par
00192                 vec.y = mesh->mTextureCoords[0][i].y;\par
00193                 vertex.TexCoords = vec;\par
00194             \}\par
00195             {\cf19 else}\par
00196             \{\par
00197                 vertex.TexCoords = glm::vec2(0.0f, 0.0f);\par
00198             \}\par
00199             vertices.push_back(vertex);\par
00200         \}\par
00201         vertices.shrink_to_fit();\par
00202         {\cf20 // process indices}\par
00203         {\cf20 //[...]}\par
00204         indices.reserve(mesh->mNumFaces);\par
00205         {\cf19 for} ({\cf18 unsigned} {\cf18 int} i = 0; i < mesh->mNumFaces; i++)\par
00206         \{\par
00207 \par
00208 \par
00209             {\cf20 //aiFace face = mesh->mFaces[i];}\par
00210             {\cf19 for} ({\cf18 unsigned} {\cf18 int} j = 0; j < mesh->mFaces[i].mNumIndices; j++) \{\par
00211 \par
00212                 {\cf20 //indices.push_back(face.mIndices[j]);}\par
00213                 indices.push_back(mesh->mFaces[i].mIndices[j]);\par
00214 \par
00215             \}\par
00216         \}\par
00217         {\cf20 // process material}\par
00218         {\cf19 if} (mesh->mMaterialIndex >= 0)\par
00219         \{\par
00220             {\cf20 //[...]}\par
00221             {\cf19 if} (mesh->mMaterialIndex >= 0)\par
00222             \{\par
00223                 aiMaterial* material = scene->mMaterials[mesh->mMaterialIndex];\par
00224                 vector<Texture> diffuseMaps = loadMaterialTextures(material,\par
00225                     aiTextureType_DIFFUSE, {\cf22 "texture_diffuse"});\par
00226                 textures.insert(textures.end(), diffuseMaps.begin(), diffuseMaps.end());\par
00227                 vector<Texture> specularMaps = loadMaterialTextures(material,\par
00228                     aiTextureType_SPECULAR, {\cf22 "texture_specular"});\par
00229                 textures.insert(textures.end(), specularMaps.begin(),\par
00230                     specularMaps.end());\par
00231             \}\par
00232         \}\par
00233         {\cf20 //TrPrE(ctx);}\par
00234         {\cf19 return} Mesh(vertices, indices, textures);\par
00235     \}\par
00236 \par
00237      vector<Texture> Model::loadMaterialTextures(aiMaterial* mat, aiTextureType type, {\cf18 string} typeName)\par
00238     \{\par
00239         {\cf20 //TrPr(ctx, __func__)}\par
00240         vector<Texture> textures;\par
00241         {\cf19 for} ({\cf18 unsigned} {\cf18 int} i = 0; i < mat->GetTextureCount(type); i++)\par
00242         \{\par
00243             aiString str;\par
00244             mat->GetTexture(type, i, &str);\par
00245             {\cf18 bool} skip = {\cf17 false};\par
00246             {\cf19 for} ({\cf18 unsigned} {\cf18 int} j = 0; j < textures_loaded.size(); j++)\par
00247             \{\par
00248                 {\cf19 if} (std::strcmp(textures_loaded[j].path.data(),\par
00249                     str.C_Str()) == 0)\par
00250                 \{\par
00251                     textures.push_back(textures_loaded[j]);\par
00252                     skip = {\cf17 true};\par
00253                     {\cf19 break};\par
00254                 \}\par
00255             \}\par
00256             {\cf19 if} (!skip)\par
00257             \{ {\cf20 // if texture hasn’t been loaded already, load it}\par
00258                 Texture texture;\par
00259                 texture.id = TextureFromFile(str.C_Str(), directory, {\cf17 true});\par
00260                 texture.type = typeName;\par
00261                 texture.path = str.C_Str();\par
00262                 textures.push_back(texture);\par
00263                 textures_loaded.push_back(texture); {\cf20 // add to loaded textures}\par
00264             \}\par
00265         \}\par
00266         {\cf20 //TrPrE(ctx);}\par
00267         {\cf19 return} textures;\par
00268     \}\par
