240 {\cf17 template} <{\cf17 class} T>\par
241 AI_FORCE_INLINE {\cf18 bool} IOStreamBuffer<T>::getNextDataLine(std::vector<T> &buffer, T continuationToken) \{\par
242     buffer.resize(m_cacheSize);\par
243     {\cf19 if} (m_cachePos >= m_cacheSize || 0 == m_filePos) \{\par
244         {\cf19 if} (!readNextBlock()) \{\par
245             {\cf19 return} {\cf17 false};\par
246         \}\par
247     \}\par
248 \par
249     {\cf18 size_t} i = 0;\par
250     {\cf19 for} (;;) \{\par
251         {\cf19 if} (continuationToken == m_cache[m_cachePos] && IsLineEnd(m_cache[m_cachePos + 1])) \{\par
252             ++m_cachePos;\par
253             {\cf19 while} (m_cache[m_cachePos] != {\cf23 '\\n'}) \{\par
254                 ++m_cachePos;\par
255             \}\par
256             ++m_cachePos;\par
257         \} {\cf19 else} {\cf19 if} (IsLineEnd(m_cache[m_cachePos])) \{\par
258             {\cf19 break};\par
259         \}\par
260 \par
261         buffer[i] = m_cache[m_cachePos];\par
262         ++m_cachePos;\par
263         ++i;\par
264 \par
265         {\cf19 if}(i == buffer.size()) \{\par
266             buffer.resize(buffer.size() * 2);\par
267         \}\par
268 \par
269         {\cf19 if} (m_cachePos >= size()) \{\par
270             {\cf19 break};\par
271         \}\par
272         {\cf19 if} (m_cachePos >= m_cacheSize) \{\par
273             {\cf19 if} (!readNextBlock()) \{\par
274                 {\cf19 return} {\cf17 false};\par
275             \}\par
276         \}\par
277     \}\par
278 \par
279     buffer[i] = {\cf23 '\\n'};\par
280     ++m_cachePos;\par
281 \par
282     {\cf19 return} {\cf17 true};\par
283 \}\par
284 \par
285 {\cf17 static} AI_FORCE_INLINE {\cf18 bool} isEndOfCache({\cf18 size_t} pos, {\cf18 size_t} cacheSize) \{\par
286     {\cf19 return} (pos == cacheSize);\par
287 \}\par
288 \par
289 {\cf17 template} <{\cf17 class} T>\par
290 AI_FORCE_INLINE {\cf18 bool} IOStreamBuffer<T>::getNextLine(std::vector<T> &buffer) \{\par
291     buffer.resize(m_cacheSize);\par
292     {\cf19 if} (isEndOfCache(m_cachePos, m_cacheSize) || 0 == m_filePos) \{\par
293         {\cf19 if} (!readNextBlock()) \{\par
294             {\cf19 return} {\cf17 false};\par
295         \}\par
296     \}\par
297 \par
298     {\cf19 if} (IsLineEnd(m_cache[m_cachePos])) \{\par
299         {\cf20 // skip line end}\par
300         {\cf19 while} (m_cache[m_cachePos] != {\cf23 '\\n'}) \{\par
301             ++m_cachePos;\par
302         \}\par
303         ++m_cachePos;\par
304         {\cf19 if} (isEndOfCache(m_cachePos, m_cacheSize)) \{\par
305             {\cf19 if} (!readNextBlock()) \{\par
306                 {\cf19 return} {\cf17 false};\par
307             \}\par
308         \}\par
309     \}\par
310 \par
311     {\cf18 size_t} i(0);\par
312     {\cf19 while} (!IsLineEnd(m_cache[m_cachePos])) \{\par
313         buffer[i] = m_cache[m_cachePos];\par
314         ++m_cachePos;\par
315         ++i;\par
316 \par
317         {\cf19 if}(i == buffer.size()) \{\par
318             buffer.resize(buffer.size() * 2);\par
319         \}\par
320 \par
321         {\cf19 if} (m_cachePos >= m_cacheSize) \{\par
322             {\cf19 if} (!readNextBlock()) \{\par
323                 {\cf19 return} {\cf17 false};\par
324             \}\par
325         \}\par
326     \}\par
327     buffer[i] = {\cf23 '\\n'};\par
328     ++m_cachePos;\par
329 \par
330     {\cf19 return} {\cf17 true};\par
331 \}\par
332 \par
333 {\cf17 template} <{\cf17 class} T>\par
334 AI_FORCE_INLINE {\cf18 bool} IOStreamBuffer<T>::getNextBlock(std::vector<T> &buffer) \{\par
335     {\cf20 // Return the last block-value if getNextLine was used before}\par
336     {\cf19 if} (0 != m_cachePos) \{\par
337         buffer = std::vector<T>(m_cache.begin() + m_cachePos, m_cache.end());\par
338         m_cachePos = 0;\par
339     \} {\cf19 else} \{\par
340         {\cf19 if} (!readNextBlock()) \{\par
341             {\cf19 return} {\cf17 false};\par
342         \}\par
343 \par
344         buffer = std::vector<T>(m_cache.begin(), m_cache.end());\par
345     \}\par
346 \par
347     {\cf19 return} {\cf17 true};\par
348 \}\par
