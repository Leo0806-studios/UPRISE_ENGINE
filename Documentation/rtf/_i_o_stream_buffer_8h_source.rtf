148 {\cf17 template} <{\cf17 class} T>\par
149 AI_FORCE_INLINE {\cf18 bool} IOStreamBuffer<T>::open(IOStream *stream) \{\par
150     {\cf20 //  file still opened!}\par
151     {\cf19 if} ({\cf17 nullptr} != m_stream) \{\par
152         {\cf19 return} {\cf17 false};\par
153     \}\par
154 \par
155     {\cf20 //  Invalid stream pointer}\par
156     {\cf19 if} ({\cf17 nullptr} == stream) \{\par
157         {\cf19 return} {\cf17 false};\par
158     \}\par
159 \par
160     m_stream = stream;\par
161     m_filesize = m_stream->FileSize();\par
162     {\cf19 if} (m_filesize == 0) \{\par
163         {\cf19 return} {\cf17 false};\par
164     \}\par
165     {\cf19 if} (m_filesize < m_cacheSize) \{\par
166         m_cacheSize = m_filesize;\par
167     \}\par
168 \par
169     m_numBlocks = m_filesize / m_cacheSize;\par
170     {\cf19 if} ((m_filesize % m_cacheSize) > 0) \{\par
171         m_numBlocks++;\par
172     \}\par
173 \par
174     {\cf19 return} {\cf17 true};\par
175 \}\par
