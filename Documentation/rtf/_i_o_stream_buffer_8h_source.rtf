185     m_filesize = 0;\par
186     m_numBlocks = 0;\par
187     m_blockIdx = 0;\par
188     m_cachePos = 0;\par
189     m_filePos = 0;\par
190 \par
191     {\cf19 return} {\cf17 true};\par
