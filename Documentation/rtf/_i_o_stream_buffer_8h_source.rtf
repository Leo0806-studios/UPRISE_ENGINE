208 {\cf17 template} <{\cf17 class} T>\par
209 AI_FORCE_INLINE {\cf18 bool} IOStreamBuffer<T>::readNextBlock() \{\par
210     m_stream->Seek(m_filePos, aiOrigin_SET);\par
211     {\cf18 size_t} readLen = m_stream->Read(&m_cache[0], {\cf17 sizeof}(T), m_cacheSize);\par
212     {\cf19 if} (readLen == 0) \{\par
213         {\cf19 return} {\cf17 false};\par
214     \}\par
215     {\cf19 if} (readLen < m_cacheSize) \{\par
216         m_cacheSize = readLen;\par
217     \}\par
218     m_filePos += m_cacheSize;\par
219     m_cachePos = 0;\par
220     m_blockIdx++;\par
221 \par
222     {\cf19 return} {\cf17 true};\par
223 \}\par
