343     {\cf20 // Classic Perlin noise, periodic variant}\par
344     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
345     GLM_FUNC_QUALIFIER T perlin(vec<2, T, Q> {\cf17 const}& Position, vec<2, T, Q> {\cf17 const}& rep)\par
346     \{\par
347         vec<4, T, Q> Pi = floor(vec<4, T, Q>(Position.x, Position.y, Position.x, Position.y)) + vec<4, T, Q>(0.0, 0.0, 1.0, 1.0);\par
348         vec<4, T, Q> Pf = fract(vec<4, T, Q>(Position.x, Position.y, Position.x, Position.y)) - vec<4, T, Q>(0.0, 0.0, 1.0, 1.0);\par
349         Pi = mod(Pi, vec<4, T, Q>(rep.x, rep.y, rep.x, rep.y)); {\cf20 // To create noise with explicit period}\par
350         Pi = mod(Pi, vec<4, T, Q>(289)); {\cf20 // To avoid truncation effects in permutation}\par
351         vec<4, T, Q> ix(Pi.x, Pi.z, Pi.x, Pi.z);\par
352         vec<4, T, Q> iy(Pi.y, Pi.y, Pi.w, Pi.w);\par
353         vec<4, T, Q> fx(Pf.x, Pf.z, Pf.x, Pf.z);\par
354         vec<4, T, Q> fy(Pf.y, Pf.y, Pf.w, Pf.w);\par
355 \par
356         vec<4, T, Q> i = detail::permute(detail::permute(ix) + iy);\par
357 \par
358         vec<4, T, Q> gx = {\cf17 static_cast<}T{\cf17 >}(2) * fract(i / T(41)) - T(1);\par
359         vec<4, T, Q> gy = abs(gx) - T(0.5);\par
360         vec<4, T, Q> tx = floor(gx + T(0.5));\par
361         gx = gx - tx;\par
362 \par
363         vec<2, T, Q> g00(gx.x, gy.x);\par
364         vec<2, T, Q> g10(gx.y, gy.y);\par
365         vec<2, T, Q> g01(gx.z, gy.z);\par
366         vec<2, T, Q> g11(gx.w, gy.w);\par
367 \par
368         vec<4, T, Q> norm = detail::taylorInvSqrt(vec<4, T, Q>(dot(g00, g00), dot(g01, g01), dot(g10, g10), dot(g11, g11)));\par
369         g00 *= norm.x;\par
370         g01 *= norm.y;\par
371         g10 *= norm.z;\par
372         g11 *= norm.w;\par
373 \par
374         T n00 = dot(g00, vec<2, T, Q>(fx.x, fy.x));\par
375         T n10 = dot(g10, vec<2, T, Q>(fx.y, fy.y));\par
376         T n01 = dot(g01, vec<2, T, Q>(fx.z, fy.z));\par
377         T n11 = dot(g11, vec<2, T, Q>(fx.w, fy.w));\par
378 \par
379         vec<2, T, Q> fade_xy = detail::fade(vec<2, T, Q>(Pf.x, Pf.y));\par
380         vec<2, T, Q> n_x = mix(vec<2, T, Q>(n00, n01), vec<2, T, Q>(n10, n11), fade_xy.x);\par
381         T n_xy = mix(n_x.x, n_x.y, fade_xy.y);\par
382         {\cf19 return} T(2.3) * n_xy;\par
383     \}\par
