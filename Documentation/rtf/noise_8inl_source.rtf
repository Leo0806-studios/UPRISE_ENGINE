590     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
591     GLM_FUNC_QUALIFIER T simplex(glm::vec<2, T, Q> {\cf17 const}& v)\par
592     \{\par
593         vec<4, T, Q> {\cf17 const} C = vec<4, T, Q>(\par
594             T( 0.211324865405187),  {\cf20 // (3.0 -  sqrt(3.0)) / 6.0}\par
595             T( 0.366025403784439),  {\cf20 //  0.5 * (sqrt(3.0)  - 1.0)}\par
596             T(-0.577350269189626),  {\cf20 // -1.0 + 2.0 * C.x}\par
597             T( 0.024390243902439)); {\cf20 //  1.0 / 41.0}\par
598 \par
599         {\cf20 // First corner}\par
600         vec<2, T, Q> i  = floor(v + dot(v, vec<2, T, Q>(C[1])));\par
601         vec<2, T, Q> x0 = v -   i + dot(i, vec<2, T, Q>(C[0]));\par
602 \par
603         {\cf20 // Other corners}\par
604         {\cf20 //i1.x = step( x0.y, x0.x ); // x0.x > x0.y ? 1.0 : 0.0}\par
605         {\cf20 //i1.y = 1.0 - i1.x;}\par
606         vec<2, T, Q> i1 = (x0.x > x0.y) ? vec<2, T, Q>(1, 0) : vec<2, T, Q>(0, 1);\par
607         {\cf20 // x0 = x0 - 0.0 + 0.0 * C.xx ;}\par
608         {\cf20 // x1 = x0 - i1 + 1.0 * C.xx ;}\par
609         {\cf20 // x2 = x0 - 1.0 + 2.0 * C.xx ;}\par
610         vec<4, T, Q> x12 = vec<4, T, Q>(x0.x, x0.y, x0.x, x0.y) + vec<4, T, Q>(C.x, C.x, C.z, C.z);\par
611         x12 = vec<4, T, Q>(vec<2, T, Q>(x12) - i1, x12.z, x12.w);\par
612 \par
613         {\cf20 // Permutations}\par
614         i = mod(i, vec<2, T, Q>(289)); {\cf20 // Avoid truncation effects in permutation}\par
615         vec<3, T, Q> p = detail::permute(\par
616             detail::permute(i.y + vec<3, T, Q>(T(0), i1.y, T(1)))\par
617             + i.x + vec<3, T, Q>(T(0), i1.x, T(1)));\par
618 \par
619         vec<3, T, Q> m = max(vec<3, T, Q>(0.5) - vec<3, T, Q>(\par
620             dot(x0, x0),\par
621             dot(vec<2, T, Q>(x12.x, x12.y), vec<2, T, Q>(x12.x, x12.y)),\par
622             dot(vec<2, T, Q>(x12.z, x12.w), vec<2, T, Q>(x12.z, x12.w))), vec<3, T, Q>(0));\par
623         m = m * m ;\par
624         m = m * m ;\par
625 \par
626         {\cf20 // Gradients: 41 points uniformly over a line, mapped onto a diamond.}\par
627         {\cf20 // The ring size 17*17 = 289 is close to a multiple of 41 (41*7 = 287)}\par
628 \par
629         vec<3, T, Q> x = {\cf17 static_cast<}T{\cf17 >}(2) * fract(p * C.w) - T(1);\par
630         vec<3, T, Q> h = abs(x) - T(0.5);\par
631         vec<3, T, Q> ox = floor(x + T(0.5));\par
632         vec<3, T, Q> a0 = x - ox;\par
633 \par
634         {\cf20 // Normalise gradients implicitly by scaling m}\par
635         {\cf20 // Inlined for speed: m *= taylorInvSqrt( a0*a0 + h*h );}\par
636         m *= {\cf17 static_cast<}T{\cf17 >}(1.79284291400159) - T(0.85373472095314) * (a0 * a0 + h * h);\par
637 \par
638         {\cf20 // Compute final noise value at P}\par
639         vec<3, T, Q> g;\par
640         g.x  = a0.x  * x0.x  + h.x  * x0.y;\par
641         {\cf20 //g.yz = a0.yz * x12.xz + h.yz * x12.yw;}\par
642         g.y = a0.y * x12.x + h.y * x12.y;\par
643         g.z = a0.z * x12.z + h.z * x12.w;\par
644         {\cf19 return} T(130) * dot(m, g);\par
645     \}\par
646 \par
647     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
648     GLM_FUNC_QUALIFIER T simplex(vec<3, T, Q> {\cf17 const}& v)\par
649     \{\par
650         vec<2, T, Q> {\cf17 const} C(1.0 / 6.0, 1.0 / 3.0);\par
651         vec<4, T, Q> {\cf17 const} D(0.0, 0.5, 1.0, 2.0);\par
652 \par
653         {\cf20 // First corner}\par
654         vec<3, T, Q> i(floor(v + dot(v, vec<3, T, Q>(C.y))));\par
655         vec<3, T, Q> x0(v - i + dot(i, vec<3, T, Q>(C.x)));\par
656 \par
657         {\cf20 // Other corners}\par
658         vec<3, T, Q> g(step(vec<3, T, Q>(x0.y, x0.z, x0.x), x0));\par
659         vec<3, T, Q> l(T(1) - g);\par
660         vec<3, T, Q> i1(min(g, vec<3, T, Q>(l.z, l.x, l.y)));\par
661         vec<3, T, Q> i2(max(g, vec<3, T, Q>(l.z, l.x, l.y)));\par
662 \par
663         {\cf20 //   x0 = x0 - 0.0 + 0.0 * C.xxx;}\par
664         {\cf20 //   x1 = x0 - i1  + 1.0 * C.xxx;}\par
665         {\cf20 //   x2 = x0 - i2  + 2.0 * C.xxx;}\par
666         {\cf20 //   x3 = x0 - 1.0 + 3.0 * C.xxx;}\par
667         vec<3, T, Q> x1(x0 - i1 + C.x);\par
668         vec<3, T, Q> x2(x0 - i2 + C.y); {\cf20 // 2.0*C.x = 1/3 = C.y}\par
669         vec<3, T, Q> x3(x0 - D.y);      {\cf20 // -1.0+3.0*C.x = -0.5 = -D.y}\par
670 \par
671         {\cf20 // Permutations}\par
672         i = detail::mod289(i);\par
673         vec<4, T, Q> p(detail::permute(detail::permute(detail::permute(\par
674             i.z + vec<4, T, Q>(T(0), i1.z, i2.z, T(1))) +\par
675             i.y + vec<4, T, Q>(T(0), i1.y, i2.y, T(1))) +\par
676             i.x + vec<4, T, Q>(T(0), i1.x, i2.x, T(1))));\par
677 \par
678         {\cf20 // Gradients: 7x7 points over a square, mapped onto an octahedron.}\par
679         {\cf20 // The ring size 17*17 = 289 is close to a multiple of 49 (49*6 = 294)}\par
680         T n_ = {\cf17 static_cast<}T{\cf17 >}(0.142857142857); {\cf20 // 1.0/7.0}\par
681         vec<3, T, Q> ns(n_ * vec<3, T, Q>(D.w, D.y, D.z) - vec<3, T, Q>(D.x, D.z, D.x));\par
682 \par
683         vec<4, T, Q> j(p - T(49) * floor(p * ns.z * ns.z));  {\cf20 //  mod(p,7*7)}\par
684 \par
685         vec<4, T, Q> x_(floor(j * ns.z));\par
686         vec<4, T, Q> y_(floor(j - T(7) * x_));    {\cf20 // mod(j,N)}\par
687 \par
688         vec<4, T, Q> x(x_ * ns.x + ns.y);\par
689         vec<4, T, Q> y(y_ * ns.x + ns.y);\par
690         vec<4, T, Q> h(T(1) - abs(x) - abs(y));\par
691 \par
692         vec<4, T, Q> b0(x.x, x.y, y.x, y.y);\par
693         vec<4, T, Q> b1(x.z, x.w, y.z, y.w);\par
694 \par
695         {\cf20 // vec4 s0 = vec4(lessThan(b0,0.0))*2.0 - 1.0;}\par
696         {\cf20 // vec4 s1 = vec4(lessThan(b1,0.0))*2.0 - 1.0;}\par
697         vec<4, T, Q> s0(floor(b0) * T(2) + T(1));\par
698         vec<4, T, Q> s1(floor(b1) * T(2) + T(1));\par
699         vec<4, T, Q> sh(-step(h, vec<4, T, Q>(0.0)));\par
700 \par
701         vec<4, T, Q> a0 = vec<4, T, Q>(b0.x, b0.z, b0.y, b0.w) + vec<4, T, Q>(s0.x, s0.z, s0.y, s0.w) * vec<4, T, Q>(sh.x, sh.x, sh.y, sh.y);\par
702         vec<4, T, Q> a1 = vec<4, T, Q>(b1.x, b1.z, b1.y, b1.w) + vec<4, T, Q>(s1.x, s1.z, s1.y, s1.w) * vec<4, T, Q>(sh.z, sh.z, sh.w, sh.w);\par
703 \par
704         vec<3, T, Q> p0(a0.x, a0.y, h.x);\par
705         vec<3, T, Q> p1(a0.z, a0.w, h.y);\par
706         vec<3, T, Q> p2(a1.x, a1.y, h.z);\par
707         vec<3, T, Q> p3(a1.z, a1.w, h.w);\par
708 \par
709         {\cf20 // Normalise gradients}\par
710         vec<4, T, Q> norm = detail::taylorInvSqrt(vec<4, T, Q>(dot(p0, p0), dot(p1, p1), dot(p2, p2), dot(p3, p3)));\par
711         p0 *= norm.x;\par
712         p1 *= norm.y;\par
713         p2 *= norm.z;\par
714         p3 *= norm.w;\par
715 \par
716         {\cf20 // Mix final noise value}\par
717         vec<4, T, Q> m = max(T(0.6) - vec<4, T, Q>(dot(x0, x0), dot(x1, x1), dot(x2, x2), dot(x3, x3)), vec<4, T, Q>(0));\par
718         m = m * m;\par
719         {\cf19 return} T(42) * dot(m * m, vec<4, T, Q>(dot(p0, x0), dot(p1, x1), dot(p2, x2), dot(p3, x3)));\par
720     \}\par
721 \par
722     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
723     GLM_FUNC_QUALIFIER T simplex(vec<4, T, Q> {\cf17 const}& v)\par
724     \{\par
725         vec<4, T, Q> {\cf17 const} C(\par
726             0.138196601125011,  {\cf20 // (5 - sqrt(5))/20  G4}\par
727             0.276393202250021,  {\cf20 // 2 * G4}\par
728             0.414589803375032,  {\cf20 // 3 * G4}\par
729             -0.447213595499958); {\cf20 // -1 + 4 * G4}\par
730 \par
731         {\cf20 // (sqrt(5) - 1)/4 = F4, used once below}\par
732         T {\cf17 const} F4 = {\cf17 static_cast<}T{\cf17 >}(0.309016994374947451);\par
733 \par
734         {\cf20 // First corner}\par
735         vec<4, T, Q> i  = floor(v + dot(v, vec<4, T, Q>(F4)));\par
736         vec<4, T, Q> x0 = v -   i + dot(i, vec<4, T, Q>(C.x));\par
737 \par
738         {\cf20 // Other corners}\par
739 \par
740         {\cf20 // Rank sorting originally contributed by Bill Licea-Kane, AMD (formerly ATI)}\par
741         vec<4, T, Q> i0;\par
742         vec<3, T, Q> isX = step(vec<3, T, Q>(x0.y, x0.z, x0.w), vec<3, T, Q>(x0.x));\par
743         vec<3, T, Q> isYZ = step(vec<3, T, Q>(x0.z, x0.w, x0.w), vec<3, T, Q>(x0.y, x0.y, x0.z));\par
744         {\cf20 //  i0.x = dot(isX, vec3(1.0));}\par
745         {\cf20 //i0.x = isX.x + isX.y + isX.z;}\par
746         {\cf20 //i0.yzw = static_cast<T>(1) - isX;}\par
747         i0 = vec<4, T, Q>(isX.x + isX.y + isX.z, T(1) - isX);\par
748         {\cf20 //  i0.y += dot(isYZ.xy, vec2(1.0));}\par
749         i0.y += isYZ.x + isYZ.y;\par
750         {\cf20 //i0.zw += 1.0 - vec<2, T, Q>(isYZ.x, isYZ.y);}\par
751         i0.z += {\cf17 static_cast<}T{\cf17 >}(1) - isYZ.x;\par
752         i0.w += {\cf17 static_cast<}T{\cf17 >}(1) - isYZ.y;\par
753         i0.z += isYZ.z;\par
754         i0.w += {\cf17 static_cast<}T{\cf17 >}(1) - isYZ.z;\par
755 \par
756         {\cf20 // i0 now contains the unique values 0,1,2,3 in each channel}\par
757         vec<4, T, Q> i3 = clamp(i0, T(0), T(1));\par
758         vec<4, T, Q> i2 = clamp(i0 - T(1), T(0), T(1));\par
759         vec<4, T, Q> i1 = clamp(i0 - T(2), T(0), T(1));\par
760 \par
761         {\cf20 //  x0 = x0 - 0.0 + 0.0 * C.xxxx}\par
762         {\cf20 //  x1 = x0 - i1  + 0.0 * C.xxxx}\par
763         {\cf20 //  x2 = x0 - i2  + 0.0 * C.xxxx}\par
764         {\cf20 //  x3 = x0 - i3  + 0.0 * C.xxxx}\par
765         {\cf20 //  x4 = x0 - 1.0 + 4.0 * C.xxxx}\par
766         vec<4, T, Q> x1 = x0 - i1 + C.x;\par
767         vec<4, T, Q> x2 = x0 - i2 + C.y;\par
768         vec<4, T, Q> x3 = x0 - i3 + C.z;\par
769         vec<4, T, Q> x4 = x0 + C.w;\par
770 \par
771         {\cf20 // Permutations}\par
772         i = mod(i, vec<4, T, Q>(289));\par
773         T j0 = detail::permute(detail::permute(detail::permute(detail::permute(i.w) + i.z) + i.y) + i.x);\par
774         vec<4, T, Q> j1 = detail::permute(detail::permute(detail::permute(detail::permute(\par
775             i.w + vec<4, T, Q>(i1.w, i2.w, i3.w, T(1))) +\par
776             i.z + vec<4, T, Q>(i1.z, i2.z, i3.z, T(1))) +\par
777             i.y + vec<4, T, Q>(i1.y, i2.y, i3.y, T(1))) +\par
778             i.x + vec<4, T, Q>(i1.x, i2.x, i3.x, T(1)));\par
779 \par
780         {\cf20 // Gradients: 7x7x6 points over a cube, mapped onto a 4-cross polytope}\par
781         {\cf20 // 7*7*6 = 294, which is close to the ring size 17*17 = 289.}\par
782         vec<4, T, Q> ip = vec<4, T, Q>(T(1) / T(294), T(1) / T(49), T(1) / T(7), T(0));\par
783 \par
784         vec<4, T, Q> p0 = detail::grad4(j0,   ip);\par
785         vec<4, T, Q> p1 = detail::grad4(j1.x, ip);\par
786         vec<4, T, Q> p2 = detail::grad4(j1.y, ip);\par
787         vec<4, T, Q> p3 = detail::grad4(j1.z, ip);\par
788         vec<4, T, Q> p4 = detail::grad4(j1.w, ip);\par
789 \par
790         {\cf20 // Normalise gradients}\par
791         vec<4, T, Q> norm = detail::taylorInvSqrt(vec<4, T, Q>(dot(p0, p0), dot(p1, p1), dot(p2, p2), dot(p3, p3)));\par
792         p0 *= norm.x;\par
793         p1 *= norm.y;\par
794         p2 *= norm.z;\par
795         p3 *= norm.w;\par
796         p4 *= detail::taylorInvSqrt(dot(p4, p4));\par
797 \par
798         {\cf20 // Mix contributions from the five corners}\par
799         vec<3, T, Q> m0 = max(T(0.6) - vec<3, T, Q>(dot(x0, x0), dot(x1, x1), dot(x2, x2)), vec<3, T, Q>(0));\par
800         vec<2, T, Q> m1 = max(T(0.6) - vec<2, T, Q>(dot(x3, x3), dot(x4, x4)             ), vec<2, T, Q>(0));\par
801         m0 = m0 * m0;\par
802         m1 = m1 * m1;\par
803         {\cf19 return} T(49) *\par
804             (dot(m0 * m0, vec<3, T, Q>(dot(p0, x0), dot(p1, x1), dot(p2, x2))) +\par
805             dot(m1 * m1, vec<2, T, Q>(dot(p3, x3), dot(p4, x4))));\par
806     \}\par
807 \}{\cf20 //namespace glm}\par
}
