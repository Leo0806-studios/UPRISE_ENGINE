\pard\plain \s40\li0\widctlpar\adjustright \shading1000\cbpat8 \f2\fs16\cgrid 1 \par
3 {\cf20 // Based on the work of Stefan Gustavson and Ashima Arts on "webgl-noise":}\par
4 {\cf20 // https://github.com/ashima/webgl-noise}\par
5 {\cf20 // Following Stefan Gustavson's paper "Simplex noise demystified":}\par
6 {\cf20 // http://www.itn.liu.se/~stegu/simplexnoise/simplexnoise.pdf}\par
7 \par
8 {\cf17 namespace }glm\{\par
9 {\cf17 namespace }detail\par
10 \{\par
11     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
12     GLM_FUNC_QUALIFIER vec<4, T, Q> grad4(T {\cf17 const}& j, vec<4, T, Q> {\cf17 const}& ip)\par
13     \{\par
14         vec<3, T, Q> pXYZ = floor(fract(vec<3, T, Q>(j) * vec<3, T, Q>(ip)) * T(7)) * ip[2] - T(1);\par
15         T pW = {\cf17 static_cast<}T{\cf17 >}(1.5) - dot(abs(pXYZ), vec<3, T, Q>(1));\par
16         vec<4, T, Q> s = vec<4, T, Q>(lessThan(vec<4, T, Q>(pXYZ, pW), vec<4, T, Q>(0.0)));\par
17         pXYZ = pXYZ + (vec<3, T, Q>(s) * T(2) - T(1)) * s.w;\par
18         {\cf19 return} vec<4, T, Q>(pXYZ, pW);\par
19     \}\par
20 \}{\cf20 //namespace detail}\par
21 \par
22     {\cf20 // Classic Perlin noise}\par
23     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
24     GLM_FUNC_QUALIFIER T perlin(vec<2, T, Q> {\cf17 const}& Position)\par
25     \{\par
26         vec<4, T, Q> Pi = glm::floor(vec<4, T, Q>(Position.x, Position.y, Position.x, Position.y)) + vec<4, T, Q>(0.0, 0.0, 1.0, 1.0);\par
27         vec<4, T, Q> Pf = glm::fract(vec<4, T, Q>(Position.x, Position.y, Position.x, Position.y)) - vec<4, T, Q>(0.0, 0.0, 1.0, 1.0);\par
28         Pi = mod(Pi, vec<4, T, Q>(289)); {\cf20 // To avoid truncation effects in permutation}\par
29         vec<4, T, Q> ix(Pi.x, Pi.z, Pi.x, Pi.z);\par
30         vec<4, T, Q> iy(Pi.y, Pi.y, Pi.w, Pi.w);\par
31         vec<4, T, Q> fx(Pf.x, Pf.z, Pf.x, Pf.z);\par
32         vec<4, T, Q> fy(Pf.y, Pf.y, Pf.w, Pf.w);\par
33 \par
34         vec<4, T, Q> i = detail::permute(detail::permute(ix) + iy);\par
35 \par
36         vec<4, T, Q> gx = {\cf17 static_cast<}T{\cf17 >}(2) * glm::fract(i / T(41)) - T(1);\par
37         vec<4, T, Q> gy = glm::abs(gx) - T(0.5);\par
38         vec<4, T, Q> tx = glm::floor(gx + T(0.5));\par
39         gx = gx - tx;\par
40 \par
41         vec<2, T, Q> g00(gx.x, gy.x);\par
42         vec<2, T, Q> g10(gx.y, gy.y);\par
43         vec<2, T, Q> g01(gx.z, gy.z);\par
