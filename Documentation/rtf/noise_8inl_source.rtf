385     {\cf20 // Classic Perlin noise, periodic variant}\par
386     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
387     GLM_FUNC_QUALIFIER T perlin(vec<3, T, Q> {\cf17 const}& Position, vec<3, T, Q> {\cf17 const}& rep)\par
388     \{\par
389         vec<3, T, Q> Pi0 = mod(floor(Position), rep); {\cf20 // Integer part, modulo period}\par
390         vec<3, T, Q> Pi1 = mod(Pi0 + vec<3, T, Q>(T(1)), rep); {\cf20 // Integer part + 1, mod period}\par
391         Pi0 = mod(Pi0, vec<3, T, Q>(289));\par
392         Pi1 = mod(Pi1, vec<3, T, Q>(289));\par
393         vec<3, T, Q> Pf0 = fract(Position); {\cf20 // Fractional part for interpolation}\par
394         vec<3, T, Q> Pf1 = Pf0 - vec<3, T, Q>(T(1)); {\cf20 // Fractional part - 1.0}\par
395         vec<4, T, Q> ix = vec<4, T, Q>(Pi0.x, Pi1.x, Pi0.x, Pi1.x);\par
396         vec<4, T, Q> iy = vec<4, T, Q>(Pi0.y, Pi0.y, Pi1.y, Pi1.y);\par
397         vec<4, T, Q> iz0(Pi0.z);\par
398         vec<4, T, Q> iz1(Pi1.z);\par
399 \par
400         vec<4, T, Q> ixy = detail::permute(detail::permute(ix) + iy);\par
401         vec<4, T, Q> ixy0 = detail::permute(ixy + iz0);\par
402         vec<4, T, Q> ixy1 = detail::permute(ixy + iz1);\par
403 \par
404         vec<4, T, Q> gx0 = ixy0 / T(7);\par
405         vec<4, T, Q> gy0 = fract(floor(gx0) / T(7)) - T(0.5);\par
406         gx0 = fract(gx0);\par
407         vec<4, T, Q> gz0 = vec<4, T, Q>(0.5) - abs(gx0) - abs(gy0);\par
408         vec<4, T, Q> sz0 = step(gz0, vec<4, T, Q>(0));\par
409         gx0 -= sz0 * (step(T(0), gx0) - T(0.5));\par
410         gy0 -= sz0 * (step(T(0), gy0) - T(0.5));\par
411 \par
412         vec<4, T, Q> gx1 = ixy1 / T(7);\par
413         vec<4, T, Q> gy1 = fract(floor(gx1) / T(7)) - T(0.5);\par
414         gx1 = fract(gx1);\par
415         vec<4, T, Q> gz1 = vec<4, T, Q>(0.5) - abs(gx1) - abs(gy1);\par
416         vec<4, T, Q> sz1 = step(gz1, vec<4, T, Q>(T(0)));\par
417         gx1 -= sz1 * (step(T(0), gx1) - T(0.5));\par
418         gy1 -= sz1 * (step(T(0), gy1) - T(0.5));\par
419 \par
420         vec<3, T, Q> g000 = vec<3, T, Q>(gx0.x, gy0.x, gz0.x);\par
421         vec<3, T, Q> g100 = vec<3, T, Q>(gx0.y, gy0.y, gz0.y);\par
422         vec<3, T, Q> g010 = vec<3, T, Q>(gx0.z, gy0.z, gz0.z);\par
423         vec<3, T, Q> g110 = vec<3, T, Q>(gx0.w, gy0.w, gz0.w);\par
424         vec<3, T, Q> g001 = vec<3, T, Q>(gx1.x, gy1.x, gz1.x);\par
425         vec<3, T, Q> g101 = vec<3, T, Q>(gx1.y, gy1.y, gz1.y);\par
426         vec<3, T, Q> g011 = vec<3, T, Q>(gx1.z, gy1.z, gz1.z);\par
427         vec<3, T, Q> g111 = vec<3, T, Q>(gx1.w, gy1.w, gz1.w);\par
428 \par
429         vec<4, T, Q> norm0 = detail::taylorInvSqrt(vec<4, T, Q>(dot(g000, g000), dot(g010, g010), dot(g100, g100), dot(g110, g110)));\par
430         g000 *= norm0.x;\par
431         g010 *= norm0.y;\par
432         g100 *= norm0.z;\par
433         g110 *= norm0.w;\par
434         vec<4, T, Q> norm1 = detail::taylorInvSqrt(vec<4, T, Q>(dot(g001, g001), dot(g011, g011), dot(g101, g101), dot(g111, g111)));\par
435         g001 *= norm1.x;\par
436         g011 *= norm1.y;\par
437         g101 *= norm1.z;\par
438         g111 *= norm1.w;\par
439 \par
440         T n000 = dot(g000, Pf0);\par
441         T n100 = dot(g100, vec<3, T, Q>(Pf1.x, Pf0.y, Pf0.z));\par
442         T n010 = dot(g010, vec<3, T, Q>(Pf0.x, Pf1.y, Pf0.z));\par
443         T n110 = dot(g110, vec<3, T, Q>(Pf1.x, Pf1.y, Pf0.z));\par
444         T n001 = dot(g001, vec<3, T, Q>(Pf0.x, Pf0.y, Pf1.z));\par
445         T n101 = dot(g101, vec<3, T, Q>(Pf1.x, Pf0.y, Pf1.z));\par
446         T n011 = dot(g011, vec<3, T, Q>(Pf0.x, Pf1.y, Pf1.z));\par
447         T n111 = dot(g111, Pf1);\par
448 \par
449         vec<3, T, Q> fade_xyz = detail::fade(Pf0);\par
450         vec<4, T, Q> n_z = mix(vec<4, T, Q>(n000, n100, n010, n110), vec<4, T, Q>(n001, n101, n011, n111), fade_xyz.z);\par
451         vec<2, T, Q> n_yz = mix(vec<2, T, Q>(n_z.x, n_z.y), vec<2, T, Q>(n_z.z, n_z.w), fade_xyz.y);\par
452         T n_xyz = mix(n_yz.x, n_yz.y, fade_xyz.x);\par
453         {\cf19 return} T(2.2) * n_xyz;\par
454     \}\par
