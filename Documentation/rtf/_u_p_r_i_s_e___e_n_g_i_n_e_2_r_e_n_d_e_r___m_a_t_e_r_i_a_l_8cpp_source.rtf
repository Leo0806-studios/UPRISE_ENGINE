00099   {\cf18 void} PAIN::TerrainModel::DrawObj()\par
00100   \{\par
00101       {\cf17 auto} poss = std::dynamic_pointer_cast<Transform>(object->behaviours[1]);\par
00102 \par
00103       glm::mat4 projection = glm::perspective(glm::radians(std::dynamic_pointer_cast<Camera>(CAM).get()->camera.FOV), ({\cf18 float})1600 / ({\cf18 float})900, 0.1f, 500.0f);\par
00104       glm::mat4 view = std::dynamic_pointer_cast<Camera>(CAM).get()->camera.GetViewMatrix();\par
00105       glm::mat4 rotation = poss.get()->rotation.ToMat4();\par
00106       glm::mat4 model = glm::mat4(1.0f);\par
00107       model = glm::translate(model, (glm::vec3)poss.get()->Position);\par
00108       shader->setMat4({\cf22 "projection"}, projection);\par
00109       shader->setMat4({\cf22 "view"}, view);\par
00110       shader->setMat4({\cf22 "model"}, model);\par
00111       shader->setMat4({\cf22 "Rotation"}, rotation);\par
00112       std::dynamic_pointer_cast<Terrain_Data>({\cf18 object}.get()->behaviours[0]).get()->model.Draw(*shader);\par
00113 \par
00114 \par
00115   \}\par
