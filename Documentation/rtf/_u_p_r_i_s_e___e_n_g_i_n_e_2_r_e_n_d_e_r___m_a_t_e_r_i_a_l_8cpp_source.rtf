00117   PAIN::Mesh PAIN::TerrainModel::generateTerrainMesh({\cf18 int} width, {\cf18 int} depth, {\cf18 float} maxHeight)\par
00118   \{\par
00119       {\cf17 auto} data = (Terrain_Data*)Terraindata;\par
00120       std::vector<Vertex> vertices;\par
00121       std::vector<unsigned int> indices;\par
00122       Vertex vertex;\par
00123       {\cf19 for} ({\cf18 int} z = 0; z < depth; z++) \{\par
00124 \par
00125           {\cf19 for} ({\cf18 int} x = 0; x < width; x++) \{\par
00126               vertex.Position = DATATYPES::TS_P_Vector3(x, data->GetHeight(x, z), z);\par
00127               vertex.Normal = DATATYPES::TS_P_Vector3(0, 1, 0);\par
00128               vertex.TexCoords = glm::vec2(({\cf18 float})x / data->width, ({\cf18 float})z / data->depth);\par
00129               vertices.push_back(vertex);\par
00130           \}\par
00131 \par
00132       \}\par
00133       {\cf19 for} ({\cf18 int} z = 0; z < data->depth - 1; ++z) \{\par
00134           {\cf19 for} ({\cf18 int} x = 0; x < data->width - 1; ++x) \{\par
00135               {\cf18 int} topLeft = z * data->width + x;\par
00136               {\cf18 int} topRight = topLeft + 1;\par
00137               {\cf18 int} bottomLeft = (z + 1) * data->width + x;\par
00138               {\cf18 int} bottomRight = bottomLeft + 1;\par
00139 \par
00140               indices.push_back(topLeft);\par
00141               indices.push_back(bottomLeft);\par
00142               indices.push_back(topRight);\par
00143 \par
00144               indices.push_back(topRight);\par
00145               indices.push_back(bottomLeft);\par
00146               indices.push_back(bottomRight);\par
00147           \}\par
00148       \}\par
00149       {\cf19 return} Mesh(vertices, indices, std::vector<Texture>());\par
00150   \}\par
