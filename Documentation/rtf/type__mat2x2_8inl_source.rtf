497     GLM_FUNC_QUALIFIER GLM_CONSTEXPR mat<2, 2, T, Q> operator/(T scalar, mat<2, 2, T, Q> {\cf17 const}& m)\par
498     \{\par
499         {\cf19 return} mat<2, 2, T, Q>(\par
500             scalar / m[0],\par
501             scalar / m[1]);\par
502     \}\par
503 \par
504     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
505     GLM_FUNC_QUALIFIER GLM_CONSTEXPR {\cf17 typename} mat<2, 2, T, Q>::col_type operator/(mat<2, 2, T, Q> {\cf17 const}& m, {\cf17 typename} mat<2, 2, T, Q>::row_type {\cf17 const}& v)\par
506     \{\par
507         {\cf19 return} inverse(m) * v;\par
508     \}\par
509 \par
510     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
511     GLM_FUNC_QUALIFIER GLM_CONSTEXPR {\cf17 typename} mat<2, 2, T, Q>::row_type operator/({\cf17 typename} mat<2, 2, T, Q>::col_type {\cf17 const}& v, mat<2, 2, T, Q> {\cf17 const}& m)\par
512     \{\par
513         {\cf19 return} v *  inverse(m);\par
514     \}\par
515 \par
516     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
517     GLM_FUNC_QUALIFIER GLM_CONSTEXPR mat<2, 2, T, Q> operator/(mat<2, 2, T, Q> {\cf17 const}& m1, mat<2, 2, T, Q> {\cf17 const}& m2)\par
518     \{\par
519         mat<2, 2, T, Q> m1_copy(m1);\par
520         {\cf19 return} m1_copy /= m2;\par
521     \}\par
522 \par
523     {\cf20 // -- Boolean operators --}\par
524 \par
525     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
526     GLM_FUNC_QUALIFIER GLM_CONSTEXPR {\cf18 bool} operator==(mat<2, 2, T, Q> {\cf17 const}& m1, mat<2, 2, T, Q> {\cf17 const}& m2)\par
527     \{\par
528         {\cf19 return} (m1[0] == m2[0]) && (m1[1] == m2[1]);\par
529     \}\par
530 \par
531     {\cf17 template}<{\cf17 typename} T, qualifier Q>\par
532     GLM_FUNC_QUALIFIER GLM_CONSTEXPR {\cf18 bool} operator!=(mat<2, 2, T, Q> {\cf17 const}& m1, mat<2, 2, T, Q> {\cf17 const}& m2)\par
533     \{\par
534         {\cf19 return} (m1[0] != m2[0]) || (m1[1] != m2[1]);\par
535     \}\par
536 \} {\cf20 //namespace glm}\par
}
