377 \{\par
378     {\cf17 template}<{\cf17 typename} CTy, {\cf17 typename} CTr, {\cf17 template}<length_t, length_t, {\cf17 typename}, qualifier> {\cf17 class }M, length_t C, length_t R, {\cf17 typename} T, qualifier Q>\par
379     GLM_FUNC_QUALIFIER std::basic_ostream<CTy, CTr>& print_matrix_pair_on(std::basic_ostream<CTy, CTr>& os, std::pair<M<C, R, T, Q> {\cf17 const}, M<C, R, T, Q> {\cf17 const}> {\cf17 const}& a)\par
380     \{\par
381         {\cf17 typename} std::basic_ostream<CTy,CTr>::sentry {\cf17 const} cerberus(os);\par
382 \par
383         {\cf19 if}(cerberus)\par
384         \{\par
385             io::format_punct<CTy> {\cf17 const}& fmt(io::get_facet<io::format_punct<CTy> >(os));\par
386             M<C, R, T, Q> {\cf17 const}& ml(a.first);\par
387             M<C, R, T, Q> {\cf17 const}& mr(a.second);\par
388             length_t {\cf17 const}& cols(type<M<C, R, T, Q> >::cols);\par
389             length_t {\cf17 const}& rows(type<M<C, R, T, Q> >::rows);\par
390 \par
391             {\cf19 if}(fmt.formatted)\par
392             \{\par
393                 os << fmt.newline << fmt.delim_left;\par
394 \par
395                 {\cf19 switch}(fmt.order)\par
396                 \{\par
397                     {\cf19 case} io::column_major:\par
398                     \{\par
399                         {\cf19 for}(length_t i(0); i < rows; ++i)\par
400                         \{\par
401                             {\cf19 if}(0 != i)\par
402                                 os << fmt.space;\par
403 \par
404                             os << row(ml, i) << ((rows-1 != i) ? fmt.space : fmt.delim_right) << fmt.space << ((0 != i) ? fmt.space : fmt.delim_left) << row(mr, i);\par
405 \par
406                             {\cf19 if}(rows-1 != i)\par
407                                 os << fmt.newline;\par
408                         \}\par
409                     \}\par
410                     {\cf19 break};\par
411                     {\cf19 case} io::row_major:\par
412                     \{\par
413                         {\cf19 for}(length_t i(0); i < cols; ++i)\par
414                         \{\par
415                             {\cf19 if}(0 != i)\par
416                                 os << fmt.space;\par
417 \par
418                             os << column(ml, i) << ((cols-1 != i) ? fmt.space : fmt.delim_right) << fmt.space << ((0 != i) ? fmt.space : fmt.delim_left) << column(mr, i);\par
419 \par
420                             {\cf19 if}(cols-1 != i)\par
421                                 os << fmt.newline;\par
422                         \}\par
423                     \}\par
424                     {\cf19 break};\par
425                 \}\par
426 \par
427                 os << fmt.delim_right;\par
428             \}\par
429             {\cf19 else}\par
430             \{\par
431                 os << ml << fmt.space << mr;\par
432             \}\par
433         \}\par
434 \par
435         {\cf19 return} os;\par
436     \}\par
