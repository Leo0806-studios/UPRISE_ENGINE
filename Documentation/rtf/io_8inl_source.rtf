236     {\cf17 template}<{\cf17 typename} CTy, {\cf17 typename} CTr, {\cf17 template}<length_t, length_t, {\cf17 typename}, qualifier> {\cf17 class }M, length_t C, length_t R, {\cf17 typename} T, qualifier Q>\par
237     GLM_FUNC_QUALIFIER std::basic_ostream<CTy, CTr>& print_matrix_on(std::basic_ostream<CTy, CTr>& os, M<C, R, T, Q> {\cf17 const}& a)\par
238     \{\par
239         {\cf17 typename} std::basic_ostream<CTy,CTr>::sentry {\cf17 const} cerberus(os);\par
240 \par
