242         \{\par
243             io::format_punct<CTy> {\cf17 const}& fmt(io::get_facet<io::format_punct<CTy> >(os));\par
244 \par
245             length_t {\cf17 const}& cols(type<M<C, R, T, Q> >::cols);\par
246             length_t {\cf17 const}& rows(type<M<C, R, T, Q> >::rows);\par
247 \par
248             {\cf19 if}(fmt.formatted)\par
249             \{\par
250                 os << fmt.newline << fmt.delim_left;\par
251 \par
252                 {\cf19 switch}(fmt.order)\par
253                 \{\par
254                     {\cf19 case} io::column_major:\par
255                     \{\par
256                         {\cf19 for}(length_t i(0); i < rows; ++i)\par
257                         \{\par
258                             {\cf19 if} (0 != i)\par
259                                 os << fmt.space;\par
260 \par
261                             os << row(a, i);\par
262 \par
263                             {\cf19 if}(rows-1 != i)\par
264                                 os << fmt.newline;\par
265                         \}\par
266                     \}\par
267                     {\cf19 break};\par
268 \par
269                     {\cf19 case} io::row_major:\par
270                     \{\par
271                         {\cf19 for}(length_t i(0); i < cols; ++i)\par
272                         \{\par
273                             {\cf19 if}(0 != i)\par
274                                 os << fmt.space;\par
275 \par
276                             os << column(a, i);\par
277 \par
278                             {\cf19 if}(cols-1 != i)\par
279                                 os << fmt.newline;\par
280                         \}\par
281                     \}\par
282                     {\cf19 break};\par
283                 \}\par
284 \par
285                 os << fmt.delim_right;\par
286             \}\par
287             {\cf19 else}\par
288             \{\par
289                 {\cf19 switch} (fmt.order)\par
290                 \{\par
291                     {\cf19 case} io::column_major:\par
292                     \{\par
293                         {\cf19 for}(length_t i(0); i < cols; ++i)\par
294                         \{\par
295                             os << column(a, i);\par
296 \par
297                             {\cf19 if}(cols - 1 != i)\par
298                                 os << fmt.space;\par
299                         \}\par
300                     \}\par
301                     {\cf19 break};\par
302 \par
303                     {\cf19 case} io::row_major:\par
304                     \{\par
305                         {\cf19 for} (length_t i(0); i < rows; ++i)\par
306                         \{\par
307                             os << row(a, i);\par
308 \par
309                             {\cf19 if} (rows-1 != i)\par
