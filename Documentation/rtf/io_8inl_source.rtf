161     {\cf17 template}<{\cf17 typename} CTy, {\cf17 typename} CTr, {\cf17 typename} V>\par
162     GLM_FUNC_QUALIFIER std::basic_ostream<CTy, CTr>&\par
163     print_vector_on(std::basic_ostream<CTy, CTr>& os, V {\cf17 const}& a)\par
164     \{\par
165         {\cf17 typename} std::basic_ostream<CTy, CTr>::sentry {\cf17 const} cerberus(os);\par
166 \par
167         {\cf19 if}(cerberus)\par
168         \{\par
169             io::format_punct<CTy> {\cf17 const}& fmt(io::get_facet<io::format_punct<CTy> >(os));\par
170 \par
171             length_t {\cf17 const}& components(type<V>::components);\par
172 \par
173             {\cf19 if}(fmt.formatted)\par
174             \{\par
175                 io::basic_state_saver<CTy> {\cf17 const} bss(os);\par
176 \par
177                 os << std::fixed << std::right << std::setprecision(static_cast<std::streamsize>(fmt.precision)) << std::setfill(fmt.space) << fmt.delim_left;\par
178 \par
179                 {\cf19 for}(length_t i(0); i < components; ++i)\par
180                 \{\par
181                     os << std::setw(static_cast<int>(fmt.width)) << a[i];\par
182                     {\cf19 if}(components-1 != i)\par
183                         os << fmt.separator;\par
184                 \}\par
185 \par
186                 os << fmt.delim_right;\par
187             \}\par
188             {\cf19 else}\par
189             \{\par
190                 {\cf19 for}(length_t i(0); i < components; ++i)\par
191                 \{\par
192                     os << a[i];\par
193 \par
194                     {\cf19 if}(components-1 != i)\par
195                         os << fmt.space;\par
196                 \}\par
197             \}\par
198         \}\par
199 \par
200         {\cf19 return} os;\par
201     \}\par
202 \}{\cf20 //namespace detail}\par
