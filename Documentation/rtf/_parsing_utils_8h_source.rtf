75 {\cf17 template} <{\cf17 class} {\cf18 char}_t>\par
76 AI_FORCE_INLINE {\cf18 bool} IsUpper(char_t in) \{\par
77     {\cf19 return} (in >= (char_t){\cf23 'A'} && in <= (char_t){\cf23 'Z'});\par
78 \}\par
79 \par
80 {\cf20 // ---------------------------------------------------------------------------------}\par
81 {\cf17 template} <{\cf17 class} {\cf18 char}_t>\par
82 AI_FORCE_INLINE {\cf18 bool} IsLower(char_t in) \{\par
83     {\cf19 return} (in >= (char_t){\cf23 'a'} && in <= (char_t){\cf23 'z'});\par
84 \}\par
85 \par
86 {\cf20 // ---------------------------------------------------------------------------------}\par
87 {\cf17 template} <{\cf17 class} {\cf18 char}_t>\par
88 AI_FORCE_INLINE {\cf18 bool} IsSpace(char_t in) \{\par
89     {\cf19 return} (in == (char_t){\cf23 ' '} || in == (char_t){\cf23 '\\t'});\par
90 \}\par
91 \par
92 {\cf20 // ---------------------------------------------------------------------------------}\par
93 {\cf17 template} <{\cf17 class} {\cf18 char}_t>\par
94 AI_FORCE_INLINE {\cf18 bool} IsLineEnd(char_t in) \{\par
95     {\cf19 return} (in == (char_t){\cf23 '\\r'} || in == (char_t){\cf23 '\\n'} || in == (char_t){\cf23 '\\0'} || in == (char_t){\cf23 '\\f'});\par
96 \}\par
97 \par
98 {\cf20 // ---------------------------------------------------------------------------------}\par
99 {\cf17 template} <{\cf17 class} {\cf18 char}_t>\par
100 AI_FORCE_INLINE {\cf18 bool} IsSpaceOrNewLine(char_t in) \{\par
101     {\cf19 return} IsSpace<char_t>(in) || IsLineEnd<char_t>(in);\par
102 \}\par
103 \par
104 {\cf20 // ---------------------------------------------------------------------------------}\par
105 {\cf17 template} <{\cf17 class} {\cf18 char}_t>\par
106 AI_FORCE_INLINE {\cf18 bool} SkipSpaces({\cf17 const} char_t *in, {\cf17 const} char_t **out) \{\par
107     {\cf19 while} (*in == (char_t){\cf23 ' '} || *in == (char_t){\cf23 '\\t'}) \{\par
108         ++in;\par
109     \}\par
110     *out = in;\par
111     {\cf19 return} !IsLineEnd<char_t>(*in);\par
112 \}\par
113 \par
114 {\cf20 // ---------------------------------------------------------------------------------}\par
115 {\cf17 template} <{\cf17 class} {\cf18 char}_t>\par
116 AI_FORCE_INLINE {\cf18 bool} SkipSpaces({\cf17 const} char_t **inout) \{\par
117     {\cf19 return} SkipSpaces<char_t>(*inout, inout);\par
118 \}\par
119 \par
120 {\cf20 // ---------------------------------------------------------------------------------}\par
121 {\cf17 template} <{\cf17 class} {\cf18 char}_t>\par
122 AI_FORCE_INLINE {\cf18 bool} SkipLine({\cf17 const} char_t *in, {\cf17 const} char_t **out) \{\par
123     {\cf19 while} (*in != (char_t){\cf23 '\\r'} && *in != (char_t){\cf23 '\\n'} && *in != (char_t){\cf23 '\\0'}) \{\par
124         ++in;\par
125     \}\par
126 \par
127     {\cf20 // files are opened in binary mode. Ergo there are both NL and CR}\par
128     {\cf19 while} (*in == (char_t){\cf23 '\\r'} || *in == (char_t){\cf23 '\\n'}) \{\par
129         ++in;\par
130     \}\par
131     *out = in;\par
132     {\cf19 return} *in != (char_t){\cf23 '\\0'};\par
133 \}\par
134 \par
135 {\cf20 // ---------------------------------------------------------------------------------}\par
136 {\cf17 template} <{\cf17 class} {\cf18 char}_t>\par
137 AI_FORCE_INLINE {\cf18 bool} SkipLine({\cf17 const} char_t **inout) \{\par
138     {\cf19 return} SkipLine<char_t>(*inout, inout);\par
139 \}\par
140 \par
141 {\cf20 // ---------------------------------------------------------------------------------}\par
142 {\cf17 template} <{\cf17 class} {\cf18 char}_t>\par
143 AI_FORCE_INLINE {\cf18 bool} SkipSpacesAndLineEnd({\cf17 const} char_t *in, {\cf17 const} char_t **out) \{\par
144     {\cf19 while} (*in == (char_t){\cf23 ' '} || *in == (char_t){\cf23 '\\t'} || *in == (char_t){\cf23 '\\r'} || *in == (char_t){\cf23 '\\n'}) \{\par
145         ++in;\par
146     \}\par
147     *out = in;\par
148     {\cf19 return} *in != {\cf23 '\\0'};\par
149 \}\par
150 \par
151 {\cf20 // ---------------------------------------------------------------------------------}\par
152 {\cf17 template} <{\cf17 class} {\cf18 char}_t>\par
153 AI_FORCE_INLINE {\cf18 bool} SkipSpacesAndLineEnd({\cf17 const} char_t **inout) \{\par
154     {\cf19 return} SkipSpacesAndLineEnd<char_t>(*inout, inout);\par
155 \}\par
156 \par
157 {\cf20 // ---------------------------------------------------------------------------------}\par
158 {\cf17 template} <{\cf17 class} {\cf18 char}_t>\par
159 AI_FORCE_INLINE {\cf18 bool} GetNextLine({\cf17 const} char_t *&buffer, char_t out[BufferSize]) \{\par
160     {\cf19 if} ((char_t){\cf23 '\\0'} == *buffer) \{\par
161         {\cf19 return} {\cf17 false};\par
162     \}\par
163 \par
164     {\cf18 char} *_out = out;\par
165     {\cf18 char} *{\cf17 const} end = _out + BufferSize;\par
166     {\cf19 while} (!IsLineEnd(*buffer) && _out < end) \{\par
167         *_out++ = *buffer++;\par
168     \}\par
169     *_out = (char_t){\cf23 '\\0'};\par
170 \par
171     {\cf19 while} (IsLineEnd(*buffer) && {\cf23 '\\0'} != *buffer) \{\par
172         ++buffer;\par
173     \}\par
174 \par
175     {\cf19 return} {\cf17 true};\par
176 \}\par
177 \par
178 {\cf20 // ---------------------------------------------------------------------------------}\par
179 {\cf17 template} <{\cf17 class} {\cf18 char}_t>\par
180 AI_FORCE_INLINE {\cf18 bool} IsNumeric(char_t in) \{\par
181     {\cf19 return} (in >= {\cf23 '0'} && in <= {\cf23 '9'}) || {\cf23 '-'} == in || {\cf23 '+'} == in;\par
182 \}\par
183 \par
184 {\cf20 // ---------------------------------------------------------------------------------}\par
185 {\cf17 template} <{\cf17 class} {\cf18 char}_t>\par
186 AI_FORCE_INLINE {\cf18 bool} TokenMatch(char_t *&in, {\cf17 const} {\cf18 char} *token, {\cf18 unsigned} {\cf18 int} len) \{\par
187     {\cf19 if} (!::strncmp(token, in, len) && IsSpaceOrNewLine(in[len])) \{\par
188         {\cf19 if} (in[len] != {\cf23 '\\0'}) \{\par
189             in += len + 1;\par
190         \} {\cf19 else} \{\par
191             {\cf20 // If EOF after the token make sure we don't go past end of buffer}\par
192             in += len;\par
193         \}\par
194         {\cf19 return} {\cf17 true};\par
195     \}\par
196 \par
197     {\cf19 return} {\cf17 false};\par
198 \}\par
199 {\cf20 // ---------------------------------------------------------------------------------}\par
205 AI_FORCE_INLINE {\cf18 bool} TokenMatchI({\cf17 const} {\cf18 char} *&in, {\cf17 const} {\cf18 char} *token, {\cf18 unsigned} {\cf18 int} len) \{\par
206     {\cf19 if} (!ASSIMP_strincmp(token, in, len) && IsSpaceOrNewLine(in[len])) \{\par
207         in += len + 1;\par
208         {\cf19 return} {\cf17 true};\par
209     \}\par
210     {\cf19 return} {\cf17 false};\par
211 \}\par
212 \par
213 {\cf20 // ---------------------------------------------------------------------------------}\par
214 AI_FORCE_INLINE {\cf18 void} SkipToken({\cf17 const} {\cf18 char} *&in) \{\par
215     SkipSpaces(&in);\par
216     {\cf19 while} (!IsSpaceOrNewLine(*in)) \{\par
217         ++in;\par
218     \}\par
219 \}\par
220 \par
221 {\cf20 // ---------------------------------------------------------------------------------}\par
222 AI_FORCE_INLINE std::string GetNextToken({\cf17 const} {\cf18 char} *&in) \{\par
223     SkipSpacesAndLineEnd(&in);\par
224     {\cf17 const} {\cf18 char} *cur = in;\par
225     {\cf19 while} (!IsSpaceOrNewLine(*in)) \{\par
226         ++in;\par
227     \}\par
228     {\cf19 return} std::string(cur, ({\cf18 size_t})(in - cur));\par
229 \}\par
230 \par
231 {\cf20 // ---------------------------------------------------------------------------------}\par
238 {\cf17 template} <{\cf17 class} {\cf18 string}_type>\par
239 AI_FORCE_INLINE {\cf18 unsigned} {\cf18 int} tokenize({\cf17 const} string_type &str, std::vector<string_type> &tokens,\par
240         {\cf17 const} string_type &delimiters) \{\par
241     {\cf20 // Skip delimiters at beginning.}\par
242     {\cf17 typename} string_type::size_type lastPos = str.find_first_not_of(delimiters, 0);\par
243 \par
244     {\cf20 // Find first "non-delimiter".}\par
245     {\cf17 typename} string_type::size_type pos = str.find_first_of(delimiters, lastPos);\par
246     {\cf19 while} (string_type::npos != pos || string_type::npos != lastPos) \{\par
247         {\cf20 // Found a token, add it to the vector.}\par
248         string_type tmp = str.substr(lastPos, pos - lastPos);\par
249         {\cf19 if} (!tmp.empty() && {\cf23 ' '} != tmp[0])\par
250             tokens.push_back(tmp);\par
251 \par
252         {\cf20 // Skip delimiters.  Note the "not_of"}\par
253         lastPos = str.find_first_not_of(delimiters, pos);\par
254 \par
255         {\cf20 // Find next "non-delimiter"}\par
256         pos = str.find_first_of(delimiters, lastPos);\par
257     \}\par
258 \par
259     {\cf19 return} {\cf17 static_cast<}{\cf18 unsigned} {\cf18 int}{\cf17 >}(tokens.size());\par
260 \}\par
261 \par
262 {\cf17 inline} std::string ai_stdStrToLower({\cf17 const} std::string &str) \{\par
263     std::string out(str);\par
264     {\cf19 for} ({\cf18 size_t} i = 0; i < str.size(); ++i) \{\par
265         out[i] = (char) tolower(({\cf18 unsigned} {\cf18 char})out[i]);\par
266     \}\par
267     {\cf19 return} out;\par
268 \}\par
