94 GLM_FUNC_QUALIFIER glm_vec4 glm_vec4_reflect(glm_vec4 I, glm_vec4 N)\par
95 \{\par
96     glm_vec4 {\cf17 const} dot0 = glm_vec4_dot(N, I);\par
97     glm_vec4 {\cf17 const} mul0 = _mm_mul_ps(N, dot0);\par
98     glm_vec4 {\cf17 const} mul1 = _mm_mul_ps(mul0, _mm_set1_ps(2.0f));\par
99     glm_vec4 {\cf17 const} sub0 = _mm_sub_ps(I, mul1);\par
100     {\cf19 return} sub0;\par
101 \}\par
