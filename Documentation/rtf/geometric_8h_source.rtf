85 GLM_FUNC_QUALIFIER glm_vec4 glm_vec4_faceforward(glm_vec4 N, glm_vec4 I, glm_vec4 Nref)\par
86 \{\par
87     glm_vec4 {\cf17 const} dot0 = glm_vec4_dot(Nref, I);\par
88     glm_vec4 {\cf17 const} sgn0 = glm_vec4_sign(dot0);\par
89     glm_vec4 {\cf17 const} mul0 = _mm_mul_ps(sgn0, _mm_set1_ps(-1.0f));\par
90     glm_vec4 {\cf17 const} mul1 = _mm_mul_ps(N, mul0);\par
91     {\cf19 return} mul1;\par
92 \}\par
