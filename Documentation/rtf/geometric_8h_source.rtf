53         glm_vec4 {\cf17 const} had1 = _mm_hadd_ps(had0, had0);\par
54         {\cf19 return} had1;\par
55 {\cf21 #   else}\par
56         glm_vec4 {\cf17 const} mul0 = _mm_mul_ps(v1, v2);\par
57         glm_vec4 {\cf17 const} mov0 = _mm_movehl_ps(mul0, mul0);\par
58         glm_vec4 {\cf17 const} add0 = _mm_add_ps(mov0, mul0);\par
59         glm_vec4 {\cf17 const} swp1 = _mm_shuffle_ps(add0, add0, 1);\par
60         glm_vec4 {\cf17 const} add1 = _mm_add_ss(add0, swp1);\par
61         {\cf19 return} add1;\par
62 {\cf21 #   endif}\par
63 \}\par
64 \par
65 GLM_FUNC_QUALIFIER glm_vec4 glm_vec4_cross(glm_vec4 v1, glm_vec4 v2)\par
66 \{\par
67     glm_vec4 {\cf17 const} swp0 = _mm_shuffle_ps(v1, v1, _MM_SHUFFLE(3, 0, 2, 1));\par
68     glm_vec4 {\cf17 const} swp1 = _mm_shuffle_ps(v1, v1, _MM_SHUFFLE(3, 1, 0, 2));\par
69     glm_vec4 {\cf17 const} swp2 = _mm_shuffle_ps(v2, v2, _MM_SHUFFLE(3, 0, 2, 1));\par
70     glm_vec4 {\cf17 const} swp3 = _mm_shuffle_ps(v2, v2, _MM_SHUFFLE(3, 1, 0, 2));\par
71     glm_vec4 {\cf17 const} mul0 = _mm_mul_ps(swp0, swp3);\par
72     glm_vec4 {\cf17 const} mul1 = _mm_mul_ps(swp1, swp2);\par
73     glm_vec4 {\cf17 const} sub0 = _mm_sub_ps(mul0, mul1);\par
74     {\cf19 return} sub0;\par
75 \}\par
