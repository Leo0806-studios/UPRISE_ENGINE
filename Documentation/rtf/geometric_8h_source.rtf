103 GLM_FUNC_QUALIFIER __m128 glm_vec4_refract(glm_vec4 I, glm_vec4 N, glm_vec4 eta)\par
104 \{\par
105     {\cf20 // k = 1.0 - eta * eta * (1.0 - dot(N, I) * dot(N, I));}\par
106     {\cf20 // if (k < 0.0)}\par
107     {\cf20 //  R = genType(0.0);       // or genDType(0.0)}\par
108     {\cf20 // else}\par
109     {\cf20 //  R = eta * I - (eta * dot(N, I) + sqrt(k)) * N;}\par
110 \par
111     glm_vec4 {\cf17 const} dot0 = glm_vec4_dot(N, I);                   {\cf20 // dot(N, I)}\par
112     glm_vec4 {\cf17 const} mul0 = _mm_mul_ps(eta, eta);                 {\cf20 // eta * eta}\par
113     glm_vec4 {\cf17 const} mul1 = _mm_mul_ps(dot0, dot0);               {\cf20 // dot(N, I) * dot(N, I)}\par
114     glm_vec4 {\cf17 const} sub1 = _mm_sub_ps(_mm_set1_ps(1.0f), mul1);  {\cf20 // (1.0 - dot(N, I) * dot(N, I))}\par
115     glm_vec4 {\cf17 const} mul2 = _mm_mul_ps(mul0, sub1);               {\cf20 // eta * eta * (1.0 - dot(N, I) * dot(N, I))}\par
116     glm_vec4 {\cf17 const} sub0 = _mm_sub_ps(_mm_set1_ps(1.0f), mul2);  {\cf20 // 1.0 - eta * eta * (1.0 - dot(N, I) * dot(N, I))}\par
117 \par
118     {\cf19 if}(_mm_movemask_ps(_mm_cmplt_ss(sub0, _mm_set1_ps(0.0f))) == 0)\par
119         {\cf19 return} _mm_set1_ps(0.0f);\par
120 \par
121     glm_vec4 {\cf17 const} sqt0 = _mm_sqrt_ps(sub0);\par
122     glm_vec4 {\cf17 const} mad0 = glm_vec4_fma(eta, dot0, sqt0);\par
123     glm_vec4 {\cf17 const} mul4 = _mm_mul_ps(mad0, N);\par
124     glm_vec4 {\cf17 const} mul5 = _mm_mul_ps(eta, I);\par
125     glm_vec4 {\cf17 const} sub2 = _mm_sub_ps(mul5, mul4);\par
126 \par
127     {\cf19 return} sub2;\par
128 \}\par
