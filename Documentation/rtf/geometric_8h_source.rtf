77 GLM_FUNC_QUALIFIER glm_vec4 glm_vec4_normalize(glm_vec4 v)\par
78 \{\par
79     glm_vec4 {\cf17 const} dot0 = glm_vec4_dot(v, v);\par
80     glm_vec4 {\cf17 const} isr0 = _mm_rsqrt_ps(dot0);\par
81     glm_vec4 {\cf17 const} mul0 = _mm_mul_ps(v, isr0);\par
82     {\cf19 return} mul0;\par
83 \}\par
