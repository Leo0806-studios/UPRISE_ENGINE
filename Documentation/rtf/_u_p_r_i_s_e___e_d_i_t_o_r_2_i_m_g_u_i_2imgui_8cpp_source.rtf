02622         {\cf19 if} (mid->key < key)\par
02623         \{\par
02624             in_p = ++mid;\par
02625             count -= count2 + 1;\par
02626         \}\par
02627         {\cf19 else}\par
02628         \{\par
02629             count = count2;\par
02630         \}\par
02631     \}\par
