03519     {\cf17 const} {\cf18 char}* text_display_end;\par
03520     {\cf19 if} (hide_text_after_hash)\par
03521     \{\par
03522         text_display_end = FindRenderedTextEnd(text, text_end);\par
03523     \}\par
03524     {\cf19 else}\par
03525     \{\par
03526         {\cf19 if} (!text_end)\par
03527             text_end = text + strlen(text); {\cf20 // FIXME-OPT}\par
03528         text_display_end = text_end;\par
03529     \}\par
03530 \par
03531     {\cf19 if} (text != text_display_end)\par
03532     \{\par
03533         window->DrawList->AddText(g.Font, g.FontSize, pos, GetColorU32(ImGuiCol_Text), text, text_display_end);\par
