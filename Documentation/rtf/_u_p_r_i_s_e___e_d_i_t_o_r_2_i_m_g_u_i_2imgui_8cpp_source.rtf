04609     SetActiveID(window->MoveId, window);\par
04610     g.NavDisableHighlight = {\cf17 true};\par
04611     g.ActiveIdClickOffset = g.IO.MouseClickedPos[0] - window->RootWindowDockTree->Pos;\par
04612     g.ActiveIdNoClearOnFocusLoss = {\cf17 true};\par
04613     SetActiveIdUsingAllKeyboardKeys();\par
04614 \par
04615     {\cf18 bool} can_move_window = {\cf17 true};\par
04616     {\cf19 if} ((window->Flags & ImGuiWindowFlags_NoMove) || (window->RootWindowDockTree->Flags & ImGuiWindowFlags_NoMove))\par
04617         can_move_window = {\cf17 false};\par
04618     {\cf19 if} (ImGuiDockNode* node = window->DockNodeAsHost)\par
04619         {\cf19 if} (node->VisibleWindow && (node->VisibleWindow->Flags & ImGuiWindowFlags_NoMove))\par
