09415 {\cf20 // Request a desired route for an input chord (key + mods).}\par
09416 {\cf20 // Return true if the route is available this frame.}\par
09417 {\cf20 // - Routes and key ownership are attributed at the beginning of next frame based on best score and mod state.}\par
09418 {\cf20 //   (Conceptually this does a "Submit for next frame" + "Test for current frame".}\par
09419 {\cf20 //   As such, it could be called TrySetXXX or SubmitXXX, or the Submit and Test operations should be separate.)}\par
09420 {\cf18 bool} ImGui::SetShortcutRouting(ImGuiKeyChord key_chord, ImGuiInputFlags flags, ImGuiID owner_id)\par
09421 \{\par
09422     ImGuiContext& g = *GImGui;\par
09423     {\cf19 if} ((flags & ImGuiInputFlags_RouteTypeMask_) == 0)\par
09424         flags |= ImGuiInputFlags_RouteGlobal | ImGuiInputFlags_RouteOverFocused | ImGuiInputFlags_RouteOverActive; {\cf20 // IMPORTANT: This is the default for SetShortcutRouting() but NOT Shortcut()}\par
09425     {\cf19 else}\par
09426         IM_ASSERT(ImIsPowerOfTwo(flags & ImGuiInputFlags_RouteTypeMask_)); {\cf20 // Check that only 1 routing flag is used}\par
09427     IM_ASSERT(owner_id != ImGuiKeyOwner_Any && owner_id != ImGuiKeyOwner_NoOwner);\par
09428     {\cf19 if} (flags & (ImGuiInputFlags_RouteOverFocused | ImGuiInputFlags_RouteOverActive | ImGuiInputFlags_RouteUnlessBgFocused))\par
09429         IM_ASSERT(flags & ImGuiInputFlags_RouteGlobal);\par
09430 \par
09431     {\cf20 // Add ImGuiMod_XXXX when a corresponding ImGuiKey_LeftXXX/ImGuiKey_RightXXX is specified.}\par
09432     key_chord = FixupKeyChord(key_chord);\par
09433 \par
09434     {\cf20 // [DEBUG] Debug break requested by user}\par
09435     {\cf19 if} (g.DebugBreakInShortcutRouting == key_chord)\par
09436         IM_DEBUG_BREAK();\par
09437 \par
09438     {\cf19 if} (flags & ImGuiInputFlags_RouteUnlessBgFocused)\par
09439         {\cf19 if} (g.NavWindow == NULL)\par
09440             {\cf19 return} {\cf17 false};\par
09441 \par
09442     {\cf20 // Note how ImGuiInputFlags_RouteAlways won't set routing and thus won't set owner. May want to rework this?}\par
09443     {\cf19 if} (flags & ImGuiInputFlags_RouteAlways)\par
09444     \{\par
09445         IMGUI_DEBUG_LOG_INPUTROUTING({\cf22 "SetShortcutRouting(%s, flags=%04X, owner_id=0x%08X) -> always, no register\\n"}, GetKeyChordName(key_chord), flags, owner_id);\par
09446         {\cf19 return} {\cf17 true};\par
09447     \}\par
09448 \par
09449     {\cf20 // Specific culling when there's an active item.}\par
09450     {\cf19 if} (g.ActiveId != 0 && g.ActiveId != owner_id)\par
09451     \{\par
09452         {\cf19 if} (flags & ImGuiInputFlags_RouteActive)\par
09453             {\cf19 return} {\cf17 false};\par
09454 \par
09455         {\cf20 // Cull shortcuts with no modifiers when it could generate a character.}\par
09456         {\cf20 // e.g. Shortcut(ImGuiKey_G) also generates 'g' character, should not trigger when InputText() is active.}\par
09457         {\cf20 // but  Shortcut(Ctrl+G) should generally trigger when InputText() is active.}\par
09458         {\cf20 // TL;DR: lettered shortcut with no mods or with only Alt mod will not trigger while an item reading text input is active.}\par
09459         {\cf20 // (We cannot filter based on io.InputQueueCharacters[] contents because of trickling and key<>chars submission order are undefined)}\par
09460         {\cf19 if} (g.IO.WantTextInput && IsKeyChordPotentiallyCharInput(key_chord))\par
09461         \{\par
09462             IMGUI_DEBUG_LOG_INPUTROUTING({\cf22 "SetShortcutRouting(%s, flags=%04X, owner_id=0x%08X) -> filtered as potential char input\\n"}, GetKeyChordName(key_chord), flags, owner_id);\par
09463             {\cf19 return} {\cf17 false};\par
09464         \}\par
09465 \par
09466         {\cf20 // ActiveIdUsingAllKeyboardKeys trumps all for ActiveId}\par
09467         {\cf19 if} ((flags & ImGuiInputFlags_RouteOverActive) == 0 && g.ActiveIdUsingAllKeyboardKeys)\par
09468         \{\par
09469             ImGuiKey key = (ImGuiKey)(key_chord & ~ImGuiMod_Mask_);\par
09470             {\cf19 if} (key == ImGuiKey_None)\par
09471                 key = ConvertSingleModFlagToKey((ImGuiKey)(key_chord & ImGuiMod_Mask_));\par
09472             {\cf19 if} (key >= ImGuiKey_Keyboard_BEGIN && key < ImGuiKey_Keyboard_END)\par
09473                 {\cf19 return} {\cf17 false};\par
09474         \}\par
09475     \}\par
09476 \par
09477     {\cf20 // Where do we evaluate route for?}\par
09478     ImGuiID focus_scope_id = g.CurrentFocusScopeId;\par
09479     {\cf19 if} (flags & ImGuiInputFlags_RouteFromRootWindow)\par
09480         focus_scope_id = g.CurrentWindow->RootWindow->ID; {\cf20 // See PushFocusScope() call in Begin()}\par
09481 \par
09482     {\cf17 const} {\cf18 int} score = CalcRoutingScore(focus_scope_id, owner_id, flags);\par
09483     IMGUI_DEBUG_LOG_INPUTROUTING({\cf22 "SetShortcutRouting(%s, flags=%04X, owner_id=0x%08X) -> score %d\\n"}, GetKeyChordName(key_chord), flags, owner_id, score);\par
09484     {\cf19 if} (score == 255)\par
09485         {\cf19 return} {\cf17 false};\par
09486 \par
09487     {\cf20 // Submit routing for NEXT frame (assuming score is sufficient)}\par
09488     {\cf20 // FIXME: Could expose a way to use a "serve last" policy for same score resolution (using <= instead of <).}\par
09489     ImGuiKeyRoutingData* routing_data = GetShortcutRoutingData(key_chord);\par
09490     {\cf20 //const bool set_route = (flags & ImGuiInputFlags_ServeLast) ? (score <= routing_data->RoutingNextScore) : (score < routing_data->RoutingNextScore);}\par
09491     {\cf19 if} (score < routing_data->RoutingNextScore)\par
09492     \{\par
09493         routing_data->RoutingNext = owner_id;\par
09494         routing_data->RoutingNextScore = (ImU8)score;\par
09495     \}\par
09496 \par
09497     {\cf20 // Return routing state for CURRENT frame}\par
09498     {\cf19 if} (routing_data->RoutingCurr == owner_id)\par
09499         IMGUI_DEBUG_LOG_INPUTROUTING({\cf22 "--> granting current route\\n"});\par
09500     {\cf19 return} routing_data->RoutingCurr == owner_id;\par
09501 \}\par
