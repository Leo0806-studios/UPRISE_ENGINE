04602 {\cf18 void} ImGui::StartMouseMovingWindow(ImGuiWindow* window)\par
04603 \{\par
04604     {\cf20 // Set ActiveId even if the _NoMove flag is set. Without it, dragging away from a window with _NoMove would activate hover on other windows.}\par
