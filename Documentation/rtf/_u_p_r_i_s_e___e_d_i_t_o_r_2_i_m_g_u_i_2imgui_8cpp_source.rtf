18769 {\cf20 // Create an explicit dockspace node within an existing window. Also expose dock node flags and creates a CentralNode by default.}\par
18770 {\cf20 // The Central Node is always displayed even when empty and shrink/extend according to the requested size of its neighbors.}\par
18771 {\cf20 // DockSpace() needs to be submitted _before_ any window they can host. If you use a dockspace, submit it early in your app.}\par
18772 {\cf20 // When ImGuiDockNodeFlags_KeepAliveOnly is set, nothing is submitted in the current window (function may be called from any location).}\par
18773 ImGuiID ImGui::DockSpace(ImGuiID dockspace_id, {\cf17 const} ImVec2& size_arg, ImGuiDockNodeFlags flags, {\cf17 const} ImGuiWindowClass* window_class)\par
18774 \{\par
18775     ImGuiContext& g = *GImGui;\par
18776     ImGuiWindow* window = GetCurrentWindowRead();\par
18777     {\cf19 if} (!(g.IO.ConfigFlags & ImGuiConfigFlags_DockingEnable))\par
18778         {\cf19 return} 0;\par
18779 \par
18780     {\cf20 // Early out if parent window is hidden/collapsed}\par
18781     {\cf20 // This is faster but also DockNodeUpdateTabBar() relies on TabBarLayout() running (which won't if SkipItems=true) to set NextSelectedTabId = 0). See #2960.}\par
18782     {\cf20 // If for whichever reason this is causing problem we would need to ensure that DockNodeUpdateTabBar() ends up clearing NextSelectedTabId even if SkipItems=true.}\par
18783     {\cf19 if} (window->SkipItems)\par
18784         flags |= ImGuiDockNodeFlags_KeepAliveOnly;\par
18785     {\cf19 if} ((flags & ImGuiDockNodeFlags_KeepAliveOnly) == 0)\par
18786         window = GetCurrentWindow(); {\cf20 // call to set window->WriteAccessed = true;}\par
18787 \par
18788     IM_ASSERT((flags & ImGuiDockNodeFlags_DockSpace) == 0);\par
18789     IM_ASSERT(dockspace_id != 0);\par
18790     ImGuiDockNode* node = DockContextFindNodeByID(&g, dockspace_id);\par
18791     {\cf19 if} (node == NULL)\par
18792     \{\par
18793         IMGUI_DEBUG_LOG_DOCKING({\cf22 "[docking] DockSpace: dockspace node 0x%08X created\\n"}, dockspace_id);\par
18794         node = DockContextAddNode(&g, dockspace_id);\par
18795         node->SetLocalFlags(ImGuiDockNodeFlags_CentralNode);\par
18796     \}\par
18797     {\cf19 if} (window_class && window_class->ClassId != node->WindowClass.ClassId)\par
18798         IMGUI_DEBUG_LOG_DOCKING({\cf22 "[docking] DockSpace: dockspace node 0x%08X: setup WindowClass 0x%08X -> 0x%08X\\n"}, dockspace_id, node->WindowClass.ClassId, window_class->ClassId);\par
18799     node->SharedFlags = flags;\par
18800     node->WindowClass = window_class ? *window_class : ImGuiWindowClass();\par
18801 \par
18802     {\cf20 // When a DockSpace transitioned form implicit to explicit this may be called a second time}\par
18803     {\cf20 // It is possible that the node has already been claimed by a docked window which appeared before the DockSpace() node, so we overwrite IsDockSpace again.}\par
18804     {\cf19 if} (node->LastFrameActive == g.FrameCount && !(flags & ImGuiDockNodeFlags_KeepAliveOnly))\par
18805     \{\par
18806         IM_ASSERT(node->IsDockSpace() == {\cf17 false} && {\cf22 "Cannot call DockSpace() twice a frame with the same ID"});\par
18807         node->SetLocalFlags(node->LocalFlags | ImGuiDockNodeFlags_DockSpace);\par
18808         {\cf19 return} dockspace_id;\par
18809     \}\par
18810     node->SetLocalFlags(node->LocalFlags | ImGuiDockNodeFlags_DockSpace);\par
18811 \par
18812     {\cf20 // Keep alive mode, this is allow windows docked into this node so stay docked even if they are not visible}\par
18813     {\cf19 if} (flags & ImGuiDockNodeFlags_KeepAliveOnly)\par
18814     \{\par
18815         node->LastFrameAlive = g.FrameCount;\par
18816         {\cf19 return} dockspace_id;\par
18817     \}\par
18818 \par
18819     {\cf17 const} ImVec2 content_avail = GetContentRegionAvail();\par
18820     ImVec2 size = ImTrunc(size_arg);\par
18821     {\cf19 if} (size.x <= 0.0f)\par
18822         size.x = ImMax(content_avail.x + size.x, 4.0f); {\cf20 // Arbitrary minimum child size (0.0f causing too much issues)}\par
18823     {\cf19 if} (size.y <= 0.0f)\par
18824         size.y = ImMax(content_avail.y + size.y, 4.0f);\par
18825     IM_ASSERT(size.x > 0.0f && size.y > 0.0f);\par
18826 \par
18827     node->Pos = window->DC.CursorPos;\par
18828     node->Size = node->SizeRef = size;\par
18829     SetNextWindowPos(node->Pos);\par
18830     SetNextWindowSize(node->Size);\par
18831     g.NextWindowData.PosUndock = {\cf17 false};\par
18832 \par
18833     {\cf20 // FIXME-DOCK: Why do we need a child window to host a dockspace, could we host it in the existing window?}\par
18834     {\cf20 // FIXME-DOCK: What is the reason for not simply calling BeginChild()? (OK to have a reason but should be commented)}\par
18835     ImGuiWindowFlags window_flags = ImGuiWindowFlags_ChildWindow | ImGuiWindowFlags_DockNodeHost;\par
18836     window_flags |= ImGuiWindowFlags_NoSavedSettings | ImGuiWindowFlags_NoResize | ImGuiWindowFlags_NoCollapse | ImGuiWindowFlags_NoTitleBar;\par
18837     window_flags |= ImGuiWindowFlags_NoScrollbar | ImGuiWindowFlags_NoScrollWithMouse;\par
18838     window_flags |= ImGuiWindowFlags_NoBackground;\par
18839 \par
18840     {\cf18 char} title[256];\par
18841     ImFormatString(title, IM_ARRAYSIZE(title), {\cf22 "%s/DockSpace_%08X"}, window->Name, dockspace_id);\par
18842 \par
18843     PushStyleVar(ImGuiStyleVar_ChildBorderSize, 0.0f);\par
18844     Begin(title, NULL, window_flags);\par
18845     PopStyleVar();\par
18846 \par
18847     ImGuiWindow* host_window = g.CurrentWindow;\par
18848     DockNodeSetupHostWindow(node, host_window);\par
18849     host_window->ChildId = window->GetID(title);\par
18850     node->OnlyNodeWithWindows = NULL;\par
18851 \par
18852     IM_ASSERT(node->IsRootNode());\par
18853 \par
18854     {\cf20 // We need to handle the rare case were a central node is missing.}\par
18855     {\cf20 // This can happen if the node was first created manually with DockBuilderAddNode() but _without_ the ImGuiDockNodeFlags_Dockspace.}\par
18856     {\cf20 // Doing it correctly would set the _CentralNode flags, which would then propagate according to subsequent split.}\par
18857     {\cf20 // It would also be ambiguous to attempt to assign a central node while there are split nodes, so we wait until there's a single node remaining.}\par
18858     {\cf20 // The specific sub-property of _CentralNode we are interested in recovering here is the "Don't delete when empty" property,}\par
18859     {\cf20 // as it doesn't make sense for an empty dockspace to not have this property.}\par
18860     {\cf19 if} (node->IsLeafNode() && !node->IsCentralNode())\par
18861         node->SetLocalFlags(node->LocalFlags | ImGuiDockNodeFlags_CentralNode);\par
18862 \par
18863     {\cf20 // Update the node}\par
18864     DockNodeUpdate(node);\par
18865 \par
18866     End();\par
18867 \par
18868     ImRect bb(node->Pos, node->Pos + size);\par
18869     ItemSize(size);\par
18870     ItemAdd(bb, dockspace_id, NULL, ImGuiItemFlags_NoNav); {\cf20 // Not a nav point (could be, would need to draw the nav rect and replicate/refactor activation from BeginChild(), but seems like CTRL+Tab works better here?)}\par
18871     {\cf19 if} ((g.LastItemData.StatusFlags & ImGuiItemStatusFlags_HoveredRect) && IsWindowChildOf(g.HoveredWindow, host_window, {\cf17 false}, {\cf17 true})) {\cf20 // To fullfill IsItemHovered(), similar to EndChild()}\par
18872         g.LastItemData.StatusFlags |= ImGuiItemStatusFlags_HoveredWindow;\par
18873 \par
18874     {\cf19 return} dockspace_id;\par
18875 \}\par
18876 \par
18877 {\cf20 // Tips: Use with ImGuiDockNodeFlags_PassthruCentralNode!}\par
18878 {\cf20 // The limitation with this call is that your window won't have a local menu bar, but you can also use BeginMainMenuBar().}\par
18879 {\cf20 // Even though we could pass window flags, it would also require the user to be able to call BeginMenuBar() somehow meaning we can't Begin/End in a single function.}\par
18880 {\cf20 // If you really want a menu bar inside the same window as the one hosting the dockspace, you will need to copy this code somewhere and tweak it.}\par
18881 ImGuiID ImGui::DockSpaceOverViewport(ImGuiID dockspace_id, {\cf17 const} ImGuiViewport* viewport, ImGuiDockNodeFlags dockspace_flags, {\cf17 const} ImGuiWindowClass* window_class)\par
18882 \{\par
18883     {\cf19 if} (viewport == NULL)\par
18884         viewport = GetMainViewport();\par
18885 \par
18886     {\cf20 // Submit a window filling the entire viewport}\par
18887     SetNextWindowPos(viewport->WorkPos);\par
18888     SetNextWindowSize(viewport->WorkSize);\par
18889     SetNextWindowViewport(viewport->ID);\par
18890 \par
18891     ImGuiWindowFlags host_window_flags = 0;\par
18892     host_window_flags |= ImGuiWindowFlags_NoTitleBar | ImGuiWindowFlags_NoCollapse | ImGuiWindowFlags_NoResize | ImGuiWindowFlags_NoMove | ImGuiWindowFlags_NoDocking;\par
18893     host_window_flags |= ImGuiWindowFlags_NoBringToFrontOnFocus | ImGuiWindowFlags_NoNavFocus;\par
18894     {\cf19 if} (dockspace_flags & ImGuiDockNodeFlags_PassthruCentralNode)\par
18895         host_window_flags |= ImGuiWindowFlags_NoBackground;\par
18896 \par
18897     {\cf18 char} label[32];\par
18898     ImFormatString(label, IM_ARRAYSIZE(label), {\cf22 "WindowOverViewport_%08X"}, viewport->ID);\par
18899 \par
18900     PushStyleVar(ImGuiStyleVar_WindowRounding, 0.0f);\par
18901     PushStyleVar(ImGuiStyleVar_WindowBorderSize, 0.0f);\par
18902     PushStyleVar(ImGuiStyleVar_WindowPadding, ImVec2(0.0f, 0.0f));\par
18903     Begin(label, NULL, host_window_flags);\par
18904     PopStyleVar(3);\par
18905 \par
18906     {\cf20 // Submit the dockspace}\par
18907     {\cf19 if} (dockspace_id == 0)\par
18908         dockspace_id = GetID({\cf22 "DockSpace"});\par
18909     DockSpace(dockspace_id, ImVec2(0.0f, 0.0f), dockspace_flags, window_class);\par
