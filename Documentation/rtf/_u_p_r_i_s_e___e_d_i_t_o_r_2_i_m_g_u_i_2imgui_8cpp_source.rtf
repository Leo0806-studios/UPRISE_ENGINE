02775 {\cf18 void} ImGuiTextFilter::ImGuiTextRange::split({\cf18 char} separator, ImVector<ImGuiTextRange>* out){\cf17  const}\par
02776 {\cf17 }\{\par
02777     out->resize(0);\par
02778     {\cf17 const} {\cf18 char}* wb = b;\par
02779     {\cf17 const} {\cf18 char}* we = wb;\par
02780     {\cf19 while} (we < e)\par
02781     \{\par
02782         {\cf19 if} (*we == separator)\par
02783         \{\par
02784             out->push_back(ImGuiTextRange(wb, we));\par
02785             wb = we + 1;\par
02786         \}\par
02787         we++;\par
02788     \}\par
02789     {\cf19 if} (wb != we)\par
02790         out->push_back(ImGuiTextRange(wb, we));\par
02791 \}\par
02792 \par
02793 {\cf18 void} ImGuiTextFilter::Build()\par
02794 \{\par
02795     Filters.resize(0);\par
02796     ImGuiTextRange input_range(InputBuf, InputBuf + strlen(InputBuf));\par
02797     input_range.split({\cf23 ','}, &Filters);\par
02798 \par
02799     CountGrep = 0;\par
02800     {\cf19 for} (ImGuiTextRange& f : Filters)\par
02801     \{\par
02802         {\cf19 while} (f.b < f.e && ImCharIsBlankA(f.b[0]))\par
02803             f.b++;\par
02804         {\cf19 while} (f.e > f.b && ImCharIsBlankA(f.e[-1]))\par
02805             f.e--;\par
02806         {\cf19 if} (f.empty())\par
02807             {\cf19 continue};\par
02808         {\cf19 if} (f.b[0] != {\cf23 '-'})\par
02809             CountGrep += 1;\par
02810     \}\par
02811 \}\par
02812 \par
02813 {\cf18 bool} ImGuiTextFilter::PassFilter({\cf17 const} {\cf18 char}* text, {\cf17 const} {\cf18 char}* text_end){\cf17  const}\par
02814 {\cf17 }\{\par
02815     {\cf19 if} (Filters.Size == 0)\par
02816         {\cf19 return} {\cf17 true};\par
02817 \par
02818     {\cf19 if} (text == NULL)\par
02819         text = text_end = {\cf22 ""};\par
02820 \par
02821     {\cf19 for} ({\cf17 const} ImGuiTextRange& f : Filters)\par
02822     \{\par
02823         {\cf19 if} (f.b == f.e)\par
02824             {\cf19 continue};\par
02825         {\cf19 if} (f.b[0] == {\cf23 '-'})\par
02826         \{\par
02827             {\cf20 // Subtract}\par
02828             {\cf19 if} (ImStristr(text, text_end, f.b + 1, f.e) != NULL)\par
02829                 {\cf19 return} {\cf17 false};\par
02830         \}\par
02831         {\cf19 else}\par
02832         \{\par
02833             {\cf20 // Grep}\par
02834             {\cf19 if} (ImStristr(text, text_end, f.b, f.e) != NULL)\par
02835                 {\cf19 return} {\cf17 true};\par
02836         \}\par
02837     \}\par
02838 \par
02839     {\cf20 // Implicit * grep}\par
02840     {\cf19 if} (CountGrep == 0)\par
02841         {\cf19 return} {\cf17 true};\par
02842 \par
02843     {\cf19 return} {\cf17 false};\par
02844 \}\par
