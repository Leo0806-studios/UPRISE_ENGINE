04395 {\cf21 #ifndef IMGUI_DISABLE_DEBUG_TOOLS}\par
04396     {\cf19 if} ({\cf18 id} != 0)\par
04397     \{\par
04398         {\cf20 // [DEBUG] Item Picker tool!}\par
04399         {\cf20 // We perform the check here because reaching is path is rare (1~ time a frame),}\par
04400         {\cf20 // making the cost of this tool near-zero! We could get better call-stack and support picking non-hovered}\par
04401         {\cf20 // items if we performed the test in ItemAdd(), but that would incur a bigger runtime cost.}\par
04402         {\cf19 if} (g.DebugItemPickerActive && g.HoveredIdPreviousFrame == {\cf18 id})\par
04403             GetForegroundDrawList()->AddRect(bb.Min, bb.Max, IM_COL32(255, 255, 0, 255));\par
