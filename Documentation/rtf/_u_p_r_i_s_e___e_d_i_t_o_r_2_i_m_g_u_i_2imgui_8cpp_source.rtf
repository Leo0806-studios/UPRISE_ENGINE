15923 {\cf18 void} ImGui::DestroyPlatformWindows()\par
15924 \{\par
15925     {\cf20 // We call the destroy window on every viewport (including the main viewport, index 0) to give a chance to the backend}\par
15926     {\cf20 // to clear any data they may have stored in e.g. PlatformUserData, RendererUserData.}\par
15927     {\cf20 // It is convenient for the platform backend code to store something in the main viewport, in order for e.g. the mouse handling}\par
15928     {\cf20 // code to operator a consistent manner.}\par
15929     {\cf20 // It is expected that the backend can handle calls to Renderer_DestroyWindow/Platform_DestroyWindow without}\par
15930     {\cf20 // crashing if it doesn't have data stored.}\par
15931     ImGuiContext& g = *GImGui;\par
15932     {\cf19 for} (ImGuiViewportP* viewport : g.Viewports)\par
15933         DestroyPlatformWindow(viewport);\par
15934 \}\par
