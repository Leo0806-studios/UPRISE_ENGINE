03622         {\cf20 //          <-> this is generally some padding value}\par
03623 \par
03624         {\cf17 const} ImFont* font = draw_list->_Data->Font;\par
03625         {\cf17 const} {\cf18 float} font_size = draw_list->_Data->FontSize;\par
03626         {\cf17 const} {\cf18 float} font_scale = draw_list->_Data->FontScale;\par
03627         {\cf17 const} {\cf18 char}* text_end_ellipsis = NULL;\par
03628         {\cf17 const} {\cf18 float} ellipsis_width = font->EllipsisWidth * font_scale;\par
03629 \par
03630         {\cf20 // We can now claim the space between pos_max.x and ellipsis_max.x}\par
03631         {\cf17 const} {\cf18 float} text_avail_width = ImMax((ImMax(pos_max.x, ellipsis_max_x) - ellipsis_width) - pos_min.x, 1.0f);\par
03632         {\cf18 float} text_size_clipped_x = font->CalcTextSizeA(font_size, text_avail_width, 0.0f, text, text_end_full, &text_end_ellipsis).x;\par
03633         {\cf19 if} (text == text_end_ellipsis && text_end_ellipsis < text_end_full)\par
03634         \{\par
03635             {\cf20 // Always display at least 1 character if there's no room for character + ellipsis}\par
03636             text_end_ellipsis = text + ImTextCountUtf8BytesFromChar(text, text_end_full);\par
03637             text_size_clipped_x = font->CalcTextSizeA(font_size, FLT_MAX, 0.0f, text, text_end_ellipsis).x;\par
03638         \}\par
03639         {\cf19 while} (text_end_ellipsis > text && ImCharIsBlankA(text_end_ellipsis[-1]))\par
03640         \{\par
03641             {\cf20 // Trim trailing space before ellipsis (FIXME: Supporting non-ascii blanks would be nice, for this we need a function to backtrack in UTF-8 text)}\par
03642             text_end_ellipsis--;\par
03643             text_size_clipped_x -= font->CalcTextSizeA(font_size, FLT_MAX, 0.0f, text_end_ellipsis, text_end_ellipsis + 1).x; {\cf20 // Ascii blanks are always 1 byte}\par
03644         \}\par
03645 \par
03646         {\cf20 // Render text, render ellipsis}\par
03647         RenderTextClippedEx(draw_list, pos_min, ImVec2(clip_max_x, pos_max.y), text, text_end_ellipsis, &text_size, ImVec2(0.0f, 0.0f));\par
03648         ImVec2 ellipsis_pos = ImTrunc(ImVec2(pos_min.x + text_size_clipped_x, pos_min.y));\par
03649         {\cf19 if} (ellipsis_pos.x + ellipsis_width <= ellipsis_max_x)\par
03650             {\cf19 for} ({\cf18 int} i = 0; i < font->EllipsisCharCount; i++, ellipsis_pos.x += font->EllipsisCharStep * font_scale)\par
03651                 font->RenderChar(draw_list, font_size, ellipsis_pos, GetColorU32(ImGuiCol_Text), font->EllipsisChar);\par
03652     \}\par
03653     {\cf19 else}\par
03654     \{\par
03655         RenderTextClippedEx(draw_list, pos_min, ImVec2(clip_max_x, pos_max.y), text, text_end_full, &text_size, ImVec2(0.0f, 0.0f));\par
03656     \}\par
03657 \par
03658     {\cf19 if} (g.LogEnabled)\par
03659         LogRenderedText(&pos_min, text, text_end_full);\par
03660 \}\par
