19901 {\cf17 static} {\cf17 const} {\cf18 char}* GetClipboardTextFn_DefaultImpl({\cf18 void}* user_data_ctx)\par
19902 \{\par
19903     ImGuiContext& g = *(ImGuiContext*)user_data_ctx;\par
19904     g.ClipboardHandlerData.clear();\par
