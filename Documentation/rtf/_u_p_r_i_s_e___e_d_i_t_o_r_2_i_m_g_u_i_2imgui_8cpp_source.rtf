19523     {\cf20 // Update window flag}\par
19524     IM_ASSERT((window->Flags & ImGuiWindowFlags_ChildWindow) == 0);\par
19525     window->Flags |= ImGuiWindowFlags_ChildWindow | ImGuiWindowFlags_NoResize;\par
19526     window->ChildFlags |= ImGuiChildFlags_AlwaysUseWindowPadding;\par
