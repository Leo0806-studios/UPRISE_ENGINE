16764 {\cf18 bool} ImGui::DockContextCalcDropPosForDocking(ImGuiWindow* target, ImGuiDockNode* target_node, ImGuiWindow* payload_window, ImGuiDockNode* payload_node, ImGuiDir split_dir, {\cf18 bool} split_outer, ImVec2* out_pos)\par
16765 \{\par
16766     {\cf19 if} (target != NULL && target_node == NULL)\par
16767         target_node = target->DockNode;\par
16768 \par
16769     {\cf20 // In DockNodePreviewDockSetup() for a root central node instead of showing both "inner" and "outer" drop rects}\par
16770     {\cf20 // (which would be functionally identical) we only show the outer one. Reflect this here.}\par
16771     {\cf19 if} (target_node && target_node->ParentNode == NULL && target_node->IsCentralNode() && split_dir != ImGuiDir_None)\par
16772         split_outer = {\cf17 true};\par
16773     ImGuiDockPreviewData split_data;\par
16774     DockNodePreviewDockSetup(target, target_node, payload_window, payload_node, &split_data, {\cf17 false}, split_outer);\par
16775     {\cf19 if} (split_data.DropRectsDraw[split_dir+1].IsInverted())\par
16776         {\cf19 return} {\cf17 false};\par
16777     *out_pos = split_data.DropRectsDraw[split_dir+1].GetCenter();\par
16778     {\cf19 return} {\cf17 true};\par
16779 \}\par
