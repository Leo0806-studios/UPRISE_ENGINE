18365 {\cf18 void} ImGui::DockNodeTreeSplit(ImGuiContext* ctx, ImGuiDockNode* parent_node, ImGuiAxis split_axis, {\cf18 int} split_inheritor_child_idx, {\cf18 float} split_ratio, ImGuiDockNode* new_node)\par
18366 \{\par
18367     ImGuiContext& g = *GImGui;\par
18368     IM_ASSERT(split_axis != ImGuiAxis_None);\par
18369 \par
18370     ImGuiDockNode* child_0 = (new_node && split_inheritor_child_idx != 0) ? new_node : DockContextAddNode(ctx, 0);\par
18371     child_0->ParentNode = parent_node;\par
18372 \par
18373     ImGuiDockNode* child_1 = (new_node && split_inheritor_child_idx != 1) ? new_node : DockContextAddNode(ctx, 0);\par
18374     child_1->ParentNode = parent_node;\par
18375 \par
18376     ImGuiDockNode* child_inheritor = (split_inheritor_child_idx == 0) ? child_0 : child_1;\par
18377     DockNodeMoveChildNodes(child_inheritor, parent_node);\par
18378     parent_node->ChildNodes[0] = child_0;\par
18379     parent_node->ChildNodes[1] = child_1;\par
18380     parent_node->ChildNodes[split_inheritor_child_idx]->VisibleWindow = parent_node->VisibleWindow;\par
18381     parent_node->SplitAxis = split_axis;\par
18382     parent_node->VisibleWindow = NULL;\par
18383     parent_node->AuthorityForPos = parent_node->AuthorityForSize = ImGuiDataAuthority_DockNode;\par
18384 \par
18385     {\cf18 float} size_avail = (parent_node->Size[split_axis] - g.Style.DockingSeparatorSize);\par
18386     size_avail = ImMax(size_avail, g.Style.WindowMinSize[split_axis] * 2.0f);\par
18387     IM_ASSERT(size_avail > 0.0f); {\cf20 // If you created a node manually with DockBuilderAddNode(), you need to also call DockBuilderSetNodeSize() before splitting.}\par
18388     child_0->SizeRef = child_1->SizeRef = parent_node->Size;\par
18389     child_0->SizeRef[split_axis] = ImTrunc(size_avail * split_ratio);\par
18390     child_1->SizeRef[split_axis] = ImTrunc(size_avail - child_0->SizeRef[split_axis]);\par
18391 \par
18392     DockNodeMoveWindows(parent_node->ChildNodes[split_inheritor_child_idx], parent_node);\par
18393     DockSettingsRenameNodeReferences(parent_node->ID, parent_node->ChildNodes[split_inheritor_child_idx]->ID);\par
18394     DockNodeUpdateHasCentralNodeChild(DockNodeGetRootNode(parent_node));\par
18395     DockNodeTreeUpdatePosSize(parent_node, parent_node->Pos, parent_node->Size);\par
18396 \par
18397     {\cf20 // Flags transfer (e.g. this is where we transfer the ImGuiDockNodeFlags_CentralNode property)}\par
18398     child_0->SharedFlags = parent_node->SharedFlags & ImGuiDockNodeFlags_SharedFlagsInheritMask_;\par
18399     child_1->SharedFlags = parent_node->SharedFlags & ImGuiDockNodeFlags_SharedFlagsInheritMask_;\par
18400     child_inheritor->LocalFlags = parent_node->LocalFlags & ImGuiDockNodeFlags_LocalFlagsTransferMask_;\par
18401     parent_node->LocalFlags &= ~ImGuiDockNodeFlags_LocalFlagsTransferMask_;\par
18402     child_0->UpdateMergedFlags();\par
18403     child_1->UpdateMergedFlags();\par
18404     parent_node->UpdateMergedFlags();\par
18405     {\cf19 if} (child_inheritor->IsCentralNode())\par
18406         DockNodeGetRootNode(parent_node)->CentralNode = child_inheritor;\par
18407 \}\par
