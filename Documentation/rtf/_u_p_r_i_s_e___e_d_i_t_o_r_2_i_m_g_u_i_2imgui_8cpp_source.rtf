11410 {\cf20 // Helper to snap on edges when aiming at an item very close to the edge,}\par
11411 {\cf20 // So the difference between WindowPadding and ItemSpacing will be in the visible area after scrolling.}\par
11412 {\cf20 // When we refactor the scrolling API this may be configurable with a flag?}\par
11413 {\cf20 // Note that the effect for this won't be visible on X axis with default Style settings as WindowPadding.x == ItemSpacing.x by default.}\par
11414 {\cf17 static} {\cf18 float} CalcScrollEdgeSnap({\cf18 float} target, {\cf18 float} snap_min, {\cf18 float} snap_max, {\cf18 float} snap_threshold, {\cf18 float} center_ratio)\par
11415 \{\par
11416     {\cf19 if} (target <= snap_min + snap_threshold)\par
11417         {\cf19 return} ImLerp(snap_min, target, center_ratio);\par
11418     {\cf19 if} (target >= snap_max - snap_threshold)\par
11419         {\cf19 return} ImLerp(target, snap_max, center_ratio);\par
11420     {\cf19 return} target;\par
11421 \}\par
11422 \par
11423 {\cf17 static} ImVec2 CalcNextScrollFromScrollTargetAndClamp(ImGuiWindow* window)\par
11424 \{\par
11425     ImVec2 scroll = window->Scroll;\par
11426     ImVec2 decoration_size(window->DecoOuterSizeX1 + window->DecoInnerSizeX1 + window->DecoOuterSizeX2, window->DecoOuterSizeY1 + window->DecoInnerSizeY1 + window->DecoOuterSizeY2);\par
11427     {\cf19 for} ({\cf18 int} axis = 0; axis < 2; axis++)\par
11428     \{\par
11429         {\cf19 if} (window->ScrollTarget[axis] < FLT_MAX)\par
11430         \{\par
11431             {\cf18 float} center_ratio = window->ScrollTargetCenterRatio[axis];\par
11432             {\cf18 float} scroll_target = window->ScrollTarget[axis];\par
11433             {\cf19 if} (window->ScrollTargetEdgeSnapDist[axis] > 0.0f)\par
11434             \{\par
11435                 {\cf18 float} snap_min = 0.0f;\par
11436                 {\cf18 float} snap_max = window->ScrollMax[axis] + window->SizeFull[axis] - decoration_size[axis];\par
11437                 scroll_target = CalcScrollEdgeSnap(scroll_target, snap_min, snap_max, window->ScrollTargetEdgeSnapDist[axis], center_ratio);\par
11438             \}\par
11439             scroll[axis] = scroll_target - center_ratio * (window->SizeFull[axis] - decoration_size[axis]);\par
11440         \}\par
11441         scroll[axis] = IM_ROUND(ImMax(scroll[axis], 0.0f));\par
11442         {\cf19 if} (!window->Collapsed && !window->SkipItems)\par
11443             scroll[axis] = ImMin(scroll[axis], window->ScrollMax[axis]);\par
11444     \}\par
11445     {\cf19 return} scroll;\par
11446 \}\par
