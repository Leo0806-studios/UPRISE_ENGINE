12164 {\cf20 // r_avoid = the rectangle to avoid (e.g. for tooltip it is a rectangle around the mouse cursor which we want to avoid. for popups it's a small point around the cursor.)}\par
12165 {\cf20 // r_outer = the visible area rectangle, minus safe area padding. If our popup size won't fit because of safe area padding we ignore it.}\par
12166 {\cf20 // (r_outer is usually equivalent to the viewport rectangle minus padding, but when multi-viewports are enabled and monitor}\par
12167 {\cf20 //  information are available, it may represent the entire platform monitor from the frame of reference of the current viewport.}\par
12168 {\cf20 //  this allows us to have tooltips/popups displayed out of the parent viewport.)}\par
12169 ImVec2 ImGui::FindBestWindowPosForPopupEx({\cf17 const} ImVec2& ref_pos, {\cf17 const} ImVec2& size, ImGuiDir* last_dir, {\cf17 const} ImRect& r_outer, {\cf17 const} ImRect& r_avoid, ImGuiPopupPositionPolicy policy)\par
12170 \{\par
12171     ImVec2 base_pos_clamped = ImClamp(ref_pos, r_outer.Min, r_outer.Max - size);\par
12172     {\cf20 //GetForegroundDrawList()->AddRect(r_avoid.Min, r_avoid.Max, IM_COL32(255,0,0,255));}\par
12173     {\cf20 //GetForegroundDrawList()->AddRect(r_outer.Min, r_outer.Max, IM_COL32(0,255,0,255));}\par
12174 \par
12175     {\cf20 // Combo Box policy (we want a connecting edge)}\par
12176     {\cf19 if} (policy == ImGuiPopupPositionPolicy_ComboBox)\par
12177     \{\par
12178         {\cf17 const} ImGuiDir dir_prefered_order[ImGuiDir_COUNT] = \{ ImGuiDir_Down, ImGuiDir_Right, ImGuiDir_Left, ImGuiDir_Up \};\par
12179         {\cf19 for} ({\cf18 int} n = (*last_dir != ImGuiDir_None) ? -1 : 0; n < ImGuiDir_COUNT; n++)\par
12180         \{\par
12181             {\cf17 const} ImGuiDir dir = (n == -1) ? *last_dir : dir_prefered_order[n];\par
12182             {\cf19 if} (n != -1 && dir == *last_dir) {\cf20 // Already tried this direction?}\par
12183                 {\cf19 continue};\par
12184             ImVec2 pos;\par
12185             {\cf19 if} (dir == ImGuiDir_Down)  pos = ImVec2(r_avoid.Min.x, r_avoid.Max.y);          {\cf20 // Below, Toward Right (default)}\par
12186             {\cf19 if} (dir == ImGuiDir_Right) pos = ImVec2(r_avoid.Min.x, r_avoid.Min.y - size.y); {\cf20 // Above, Toward Right}\par
12187             {\cf19 if} (dir == ImGuiDir_Left)  pos = ImVec2(r_avoid.Max.x - size.x, r_avoid.Max.y); {\cf20 // Below, Toward Left}\par
12188             {\cf19 if} (dir == ImGuiDir_Up)    pos = ImVec2(r_avoid.Max.x - size.x, r_avoid.Min.y - size.y); {\cf20 // Above, Toward Left}\par
12189             {\cf19 if} (!r_outer.Contains(ImRect(pos, pos + size)))\par
12190                 {\cf19 continue};\par
12191             *last_dir = dir;\par
12192             {\cf19 return} pos;\par
12193         \}\par
12194     \}\par
12195 \par
12196     {\cf20 // Tooltip and Default popup policy}\par
12197     {\cf20 // (Always first try the direction we used on the last frame, if any)}\par
12198     {\cf19 if} (policy == ImGuiPopupPositionPolicy_Tooltip || policy == ImGuiPopupPositionPolicy_Default)\par
12199     \{\par
12200         {\cf17 const} ImGuiDir dir_prefered_order[ImGuiDir_COUNT] = \{ ImGuiDir_Right, ImGuiDir_Down, ImGuiDir_Up, ImGuiDir_Left \};\par
12201         {\cf19 for} ({\cf18 int} n = (*last_dir != ImGuiDir_None) ? -1 : 0; n < ImGuiDir_COUNT; n++)\par
12202         \{\par
12203             {\cf17 const} ImGuiDir dir = (n == -1) ? *last_dir : dir_prefered_order[n];\par
12204             {\cf19 if} (n != -1 && dir == *last_dir) {\cf20 // Already tried this direction?}\par
12205                 {\cf19 continue};\par
12206 \par
12207             {\cf17 const} {\cf18 float} avail_w = (dir == ImGuiDir_Left ? r_avoid.Min.x : r_outer.Max.x) - (dir == ImGuiDir_Right ? r_avoid.Max.x : r_outer.Min.x);\par
12208             {\cf17 const} {\cf18 float} avail_h = (dir == ImGuiDir_Up ? r_avoid.Min.y : r_outer.Max.y) - (dir == ImGuiDir_Down ? r_avoid.Max.y : r_outer.Min.y);\par
12209 \par
12210             {\cf20 // If there's not enough room on one axis, there's no point in positioning on a side on this axis (e.g. when not enough width, use a top/bottom position to maximize available width)}\par
12211             {\cf19 if} (avail_w < size.x && (dir == ImGuiDir_Left || dir == ImGuiDir_Right))\par
12212                 {\cf19 continue};\par
12213             {\cf19 if} (avail_h < size.y && (dir == ImGuiDir_Up || dir == ImGuiDir_Down))\par
12214                 {\cf19 continue};\par
12215 \par
12216             ImVec2 pos;\par
12217             pos.x = (dir == ImGuiDir_Left) ? r_avoid.Min.x - size.x : (dir == ImGuiDir_Right) ? r_avoid.Max.x : base_pos_clamped.x;\par
12218             pos.y = (dir == ImGuiDir_Up) ? r_avoid.Min.y - size.y : (dir == ImGuiDir_Down) ? r_avoid.Max.y : base_pos_clamped.y;\par
12219 \par
12220             {\cf20 // Clamp top-left corner of popup}\par
12221             pos.x = ImMax(pos.x, r_outer.Min.x);\par
12222             pos.y = ImMax(pos.y, r_outer.Min.y);\par
12223 \par
12224             *last_dir = dir;\par
12225             {\cf19 return} pos;\par
12226         \}\par
12227     \}\par
12228 \par
12229     {\cf20 // Fallback when not enough room:}\par
12230     *last_dir = ImGuiDir_None;\par
12231 \par
12232     {\cf20 // For tooltip we prefer avoiding the cursor at all cost even if it means that part of the tooltip won't be visible.}\par
12233     {\cf19 if} (policy == ImGuiPopupPositionPolicy_Tooltip)\par
12234         {\cf19 return} ref_pos + ImVec2(2, 2);\par
12235 \par
12236     {\cf20 // Otherwise try to keep within display}\par
12237     ImVec2 pos = ref_pos;\par
12238     pos.x = ImMax(ImMin(pos.x + size.x, r_outer.Max.x) - size.x, r_outer.Min.x);\par
12239     pos.y = ImMax(ImMin(pos.y + size.y, r_outer.Max.y) - size.y, r_outer.Min.y);\par
12240     {\cf19 return} pos;\par
12241 \}\par
12242 \par
12243 {\cf20 // Note that this is used for popups, which can overlap the non work-area of individual viewports.}\par
12244 ImRect ImGui::GetPopupAllowedExtentRect(ImGuiWindow* window)\par
12245 \{\par
12246     ImGuiContext& g = *GImGui;\par
12247     ImRect r_screen;\par
12248     {\cf19 if} (window->ViewportAllowPlatformMonitorExtend >= 0)\par
12249     \{\par
12250         {\cf20 // Extent with be in the frame of reference of the given viewport (so Min is likely to be negative here)}\par
12251         {\cf17 const} ImGuiPlatformMonitor& monitor = g.PlatformIO.Monitors[window->ViewportAllowPlatformMonitorExtend];\par
12252         r_screen.Min = monitor.WorkPos;\par
12253         r_screen.Max = monitor.WorkPos + monitor.WorkSize;\par
12254     \}\par
12255     {\cf19 else}\par
12256     \{\par
12257         {\cf20 // Use the full viewport area (not work area) for popups}\par
12258         r_screen = window->Viewport->GetMainRect();\par
12259     \}\par
12260     ImVec2 padding = g.Style.DisplaySafeAreaPadding;\par
12261     r_screen.Expand(ImVec2((r_screen.GetWidth() > padding.x * 2) ? -padding.x : 0.0f, (r_screen.GetHeight() > padding.y * 2) ? -padding.y : 0.0f));\par
