19028     {\cf19 if} (node == NULL)\par
19029         {\cf19 return};\par
19030     DockBuilderRemoveNodeDockedWindows(node_id, {\cf17 true});\par
19031     DockBuilderRemoveNodeChildNodes(node_id);\par
