12034 {\cf20 // If 'p_open' is specified for a modal popup window, the popup will have a regular close button which will close the popup.}\par
12035 {\cf20 // Note that popup visibility status is owned by Dear ImGui (and manipulated with e.g. OpenPopup).}\par
12036 {\cf20 // - *p_open set back to false in BeginPopupModal() when popup is not open.}\par
12037 {\cf20 // - if you set *p_open to false before calling BeginPopupModal(), it will close the popup.}\par
12038 {\cf18 bool} ImGui::BeginPopupModal({\cf17 const} {\cf18 char}* name, {\cf18 bool}* p_open, ImGuiWindowFlags flags)\par
12039 \{\par
12040     ImGuiContext& g = *GImGui;\par
12041     ImGuiWindow* window = g.CurrentWindow;\par
12042     {\cf17 const} ImGuiID {\cf18 id} = window->GetID(name);\par
12043     {\cf19 if} (!IsPopupOpen({\cf18 id}, ImGuiPopupFlags_None))\par
12044     \{\par
12045         g.NextWindowData.ClearFlags(); {\cf20 // We behave like Begin() and need to consume those values}\par
12046         {\cf19 if} (p_open && *p_open)\par
12047             *p_open = {\cf17 false};\par
12048         {\cf19 return} {\cf17 false};\par
12049     \}\par
12050 \par
12051     {\cf20 // Center modal windows by default for increased visibility}\par
12052     {\cf20 // (this won't really last as settings will kick in, and is mostly for backward compatibility. user may do the same themselves)}\par
12053     {\cf20 // FIXME: Should test for (PosCond & window->SetWindowPosAllowFlags) with the upcoming window.}\par
12054     {\cf19 if} ((g.NextWindowData.Flags & ImGuiNextWindowDataFlags_HasPos) == 0)\par
12055     \{\par
12056         {\cf17 const} ImGuiViewport* viewport = window->WasActive ? window->Viewport : GetMainViewport(); {\cf20 // FIXME-VIEWPORT: What may be our reference viewport?}\par
12057         SetNextWindowPos(viewport->GetCenter(), ImGuiCond_FirstUseEver, ImVec2(0.5f, 0.5f));\par
12058     \}\par
12059 \par
12060     flags |= ImGuiWindowFlags_Popup | ImGuiWindowFlags_Modal | ImGuiWindowFlags_NoCollapse | ImGuiWindowFlags_NoDocking;\par
12061     {\cf17 const} {\cf18 bool} is_open = Begin(name, p_open, flags);\par
12062     {\cf19 if} (!is_open || (p_open && !*p_open)) {\cf20 // NB: is_open can be 'false' when the popup is completely clipped (e.g. zero size display)}\par
12063     \{\par
12064         EndPopup();\par
12065         {\cf19 if} (is_open)\par
12066             ClosePopupToLevel(g.BeginPopupStack.Size, {\cf17 true});\par
12067         {\cf19 return} {\cf17 false};\par
12068     \}\par
12069     {\cf19 return} is_open;\par
12070 \}\par
