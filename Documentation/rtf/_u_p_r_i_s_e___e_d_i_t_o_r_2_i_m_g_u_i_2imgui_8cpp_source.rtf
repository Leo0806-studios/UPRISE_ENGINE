11746 {\cf20 // Supported flags: ImGuiPopupFlags_AnyPopupId, ImGuiPopupFlags_AnyPopupLevel}\par
11747 {\cf18 bool} ImGui::IsPopupOpen(ImGuiID {\cf18 id}, ImGuiPopupFlags popup_flags)\par
11748 \{\par
11749     ImGuiContext& g = *GImGui;\par
11750     {\cf19 if} (popup_flags & ImGuiPopupFlags_AnyPopupId)\par
11751     \{\par
11752         {\cf20 // Return true if any popup is open at the current BeginPopup() level of the popup stack}\par
11753         {\cf20 // This may be used to e.g. test for another popups already opened to handle popups priorities at the same level.}\par
11754         IM_ASSERT({\cf18 id} == 0);\par
11755         {\cf19 if} (popup_flags & ImGuiPopupFlags_AnyPopupLevel)\par
11756             {\cf19 return} g.OpenPopupStack.Size > 0;\par
11757         {\cf19 else}\par
11758             {\cf19 return} g.OpenPopupStack.Size > g.BeginPopupStack.Size;\par
11759     \}\par
11760     {\cf19 else}\par
11761     \{\par
11762         {\cf19 if} (popup_flags & ImGuiPopupFlags_AnyPopupLevel)\par
11763         \{\par
11764             {\cf20 // Return true if the popup is open anywhere in the popup stack}\par
11765             {\cf19 for} (ImGuiPopupData& popup_data : g.OpenPopupStack)\par
11766                 {\cf19 if} (popup_data.PopupId == {\cf18 id})\par
11767                     {\cf19 return} {\cf17 true};\par
11768             {\cf19 return} {\cf17 false};\par
11769         \}\par
11770         {\cf19 else}\par
11771         \{\par
11772             {\cf20 // Return true if the popup is open at the current BeginPopup() level of the popup stack (this is the most-common query)}\par
11773             {\cf19 return} g.OpenPopupStack.Size > g.BeginPopupStack.Size && g.OpenPopupStack[g.BeginPopupStack.Size].PopupId == id;\par
11774         \}\par
11775     \}\par
11776 \}\par
