08192         g.CurrentItemFlags |= ImGuiItemFlags_Disabled;\par
08193     g.ItemFlagsStack.push_back(g.CurrentItemFlags); {\cf20 // FIXME-OPT: can we simply skip this and use DisabledStackSize?}\par
