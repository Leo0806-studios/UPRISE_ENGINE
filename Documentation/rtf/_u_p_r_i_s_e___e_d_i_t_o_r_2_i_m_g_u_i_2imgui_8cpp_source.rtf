11943 {\cf18 void} ImGui::ClosePopupToLevel({\cf18 int} remaining, {\cf18 bool} restore_focus_to_window_under_popup)\par
11944 \{\par
11945     ImGuiContext& g = *GImGui;\par
11946     IMGUI_DEBUG_LOG_POPUP({\cf22 "[popup] ClosePopupToLevel(%d), restore_under=%d\\n"}, remaining, restore_focus_to_window_under_popup);\par
11947     IM_ASSERT(remaining >= 0 && remaining < g.OpenPopupStack.Size);\par
11948 \par
11949     {\cf20 // Trim open popup stack}\par
11950     ImGuiPopupData prev_popup = g.OpenPopupStack[remaining];\par
11951     g.OpenPopupStack.resize(remaining);\par
11952 \par
11953     {\cf20 // Restore focus (unless popup window was not yet submitted, and didn't have a chance to take focus anyhow. See #7325 for an edge case)}\par
11954     {\cf19 if} (restore_focus_to_window_under_popup && prev_popup.Window)\par
11955     \{\par
11956         ImGuiWindow* popup_window = prev_popup.Window;\par
11957         ImGuiWindow* focus_window = (popup_window->Flags & ImGuiWindowFlags_ChildMenu) ? popup_window->ParentWindow : prev_popup.RestoreNavWindow;\par
11958         {\cf19 if} (focus_window && !focus_window->WasActive)\par
11959             FocusTopMostWindowUnderOne(popup_window, NULL, NULL, ImGuiFocusRequestFlags_RestoreFocusedChild); {\cf20 // Fallback}\par
11960         {\cf19 else}\par
11961             FocusWindow(focus_window, (g.NavLayer == ImGuiNavLayer_Main) ? ImGuiFocusRequestFlags_RestoreFocusedChild : ImGuiFocusRequestFlags_None);\par
11962     \}\par
11963 \}\par
