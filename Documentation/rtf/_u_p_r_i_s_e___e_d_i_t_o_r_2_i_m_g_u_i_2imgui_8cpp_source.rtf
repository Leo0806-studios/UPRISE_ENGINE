13149 {\cf20 // Bias scoring rect ahead of scoring + update preferred pos (if missing) using source position}\par
13150 {\cf17 static} {\cf18 void} NavBiasScoringRect(ImRect& r, ImVec2& preferred_pos_rel, ImGuiDir move_dir, ImGuiNavMoveFlags move_flags)\par
13151 \{\par
13152     {\cf20 // Bias initial rect}\par
13153     ImGuiContext& g = *GImGui;\par
13154     {\cf17 const} ImVec2 rel_to_abs_offset = g.NavWindow->DC.CursorStartPos;\par
13155 \par
13156     {\cf20 // Initialize bias on departure if we don't have any. So mouse-click + arrow will record bias.}\par
13157     {\cf20 // - We default to L/U bias, so moving down from a large source item into several columns will land on left-most column.}\par
13158     {\cf20 // - But each successful move sets new bias on one axis, only cleared when using mouse.}\par
13159     {\cf19 if} ((move_flags & ImGuiNavMoveFlags_Forwarded) == 0)\par
13160     \{\par
13161         {\cf19 if} (preferred_pos_rel.x == FLT_MAX)\par
13162             preferred_pos_rel.x = ImMin(r.Min.x + 1.0f, r.Max.x) - rel_to_abs_offset.x;\par
13163         {\cf19 if} (preferred_pos_rel.y == FLT_MAX)\par
13164             preferred_pos_rel.y = r.GetCenter().y - rel_to_abs_offset.y;\par
13165     \}\par
13166 \par
13167     {\cf20 // Apply general bias on the other axis}\par
13168     {\cf19 if} ((move_dir == ImGuiDir_Up || move_dir == ImGuiDir_Down) && preferred_pos_rel.x != FLT_MAX)\par
13169         r.Min.x = r.Max.x = preferred_pos_rel.x + rel_to_abs_offset.x;\par
13170     {\cf19 else} {\cf19 if} ((move_dir == ImGuiDir_Left || move_dir == ImGuiDir_Right) && preferred_pos_rel.y != FLT_MAX)\par
13171         r.Min.y = r.Max.y = preferred_pos_rel.y + rel_to_abs_offset.y;\par
13172 \}\par
