05347 {\cf20 // We call ChannelsMerge() lazily here at it is faster that doing a full iteration of g.Windows[] prior to calling RenderDimmedBackgrounds().}\par
05348 {\cf17 static} {\cf18 void} ImGui::RenderDimmedBackgrounds()\par
05349 \{\par
05350     ImGuiContext& g = *GImGui;\par
05351     ImGuiWindow* modal_window = GetTopMostAndVisiblePopupModal();\par
05352     {\cf19 if} (g.DimBgRatio <= 0.0f && g.NavWindowingHighlightAlpha <= 0.0f)\par
05353         {\cf19 return};\par
05354     {\cf17 const} {\cf18 bool} dim_bg_for_modal = (modal_window != NULL);\par
05355     {\cf17 const} {\cf18 bool} dim_bg_for_window_list = (g.NavWindowingTargetAnim != NULL && g.NavWindowingTargetAnim->Active);\par
05356     {\cf19 if} (!dim_bg_for_modal && !dim_bg_for_window_list)\par
05357         {\cf19 return};\par
05358 \par
05359     ImGuiViewport* viewports_already_dimmed[2] = \{ NULL, NULL \};\par
05360     {\cf19 if} (dim_bg_for_modal)\par
05361     \{\par
05362         {\cf20 // Draw dimming behind modal or a begin stack child, whichever comes first in draw order.}\par
05363         ImGuiWindow* dim_behind_window = FindBottomMostVisibleWindowWithinBeginStack(modal_window);\par
05364         RenderDimmedBackgroundBehindWindow(dim_behind_window, GetColorU32(modal_window->DC.ModalDimBgColor, g.DimBgRatio));\par
05365         viewports_already_dimmed[0] = modal_window->Viewport;\par
05366     \}\par
05367     {\cf19 else} {\cf19 if} (dim_bg_for_window_list)\par
05368     \{\par
05369         {\cf20 // Draw dimming behind CTRL+Tab target window and behind CTRL+Tab UI window}\par
05370         RenderDimmedBackgroundBehindWindow(g.NavWindowingTargetAnim, GetColorU32(ImGuiCol_NavWindowingDimBg, g.DimBgRatio));\par
05371         {\cf19 if} (g.NavWindowingListWindow != NULL && g.NavWindowingListWindow->Viewport && g.NavWindowingListWindow->Viewport != g.NavWindowingTargetAnim->Viewport)\par
05372             RenderDimmedBackgroundBehindWindow(g.NavWindowingListWindow, GetColorU32(ImGuiCol_NavWindowingDimBg, g.DimBgRatio));\par
05373         viewports_already_dimmed[0] = g.NavWindowingTargetAnim->Viewport;\par
05374         viewports_already_dimmed[1] = g.NavWindowingListWindow ? g.NavWindowingListWindow->Viewport : NULL;\par
05375 \par
05376         {\cf20 // Draw border around CTRL+Tab target window}\par
05377         ImGuiWindow* window = g.NavWindowingTargetAnim;\par
05378         ImGuiViewport* viewport = window->Viewport;\par
05379         {\cf18 float} distance = g.FontSize;\par
05380         ImRect bb = window->Rect();\par
05381         bb.Expand(distance);\par
05382         {\cf19 if} (bb.GetWidth() >= viewport->Size.x && bb.GetHeight() >= viewport->Size.y)\par
05383             bb.Expand(-distance - 1.0f); {\cf20 // If a window fits the entire viewport, adjust its highlight inward}\par
05384         window->DrawList->ChannelsMerge();\par
05385         {\cf19 if} (window->DrawList->CmdBuffer.Size == 0)\par
05386             window->DrawList->AddDrawCmd();\par
05387         window->DrawList->PushClipRect(viewport->Pos, viewport->Pos + viewport->Size);\par
05388         window->DrawList->AddRect(bb.Min, bb.Max, GetColorU32(ImGuiCol_NavWindowingHighlight, g.NavWindowingHighlightAlpha), window->WindowRounding, 0, 3.0f);\par
05389         window->DrawList->PopClipRect();\par
05390     \}\par
05391 \par
05392     {\cf20 // Draw dimming background on _other_ viewports than the ones our windows are in}\par
05393     {\cf19 for} (ImGuiViewportP* viewport : g.Viewports)\par
05394     \{\par
05395         {\cf19 if} (viewport == viewports_already_dimmed[0] || viewport == viewports_already_dimmed[1])\par
05396             {\cf19 continue};\par
05397         {\cf19 if} (modal_window && viewport->Window && IsWindowAbove(viewport->Window, modal_window))\par
05398             {\cf19 continue};\par
05399         ImDrawList* draw_list = GetForegroundDrawList(viewport);\par
05400         {\cf17 const} ImU32 dim_bg_col = GetColorU32(dim_bg_for_modal ? ImGuiCol_ModalWindowDimBg : ImGuiCol_NavWindowingDimBg, g.DimBgRatio);\par
05401         draw_list->AddRectFilled(viewport->Pos, viewport->Pos + viewport->Size, dim_bg_col);\par
05402     \}\par
05403 \}\par
