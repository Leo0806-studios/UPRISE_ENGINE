14215     {\cf20 // NB: We currently accept NULL id as target. However, overlapping targets requires a unique ID to function!}\par
14216     {\cf17 const} {\cf18 bool} was_accepted_previously = (g.DragDropAcceptIdPrev == g.DragDropTargetId);\par
14217     ImRect r = g.DragDropTargetRect;\par
14218     {\cf18 float} r_surface = r.GetWidth() * r.GetHeight();\par
14219     {\cf19 if} (r_surface > g.DragDropAcceptIdCurrRectSurface)\par
14220         {\cf19 return} NULL;\par
14221 \par
14222     g.DragDropAcceptFlags = flags;\par
14223     g.DragDropAcceptIdCurr = g.DragDropTargetId;\par
14224     g.DragDropAcceptIdCurrRectSurface = r_surface;\par
14225     {\cf20 //IMGUI_DEBUG_LOG("AcceptDragDropPayload(): %08X: accept\\n", g.DragDropTargetId);}\par
14226 \par
