06826     {\cf20 // Title bar text (with: horizontal alignment, avoiding collapse/close button, optional "unsaved document" marker)}\par
06827     {\cf20 // FIXME: Refactor text alignment facilities along with RenderText helpers, this is WAY too much messy code..}\par
06828     {\cf17 const} {\cf18 float} marker_size_x = (flags & ImGuiWindowFlags_UnsavedDocument) ? button_sz * 0.80f : 0.0f;\par
06829     {\cf17 const} ImVec2 text_size = CalcTextSize(name, NULL, {\cf17 true}) + ImVec2(marker_size_x, 0.0f);\par
