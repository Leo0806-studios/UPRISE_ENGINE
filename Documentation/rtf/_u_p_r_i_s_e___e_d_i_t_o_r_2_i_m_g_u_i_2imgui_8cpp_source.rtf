06908 {\cf20 // When a modal popup is open, newly created windows that want focus (i.e. are not popups and do not specify ImGuiWindowFlags_NoFocusOnAppearing)}\par
06909 {\cf20 // should be positioned behind that modal window, unless the window was created inside the modal begin-stack.}\par
06910 {\cf20 // In case of multiple stacked modals newly created window honors begin stack order and does not go below its own modal parent.}\par
06911 {\cf20 // - WindowA            // FindBlockingModal() returns Modal1}\par
06912 {\cf20 //   - WindowB          //                  .. returns Modal1}\par
06913 {\cf20 //   - Modal1           //                  .. returns Modal2}\par
06914 {\cf20 //      - WindowC       //                  .. returns Modal2}\par
06915 {\cf20 //          - WindowD   //                  .. returns Modal2}\par
06916 {\cf20 //          - Modal2    //                  .. returns Modal2}\par
06917 {\cf20 //            - WindowE //                  .. returns NULL}\par
06918 {\cf20 // Notes:}\par
06919 {\cf20 // - FindBlockingModal(NULL) == NULL is generally equivalent to GetTopMostPopupModal() == NULL.}\par
06920 {\cf20 //   Only difference is here we check for ->Active/WasActive but it may be unnecessary.}\par
06921 ImGuiWindow* ImGui::FindBlockingModal(ImGuiWindow* window)\par
06922 \{\par
06923     ImGuiContext& g = *GImGui;\par
06924     {\cf19 if} (g.OpenPopupStack.Size <= 0)\par
06925         {\cf19 return} NULL;\par
06926 \par
06927     {\cf20 // Find a modal that has common parent with specified window. Specified window should be positioned behind that modal.}\par
06928     {\cf19 for} (ImGuiPopupData& popup_data : g.OpenPopupStack)\par
06929     \{\par
06930         ImGuiWindow* popup_window = popup_data.Window;\par
06931         {\cf19 if} (popup_window == NULL || !(popup_window->Flags & ImGuiWindowFlags_Modal))\par
06932             {\cf19 continue};\par
06933         {\cf19 if} (!popup_window->Active && !popup_window->WasActive)      {\cf20 // Check WasActive, because this code may run before popup renders on current frame, also check Active to handle newly created windows.}\par
06934             {\cf19 continue};\par
06935         {\cf19 if} (window == NULL)                                         {\cf20 // FindBlockingModal(NULL) test for if FocusWindow(NULL) is naturally possible via a mouse click.}\par
06936             {\cf19 return} popup_window;\par
06937         {\cf19 if} (IsWindowWithinBeginStackOf(window, popup_window))       {\cf20 // Window may be over modal}\par
06938             {\cf19 continue};\par
06939         {\cf19 return} popup_window;                                        {\cf20 // Place window right below first block modal}\par
06940     \}\par
06941     {\cf19 return} NULL;\par
06942 \}\par
