11689                 SetWindowHiddenAndSkipItemsForCurrentFrame(window);\par
11690                 ImFormatString(window_name, IM_ARRAYSIZE(window_name), {\cf22 "##Tooltip_%02d"}, ++g.TooltipOverrideCount);\par
11691             \}\par
11692     ImGuiWindowFlags flags = ImGuiWindowFlags_Tooltip | ImGuiWindowFlags_NoInputs | ImGuiWindowFlags_NoTitleBar | ImGuiWindowFlags_NoMove | ImGuiWindowFlags_NoResize | ImGuiWindowFlags_NoSavedSettings | ImGuiWindowFlags_AlwaysAutoResize | ImGuiWindowFlags_NoDocking;\par
11693     Begin(window_name, NULL, flags | extra_window_flags);\par
