04714 {\cf20 // Initiate moving window when clicking on empty space or title bar.}\par
04715 {\cf20 // Handle left-click and right-click focus.}\par
04716 {\cf18 void} ImGui::UpdateMouseMovingWindowEndFrame()\par
04717 \{\par
04718     ImGuiContext& g = *GImGui;\par
04719     {\cf19 if} (g.ActiveId != 0 || g.HoveredId != 0)\par
04720         {\cf19 return};\par
04721 \par
04722     {\cf20 // Unless we just made a window/popup appear}\par
04723     {\cf19 if} (g.NavWindow && g.NavWindow->Appearing)\par
04724         {\cf19 return};\par
04725 \par
04726     {\cf20 // Click on empty space to focus window and start moving}\par
04727     {\cf20 // (after we're done with all our widgets, so e.g. clicking on docking tab-bar which have set HoveredId already and not get us here!)}\par
04728     {\cf19 if} (g.IO.MouseClicked[0])\par
04729     \{\par
04730         {\cf20 // Handle the edge case of a popup being closed while clicking in its empty space.}\par
04731         {\cf20 // If we try to focus it, FocusWindow() > ClosePopupsOverWindow() will accidentally close any parent popups because they are not linked together any more.}\par
04732         ImGuiWindow* root_window = g.HoveredWindow ? g.HoveredWindow->RootWindow : NULL;\par
04733         {\cf17 const} {\cf18 bool} is_closed_popup = root_window && (root_window->Flags & ImGuiWindowFlags_Popup) && !IsPopupOpen(root_window->PopupId, ImGuiPopupFlags_AnyPopupLevel);\par
04734 \par
04735         {\cf19 if} (root_window != NULL && !is_closed_popup)\par
04736         \{\par
04737             StartMouseMovingWindow(g.HoveredWindow); {\cf20 //-V595}\par
04738 \par
04739             {\cf20 // Cancel moving if clicked outside of title bar}\par
04740             {\cf19 if} (g.IO.ConfigWindowsMoveFromTitleBarOnly)\par
04741                 {\cf19 if} (!(root_window->Flags & ImGuiWindowFlags_NoTitleBar) || root_window->DockIsActive)\par
04742                     {\cf19 if} (!root_window->TitleBarRect().Contains(g.IO.MouseClickedPos[0]))\par
04743                         g.MovingWindow = NULL;\par
04744 \par
04745             {\cf20 // Cancel moving if clicked over an item which was disabled or inhibited by popups (note that we know HoveredId == 0 already)}\par
04746             {\cf19 if} (g.HoveredIdIsDisabled)\par
04747                 g.MovingWindow = NULL;\par
04748         \}\par
04749         {\cf19 else} {\cf19 if} (root_window == NULL && g.NavWindow != NULL)\par
04750         \{\par
04751             {\cf20 // Clicking on void disable focus}\par
04752             FocusWindow(NULL, ImGuiFocusRequestFlags_UnlessBelowModal);\par
04753         \}\par
04754     \}\par
