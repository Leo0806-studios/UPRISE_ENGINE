02941 {\cf17 static} {\cf18 void} ImGuiListClipper_SortAndFuseRanges(ImVector<ImGuiListClipperRange>& ranges, {\cf18 int} offset = 0)\par
02942 \{\par
02943     {\cf19 if} (ranges.Size - offset <= 1)\par
02944         {\cf19 return};\par
02945 \par
02946     {\cf20 // Helper to order ranges and fuse them together if possible (bubble sort is fine as we are only sorting 2-3 entries)}\par
02947     {\cf19 for} ({\cf18 int} sort_end = ranges.Size - offset - 1; sort_end > 0; --sort_end)\par
02948         {\cf19 for} ({\cf18 int} i = offset; i < sort_end + offset; ++i)\par
02949             {\cf19 if} (ranges[i].Min > ranges[i + 1].Min)\par
02950                 ImSwap(ranges[i], ranges[i + 1]);\par
02951 \par
02952     {\cf20 // Now fuse ranges together as much as possible.}\par
02953     {\cf19 for} ({\cf18 int} i = 1 + offset; i < ranges.Size; i++)\par
02954     \{\par
02955         IM_ASSERT(!ranges[i].PosToIndexConvert && !ranges[i - 1].PosToIndexConvert);\par
02956         {\cf19 if} (ranges[i - 1].Max < ranges[i].Min)\par
02957             {\cf19 continue};\par
02958         ranges[i - 1].Min = ImMin(ranges[i - 1].Min, ranges[i].Min);\par
02959         ranges[i - 1].Max = ImMax(ranges[i - 1].Max, ranges[i].Max);\par
02960         ranges.erase(ranges.Data + i);\par
02961         i--;\par
02962     \}\par
02963 \}\par
02964 \par
02965 {\cf17 static} {\cf18 void} ImGuiListClipper_SeekCursorAndSetupPrevLine({\cf18 float} pos_y, {\cf18 float} line_height)\par
02966 \{\par
02967     {\cf20 // Set cursor position and a few other things so that SetScrollHereY() and Columns() can work when seeking cursor.}\par
02968     {\cf20 // FIXME: It is problematic that we have to do that here, because custom/equivalent end-user code would stumble on the same issue.}\par
02969     {\cf20 // The clipper should probably have a final step to display the last item in a regular manner, maybe with an opt-out flag for data sets which may have costly seek?}\par
02970     ImGuiContext& g = *GImGui;\par
02971     ImGuiWindow* window = g.CurrentWindow;\par
02972     {\cf18 float} off_y = pos_y - window->DC.CursorPos.y;\par
02973     window->DC.CursorPos.y = pos_y;\par
02974     window->DC.CursorMaxPos.y = ImMax(window->DC.CursorMaxPos.y, pos_y - g.Style.ItemSpacing.y);\par
02975     window->DC.CursorPosPrevLine.y = window->DC.CursorPos.y - line_height;  {\cf20 // Setting those fields so that SetScrollHereY() can properly function after the end of our clipper usage.}\par
02976     window->DC.PrevLineSize.y = (line_height - g.Style.ItemSpacing.y);      {\cf20 // If we end up needing more accurate data (to e.g. use SameLine) we may as well make the clipper have a fourth step to let user process and display the last item in their list.}\par
02977     {\cf19 if} (ImGuiOldColumns* columns = window->DC.CurrentColumns)\par
02978         columns->LineMinY = window->DC.CursorPos.y;                         {\cf20 // Setting this so that cell Y position are set properly}\par
02979     {\cf19 if} (ImGuiTable* table = g.CurrentTable)\par
02980     \{\par
02981         {\cf19 if} (table->IsInsideRow)\par
02982             ImGui::TableEndRow(table);\par
02983         table->RowPosY2 = window->DC.CursorPos.y;\par
02984         {\cf17 const} {\cf18 int} row_increase = (int)((off_y / line_height) + 0.5f);\par
02985         {\cf20 //table->CurrentRow += row_increase; // Can't do without fixing TableEndRow()}\par
02986         table->RowBgColorCounter += row_increase;\par
02987     \}\par
02988 \}\par
