17231     node->CentralNode = info.CentralNode;\par
17232     node->OnlyNodeWithWindows = (info.CountNodesWithWindows == 1) ? info.FirstNodeWithWindows : NULL;\par
17233     node->CountNodeWithWindows = info.CountNodesWithWindows;\par
