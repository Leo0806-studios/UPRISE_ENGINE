07876 {\cf18 void} ImGui::End()\par
07877 \{\par
07878     ImGuiContext& g = *GImGui;\par
07879     ImGuiWindow* window = g.CurrentWindow;\par
07880 \par
07881     {\cf20 // Error checking: verify that user hasn't called End() too many times!}\par
07882     {\cf19 if} (g.CurrentWindowStack.Size <= 1 && g.WithinFrameScopeWithImplicitWindow)\par
07883     \{\par
07884         IM_ASSERT_USER_ERROR(g.CurrentWindowStack.Size > 1, {\cf22 "Calling End() too many times!"});\par
07885         {\cf19 return};\par
07886     \}\par
07887     ImGuiWindowStackData& window_stack_data = g.CurrentWindowStack.back();\par
07888 \par
07889     {\cf20 // Error checking: verify that user doesn't directly call End() on a child window.}\par
07890     {\cf19 if} ((window->Flags & ImGuiWindowFlags_ChildWindow) && !(window->Flags & ImGuiWindowFlags_DockNodeHost) && !window->DockIsActive)\par
07891         IM_ASSERT_USER_ERROR(g.WithinEndChild, {\cf22 "Must call EndChild() and not End()!"});\par
07892 \par
07893     {\cf20 // Close anything that is open}\par
07894     {\cf19 if} (window->DC.CurrentColumns)\par
07895         EndColumns();\par
07896     {\cf19 if} (!(window->Flags & ImGuiWindowFlags_DockNodeHost) && !window->SkipRefresh)   {\cf20 // Pop inner window clip rectangle}\par
07897         PopClipRect();\par
07898     PopFocusScope();\par
07899     {\cf19 if} (window_stack_data.DisabledOverrideReenable && window->RootWindow == window)\par
07900         EndDisabledOverrideReenable();\par
07901 \par
07902     {\cf19 if} (window->SkipRefresh)\par
07903     \{\par
07904         IM_ASSERT(window->DrawList == NULL);\par
07905         window->DrawList = &window->DrawListInst;\par
07906     \}\par
07907 \par
07908     {\cf20 // Stop logging}\par
07909     {\cf19 if} (!(window->Flags & ImGuiWindowFlags_ChildWindow))    {\cf20 // FIXME: add more options for scope of logging}\par
07910         LogFinish();\par
07911 \par
07912     {\cf19 if} (window->DC.IsSetPos)\par
07913         ErrorCheckUsingSetCursorPosToExtendParentBoundaries();\par
07914 \par
07915     {\cf20 // Docking: report contents sizes to parent to allow for auto-resize}\par
07916     {\cf19 if} (window->DockNode && window->DockTabIsVisible)\par
07917         {\cf19 if} (ImGuiWindow* host_window = window->DockNode->HostWindow)         {\cf20 // FIXME-DOCK}\par
07918             host_window->DC.CursorMaxPos = window->DC.CursorMaxPos + window->WindowPadding - host_window->WindowPadding;\par
07919 \par
07920     {\cf20 // Pop from window stack}\par
07921     g.LastItemData = window_stack_data.ParentLastItemDataBackup;\par
07922     {\cf19 if} (window->Flags & ImGuiWindowFlags_ChildMenu)\par
07923         g.BeginMenuDepth--;\par
07924     {\cf19 if} (window->Flags & ImGuiWindowFlags_Popup)\par
07925         g.BeginPopupStack.pop_back();\par
07926     window_stack_data.StackSizesOnBegin.CompareWithContextState(&g);\par
07927     g.CurrentWindowStack.pop_back();\par
07928     SetCurrentWindow(g.CurrentWindowStack.Size == 0 ? NULL : g.CurrentWindowStack.back().Window);\par
07929     {\cf19 if} (g.CurrentWindow)\par
07930         SetCurrentViewport(g.CurrentWindow, g.CurrentWindow->Viewport);\par
07931 \}\par
