01617     IM_ASSERT((BackendUsingLegacyKeyArrays == -1 || BackendUsingLegacyKeyArrays == 0) && {\cf22 "Backend needs to either only use io.AddKeyEvent(), either only fill legacy io.KeysDown[] + io.KeyMap[]. Not both!"});\par
01618     {\cf19 if} (BackendUsingLegacyKeyArrays == -1)\par
