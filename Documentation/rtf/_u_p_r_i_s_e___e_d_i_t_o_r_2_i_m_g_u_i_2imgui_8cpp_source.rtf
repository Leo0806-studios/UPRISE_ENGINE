13174 {\cf18 void} ImGui::NavUpdateCreateMoveRequest()\par
13175 \{\par
13176     ImGuiContext& g = *GImGui;\par
13177     ImGuiIO& io = g.IO;\par
13178     ImGuiWindow* window = g.NavWindow;\par
