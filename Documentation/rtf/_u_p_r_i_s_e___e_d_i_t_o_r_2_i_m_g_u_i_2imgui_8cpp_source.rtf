18460 {\cf20 // Update Pos/Size for a node hierarchy (don't affect child Windows yet)}\par
18461 {\cf20 // (Depth-first, Pre-Order)}\par
18462 {\cf18 void} ImGui::DockNodeTreeUpdatePosSize(ImGuiDockNode* node, ImVec2 pos, ImVec2 size, ImGuiDockNode* only_write_to_single_node)\par
18463 \{\par
18464     {\cf20 // During the regular dock node update we write to all nodes.}\par
18465     {\cf20 // 'only_write_to_single_node' is only set when turning a node visible mid-frame and we need its size right-away.}\par
18466     ImGuiContext& g = *GImGui;\par
18467     {\cf17 const} {\cf18 bool} write_to_node = only_write_to_single_node == NULL || only_write_to_single_node == node;\par
18468     {\cf19 if} (write_to_node)\par
18469     \{\par
18470         node->Pos = pos;\par
18471         node->Size = size;\par
18472     \}\par
18473 \par
18474     {\cf19 if} (node->IsLeafNode())\par
18475         {\cf19 return};\par
18476 \par
18477     ImGuiDockNode* child_0 = node->ChildNodes[0];\par
18478     ImGuiDockNode* child_1 = node->ChildNodes[1];\par
18479     ImVec2 child_0_pos = pos, child_1_pos = pos;\par
18480     ImVec2 child_0_size = size, child_1_size = size;\par
18481 \par
18482     {\cf17 const} {\cf18 bool} child_0_is_toward_single_node = (only_write_to_single_node != NULL && DockNodeIsInHierarchyOf(only_write_to_single_node, child_0));\par
18483     {\cf17 const} {\cf18 bool} child_1_is_toward_single_node = (only_write_to_single_node != NULL && DockNodeIsInHierarchyOf(only_write_to_single_node, child_1));\par
18484     {\cf17 const} {\cf18 bool} child_0_is_or_will_be_visible = child_0->IsVisible || child_0_is_toward_single_node;\par
18485     {\cf17 const} {\cf18 bool} child_1_is_or_will_be_visible = child_1->IsVisible || child_1_is_toward_single_node;\par
18486 \par
18487     {\cf19 if} (child_0_is_or_will_be_visible && child_1_is_or_will_be_visible)\par
18488     \{\par
18489         {\cf17 const} {\cf18 float} spacing = g.Style.DockingSeparatorSize;\par
18490         {\cf17 const} ImGuiAxis axis = (ImGuiAxis)node->SplitAxis;\par
18491         {\cf17 const} {\cf18 float} size_avail = ImMax(size[axis] - spacing, 0.0f);\par
18492 \par
18493         {\cf20 // Size allocation policy}\par
18494         {\cf20 // 1) The first 0..WindowMinSize[axis]*2 are allocated evenly to both windows.}\par
18495         {\cf17 const} {\cf18 float} size_min_each = ImTrunc(ImMin(size_avail, g.Style.WindowMinSize[axis] * 2.0f) * 0.5f);\par
18496 \par
18497         {\cf20 // FIXME: Blocks 2) and 3) are essentially doing nearly the same thing.}\par
18498         {\cf20 // Difference are: write-back to SizeRef; application of a minimum size; rounding before ImTrunc()}\par
18499         {\cf20 // Clarify and rework differences between Size & SizeRef and purpose of WantLockSizeOnce}\par
18500 \par
18501         {\cf20 // 2) Process locked absolute size (during a splitter resize we preserve the child of nodes not touching the splitter edge)}\par
18502         {\cf19 if} (child_0->WantLockSizeOnce && !child_1->WantLockSizeOnce)\par
18503         \{\par
18504             child_0_size[axis] = child_0->SizeRef[axis] = ImMin(size_avail - 1.0f, child_0->Size[axis]);\par
18505             child_1_size[axis] = child_1->SizeRef[axis] = (size_avail - child_0_size[axis]);\par
18506             IM_ASSERT(child_0->SizeRef[axis] > 0.0f && child_1->SizeRef[axis] > 0.0f);\par
18507         \}\par
18508         {\cf19 else} {\cf19 if} (child_1->WantLockSizeOnce && !child_0->WantLockSizeOnce)\par
18509         \{\par
18510             child_1_size[axis] = child_1->SizeRef[axis] = ImMin(size_avail - 1.0f, child_1->Size[axis]);\par
18511             child_0_size[axis] = child_0->SizeRef[axis] = (size_avail - child_1_size[axis]);\par
18512             IM_ASSERT(child_0->SizeRef[axis] > 0.0f && child_1->SizeRef[axis] > 0.0f);\par
18513         \}\par
18514         {\cf19 else} {\cf19 if} (child_0->WantLockSizeOnce && child_1->WantLockSizeOnce)\par
18515         \{\par
18516             {\cf20 // FIXME-DOCK: We cannot honor the requested size, so apply ratio.}\par
18517             {\cf20 // Currently this path will only be taken if code programmatically sets WantLockSizeOnce}\par
18518             {\cf18 float} split_ratio = child_0_size[axis] / (child_0_size[axis] + child_1_size[axis]);\par
18519             child_0_size[axis] = child_0->SizeRef[axis] = ImTrunc(size_avail * split_ratio);\par
18520             child_1_size[axis] = child_1->SizeRef[axis] = (size_avail - child_0_size[axis]);\par
18521             IM_ASSERT(child_0->SizeRef[axis] > 0.0f && child_1->SizeRef[axis] > 0.0f);\par
18522         \}\par
18523 \par
18524         {\cf20 // 3) If one window is the central node (~ use remaining space, should be made explicit!), use explicit size from the other, and remainder for the central node}\par
18525         {\cf19 else} {\cf19 if} (child_0->SizeRef[axis] != 0.0f && child_1->HasCentralNodeChild)\par
18526         \{\par
18527             child_0_size[axis] = ImMin(size_avail - size_min_each, child_0->SizeRef[axis]);\par
18528             child_1_size[axis] = (size_avail - child_0_size[axis]);\par
18529         \}\par
18530         {\cf19 else} {\cf19 if} (child_1->SizeRef[axis] != 0.0f && child_0->HasCentralNodeChild)\par
18531         \{\par
18532             child_1_size[axis] = ImMin(size_avail - size_min_each, child_1->SizeRef[axis]);\par
18533             child_0_size[axis] = (size_avail - child_1_size[axis]);\par
18534         \}\par
18535         {\cf19 else}\par
18536         \{\par
18537             {\cf20 // 4) Otherwise distribute according to the relative ratio of each SizeRef value}\par
18538             {\cf18 float} split_ratio = child_0->SizeRef[axis] / (child_0->SizeRef[axis] + child_1->SizeRef[axis]);\par
18539             child_0_size[axis] = ImMax(size_min_each, ImTrunc(size_avail * split_ratio + 0.5f));\par
18540             child_1_size[axis] = (size_avail - child_0_size[axis]);\par
18541         \}\par
18542 \par
18543         child_1_pos[axis] += spacing + child_0_size[axis];\par
18544     \}\par
18545 \par
18546     {\cf19 if} (only_write_to_single_node == NULL)\par
18547         child_0->WantLockSizeOnce = child_1->WantLockSizeOnce = {\cf17 false};\par
18548 \par
18549     {\cf17 const} {\cf18 bool} child_0_recurse = only_write_to_single_node ? child_0_is_toward_single_node : child_0->IsVisible;\par
18550     {\cf17 const} {\cf18 bool} child_1_recurse = only_write_to_single_node ? child_1_is_toward_single_node : child_1->IsVisible;\par
18551     {\cf19 if} (child_0_recurse)\par
18552         DockNodeTreeUpdatePosSize(child_0, child_0_pos, child_0_size);\par
18553     {\cf19 if} (child_1_recurse)\par
18554         DockNodeTreeUpdatePosSize(child_1, child_1_pos, child_1_size);\par
18555 \}\par
18556 \par
18557 {\cf17 static} {\cf18 void} DockNodeTreeUpdateSplitterFindTouchingNode(ImGuiDockNode* node, ImGuiAxis axis, {\cf18 int} side, ImVector<ImGuiDockNode*>* touching_nodes)\par
18558 \{\par
18559     {\cf19 if} (node->IsLeafNode())\par
18560     \{\par
18561         touching_nodes->push_back(node);\par
18562         {\cf19 return};\par
18563     \}\par
18564     {\cf19 if} (node->ChildNodes[0]->IsVisible)\par
18565         {\cf19 if} (node->SplitAxis != axis || side == 0 || !node->ChildNodes[1]->IsVisible)\par
18566             DockNodeTreeUpdateSplitterFindTouchingNode(node->ChildNodes[0], axis, side, touching_nodes);\par
18567     {\cf19 if} (node->ChildNodes[1]->IsVisible)\par
18568         {\cf19 if} (node->SplitAxis != axis || side == 1 || !node->ChildNodes[0]->IsVisible)\par
18569             DockNodeTreeUpdateSplitterFindTouchingNode(node->ChildNodes[1], axis, side, touching_nodes);\par
18570 \}\par
18571 \par
18572 {\cf20 // (Depth-First, Pre-Order)}\par
18573 {\cf18 void} ImGui::DockNodeTreeUpdateSplitter(ImGuiDockNode* node)\par
18574 \{\par
18575     {\cf19 if} (node->IsLeafNode())\par
18576         {\cf19 return};\par
18577 \par
18578     ImGuiContext& g = *GImGui;\par
18579 \par
18580     ImGuiDockNode* child_0 = node->ChildNodes[0];\par
18581     ImGuiDockNode* child_1 = node->ChildNodes[1];\par
18582     {\cf19 if} (child_0->IsVisible && child_1->IsVisible)\par
18583     \{\par
18584         {\cf20 // Bounding box of the splitter cover the space between both nodes (w = Spacing, h = Size[xy^1] for when splitting horizontally)}\par
18585         {\cf17 const} ImGuiAxis axis = (ImGuiAxis)node->SplitAxis;\par
18586         IM_ASSERT(axis != ImGuiAxis_None);\par
18587         ImRect bb;\par
18588         bb.Min = child_0->Pos;\par
18589         bb.Max = child_1->Pos;\par
18590         bb.Min[axis] += child_0->Size[axis];\par
18591         bb.Max[axis ^ 1] += child_1->Size[axis ^ 1];\par
18592         {\cf20 //if (g.IO.KeyCtrl) GetForegroundDrawList(g.CurrentWindow->Viewport)->AddRect(bb.Min, bb.Max, IM_COL32(255,0,255,255));}\par
18593 \par
18594         {\cf17 const} ImGuiDockNodeFlags merged_flags = child_0->MergedFlags | child_1->MergedFlags; {\cf20 // Merged flags for BOTH childs}\par
18595         {\cf17 const} ImGuiDockNodeFlags no_resize_axis_flag = (axis == ImGuiAxis_X) ? ImGuiDockNodeFlags_NoResizeX : ImGuiDockNodeFlags_NoResizeY;\par
18596         {\cf19 if} ((merged_flags & ImGuiDockNodeFlags_NoResize) || (merged_flags & no_resize_axis_flag))\par
18597         \{\par
18598             ImGuiWindow* window = g.CurrentWindow;\par
18599             window->DrawList->AddRectFilled(bb.Min, bb.Max, GetColorU32(ImGuiCol_Separator), g.Style.FrameRounding);\par
18600         \}\par
18601         {\cf19 else}\par
18602         \{\par
18603             {\cf20 //bb.Min[axis] += 1; // Display a little inward so highlight doesn't connect with nearby tabs on the neighbor node.}\par
18604             {\cf20 //bb.Max[axis] -= 1;}\par
18605             PushID(node->ID);\par
18606 \par
18607             {\cf20 // Find resizing limits by gathering list of nodes that are touching the splitter line.}\par
18608             ImVector<ImGuiDockNode*> touching_nodes[2];\par
18609             {\cf18 float} min_size = g.Style.WindowMinSize[axis];\par
18610             {\cf18 float} resize_limits[2];\par
18611             resize_limits[0] = node->ChildNodes[0]->Pos[axis] + min_size;\par
18612             resize_limits[1] = node->ChildNodes[1]->Pos[axis] + node->ChildNodes[1]->Size[axis] - min_size;\par
18613 \par
18614             ImGuiID splitter_id = GetID({\cf22 "##Splitter"});\par
18615             {\cf19 if} (g.ActiveId == splitter_id) {\cf20 // Only process when splitter is active}\par
18616             \{\par
18617                 DockNodeTreeUpdateSplitterFindTouchingNode(child_0, axis, 1, &touching_nodes[0]);\par
18618                 DockNodeTreeUpdateSplitterFindTouchingNode(child_1, axis, 0, &touching_nodes[1]);\par
18619                 {\cf19 for} ({\cf18 int} touching_node_n = 0; touching_node_n < touching_nodes[0].Size; touching_node_n++)\par
18620                     resize_limits[0] = ImMax(resize_limits[0], touching_nodes[0][touching_node_n]->Rect().Min[axis] + min_size);\par
18621                 {\cf19 for} ({\cf18 int} touching_node_n = 0; touching_node_n < touching_nodes[1].Size; touching_node_n++)\par
18622                     resize_limits[1] = ImMin(resize_limits[1], touching_nodes[1][touching_node_n]->Rect().Max[axis] - min_size);\par
18623 \par
18624                 {\cf20 // [DEBUG] Render touching nodes & limits}\par
18625                 {\cf20 /*}\par
18626 {\cf20                 ImDrawList* draw_list = node->HostWindow ? GetForegroundDrawList(node->HostWindow) : GetForegroundDrawList(GetMainViewport());}\par
18627 {\cf20                 for (int n = 0; n < 2; n++)}\par
18628 {\cf20                 \{}\par
18629 {\cf20                     for (int touching_node_n = 0; touching_node_n < touching_nodes[n].Size; touching_node_n++)}\par
18630 {\cf20                         draw_list->AddRect(touching_nodes[n][touching_node_n]->Pos, touching_nodes[n][touching_node_n]->Pos + touching_nodes[n][touching_node_n]->Size, IM_COL32(0, 255, 0, 255));}\par
18631 {\cf20                     if (axis == ImGuiAxis_X)}\par
18632 {\cf20                         draw_list->AddLine(ImVec2(resize_limits[n], node->ChildNodes[n]->Pos.y), ImVec2(resize_limits[n], node->ChildNodes[n]->Pos.y + node->ChildNodes[n]->Size.y), IM_COL32(255, 0, 255, 255), 3.0f);}\par
18633 {\cf20                     else}\par
18634 {\cf20                         draw_list->AddLine(ImVec2(node->ChildNodes[n]->Pos.x, resize_limits[n]), ImVec2(node->ChildNodes[n]->Pos.x + node->ChildNodes[n]->Size.x, resize_limits[n]), IM_COL32(255, 0, 255, 255), 3.0f);}\par
18635 {\cf20                 \}}\par
18636 {\cf20                 */}\par
18637             \}\par
18638 \par
18639             {\cf20 // Use a short delay before highlighting the splitter (and changing the mouse cursor) in order for regular mouse movement to not highlight many splitters}\par
18640             {\cf18 float} cur_size_0 = child_0->Size[axis];\par
18641             {\cf18 float} cur_size_1 = child_1->Size[axis];\par
18642             {\cf18 float} min_size_0 = resize_limits[0] - child_0->Pos[axis];\par
18643             {\cf18 float} min_size_1 = child_1->Pos[axis] + child_1->Size[axis] - resize_limits[1];\par
18644             ImU32 bg_col = GetColorU32(ImGuiCol_WindowBg);\par
18645             {\cf19 if} (SplitterBehavior(bb, GetID({\cf22 "##Splitter"}), axis, &cur_size_0, &cur_size_1, min_size_0, min_size_1, WINDOWS_HOVER_PADDING, WINDOWS_RESIZE_FROM_EDGES_FEEDBACK_TIMER, bg_col))\par
18646             \{\par
18647                 {\cf19 if} (touching_nodes[0].Size > 0 && touching_nodes[1].Size > 0)\par
18648                 \{\par
18649                     child_0->Size[axis] = child_0->SizeRef[axis] = cur_size_0;\par
18650                     child_1->Pos[axis] -= cur_size_1 - child_1->Size[axis];\par
18651                     child_1->Size[axis] = child_1->SizeRef[axis] = cur_size_1;\par
18652 \par
18653                     {\cf20 // Lock the size of every node that is a sibling of the node we are touching}\par
18654                     {\cf20 // This might be less desirable if we can merge sibling of a same axis into the same parental level.}\par
18655                     {\cf19 for} ({\cf18 int} side_n = 0; side_n < 2; side_n++)\par
18656                         {\cf19 for} ({\cf18 int} touching_node_n = 0; touching_node_n < touching_nodes[side_n].Size; touching_node_n++)\par
18657                         \{\par
18658                             ImGuiDockNode* touching_node = touching_nodes[side_n][touching_node_n];\par
18659                             {\cf20 //ImDrawList* draw_list = node->HostWindow ? GetForegroundDrawList(node->HostWindow) : GetForegroundDrawList(GetMainViewport());}\par
18660                             {\cf20 //draw_list->AddRect(touching_node->Pos, touching_node->Pos + touching_node->Size, IM_COL32(255, 128, 0, 255));}\par
18661                             {\cf19 while} (touching_node->ParentNode != node)\par
18662                             \{\par
18663                                 {\cf19 if} (touching_node->ParentNode->SplitAxis == axis)\par
18664                                 \{\par
18665                                     {\cf20 // Mark other node so its size will be preserved during the upcoming call to DockNodeTreeUpdatePosSize().}\par
18666                                     ImGuiDockNode* node_to_preserve = touching_node->ParentNode->ChildNodes[side_n];\par
18667                                     node_to_preserve->WantLockSizeOnce = {\cf17 true};\par
