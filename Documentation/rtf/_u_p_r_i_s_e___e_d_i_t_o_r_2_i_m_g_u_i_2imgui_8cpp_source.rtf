18733 {\cf18 void} ImGui::SetWindowDock(ImGuiWindow* window, ImGuiID dock_id, ImGuiCond cond)\par
18734 \{\par
18735     {\cf20 // Test condition (NB: bit 0 is always true) and clear flags for next time}\par
18736     {\cf19 if} (cond && (window->SetWindowDockAllowFlags & cond) == 0)\par
18737         {\cf19 return};\par
18738     window->SetWindowDockAllowFlags &= ~(ImGuiCond_Once | ImGuiCond_FirstUseEver | ImGuiCond_Appearing);\par
18739 \par
18740     {\cf19 if} (window->DockId == dock_id)\par
18741         {\cf19 return};\par
18742 \par
18743     {\cf20 // If the user attempt to set a dock id that is a split node, we'll dig within to find a suitable docking spot}\par
18744     ImGuiContext& g = *GImGui;\par
18745     {\cf19 if} (ImGuiDockNode* new_node = DockContextFindNodeByID(&g, dock_id))\par
18746         {\cf19 if} (new_node->IsSplitNode())\par
18747         \{\par
18748             {\cf20 // Policy: Find central node or latest focused node. We first move back to our root node.}\par
18749             new_node = DockNodeGetRootNode(new_node);\par
18750             {\cf19 if} (new_node->CentralNode)\par
18751             \{\par
18752                 IM_ASSERT(new_node->CentralNode->IsCentralNode());\par
18753                 dock_id = new_node->CentralNode->ID;\par
18754             \}\par
18755             {\cf19 else}\par
18756             \{\par
18757                 dock_id = new_node->LastFocusedNodeId;\par
18758             \}\par
18759         \}\par
18760 \par
18761     {\cf19 if} (window->DockId == dock_id)\par
18762         {\cf19 return};\par
18763 \par
18764     {\cf19 if} (window->DockNode)\par
18765         DockNodeRemoveWindow(window->DockNode, window, 0);\par
18766     window->DockId = dock_id;\par
18767 \}\par
