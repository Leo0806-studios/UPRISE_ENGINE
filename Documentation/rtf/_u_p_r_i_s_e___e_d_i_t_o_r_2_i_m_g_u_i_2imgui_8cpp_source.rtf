16722 {\cf18 void} ImGui::DockContextProcessUndockNode(ImGuiContext* ctx, ImGuiDockNode* node)\par
16723 \{\par
16724     ImGuiContext& g = *ctx;\par
16725     IMGUI_DEBUG_LOG_DOCKING({\cf22 "[docking] DockContextProcessUndockNode node %08X\\n"}, node->ID);\par
16726     IM_ASSERT(node->IsLeafNode());\par
16727     IM_ASSERT(node->Windows.Size >= 1);\par
16728 \par
16729     {\cf19 if} (node->IsRootNode() || node->IsCentralNode())\par
16730     \{\par
16731         {\cf20 // In the case of a root node or central node, the node will have to stay in place. Create a new node to receive the payload.}\par
16732         ImGuiDockNode* new_node = DockContextAddNode(ctx, 0);\par
16733         new_node->Pos = node->Pos;\par
16734         new_node->Size = node->Size;\par
16735         new_node->SizeRef = node->SizeRef;\par
16736         DockNodeMoveWindows(new_node, node);\par
16737         DockSettingsRenameNodeReferences(node->ID, new_node->ID);\par
16738         node = new_node;\par
16739     \}\par
16740     {\cf19 else}\par
16741     \{\par
16742         {\cf20 // Otherwise extract our node and merge our sibling back into the parent node.}\par
16743         IM_ASSERT(node->ParentNode->ChildNodes[0] == node || node->ParentNode->ChildNodes[1] == node);\par
16744         {\cf18 int} index_in_parent = (node->ParentNode->ChildNodes[0] == node) ? 0 : 1;\par
16745         node->ParentNode->ChildNodes[index_in_parent] = NULL;\par
16746         DockNodeTreeMerge(ctx, node->ParentNode, node->ParentNode->ChildNodes[index_in_parent ^ 1]);\par
16747         node->ParentNode->AuthorityForViewport = ImGuiDataAuthority_Window; {\cf20 // The node that stays in place keeps the viewport, so our newly dragged out node will create a new viewport}\par
16748         node->ParentNode = NULL;\par
16749     \}\par
16750     {\cf19 for} (ImGuiWindow* window : node->Windows)\par
16751     \{\par
16752         window->Flags &= ~ImGuiWindowFlags_ChildWindow;\par
16753         {\cf19 if} (window->ParentWindow)\par
16754             window->ParentWindow->DC.ChildWindows.find_erase(window);\par
16755         UpdateWindowParentAndRootLinks(window, window->Flags, NULL);\par
16756     \}\par
16757     node->AuthorityForPos = node->AuthorityForSize = ImGuiDataAuthority_DockNode;\par
16758     node->Size = FixLargeWindowsWhenUndocking(node->Size, node->Windows[0]->Viewport);\par
16759     node->WantMouseMove = {\cf17 true};\par
16760     MarkIniSettingsDirty();\par
16761 \}\par
16762 \par
