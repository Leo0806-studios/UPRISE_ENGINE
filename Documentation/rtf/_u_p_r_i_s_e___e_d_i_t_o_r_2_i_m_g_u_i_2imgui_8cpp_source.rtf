03845     g.IO.ClipboardUserData = ({\cf18 void}*)&g;                          {\cf20 // Default implementation use the ImGuiContext as user data (ideally those would be arguments to the function)}\par
03846     g.IO.PlatformOpenInShellFn = PlatformOpenInShellFn_DefaultImpl;\par
03847     g.IO.PlatformSetImeDataFn = PlatformSetImeDataFn_DefaultImpl;\par
