15887 {\cf20 // Return value is always != NULL, but don't hold on it across frames.}\par
15888 {\cf17 const} ImGuiPlatformMonitor* ImGui::GetViewportPlatformMonitor(ImGuiViewport* viewport_p)\par
15889 \{\par
15890     ImGuiContext& g = *GImGui;\par
15891     ImGuiViewportP* viewport = (ImGuiViewportP*)({\cf18 void}*)viewport_p;\par
15892     {\cf18 int} monitor_idx = viewport->PlatformMonitor;\par
15893     {\cf19 if} (monitor_idx >= 0 && monitor_idx < g.PlatformIO.Monitors.Size)\par
15894         {\cf19 return} &g.PlatformIO.Monitors[monitor_idx];\par
15895     {\cf19 return} &g.FallbackMonitor;\par
15896 \}\par
