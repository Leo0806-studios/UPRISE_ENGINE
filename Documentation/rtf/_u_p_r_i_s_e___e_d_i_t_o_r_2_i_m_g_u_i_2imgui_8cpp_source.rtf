18063 {\cf18 void} ImGui::DockNodeCalcSplitRects(ImVec2& pos_old, ImVec2& size_old, ImVec2& pos_new, ImVec2& size_new, ImGuiDir dir, ImVec2 size_new_desired)\par
18064 \{\par
18065     ImGuiContext& g = *GImGui;\par
18066     {\cf17 const} {\cf18 float} dock_spacing = g.Style.ItemInnerSpacing.x;\par
18067     {\cf17 const} ImGuiAxis axis = (dir == ImGuiDir_Left || dir == ImGuiDir_Right) ? ImGuiAxis_X : ImGuiAxis_Y;\par
18068     pos_new[axis ^ 1] = pos_old[axis ^ 1];\par
18069     size_new[axis ^ 1] = size_old[axis ^ 1];\par
18070 \par
18071     {\cf20 // Distribute size on given axis (with a desired size or equally)}\par
18072     {\cf17 const} {\cf18 float} w_avail = size_old[axis] - dock_spacing;\par
18073     {\cf19 if} (size_new_desired[axis] > 0.0f && size_new_desired[axis] <= w_avail * 0.5f)\par
18074     \{\par
18075         size_new[axis] = size_new_desired[axis];\par
18076         size_old[axis] = IM_TRUNC(w_avail - size_new[axis]);\par
18077     \}\par
18078     {\cf19 else}\par
18079     \{\par
18080         size_new[axis] = IM_TRUNC(w_avail * 0.5f);\par
18081         size_old[axis] = IM_TRUNC(w_avail - size_new[axis]);\par
18082     \}\par
18083 \par
18084     {\cf20 // Position each node}\par
18085     {\cf19 if} (dir == ImGuiDir_Right || dir == ImGuiDir_Down)\par
18086     \{\par
18087         pos_new[axis] = pos_old[axis] + size_old[axis] + dock_spacing;\par
18088     \}\par
18089     {\cf19 else} {\cf19 if} (dir == ImGuiDir_Left || dir == ImGuiDir_Up)\par
18090     \{\par
18091         pos_new[axis] = pos_old[axis];\par
18092         pos_old[axis] = pos_new[axis] + size_new[axis] + dock_spacing;\par
18093     \}\par
18094 \}\par
18095 \par
18096 {\cf20 // Retrieve the drop rectangles for a given direction or for the center + perform hit testing.}\par
18097 {\cf18 bool} ImGui::DockNodeCalcDropRectsAndTestMousePos({\cf17 const} ImRect& parent, ImGuiDir dir, ImRect& out_r, {\cf18 bool} outer_docking, ImVec2* test_mouse_pos)\par
18098 \{\par
18099     ImGuiContext& g = *GImGui;\par
18100 \par
18101     {\cf17 const} {\cf18 float} parent_smaller_axis = ImMin(parent.GetWidth(), parent.GetHeight());\par
18102     {\cf17 const} {\cf18 float} hs_for_central_nodes = ImMin(g.FontSize * 1.5f, ImMax(g.FontSize * 0.5f, parent_smaller_axis / 8.0f));\par
18103     {\cf18 float} hs_w; {\cf20 // Half-size, longer axis}\par
18104     {\cf18 float} hs_h; {\cf20 // Half-size, smaller axis}\par
18105     ImVec2 off; {\cf20 // Distance from edge or center}\par
18106     {\cf19 if} (outer_docking)\par
18107     \{\par
18108         {\cf20 //hs_w = ImTrunc(ImClamp(parent_smaller_axis - hs_for_central_nodes * 4.0f, g.FontSize * 0.5f, g.FontSize * 8.0f));}\par
18109         {\cf20 //hs_h = ImTrunc(hs_w * 0.15f);}\par
18110         {\cf20 //off = ImVec2(ImTrunc(parent.GetWidth() * 0.5f - GetFrameHeightWithSpacing() * 1.4f - hs_h), ImTrunc(parent.GetHeight() * 0.5f - GetFrameHeightWithSpacing() * 1.4f - hs_h));}\par
18111         hs_w = ImTrunc(hs_for_central_nodes * 1.50f);\par
18112         hs_h = ImTrunc(hs_for_central_nodes * 0.80f);\par
18113         off = ImTrunc(ImVec2(parent.GetWidth() * 0.5f - hs_h, parent.GetHeight() * 0.5f - hs_h));\par
18114     \}\par
18115     {\cf19 else}\par
18116     \{\par
18117         hs_w = ImTrunc(hs_for_central_nodes);\par
18118         hs_h = ImTrunc(hs_for_central_nodes * 0.90f);\par
18119         off = ImTrunc(ImVec2(hs_w * 2.40f, hs_w * 2.40f));\par
18120     \}\par
18121 \par
18122     ImVec2 c = ImTrunc(parent.GetCenter());\par
18123     {\cf19 if}      (dir == ImGuiDir_None)  \{ out_r = ImRect(c.x - hs_w, c.y - hs_w,         c.x + hs_w, c.y + hs_w);         \}\par
18124     {\cf19 else} {\cf19 if} (dir == ImGuiDir_Up)    \{ out_r = ImRect(c.x - hs_w, c.y - off.y - hs_h, c.x + hs_w, c.y - off.y + hs_h); \}\par
18125     {\cf19 else} {\cf19 if} (dir == ImGuiDir_Down)  \{ out_r = ImRect(c.x - hs_w, c.y + off.y - hs_h, c.x + hs_w, c.y + off.y + hs_h); \}\par
18126     {\cf19 else} {\cf19 if} (dir == ImGuiDir_Left)  \{ out_r = ImRect(c.x - off.x - hs_h, c.y - hs_w, c.x - off.x + hs_h, c.y + hs_w); \}\par
18127     {\cf19 else} {\cf19 if} (dir == ImGuiDir_Right) \{ out_r = ImRect(c.x + off.x - hs_h, c.y - hs_w, c.x + off.x + hs_h, c.y + hs_w); \}\par
18128 \par
18129     {\cf19 if} (test_mouse_pos == NULL)\par
18130         {\cf19 return} {\cf17 false};\par
18131 \par
18132     ImRect hit_r = out_r;\par
18133     {\cf19 if} (!outer_docking)\par
18134     \{\par
18135         {\cf20 // Custom hit testing for the 5-way selection, designed to reduce flickering when moving diagonally between sides}\par
18136         hit_r.Expand(ImTrunc(hs_w * 0.30f));\par
18137         ImVec2 mouse_delta = (*test_mouse_pos - c);\par
18138         {\cf18 float} mouse_delta_len2 = ImLengthSqr(mouse_delta);\par
18139         {\cf18 float} r_threshold_center = hs_w * 1.4f;\par
18140         {\cf18 float} r_threshold_sides = hs_w * (1.4f + 1.2f);\par
18141         {\cf19 if} (mouse_delta_len2 < r_threshold_center * r_threshold_center)\par
18142             {\cf19 return} (dir == ImGuiDir_None);\par
18143         {\cf19 if} (mouse_delta_len2 < r_threshold_sides * r_threshold_sides)\par
18144             {\cf19 return} (dir == ImGetDirQuadrantFromDelta(mouse_delta.x, mouse_delta.y));\par
18145     \}\par
18146     {\cf19 return} hit_r.Contains(*test_mouse_pos);\par
18147 \}\par
18148 \par
18149 {\cf20 // host_node may be NULL if the window doesn't have a DockNode already.}\par
18150 {\cf20 // FIXME-DOCK: This is misnamed since it's also doing the filtering.}\par
18151 {\cf17 static} {\cf18 void} ImGui::DockNodePreviewDockSetup(ImGuiWindow* host_window, ImGuiDockNode* host_node, ImGuiWindow* payload_window, ImGuiDockNode* payload_node, ImGuiDockPreviewData* data, {\cf18 bool} is_explicit_target, {\cf18 bool} is_outer_docking)\par
18152 \{\par
18153     ImGuiContext& g = *GImGui;\par
18154 \par
18155     {\cf20 // There is an edge case when docking into a dockspace which only has inactive nodes.}\par
18156     {\cf20 // In this case DockNodeTreeFindNodeByPos() will have selected a leaf node which is inactive.}\par
18157     {\cf20 // Because the inactive leaf node doesn't have proper pos/size yet, we'll use the root node as reference.}\par
18158     {\cf19 if} (payload_node == NULL)\par
18159         payload_node = payload_window->DockNodeAsHost;\par
18160     ImGuiDockNode* ref_node_for_rect = (host_node && !host_node->IsVisible) ? DockNodeGetRootNode(host_node) : host_node;\par
18161     {\cf19 if} (ref_node_for_rect)\par
18162         IM_ASSERT(ref_node_for_rect->IsVisible == {\cf17 true});\par
18163 \par
18164     {\cf20 // Filter, figure out where we are allowed to dock}\par
18165     ImGuiDockNodeFlags src_node_flags = payload_node ? payload_node->MergedFlags : payload_window->WindowClass.DockNodeFlagsOverrideSet;\par
18166     ImGuiDockNodeFlags dst_node_flags = host_node ? host_node->MergedFlags : host_window->WindowClass.DockNodeFlagsOverrideSet;\par
18167     data->IsCenterAvailable = {\cf17 true};\par
18168     {\cf19 if} (is_outer_docking)\par
18169         data->IsCenterAvailable = {\cf17 false};\par
18170     {\cf19 else} {\cf19 if} (dst_node_flags & ImGuiDockNodeFlags_NoDockingOverMe)\par
18171         data->IsCenterAvailable = {\cf17 false};\par
18172     {\cf19 else} {\cf19 if} (host_node && (dst_node_flags & ImGuiDockNodeFlags_NoDockingOverCentralNode) && host_node->IsCentralNode())\par
18173         data->IsCenterAvailable = {\cf17 false};\par
18174     {\cf19 else} {\cf19 if} ((!host_node || !host_node->IsEmpty()) && payload_node && payload_node->IsSplitNode() && (payload_node->OnlyNodeWithWindows == NULL)) {\cf20 // Is _visibly_ split?}\par
18175         data->IsCenterAvailable = {\cf17 false};\par
18176     {\cf19 else} {\cf19 if} ((src_node_flags & ImGuiDockNodeFlags_NoDockingOverOther) && (!host_node || !host_node->IsEmpty()))\par
18177         data->IsCenterAvailable = {\cf17 false};\par
18178     {\cf19 else} {\cf19 if} ((src_node_flags & ImGuiDockNodeFlags_NoDockingOverEmpty) && host_node && host_node->IsEmpty())\par
18179         data->IsCenterAvailable = {\cf17 false};\par
18180 \par
18181     data->IsSidesAvailable = {\cf17 true};\par
18182     {\cf19 if} ((dst_node_flags & ImGuiDockNodeFlags_NoDockingSplit) || g.IO.ConfigDockingNoSplit)\par
18183         data->IsSidesAvailable = {\cf17 false};\par
18184     {\cf19 else} {\cf19 if} (!is_outer_docking && host_node && host_node->ParentNode == NULL && host_node->IsCentralNode())\par
18185         data->IsSidesAvailable = {\cf17 false};\par
18186     {\cf19 else} {\cf19 if} (src_node_flags & ImGuiDockNodeFlags_NoDockingSplitOther)\par
18187         data->IsSidesAvailable = {\cf17 false};\par
18188 \par
18189     {\cf20 // Build a tentative future node (reuse same structure because it is practical. Shape will be readjusted when previewing a split)}\par
18190     data->FutureNode.HasCloseButton = (host_node ? host_node->HasCloseButton : host_window->HasCloseButton) || (payload_window->HasCloseButton);\par
18191     data->FutureNode.HasWindowMenuButton = host_node ? true : ((host_window->Flags & ImGuiWindowFlags_NoCollapse) == 0);\par
18192     data->FutureNode.Pos = ref_node_for_rect ? ref_node_for_rect->Pos : host_window->Pos;\par
18193     data->FutureNode.Size = ref_node_for_rect ? ref_node_for_rect->Size : host_window->Size;\par
18194 \par
18195     {\cf20 // Calculate drop shapes geometry for allowed splitting directions}\par
18196     IM_ASSERT(ImGuiDir_None == -1);\par
18197     data->SplitNode = host_node;\par
18198     data->SplitDir = ImGuiDir_None;\par
18199     data->IsSplitDirExplicit = {\cf17 false};\par
18200     {\cf19 if} (!host_window->Collapsed)\par
18201         {\cf19 for} ({\cf18 int} dir = ImGuiDir_None; dir < ImGuiDir_COUNT; dir++)\par
18202         \{\par
18203             {\cf19 if} (dir == ImGuiDir_None && !data->IsCenterAvailable)\par
18204                 {\cf19 continue};\par
18205             {\cf19 if} (dir != ImGuiDir_None && !data->IsSidesAvailable)\par
18206                 {\cf19 continue};\par
18207             {\cf19 if} (DockNodeCalcDropRectsAndTestMousePos(data->FutureNode.Rect(), (ImGuiDir)dir, data->DropRectsDraw[dir+1], is_outer_docking, &g.IO.MousePos))\par
18208             \{\par
18209                 data->SplitDir = (ImGuiDir)dir;\par
18210                 data->IsSplitDirExplicit = {\cf17 true};\par
18211             \}\par
18212         \}\par
18213 \par
18214     {\cf20 // When docking without holding Shift, we only allow and preview docking when hovering over a drop rect or over the title bar}\par
18215     data->IsDropAllowed = (data->SplitDir != ImGuiDir_None) || (data->IsCenterAvailable);\par
18216     {\cf19 if} (!is_explicit_target && !data->IsSplitDirExplicit && !g.IO.ConfigDockingWithShift)\par
18217         data->IsDropAllowed = {\cf17 false};\par
18218 \par
18219     {\cf20 // Calculate split area}\par
18220     data->SplitRatio = 0.0f;\par
18221     {\cf19 if} (data->SplitDir != ImGuiDir_None)\par
18222     \{\par
18223         ImGuiDir split_dir = data->SplitDir;\par
18224         ImGuiAxis split_axis = (split_dir == ImGuiDir_Left || split_dir == ImGuiDir_Right) ? ImGuiAxis_X : ImGuiAxis_Y;\par
18225         ImVec2 pos_new, pos_old = data->FutureNode.Pos;\par
18226         ImVec2 size_new, size_old = data->FutureNode.Size;\par
18227         DockNodeCalcSplitRects(pos_old, size_old, pos_new, size_new, split_dir, payload_window->Size);\par
18228 \par
18229         {\cf20 // Calculate split ratio so we can pass it down the docking request}\par
18230         {\cf18 float} split_ratio = ImSaturate(size_new[split_axis] / data->FutureNode.Size[split_axis]);\par
18231         data->FutureNode.Pos = pos_new;\par
18232         data->FutureNode.Size = size_new;\par
18233         data->SplitRatio = (split_dir == ImGuiDir_Right || split_dir == ImGuiDir_Down) ? (1.0f - split_ratio) : (split_ratio);\par
18234     \}\par
18235 \}\par
