19805 {\cf17 static} {\cf18 void} ImGui::DockSettingsHandler_WriteAll(ImGuiContext* ctx, ImGuiSettingsHandler* handler, ImGuiTextBuffer* buf)\par
19806 \{\par
19807     ImGuiContext& g = *ctx;\par
19808     ImGuiDockContext* dc = &ctx->DockContext;\par
19809     {\cf19 if} (!(g.IO.ConfigFlags & ImGuiConfigFlags_DockingEnable))\par
19810         {\cf19 return};\par
19811 \par
19812     {\cf20 // Gather settings data}\par
19813     {\cf20 // (unlike our windows settings, because nodes are always built we can do a full rewrite of the SettingsNode buffer)}\par
19814     dc->NodesSettings.resize(0);\par
19815     dc->NodesSettings.reserve(dc->Nodes.Data.Size);\par
19816     {\cf19 for} ({\cf18 int} n = 0; n < dc->Nodes.Data.Size; n++)\par
19817         {\cf19 if} (ImGuiDockNode* node = (ImGuiDockNode*)dc->Nodes.Data[n].val_p)\par
19818             {\cf19 if} (node->IsRootNode())\par
19819                 DockSettingsHandler_DockNodeToSettings(dc, node, 0);\par
19820 \par
19821     {\cf18 int} max_depth = 0;\par
19822     {\cf19 for} ({\cf18 int} node_n = 0; node_n < dc->NodesSettings.Size; node_n++)\par
19823         max_depth = ImMax(({\cf18 int})dc->NodesSettings[node_n].Depth, max_depth);\par
19824 \par
19825     {\cf20 // Write to text buffer}\par
19826     buf->appendf({\cf22 "[%s][Data]\\n"}, handler->TypeName);\par
19827     {\cf19 for} ({\cf18 int} node_n = 0; node_n < dc->NodesSettings.Size; node_n++)\par
19828     \{\par
19829         {\cf17 const} {\cf18 int} line_start_pos = buf->size(); (void)line_start_pos;\par
19830         {\cf17 const} ImGuiDockNodeSettings* node_settings = &dc->NodesSettings[node_n];\par
