02192 {\cf20 // Known size hash}\par
02193 {\cf20 // It is ok to call ImHashData on a string with known length but the ### operator won't be supported.}\par
02194 {\cf20 // FIXME-OPT: Replace with e.g. FNV1a hash? CRC32 pretty much randomly access 1KB. Need to do proper measurements.}\par
02195 ImGuiID ImHashData({\cf17 const} {\cf18 void}* data_p, {\cf18 size_t} data_size, ImGuiID seed)\par
02196 \{\par
02197     ImU32 crc = ~seed;\par
02198     {\cf17 const} {\cf18 unsigned} {\cf18 char}* data = ({\cf17 const} {\cf18 unsigned} {\cf18 char}*)data_p;\par
02199     {\cf17 const} ImU32* crc32_lut = GCrc32LookupTable;\par
02200     {\cf19 while} (data_size-- != 0)\par
02201         crc = (crc >> 8) ^ crc32_lut[(crc & 0xFF) ^ *data++];\par
02202     {\cf19 return} ~crc;\par
02203 \}\par
02204 \par
02205 {\cf20 // Zero-terminated string hash, with support for ### to reset back to seed value}\par
02206 {\cf20 // We support a syntax of "label###id" where only "###id" is included in the hash, and only "label" gets displayed.}\par
02207 {\cf20 // Because this syntax is rarely used we are optimizing for the common case.}\par
02208 {\cf20 // - If we reach ### in the string we discard the hash so far and reset to the seed.}\par
02209 {\cf20 // - We don't do 'current += 2; continue;' after handling ### to keep the code smaller/faster (measured ~10% diff in Debug build)}\par
02210 {\cf20 // FIXME-OPT: Replace with e.g. FNV1a hash? CRC32 pretty much randomly access 1KB. Need to do proper measurements.}\par
02211 ImGuiID ImHashStr({\cf17 const} {\cf18 char}* data_p, {\cf18 size_t} data_size, ImGuiID seed)\par
02212 \{\par
02213     seed = ~seed;\par
02214     ImU32 crc = seed;\par
02215     {\cf17 const} {\cf18 unsigned} {\cf18 char}* data = ({\cf17 const} {\cf18 unsigned} {\cf18 char}*)data_p;\par
02216     {\cf17 const} ImU32* crc32_lut = GCrc32LookupTable;\par
02217     {\cf19 if} (data_size != 0)\par
02218     \{\par
02219         {\cf19 while} (data_size-- != 0)\par
02220         \{\par
02221             {\cf18 unsigned} {\cf18 char} c = *data++;\par
02222             {\cf19 if} (c == {\cf23 '#'} && data_size >= 2 && data[0] == {\cf23 '#'} && data[1] == {\cf23 '#'})\par
02223                 crc = seed;\par
02224             crc = (crc >> 8) ^ crc32_lut[(crc & 0xFF) ^ c];\par
02225         \}\par
02226     \}\par
02227     {\cf19 else}\par
02228     \{\par
02229         {\cf19 while} ({\cf18 unsigned} {\cf18 char} c = *data++)\par
02230         \{\par
02231             {\cf19 if} (c == {\cf23 '#'} && data[0] == {\cf23 '#'} && data[1] == {\cf23 '#'})\par
02232                 crc = seed;\par
02233             crc = (crc >> 8) ^ crc32_lut[(crc & 0xFF) ^ c];\par
02234         \}\par
02235     \}\par
02236     {\cf19 return} ~crc;\par
02237 \}\par
