09211 {\cf20 // t0 = previous time (e.g.: g.Time - g.IO.DeltaTime)}\par
09212 {\cf20 // t1 = current time (e.g.: g.Time)}\par
09213 {\cf20 // An event is triggered at:}\par
09214 {\cf20 //  t = 0.0f     t = repeat_delay,    t = repeat_delay + repeat_rate*N}\par
09215 {\cf18 int} ImGui::CalcTypematicRepeatAmount({\cf18 float} t0, {\cf18 float} t1, {\cf18 float} repeat_delay, {\cf18 float} repeat_rate)\par
09216 \{\par
09217     {\cf19 if} (t1 == 0.0f)\par
09218         {\cf19 return} 1;\par
09219     {\cf19 if} (t0 >= t1)\par
09220         {\cf19 return} 0;\par
09221     {\cf19 if} (repeat_rate <= 0.0f)\par
09222         {\cf19 return} (t0 < repeat_delay) && (t1 >= repeat_delay);\par
09223     {\cf17 const} {\cf18 int} count_t0 = (t0 < repeat_delay) ? -1 : (int)((t0 - repeat_delay) / repeat_rate);\par
09224     {\cf17 const} {\cf18 int} count_t1 = (t1 < repeat_delay) ? -1 : (int)((t1 - repeat_delay) / repeat_rate);\par
09225     {\cf17 const} {\cf18 int} count = count_t1 - count_t0;\par
09226     {\cf19 return} count;\par
09227 \}\par
