21771 {\cf20 // Display line, search for 0xXXXXXXXX identifiers and call DebugLocateItemOnHover() when hovered.}\par
21772 {\cf18 void} ImGui::DebugTextUnformattedWithLocateItem({\cf17 const} {\cf18 char}* line_begin, {\cf17 const} {\cf18 char}* line_end)\par
21773 \{\par
21774     TextUnformatted(line_begin, line_end);\par
21775     {\cf19 if} (!IsItemHovered())\par
21776         {\cf19 return};\par
21777     ImGuiContext& g = *GImGui;\par
21778     ImRect text_rect = g.LastItemData.Rect;\par
21779     {\cf19 for} ({\cf17 const} {\cf18 char}* p = line_begin; p <= line_end - 10; p++)\par
21780     \{\par
21781         ImGuiID {\cf18 id} = 0;\par
21782         {\cf19 if} (p[0] != {\cf23 '0'} || (p[1] != {\cf23 'x'} && p[1] != {\cf23 'X'}) || sscanf(p + 2, {\cf22 "%X"}, &{\cf18 id}) != 1 || ImCharIsXdigitA(p[10]))\par
21783             {\cf19 continue};\par
21784         ImVec2 p0 = CalcTextSize(line_begin, p);\par
21785         ImVec2 p1 = CalcTextSize(p, p + 10);\par
21786         g.LastItemData.Rect = ImRect(text_rect.Min + ImVec2(p0.x, 0.0f), text_rect.Min + ImVec2(p0.x + p1.x, p1.y));\par
21787         {\cf19 if} (IsMouseHoveringRect(g.LastItemData.Rect.Min, g.LastItemData.Rect.Max, {\cf17 true}))\par
21788             DebugLocateItemOnHover({\cf18 id});\par
21789         p += 10;\par
21790     \}\par
21791 \}\par
