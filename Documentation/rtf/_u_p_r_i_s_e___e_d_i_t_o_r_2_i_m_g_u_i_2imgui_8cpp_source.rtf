01830 ImVec2 ImBezierCubicClosestPoint({\cf17 const} ImVec2& p1, {\cf17 const} ImVec2& p2, {\cf17 const} ImVec2& p3, {\cf17 const} ImVec2& p4, {\cf17 const} ImVec2& p, {\cf18 int} num_segments)\par
01831 \{\par
