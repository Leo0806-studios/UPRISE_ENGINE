16335 {\cf17 static} {\cf18 void} ImGui::DockContextRemoveNode(ImGuiContext* ctx, ImGuiDockNode* node, {\cf18 bool} merge_sibling_into_parent_node)\par
16336 \{\par
16337     ImGuiContext& g = *ctx;\par
16338     ImGuiDockContext* dc = &ctx->DockContext;\par
16339 \par
16340     IMGUI_DEBUG_LOG_DOCKING({\cf22 "[docking] DockContextRemoveNode 0x%08X\\n"}, node->ID);\par
16341     IM_ASSERT(DockContextFindNodeByID(ctx, node->ID) == node);\par
16342     IM_ASSERT(node->ChildNodes[0] == NULL && node->ChildNodes[1] == NULL);\par
16343     IM_ASSERT(node->Windows.Size == 0);\par
16344 \par
16345     {\cf19 if} (node->HostWindow)\par
16346         node->HostWindow->DockNodeAsHost = NULL;\par
16347 \par
16348     ImGuiDockNode* parent_node = node->ParentNode;\par
16349     {\cf17 const} {\cf18 bool} merge = (merge_sibling_into_parent_node && parent_node != NULL);\par
16350     {\cf19 if} (merge)\par
16351     \{\par
16352         IM_ASSERT(parent_node->ChildNodes[0] == node || parent_node->ChildNodes[1] == node);\par
16353         ImGuiDockNode* sibling_node = (parent_node->ChildNodes[0] == node ? parent_node->ChildNodes[1] : parent_node->ChildNodes[0]);\par
16354         DockNodeTreeMerge(&g, parent_node, sibling_node);\par
16355     \}\par
16356     {\cf19 else}\par
16357     \{\par
16358         {\cf19 for} ({\cf18 int} n = 0; parent_node && n < IM_ARRAYSIZE(parent_node->ChildNodes); n++)\par
16359             {\cf19 if} (parent_node->ChildNodes[n] == node)\par
16360                 node->ParentNode->ChildNodes[n] = NULL;\par
16361         dc->Nodes.SetVoidPtr(node->ID, NULL);\par
16362         IM_DELETE(node);\par
16363     \}\par
16364 \}\par
