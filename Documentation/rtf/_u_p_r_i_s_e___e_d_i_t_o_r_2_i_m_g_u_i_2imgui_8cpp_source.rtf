16545 {\cf18 void} ImGui::DockContextProcessDock(ImGuiContext* ctx, ImGuiDockRequest* req)\par
16546 \{\par
16547     IM_ASSERT((req->Type == ImGuiDockRequestType_Dock && req->DockPayload != NULL) || (req->Type == ImGuiDockRequestType_Split && req->DockPayload == NULL));\par
16548     IM_ASSERT(req->DockTargetWindow != NULL || req->DockTargetNode != NULL);\par
16549 \par
16550     ImGuiContext& g = *ctx;\par
16551     IM_UNUSED(g);\par
16552 \par
16553     ImGuiWindow* payload_window = req->DockPayload;     {\cf20 // Optional}\par
16554     ImGuiWindow* target_window = req->DockTargetWindow;\par
16555     ImGuiDockNode* node = req->DockTargetNode;\par
16556     {\cf19 if} (payload_window)\par
16557         IMGUI_DEBUG_LOG_DOCKING({\cf22 "[docking] DockContextProcessDock node 0x%08X target '%s' dock window '%s', split_dir %d\\n"}, node ? node->ID : 0, target_window ? target_window->Name : {\cf22 "NULL"}, payload_window->Name, req->DockSplitDir);\par
16558     {\cf19 else}\par
16559         IMGUI_DEBUG_LOG_DOCKING({\cf22 "[docking] DockContextProcessDock node 0x%08X, split_dir %d\\n"}, node ? node->ID : 0, req->DockSplitDir);\par
16560 \par
16561     {\cf20 // Decide which Tab will be selected at the end of the operation}\par
16562     ImGuiID next_selected_id = 0;\par
16563     ImGuiDockNode* payload_node = NULL;\par
16564     {\cf19 if} (payload_window)\par
16565     \{\par
16566         payload_node = payload_window->DockNodeAsHost;\par
16567         payload_window->DockNodeAsHost = NULL; {\cf20 // Important to clear this as the node will have its life as a child which might be merged/deleted later.}\par
16568         {\cf19 if} (payload_node && payload_node->IsLeafNode())\par
16569             next_selected_id = payload_node->TabBar->NextSelectedTabId ? payload_node->TabBar->NextSelectedTabId : payload_node->TabBar->SelectedTabId;\par
16570         {\cf19 if} (payload_node == NULL)\par
16571             next_selected_id = payload_window->TabId;\par
16572     \}\par
16573 \par
16574     {\cf20 // FIXME-DOCK: When we are trying to dock an existing single-window node into a loose window, transfer Node ID as well}\par
16575     {\cf20 // When processing an interactive split, usually LastFrameAlive will be < g.FrameCount. But DockBuilder operations can make it ==.}\par
16576     {\cf19 if} (node)\par
16577         IM_ASSERT(node->LastFrameAlive <= g.FrameCount);\par
16578     {\cf19 if} (node && target_window && node == target_window->DockNodeAsHost)\par
16579         IM_ASSERT(node->Windows.Size > 0 || node->IsSplitNode() || node->IsCentralNode());\par
16580 \par
16581     {\cf20 // Create new node and add existing window to it}\par
16582     {\cf19 if} (node == NULL)\par
16583     \{\par
16584         node = DockContextAddNode(ctx, 0);\par
16585         node->Pos = target_window->Pos;\par
16586         node->Size = target_window->Size;\par
16587         {\cf19 if} (target_window->DockNodeAsHost == NULL)\par
16588         \{\par
16589             DockNodeAddWindow(node, target_window, {\cf17 true});\par
16590             node->TabBar->Tabs[0].Flags &= ~ImGuiTabItemFlags_Unsorted;\par
16591             target_window->DockIsActive = {\cf17 true};\par
16592         \}\par
16593     \}\par
16594 \par
16595     ImGuiDir split_dir = req->DockSplitDir;\par
16596     {\cf19 if} (split_dir != ImGuiDir_None)\par
16597     \{\par
16598         {\cf20 // Split into two, one side will be our payload node unless we are dropping a loose window}\par
16599         {\cf17 const} ImGuiAxis split_axis = (split_dir == ImGuiDir_Left || split_dir == ImGuiDir_Right) ? ImGuiAxis_X : ImGuiAxis_Y;\par
16600         {\cf17 const} {\cf18 int} split_inheritor_child_idx = (split_dir == ImGuiDir_Left || split_dir == ImGuiDir_Up) ? 1 : 0; {\cf20 // Current contents will be moved to the opposite side}\par
16601         {\cf17 const} {\cf18 float} split_ratio = req->DockSplitRatio;\par
16602         DockNodeTreeSplit(ctx, node, split_axis, split_inheritor_child_idx, split_ratio, payload_node);  {\cf20 // payload_node may be NULL here!}\par
16603         ImGuiDockNode* new_node = node->ChildNodes[split_inheritor_child_idx ^ 1];\par
16604         new_node->HostWindow = node->HostWindow;\par
16605         node = new_node;\par
16606     \}\par
16607     node->SetLocalFlags(node->LocalFlags & ~ImGuiDockNodeFlags_HiddenTabBar);\par
16608 \par
16609     {\cf19 if} (node != payload_node)\par
16610     \{\par
16611         {\cf20 // Create tab bar before we call DockNodeMoveWindows (which would attempt to move the old tab-bar, which would lead us to payload tabs wrongly appearing before target tabs!)}\par
16612         {\cf19 if} (node->Windows.Size > 0 && node->TabBar == NULL)\par
16613         \{\par
16614             DockNodeAddTabBar(node);\par
16615             {\cf19 for} ({\cf18 int} n = 0; n < node->Windows.Size; n++)\par
16616                 TabBarAddTab(node->TabBar, ImGuiTabItemFlags_None, node->Windows[n]);\par
16617         \}\par
16618 \par
16619         {\cf19 if} (payload_node != NULL)\par
16620         \{\par
16621             {\cf20 // Transfer full payload node (with 1+ child windows or child nodes)}\par
16622             {\cf19 if} (payload_node->IsSplitNode())\par
16623             \{\par
16624                 {\cf19 if} (node->Windows.Size > 0)\par
16625                 \{\par
16626                     {\cf20 // We can dock a split payload into a node that already has windows _only_ if our payload is a node tree with a single visible node.}\par
16627                     {\cf20 // In this situation, we move the windows of the target node into the currently visible node of the payload.}\par
16628                     {\cf20 // This allows us to preserve some of the underlying dock tree settings nicely.}\par
16629                     IM_ASSERT(payload_node->OnlyNodeWithWindows != NULL); {\cf20 // The docking should have been blocked by DockNodePreviewDockSetup() early on and never submitted.}\par
16630                     ImGuiDockNode* visible_node = payload_node->OnlyNodeWithWindows;\par
16631                     {\cf19 if} (visible_node->TabBar)\par
16632                         IM_ASSERT(visible_node->TabBar->Tabs.Size > 0);\par
16633                     DockNodeMoveWindows(node, visible_node);\par
16634                     DockNodeMoveWindows(visible_node, node);\par
16635                     DockSettingsRenameNodeReferences(node->ID, visible_node->ID);\par
16636                 \}\par
16637                 {\cf19 if} (node->IsCentralNode())\par
16638                 \{\par
16639                     {\cf20 // Central node property needs to be moved to a leaf node, pick the last focused one.}\par
16640                     {\cf20 // FIXME-DOCK: If we had to transfer other flags here, what would the policy be?}\par
16641                     ImGuiDockNode* last_focused_node = DockContextFindNodeByID(ctx, payload_node->LastFocusedNodeId);\par
16642                     IM_ASSERT(last_focused_node != NULL);\par
16643                     ImGuiDockNode* last_focused_root_node = DockNodeGetRootNode(last_focused_node);\par
16644                     IM_ASSERT(last_focused_root_node == DockNodeGetRootNode(payload_node));\par
16645                     last_focused_node->SetLocalFlags(last_focused_node->LocalFlags | ImGuiDockNodeFlags_CentralNode);\par
16646                     node->SetLocalFlags(node->LocalFlags & ~ImGuiDockNodeFlags_CentralNode);\par
16647                     last_focused_root_node->CentralNode = last_focused_node;\par
16648                 \}\par
16649 \par
16650                 IM_ASSERT(node->Windows.Size == 0);\par
16651                 DockNodeMoveChildNodes(node, payload_node);\par
16652             \}\par
16653             {\cf19 else}\par
16654             \{\par
16655                 {\cf17 const} ImGuiID payload_dock_id = payload_node->ID;\par
16656                 DockNodeMoveWindows(node, payload_node);\par
16657                 DockSettingsRenameNodeReferences(payload_dock_id, node->ID);\par
16658             \}\par
16659             DockContextRemoveNode(ctx, payload_node, {\cf17 true});\par
16660         \}\par
16661         {\cf19 else} {\cf19 if} (payload_window)\par
16662         \{\par
16663             {\cf20 // Transfer single window}\par
16664             {\cf17 const} ImGuiID payload_dock_id = payload_window->DockId;\par
16665             node->VisibleWindow = payload_window;\par
16666             DockNodeAddWindow(node, payload_window, {\cf17 true});\par
16667             {\cf19 if} (payload_dock_id != 0)\par
16668                 DockSettingsRenameNodeReferences(payload_dock_id, node->ID);\par
16669         \}\par
16670     \}\par
16671     {\cf19 else}\par
16672     \{\par
16673         {\cf20 // When docking a floating single window node we want to reevaluate auto-hiding of the tab bar}\par
16674         node->WantHiddenTabBarUpdate = {\cf17 true};\par
16675     \}\par
16676 \par
16677     {\cf20 // Update selection immediately}\par
16678     {\cf19 if} (ImGuiTabBar* tab_bar = node->TabBar)\par
16679         tab_bar->NextSelectedTabId = next_selected_id;\par
16680     MarkIniSettingsDirty();\par
16681 \}\par
16682 \par
16683 {\cf20 // Problem:}\par
16684 {\cf20 //   Undocking a large (~full screen) window would leave it so large that the bottom right sizing corner would more}\par
16685 {\cf20 //   than likely be off the screen and the window would be hard to resize to fit on screen. This can be particularly problematic}\par
16686 {\cf20 //   with 'ConfigWindowsMoveFromTitleBarOnly=true' and/or with 'ConfigWindowsResizeFromEdges=false' as well (the later can be}\par
16687 {\cf20 //   due to missing ImGuiBackendFlags_HasMouseCursors backend flag).}\par
16688 {\cf20 // Solution:}\par
16689 {\cf20 //   When undocking a window we currently force its maximum size to 90% of the host viewport or monitor.}\par
16690 {\cf20 // Reevaluate this when we implement preserving docked/undocked size ("docking_wip/undocked_size" branch).}\par
16691 {\cf17 static} ImVec2 FixLargeWindowsWhenUndocking({\cf17 const} ImVec2& size, ImGuiViewport* ref_viewport)\par
16692 \{\par
16693     {\cf19 if} (ref_viewport == NULL)\par
16694         {\cf19 return} size;\par
16695 \par
16696     ImGuiContext& g = *GImGui;\par
16697     ImVec2 max_size = ImTrunc(ref_viewport->WorkSize * 0.90f);\par
16698     {\cf19 if} (g.ConfigFlagsCurrFrame & ImGuiConfigFlags_ViewportsEnable)\par
16699     \{\par
16700         {\cf17 const} ImGuiPlatformMonitor* monitor = ImGui::GetViewportPlatformMonitor(ref_viewport);\par
16701         max_size = ImTrunc(monitor->WorkSize * 0.90f);\par
16702     \}\par
16703     {\cf19 return} ImMin(size, max_size);\par
16704 \}\par
16705 \par
16706 {\cf18 void} ImGui::DockContextProcessUndockWindow(ImGuiContext* ctx, ImGuiWindow* window, {\cf18 bool} clear_persistent_docking_ref)\par
16707 \{\par
16708     ImGuiContext& g = *ctx;\par
16709     IMGUI_DEBUG_LOG_DOCKING({\cf22 "[docking] DockContextProcessUndockWindow window '%s', clear_persistent_docking_ref = %d\\n"}, window->Name, clear_persistent_docking_ref);\par
16710     {\cf19 if} (window->DockNode)\par
16711         DockNodeRemoveWindow(window->DockNode, window, clear_persistent_docking_ref ? 0 : window->DockId);\par
16712     {\cf19 else}\par
16713         window->DockId = 0;\par
16714     window->Collapsed = {\cf17 false};\par
16715     window->DockIsActive = {\cf17 false};\par
16716     window->DockNodeIsVisible = window->DockTabIsVisible = {\cf17 false};\par
16717     window->Size = window->SizeFull = FixLargeWindowsWhenUndocking(window->SizeFull, window->Viewport);\par
16718 \par
16719     MarkIniSettingsDirty();\par
16720 \}\par
