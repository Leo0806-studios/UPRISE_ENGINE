18956         ImGuiWindowSettings* settings = FindWindowSettingsByID(window_id);\par
18957         {\cf19 if} (settings == NULL)\par
18958             settings = CreateNewWindowSettings(window_name);\par
18959         {\cf19 if} (settings->DockId != node_id)\par
18960             settings->DockOrder = -1;\par
