02246 ImFileHandle ImFileOpen({\cf17 const} {\cf18 char}* filename, {\cf17 const} {\cf18 char}* mode)\par
02247 \{\par
02248 {\cf21 #if defined(_WIN32) && !defined(IMGUI_DISABLE_WIN32_FUNCTIONS) && !defined(__CYGWIN__) && !defined(__GNUC__)}\par
02249     {\cf20 // We need a fopen() wrapper because MSVC/Windows fopen doesn't handle UTF-8 filenames.}\par
02250     {\cf20 // Previously we used ImTextCountCharsFromUtf8/ImTextStrFromUtf8 here but we now need to support ImWchar16 and ImWchar32!}\par
02251     {\cf17 const} {\cf18 int} filename_wsize = ::MultiByteToWideChar(CP_UTF8, 0, filename, -1, NULL, 0);\par
02252     {\cf17 const} {\cf18 int} mode_wsize = ::MultiByteToWideChar(CP_UTF8, 0, mode, -1, NULL, 0);\par
02253 \par
02254     {\cf20 // Use stack buffer if possible, otherwise heap buffer. Sizes include zero terminator.}\par
02255     {\cf20 // We don't rely on current ImGuiContext as this is implied to be a helper function which doesn't depend on it (see #7314).}\par
02256     {\cf18 wchar_t} local_temp_stack[FILENAME_MAX];\par
02257     ImVector<wchar_t> local_temp_heap;\par
02258     {\cf19 if} (filename_wsize + mode_wsize > IM_ARRAYSIZE(local_temp_stack))\par
02259         local_temp_heap.resize(filename_wsize + mode_wsize);\par
02260     {\cf18 wchar_t}* filename_wbuf = local_temp_heap.Data ? local_temp_heap.Data : local_temp_stack;\par
02261     {\cf18 wchar_t}* mode_wbuf = filename_wbuf + filename_wsize;\par
02262     ::MultiByteToWideChar(CP_UTF8, 0, filename, -1, filename_wbuf, filename_wsize);\par
02263     ::MultiByteToWideChar(CP_UTF8, 0, mode, -1, mode_wbuf, mode_wsize);\par
02264     return ::_wfopen(filename_wbuf, mode_wbuf);\par
02265 {\cf21 #else}\par
02266     {\cf19 return} fopen(filename, mode);\par
02267 {\cf21 #endif}\par
02268 \}\par
02269 \par
02270 {\cf20 // We should in theory be using fseeko()/ftello() with off_t and _fseeki64()/_ftelli64() with __int64, waiting for the PR that does that in a very portable pre-C++11 zero-warnings way.}\par
02271 {\cf18 bool}    ImFileClose(ImFileHandle f)     \{ {\cf19 return} fclose(f) == 0; \}\par
02272 ImU64   ImFileGetSize(ImFileHandle f)   \{ {\cf18 long} off = 0, sz = 0; {\cf19 return} ((off = ftell(f)) != -1 && !fseek(f, 0, SEEK_END) && (sz = ftell(f)) != -1 && !fseek(f, off, SEEK_SET)) ? (ImU64)sz : (ImU64)-1; \}\par
02273 ImU64   ImFileRead({\cf18 void}* data, ImU64 sz, ImU64 count, ImFileHandle f)           \{ {\cf19 return} fread(data, ({\cf18 size_t})sz, ({\cf18 size_t})count, f); \}\par
02274 ImU64   ImFileWrite({\cf17 const} {\cf18 void}* data, ImU64 sz, ImU64 count, ImFileHandle f)    \{ {\cf19 return} fwrite(data, ({\cf18 size_t})sz, ({\cf18 size_t})count, f); \}\par
02275 {\cf21 #endif }{\cf20 // #ifndef IMGUI_DISABLE_DEFAULT_FILE_FUNCTIONS}\par
