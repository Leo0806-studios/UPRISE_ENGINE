08423 {\cf18 void} ImGui::SetWindowPos(ImGuiWindow* window, {\cf17 const} ImVec2& pos, ImGuiCond cond)\par
08424 \{\par
08425     {\cf20 // Test condition (NB: bit 0 is always true) and clear flags for next time}\par
08426     {\cf19 if} (cond && (window->SetWindowPosAllowFlags & cond) == 0)\par
08427         {\cf19 return};\par
08428 \par
08429     IM_ASSERT(cond == 0 || ImIsPowerOfTwo(cond)); {\cf20 // Make sure the user doesn't attempt to combine multiple condition flags.}\par
08430     window->SetWindowPosAllowFlags &= ~(ImGuiCond_Once | ImGuiCond_FirstUseEver | ImGuiCond_Appearing);\par
08431     window->SetWindowPosVal = ImVec2(FLT_MAX, FLT_MAX);\par
