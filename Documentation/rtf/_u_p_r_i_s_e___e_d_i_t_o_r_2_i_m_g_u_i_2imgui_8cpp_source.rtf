19743 {\cf17 static} {\cf18 void} ImGui::DockSettingsHandler_ReadLine(ImGuiContext* ctx, ImGuiSettingsHandler*, {\cf18 void}*, {\cf17 const} {\cf18 char}* line)\par
19744 \{\par
19745     {\cf18 char} c = 0;\par
19746     {\cf18 int} x = 0, y = 0;\par
19747     {\cf18 int} r = 0;\par
19748 \par
19749     {\cf20 // Parsing, e.g.}\par
19750     {\cf20 // " DockNode   ID=0x00000001 Pos=383,193 Size=201,322 Split=Y,0.506 "}\par
19751     {\cf20 // "   DockNode ID=0x00000002 Parent=0x00000001 "}\par
19752     {\cf20 // Important: this code expect currently fields in a fixed order.}\par
19753     ImGuiDockNodeSettings node;\par
19754     line = ImStrSkipBlank(line);\par
19755     {\cf19 if}      (strncmp(line, {\cf22 "DockNode"}, 8) == 0)  \{ line = ImStrSkipBlank(line + strlen({\cf22 "DockNode"})); \}\par
19756     {\cf19 else} {\cf19 if} (strncmp(line, {\cf22 "DockSpace"}, 9) == 0) \{ line = ImStrSkipBlank(line + strlen({\cf22 "DockSpace"})); node.Flags |= ImGuiDockNodeFlags_DockSpace; \}\par
19757     {\cf19 else} {\cf19 return};\par
19758     {\cf19 if} (sscanf(line, {\cf22 "ID=0x%08X%n"},      &node.ID, &r) == 1)            \{ line += r; \} {\cf19 else} {\cf19 return};\par
19759     {\cf19 if} (sscanf(line, {\cf22 " Parent=0x%08X%n"}, &node.ParentNodeId, &r) == 1)  \{ line += r; {\cf19 if} (node.ParentNodeId == 0) {\cf19 return}; \}\par
19760     {\cf19 if} (sscanf(line, {\cf22 " Window=0x%08X%n"}, &node.ParentWindowId, &r) ==1) \{ line += r; {\cf19 if} (node.ParentWindowId == 0) {\cf19 return}; \}\par
19761     {\cf19 if} (node.ParentNodeId == 0)\par
19762     \{\par
19763         {\cf19 if} (sscanf(line, {\cf22 " Pos=%i,%i%n"},  &x, &y, &r) == 2)         \{ line += r; node.Pos = ImVec2ih(({\cf18 short})x, ({\cf18 short})y); \} {\cf19 else} {\cf19 return};\par
19764         {\cf19 if} (sscanf(line, {\cf22 " Size=%i,%i%n"}, &x, &y, &r) == 2)         \{ line += r; node.Size = ImVec2ih(({\cf18 short})x, ({\cf18 short})y); \} {\cf19 else} {\cf19 return};\par
19765     \}\par
19766     {\cf19 else}\par
19767     \{\par
19768         {\cf19 if} (sscanf(line, {\cf22 " SizeRef=%i,%i%n"}, &x, &y, &r) == 2)      \{ line += r; node.SizeRef = ImVec2ih(({\cf18 short})x, ({\cf18 short})y); \}\par
19769     \}\par
19770     {\cf19 if} (sscanf(line, {\cf22 " Split=%c%n"}, &c, &r) == 1)                   \{ line += r; {\cf19 if} (c == {\cf23 'X'}) node.SplitAxis = ImGuiAxis_X; {\cf19 else} {\cf19 if} (c == {\cf23 'Y'}) node.SplitAxis = ImGuiAxis_Y; \}\par
19771     {\cf19 if} (sscanf(line, {\cf22 " NoResize=%d%n"}, &x, &r) == 1)                \{ line += r; {\cf19 if} (x != 0) node.Flags |= ImGuiDockNodeFlags_NoResize; \}\par
19772     {\cf19 if} (sscanf(line, {\cf22 " CentralNode=%d%n"}, &x, &r) == 1)             \{ line += r; {\cf19 if} (x != 0) node.Flags |= ImGuiDockNodeFlags_CentralNode; \}\par
19773     {\cf19 if} (sscanf(line, {\cf22 " NoTabBar=%d%n"}, &x, &r) == 1)                \{ line += r; {\cf19 if} (x != 0) node.Flags |= ImGuiDockNodeFlags_NoTabBar; \}\par
19774     {\cf19 if} (sscanf(line, {\cf22 " HiddenTabBar=%d%n"}, &x, &r) == 1)            \{ line += r; {\cf19 if} (x != 0) node.Flags |= ImGuiDockNodeFlags_HiddenTabBar; \}\par
19775     {\cf19 if} (sscanf(line, {\cf22 " NoWindowMenuButton=%d%n"}, &x, &r) == 1)      \{ line += r; {\cf19 if} (x != 0) node.Flags |= ImGuiDockNodeFlags_NoWindowMenuButton; \}\par
19776     {\cf19 if} (sscanf(line, {\cf22 " NoCloseButton=%d%n"}, &x, &r) == 1)           \{ line += r; {\cf19 if} (x != 0) node.Flags |= ImGuiDockNodeFlags_NoCloseButton; \}\par
19777     {\cf19 if} (sscanf(line, {\cf22 " Selected=0x%08X%n"}, &node.SelectedTabId,&r) == 1) \{ line += r; \}\par
19778     {\cf19 if} (node.ParentNodeId != 0)\par
19779         {\cf19 if} (ImGuiDockNodeSettings* parent_settings = DockSettingsFindNodeSettings(ctx, node.ParentNodeId))\par
19780             node.Depth = parent_settings->Depth + 1;\par
19781     ctx->DockContext.NodesSettings.push_back(node);\par
19782 \}\par
