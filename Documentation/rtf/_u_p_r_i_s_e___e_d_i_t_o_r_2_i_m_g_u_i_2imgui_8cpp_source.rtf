12560 {\cf20 // True when current work location may be scrolled horizontally when moving left / right.}\par
12561 {\cf20 // This is generally always true UNLESS within a column. We don't have a vertical equivalent.}\par
12562 {\cf18 void} ImGui::NavUpdateCurrentWindowIsScrollPushableX()\par
12563 \{\par
12564     ImGuiContext& g = *GImGui;\par
12565     ImGuiWindow* window = g.CurrentWindow;\par
12566     window->DC.NavIsScrollPushableX = (g.CurrentTable == NULL && window->DC.CurrentColumns == NULL);\par
12567 \}\par
12568 \par
12569 {\cf20 // We get there when either NavId == id, or when g.NavAnyRequest is set (which is updated by NavUpdateAnyRequestFlag above)}\par
12570 {\cf20 // This is called after LastItemData is set, but NextItemData is also still valid.}\par
12571 {\cf17 static} {\cf18 void} ImGui::NavProcessItem()\par
12572 \{\par
12573     ImGuiContext& g = *GImGui;\par
12574     ImGuiWindow* window = g.CurrentWindow;\par
12575     {\cf17 const} ImGuiID {\cf18 id} = g.LastItemData.ID;\par
12576     {\cf17 const} ImGuiItemFlags item_flags = g.LastItemData.InFlags;\par
12577 \par
12578     {\cf20 // When inside a container that isn't scrollable with Left<>Right, clip NavRect accordingly (#2221)}\par
12579     {\cf19 if} (window->DC.NavIsScrollPushableX == {\cf17 false})\par
12580     \{\par
12581         g.LastItemData.NavRect.Min.x = ImClamp(g.LastItemData.NavRect.Min.x, window->ClipRect.Min.x, window->ClipRect.Max.x);\par
12582         g.LastItemData.NavRect.Max.x = ImClamp(g.LastItemData.NavRect.Max.x, window->ClipRect.Min.x, window->ClipRect.Max.x);\par
12583     \}\par
12584     {\cf17 const} ImRect nav_bb = g.LastItemData.NavRect;\par
12585 \par
12586     {\cf20 // Process Init Request}\par
12587     {\cf19 if} (g.NavInitRequest && g.NavLayer == window->DC.NavLayerCurrent && (item_flags & ImGuiItemFlags_Disabled) == 0)\par
12588     \{\par
12589         {\cf20 // Even if 'ImGuiItemFlags_NoNavDefaultFocus' is on (typically collapse/close button) we record the first ResultId so they can be used as a fallback}\par
12590         {\cf17 const} {\cf18 bool} candidate_for_nav_default_focus = (item_flags & ImGuiItemFlags_NoNavDefaultFocus) == 0;\par
12591         {\cf19 if} (candidate_for_nav_default_focus || g.NavInitResult.ID == 0)\par
12592         \{\par
12593             NavApplyItemToResult(&g.NavInitResult);\par
12594         \}\par
12595         {\cf19 if} (candidate_for_nav_default_focus)\par
12596         \{\par
12597             g.NavInitRequest = {\cf17 false}; {\cf20 // Found a match, clear request}\par
12598             NavUpdateAnyRequestFlag();\par
12599         \}\par
12600     \}\par
12601 \par
12602     {\cf20 // Process Move Request (scoring for navigation)}\par
12603     {\cf20 // FIXME-NAV: Consider policy for double scoring (scoring from NavScoringRect + scoring from a rect wrapped according to current wrapping policy)}\par
12604     {\cf19 if} (g.NavMoveScoringItems && (item_flags & ImGuiItemFlags_Disabled) == 0)\par
12605     \{\par
12606         {\cf19 if} ((g.NavMoveFlags & ImGuiNavMoveFlags_FocusApi) || (window->Flags & ImGuiWindowFlags_NoNavInputs) == 0)\par
12607         \{\par
12608             {\cf17 const} {\cf18 bool} is_tabbing = (g.NavMoveFlags & ImGuiNavMoveFlags_IsTabbing) != 0;\par
