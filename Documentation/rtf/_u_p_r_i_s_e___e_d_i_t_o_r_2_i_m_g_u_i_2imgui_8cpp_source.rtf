02047 \{\par
02048     {\cf18 char}* p = buf;\par
02049     {\cf19 while} (p[0] == {\cf23 ' '} || p[0] == {\cf23 '\\t'})     {\cf20 // Leading blanks}\par
02050         p++;\par
02051     {\cf18 char}* p_start = p;\par
02052     {\cf19 while} (*p != 0)                         {\cf20 // Find end of string}\par
02053         p++;\par
02054     {\cf19 while} (p > p_start && (p[-1] == {\cf23 ' '} || p[-1] == {\cf23 '\\t'}))  {\cf20 // Trailing blanks}\par
02055         p--;\par
02056     {\cf19 if} (p_start != buf)                     {\cf20 // Copy memory if we had leading blanks}\par
02057         memmove(buf, p_start, p - p_start);\par
02058     buf[p - p_start] = 0;                   {\cf20 // Zero terminate}\par
02059 \}\par
