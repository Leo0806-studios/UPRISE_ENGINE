08435     window->Pos = ImTrunc(pos);\par
08436     ImVec2 offset = window->Pos - old_pos;\par
08437     {\cf19 if} (offset.x == 0.0f && offset.y == 0.0f)\par
08438         {\cf19 return};\par
08439     MarkIniSettingsDirty(window);\par
08440     {\cf20 // FIXME: share code with TranslateWindow(), need to confirm whether the 3 rect modified by TranslateWindow() are desirable here.}\par
08441     window->DC.CursorPos += offset;         {\cf20 // As we happen to move the window while it is being appended to (which is a bad idea - will smear) let's at least offset the cursor}\par
08442     window->DC.CursorMaxPos += offset;      {\cf20 // And more importantly we need to offset CursorMaxPos/CursorStartPos this so ContentSize calculation doesn't get affected.}\par
08443     window->DC.IdealMaxPos += offset;\par
08444     window->DC.CursorStartPos += offset;\par
