02933 {\cf20 // FIXME-TABLE: This prevents us from using ImGuiListClipper _inside_ a table cell.}\par
02934 {\cf20 // The problem we have is that without a Begin/End scheme for rows using the clipper is ambiguous.}\par
02935 {\cf17 static} {\cf18 bool} GetSkipItemForListClipping()\par
02936 \{\par
02937     ImGuiContext& g = *GImGui;\par
02938     {\cf19 return} (g.CurrentTable ? g.CurrentTable->HostSkipItems : g.CurrentWindow->SkipItems);\par
02939 \}\par
