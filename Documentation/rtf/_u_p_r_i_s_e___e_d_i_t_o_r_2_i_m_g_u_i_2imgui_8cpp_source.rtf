19928     {\cf17 const} {\cf18 int} wbuf_length = ::MultiByteToWideChar(CP_UTF8, 0, text, -1, NULL, 0);\par
19929     HGLOBAL wbuf_handle = ::GlobalAlloc(GMEM_MOVEABLE, (SIZE_T)wbuf_length * {\cf17 sizeof}(WCHAR));\par
19930     {\cf19 if} (wbuf_handle == NULL)\par
19931     \{\par
19932         ::CloseClipboard();\par
19933         {\cf19 return};\par
19934     \}\par
