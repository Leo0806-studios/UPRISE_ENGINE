16211 {\cf18 void} ImGui::DockContextNewFrameUpdateUndocking(ImGuiContext* ctx)\par
16212 \{\par
16213     ImGuiContext& g = *ctx;\par
16214     ImGuiDockContext* dc = &ctx->DockContext;\par
16215     {\cf19 if} (!(g.IO.ConfigFlags & ImGuiConfigFlags_DockingEnable))\par
16216     \{\par
16217         {\cf19 if} (dc->Nodes.Data.Size > 0 || dc->Requests.Size > 0)\par
16218             DockContextClearNodes(ctx, 0, {\cf17 true});\par
16219         {\cf19 return};\par
16220     \}\par
16221 \par
16222     {\cf20 // Setting NoSplit at runtime merges all nodes}\par
16223     {\cf19 if} (g.IO.ConfigDockingNoSplit)\par
16224         {\cf19 for} ({\cf18 int} n = 0; n < dc->Nodes.Data.Size; n++)\par
16225             {\cf19 if} (ImGuiDockNode* node = (ImGuiDockNode*)dc->Nodes.Data[n].val_p)\par
16226                 {\cf19 if} (node->IsRootNode() && node->IsSplitNode())\par
16227                 \{\par
16228                     DockBuilderRemoveNodeChildNodes(node->ID);\par
16229                     {\cf20 //dc->WantFullRebuild = true;}\par
16230                 \}\par
16231 \par
16232     {\cf20 // Process full rebuild}\par
16233 {\cf21 #if 0}\par
16234     {\cf19 if} (ImGui::IsKeyPressed(ImGui::GetKeyIndex(ImGuiKey_C)))\par
16235         dc->WantFullRebuild = {\cf17 true};\par
16236 {\cf21 #endif}\par
16237     {\cf19 if} (dc->WantFullRebuild)\par
16238     \{\par
16239         DockContextRebuildNodes(ctx);\par
16240         dc->WantFullRebuild = {\cf17 false};\par
16241     \}\par
16242 \par
16243     {\cf20 // Process Undocking requests (we need to process them _before_ the UpdateMouseMovingWindowNewFrame call in NewFrame)}\par
16244     {\cf19 for} (ImGuiDockRequest& req : dc->Requests)\par
16245     \{\par
16246         {\cf19 if} (req.Type == ImGuiDockRequestType_Undock && req.UndockTargetWindow)\par
16247             DockContextProcessUndockWindow(ctx, req.UndockTargetWindow);\par
16248         {\cf19 else} {\cf19 if} (req.Type == ImGuiDockRequestType_Undock && req.UndockTargetNode)\par
16249             DockContextProcessUndockNode(ctx, req.UndockTargetNode);\par
16250     \}\par
16251 \}\par
