16921 {\cf17 static} {\cf18 void} ImGui::DockNodeRemoveWindow(ImGuiDockNode* node, ImGuiWindow* window, ImGuiID save_dock_id)\par
16922 \{\par
16923     ImGuiContext& g = *GImGui;\par
16924     IM_ASSERT(window->DockNode == node);\par
16925     {\cf20 //IM_ASSERT(window->RootWindowDockTree == node->HostWindow);}\par
16926     {\cf20 //IM_ASSERT(window->LastFrameActive < g.FrameCount);    // We may call this from Begin()}\par
16927     IM_ASSERT(save_dock_id == 0 || save_dock_id == node->ID);\par
16928     IMGUI_DEBUG_LOG_DOCKING({\cf22 "[docking] DockNodeRemoveWindow node 0x%08X window '%s'\\n"}, node->ID, window->Name);\par
16929 \par
16930     window->DockNode = NULL;\par
16931     window->DockIsActive = window->DockTabWantClose = {\cf17 false};\par
16932     window->DockId = save_dock_id;\par
16933     window->Flags &= ~ImGuiWindowFlags_ChildWindow;\par
16934     {\cf19 if} (window->ParentWindow)\par
16935         window->ParentWindow->DC.ChildWindows.find_erase(window);\par
16936     UpdateWindowParentAndRootLinks(window, window->Flags, NULL); {\cf20 // Update immediately}\par
16937 \par
16938     {\cf19 if} (node->HostWindow && node->HostWindow->ViewportOwned)\par
16939     \{\par
16940         {\cf20 // When undocking from a user interaction this will always run in NewFrame() and have not much effect.}\par
16941         {\cf20 // But mid-frame, if we clear viewport we need to mark window as hidden as well.}\par
16942         window->Viewport = NULL;\par
16943         window->ViewportId = 0;\par
16944         window->ViewportOwned = {\cf17 false};\par
16945         window->Hidden = {\cf17 true};\par
16946     \}\par
16947 \par
16948     {\cf20 // Remove window}\par
16949     {\cf18 bool} erased = {\cf17 false};\par
16950     {\cf19 for} ({\cf18 int} n = 0; n < node->Windows.Size; n++)\par
16951         {\cf19 if} (node->Windows[n] == window)\par
16952         \{\par
16953             node->Windows.erase(node->Windows.Data + n);\par
16954             erased = {\cf17 true};\par
16955             {\cf19 break};\par
16956         \}\par
16957     {\cf19 if} (!erased)\par
16958         IM_ASSERT(erased);\par
16959     {\cf19 if} (node->VisibleWindow == window)\par
16960         node->VisibleWindow = NULL;\par
16961 \par
16962     {\cf20 // Remove tab and possibly tab bar}\par
16963     node->WantHiddenTabBarUpdate = {\cf17 true};\par
16964     {\cf19 if} (node->TabBar)\par
16965     \{\par
16966         TabBarRemoveTab(node->TabBar, window->TabId);\par
16967         {\cf17 const} {\cf18 int} tab_count_threshold_for_tab_bar = node->IsCentralNode() ? 1 : 2;\par
16968         {\cf19 if} (node->Windows.Size < tab_count_threshold_for_tab_bar)\par
16969             DockNodeRemoveTabBar(node);\par
16970     \}\par
16971 \par
16972     {\cf19 if} (node->Windows.Size == 0 && !node->IsCentralNode() && !node->IsDockSpace() && window->DockId != node->ID)\par
16973     \{\par
16974         {\cf20 // Automatic dock node delete themselves if they are not holding at least one tab}\par
16975         DockContextRemoveNode(&g, node, {\cf17 true});\par
16976         {\cf19 return};\par
16977     \}\par
16978 \par
16979     {\cf19 if} (node->Windows.Size == 1 && !node->IsCentralNode() && node->HostWindow)\par
16980     \{\par
16981         ImGuiWindow* remaining_window = node->Windows[0];\par
16982         {\cf20 // Note: we used to transport viewport ownership here.}\par
16983         remaining_window->Collapsed = node->HostWindow->Collapsed;\par
16984     \}\par
16985 \par
16986     {\cf20 // Update visibility immediately is required so the DockNodeUpdateRemoveInactiveChilds() processing can reflect changes up the tree}\par
16987     DockNodeUpdateVisibleFlag(node);\par
16988 \}\par
