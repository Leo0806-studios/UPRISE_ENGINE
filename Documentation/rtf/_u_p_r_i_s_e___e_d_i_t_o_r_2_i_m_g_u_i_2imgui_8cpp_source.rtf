19419 {\cf18 void} ImGui::BeginDocked(ImGuiWindow* window, {\cf18 bool}* p_open)\par
19420 \{\par
19421     ImGuiContext& g = *GImGui;\par
19422 \par
19423     {\cf20 // Clear fields ahead so most early-out paths don't have to do it}\par
19424     window->DockIsActive = window->DockNodeIsVisible = window->DockTabIsVisible = {\cf17 false};\par
19425 \par
19426     {\cf17 const} {\cf18 bool} auto_dock_node = GetWindowAlwaysWantOwnTabBar(window);\par
19427     {\cf19 if} (auto_dock_node)\par
19428     \{\par
19429         {\cf19 if} (window->DockId == 0)\par
19430         \{\par
19431             IM_ASSERT(window->DockNode == NULL);\par
19432             window->DockId = DockContextGenNodeID(&g);\par
19433         \}\par
19434     \}\par
19435     {\cf19 else}\par
19436     \{\par
19437         {\cf20 // Calling SetNextWindowPos() undock windows by default (by setting PosUndock)}\par
19438         {\cf18 bool} want_undock = {\cf17 false};\par
19439         want_undock |= (window->Flags & ImGuiWindowFlags_NoDocking) != 0;\par
19440         want_undock |= (g.NextWindowData.Flags & ImGuiNextWindowDataFlags_HasPos) && (window->SetWindowPosAllowFlags & g.NextWindowData.PosCond) && g.NextWindowData.PosUndock;\par
19441         {\cf19 if} (want_undock)\par
19442         \{\par
19443             DockContextProcessUndockWindow(&g, window);\par
19444             {\cf19 return};\par
19445         \}\par
19446     \}\par
19447 \par
19448     {\cf20 // Bind to our dock node}\par
19449     ImGuiDockNode* node = window->DockNode;\par
19450     {\cf19 if} (node != NULL)\par
19451         IM_ASSERT(window->DockId == node->ID);\par
19452     {\cf19 if} (window->DockId != 0 && node == NULL)\par
19453     \{\par
19454         node = DockContextBindNodeToWindow(&g, window);\par
19455         {\cf19 if} (node == NULL)\par
19456             {\cf19 return};\par
19457     \}\par
19458 \par
19459 {\cf21 #if 0}\par
19460     {\cf20 // Undock if the ImGuiDockNodeFlags_NoDockingInCentralNode got set}\par
19461     {\cf19 if} (node->IsCentralNode && (node->Flags & ImGuiDockNodeFlags_NoDockingInCentralNode))\par
19462     \{\par
19463         DockContextProcessUndockWindow(ctx, window);\par
19464         {\cf19 return};\par
19465     \}\par
19466 {\cf21 #endif}\par
19467 \par
19468     {\cf20 // Undock if our dockspace node disappeared}\par
19469     {\cf20 // Note how we are testing for LastFrameAlive and NOT LastFrameActive. A DockSpace node can be maintained alive while being inactive with ImGuiDockNodeFlags_KeepAliveOnly.}\par
19470     {\cf19 if} (node->LastFrameAlive < g.FrameCount)\par
19471     \{\par
19472         {\cf20 // If the window has been orphaned, transition the docknode to an implicit node processed in DockContextNewFrameUpdateDocking()}\par
19473         ImGuiDockNode* root_node = DockNodeGetRootNode(node);\par
19474         {\cf19 if} (root_node->LastFrameAlive < g.FrameCount)\par
19475             DockContextProcessUndockWindow(&g, window);\par
19476         {\cf19 else}\par
19477             window->DockIsActive = {\cf17 true};\par
19478         {\cf19 return};\par
19479     \}\par
19480 \par
19481     {\cf20 // Store style overrides}\par
19482     StoreDockStyleForWindow(window);\par
19483 \par
