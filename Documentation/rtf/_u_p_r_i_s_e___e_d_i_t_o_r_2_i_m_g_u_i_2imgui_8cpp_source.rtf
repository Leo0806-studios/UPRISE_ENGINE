02483 {\cf18 int} ImTextCountUtf8BytesFromStr({\cf17 const} ImWchar* in_text, {\cf17 const} ImWchar* in_text_end)\par
02484 \{\par
02485     {\cf18 int} bytes_count = 0;\par
02486     {\cf19 while} ((!in_text_end || in_text < in_text_end) && *in_text)\par
