06944 {\cf20 // Push a new Dear ImGui window to add widgets to.}\par
06945 {\cf20 // - A default window called "Debug" is automatically stacked at the beginning of every frame so you can use widgets without explicitly calling a Begin/End pair.}\par
06946 {\cf20 // - Begin/End can be called multiple times during the frame with the same window name to append content.}\par
06947 {\cf20 // - The window name is used as a unique identifier to preserve window information across frames (and save rudimentary information to the .ini file).}\par
06948 {\cf20 //   You can use the "##" or "###" markers to use the same label with different id, or same id with different label. See documentation at the top of this file.}\par
06949 {\cf20 // - Return false when window is collapsed, so you can early out in your code. You always need to call ImGui::End() even if false is returned.}\par
06950 {\cf20 // - Passing 'bool* p_open' displays a Close button on the upper-right corner of the window, the pointed value will be set to false when the button is pressed.}\par
06951 {\cf18 bool} ImGui::Begin({\cf17 const} {\cf18 char}* name, {\cf18 bool}* p_open, ImGuiWindowFlags flags)\par
06952 \{\par
06953     ImGuiContext& g = *GImGui;\par
06954     {\cf17 const} ImGuiStyle& style = g.Style;\par
06955     IM_ASSERT(name != NULL && name[0] != {\cf23 '\\0'});     {\cf20 // Window name required}\par
06956     IM_ASSERT(g.WithinFrameScope);                  {\cf20 // Forgot to call ImGui::NewFrame()}\par
06957     IM_ASSERT(g.FrameCountEnded != g.FrameCount);   {\cf20 // Called ImGui::Render() or ImGui::EndFrame() and haven't called ImGui::NewFrame() again yet}\par
06958 \par
06959     {\cf20 // Find or create}\par
06960     ImGuiWindow* window = FindWindowByName(name);\par
06961     {\cf17 const} {\cf18 bool} window_just_created = (window == NULL);\par
06962     {\cf19 if} (window_just_created)\par
06963         window = CreateNewWindow(name, flags);\par
06964 \par
06965     {\cf20 // [DEBUG] Debug break requested by user}\par
06966     {\cf19 if} (g.DebugBreakInWindow == window->ID)\par
06967         IM_DEBUG_BREAK();\par
06968 \par
06969     {\cf20 // Automatically disable manual moving/resizing when NoInputs is set}\par
06970     {\cf19 if} ((flags & ImGuiWindowFlags_NoInputs) == ImGuiWindowFlags_NoInputs)\par
06971         flags |= ImGuiWindowFlags_NoMove | ImGuiWindowFlags_NoResize;\par
06972 \par
06973     {\cf17 const} {\cf18 int} current_frame = g.FrameCount;\par
06974     {\cf17 const} {\cf18 bool} first_begin_of_the_frame = (window->LastFrameActive != current_frame);\par
06975     window->IsFallbackWindow = (g.CurrentWindowStack.Size == 0 && g.WithinFrameScopeWithImplicitWindow);\par
06976 \par
06977     {\cf20 // Update the Appearing flag (note: the BeginDocked() path may also set this to true later)}\par
06978     {\cf18 bool} window_just_activated_by_user = (window->LastFrameActive < current_frame - 1); {\cf20 // Not using !WasActive because the implicit "Debug" window would always toggle off->on}\par
06979     {\cf19 if} (flags & ImGuiWindowFlags_Popup)\par
06980     \{\par
06981         ImGuiPopupData& popup_ref = g.OpenPopupStack[g.BeginPopupStack.Size];\par
06982         window_just_activated_by_user |= (window->PopupId != popup_ref.PopupId); {\cf20 // We recycle popups so treat window as activated if popup id changed}\par
06983         window_just_activated_by_user |= (window != popup_ref.Window);\par
06984     \}\par
06985 \par
06986     {\cf20 // Update Flags, LastFrameActive, BeginOrderXXX fields}\par
06987     {\cf17 const} {\cf18 bool} window_was_appearing = window->Appearing;\par
06988     {\cf19 if} (first_begin_of_the_frame)\par
06989     \{\par
06990         UpdateWindowInFocusOrderList(window, window_just_created, flags);\par
06991         window->Appearing = window_just_activated_by_user;\par
06992         {\cf19 if} (window->Appearing)\par
06993             SetWindowConditionAllowFlags(window, ImGuiCond_Appearing, {\cf17 true});\par
06994         window->FlagsPreviousFrame = window->Flags;\par
06995         window->Flags = (ImGuiWindowFlags)flags;\par
06996         window->ChildFlags = (g.NextWindowData.Flags & ImGuiNextWindowDataFlags_HasChildFlags) ? g.NextWindowData.ChildFlags : 0;\par
06997         window->LastFrameActive = current_frame;\par
06998         window->LastTimeActive = (float)g.Time;\par
06999         window->BeginOrderWithinParent = 0;\par
07000         window->BeginOrderWithinContext = (short)(g.WindowsActiveCount++);\par
07001     \}\par
07002     {\cf19 else}\par
07003     \{\par
07004         flags = window->Flags;\par
07005     \}\par
