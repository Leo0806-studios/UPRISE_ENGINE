13283         {\cf20 //GetForegroundDrawList()->AddRect(scoring_rect.Min, scoring_rect.Max, IM_COL32(255,200,0,255)); // [DEBUG]}\par
13284         {\cf20 //if (!g.NavScoringNoClipRect.IsInverted()) \{ GetForegroundDrawList()->AddRect(g.NavScoringNoClipRect.Min, g.NavScoringNoClipRect.Max, IM_COL32(255, 200, 0, 255)); \} // [DEBUG]}\par
