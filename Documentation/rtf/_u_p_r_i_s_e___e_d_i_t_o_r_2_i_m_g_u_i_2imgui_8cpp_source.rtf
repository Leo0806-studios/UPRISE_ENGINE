10210 {\cf20 // Process input queue}\par
10211 {\cf20 // We always call this with the value of 'bool g.IO.ConfigInputTrickleEventQueue'.}\par
10212 {\cf20 // - trickle_fast_inputs = false : process all events, turn into flattened input state (e.g. successive down/up/down/up will be lost)}\par
10213 {\cf20 // - trickle_fast_inputs = true  : process as many events as possible (successive down/up/down/up will be trickled over several frames so nothing is lost) (new feature in 1.87)}\par
10214 {\cf18 void} ImGui::UpdateInputEvents({\cf18 bool} trickle_fast_inputs)\par
10215 \{\par
10216     ImGuiContext& g = *GImGui;\par
10217     ImGuiIO& io = g.IO;\par
10218 \par
10219     {\cf20 // Only trickle chars<>key when working with InputText()}\par
10220     {\cf20 // FIXME: InputText() could parse event trail?}\par
10221     {\cf20 // FIXME: Could specialize chars<>keys trickling rules for control keys (those not typically associated to characters)}\par
10222     {\cf17 const} {\cf18 bool} trickle_interleaved_keys_and_text = (trickle_fast_inputs && g.WantTextInputNextFrame == 1);\par
10223 \par
10224     {\cf18 bool} mouse_moved = {\cf17 false}, mouse_wheeled = {\cf17 false}, key_changed = {\cf17 false}, text_inputted = {\cf17 false};\par
10225     {\cf18 int}  mouse_button_changed = 0x00;\par
10226     ImBitArray<ImGuiKey_KeysData_SIZE> key_changed_mask;\par
10227 \par
10228     {\cf18 int} event_n = 0;\par
10229     {\cf19 for} (; event_n < g.InputEventsQueue.Size; event_n++)\par
10230     \{\par
10231         ImGuiInputEvent* e = &g.InputEventsQueue[event_n];\par
10232         {\cf19 if} (e->Type == ImGuiInputEventType_MousePos)\par
10233         \{\par
10234             {\cf19 if} (g.IO.WantSetMousePos)\par
10235                 {\cf19 continue};\par
10236             {\cf20 // Trickling Rule: Stop processing queued events if we already handled a mouse button change}\par
10237             ImVec2 event_pos(e->MousePos.PosX, e->MousePos.PosY);\par
10238             {\cf19 if} (trickle_fast_inputs && (mouse_button_changed != 0 || mouse_wheeled || key_changed || text_inputted))\par
10239                 {\cf19 break};\par
10240             io.MousePos = event_pos;\par
10241             io.MouseSource = e->MousePos.MouseSource;\par
10242             mouse_moved = {\cf17 true};\par
10243         \}\par
10244         {\cf19 else} {\cf19 if} (e->Type == ImGuiInputEventType_MouseButton)\par
10245         \{\par
10246             {\cf20 // Trickling Rule: Stop processing queued events if we got multiple action on the same button}\par
10247             {\cf17 const} ImGuiMouseButton button = e->MouseButton.Button;\par
10248             IM_ASSERT(button >= 0 && button < ImGuiMouseButton_COUNT);\par
10249             {\cf19 if} (trickle_fast_inputs && ((mouse_button_changed & (1 << button)) || mouse_wheeled))\par
10250                 {\cf19 break};\par
10251             {\cf19 if} (trickle_fast_inputs && e->MouseButton.MouseSource == ImGuiMouseSource_TouchScreen && mouse_moved) {\cf20 // #2702: TouchScreen have no initial hover.}\par
10252                 {\cf19 break};\par
10253             io.MouseDown[button] = e->MouseButton.Down;\par
10254             io.MouseSource = e->MouseButton.MouseSource;\par
10255             mouse_button_changed |= (1 << button);\par
10256         \}\par
10257         {\cf19 else} {\cf19 if} (e->Type == ImGuiInputEventType_MouseWheel)\par
10258         \{\par
10259             {\cf20 // Trickling Rule: Stop processing queued events if we got multiple action on the event}\par
10260             {\cf19 if} (trickle_fast_inputs && (mouse_moved || mouse_button_changed != 0))\par
10261                 {\cf19 break};\par
10262             io.MouseWheelH += e->MouseWheel.WheelX;\par
10263             io.MouseWheel += e->MouseWheel.WheelY;\par
10264             io.MouseSource = e->MouseWheel.MouseSource;\par
10265             mouse_wheeled = {\cf17 true};\par
10266         \}\par
10267         {\cf19 else} {\cf19 if} (e->Type == ImGuiInputEventType_MouseViewport)\par
10268         \{\par
10269             io.MouseHoveredViewport = e->MouseViewport.HoveredViewportID;\par
10270         \}\par
10271         {\cf19 else} {\cf19 if} (e->Type == ImGuiInputEventType_Key)\par
10272         \{\par
10273             {\cf20 // Trickling Rule: Stop processing queued events if we got multiple action on the same button}\par
10274             {\cf19 if} (io.ConfigFlags & ImGuiConfigFlags_NoKeyboard)\par
10275                 {\cf19 continue};\par
10276             ImGuiKey key = e->Key.Key;\par
10277             IM_ASSERT(key != ImGuiKey_None);\par
10278             ImGuiKeyData* key_data = GetKeyData(key);\par
10279             {\cf17 const} {\cf18 int} key_data_index = (int)(key_data - g.IO.KeysData);\par
10280             {\cf19 if} (trickle_fast_inputs && key_data->Down != e->Key.Down && (key_changed_mask.TestBit(key_data_index) || text_inputted || mouse_button_changed != 0))\par
10281                 {\cf19 break};\par
10282             key_data->Down = e->Key.Down;\par
10283             key_data->AnalogValue = e->Key.AnalogValue;\par
10284             key_changed = {\cf17 true};\par
10285             key_changed_mask.SetBit(key_data_index);\par
10286 \par
10287             {\cf20 // Allow legacy code using io.KeysDown[GetKeyIndex()] with new backends}\par
10288 {\cf21 #ifndef IMGUI_DISABLE_OBSOLETE_KEYIO}\par
10289             io.KeysDown[key_data_index] = key_data->Down;\par
10290             {\cf19 if} (io.KeyMap[key_data_index] != -1)\par
10291                 io.KeysDown[io.KeyMap[key_data_index]] = key_data->Down;\par
10292 {\cf21 #endif}\par
10293         \}\par
10294         {\cf19 else} {\cf19 if} (e->Type == ImGuiInputEventType_Text)\par
10295         \{\par
10296             {\cf19 if} (io.ConfigFlags & ImGuiConfigFlags_NoKeyboard)\par
10297                 {\cf19 continue};\par
10298             {\cf20 // Trickling Rule: Stop processing queued events if keys/mouse have been interacted with}\par
10299             {\cf19 if} (trickle_fast_inputs && ((key_changed && trickle_interleaved_keys_and_text) || mouse_button_changed != 0 || mouse_moved || mouse_wheeled))\par
10300                 {\cf19 break};\par
10301             {\cf18 unsigned} {\cf18 int} c = e->Text.Char;\par
10302             io.InputQueueCharacters.push_back(c <= IM_UNICODE_CODEPOINT_MAX ? (ImWchar)c : IM_UNICODE_CODEPOINT_INVALID);\par
10303             {\cf19 if} (trickle_interleaved_keys_and_text)\par
10304                 text_inputted = {\cf17 true};\par
10305         \}\par
10306         {\cf19 else} {\cf19 if} (e->Type == ImGuiInputEventType_Focus)\par
10307         \{\par
10308             {\cf20 // We intentionally overwrite this and process in NewFrame(), in order to give a chance}\par
10309             {\cf20 // to multi-viewports backends to queue AddFocusEvent(false) + AddFocusEvent(true) in same frame.}\par
10310             {\cf17 const} {\cf18 bool} focus_lost = !e->AppFocused.Focused;\par
10311             io.AppFocusLost = focus_lost;\par
10312         \}\par
10313         {\cf19 else}\par
10314         \{\par
10315             IM_ASSERT(0 && {\cf22 "Unknown event!"});\par
10316         \}\par
10317     \}\par
10318 \par
10319     {\cf20 // Record trail (for domain-specific applications wanting to access a precise trail)}\par
10320     {\cf20 //if (event_n != 0) IMGUI_DEBUG_LOG_IO("Processed: %d / Remaining: %d\\n", event_n, g.InputEventsQueue.Size - event_n);}\par
10321     {\cf19 for} ({\cf18 int} n = 0; n < event_n; n++)\par
10322         g.InputEventsTrail.push_back(g.InputEventsQueue[n]);\par
10323 \par
10324     {\cf20 // [DEBUG]}\par
10325 {\cf21 #ifndef IMGUI_DISABLE_DEBUG_TOOLS}\par
10326     {\cf19 if} (event_n != 0 && (g.DebugLogFlags & ImGuiDebugLogFlags_EventIO))\par
10327         {\cf19 for} ({\cf18 int} n = 0; n < g.InputEventsQueue.Size; n++)\par
10328             DebugPrintInputEvent(n < event_n ? {\cf22 "Processed"} : {\cf22 "Remaining"}, &g.InputEventsQueue[n]);\par
10329 {\cf21 #endif}\par
10330 \par
10331     {\cf20 // Remaining events will be processed on the next frame}\par
10332     {\cf19 if} (event_n == g.InputEventsQueue.Size)\par
10333         g.InputEventsQueue.resize(0);\par
10334     {\cf19 else}\par
10335         g.InputEventsQueue.erase(g.InputEventsQueue.Data, g.InputEventsQueue.Data + event_n);\par
10336 \par
10337     {\cf20 // Clear buttons state when focus is lost}\par
10338     {\cf20 // - this is useful so e.g. releasing Alt after focus loss on Alt-Tab doesn't trigger the Alt menu toggle.}\par
10339     {\cf20 // - we clear in EndFrame() and not now in order allow application/user code polling this flag}\par
10340     {\cf20 //   (e.g. custom backend may want to clear additional data, custom widgets may want to react with a "canceling" event).}\par
10341     {\cf19 if} (g.IO.AppFocusLost)\par
10342     \{\par
10343         g.IO.ClearInputKeys();\par
10344         g.IO.ClearInputMouse();\par
10345     \}\par
10346 \}\par
