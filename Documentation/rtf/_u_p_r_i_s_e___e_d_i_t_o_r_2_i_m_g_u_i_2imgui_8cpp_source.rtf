14817 {\cf17 static} {\cf18 void} WindowSettingsHandler_ReadLine(ImGuiContext*, ImGuiSettingsHandler*, {\cf18 void}* entry, {\cf17 const} {\cf18 char}* line)\par
14818 \{\par
14819     ImGuiWindowSettings* settings = (ImGuiWindowSettings*)entry;\par
14820     {\cf18 int} x, y;\par
14821     {\cf18 int} i;\par
14822     ImU32 u1;\par
14823     {\cf19 if} (sscanf(line, {\cf22 "Pos=%i,%i"}, &x, &y) == 2)             \{ settings->Pos = ImVec2ih(({\cf18 short})x, ({\cf18 short})y); \}\par
14824     {\cf19 else} {\cf19 if} (sscanf(line, {\cf22 "Size=%i,%i"}, &x, &y) == 2)       \{ settings->Size = ImVec2ih(({\cf18 short})x, ({\cf18 short})y); \}\par
14825     {\cf19 else} {\cf19 if} (sscanf(line, {\cf22 "ViewportId=0x%08X"}, &u1) == 1)   \{ settings->ViewportId = u1; \}\par
14826     {\cf19 else} {\cf19 if} (sscanf(line, {\cf22 "ViewportPos=%i,%i"}, &x, &y) == 2)\{ settings->ViewportPos = ImVec2ih(({\cf18 short})x, ({\cf18 short})y); \}\par
14827     {\cf19 else} {\cf19 if} (sscanf(line, {\cf22 "Collapsed=%d"}, &i) == 1)         \{ settings->Collapsed = (i != 0); \}\par
14828     {\cf19 else} {\cf19 if} (sscanf(line, {\cf22 "IsChild=%d"}, &i) == 1)           \{ settings->IsChild = (i != 0); \}\par
14829     {\cf19 else} {\cf19 if} (sscanf(line, {\cf22 "DockId=0x%X,%d"}, &u1, &i) == 2)  \{ settings->DockId = u1; settings->DockOrder = (short)i; \}\par
14830     {\cf19 else} {\cf19 if} (sscanf(line, {\cf22 "DockId=0x%X"}, &u1) == 1)         \{ settings->DockId = u1; settings->DockOrder = -1; \}\par
14831     {\cf19 else} {\cf19 if} (sscanf(line, {\cf22 "ClassId=0x%X"}, &u1) == 1)        \{ settings->ClassId = u1; \}\par
14832 \}\par
14833 \par
14834 {\cf20 // Apply to existing windows (if any)}\par
14835 {\cf17 static} {\cf18 void} WindowSettingsHandler_ApplyAll(ImGuiContext* ctx, ImGuiSettingsHandler*)\par
14836 \{\par
14837     ImGuiContext& g = *ctx;\par
14838     {\cf19 for} (ImGuiWindowSettings* settings = g.SettingsWindows.begin(); settings != NULL; settings = g.SettingsWindows.next_chunk(settings))\par
14839         {\cf19 if} (settings->WantApply)\par
14840         \{\par
14841             {\cf19 if} (ImGuiWindow* window = ImGui::FindWindowByID(settings->ID))\par
14842                 ApplyWindowSettings(window, settings);\par
14843             settings->WantApply = {\cf17 false};\par
14844         \}\par
14845 \}\par
14846 \par
14847 {\cf17 static} {\cf18 void} WindowSettingsHandler_WriteAll(ImGuiContext* ctx, ImGuiSettingsHandler* handler, ImGuiTextBuffer* buf)\par
14848 \{\par
14849     {\cf20 // Gather data from windows that were active during this session}\par
14850     {\cf20 // (if a window wasn't opened in this session we preserve its settings)}\par
14851     ImGuiContext& g = *ctx;\par
14852     {\cf19 for} (ImGuiWindow* window : g.Windows)\par
14853     \{\par
14854         {\cf19 if} (window->Flags & ImGuiWindowFlags_NoSavedSettings)\par
14855             {\cf19 continue};\par
14856 \par
14857         ImGuiWindowSettings* settings = ImGui::FindWindowSettingsByWindow(window);\par
14858         {\cf19 if} (!settings)\par
14859         \{\par
14860             settings = ImGui::CreateNewWindowSettings(window->Name);\par
14861             window->SettingsOffset = g.SettingsWindows.offset_from_ptr(settings);\par
14862         \}\par
14863         IM_ASSERT(settings->ID == window->ID);\par
14864         settings->Pos = ImVec2ih(window->Pos - window->ViewportPos);\par
14865         settings->Size = ImVec2ih(window->SizeFull);\par
14866         settings->ViewportId = window->ViewportId;\par
14867         settings->ViewportPos = ImVec2ih(window->ViewportPos);\par
14868         IM_ASSERT(window->DockNode == NULL || window->DockNode->ID == window->DockId);\par
14869         settings->DockId = window->DockId;\par
14870         settings->ClassId = window->WindowClass.ClassId;\par
14871         settings->DockOrder = window->DockOrder;\par
14872         settings->Collapsed = window->Collapsed;\par
14873         settings->IsChild = (window->RootWindow != window); {\cf20 // Cannot rely on ImGuiWindowFlags_ChildWindow here as docked windows have this set.}\par
14874         settings->WantDelete = {\cf17 false};\par
14875     \}\par
14876 \par
14877     {\cf20 // Write to text buffer}\par
14878     buf->reserve(buf->size() + g.SettingsWindows.size() * 6); {\cf20 // ballpark reserve}\par
14879     {\cf19 for} (ImGuiWindowSettings* settings = g.SettingsWindows.begin(); settings != NULL; settings = g.SettingsWindows.next_chunk(settings))\par
14880     \{\par
14881         {\cf19 if} (settings->WantDelete)\par
14882             {\cf19 continue};\par
14883         {\cf17 const} {\cf18 char}* settings_name = settings->GetName();\par
14884         buf->appendf({\cf22 "[%s][%s]\\n"}, handler->TypeName, settings_name);\par
14885         {\cf19 if} (settings->IsChild)\par
14886         \{\par
14887             buf->appendf({\cf22 "IsChild=1\\n"});\par
14888             buf->appendf({\cf22 "Size=%d,%d\\n"}, settings->Size.x, settings->Size.y);\par
14889         \}\par
14890         {\cf19 else}\par
14891         \{\par
14892             {\cf19 if} (settings->ViewportId != 0 && settings->ViewportId != ImGui::IMGUI_VIEWPORT_DEFAULT_ID)\par
14893             \{\par
14894                 buf->appendf({\cf22 "ViewportPos=%d,%d\\n"}, settings->ViewportPos.x, settings->ViewportPos.y);\par
14895                 buf->appendf({\cf22 "ViewportId=0x%08X\\n"}, settings->ViewportId);\par
14896             \}\par
14897             {\cf19 if} (settings->Pos.x != 0 || settings->Pos.y != 0 || settings->ViewportId == ImGui::IMGUI_VIEWPORT_DEFAULT_ID)\par
14898                 buf->appendf({\cf22 "Pos=%d,%d\\n"}, settings->Pos.x, settings->Pos.y);\par
14899             {\cf19 if} (settings->Size.x != 0 || settings->Size.y != 0)\par
14900                 buf->appendf({\cf22 "Size=%d,%d\\n"}, settings->Size.x, settings->Size.y);\par
14901             buf->appendf({\cf22 "Collapsed=%d\\n"}, settings->Collapsed);\par
14902             {\cf19 if} (settings->DockId != 0)\par
14903             \{\par
