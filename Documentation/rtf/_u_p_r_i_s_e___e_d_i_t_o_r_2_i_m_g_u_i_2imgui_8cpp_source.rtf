19914     \{\par
19915         {\cf18 int} buf_len = ::WideCharToMultiByte(CP_UTF8, 0, wbuf_global, -1, NULL, 0, NULL, NULL);\par
19916         g.ClipboardHandlerData.resize(buf_len);\par
19917         ::WideCharToMultiByte(CP_UTF8, 0, wbuf_global, -1, g.ClipboardHandlerData.Data, buf_len, NULL, NULL);\par
