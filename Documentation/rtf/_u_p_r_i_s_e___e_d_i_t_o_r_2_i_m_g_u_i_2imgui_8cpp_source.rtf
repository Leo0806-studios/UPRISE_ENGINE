13217     \}\par
13218 \par
13219     {\cf20 // [DEBUG] Always send a request when holding CTRL. Hold CTRL + Arrow change the direction.}\par
13220 {\cf21 #if IMGUI_DEBUG_NAV_SCORING}\par
13221     {\cf20 //if (io.KeyCtrl && IsKeyPressed(ImGuiKey_C))}\par
