09229 {\cf18 void} ImGui::GetTypematicRepeatRate(ImGuiInputFlags flags, {\cf18 float}* repeat_delay, {\cf18 float}* repeat_rate)\par
09230 \{\par
09231     ImGuiContext& g = *GImGui;\par
09232     {\cf19 switch} (flags & ImGuiInputFlags_RepeatRateMask_)\par
09233     \{\par
09234     {\cf19 case} ImGuiInputFlags_RepeatRateNavMove:             *repeat_delay = g.IO.KeyRepeatDelay * 0.72f; *repeat_rate = g.IO.KeyRepeatRate * 0.80f; {\cf19 return};\par
09235     {\cf19 case} ImGuiInputFlags_RepeatRateNavTweak:            *repeat_delay = g.IO.KeyRepeatDelay * 0.72f; *repeat_rate = g.IO.KeyRepeatRate * 0.30f; {\cf19 return};\par
09236     {\cf19 case} ImGuiInputFlags_RepeatRateDefault: {\cf19 default}:    *repeat_delay = g.IO.KeyRepeatDelay * 1.00f; *repeat_rate = g.IO.KeyRepeatRate * 1.00f; {\cf19 return};\par
09237     \}\par
09238 \}\par
