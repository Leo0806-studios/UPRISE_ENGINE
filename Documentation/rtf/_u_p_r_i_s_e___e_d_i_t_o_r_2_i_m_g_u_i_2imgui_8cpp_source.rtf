16487         ImGuiDockNode* node = DockContextFindNodeByID(ctx, window->DockId);\par
16488         IM_ASSERT(node != NULL);   {\cf20 // This should have been called after DockContextBuildNodesFromSettings()}\par
16489         {\cf19 if} (root_id == 0 || DockNodeGetRootNode(node)->ID == root_id)\par
16490             DockNodeAddWindow(node, window, {\cf17 true});\par
16491     \}\par
