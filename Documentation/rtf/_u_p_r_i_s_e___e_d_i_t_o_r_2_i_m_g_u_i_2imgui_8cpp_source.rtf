18939 {\cf18 void} ImGui::DockBuilderDockWindow({\cf17 const} {\cf18 char}* window_name, ImGuiID node_id)\par
18940 \{\par
18941     {\cf20 // We don't preserve relative order of multiple docked windows (by clearing DockOrder back to -1)}\par
18942     ImGuiContext& g = *GImGui; IM_UNUSED(g);\par
18943     IMGUI_DEBUG_LOG_DOCKING({\cf22 "[docking] DockBuilderDockWindow '%s' to node 0x%08X\\n"}, window_name, node_id);\par
