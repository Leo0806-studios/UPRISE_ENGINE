15391     {\cf19 if} (window != NULL)\par
15392     \{\par
15393         {\cf19 if} (g.MovingWindow && g.MovingWindow->RootWindowDockTree == window)\par
15394             flags |= ImGuiViewportFlags_NoInputs | ImGuiViewportFlags_NoFocusOnAppearing;\par
