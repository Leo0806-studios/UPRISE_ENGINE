19183 {\cf17 static} ImGuiDockNode* DockBuilderCopyNodeRec(ImGuiDockNode* src_node, ImGuiID dst_node_id_if_known, ImVector<ImGuiID>* out_node_remap_pairs)\par
19184 \{\par
19185     ImGuiContext& g = *GImGui;\par
19186     ImGuiDockNode* dst_node = ImGui::DockContextAddNode(&g, dst_node_id_if_known);\par
19187     dst_node->SharedFlags = src_node->SharedFlags;\par
19188     dst_node->LocalFlags = src_node->LocalFlags;\par
19189     dst_node->LocalFlagsInWindows = ImGuiDockNodeFlags_None;\par
19190     dst_node->Pos = src_node->Pos;\par
19191     dst_node->Size = src_node->Size;\par
19192     dst_node->SizeRef = src_node->SizeRef;\par
19193     dst_node->SplitAxis = src_node->SplitAxis;\par
19194     dst_node->UpdateMergedFlags();\par
19195 \par
19196     out_node_remap_pairs->push_back(src_node->ID);\par
19197     out_node_remap_pairs->push_back(dst_node->ID);\par
19198 \par
19199     {\cf19 for} ({\cf18 int} child_n = 0; child_n < IM_ARRAYSIZE(src_node->ChildNodes); child_n++)\par
19200         {\cf19 if} (src_node->ChildNodes[child_n])\par
19201         \{\par
19202             dst_node->ChildNodes[child_n] = DockBuilderCopyNodeRec(src_node->ChildNodes[child_n], 0, out_node_remap_pairs);\par
19203             dst_node->ChildNodes[child_n]->ParentNode = dst_node;\par
19204         \}\par
19205 \par
19206     IMGUI_DEBUG_LOG_DOCKING({\cf22 "[docking] Fork node %08X -> %08X (%d childs)\\n"}, src_node->ID, dst_node->ID, dst_node->IsSplitNode() ? 2 : 0);\par
19207     {\cf19 return} dst_node;\par
19208 \}\par
