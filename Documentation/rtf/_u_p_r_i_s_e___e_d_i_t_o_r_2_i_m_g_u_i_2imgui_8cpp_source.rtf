04833         {\cf19 if} (io.MouseClicked[i])\par
04834         \{\par
04835             io.MouseDownOwned[i] = (g.HoveredWindow != NULL) || has_open_popup;\par
04836             io.MouseDownOwnedUnlessPopupClose[i] = (g.HoveredWindow != NULL) || has_open_modal;\par
04837         \}\par
04838         mouse_any_down |= io.MouseDown[i];\par
04839         {\cf19 if} (io.MouseDown[i] || io.MouseReleased[i]) {\cf20 // Increase release frame for our evaluation of earliest button (#1392)}\par
04840             {\cf19 if} (mouse_earliest_down == -1 || io.MouseClickedTime[i] < io.MouseClickedTime[mouse_earliest_down])\par
04841                 mouse_earliest_down = i;\par
04842     \}\par
04843     {\cf17 const} {\cf18 bool} mouse_avail = (mouse_earliest_down == -1) || io.MouseDownOwned[mouse_earliest_down];\par
