16446 {\cf17 static} {\cf18 void} ImGui::DockContextBuildNodesFromSettings(ImGuiContext* ctx, ImGuiDockNodeSettings* node_settings_array, {\cf18 int} node_settings_count)\par
16447 \{\par
16448     {\cf20 // Build nodes}\par
16449     {\cf19 for} ({\cf18 int} node_n = 0; node_n < node_settings_count; node_n++)\par
16450     \{\par
16451         ImGuiDockNodeSettings* settings = &node_settings_array[node_n];\par
16452         {\cf19 if} (settings->ID == 0)\par
16453             {\cf19 continue};\par
16454         ImGuiDockNode* node = DockContextAddNode(ctx, settings->ID);\par
16455         node->ParentNode = settings->ParentNodeId ? DockContextFindNodeByID(ctx, settings->ParentNodeId) : NULL;\par
16456         node->Pos = ImVec2(settings->Pos.x, settings->Pos.y);\par
16457         node->Size = ImVec2(settings->Size.x, settings->Size.y);\par
16458         node->SizeRef = ImVec2(settings->SizeRef.x, settings->SizeRef.y);\par
16459         node->AuthorityForPos = node->AuthorityForSize = node->AuthorityForViewport = ImGuiDataAuthority_DockNode;\par
16460         {\cf19 if} (node->ParentNode && node->ParentNode->ChildNodes[0] == NULL)\par
16461             node->ParentNode->ChildNodes[0] = node;\par
16462         {\cf19 else} {\cf19 if} (node->ParentNode && node->ParentNode->ChildNodes[1] == NULL)\par
16463             node->ParentNode->ChildNodes[1] = node;\par
16464         node->SelectedTabId = settings->SelectedTabId;\par
16465         node->SplitAxis = (ImGuiAxis)settings->SplitAxis;\par
16466         node->SetLocalFlags(settings->Flags & ImGuiDockNodeFlags_SavedFlagsMask_);\par
16467 \par
16468         {\cf20 // Bind host window immediately if it already exist (in case of a rebuild)}\par
16469         {\cf20 // This is useful as the RootWindowForTitleBarHighlight links necessary to highlight the currently focused node requires node->HostWindow to be set.}\par
16470         {\cf18 char} host_window_title[20];\par
16471         ImGuiDockNode* root_node = DockNodeGetRootNode(node);\par
16472         node->HostWindow = FindWindowByName(DockNodeGetHostWindowTitle(root_node, host_window_title, IM_ARRAYSIZE(host_window_title)));\par
16473     \}\par
16474 \}\par
