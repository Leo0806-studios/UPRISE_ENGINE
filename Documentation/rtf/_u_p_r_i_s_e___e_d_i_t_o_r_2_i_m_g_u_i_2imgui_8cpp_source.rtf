03500 {\cf17 const} {\cf18 char}* ImGui::FindRenderedTextEnd({\cf17 const} {\cf18 char}* text, {\cf17 const} {\cf18 char}* text_end)\par
03501 \{\par
03502     {\cf17 const} {\cf18 char}* text_display_end = text;\par
03503     {\cf19 if} (!text_end)\par
03504         text_end = ({\cf17 const} {\cf18 char}*)-1;\par
03505 \par
03506     {\cf19 while} (text_display_end < text_end && *text_display_end != {\cf23 '\\0'} && (text_display_end[0] != {\cf23 '#'} || text_display_end[1] != {\cf23 '#'}))\par
03507         text_display_end++;\par
03508     {\cf19 return} text_display_end;\par
03509 \}\par
