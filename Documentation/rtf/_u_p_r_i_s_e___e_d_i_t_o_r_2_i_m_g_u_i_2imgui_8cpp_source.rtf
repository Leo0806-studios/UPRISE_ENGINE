14722 {\cf20 // Call registered handlers (e.g. SettingsHandlerWindow_WriteAll() + custom handlers) to write their stuff into a text buffer}\par
14723 {\cf17 const} {\cf18 char}* ImGui::SaveIniSettingsToMemory({\cf18 size_t}* out_size)\par
14724 \{\par
14725     ImGuiContext& g = *GImGui;\par
14726     g.SettingsDirtyTimer = 0.0f;\par
14727     g.SettingsIniData.Buf.resize(0);\par
14728     g.SettingsIniData.Buf.push_back(0);\par
14729     {\cf19 for} (ImGuiSettingsHandler& handler : g.SettingsHandlers)\par
14730         handler.WriteAllFn(&g, &handler, &g.SettingsIniData);\par
14731     {\cf19 if} (out_size)\par
14732         *out_size = (size_t)g.SettingsIniData.size();\par
14733     {\cf19 return} g.SettingsIniData.c_str();\par
14734 \}\par
