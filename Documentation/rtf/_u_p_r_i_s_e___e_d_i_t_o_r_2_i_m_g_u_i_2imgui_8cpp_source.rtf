11018 {\cf18 void} ImGui::ItemSize({\cf17 const} ImVec2& size, {\cf18 float} text_baseline_y)\par
11019 \{\par
11020     ImGuiContext& g = *GImGui;\par
11021     ImGuiWindow* window = g.CurrentWindow;\par
11022     {\cf19 if} (window->SkipItems)\par
11023         {\cf19 return};\par
11024 \par
11025     {\cf20 // We increase the height in this function to accommodate for baseline offset.}\par
11026     {\cf20 // In theory we should be offsetting the starting position (window->DC.CursorPos), that will be the topic of a larger refactor,}\par
11027     {\cf20 // but since ItemSize() is not yet an API that moves the cursor (to handle e.g. wrapping) enlarging the height has the same effect.}\par
11028     {\cf17 const} {\cf18 float} offset_to_match_baseline_y = (text_baseline_y >= 0) ? ImMax(0.0f, window->DC.CurrLineTextBaseOffset - text_baseline_y) : 0.0f;\par
11029 \par
11030     {\cf17 const} {\cf18 float} line_y1 = window->DC.IsSameLine ? window->DC.CursorPosPrevLine.y : window->DC.CursorPos.y;\par
11031     {\cf17 const} {\cf18 float} line_height = ImMax(window->DC.CurrLineSize.y, {\cf20 /*ImMax(*/}window->DC.CursorPos.y - line_y1{\cf20 /*, 0.0f)*/} + size.y + offset_to_match_baseline_y);\par
11032 \par
11033     {\cf20 // Always align ourselves on pixel boundaries}\par
11034     {\cf20 //if (g.IO.KeyAlt) window->DrawList->AddRect(window->DC.CursorPos, window->DC.CursorPos + ImVec2(size.x, line_height), IM_COL32(255,0,0,200)); // [DEBUG]}\par
11035     window->DC.CursorPosPrevLine.x = window->DC.CursorPos.x + size.x;\par
11036     window->DC.CursorPosPrevLine.y = line_y1;\par
11037     window->DC.CursorPos.x = IM_TRUNC(window->Pos.x + window->DC.Indent.x + window->DC.ColumnsOffset.x);    {\cf20 // Next line}\par
11038     window->DC.CursorPos.y = IM_TRUNC(line_y1 + line_height + g.Style.ItemSpacing.y);                       {\cf20 // Next line}\par
11039     window->DC.CursorMaxPos.x = ImMax(window->DC.CursorMaxPos.x, window->DC.CursorPosPrevLine.x);\par
11040     window->DC.CursorMaxPos.y = ImMax(window->DC.CursorMaxPos.y, window->DC.CursorPos.y - g.Style.ItemSpacing.y);\par
11041     {\cf20 //if (g.IO.KeyAlt) window->DrawList->AddCircle(window->DC.CursorMaxPos, 3.0f, IM_COL32(255,0,0,255), 4); // [DEBUG]}\par
11042 \par
11043     window->DC.PrevLineSize.y = line_height;\par
11044     window->DC.CurrLineSize.y = 0.0f;\par
11045     window->DC.PrevLineTextBaseOffset = ImMax(window->DC.CurrLineTextBaseOffset, text_baseline_y);\par
11046     window->DC.CurrLineTextBaseOffset = 0.0f;\par
11047     window->DC.IsSameLine = window->DC.IsSetPos = {\cf17 false};\par
11048 \par
11049     {\cf20 // Horizontal layout mode}\par
