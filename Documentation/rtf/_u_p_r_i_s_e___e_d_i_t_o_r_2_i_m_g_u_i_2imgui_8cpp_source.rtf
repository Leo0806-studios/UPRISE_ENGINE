03403 {\cf18 void} ImGui::PopStyleVar({\cf18 int} count)\par
03404 \{\par
03405     ImGuiContext& g = *GImGui;\par
03406     {\cf19 if} (g.StyleVarStack.Size < count)\par
03407     \{\par
03408         IM_ASSERT_USER_ERROR(g.StyleVarStack.Size > count, {\cf22 "Calling PopStyleVar() too many times!"});\par
03409         count = g.StyleVarStack.Size;\par
03410     \}\par
03411     {\cf19 while} (count > 0)\par
03412     \{\par
03413         {\cf20 // We avoid a generic memcpy(data, &backup.Backup.., GDataTypeSize[info->Type] * info->Count), the overhead in Debug is not worth it.}\par
03414         ImGuiStyleMod& backup = g.StyleVarStack.back();\par
03415         {\cf17 const} ImGuiDataVarInfo* info = GetStyleVarInfo(backup.VarIdx);\par
03416         {\cf18 void}* data = info->GetVarPtr(&g.Style);\par
03417         {\cf19 if} (info->Type == ImGuiDataType_Float && info->Count == 1)      \{ (({\cf18 float}*)data)[0] = backup.BackupFloat[0]; \}\par
03418         {\cf19 else} {\cf19 if} (info->Type == ImGuiDataType_Float && info->Count == 2) \{ (({\cf18 float}*)data)[0] = backup.BackupFloat[0]; (({\cf18 float}*)data)[1] = backup.BackupFloat[1]; \}\par
03419         g.StyleVarStack.pop_back();\par
03420         count--;\par
03421     \}\par
03422 \}\par
