06566     {\cf19 if} (pos_target.y != FLT_MAX && window->Pos.y != ImTrunc(pos_target.y))\par
06567         window->Pos.y = ImTrunc(pos_target.y);\par
06568     {\cf19 if} (curr_pos.x != window->Pos.x || curr_pos.y != window->Pos.y || curr_size.x != window->SizeFull.x || curr_size.y != window->SizeFull.y)\par
06569         MarkIniSettingsDirty(window);\par
06570 \par
06571     {\cf20 // Recalculate next expected border expected coordinates}\par
06572     {\cf19 if} (*border_held != -1)\par
06573         g.WindowResizeBorderExpectedRect = GetResizeBorderRect(window, *border_held, grip_hover_inner_size, WINDOWS_HOVER_PADDING);\par
06574 \par
06575     {\cf19 return} ret_auto_fit_mask;\par
06576 \}\par
