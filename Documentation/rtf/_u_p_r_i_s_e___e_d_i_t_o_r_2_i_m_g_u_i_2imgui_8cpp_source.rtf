17981 {\cf17 static} {\cf18 bool} DockNodeIsDropAllowedOne(ImGuiWindow* payload, ImGuiWindow* host_window)\par
17982 \{\par
17983     {\cf19 if} (host_window->DockNodeAsHost && host_window->DockNodeAsHost->IsDockSpace() && payload->BeginOrderWithinContext < host_window->BeginOrderWithinContext)\par
17984         {\cf19 return} {\cf17 false};\par
17985 \par
17986     ImGuiWindowClass* host_class = host_window->DockNodeAsHost ? &host_window->DockNodeAsHost->WindowClass : &host_window->WindowClass;\par
17987     ImGuiWindowClass* payload_class = &payload->WindowClass;\par
17988     {\cf19 if} (host_class->ClassId != payload_class->ClassId)\par
17989     \{\par
17990         {\cf18 bool} pass = {\cf17 false};\par
17991         {\cf19 if} (host_class->ClassId != 0 && host_class->DockingAllowUnclassed && payload_class->ClassId == 0)\par
17992             pass = {\cf17 true};\par
17993         {\cf19 if} (payload_class->ClassId != 0 && payload_class->DockingAllowUnclassed && host_class->ClassId == 0)\par
17994             pass = {\cf17 true};\par
17995         {\cf19 if} (!pass)\par
17996             {\cf19 return} {\cf17 false};\par
17997     \}\par
17998 \par
17999     {\cf20 // Prevent docking any window created above a popup}\par
18000     {\cf20 // Technically we should support it (e.g. in the case of a long-lived modal window that had fancy docking features),}\par
18001     {\cf20 // by e.g. adding a 'if (!ImGui::IsWindowWithinBeginStackOf(host_window, popup_window))' test.}\par
18002     {\cf20 // But it would requires more work on our end because the dock host windows is technically created in NewFrame()}\par
18003     {\cf20 // and our ->ParentXXX and ->RootXXX pointers inside windows are currently mislading or lacking.}\par
18004     ImGuiContext& g = *GImGui;\par
18005     {\cf19 for} ({\cf18 int} i = g.OpenPopupStack.Size - 1; i >= 0; i--)\par
18006         {\cf19 if} (ImGuiWindow* popup_window = g.OpenPopupStack[i].Window)\par
18007             {\cf19 if} (ImGui::IsWindowWithinBeginStackOf(payload, popup_window))   {\cf20 // Payload is created from within a popup begin stack.}\par
18008                 {\cf19 return} {\cf17 false};\par
18009 \par
18010     {\cf19 return} {\cf17 true};\par
18011 \}\par
