06131 {\cf17 static} {\cf17 inline} ImVec2 CalcWindowMinSize(ImGuiWindow* window)\par
06132 \{\par
06133     {\cf20 // We give windows non-zero minimum size to facilitate understanding problematic cases (e.g. empty popups)}\par
06134     {\cf20 // FIXME: Essentially we want to restrict manual resizing to WindowMinSize+Decoration, and allow api resizing to be smaller.}\par
06135     {\cf20 // Perhaps should tend further a neater test for this.}\par
06136     ImGuiContext& g = *GImGui;\par
06137     ImVec2 size_min;\par
06138     {\cf19 if} ((window->Flags & ImGuiWindowFlags_ChildWindow) && !(window->Flags & ImGuiWindowFlags_Popup))\par
06139     \{\par
06140         size_min.x = (window->ChildFlags & ImGuiChildFlags_ResizeX) ? g.Style.WindowMinSize.x : 4.0f;\par
06141         size_min.y = (window->ChildFlags & ImGuiChildFlags_ResizeY) ? g.Style.WindowMinSize.y : 4.0f;\par
06142     \}\par
06143     {\cf19 else}\par
06144     \{\par
06145         size_min.x = ((window->Flags & ImGuiWindowFlags_AlwaysAutoResize) == 0) ? g.Style.WindowMinSize.x : 4.0f;\par
06146         size_min.y = ((window->Flags & ImGuiWindowFlags_AlwaysAutoResize) == 0) ? g.Style.WindowMinSize.y : 4.0f;\par
06147     \}\par
06148 \par
06149     {\cf20 // Reduce artifacts with very small windows}\par
06150     ImGuiWindow* window_for_height = GetWindowForTitleAndMenuHeight(window);\par
06151     size_min.y = ImMax(size_min.y, window_for_height->TitleBarHeight + window_for_height->MenuBarHeight + ImMax(0.0f, g.Style.WindowRounding - 1.0f));\par
06152     {\cf19 return} size_min;\par
06153 \}\par
06154 \par
06155 {\cf17 static} ImVec2 CalcWindowSizeAfterConstraint(ImGuiWindow* window, {\cf17 const} ImVec2& size_desired)\par
06156 \{\par
06157     ImGuiContext& g = *GImGui;\par
06158     ImVec2 new_size = size_desired;\par
06159     {\cf19 if} (g.NextWindowData.Flags & ImGuiNextWindowDataFlags_HasSizeConstraint)\par
06160     \{\par
06161         {\cf20 // See comments in SetNextWindowSizeConstraints() for details about setting size_min an size_max.}\par
06162         ImRect cr = g.NextWindowData.SizeConstraintRect;\par
06163         new_size.x = (cr.Min.x >= 0 && cr.Max.x >= 0) ? ImClamp(new_size.x, cr.Min.x, cr.Max.x) : window->SizeFull.x;\par
06164         new_size.y = (cr.Min.y >= 0 && cr.Max.y >= 0) ? ImClamp(new_size.y, cr.Min.y, cr.Max.y) : window->SizeFull.y;\par
06165         {\cf19 if} (g.NextWindowData.SizeCallback)\par
06166         \{\par
06167             ImGuiSizeCallbackData data;\par
06168             data.UserData = g.NextWindowData.SizeCallbackUserData;\par
06169             data.Pos = window->Pos;\par
06170             data.CurrentSize = window->SizeFull;\par
06171             data.DesiredSize = new_size;\par
06172             g.NextWindowData.SizeCallback(&data);\par
06173             new_size = data.DesiredSize;\par
06174         \}\par
06175         new_size.x = IM_TRUNC(new_size.x);\par
06176         new_size.y = IM_TRUNC(new_size.y);\par
06177     \}\par
06178 \par
06179     {\cf20 // Minimum size}\par
06180     ImVec2 size_min = CalcWindowMinSize(window);\par
06181     {\cf19 return} ImMax(new_size, size_min);\par
06182 \}\par
06183 \par
06184 {\cf17 static} {\cf18 void} CalcWindowContentSizes(ImGuiWindow* window, ImVec2* content_size_current, ImVec2* content_size_ideal)\par
06185 \{\par
06186     {\cf18 bool} preserve_old_content_sizes = {\cf17 false};\par
06187     {\cf19 if} (window->Collapsed && window->AutoFitFramesX <= 0 && window->AutoFitFramesY <= 0)\par
06188         preserve_old_content_sizes = {\cf17 true};\par
06189     {\cf19 else} {\cf19 if} (window->Hidden && window->HiddenFramesCannotSkipItems == 0 && window->HiddenFramesCanSkipItems > 0)\par
06190         preserve_old_content_sizes = {\cf17 true};\par
06191     {\cf19 if} (preserve_old_content_sizes)\par
06192     \{\par
06193         *content_size_current = window->ContentSize;\par
06194         *content_size_ideal = window->ContentSizeIdeal;\par
06195         {\cf19 return};\par
06196     \}\par
06197 \par
06198     content_size_current->x = (window->ContentSizeExplicit.x != 0.0f) ? window->ContentSizeExplicit.x : IM_TRUNC(window->DC.CursorMaxPos.x - window->DC.CursorStartPos.x);\par
06199     content_size_current->y = (window->ContentSizeExplicit.y != 0.0f) ? window->ContentSizeExplicit.y : IM_TRUNC(window->DC.CursorMaxPos.y - window->DC.CursorStartPos.y);\par
06200     content_size_ideal->x = (window->ContentSizeExplicit.x != 0.0f) ? window->ContentSizeExplicit.x : IM_TRUNC(ImMax(window->DC.CursorMaxPos.x, window->DC.IdealMaxPos.x) - window->DC.CursorStartPos.x);\par
06201     content_size_ideal->y = (window->ContentSizeExplicit.y != 0.0f) ? window->ContentSizeExplicit.y : IM_TRUNC(ImMax(window->DC.CursorMaxPos.y, window->DC.IdealMaxPos.y) - window->DC.CursorStartPos.y);\par
06202 \}\par
06203 \par
06204 {\cf17 static} ImVec2 CalcWindowAutoFitSize(ImGuiWindow* window, {\cf17 const} ImVec2& size_contents)\par
06205 \{\par
06206     ImGuiContext& g = *GImGui;\par
06207     ImGuiStyle& style = g.Style;\par
06208     {\cf17 const} {\cf18 float} decoration_w_without_scrollbars = window->DecoOuterSizeX1 + window->DecoOuterSizeX2 - window->ScrollbarSizes.x;\par
06209     {\cf17 const} {\cf18 float} decoration_h_without_scrollbars = window->DecoOuterSizeY1 + window->DecoOuterSizeY2 - window->ScrollbarSizes.y;\par
06210     ImVec2 size_pad = window->WindowPadding * 2.0f;\par
06211     ImVec2 size_desired = size_contents + size_pad + ImVec2(decoration_w_without_scrollbars, decoration_h_without_scrollbars);\par
06212     {\cf19 if} (window->Flags & ImGuiWindowFlags_Tooltip)\par
06213     \{\par
06214         {\cf20 // Tooltip always resize}\par
06215         {\cf19 return} size_desired;\par
06216     \}\par
06217     {\cf19 else}\par
06218     \{\par
06219         {\cf20 // Maximum window size is determined by the viewport size or monitor size}\par
06220         ImVec2 size_min = CalcWindowMinSize(window);\par
06221         ImVec2 size_max = ImVec2(FLT_MAX, FLT_MAX);\par
06222 \par
06223         {\cf20 // Child windows are layed within their parent (unless they are also popups/menus) and thus have no restriction}\par
06224         {\cf19 if} ((window->Flags & ImGuiWindowFlags_ChildWindow) == 0 || (window->Flags & ImGuiWindowFlags_Popup) != 0)\par
06225         \{\par
06226             {\cf19 if} (!window->ViewportOwned)\par
06227                 size_max = ImGui::GetMainViewport()->WorkSize - style.DisplaySafeAreaPadding * 2.0f;\par
06228             {\cf17 const} {\cf18 int} monitor_idx = window->ViewportAllowPlatformMonitorExtend;\par
06229             {\cf19 if} (monitor_idx >= 0 && monitor_idx < g.PlatformIO.Monitors.Size)\par
06230                 size_max = g.PlatformIO.Monitors[monitor_idx].WorkSize - style.DisplaySafeAreaPadding * 2.0f;\par
06231         \}\par
06232 \par
06233         ImVec2 size_auto_fit = ImClamp(size_desired, size_min, ImMax(size_min, size_max));\par
06234 \par
06235         {\cf20 // FIXME: CalcWindowAutoFitSize() doesn't take into account that only one axis may be auto-fit when calculating scrollbars,}\par
06236         {\cf20 // we may need to compute/store three variants of size_auto_fit, for x/y/xy.}\par
06237         {\cf20 // Here we implement a workaround for child windows only, but a full solution would apply to normal windows as well:}\par
06238         {\cf19 if} ((window->ChildFlags & ImGuiChildFlags_ResizeX) && !(window->ChildFlags & ImGuiChildFlags_ResizeY))\par
06239             size_auto_fit.y = window->SizeFull.y;\par
06240         {\cf19 else} {\cf19 if} (!(window->ChildFlags & ImGuiChildFlags_ResizeX) && (window->ChildFlags & ImGuiChildFlags_ResizeY))\par
06241             size_auto_fit.x = window->SizeFull.x;\par
06242 \par
06243         {\cf20 // When the window cannot fit all contents (either because of constraints, either because screen is too small),}\par
06244         {\cf20 // we are growing the size on the other axis to compensate for expected scrollbar. FIXME: Might turn bigger than ViewportSize-WindowPadding.}\par
06245         ImVec2 size_auto_fit_after_constraint = CalcWindowSizeAfterConstraint(window, size_auto_fit);\par
06246         {\cf18 bool} will_have_scrollbar_x = (size_auto_fit_after_constraint.x - size_pad.x - decoration_w_without_scrollbars < size_contents.x && !(window->Flags & ImGuiWindowFlags_NoScrollbar) && (window->Flags & ImGuiWindowFlags_HorizontalScrollbar)) || (window->Flags & ImGuiWindowFlags_AlwaysHorizontalScrollbar);\par
06247         {\cf18 bool} will_have_scrollbar_y = (size_auto_fit_after_constraint.y - size_pad.y - decoration_h_without_scrollbars < size_contents.y && !(window->Flags & ImGuiWindowFlags_NoScrollbar)) || (window->Flags & ImGuiWindowFlags_AlwaysVerticalScrollbar);\par
06248         {\cf19 if} (will_have_scrollbar_x)\par
06249             size_auto_fit.y += style.ScrollbarSize;\par
06250         {\cf19 if} (will_have_scrollbar_y)\par
06251             size_auto_fit.x += style.ScrollbarSize;\par
06252         {\cf19 return} size_auto_fit;\par
06253     \}\par
06254 \}\par
06255 \par
06256 ImVec2 ImGui::CalcWindowNextAutoFitSize(ImGuiWindow* window)\par
06257 \{\par
06258     ImVec2 size_contents_current;\par
06259     ImVec2 size_contents_ideal;\par
06260     CalcWindowContentSizes(window, &size_contents_current, &size_contents_ideal);\par
06261     ImVec2 size_auto_fit = CalcWindowAutoFitSize(window, size_contents_ideal);\par
06262     ImVec2 size_final = CalcWindowSizeAfterConstraint(window, size_auto_fit);\par
06263     {\cf19 return} size_final;\par
06264 \}\par
