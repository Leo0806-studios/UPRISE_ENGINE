13228         g.NavMoveFlags |= ImGuiNavMoveFlags_DebugNoResult;\par
13229     \}\par
13230 {\cf21 #endif}\par
13231 \par
13232     {\cf20 // Submit}\par
13233     g.NavMoveForwardToNextFrame = {\cf17 false};\par
13234     {\cf19 if} (g.NavMoveDir != ImGuiDir_None)\par
13235         NavMoveRequestSubmit(g.NavMoveDir, g.NavMoveClipDir, g.NavMoveFlags, g.NavMoveScrollFlags);\par
13236 \par
