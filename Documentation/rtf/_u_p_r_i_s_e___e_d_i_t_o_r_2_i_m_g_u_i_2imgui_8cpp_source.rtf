06275 {\cf17 static} {\cf18 void} CalcResizePosSizeFromAnyCorner(ImGuiWindow* window, {\cf17 const} ImVec2& corner_target, {\cf17 const} ImVec2& corner_norm, ImVec2* out_pos, ImVec2* out_size)\par
06276 \{\par
06277     ImVec2 pos_min = ImLerp(corner_target, window->Pos, corner_norm);                {\cf20 // Expected window upper-left}\par
06278     ImVec2 pos_max = ImLerp(window->Pos + window->Size, corner_target, corner_norm); {\cf20 // Expected window lower-right}\par
06279     ImVec2 size_expected = pos_max - pos_min;\par
06280     ImVec2 size_constrained = CalcWindowSizeAfterConstraint(window, size_expected);\par
06281     *out_pos = pos_min;\par
06282     {\cf19 if} (corner_norm.x == 0.0f)\par
06283         out_pos->x -= (size_constrained.x - size_expected.x);\par
06284     {\cf19 if} (corner_norm.y == 0.0f)\par
06285         out_pos->y -= (size_constrained.y - size_expected.y);\par
06286     *out_size = size_constrained;\par
06287 \}\par
