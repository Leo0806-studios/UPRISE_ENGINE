04241 {\cf18 bool} ImGui::IsItemHovered(ImGuiHoveredFlags flags)\par
04242 \{\par
04243     ImGuiContext& g = *GImGui;\par
04244     ImGuiWindow* window = g.CurrentWindow;\par
04245     IM_ASSERT((flags & ~ImGuiHoveredFlags_AllowedMaskForIsItemHovered) == 0 && {\cf22 "Invalid flags for IsItemHovered()!"});\par
04246 \par
04247     {\cf19 if} (g.NavDisableMouseHover && !g.NavDisableHighlight && !(flags & ImGuiHoveredFlags_NoNavOverride))\par
04248     \{\par
04249         {\cf19 if} ((g.LastItemData.InFlags & ImGuiItemFlags_Disabled) && !(flags & ImGuiHoveredFlags_AllowWhenDisabled))\par
04250             {\cf19 return} {\cf17 false};\par
04251         {\cf19 if} (!IsItemFocused())\par
04252             {\cf19 return} {\cf17 false};\par
04253 \par
04254         {\cf19 if} (flags & ImGuiHoveredFlags_ForTooltip)\par
04255             flags = ApplyHoverFlagsForTooltip(flags, g.Style.HoverFlagsForTooltipNav);\par
04256     \}\par
04257     {\cf19 else}\par
04258     \{\par
04259         {\cf20 // Test for bounding box overlap, as updated as ItemAdd()}\par
04260         ImGuiItemStatusFlags status_flags = g.LastItemData.StatusFlags;\par
04261         {\cf19 if} (!(status_flags & ImGuiItemStatusFlags_HoveredRect))\par
04262             {\cf19 return} {\cf17 false};\par
04263 \par
04264         {\cf19 if} (flags & ImGuiHoveredFlags_ForTooltip)\par
04265             flags = ApplyHoverFlagsForTooltip(flags, g.Style.HoverFlagsForTooltipMouse);\par
04266 \par
04267         IM_ASSERT((flags & (ImGuiHoveredFlags_AnyWindow | ImGuiHoveredFlags_RootWindow | ImGuiHoveredFlags_ChildWindows | ImGuiHoveredFlags_NoPopupHierarchy | ImGuiHoveredFlags_DockHierarchy)) == 0);   {\cf20 // Flags not supported by this function}\par
04268 \par
04269         {\cf20 // Done with rectangle culling so we can perform heavier checks now}\par
04270         {\cf20 // Test if we are hovering the right window (our window could be behind another window)}\par
04271         {\cf20 // [2021/03/02] Reworked / reverted the revert, finally. Note we want e.g. BeginGroup/ItemAdd/EndGroup to work as well. (#3851)}\par
04272         {\cf20 // [2017/10/16] Reverted commit 344d48be3 and testing RootWindow instead. I believe it is correct to NOT test for RootWindow but this leaves us unable}\par
04273         {\cf20 // to use IsItemHovered() after EndChild() itself. Until a solution is found I believe reverting to the test from 2017/09/27 is safe since this was}\par
04274         {\cf20 // the test that has been running for a long while.}\par
04275         {\cf19 if} (g.HoveredWindow != window && (status_flags & ImGuiItemStatusFlags_HoveredWindow) == 0)\par
04276             {\cf19 if} ((flags & ImGuiHoveredFlags_AllowWhenOverlappedByWindow) == 0)\par
04277                 {\cf19 return} {\cf17 false};\par
04278 \par
04279         {\cf20 // Test if another item is active (e.g. being dragged)}\par
04280         {\cf17 const} ImGuiID {\cf18 id} = g.LastItemData.ID;\par
04281         {\cf19 if} ((flags & ImGuiHoveredFlags_AllowWhenBlockedByActiveItem) == 0)\par
04282             {\cf19 if} (g.ActiveId != 0 && g.ActiveId != {\cf18 id} && !g.ActiveIdAllowOverlap)\par
04283                 {\cf19 if} (g.ActiveId != window->MoveId && g.ActiveId != window->TabId)\par
04284                     {\cf19 return} {\cf17 false};\par
04285 \par
04286         {\cf20 // Test if interactions on this window are blocked by an active popup or modal.}\par
04287         {\cf20 // The ImGuiHoveredFlags_AllowWhenBlockedByPopup flag will be tested here.}\par
04288         {\cf19 if} (!IsWindowContentHoverable(window, flags) && !(g.LastItemData.InFlags & ImGuiItemFlags_NoWindowHoverableCheck))\par
04289             {\cf19 return} {\cf17 false};\par
04290 \par
04291         {\cf20 // Test if the item is disabled}\par
04292         {\cf19 if} ((g.LastItemData.InFlags & ImGuiItemFlags_Disabled) && !(flags & ImGuiHoveredFlags_AllowWhenDisabled))\par
04293             {\cf19 return} {\cf17 false};\par
04294 \par
04295         {\cf20 // Special handling for calling after Begin() which represent the title bar or tab.}\par
04296         {\cf20 // When the window is skipped/collapsed (SkipItems==true) that last item (always ->MoveId submitted by Begin)}\par
04297         {\cf20 // will never be overwritten so we need to detect the case.}\par
04298         {\cf19 if} ({\cf18 id} == window->MoveId && window->WriteAccessed)\par
04299             {\cf19 return} {\cf17 false};\par
04300 \par
04301         {\cf20 // Test if using AllowOverlap and overlapped}\par
04302         {\cf19 if} ((g.LastItemData.InFlags & ImGuiItemFlags_AllowOverlap) && {\cf18 id} != 0)\par
04303             {\cf19 if} ((flags & ImGuiHoveredFlags_AllowWhenOverlappedByItem) == 0)\par
04304                 {\cf19 if} (g.HoveredIdPreviousFrame != g.LastItemData.ID)\par
04305                     {\cf19 return} {\cf17 false};\par
04306     \}\par
04307 \par
04308     {\cf20 // Handle hover delay}\par
04309     {\cf20 // (some ideas: https://www.nngroup.com/articles/timing-exposing-content)}\par
04310     {\cf17 const} {\cf18 float} delay = CalcDelayFromHoveredFlags(flags);\par
04311     {\cf19 if} (delay > 0.0f || (flags & ImGuiHoveredFlags_Stationary))\par
04312     \{\par
04313         ImGuiID hover_delay_id = (g.LastItemData.ID != 0) ? g.LastItemData.ID : window->GetIDFromRectangle(g.LastItemData.Rect);\par
04314         {\cf19 if} ((flags & ImGuiHoveredFlags_NoSharedDelay) && (g.HoverItemDelayIdPreviousFrame != hover_delay_id))\par
04315             g.HoverItemDelayTimer = 0.0f;\par
04316         g.HoverItemDelayId = hover_delay_id;\par
04317 \par
04318         {\cf20 // When changing hovered item we requires a bit of stationary delay before activating hover timer,}\par
04319         {\cf20 // but once unlocked on a given item we also moving.}\par
04320         {\cf20 //if (g.HoverDelayTimer >= delay && (g.HoverDelayTimer - g.IO.DeltaTime < delay || g.MouseStationaryTimer - g.IO.DeltaTime < g.Style.HoverStationaryDelay)) \{ IMGUI_DEBUG_LOG("HoverDelayTimer = %f/%f, MouseStationaryTimer = %f\\n", g.HoverDelayTimer, delay, g.MouseStationaryTimer); \}}\par
04321         {\cf19 if} ((flags & ImGuiHoveredFlags_Stationary) != 0 && g.HoverItemUnlockedStationaryId != hover_delay_id)\par
04322             {\cf19 return} {\cf17 false};\par
04323 \par
04324         {\cf19 if} (g.HoverItemDelayTimer < delay)\par
04325             {\cf19 return} {\cf17 false};\par
04326     \}\par
04327 \par
04328     {\cf19 return} {\cf17 true};\par
04329 \}\par
