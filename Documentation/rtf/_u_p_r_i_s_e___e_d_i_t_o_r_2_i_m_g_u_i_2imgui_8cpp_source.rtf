12393 {\cf17 static} {\cf18 float} {\cf17 inline} NavScoreItemDistInterval({\cf18 float} cand_min, {\cf18 float} cand_max, {\cf18 float} curr_min, {\cf18 float} curr_max)\par
12394 \{\par
12395     {\cf19 if} (cand_max < curr_min)\par
12396         {\cf19 return} cand_max - curr_min;\par
12397     {\cf19 if} (curr_max < cand_min)\par
12398         {\cf19 return} cand_min - curr_max;\par
12399     {\cf19 return} 0.0f;\par
12400 \}\par
12401 \par
12402 {\cf20 // Scoring function for gamepad/keyboard directional navigation. Based on https://gist.github.com/rygorous/6981057}\par
12403 {\cf17 static} {\cf18 bool} ImGui::NavScoreItem(ImGuiNavItemData* result)\par
12404 \{\par
12405     ImGuiContext& g = *GImGui;\par
12406     ImGuiWindow* window = g.CurrentWindow;\par
12407     {\cf19 if} (g.NavLayer != window->DC.NavLayerCurrent)\par
12408         {\cf19 return} {\cf17 false};\par
12409 \par
12410     {\cf20 // FIXME: Those are not good variables names}\par
12411     ImRect cand = g.LastItemData.NavRect;   {\cf20 // Current item nav rectangle}\par
12412     {\cf17 const} ImRect curr = g.NavScoringRect;   {\cf20 // Current modified source rect (NB: we've applied Max.x = Min.x in NavUpdate() to inhibit the effect of having varied item width)}\par
12413     g.NavScoringDebugCount++;\par
12414 \par
12415     {\cf20 // When entering through a NavFlattened border, we consider child window items as fully clipped for scoring}\par
12416     {\cf19 if} (window->ParentWindow == g.NavWindow)\par
12417     \{\par
12418         IM_ASSERT((window->ChildFlags | g.NavWindow->ChildFlags) & ImGuiChildFlags_NavFlattened);\par
12419         {\cf19 if} (!window->ClipRect.Overlaps(cand))\par
12420             {\cf19 return} {\cf17 false};\par
12421         cand.ClipWithFull(window->ClipRect); {\cf20 // This allows the scored item to not overlap other candidates in the parent window}\par
12422     \}\par
12423 \par
12424     {\cf20 // Compute distance between boxes}\par
12425     {\cf20 // FIXME-NAV: Introducing biases for vertical navigation, needs to be removed.}\par
12426     {\cf18 float} dbx = NavScoreItemDistInterval(cand.Min.x, cand.Max.x, curr.Min.x, curr.Max.x);\par
12427     {\cf18 float} dby = NavScoreItemDistInterval(ImLerp(cand.Min.y, cand.Max.y, 0.2f), ImLerp(cand.Min.y, cand.Max.y, 0.8f), ImLerp(curr.Min.y, curr.Max.y, 0.2f), ImLerp(curr.Min.y, curr.Max.y, 0.8f)); {\cf20 // Scale down on Y to keep using box-distance for vertically touching items}\par
12428     {\cf19 if} (dby != 0.0f && dbx != 0.0f)\par
12429         dbx = (dbx / 1000.0f) + ((dbx > 0.0f) ? +1.0f : -1.0f);\par
12430     {\cf18 float} dist_box = ImFabs(dbx) + ImFabs(dby);\par
12431 \par
12432     {\cf20 // Compute distance between centers (this is off by a factor of 2, but we only compare center distances with each other so it doesn't matter)}\par
12433     {\cf18 float} dcx = (cand.Min.x + cand.Max.x) - (curr.Min.x + curr.Max.x);\par
12434     {\cf18 float} dcy = (cand.Min.y + cand.Max.y) - (curr.Min.y + curr.Max.y);\par
12435     {\cf18 float} dist_center = ImFabs(dcx) + ImFabs(dcy); {\cf20 // L1 metric (need this for our connectedness guarantee)}\par
12436 \par
12437     {\cf20 // Determine which quadrant of 'curr' our candidate item 'cand' lies in based on distance}\par
12438     ImGuiDir quadrant;\par
12439     {\cf18 float} dax = 0.0f, day = 0.0f, dist_axial = 0.0f;\par
12440     {\cf19 if} (dbx != 0.0f || dby != 0.0f)\par
12441     \{\par
12442         {\cf20 // For non-overlapping boxes, use distance between boxes}\par
12443         {\cf20 // FIXME-NAV: Quadrant may be incorrect because of (1) dbx bias and (2) curr.Max.y bias applied by NavBiasScoringRect() where typically curr.Max.y==curr.Min.y}\par
12444         {\cf20 // One typical case where this happens, with style.WindowMenuButtonPosition == ImGuiDir_Right, pressing Left to navigate from Close to Collapse tends to fail.}\par
12445         {\cf20 // Also see #6344. Calling ImGetDirQuadrantFromDelta() with unbiased values may be good but side-effects are plenty.}\par
12446         dax = dbx;\par
12447         day = dby;\par
12448         dist_axial = dist_box;\par
12449         quadrant = ImGetDirQuadrantFromDelta(dbx, dby);\par
12450     \}\par
12451     {\cf19 else} {\cf19 if} (dcx != 0.0f || dcy != 0.0f)\par
12452     \{\par
12453         {\cf20 // For overlapping boxes with different centers, use distance between centers}\par
12454         dax = dcx;\par
12455         day = dcy;\par
12456         dist_axial = dist_center;\par
12457         quadrant = ImGetDirQuadrantFromDelta(dcx, dcy);\par
12458     \}\par
12459     {\cf19 else}\par
12460     \{\par
12461         {\cf20 // Degenerate case: two overlapping buttons with same center, break ties arbitrarily (note that LastItemId here is really the _previous_ item order, but it doesn't matter)}\par
12462         quadrant = (g.LastItemData.ID < g.NavId) ? ImGuiDir_Left : ImGuiDir_Right;\par
12463     \}\par
12464 \par
12465     {\cf17 const} ImGuiDir move_dir = g.NavMoveDir;\par
12466 {\cf21 #if IMGUI_DEBUG_NAV_SCORING}\par
12467     {\cf18 char} buf[200];\par
12468     {\cf19 if} (g.IO.KeyCtrl) {\cf20 // Hold CTRL to preview score in matching quadrant. CTRL+Arrow to rotate.}\par
12469     \{\par
12470         {\cf19 if} (quadrant == move_dir)\par
12471         \{\par
12472             ImFormatString(buf, IM_ARRAYSIZE(buf), {\cf22 "%.0f/%.0f"}, dist_box, dist_center);\par
12473             ImDrawList* draw_list = GetForegroundDrawList(window);\par
12474             draw_list->AddRectFilled(cand.Min, cand.Max, IM_COL32(255, 0, 0, 80));\par
12475             draw_list->AddRectFilled(cand.Min, cand.Min + CalcTextSize(buf), IM_COL32(255, 0, 0, 200));\par
12476             draw_list->AddText(cand.Min, IM_COL32(255, 255, 255, 255), buf);\par
12477         \}\par
12478     \}\par
12479     {\cf17 const} {\cf18 bool} debug_hovering = IsMouseHoveringRect(cand.Min, cand.Max);\par
12480     {\cf17 const} {\cf18 bool} debug_tty = (g.IO.KeyCtrl && IsKeyPressed(ImGuiKey_Space));\par
12481     {\cf19 if} (debug_hovering || debug_tty)\par
12482     \{\par
12483         ImFormatString(buf, IM_ARRAYSIZE(buf),\par
12484             {\cf22 "d-box    (%7.3f,%7.3f) -> %7.3f\\nd-center (%7.3f,%7.3f) -> %7.3f\\nd-axial  (%7.3f,%7.3f) -> %7.3f\\nnav %c, quadrant %c"},\par
12485             dbx, dby, dist_box, dcx, dcy, dist_center, dax, day, dist_axial, {\cf22 "-WENS"}[move_dir+1], {\cf22 "-WENS"}[quadrant+1]);\par
12486         {\cf19 if} (debug_hovering)\par
12487         \{\par
12488             ImDrawList* draw_list = GetForegroundDrawList(window);\par
12489             draw_list->AddRect(curr.Min, curr.Max, IM_COL32(255, 200, 0, 100));\par
12490             draw_list->AddRect(cand.Min, cand.Max, IM_COL32(255, 255, 0, 200));\par
12491             draw_list->AddRectFilled(cand.Max - ImVec2(4, 4), cand.Max + CalcTextSize(buf) + ImVec2(4, 4), IM_COL32(40, 0, 0, 200));\par
12492             draw_list->AddText(cand.Max, ~0U, buf);\par
12493         \}\par
12494         {\cf19 if} (debug_tty) \{ IMGUI_DEBUG_LOG_NAV({\cf22 "id 0x%08X\\n%s\\n"}, g.LastItemData.ID, buf); \}\par
12495     \}\par
12496 {\cf21 #endif}\par
12497 \par
12498     {\cf20 // Is it in the quadrant we're interested in moving to?}\par
12499     {\cf18 bool} new_best = {\cf17 false};\par
12500     {\cf19 if} (quadrant == move_dir)\par
12501     \{\par
12502         {\cf20 // Does it beat the current best candidate?}\par
12503         {\cf19 if} (dist_box < result->DistBox)\par
12504         \{\par
12505             result->DistBox = dist_box;\par
12506             result->DistCenter = dist_center;\par
12507             {\cf19 return} {\cf17 true};\par
12508         \}\par
12509         {\cf19 if} (dist_box == result->DistBox)\par
12510         \{\par
12511             {\cf20 // Try using distance between center points to break ties}\par
12512             {\cf19 if} (dist_center < result->DistCenter)\par
12513             \{\par
12514                 result->DistCenter = dist_center;\par
12515                 new_best = {\cf17 true};\par
12516             \}\par
12517             {\cf19 else} {\cf19 if} (dist_center == result->DistCenter)\par
12518             \{\par
12519                 {\cf20 // Still tied! we need to be extra-careful to make sure everything gets linked properly. We consistently break ties by symbolically moving "later" items}\par
12520                 {\cf20 // (with higher index) to the right/downwards by an infinitesimal amount since we the current "best" button already (so it must have a lower index),}\par
12521                 {\cf20 // this is fairly easy. This rule ensures that all buttons with dx==dy==0 will end up being linked in order of appearance along the x axis.}\par
12522                 {\cf19 if} (((move_dir == ImGuiDir_Up || move_dir == ImGuiDir_Down) ? dby : dbx) < 0.0f) {\cf20 // moving bj to the right/down decreases distance}\par
12523                     new_best = true;\par
12524             \}\par
12525         \}\par
12526     \}\par
12527 \par
12528     {\cf20 // Axial check: if 'curr' has no link at all in some direction and 'cand' lies roughly in that direction, add a tentative link. This will only be kept if no "real" matches}\par
12529     {\cf20 // are found, so it only augments the graph produced by the above method using extra links. (important, since it doesn't guarantee strong connectedness)}\par
12530     {\cf20 // This is just to avoid buttons having no links in a particular direction when there's a suitable neighbor. you get good graphs without this too.}\par
12531     {\cf20 // 2017/09/29: FIXME: This now currently only enabled inside menu bars, ideally we'd disable it everywhere. Menus in particular need to catch failure. For general navigation it feels awkward.}\par
12532     {\cf20 // Disabling it may lead to disconnected graphs when nodes are very spaced out on different axis. Perhaps consider offering this as an option?}\par
12533     {\cf19 if} (result->DistBox == FLT_MAX && dist_axial < result->DistAxial)  {\cf20 // Check axial match}\par
12534         {\cf19 if} (g.NavLayer == ImGuiNavLayer_Menu && !(g.NavWindow->Flags & ImGuiWindowFlags_ChildMenu))\par
12535             {\cf19 if} ((move_dir == ImGuiDir_Left && dax < 0.0f) || (move_dir == ImGuiDir_Right && dax > 0.0f) || (move_dir == ImGuiDir_Up && day < 0.0f) || (move_dir == ImGuiDir_Down && day > 0.0f))\par
12536             \{\par
12537                 result->DistAxial = dist_axial;\par
12538                 new_best = {\cf17 true};\par
12539             \}\par
12540 \par
12541     {\cf19 return} new_best;\par
12542 \}\par
