13535             nav_rect_rel.Min.y = nav_rect_rel.Max.y = 0.0f;\par
13536             {\cf19 if} (nav_rect_rel.IsInverted())\par
13537                 nav_rect_rel.Min.x = nav_rect_rel.Max.x = 0.0f;\par
13538             g.NavMoveDir = ImGuiDir_Down;\par
13539             g.NavMoveFlags = ImGuiNavMoveFlags_AllowCurrentNavId | ImGuiNavMoveFlags_ScrollToEdgeY;\par
13540             {\cf20 // FIXME-NAV: MoveClipDir left to _None, intentional?}\par
13541         \}\par
13542         {\cf19 else} {\cf19 if} (end_pressed)\par
13543         \{\par
13544             nav_rect_rel.Min.y = nav_rect_rel.Max.y = window->ContentSize.y;\par
13545             {\cf19 if} (nav_rect_rel.IsInverted())\par
13546                 nav_rect_rel.Min.x = nav_rect_rel.Max.x = 0.0f;\par
13547             g.NavMoveDir = ImGuiDir_Up;\par
13548             g.NavMoveFlags = ImGuiNavMoveFlags_AllowCurrentNavId | ImGuiNavMoveFlags_ScrollToEdgeY;\par
13549             {\cf20 // FIXME-NAV: MoveClipDir left to _None, intentional?}\par
13550         \}\par
13551         {\cf19 return} nav_scoring_rect_offset_y;\par
13552     \}\par
13553     {\cf19 return} 0.0f;\par
13554 \}\par
