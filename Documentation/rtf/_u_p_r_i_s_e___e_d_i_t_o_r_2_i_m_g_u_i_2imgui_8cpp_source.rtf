13482 {\cf17 static} {\cf18 float} ImGui::NavUpdatePageUpPageDown()\par
13483 \{\par
13484     ImGuiContext& g = *GImGui;\par
13485     ImGuiWindow* window = g.NavWindow;\par
13486     {\cf19 if} ((window->Flags & ImGuiWindowFlags_NoNavInputs) || g.NavWindowingTarget != NULL)\par
13487         {\cf19 return} 0.0f;\par
13488 \par
13489     {\cf17 const} {\cf18 bool} page_up_held = IsKeyDown(ImGuiKey_PageUp, ImGuiKeyOwner_NoOwner);\par
13490     {\cf17 const} {\cf18 bool} page_down_held = IsKeyDown(ImGuiKey_PageDown, ImGuiKeyOwner_NoOwner);\par
13491     {\cf17 const} {\cf18 bool} home_pressed = IsKeyPressed(ImGuiKey_Home, ImGuiInputFlags_Repeat, ImGuiKeyOwner_NoOwner);\par
13492     {\cf17 const} {\cf18 bool} end_pressed = IsKeyPressed(ImGuiKey_End, ImGuiInputFlags_Repeat, ImGuiKeyOwner_NoOwner);\par
13493     {\cf19 if} (page_up_held == page_down_held && home_pressed == end_pressed) {\cf20 // Proceed if either (not both) are pressed, otherwise early out}\par
13494         {\cf19 return} 0.0f;\par
13495 \par
13496     {\cf19 if} (g.NavLayer != ImGuiNavLayer_Main)\par
13497         NavRestoreLayer(ImGuiNavLayer_Main);\par
13498 \par
13499     {\cf19 if} (window->DC.NavLayersActiveMask == 0x00 && window->DC.NavWindowHasScrollY)\par
13500     \{\par
13501         {\cf20 // Fallback manual-scroll when window has no navigable item}\par
13502         {\cf19 if} (IsKeyPressed(ImGuiKey_PageUp, ImGuiInputFlags_Repeat, ImGuiKeyOwner_NoOwner))\par
13503             SetScrollY(window, window->Scroll.y - window->InnerRect.GetHeight());\par
