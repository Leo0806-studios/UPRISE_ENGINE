21217         TextColored(ImVec4(1.0f, 0.4f, 0.4f, 1.0f), {\cf22 "CURRENTLY APPENDING"}); {\cf20 // Can't display stats for active draw list! (we don't have the data double-buffered)}\par
21218         {\cf19 if} (node_open)\par
21219             TreePop();\par
21220         {\cf19 return};\par
21221     \}\par
21222 \par
21223     ImDrawList* fg_draw_list = viewport ? GetForegroundDrawList(viewport) : NULL; {\cf20 // Render additional visuals into the top-most draw list}\par
21224     {\cf19 if} (window && IsItemHovered() && fg_draw_list)\par
21225         fg_draw_list->AddRect(window->Pos, window->Pos + window->Size, IM_COL32(255, 255, 0, 255));\par
21226     {\cf19 if} (!node_open)\par
21227         {\cf19 return};\par
21228 \par
21229     {\cf19 if} (window && !window->WasActive)\par
21230         TextDisabled({\cf22 "Warning: owning Window is inactive. This DrawList is not being rendered!"});\par
21231 \par
21232     {\cf19 for} ({\cf17 const} ImDrawCmd* pcmd = draw_list->CmdBuffer.Data; pcmd < draw_list->CmdBuffer.Data + cmd_count; pcmd++)\par
21233     \{\par
21234         {\cf19 if} (pcmd->UserCallback)\par
21235         \{\par
21236             BulletText({\cf22 "Callback %p, user_data %p"}, pcmd->UserCallback, pcmd->UserCallbackData);\par
21237             {\cf19 continue};\par
21238         \}\par
21239 \par
21240         {\cf18 char} texid_desc[20];\par
21241         FormatTextureIDForDebugDisplay(texid_desc, IM_ARRAYSIZE(texid_desc), pcmd->TextureId);\par
21242         {\cf18 char} buf[300];\par
21243         ImFormatString(buf, IM_ARRAYSIZE(buf), {\cf22 "DrawCmd:%5d tris, Tex %s, ClipRect (%4.0f,%4.0f)-(%4.0f,%4.0f)"},\par
21244             pcmd->ElemCount / 3, texid_desc, pcmd->ClipRect.x, pcmd->ClipRect.y, pcmd->ClipRect.z, pcmd->ClipRect.w);\par
21245         {\cf18 bool} pcmd_node_open = TreeNode(({\cf18 void}*)(pcmd - draw_list->CmdBuffer.begin()), {\cf22 "%s"}, buf);\par
21246         {\cf19 if} (IsItemHovered() && (cfg->ShowDrawCmdMesh || cfg->ShowDrawCmdBoundingBoxes) && fg_draw_list)\par
21247             DebugNodeDrawCmdShowMeshAndBoundingBox(fg_draw_list, draw_list, pcmd, cfg->ShowDrawCmdMesh, cfg->ShowDrawCmdBoundingBoxes);\par
21248         {\cf19 if} (!pcmd_node_open)\par
21249             {\cf19 continue};\par
21250 \par
21251         {\cf20 // Calculate approximate coverage area (touched pixel count)}\par
21252         {\cf20 // This will be in pixels squared as long there's no post-scaling happening to the renderer output.}\par
21253         {\cf17 const} ImDrawIdx* idx_buffer = (draw_list->IdxBuffer.Size > 0) ? draw_list->IdxBuffer.Data : NULL;\par
21254         {\cf17 const} ImDrawVert* vtx_buffer = draw_list->VtxBuffer.Data + pcmd->VtxOffset;\par
21255         {\cf18 float} total_area = 0.0f;\par
21256         {\cf19 for} ({\cf18 unsigned} {\cf18 int} idx_n = pcmd->IdxOffset; idx_n < pcmd->IdxOffset + pcmd->ElemCount; )\par
21257         \{\par
21258             ImVec2 triangle[3];\par
21259             {\cf19 for} ({\cf18 int} n = 0; n < 3; n++, idx_n++)\par
21260                 triangle[n] = vtx_buffer[idx_buffer ? idx_buffer[idx_n] : idx_n].pos;\par
21261             total_area += ImTriangleArea(triangle[0], triangle[1], triangle[2]);\par
21262         \}\par
21263 \par
21264         {\cf20 // Display vertex information summary. Hover to get all triangles drawn in wire-frame}\par
21265         ImFormatString(buf, IM_ARRAYSIZE(buf), {\cf22 "Mesh: ElemCount: %d, VtxOffset: +%d, IdxOffset: +%d, Area: ~%0.f px"}, pcmd->ElemCount, pcmd->VtxOffset, pcmd->IdxOffset, total_area);\par
21266         Selectable(buf);\par
21267         {\cf19 if} (IsItemHovered() && fg_draw_list)\par
21268             DebugNodeDrawCmdShowMeshAndBoundingBox(fg_draw_list, draw_list, pcmd, {\cf17 true}, {\cf17 false});\par
21269 \par
21270         {\cf20 // Display individual triangles/vertices. Hover on to get the corresponding triangle highlighted.}\par
21271         ImGuiListClipper clipper;\par
21272         clipper.Begin(pcmd->ElemCount / 3); {\cf20 // Manually coarse clip our print out of individual vertices to save CPU, only items that may be visible.}\par
21273         {\cf19 while} (clipper.Step())\par
21274             {\cf19 for} ({\cf18 int} prim = clipper.DisplayStart, idx_i = pcmd->IdxOffset + clipper.DisplayStart * 3; prim < clipper.DisplayEnd; prim++)\par
21275             \{\par
21276                 {\cf18 char}* buf_p = buf, * buf_end = buf + IM_ARRAYSIZE(buf);\par
21277                 ImVec2 triangle[3];\par
21278                 {\cf19 for} ({\cf18 int} n = 0; n < 3; n++, idx_i++)\par
21279                 \{\par
21280                     {\cf17 const} ImDrawVert& v = vtx_buffer[idx_buffer ? idx_buffer[idx_i] : idx_i];\par
21281                     triangle[n] = v.pos;\par
21282                     buf_p += ImFormatString(buf_p, buf_end - buf_p, {\cf22 "%s %04d: pos (%8.2f,%8.2f), uv (%.6f,%.6f), col %08X\\n"},\par
21283                         (n == 0) ? {\cf22 "Vert:"} : {\cf22 "     "}, idx_i, v.pos.x, v.pos.y, v.uv.x, v.uv.y, v.col);\par
21284                 \}\par
21285 \par
21286                 Selectable(buf, {\cf17 false});\par
21287                 {\cf19 if} (fg_draw_list && IsItemHovered())\par
21288                 \{\par
21289                     ImDrawListFlags backup_flags = fg_draw_list->Flags;\par
21290                     fg_draw_list->Flags &= ~ImDrawListFlags_AntiAliasedLines; {\cf20 // Disable AA on triangle outlines is more readable for very large and thin triangles.}\par
21291                     fg_draw_list->AddPolyline(triangle, 3, IM_COL32(255, 255, 0, 255), ImDrawFlags_Closed, 1.0f);\par
21292                     fg_draw_list->Flags = backup_flags;\par
21293                 \}\par
21294             \}\par
21295         TreePop();\par
21296     \}\par
21297     TreePop();\par
21298 \}\par
