14205 {\cf17 const} ImGuiPayload* ImGui::AcceptDragDropPayload({\cf17 const} {\cf18 char}* type, ImGuiDragDropFlags flags)\par
14206 \{\par
14207     ImGuiContext& g = *GImGui;\par
14208     ImGuiPayload& payload = g.DragDropPayload;\par
14209     IM_ASSERT(g.DragDropActive);                        {\cf20 // Not called between BeginDragDropTarget() and EndDragDropTarget() ?}\par
14210     IM_ASSERT(payload.DataFrameCount != -1);            {\cf20 // Forgot to call EndDragDropTarget() ?}\par
