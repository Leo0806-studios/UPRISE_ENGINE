09347 {\cf20 // Current score encoding (lower is highest priority):}\par
09348 {\cf20 //  -   0: ImGuiInputFlags_RouteGlobal | ImGuiInputFlags_RouteOverActive}\par
09349 {\cf20 //  -   1: ImGuiInputFlags_ActiveItem or ImGuiInputFlags_RouteFocused (if item active)}\par
09350 {\cf20 //  -   2: ImGuiInputFlags_RouteGlobal | ImGuiInputFlags_RouteOverFocused}\par
09351 {\cf20 //  -  3+: ImGuiInputFlags_RouteFocused (if window in focus-stack)}\par
09352 {\cf20 //  - 254: ImGuiInputFlags_RouteGlobal}\par
09353 {\cf20 //  - 255: never route}\par
09354 {\cf20 // 'flags' should include an explicit routing policy}\par
09355 {\cf17 static} {\cf18 int} CalcRoutingScore(ImGuiID focus_scope_id, ImGuiID owner_id, ImGuiInputFlags flags)\par
09356 \{\par
09357     ImGuiContext& g = *GImGui;\par
09358     {\cf19 if} (flags & ImGuiInputFlags_RouteFocused)\par
09359     \{\par
09360         {\cf20 // ActiveID gets top priority}\par
09361         {\cf20 // (we don't check g.ActiveIdUsingAllKeys here. Routing is applied but if input ownership is tested later it may discard it)}\par
09362         {\cf19 if} (owner_id != 0 && g.ActiveId == owner_id)\par
09363             {\cf19 return} 1;\par
09364 \par
09365         {\cf20 // Score based on distance to focused window (lower is better)}\par
09366         {\cf20 // Assuming both windows are submitting a routing request,}\par
09367         {\cf20 // - When Window....... is focused -> Window scores 3 (best), Window/ChildB scores 255 (no match)}\par
09368         {\cf20 // - When Window/ChildB is focused -> Window scores 4,        Window/ChildB scores 3 (best)}\par
09369         {\cf20 // Assuming only WindowA is submitting a routing request,}\par
09370         {\cf20 // - When Window/ChildB is focused -> Window scores 4 (best), Window/ChildB doesn't have a score.}\par
09371         {\cf20 // This essentially follow the window->ParentWindowForFocusRoute chain.}\par
09372         {\cf19 if} (focus_scope_id == 0)\par
09373             {\cf19 return} 255;\par
09374         {\cf19 for} ({\cf18 int} index_in_focus_path = 0; index_in_focus_path < g.NavFocusRoute.Size; index_in_focus_path++)\par
09375             {\cf19 if} (g.NavFocusRoute.Data[index_in_focus_path].ID == focus_scope_id)\par
09376                 {\cf19 return} 3 + index_in_focus_path;\par
09377         {\cf19 return} 255;\par
09378     \}\par
09379     {\cf19 else} {\cf19 if} (flags & ImGuiInputFlags_RouteActive)\par
09380     \{\par
09381         {\cf19 if} (owner_id != 0 && g.ActiveId == owner_id)\par
09382             {\cf19 return} 1;\par
09383         {\cf19 return} 255;\par
09384     \}\par
09385     {\cf19 else} {\cf19 if} (flags & ImGuiInputFlags_RouteGlobal)\par
09386     \{\par
09387         {\cf19 if} (flags & ImGuiInputFlags_RouteOverActive)\par
09388             {\cf19 return} 0;\par
09389         {\cf19 if} (flags & ImGuiInputFlags_RouteOverFocused)\par
09390             {\cf19 return} 2;\par
09391         {\cf19 return} 254;\par
09392     \}\par
09393     IM_ASSERT(0);\par
09394     {\cf19 return} 0;\par
09395 \}\par
