04341     {\cf19 if} (g.HoveredWindow != window)\par
04342         {\cf19 return} {\cf17 false};\par
04343     {\cf19 if} (!IsMouseHoveringRect(bb.Min, bb.Max))\par
04344         {\cf19 return} {\cf17 false};\par
04345 \par
04346     {\cf19 if} (g.HoveredId != 0 && g.HoveredId != {\cf18 id} && !g.HoveredIdAllowOverlap)\par
04347         {\cf19 return} {\cf17 false};\par
04348     {\cf19 if} (g.ActiveId != 0 && g.ActiveId != {\cf18 id} && !g.ActiveIdAllowOverlap)\par
04349         {\cf19 if} (!g.ActiveIdFromShortcut)\par
04350             {\cf19 return} {\cf17 false};\par
04351 \par
