10692 {\cf17 static} {\cf18 void} ImGui::ErrorCheckEndFrameSanityChecks()\par
10693 \{\par
10694     ImGuiContext& g = *GImGui;\par
10695 \par
10696     {\cf20 // Verify that io.KeyXXX fields haven't been tampered with. Key mods should not be modified between NewFrame() and EndFrame()}\par
10697     {\cf20 // One possible reason leading to this assert is that your backends update inputs _AFTER_ NewFrame().}\par
10698     {\cf20 // It is known that when some modal native windows called mid-frame takes focus away, some backends such as GLFW will}\par
10699     {\cf20 // send key release events mid-frame. This would normally trigger this assertion and lead to sheared inputs.}\par
10700     {\cf20 // We silently accommodate for this case by ignoring the case where all io.KeyXXX modifiers were released (aka key_mod_flags == 0),}\par
10701     {\cf20 // while still correctly asserting on mid-frame key press events.}\par
10702     {\cf17 const} ImGuiKeyChord key_mods = GetMergedModsFromKeys();\par
10703     IM_ASSERT((key_mods == 0 || g.IO.KeyMods == key_mods) && {\cf22 "Mismatching io.KeyCtrl/io.KeyShift/io.KeyAlt/io.KeySuper vs io.KeyMods"});\par
10704     IM_UNUSED(key_mods);\par
10705 \par
10706     {\cf20 // [EXPERIMENTAL] Recover from errors: You may call this yourself before EndFrame().}\par
10707     {\cf20 //ErrorCheckEndFrameRecover();}\par
10708 \par
10709     {\cf20 // Report when there is a mismatch of Begin/BeginChild vs End/EndChild calls. Important: Remember that the Begin/BeginChild API requires you}\par
10710     {\cf20 // to always call End/EndChild even if Begin/BeginChild returns false! (this is unfortunately inconsistent with most other Begin* API).}\par
10711     {\cf19 if} (g.CurrentWindowStack.Size != 1)\par
10712     \{\par
10713         {\cf19 if} (g.CurrentWindowStack.Size > 1)\par
10714         \{\par
10715             ImGuiWindow* window = g.CurrentWindowStack.back().Window; {\cf20 // <-- This window was not Ended!}\par
10716             IM_ASSERT_USER_ERROR(g.CurrentWindowStack.Size == 1, {\cf22 "Mismatched Begin/BeginChild vs End/EndChild calls: did you forget to call End/EndChild?"});\par
