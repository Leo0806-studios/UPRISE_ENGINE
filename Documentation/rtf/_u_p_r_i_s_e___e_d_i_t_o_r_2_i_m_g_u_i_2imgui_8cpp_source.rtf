04354     \{\par
04355         g.HoveredIdIsDisabled = {\cf17 true};\par
04356         {\cf19 return} {\cf17 false};\par
04357     \}\par
04358 \par
04359     {\cf20 // We exceptionally allow this function to be called with id==0 to allow using it for easy high-level}\par
04360     {\cf20 // hover test in widgets code. We could also decide to split this function is two.}\par
04361     {\cf19 if} ({\cf18 id} != 0)\par
