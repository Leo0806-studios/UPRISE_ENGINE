13510     \}\par
13511     {\cf19 else}\par
13512     \{\par
13513         ImRect& nav_rect_rel = window->NavRectRel[g.NavLayer];\par
13514         {\cf17 const} {\cf18 float} page_offset_y = ImMax(0.0f, window->InnerRect.GetHeight() - window->CalcFontSize() * 1.0f + nav_rect_rel.GetHeight());\par
13515         {\cf18 float} nav_scoring_rect_offset_y = 0.0f;\par
13516         {\cf19 if} (IsKeyPressed(ImGuiKey_PageUp, {\cf17 true}))\par
13517         \{\par
13518             nav_scoring_rect_offset_y = -page_offset_y;\par
13519             g.NavMoveDir = ImGuiDir_Down; {\cf20 // Because our scoring rect is offset up, we request the down direction (so we can always land on the last item)}\par
