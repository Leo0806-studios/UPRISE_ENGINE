18409 {\cf18 void} ImGui::DockNodeTreeMerge(ImGuiContext* ctx, ImGuiDockNode* parent_node, ImGuiDockNode* merge_lead_child)\par
18410 \{\par
18411     {\cf20 // When called from DockContextProcessUndockNode() it is possible that one of the child is NULL.}\par
18412     ImGuiContext& g = *GImGui;\par
18413     ImGuiDockNode* child_0 = parent_node->ChildNodes[0];\par
18414     ImGuiDockNode* child_1 = parent_node->ChildNodes[1];\par
18415     IM_ASSERT(child_0 || child_1);\par
18416     IM_ASSERT(merge_lead_child == child_0 || merge_lead_child == child_1);\par
18417     {\cf19 if} ((child_0 && child_0->Windows.Size > 0) || (child_1 && child_1->Windows.Size > 0))\par
18418     \{\par
18419         IM_ASSERT(parent_node->TabBar == NULL);\par
18420         IM_ASSERT(parent_node->Windows.Size == 0);\par
18421     \}\par
18422     IMGUI_DEBUG_LOG_DOCKING({\cf22 "[docking] DockNodeTreeMerge: 0x%08X + 0x%08X back into parent 0x%08X\\n"}, child_0 ? child_0->ID : 0, child_1 ? child_1->ID : 0, parent_node->ID);\par
18423 \par
18424     ImVec2 backup_last_explicit_size = parent_node->SizeRef;\par
18425     DockNodeMoveChildNodes(parent_node, merge_lead_child);\par
18426     {\cf19 if} (child_0)\par
18427     \{\par
18428         DockNodeMoveWindows(parent_node, child_0); {\cf20 // Generally only 1 of the 2 child node will have windows}\par
18429         DockSettingsRenameNodeReferences(child_0->ID, parent_node->ID);\par
18430     \}\par
18431     {\cf19 if} (child_1)\par
18432     \{\par
18433         DockNodeMoveWindows(parent_node, child_1);\par
18434         DockSettingsRenameNodeReferences(child_1->ID, parent_node->ID);\par
18435     \}\par
18436     DockNodeApplyPosSizeToWindows(parent_node);\par
18437     parent_node->AuthorityForPos = parent_node->AuthorityForSize = parent_node->AuthorityForViewport = ImGuiDataAuthority_Auto;\par
18438     parent_node->VisibleWindow = merge_lead_child->VisibleWindow;\par
18439     parent_node->SizeRef = backup_last_explicit_size;\par
18440 \par
18441     {\cf20 // Flags transfer}\par
18442     parent_node->LocalFlags &= ~ImGuiDockNodeFlags_LocalFlagsTransferMask_; {\cf20 // Preserve Dockspace flag}\par
18443     parent_node->LocalFlags |= (child_0 ? child_0->LocalFlags : 0) & ImGuiDockNodeFlags_LocalFlagsTransferMask_;\par
18444     parent_node->LocalFlags |= (child_1 ? child_1->LocalFlags : 0) & ImGuiDockNodeFlags_LocalFlagsTransferMask_;\par
18445     parent_node->LocalFlagsInWindows = (child_0 ? child_0->LocalFlagsInWindows : 0) | (child_1 ? child_1->LocalFlagsInWindows : 0); {\cf20 // FIXME: Would be more consistent to update from actual windows}\par
18446     parent_node->UpdateMergedFlags();\par
18447 \par
18448     {\cf19 if} (child_0)\par
18449     \{\par
18450         ctx->DockContext.Nodes.SetVoidPtr(child_0->ID, NULL);\par
18451         IM_DELETE(child_0);\par
18452     \}\par
18453     {\cf19 if} (child_1)\par
18454     \{\par
18455         ctx->DockContext.Nodes.SetVoidPtr(child_1->ID, NULL);\par
18456         IM_DELETE(child_1);\par
18457     \}\par
18458 \}\par
