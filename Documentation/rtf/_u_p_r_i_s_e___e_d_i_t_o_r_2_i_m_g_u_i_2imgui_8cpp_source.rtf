15835 {\cf17 static} {\cf18 int} ImGui::FindPlatformMonitorForPos({\cf17 const} ImVec2& pos)\par
15836 \{\par
15837     ImGuiContext& g = *GImGui;\par
15838     {\cf19 for} ({\cf18 int} monitor_n = 0; monitor_n < g.PlatformIO.Monitors.Size; monitor_n++)\par
15839     \{\par
15840         {\cf17 const} ImGuiPlatformMonitor& monitor = g.PlatformIO.Monitors[monitor_n];\par
15841         {\cf19 if} (ImRect(monitor.MainPos, monitor.MainPos + monitor.MainSize).Contains(pos))\par
15842             {\cf19 return} monitor_n;\par
15843     \}\par
15844     {\cf19 return} -1;\par
15845 \}\par
15846 \par
15847 {\cf20 // Search for the monitor with the largest intersection area with the given rectangle}\par
15848 {\cf20 // We generally try to avoid searching loops but the monitor count should be very small here}\par
15849 {\cf20 // FIXME-OPT: We could test the last monitor used for that viewport first, and early}\par
15850 {\cf17 static} {\cf18 int} ImGui::FindPlatformMonitorForRect({\cf17 const} ImRect& rect)\par
15851 \{\par
15852     ImGuiContext& g = *GImGui;\par
15853 \par
15854     {\cf17 const} {\cf18 int} monitor_count = g.PlatformIO.Monitors.Size;\par
15855     {\cf19 if} (monitor_count <= 1)\par
15856         {\cf19 return} monitor_count - 1;\par
15857 \par
15858     {\cf20 // Use a minimum threshold of 1.0f so a zero-sized rect won't false positive, and will still find the correct monitor given its position.}\par
15859     {\cf20 // This is necessary for tooltips which always resize down to zero at first.}\par
15860     {\cf17 const} {\cf18 float} surface_threshold = ImMax(rect.GetWidth() * rect.GetHeight() * 0.5f, 1.0f);\par
15861     {\cf18 int} best_monitor_n = -1;\par
15862     {\cf18 float} best_monitor_surface = 0.001f;\par
15863 \par
15864     {\cf19 for} ({\cf18 int} monitor_n = 0; monitor_n < g.PlatformIO.Monitors.Size && best_monitor_surface < surface_threshold; monitor_n++)\par
15865     \{\par
15866         {\cf17 const} ImGuiPlatformMonitor& monitor = g.PlatformIO.Monitors[monitor_n];\par
15867         {\cf17 const} ImRect monitor_rect = ImRect(monitor.MainPos, monitor.MainPos + monitor.MainSize);\par
15868         {\cf19 if} (monitor_rect.Contains(rect))\par
15869             {\cf19 return} monitor_n;\par
15870         ImRect overlapping_rect = rect;\par
15871         overlapping_rect.ClipWithFull(monitor_rect);\par
15872         {\cf18 float} overlapping_surface = overlapping_rect.GetWidth() * overlapping_rect.GetHeight();\par
15873         {\cf19 if} (overlapping_surface < best_monitor_surface)\par
15874             {\cf19 continue};\par
15875         best_monitor_surface = overlapping_surface;\par
15876         best_monitor_n = monitor_n;\par
15877     \}\par
15878     {\cf19 return} best_monitor_n;\par
15879 \}\par
15880 \par
15881 {\cf20 // Update monitor from viewport rectangle (we'll use this info to clamp windows and save windows lost in a removed monitor)}\par
15882 {\cf17 static} {\cf18 void} ImGui::UpdateViewportPlatformMonitor(ImGuiViewportP* viewport)\par
15883 \{\par
15884     viewport->PlatformMonitor = (short)FindPlatformMonitorForRect(viewport->GetMainRect());\par
15885 \}\par
