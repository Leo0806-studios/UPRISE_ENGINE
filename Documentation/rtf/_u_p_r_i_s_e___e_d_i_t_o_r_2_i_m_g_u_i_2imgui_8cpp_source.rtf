17221 {\cf20 // Update CentralNode, OnlyNodeWithWindows, LastFocusedNodeID. Copy window class.}\par
17222 {\cf17 static} {\cf18 void} ImGui::DockNodeUpdateForRootNode(ImGuiDockNode* node)\par
17223 \{\par
