15076     {\cf20 // 1) We test if ImGuiConfigFlags_ViewportsEnable was just toggled, which allows us to conveniently}\par
15077     {\cf20 // translate imgui windows from OS-window-local to absolute coordinates or vice-versa.}\par
15078     {\cf20 // 2) If it's not going to fit into the new size, keep it at same absolute position.}\par
15079     {\cf20 // One problem with this is that most Win32 applications doesn't update their render while dragging,}\par
15080     {\cf20 // and so the window will appear to teleport when releasing the mouse.}\par
15081     {\cf17 const} {\cf18 bool} translate_all_windows = (g.ConfigFlagsCurrFrame & ImGuiConfigFlags_ViewportsEnable) != (g.ConfigFlagsLastFrame & ImGuiConfigFlags_ViewportsEnable);\par
15082     ImRect test_still_fit_rect(old_pos, old_pos + viewport->Size);\par
15083     ImVec2 delta_pos = new_pos - old_pos;\par
15084     {\cf19 for} (ImGuiWindow* window : g.Windows) {\cf20 // FIXME-OPT}\par
15085         {\cf19 if} (translate_all_windows || (window->Viewport == viewport && test_still_fit_rect.Contains(window->Rect())))\par
15086             TranslateWindow(window, delta_pos);\par
15087 \}\par
