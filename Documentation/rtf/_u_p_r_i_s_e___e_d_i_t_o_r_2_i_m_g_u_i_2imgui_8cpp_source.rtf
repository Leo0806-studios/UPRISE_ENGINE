04762         {\cf20 // This is where we can trim the popup stack.}\par
04763         ImGuiWindow* modal = GetTopMostPopupModal();\par
04764         {\cf18 bool} hovered_window_above_modal = g.HoveredWindow && (modal == NULL || IsWindowAbove(g.HoveredWindow, modal));\par
04765         ClosePopupsOverWindow(hovered_window_above_modal ? g.HoveredWindow : modal, {\cf17 true});\par
