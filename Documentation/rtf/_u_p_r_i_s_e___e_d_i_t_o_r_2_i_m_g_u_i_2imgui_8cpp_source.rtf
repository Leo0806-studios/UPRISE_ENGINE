10579 {\cf20 // Until 1.89 (IMGUI_VERSION_NUM < 18814) it was legal to use SetCursorPos() to extend the boundary of a parent (e.g. window or table cell)}\par
10580 {\cf20 // This is causing issues and ambiguity and we need to retire that.}\par
10581 {\cf20 // See https://github.com/ocornut/imgui/issues/5548 for more details.}\par
10582 {\cf20 // [Scenario 1]}\par
10583 {\cf20 //  Previously this would make the window content size ~200x200:}\par
10584 {\cf20 //    Begin(...) + SetCursorScreenPos(GetCursorScreenPos() + ImVec2(200,200)) + End();  // NOT OK}\par
10585 {\cf20 //  Instead, please submit an item:}\par
10586 {\cf20 //    Begin(...) + SetCursorScreenPos(GetCursorScreenPos() + ImVec2(200,200)) + Dummy(ImVec2(0,0)) + End(); // OK}\par
10587 {\cf20 //  Alternative:}\par
10588 {\cf20 //    Begin(...) + Dummy(ImVec2(200,200)) + End(); // OK}\par
10589 {\cf20 // [Scenario 2]}\par
10590 {\cf20 //  For reference this is one of the issue what we aim to fix with this change:}\par
10591 {\cf20 //    BeginGroup() + SomeItem("foobar") + SetCursorScreenPos(GetCursorScreenPos()) + EndGroup()}\par
10592 {\cf20 //  The previous logic made SetCursorScreenPos(GetCursorScreenPos()) have a side-effect! It would erroneously incorporate ItemSpacing.y after the item into content size, making the group taller!}\par
10593 {\cf20 //  While this code is a little twisted, no-one would expect SetXXX(GetXXX()) to have a side-effect. Using vertical alignment patterns could trigger this issue.}\par
10594 {\cf18 void} ImGui::ErrorCheckUsingSetCursorPosToExtendParentBoundaries()\par
10595 \{\par
10596     ImGuiContext& g = *GImGui;\par
10597     ImGuiWindow* window = g.CurrentWindow;\par
10598     IM_ASSERT(window->DC.IsSetPos);\par
10599     window->DC.IsSetPos = {\cf17 false};\par
10600 {\cf21 #ifdef IMGUI_DISABLE_OBSOLETE_FUNCTIONS}\par
10601     {\cf19 if} (window->DC.CursorPos.x <= window->DC.CursorMaxPos.x && window->DC.CursorPos.y <= window->DC.CursorMaxPos.y)\par
10602         {\cf19 return};\par
10603     {\cf19 if} (window->SkipItems)\par
10604         {\cf19 return};\par
10605     IM_ASSERT(0 && {\cf22 "Code uses SetCursorPos()/SetCursorScreenPos() to extend window/parent boundaries. Please submit an item e.g. Dummy() to validate extent."});\par
10606 {\cf21 #else}\par
10607     window->DC.CursorMaxPos = ImMax(window->DC.CursorMaxPos, window->DC.CursorPos);\par
10608 {\cf21 #endif}\par
10609 \}\par
10610 \par
10611 {\cf17 static} {\cf18 void} ImGui::ErrorCheckNewFrameSanityChecks()\par
10612 \{\par
10613     ImGuiContext& g = *GImGui;\par
10614 \par
10615     {\cf20 // Check user IM_ASSERT macro}\par
10616     {\cf20 // (IF YOU GET A WARNING OR COMPILE ERROR HERE: it means your assert macro is incorrectly defined!}\par
10617     {\cf20 //  If your macro uses multiple statements, it NEEDS to be surrounded by a 'do \{ ... \} while (0)' block.}\par
10618     {\cf20 //  This is a common C/C++ idiom to allow multiple statements macros to be used in control flow blocks.)}\par
10619     {\cf20 // #define IM_ASSERT(EXPR)   if (SomeCode(EXPR)) SomeMoreCode();                    // Wrong!}\par
10620     {\cf20 // #define IM_ASSERT(EXPR)   do \{ if (SomeCode(EXPR)) SomeMoreCode(); \} while (0)   // Correct!}\par
10621     {\cf19 if} ({\cf17 true}) IM_ASSERT(1); {\cf19 else} IM_ASSERT(0);\par
10622 \par
10623     {\cf20 // Emscripten backends are often imprecise in their submission of DeltaTime. (#6114, #3644)}\par
10624     {\cf20 // Ideally the Emscripten app/backend should aim to fix or smooth this value and avoid feeding zero, but we tolerate it.}\par
10625 {\cf21 #ifdef __EMSCRIPTEN__}\par
10626     {\cf19 if} (g.IO.DeltaTime <= 0.0f && g.FrameCount > 0)\par
10627         g.IO.DeltaTime = 0.00001f;\par
10628 {\cf21 #endif}\par
10629 \par
10630     {\cf20 // Check user data}\par
10631     {\cf20 // (We pass an error message in the assert expression to make it visible to programmers who are not using a debugger, as most assert handlers display their argument)}\par
10632     IM_ASSERT(g.Initialized);\par
10633     IM_ASSERT((g.IO.DeltaTime > 0.0f || g.FrameCount == 0)              && {\cf22 "Need a positive DeltaTime!"});\par
10634     IM_ASSERT((g.FrameCount == 0 || g.FrameCountEnded == g.FrameCount)  && {\cf22 "Forgot to call Render() or EndFrame() at the end of the previous frame?"});\par
10635     IM_ASSERT(g.IO.DisplaySize.x >= 0.0f && g.IO.DisplaySize.y >= 0.0f  && {\cf22 "Invalid DisplaySize value!"});\par
10636     IM_ASSERT(g.IO.Fonts->IsBuilt()                                     && {\cf22 "Font Atlas not built! Make sure you called ImGui_ImplXXXX_NewFrame() function for renderer backend, which should call io.Fonts->GetTexDataAsRGBA32() / GetTexDataAsAlpha8()"});\par
10637     IM_ASSERT(g.Style.CurveTessellationTol > 0.0f                       && {\cf22 "Invalid style setting!"});\par
10638     IM_ASSERT(g.Style.CircleTessellationMaxError > 0.0f                 && {\cf22 "Invalid style setting!"});\par
10639     IM_ASSERT(g.Style.Alpha >= 0.0f && g.Style.Alpha <= 1.0f            && {\cf22 "Invalid style setting!"}); {\cf20 // Allows us to avoid a few clamps in color computations}\par
10640     IM_ASSERT(g.Style.WindowMinSize.x >= 1.0f && g.Style.WindowMinSize.y >= 1.0f && {\cf22 "Invalid style setting."});\par
10641     IM_ASSERT(g.Style.WindowMenuButtonPosition == ImGuiDir_None || g.Style.WindowMenuButtonPosition == ImGuiDir_Left || g.Style.WindowMenuButtonPosition == ImGuiDir_Right);\par
10642     IM_ASSERT(g.Style.ColorButtonPosition == ImGuiDir_Left || g.Style.ColorButtonPosition == ImGuiDir_Right);\par
10643 {\cf21 #ifndef IMGUI_DISABLE_OBSOLETE_KEYIO}\par
10644     {\cf19 for} ({\cf18 int} n = ImGuiKey_NamedKey_BEGIN; n < ImGuiKey_COUNT; n++)\par
10645         IM_ASSERT(g.IO.KeyMap[n] >= -1 && g.IO.KeyMap[n] < ImGuiKey_LegacyNativeKey_END && {\cf22 "io.KeyMap[] contains an out of bound value (need to be 0..511, or -1 for unmapped key)"});\par
10646 \par
10647     {\cf20 // Check: required key mapping (we intentionally do NOT check all keys to not pressure user into setting up everything, but Space is required and was only added in 1.60 WIP)}\par
10648     {\cf19 if} ((g.IO.ConfigFlags & ImGuiConfigFlags_NavEnableKeyboard) && g.IO.BackendUsingLegacyKeyArrays == 1)\par
10649         IM_ASSERT(g.IO.KeyMap[ImGuiKey_Space] != -1 && {\cf22 "ImGuiKey_Space is not mapped, required for keyboard navigation."});\par
10650 {\cf21 #endif}\par
10651 \par
10652     {\cf20 // Perform simple check: error if Docking or Viewport are enabled _exactly_ on frame 1 (instead of frame 0 or later), which is a common error leading to loss of .ini data.}\par
10653     {\cf19 if} (g.FrameCount == 1 && (g.IO.ConfigFlags & ImGuiConfigFlags_DockingEnable) && (g.ConfigFlagsLastFrame & ImGuiConfigFlags_DockingEnable) == 0)\par
10654         IM_ASSERT(0 && {\cf22 "Please set DockingEnable before the first call to NewFrame()! Otherwise you will lose your .ini settings!"});\par
10655     {\cf19 if} (g.FrameCount == 1 && (g.IO.ConfigFlags & ImGuiConfigFlags_ViewportsEnable) && (g.ConfigFlagsLastFrame & ImGuiConfigFlags_ViewportsEnable) == 0)\par
10656         IM_ASSERT(0 && {\cf22 "Please set ViewportsEnable before the first call to NewFrame()! Otherwise you will lose your .ini settings!"});\par
10657 \par
10658     {\cf20 // Perform simple checks: multi-viewport and platform windows support}\par
10659     {\cf19 if} (g.IO.ConfigFlags & ImGuiConfigFlags_ViewportsEnable)\par
10660     \{\par
10661         {\cf19 if} ((g.IO.BackendFlags & ImGuiBackendFlags_PlatformHasViewports) && (g.IO.BackendFlags & ImGuiBackendFlags_RendererHasViewports))\par
10662         \{\par
10663             IM_ASSERT((g.FrameCount == 0 || g.FrameCount == g.FrameCountPlatformEnded) && {\cf22 "Forgot to call UpdatePlatformWindows() in main loop after EndFrame()? Check examples/ applications for reference."});\par
10664             IM_ASSERT(g.PlatformIO.Platform_CreateWindow  != NULL && {\cf22 "Platform init didn't install handlers?"});\par
10665             IM_ASSERT(g.PlatformIO.Platform_DestroyWindow != NULL && {\cf22 "Platform init didn't install handlers?"});\par
10666             IM_ASSERT(g.PlatformIO.Platform_GetWindowPos  != NULL && {\cf22 "Platform init didn't install handlers?"});\par
10667             IM_ASSERT(g.PlatformIO.Platform_SetWindowPos  != NULL && {\cf22 "Platform init didn't install handlers?"});\par
10668             IM_ASSERT(g.PlatformIO.Platform_GetWindowSize != NULL && {\cf22 "Platform init didn't install handlers?"});\par
10669             IM_ASSERT(g.PlatformIO.Platform_SetWindowSize != NULL && {\cf22 "Platform init didn't install handlers?"});\par
10670             IM_ASSERT(g.PlatformIO.Monitors.Size > 0 && {\cf22 "Platform init didn't setup Monitors list?"});\par
10671             IM_ASSERT((g.Viewports[0]->PlatformUserData != NULL || g.Viewports[0]->PlatformHandle != NULL) && {\cf22 "Platform init didn't setup main viewport."});\par
10672             {\cf19 if} (g.IO.ConfigDockingTransparentPayload && (g.IO.ConfigFlags & ImGuiConfigFlags_DockingEnable))\par
10673                 IM_ASSERT(g.PlatformIO.Platform_SetWindowAlpha != NULL && {\cf22 "Platform_SetWindowAlpha handler is required to use io.ConfigDockingTransparent!"});\par
10674         \}\par
10675         {\cf19 else}\par
10676         \{\par
10677             {\cf20 // Disable feature, our backends do not support it}\par
10678             g.IO.ConfigFlags &= ~ImGuiConfigFlags_ViewportsEnable;\par
10679         \}\par
10680 \par
10681         {\cf20 // Perform simple checks on platform monitor data + compute a total bounding box for quick early outs}\par
10682         {\cf19 for} (ImGuiPlatformMonitor& mon : g.PlatformIO.Monitors)\par
10683         \{\par
10684             IM_UNUSED(mon);\par
10685             IM_ASSERT(mon.MainSize.x > 0.0f && mon.MainSize.y > 0.0f && {\cf22 "Monitor main bounds not setup properly."});\par
10686             IM_ASSERT(ImRect(mon.MainPos, mon.MainPos + mon.MainSize).Contains(ImRect(mon.WorkPos, mon.WorkPos + mon.WorkSize)) && {\cf22 "Monitor work bounds not setup properly. If you don't have work area information, just copy MainPos/MainSize into them."});\par
10687             IM_ASSERT(mon.DpiScale != 0.0f);\par
10688         \}\par
10689     \}\par
10690 \}\par
