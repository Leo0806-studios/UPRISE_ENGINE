13521             g.NavMoveFlags = ImGuiNavMoveFlags_AllowCurrentNavId | ImGuiNavMoveFlags_AlsoScoreVisibleSet | ImGuiNavMoveFlags_IsPageMove;\par
13522         \}\par
13523         {\cf19 else} {\cf19 if} (IsKeyPressed(ImGuiKey_PageDown, {\cf17 true}))\par
13524         \{\par
13525             nav_scoring_rect_offset_y = +page_offset_y;\par
13526             g.NavMoveDir = ImGuiDir_Up; {\cf20 // Because our scoring rect is offset down, we request the up direction (so we can always land on the last item)}\par
13527             g.NavMoveClipDir = ImGuiDir_Down;\par
13528             g.NavMoveFlags = ImGuiNavMoveFlags_AllowCurrentNavId | ImGuiNavMoveFlags_AlsoScoreVisibleSet | ImGuiNavMoveFlags_IsPageMove;\par
13529         \}\par
13530         {\cf19 else} {\cf19 if} (home_pressed)\par
13531         \{\par
13532             {\cf20 // FIXME-NAV: handling of Home/End is assuming that the top/bottom most item will be visible with Scroll.y == 0/ScrollMax.y}\par
13533             {\cf20 // Scrolling will be handled via the ImGuiNavMoveFlags_ScrollToEdgeY flag, we don't scroll immediately to avoid scrolling happening before nav result.}\par
