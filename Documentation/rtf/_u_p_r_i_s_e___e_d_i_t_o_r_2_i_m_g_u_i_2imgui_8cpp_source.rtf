18013 {\cf17 static} {\cf18 bool} ImGui::DockNodeIsDropAllowed(ImGuiWindow* host_window, ImGuiWindow* root_payload)\par
18014 \{\par
18015     {\cf19 if} (root_payload->DockNodeAsHost && root_payload->DockNodeAsHost->IsSplitNode()) {\cf20 // FIXME-DOCK: Missing filtering}\par
18016         {\cf19 return} {\cf17 true};\par
18017 \par
18018     {\cf17 const} {\cf18 int} payload_count = root_payload->DockNodeAsHost ? root_payload->DockNodeAsHost->Windows.Size : 1;\par
18019     {\cf19 for} ({\cf18 int} payload_n = 0; payload_n < payload_count; payload_n++)\par
18020     \{\par
