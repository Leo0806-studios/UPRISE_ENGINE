21300 {\cf20 // [DEBUG] Display mesh/aabb of a ImDrawCmd}\par
21301 {\cf18 void} ImGui::DebugNodeDrawCmdShowMeshAndBoundingBox(ImDrawList* out_draw_list, {\cf17 const} ImDrawList* draw_list, {\cf17 const} ImDrawCmd* draw_cmd, {\cf18 bool} show_mesh, {\cf18 bool} show_aabb)\par
21302 \{\par
21303     IM_ASSERT(show_mesh || show_aabb);\par
21304 \par
21305     {\cf20 // Draw wire-frame version of all triangles}\par
21306     ImRect clip_rect = draw_cmd->ClipRect;\par
21307     ImRect vtxs_rect(FLT_MAX, FLT_MAX, -FLT_MAX, -FLT_MAX);\par
21308     ImDrawListFlags backup_flags = out_draw_list->Flags;\par
21309     out_draw_list->Flags &= ~ImDrawListFlags_AntiAliasedLines; {\cf20 // Disable AA on triangle outlines is more readable for very large and thin triangles.}\par
21310     {\cf19 for} ({\cf18 unsigned} {\cf18 int} idx_n = draw_cmd->IdxOffset, idx_end = draw_cmd->IdxOffset + draw_cmd->ElemCount; idx_n < idx_end; )\par
21311     \{\par
21312         ImDrawIdx* idx_buffer = (draw_list->IdxBuffer.Size > 0) ? draw_list->IdxBuffer.Data : NULL; {\cf20 // We don't hold on those pointers past iterations as ->AddPolyline() may invalidate them if out_draw_list==draw_list}\par
21313         ImDrawVert* vtx_buffer = draw_list->VtxBuffer.Data + draw_cmd->VtxOffset;\par
21314 \par
21315         ImVec2 triangle[3];\par
21316         {\cf19 for} ({\cf18 int} n = 0; n < 3; n++, idx_n++)\par
21317             vtxs_rect.Add((triangle[n] = vtx_buffer[idx_buffer ? idx_buffer[idx_n] : idx_n].pos));\par
21318         {\cf19 if} (show_mesh)\par
21319             out_draw_list->AddPolyline(triangle, 3, IM_COL32(255, 255, 0, 255), ImDrawFlags_Closed, 1.0f); {\cf20 // In yellow: mesh triangles}\par
21320     \}\par
21321     {\cf20 // Draw bounding boxes}\par
21322     {\cf19 if} (show_aabb)\par
21323     \{\par
21324         out_draw_list->AddRect(ImTrunc(clip_rect.Min), ImTrunc(clip_rect.Max), IM_COL32(255, 0, 255, 255)); {\cf20 // In pink: clipping rectangle submitted to GPU}\par
21325         out_draw_list->AddRect(ImTrunc(vtxs_rect.Min), ImTrunc(vtxs_rect.Max), IM_COL32(0, 255, 255, 255)); {\cf20 // In cyan: bounding box of triangles}\par
21326     \}\par
21327     out_draw_list->Flags = backup_flags;\par
21328 \}\par
