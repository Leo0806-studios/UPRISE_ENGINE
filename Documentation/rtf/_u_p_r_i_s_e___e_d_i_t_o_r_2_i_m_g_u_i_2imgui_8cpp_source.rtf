04198                 {\cf20 // For the purpose of those flags we differentiate "standard popup" from "modal popup"}\par
04199                 {\cf20 // NB: The 'else' is important because Modal windows are also Popups.}\par
04200                 {\cf18 bool} want_inhibit = {\cf17 false};\par
04201                 {\cf19 if} (focused_root_window->Flags & ImGuiWindowFlags_Modal)\par
04202                     want_inhibit = {\cf17 true};\par
04203                 {\cf19 else} {\cf19 if} ((focused_root_window->Flags & ImGuiWindowFlags_Popup) && !(flags & ImGuiHoveredFlags_AllowWhenBlockedByPopup))\par
04204                     want_inhibit = {\cf17 true};\par
