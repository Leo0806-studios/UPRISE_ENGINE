05290 {\cf17 static} {\cf18 void} ImGui::RenderDimmedBackgroundBehindWindow(ImGuiWindow* window, ImU32 col)\par
05291 \{\par
05292     {\cf19 if} ((col & IM_COL32_A_MASK) == 0)\par
05293         {\cf19 return};\par
05294 \par
05295     ImGuiViewportP* viewport = window->Viewport;\par
05296     ImRect viewport_rect = viewport->GetMainRect();\par
05297 \par
05298     {\cf20 // Draw behind window by moving the draw command at the FRONT of the draw list}\par
05299     \{\par
05300         {\cf20 // Draw list have been trimmed already, hence the explicit recreation of a draw command if missing.}\par
05301         {\cf20 // FIXME: This is creating complication, might be simpler if we could inject a drawlist in drawdata at a given position and not attempt to manipulate ImDrawCmd order.}\par
05302         ImDrawList* draw_list = window->RootWindowDockTree->DrawList;\par
05303         draw_list->ChannelsMerge();\par
05304         {\cf19 if} (draw_list->CmdBuffer.Size == 0)\par
05305             draw_list->AddDrawCmd();\par
05306         draw_list->PushClipRect(viewport_rect.Min - ImVec2(1, 1), viewport_rect.Max + ImVec2(1, 1), {\cf17 false}); {\cf20 // FIXME: Need to stricty ensure ImDrawCmd are not merged (ElemCount==6 checks below will verify that)}\par
05307         draw_list->AddRectFilled(viewport_rect.Min, viewport_rect.Max, col);\par
05308         ImDrawCmd cmd = draw_list->CmdBuffer.back();\par
05309         IM_ASSERT(cmd.ElemCount == 6);\par
05310         draw_list->CmdBuffer.pop_back();\par
05311         draw_list->CmdBuffer.push_front(cmd);\par
05312         draw_list->AddDrawCmd(); {\cf20 // We need to create a command as CmdBuffer.back().IdxOffset won't be correct if we append to same command.}\par
05313         draw_list->PopClipRect();\par
05314     \}\par
05315 \par
05316     {\cf20 // Draw over sibling docking nodes in a same docking tree}\par
05317     {\cf19 if} (window->RootWindow->DockIsActive)\par
05318     \{\par
05319         ImDrawList* draw_list = FindFrontMostVisibleChildWindow(window->RootWindowDockTree)->DrawList;\par
05320         draw_list->ChannelsMerge();\par
05321         {\cf19 if} (draw_list->CmdBuffer.Size == 0)\par
05322             draw_list->AddDrawCmd();\par
05323         draw_list->PushClipRect(viewport_rect.Min, viewport_rect.Max, {\cf17 false});\par
05324         RenderRectFilledWithHole(draw_list, window->RootWindowDockTree->Rect(), window->RootWindow->Rect(), col, 0.0f);{\cf20 // window->RootWindowDockTree->WindowRounding);}\par
05325         draw_list->PopClipRect();\par
05326     \}\par
05327 \}\par
