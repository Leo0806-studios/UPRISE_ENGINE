09535 {\cf20 // Important: unless legacy IsKeyPressed(ImGuiKey, bool repeat=true) which DEFAULT to repeat, this requires EXPLICIT repeat.}\par
09536 {\cf18 bool} ImGui::IsKeyPressed(ImGuiKey key, ImGuiInputFlags flags, ImGuiID owner_id)\par
09537 \{\par
09538     {\cf17 const} ImGuiKeyData* key_data = GetKeyData(key);\par
09539     {\cf19 if} (!key_data->Down) {\cf20 // In theory this should already be encoded as (DownDuration < 0.0f), but testing this facilitates eating mechanism (until we finish work on key ownership)}\par
09540         {\cf19 return} {\cf17 false};\par
09541     {\cf17 const} {\cf18 float} t = key_data->DownDuration;\par
09542     {\cf19 if} (t < 0.0f)\par
09543         {\cf19 return} {\cf17 false};\par
09544     IM_ASSERT((flags & ~ImGuiInputFlags_SupportedByIsKeyPressed) == 0); {\cf20 // Passing flags not supported by this function!}\par
09545     {\cf19 if} (flags & (ImGuiInputFlags_RepeatRateMask_ | ImGuiInputFlags_RepeatUntilMask_)) {\cf20 // Setting any _RepeatXXX option enables _Repeat}\par
09546         flags |= ImGuiInputFlags_Repeat;\par
09547 \par
09548     {\cf18 bool} pressed = (t == 0.0f);\par
09549     {\cf19 if} (!pressed && (flags & ImGuiInputFlags_Repeat) != 0)\par
09550     \{\par
09551         {\cf18 float} repeat_delay, repeat_rate;\par
09552         GetTypematicRepeatRate(flags, &repeat_delay, &repeat_rate);\par
09553         pressed = (t > repeat_delay) && GetKeyPressedAmount(key, repeat_delay, repeat_rate) > 0;\par
09554         {\cf19 if} (pressed && (flags & ImGuiInputFlags_RepeatUntilMask_))\par
09555         \{\par
09556             {\cf20 // Slightly bias 'key_pressed_time' as DownDuration is an accumulation of DeltaTime which we compare to an absolute time value.}\par
09557             {\cf20 // Ideally we'd replace DownDuration with KeyPressedTime but it would break user's code.}\par
09558             ImGuiContext& g = *GImGui;\par
09559             {\cf18 double} key_pressed_time = g.Time - t + 0.00001f;\par
09560             {\cf19 if} ((flags & ImGuiInputFlags_RepeatUntilKeyModsChange) && (g.LastKeyModsChangeTime > key_pressed_time))\par
09561                 pressed = {\cf17 false};\par
09562             {\cf19 if} ((flags & ImGuiInputFlags_RepeatUntilKeyModsChangeFromNone) && (g.LastKeyModsChangeFromNoneTime > key_pressed_time))\par
09563                 pressed = {\cf17 false};\par
09564             {\cf19 if} ((flags & ImGuiInputFlags_RepeatUntilOtherKeyPress) && (g.LastKeyboardKeyPressTime > key_pressed_time))\par
09565                 pressed = {\cf17 false};\par
09566         \}\par
09567     \}\par
09568     {\cf19 if} (!pressed)\par
09569         {\cf19 return} {\cf17 false};\par
09570     {\cf19 if} (!TestKeyOwner(key, owner_id))\par
09571         {\cf19 return} {\cf17 false};\par
09572     {\cf19 return} {\cf17 true};\par
09573 \}\par
