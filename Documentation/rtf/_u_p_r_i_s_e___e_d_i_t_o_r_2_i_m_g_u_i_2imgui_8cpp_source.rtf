19261 {\cf20 // FIXME: Will probably want to change this signature, in particular how the window remapping pairs are passed.}\par
19262 {\cf18 void} ImGui::DockBuilderCopyDockSpace(ImGuiID src_dockspace_id, ImGuiID dst_dockspace_id, ImVector<const char*>* in_window_remap_pairs)\par
19263 \{\par
19264     ImGuiContext& g = *GImGui;\par
19265     IM_ASSERT(src_dockspace_id != 0);\par
19266     IM_ASSERT(dst_dockspace_id != 0);\par
19267     IM_ASSERT(in_window_remap_pairs != NULL);\par
19268     IM_ASSERT((in_window_remap_pairs->Size % 2) == 0);\par
19269 \par
19270     {\cf20 // Duplicate entire dock}\par
19271     {\cf20 // FIXME: When overwriting dst_dockspace_id, windows that aren't part of our dockspace window class but that are docked in a same node will be split apart,}\par
19272     {\cf20 // whereas we could attempt to at least keep them together in a new, same floating node.}\par
19273     ImVector<ImGuiID> node_remap_pairs;\par
19274     DockBuilderCopyNode(src_dockspace_id, dst_dockspace_id, &node_remap_pairs);\par
19275 \par
19276     {\cf20 // Attempt to transition all the upcoming windows associated to dst_dockspace_id into the newly created hierarchy of dock nodes}\par
19277     {\cf20 // (The windows associated to src_dockspace_id are staying in place)}\par
19278     ImVector<ImGuiID> src_windows;\par
19279     {\cf19 for} ({\cf18 int} remap_window_n = 0; remap_window_n < in_window_remap_pairs->Size; remap_window_n += 2)\par
19280     \{\par
19281         {\cf17 const} {\cf18 char}* src_window_name = (*in_window_remap_pairs)[remap_window_n];\par
19282         {\cf17 const} {\cf18 char}* dst_window_name = (*in_window_remap_pairs)[remap_window_n + 1];\par
19283         ImGuiID src_window_id = ImHashStr(src_window_name);\par
19284         src_windows.push_back(src_window_id);\par
19285 \par
19286         {\cf20 // Search in the remapping tables}\par
19287         ImGuiID src_dock_id = 0;\par
19288         {\cf19 if} (ImGuiWindow* src_window = FindWindowByID(src_window_id))\par
19289             src_dock_id = src_window->DockId;\par
19290         {\cf19 else} {\cf19 if} (ImGuiWindowSettings* src_window_settings = FindWindowSettingsByID(src_window_id))\par
19291             src_dock_id = src_window_settings->DockId;\par
19292         ImGuiID dst_dock_id = 0;\par
19293         {\cf19 for} ({\cf18 int} dock_remap_n = 0; dock_remap_n < node_remap_pairs.Size; dock_remap_n += 2)\par
19294             {\cf19 if} (node_remap_pairs[dock_remap_n] == src_dock_id)\par
19295             \{\par
19296                 dst_dock_id = node_remap_pairs[dock_remap_n + 1];\par
19297                 {\cf20 //node_remap_pairs[dock_remap_n] = node_remap_pairs[dock_remap_n + 1] = 0; // Clear}\par
19298                 {\cf19 break};\par
19299             \}\par
19300 \par
19301         {\cf19 if} (dst_dock_id != 0)\par
19302         \{\par
19303             {\cf20 // Docked windows gets redocked into the new node hierarchy.}\par
19304             IMGUI_DEBUG_LOG_DOCKING({\cf22 "[docking] Remap live window '%s' 0x%08X -> '%s' 0x%08X\\n"}, src_window_name, src_dock_id, dst_window_name, dst_dock_id);\par
19305             DockBuilderDockWindow(dst_window_name, dst_dock_id);\par
19306         \}\par
19307         {\cf19 else}\par
19308         \{\par
19309             {\cf20 // Floating windows gets their settings transferred (regardless of whether the new window already exist or not)}\par
19310             {\cf20 // When this is leading to a Copy and not a Move, we would get two overlapping floating windows. Could we possibly dock them together?}\par
19311             IMGUI_DEBUG_LOG_DOCKING({\cf22 "[docking] Remap window settings '%s' -> '%s'\\n"}, src_window_name, dst_window_name);\par
19312             DockBuilderCopyWindowSettings(src_window_name, dst_window_name);\par
19313         \}\par
19314     \}\par
19315 \par
19316     {\cf20 // Anything else in the source nodes of 'node_remap_pairs' are windows that are not included in the remapping list.}\par
19317     {\cf20 // Find those windows and move to them to the cloned dock node. This may be optional?}\par
19318     {\cf20 // Dock those are a second step as undocking would invalidate source dock nodes.}\par
19319     {\cf17 struct }DockRemainingWindowTask \{ ImGuiWindow* Window; ImGuiID DockId; DockRemainingWindowTask(ImGuiWindow* window, ImGuiID dock_id) \{ Window = window; DockId = dock_id; \} \};\par
19320     ImVector<DockRemainingWindowTask> dock_remaining_windows;\par
19321     {\cf19 for} ({\cf18 int} dock_remap_n = 0; dock_remap_n < node_remap_pairs.Size; dock_remap_n += 2)\par
19322         {\cf19 if} (ImGuiID src_dock_id = node_remap_pairs[dock_remap_n])\par
19323         \{\par
19324             ImGuiID dst_dock_id = node_remap_pairs[dock_remap_n + 1];\par
19325             ImGuiDockNode* node = DockBuilderGetNode(src_dock_id);\par
19326             {\cf19 for} ({\cf18 int} window_n = 0; window_n < node->Windows.Size; window_n++)\par
19327             \{\par
19328                 ImGuiWindow* window = node->Windows[window_n];\par
19329                 {\cf19 if} (src_windows.contains(window->ID))\par
19330                     {\cf19 continue};\par
19331 \par
19332                 {\cf20 // Docked windows gets redocked into the new node hierarchy.}\par
19333                 IMGUI_DEBUG_LOG_DOCKING({\cf22 "[docking] Remap window '%s' %08X -> %08X\\n"}, window->Name, src_dock_id, dst_dock_id);\par
19334                 dock_remaining_windows.push_back(DockRemainingWindowTask(window, dst_dock_id));\par
19335             \}\par
19336         \}\par
19337     {\cf19 for} ({\cf17 const} DockRemainingWindowTask& task : dock_remaining_windows)\par
19338         DockBuilderDockWindow(task.Window->Name, task.DockId);\par
19339 \}\par
