11817 {\cf18 void} ImGui::OpenPopup(ImGuiID {\cf18 id}, ImGuiPopupFlags popup_flags)\par
11818 \{\par
11819     OpenPopupEx({\cf18 id}, popup_flags);\par
11820 \}\par
11821 \par
11822 {\cf20 // Mark popup as open (toggle toward open state).}\par
11823 {\cf20 // Popups are closed when user click outside, or activate a pressable item, or CloseCurrentPopup() is called within a BeginPopup()/EndPopup() block.}\par
11824 {\cf20 // Popup identifiers are relative to the current ID-stack (so OpenPopup and BeginPopup needs to be at the same level).}\par
11825 {\cf20 // One open popup per level of the popup hierarchy (NB: when assigning we reset the Window member of ImGuiPopupRef to NULL)}\par
11826 {\cf18 void} ImGui::OpenPopupEx(ImGuiID {\cf18 id}, ImGuiPopupFlags popup_flags)\par
11827 \{\par
11828     ImGuiContext& g = *GImGui;\par
11829     ImGuiWindow* parent_window = g.CurrentWindow;\par
11830     {\cf17 const} {\cf18 int} current_stack_size = g.BeginPopupStack.Size;\par
11831 \par
11832     {\cf19 if} (popup_flags & ImGuiPopupFlags_NoOpenOverExistingPopup)\par
11833         {\cf19 if} (IsPopupOpen((ImGuiID)0, ImGuiPopupFlags_AnyPopupId))\par
11834             {\cf19 return};\par
11835 \par
11836     ImGuiPopupData popup_ref; {\cf20 // Tagged as new ref as Window will be set back to NULL if we write this into OpenPopupStack.}\par
11837     popup_ref.PopupId = id;\par
11838     popup_ref.Window = NULL;\par
11839     popup_ref.RestoreNavWindow = g.NavWindow;           {\cf20 // When popup closes focus may be restored to NavWindow (depend on window type).}\par
11840     popup_ref.OpenFrameCount = g.FrameCount;\par
11841     popup_ref.OpenParentId = parent_window->IDStack.back();\par
11842     popup_ref.OpenPopupPos = NavCalcPreferredRefPos();\par
11843     popup_ref.OpenMousePos = IsMousePosValid(&g.IO.MousePos) ? g.IO.MousePos : popup_ref.OpenPopupPos;\par
11844 \par
11845     IMGUI_DEBUG_LOG_POPUP({\cf22 "[popup] OpenPopupEx(0x%08X)\\n"}, {\cf18 id});\par
11846     {\cf19 if} (g.OpenPopupStack.Size < current_stack_size + 1)\par
11847     \{\par
11848         g.OpenPopupStack.push_back(popup_ref);\par
11849     \}\par
11850     {\cf19 else}\par
11851     \{\par
11852         {\cf20 // Gently handle the user mistakenly calling OpenPopup() every frames: it is likely a programming mistake!}\par
11853         {\cf20 // However, if we were to run the regular code path, the ui would become completely unusable because the popup will always be}\par
11854         {\cf20 // in hidden-while-calculating-size state _while_ claiming focus. Which is extremely confusing situation for the programmer.}\par
11855         {\cf20 // Instead, for successive frames calls to OpenPopup(), we silently avoid reopening even if ImGuiPopupFlags_NoReopen is not specified.}\par
11856         {\cf18 bool} keep_existing = {\cf17 false};\par
11857         {\cf19 if} (g.OpenPopupStack[current_stack_size].PopupId == {\cf18 id})\par
11858             {\cf19 if} ((g.OpenPopupStack[current_stack_size].OpenFrameCount == g.FrameCount - 1) || (popup_flags & ImGuiPopupFlags_NoReopen))\par
11859                 keep_existing = {\cf17 true};\par
11860         {\cf19 if} (keep_existing)\par
11861         \{\par
11862             {\cf20 // No reopen}\par
11863             g.OpenPopupStack[current_stack_size].OpenFrameCount = popup_ref.OpenFrameCount;\par
11864         \}\par
11865         {\cf19 else}\par
11866         \{\par
11867             {\cf20 // Reopen: close child popups if any, then flag popup for open/reopen (set position, focus, init navigation)}\par
11868             ClosePopupToLevel(current_stack_size, {\cf17 true});\par
11869             g.OpenPopupStack.push_back(popup_ref);\par
11870         \}\par
11871 \par
11872         {\cf20 // When reopening a popup we first refocus its parent, otherwise if its parent is itself a popup it would get closed by ClosePopupsOverWindow().}\par
11873         {\cf20 // This is equivalent to what ClosePopupToLevel() does.}\par
11874         {\cf20 //if (g.OpenPopupStack[current_stack_size].PopupId == id)}\par
11875         {\cf20 //    FocusWindow(parent_window);}\par
11876     \}\par
11877 \}\par
11878 \par
11879 {\cf20 // When popups are stacked, clicking on a lower level popups puts focus back to it and close popups above it.}\par
11880 {\cf20 // This function closes any popups that are over 'ref_window'.}\par
11881 {\cf18 void} ImGui::ClosePopupsOverWindow(ImGuiWindow* ref_window, {\cf18 bool} restore_focus_to_window_under_popup)\par
11882 \{\par
11883     ImGuiContext& g = *GImGui;\par
11884     {\cf19 if} (g.OpenPopupStack.Size == 0)\par
11885         {\cf19 return};\par
11886 \par
11887     {\cf20 // Don't close our own child popup windows.}\par
11888     {\cf20 //IMGUI_DEBUG_LOG_POPUP("[popup] ClosePopupsOverWindow(\\"%s\\") restore_under=%d\\n", ref_window ? ref_window->Name : "<NULL>", restore_focus_to_window_under_popup);}\par
11889     {\cf18 int} popup_count_to_keep = 0;\par
11890     {\cf19 if} (ref_window)\par
11891     \{\par
11892         {\cf20 // Find the highest popup which is a descendant of the reference window (generally reference window = NavWindow)}\par
11893         {\cf19 for} (; popup_count_to_keep < g.OpenPopupStack.Size; popup_count_to_keep++)\par
11894         \{\par
11895             ImGuiPopupData& popup = g.OpenPopupStack[popup_count_to_keep];\par
11896             {\cf19 if} (!popup.Window)\par
11897                 {\cf19 continue};\par
11898             IM_ASSERT((popup.Window->Flags & ImGuiWindowFlags_Popup) != 0);\par
11899 \par
11900             {\cf20 // Trim the stack unless the popup is a direct parent of the reference window (the reference window is often the NavWindow)}\par
11901             {\cf20 // - Clicking/Focusing Window2 won't close Popup1:}\par
11902             {\cf20 //     Window -> Popup1 -> Window2(Ref)}\par
11903             {\cf20 // - Clicking/focusing Popup1 will close Popup2 and Popup3:}\par
11904             {\cf20 //     Window -> Popup1(Ref) -> Popup2 -> Popup3}\par
11905             {\cf20 // - Each popups may contain child windows, which is why we compare ->RootWindowDockTree!}\par
11906             {\cf20 //     Window -> Popup1 -> Popup1_Child -> Popup2 -> Popup2_Child}\par
11907             {\cf20 // We step through every popup from bottom to top to validate their position relative to reference window.}\par
11908             {\cf18 bool} ref_window_is_descendent_of_popup = {\cf17 false};\par
11909             {\cf19 for} ({\cf18 int} n = popup_count_to_keep; n < g.OpenPopupStack.Size; n++)\par
11910                 {\cf19 if} (ImGuiWindow* popup_window = g.OpenPopupStack[n].Window)\par
11911                     {\cf20 //if (popup_window->RootWindowDockTree == ref_window->RootWindowDockTree) // FIXME-MERGE}\par
11912                     {\cf19 if} (IsWindowWithinBeginStackOf(ref_window, popup_window))\par
11913                     \{\par
11914                         ref_window_is_descendent_of_popup = {\cf17 true};\par
11915                         {\cf19 break};\par
11916                     \}\par
11917             {\cf19 if} (!ref_window_is_descendent_of_popup)\par
11918                 {\cf19 break};\par
11919         \}\par
11920     \}\par
11921     {\cf19 if} (popup_count_to_keep < g.OpenPopupStack.Size) {\cf20 // This test is not required but it allows to set a convenient breakpoint on the statement below}\par
11922     \{\par
11923         IMGUI_DEBUG_LOG_POPUP({\cf22 "[popup] ClosePopupsOverWindow(\\"%s\\")\\n"}, ref_window ? ref_window->Name : {\cf22 "<NULL>"});\par
11924         ClosePopupToLevel(popup_count_to_keep, restore_focus_to_window_under_popup);\par
11925     \}\par
11926 \}\par
