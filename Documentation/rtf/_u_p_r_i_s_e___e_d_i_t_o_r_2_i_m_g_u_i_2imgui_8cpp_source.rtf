17241     \{\par
17242         node->WindowClass = first_node_with_windows->Windows[0]->WindowClass;\par
17243         {\cf19 for} ({\cf18 int} n = 1; n < first_node_with_windows->Windows.Size; n++)\par
17244             {\cf19 if} (first_node_with_windows->Windows[n]->WindowClass.DockingAllowUnclassed == {\cf17 false})\par
17245             \{\par
17246                 node->WindowClass = first_node_with_windows->Windows[n]->WindowClass;\par
17247                 {\cf19 break};\par
17248             \}\par
17249     \}\par
17250 \par
17251     ImGuiDockNode* mark_node = node->CentralNode;\par
17252     {\cf19 while} (mark_node)\par
17253     \{\par
17254         mark_node->HasCentralNodeChild = {\cf17 true};\par
17255         mark_node = mark_node->ParentNode;\par
