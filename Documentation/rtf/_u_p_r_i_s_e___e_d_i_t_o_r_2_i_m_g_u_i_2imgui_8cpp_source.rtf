12893 {\cf17 static} ImVec2 ImGui::NavCalcPreferredRefPos()\par
12894 \{\par
12895     ImGuiContext& g = *GImGui;\par
12896     ImGuiWindow* window = g.NavWindow;\par
12897     {\cf17 const} {\cf18 bool} activated_shortcut = g.ActiveId != 0 && g.ActiveIdFromShortcut && g.ActiveId == g.LastItemData.ID;\par
12898 \par
12899     {\cf20 // Testing for !activated_shortcut here could in theory be removed if we decided that activating a remote shortcut altered one of the g.NavDisableXXX flag.}\par
12900     {\cf19 if} ((g.NavDisableHighlight || !g.NavDisableMouseHover || !window) && !activated_shortcut)\par
12901     \{\par
12902         {\cf20 // Mouse (we need a fallback in case the mouse becomes invalid after being used)}\par
12903         {\cf20 // The +1.0f offset when stored by OpenPopupEx() allows reopening this or another popup (same or another mouse button) while not moving the mouse, it is pretty standard.}\par
12904         {\cf20 // In theory we could move that +1.0f offset in OpenPopupEx()}\par
12905         ImVec2 p = IsMousePosValid(&g.IO.MousePos) ? g.IO.MousePos : g.MouseLastValidPos;\par
12906         {\cf19 return} ImVec2(p.x + 1.0f, p.y);\par
12907     \}\par
12908     {\cf19 else}\par
12909     \{\par
12910         {\cf20 // When navigation is active and mouse is disabled, pick a position around the bottom left of the currently navigated item}\par
12911         ImRect ref_rect;\par
12912         {\cf19 if} (activated_shortcut)\par
12913             ref_rect = g.LastItemData.NavRect;\par
12914         {\cf19 else}\par
12915             ref_rect = WindowRectRelToAbs(window, window->NavRectRel[g.NavLayer]);\par
12916 \par
12917         {\cf20 // Take account of upcoming scrolling (maybe set mouse pos should be done in EndFrame?)}\par
12918         {\cf19 if} (window->LastFrameActive != g.FrameCount && (window->ScrollTarget.x != FLT_MAX || window->ScrollTarget.y != FLT_MAX))\par
12919         \{\par
12920             ImVec2 next_scroll = CalcNextScrollFromScrollTargetAndClamp(window);\par
12921             ref_rect.Translate(window->Scroll - next_scroll);\par
12922         \}\par
12923         ImVec2 pos = ImVec2(ref_rect.Min.x + ImMin(g.Style.FramePadding.x * 4, ref_rect.GetWidth()), ref_rect.Max.y - ImMin(g.Style.FramePadding.y, ref_rect.GetHeight()));\par
12924         ImGuiViewport* viewport = window->Viewport;\par
12925         {\cf19 return} ImTrunc(ImClamp(pos, viewport->Pos, viewport->Pos + viewport->Size)); {\cf20 // ImTrunc() is important because non-integer mouse position application in backend might be lossy and result in undesirable non-zero delta.}\par
12926     \}\par
12927 \}\par
