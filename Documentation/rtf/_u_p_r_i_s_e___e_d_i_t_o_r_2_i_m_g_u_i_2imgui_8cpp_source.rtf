19034     {\cf19 if} (node == NULL)\par
19035         {\cf19 return};\par
19036     {\cf19 if} (node->IsCentralNode() && node->ParentNode)\par
19037         node->ParentNode->SetLocalFlags(node->ParentNode->LocalFlags | ImGuiDockNodeFlags_CentralNode);\par
