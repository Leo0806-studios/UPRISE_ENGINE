04797 {\cf20 // The reason this is exposed in imgui_internal.h is: on touch-based system that don't have hovering, we want to dispatch inputs to the right target (imgui vs imgui+app)}\par
04798 {\cf18 void} ImGui::UpdateHoveredWindowAndCaptureFlags()\par
04799 \{\par
04800     ImGuiContext& g = *GImGui;\par
04801     ImGuiIO& io = g.IO;\par
04802 \par
04803     {\cf20 // FIXME-DPI: This storage was added on 2021/03/31 for test engine, but if we want to multiply WINDOWS_HOVER_PADDING}\par
04804     {\cf20 // by DpiScale, we need to make this window-agnostic anyhow, maybe need storing inside ImGuiWindow.}\par
04805     g.WindowsHoverPadding = ImMax(g.Style.TouchExtraPadding, ImVec2(WINDOWS_HOVER_PADDING, WINDOWS_HOVER_PADDING));\par
04806 \par
04807     {\cf20 // Find the window hovered by mouse:}\par
04808     {\cf20 // - Child windows can extend beyond the limit of their parent so we need to derive HoveredRootWindow from HoveredWindow.}\par
04809     {\cf20 // - When moving a window we can skip the search, which also conveniently bypasses the fact that window->WindowRectClipped is lagging as this point of the frame.}\par
04810     {\cf20 // - We also support the moved window toggling the NoInputs flag after moving has started in order to be able to detect windows below it, which is useful for e.g. docking mechanisms.}\par
04811     {\cf18 bool} clear_hovered_windows = {\cf17 false};\par
04812     FindHoveredWindowEx(g.IO.MousePos, {\cf17 false}, &g.HoveredWindow, &g.HoveredWindowUnderMovingWindow);\par
04813     IM_ASSERT(g.HoveredWindow == NULL || g.HoveredWindow == g.MovingWindow || g.HoveredWindow->Viewport == g.MouseViewport);\par
04814     g.HoveredWindowBeforeClear = g.HoveredWindow;\par
04815 \par
04816     {\cf20 // Modal windows prevents mouse from hovering behind them.}\par
04817     ImGuiWindow* modal_window = GetTopMostPopupModal();\par
04818     {\cf19 if} (modal_window && g.HoveredWindow && !IsWindowWithinBeginStackOf(g.HoveredWindow->RootWindow, modal_window)) {\cf20 // FIXME-MERGE: RootWindowDockTree ?}\par
04819         clear_hovered_windows = {\cf17 true};\par
04820 \par
04821     {\cf20 // Disabled mouse hovering (we don't currently clear MousePos, we could)}\par
04822     {\cf19 if} (io.ConfigFlags & ImGuiConfigFlags_NoMouse)\par
04823         clear_hovered_windows = {\cf17 true};\par
04824 \par
04825     {\cf20 // We track click ownership. When clicked outside of a window the click is owned by the application and}\par
04826     {\cf20 // won't report hovering nor request capture even while dragging over our windows afterward.}\par
04827     {\cf17 const} {\cf18 bool} has_open_popup = (g.OpenPopupStack.Size > 0);\par
04828     {\cf17 const} {\cf18 bool} has_open_modal = (modal_window != NULL);\par
04829     {\cf18 int} mouse_earliest_down = -1;\par
04830     {\cf18 bool} mouse_any_down = {\cf17 false};\par
04831     {\cf19 for} ({\cf18 int} i = 0; i < IM_ARRAYSIZE(io.MouseDown); i++)\par
