15119 {\cf20 // Update viewports and monitor infos}\par
15120 {\cf20 // Note that this is running even if 'ImGuiConfigFlags_ViewportsEnable' is not set, in order to clear unused viewports (if any) and update monitor info.}\par
15121 {\cf17 static} {\cf18 void} ImGui::UpdateViewportsNewFrame()\par
15122 \{\par
15123     ImGuiContext& g = *GImGui;\par
15124     IM_ASSERT(g.PlatformIO.Viewports.Size <= g.Viewports.Size);\par
15125 \par
15126     {\cf20 // Update Minimized status (we need it first in order to decide if we'll apply Pos/Size of the main viewport)}\par
15127     {\cf20 // Update Focused status}\par
15128     {\cf17 const} {\cf18 bool} viewports_enabled = (g.ConfigFlagsCurrFrame & ImGuiConfigFlags_ViewportsEnable) != 0;\par
15129     {\cf19 if} (viewports_enabled)\par
15130     \{\par
15131         ImGuiViewportP* focused_viewport = NULL;\par
15132         {\cf19 for} (ImGuiViewportP* viewport : g.Viewports)\par
15133         \{\par
15134             {\cf17 const} {\cf18 bool} platform_funcs_available = viewport->PlatformWindowCreated;\par
15135             {\cf19 if} (g.PlatformIO.Platform_GetWindowMinimized && platform_funcs_available)\par
15136             \{\par
15137                 {\cf18 bool} is_minimized = g.PlatformIO.Platform_GetWindowMinimized(viewport);\par
15138                 {\cf19 if} (is_minimized)\par
15139                     viewport->Flags |= ImGuiViewportFlags_IsMinimized;\par
15140                 {\cf19 else}\par
15141                     viewport->Flags &= ~ImGuiViewportFlags_IsMinimized;\par
15142             \}\par
15143 \par
15144             {\cf20 // Update our implicit z-order knowledge of platform windows, which is used when the backend cannot provide io.MouseHoveredViewport.}\par
15145             {\cf20 // When setting Platform_GetWindowFocus, it is expected that the platform backend can handle calls without crashing if it doesn't have data stored.}\par
15146             {\cf19 if} (g.PlatformIO.Platform_GetWindowFocus && platform_funcs_available)\par
15147             \{\par
15148                 {\cf18 bool} is_focused = g.PlatformIO.Platform_GetWindowFocus(viewport);\par
15149                 {\cf19 if} (is_focused)\par
15150                     viewport->Flags |= ImGuiViewportFlags_IsFocused;\par
15151                 {\cf19 else}\par
15152                     viewport->Flags &= ~ImGuiViewportFlags_IsFocused;\par
15153                 {\cf19 if} (is_focused)\par
15154                     focused_viewport = viewport;\par
15155             \}\par
15156         \}\par
15157 \par
15158         {\cf20 // Focused viewport has changed?}\par
15159         {\cf19 if} (focused_viewport && g.PlatformLastFocusedViewportId != focused_viewport->ID)\par
15160         \{\par
15161             IMGUI_DEBUG_LOG_VIEWPORT({\cf22 "[viewport] Focused viewport changed %08X -> %08X, attempting to apply our focus.\\n"}, g.PlatformLastFocusedViewportId, focused_viewport->ID);\par
15162             {\cf17 const} ImGuiViewport* prev_focused_viewport = FindViewportByID(g.PlatformLastFocusedViewportId);\par
15163             {\cf17 const} {\cf18 bool} prev_focused_has_been_destroyed = (prev_focused_viewport == NULL) || (prev_focused_viewport->PlatformWindowCreated == {\cf17 false});\par
15164 \par
15165             {\cf20 // Store a tag so we can infer z-order easily from all our windows}\par
15166             {\cf20 // We compare PlatformLastFocusedViewportId so newly created viewports with _NoFocusOnAppearing flag}\par
15167             {\cf20 // will keep the front most stamp instead of losing it back to their parent viewport.}\par
15168             {\cf19 if} (focused_viewport->LastFocusedStampCount != g.ViewportFocusedStampCount)\par
15169                 focused_viewport->LastFocusedStampCount = ++g.ViewportFocusedStampCount;\par
15170             g.PlatformLastFocusedViewportId = focused_viewport->ID;\par
15171 \par
15172             {\cf20 // Focus associated dear imgui window}\par
15173             {\cf20 // - if focus didn't happen with a click within imgui boundaries, e.g. Clicking platform title bar. (#6299)}\par
15174             {\cf20 // - if focus didn't happen because we destroyed another window (#6462)}\par
15175             {\cf20 // FIXME: perhaps 'FocusTopMostWindowUnderOne()' can handle the 'focused_window->Window != NULL' case as well.}\par
15176             {\cf17 const} {\cf18 bool} apply_imgui_focus_on_focused_viewport = !IsAnyMouseDown() && !prev_focused_has_been_destroyed;\par
15177             {\cf19 if} (apply_imgui_focus_on_focused_viewport)\par
15178             \{\par
15179                 focused_viewport->LastFocusedHadNavWindow |= (g.NavWindow != NULL) && (g.NavWindow->Viewport == focused_viewport); {\cf20 // Update so a window changing viewport won't lose focus.}\par
15180                 ImGuiFocusRequestFlags focus_request_flags = ImGuiFocusRequestFlags_UnlessBelowModal | ImGuiFocusRequestFlags_RestoreFocusedChild;\par
15181                 {\cf19 if} (focused_viewport->Window != NULL)\par
15182                     FocusWindow(focused_viewport->Window, focus_request_flags);\par
15183                 {\cf19 else} {\cf19 if} (focused_viewport->LastFocusedHadNavWindow)\par
15184                     FocusTopMostWindowUnderOne(NULL, NULL, focused_viewport, focus_request_flags); {\cf20 // Focus top most in viewport}\par
15185                 {\cf19 else}\par
15186                     FocusWindow(NULL, focus_request_flags); {\cf20 // No window had focus last time viewport was focused}\par
15187             \}\par
15188         \}\par
15189         {\cf19 if} (focused_viewport)\par
15190             focused_viewport->LastFocusedHadNavWindow = (g.NavWindow != NULL) && (g.NavWindow->Viewport == focused_viewport);\par
15191     \}\par
15192 \par
15193     {\cf20 // Create/update main viewport with current platform position.}\par
15194     {\cf20 // FIXME-VIEWPORT: Size is driven by backend/user code for backward-compatibility but we should aim to make this more consistent.}\par
15195     ImGuiViewportP* main_viewport = g.Viewports[0];\par
15196     IM_ASSERT(main_viewport->ID == IMGUI_VIEWPORT_DEFAULT_ID);\par
15197     IM_ASSERT(main_viewport->Window == NULL);\par
15198     ImVec2 main_viewport_pos = viewports_enabled ? g.PlatformIO.Platform_GetWindowPos(main_viewport) : ImVec2(0.0f, 0.0f);\par
15199     ImVec2 main_viewport_size = g.IO.DisplaySize;\par
15200     {\cf19 if} (viewports_enabled && (main_viewport->Flags & ImGuiViewportFlags_IsMinimized))\par
15201     \{\par
15202         main_viewport_pos = main_viewport->Pos;    {\cf20 // Preserve last pos/size when minimized (FIXME: We don't do the same for Size outside of the viewport path)}\par
15203         main_viewport_size = main_viewport->Size;\par
15204     \}\par
15205     AddUpdateViewport(NULL, IMGUI_VIEWPORT_DEFAULT_ID, main_viewport_pos, main_viewport_size, ImGuiViewportFlags_OwnedByApp | ImGuiViewportFlags_CanHostOtherWindows);\par
15206 \par
15207     g.CurrentDpiScale = 0.0f;\par
15208     g.CurrentViewport = NULL;\par
15209     g.MouseViewport = NULL;\par
15210     {\cf19 for} ({\cf18 int} n = 0; n < g.Viewports.Size; n++)\par
15211     \{\par
15212         ImGuiViewportP* viewport = g.Viewports[n];\par
15213         viewport->Idx = n;\par
15214 \par
15215         {\cf20 // Erase unused viewports}\par
15216         {\cf19 if} (n > 0 && viewport->LastFrameActive < g.FrameCount - 2)\par
15217         \{\par
15218             DestroyViewport(viewport);\par
15219             n--;\par
15220             {\cf19 continue};\par
15221         \}\par
15222 \par
15223         {\cf17 const} {\cf18 bool} platform_funcs_available = viewport->PlatformWindowCreated;\par
15224         {\cf19 if} (viewports_enabled)\par
15225         \{\par
15226             {\cf20 // Update Position and Size (from Platform Window to ImGui) if requested.}\par
15227             {\cf20 // We do it early in the frame instead of waiting for UpdatePlatformWindows() to avoid a frame of lag when moving/resizing using OS facilities.}\par
15228             {\cf19 if} (!(viewport->Flags & ImGuiViewportFlags_IsMinimized) && platform_funcs_available)\par
15229             \{\par
15230                 {\cf20 // Viewport->WorkPos and WorkSize will be updated below}\par
15231                 {\cf19 if} (viewport->PlatformRequestMove)\par
15232                     viewport->Pos = viewport->LastPlatformPos = g.PlatformIO.Platform_GetWindowPos(viewport);\par
15233                 {\cf19 if} (viewport->PlatformRequestResize)\par
15234                     viewport->Size = viewport->LastPlatformSize = g.PlatformIO.Platform_GetWindowSize(viewport);\par
15235             \}\par
15236         \}\par
15237 \par
15238         {\cf20 // Update/copy monitor info}\par
15239         UpdateViewportPlatformMonitor(viewport);\par
15240 \par
15241         {\cf20 // Lock down space taken by menu bars and status bars + query initial insets from backend}\par
15242         {\cf20 // Setup initial value for functions like BeginMainMenuBar(), DockSpaceOverViewport() etc.}\par
15243         viewport->WorkInsetMin = viewport->BuildWorkInsetMin;\par
15244         viewport->WorkInsetMax = viewport->BuildWorkInsetMax;\par
15245         viewport->BuildWorkInsetMin = viewport->BuildWorkInsetMax = ImVec2(0.0f, 0.0f);\par
15246         {\cf19 if} (g.PlatformIO.Platform_GetWindowWorkAreaInsets != NULL && platform_funcs_available)\par
15247         \{\par
15248             ImVec4 insets = g.PlatformIO.Platform_GetWindowWorkAreaInsets(viewport);\par
15249             IM_ASSERT(insets.x >= 0.0f && insets.y >= 0.0f && insets.z >= 0.0f && insets.w >= 0.0f);\par
15250             viewport->BuildWorkInsetMin = ImVec2(insets.x, insets.y);\par
15251             viewport->BuildWorkInsetMax = ImVec2(insets.z, insets.w);\par
15252         \}\par
15253         viewport->UpdateWorkRect();\par
15254 \par
15255         {\cf20 // Reset alpha every frame. Users of transparency (docking) needs to request a lower alpha back.}\par
15256         viewport->Alpha = 1.0f;\par
15257 \par
15258         {\cf20 // Translate Dear ImGui windows when a Host Viewport has been moved}\par
15259         {\cf20 // (This additionally keeps windows at the same place when ImGuiConfigFlags_ViewportsEnable is toggled!)}\par
15260         {\cf17 const} ImVec2 viewport_delta_pos = viewport->Pos - viewport->LastPos;\par
15261         {\cf19 if} ((viewport->Flags & ImGuiViewportFlags_CanHostOtherWindows) && (viewport_delta_pos.x != 0.0f || viewport_delta_pos.y != 0.0f))\par
15262             TranslateWindowsInViewport(viewport, viewport->LastPos, viewport->Pos);\par
15263 \par
15264         {\cf20 // Update DPI scale}\par
15265         {\cf18 float} new_dpi_scale;\par
15266         {\cf19 if} (g.PlatformIO.Platform_GetWindowDpiScale && platform_funcs_available)\par
15267             new_dpi_scale = g.PlatformIO.Platform_GetWindowDpiScale(viewport);\par
15268         {\cf19 else} {\cf19 if} (viewport->PlatformMonitor != -1)\par
15269             new_dpi_scale = g.PlatformIO.Monitors[viewport->PlatformMonitor].DpiScale;\par
15270         {\cf19 else}\par
15271             new_dpi_scale = (viewport->DpiScale != 0.0f) ? viewport->DpiScale : 1.0f;\par
15272         {\cf19 if} (viewport->DpiScale != 0.0f && new_dpi_scale != viewport->DpiScale)\par
15273         \{\par
15274             {\cf18 float} scale_factor = new_dpi_scale / viewport->DpiScale;\par
15275             {\cf19 if} (g.IO.ConfigFlags & ImGuiConfigFlags_DpiEnableScaleViewports)\par
15276                 ScaleWindowsInViewport(viewport, scale_factor);\par
15277             {\cf20 //if (viewport == GetMainViewport())}\par
15278             {\cf20 //    g.PlatformInterface.SetWindowSize(viewport, viewport->Size * scale_factor);}\par
15279 \par
15280             {\cf20 // Scale our window moving pivot so that the window will rescale roughly around the mouse position.}\par
15281             {\cf20 // FIXME-VIEWPORT: This currently creates a resizing feedback loop when a window is straddling a DPI transition border.}\par
15282             {\cf20 // (Minor: since our sizes do not perfectly linearly scale, deferring the click offset scale until we know the actual window scale ratio may get us slightly more precise mouse positioning.)}\par
15283             {\cf20 //if (g.MovingWindow != NULL && g.MovingWindow->Viewport == viewport)}\par
15284             {\cf20 //    g.ActiveIdClickOffset = ImTrunc(g.ActiveIdClickOffset * scale_factor);}\par
15285         \}\par
15286         viewport->DpiScale = new_dpi_scale;\par
15287     \}\par
15288 \par
15289     {\cf20 // Update fallback monitor}\par
15290     g.PlatformMonitorsFullWorkRect = ImRect(+FLT_MAX, +FLT_MAX, -FLT_MAX, -FLT_MAX);\par
15291     {\cf19 if} (g.PlatformIO.Monitors.Size == 0)\par
15292     \{\par
15293         ImGuiPlatformMonitor* monitor = &g.FallbackMonitor;\par
