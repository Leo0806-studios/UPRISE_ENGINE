00082 {\cf17 template} <{\cf17 typename} Type>\par
00083 AI_FORCE_INLINE aiReturn aiMaterial::Get({\cf17 const} {\cf18 char}* pKey,{\cf18 unsigned} {\cf18 int} type,\par
00084         {\cf18 unsigned} {\cf18 int} idx, Type* pOut,\par
00085         {\cf18 unsigned} {\cf18 int}* pMax){\cf17  const }\{\par
