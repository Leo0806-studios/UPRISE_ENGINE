00090         ({\cf17 const} aiMaterialProperty**)&prop);\par
00091     {\cf19 if} ( AI_SUCCESS == ret )    \{\par
00092 \par
00093         {\cf19 if} (prop->mDataLength < {\cf17 sizeof}(Type)*iNum) \{\par
00094             {\cf19 return} AI_FAILURE;\par
00095         \}\par
00096 \par
00097         {\cf19 if} (prop->mType != aiPTI_Buffer) \{\par
00098             {\cf19 return} AI_FAILURE;\par
00099         \}\par
00100 \par
00101         iNum = {\cf17 static_cast<}{\cf18 unsigned} {\cf18 int}{\cf17 >}(std::min({\cf17 static_cast<}{\cf18 size_t}{\cf17 >}(iNum),prop->mDataLength / {\cf17 sizeof}(Type)));\par
00102         ::memcpy(pOut,prop->mData,iNum * {\cf17 sizeof}(Type));\par
00103         {\cf19 if} (pMax) \{\par
00104             *pMax = iNum;\par
00105         \}\par
00106     \}\par
00107     {\cf19 return} ret;\par
00108 \}\par
