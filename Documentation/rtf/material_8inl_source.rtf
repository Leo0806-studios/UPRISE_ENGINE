00133 {\cf20 // Specialisation for a single bool.}\par
00134 {\cf20 // Casts floating point and integer to bool}\par
00135 {\cf17 template} <>\par
00136 AI_FORCE_INLINE\par
00137         aiReturn\par
00138         aiMaterial::Get({\cf17 const} {\cf18 char} *pKey, {\cf18 unsigned} {\cf18 int} type,\par
00139                 {\cf18 unsigned} {\cf18 int} idx, {\cf18 bool} &pOut){\cf17  const }\{\par
00140     {\cf17 const} aiMaterialProperty *prop;\par
00141     {\cf17 const} aiReturn ret = ::aiGetMaterialProperty({\cf17 this}, pKey, type, idx,\par
00142             ({\cf17 const} aiMaterialProperty **)&prop);\par
00143     {\cf19 if} (AI_SUCCESS == ret) \{\par
00144 \par
00145         {\cf19 switch} (prop->mType) \{\par
00146             {\cf20 // Type cannot be converted}\par
00147         {\cf19 default}: {\cf19 return} AI_FAILURE;\par
00148 \par
00149         {\cf19 case} aiPTI_Buffer: \{\par
00150             {\cf20 // Native bool value storage}\par
00151             {\cf19 if} (prop->mDataLength < {\cf17 sizeof}({\cf18 bool})) \{\par
00152                 {\cf19 return} AI_FAILURE;\par
00153             \}\par
00154             ::memcpy(&pOut, prop->mData, {\cf17 sizeof}({\cf18 bool}));\par
00155         \} {\cf19 break};\par
00156 \par
00157         {\cf19 case} aiPTI_Float:\par
00158         {\cf19 case} aiPTI_Double: \{\par
00159             {\cf20 // Read as float and cast to bool}\par
00160             ai_real value = 0.0f;\par
00161             {\cf19 if} (AI_SUCCESS == ::aiGetMaterialFloat({\cf17 this}, pKey, type, idx, &value)) \{\par
00162                 pOut = {\cf17 static_cast<}{\cf18 bool}{\cf17 >}(value);\par
00163                 {\cf19 return} AI_SUCCESS;\par
00164             \}\par
00165             {\cf19 return} AI_FAILURE;\par
00166         \}\par
00167         {\cf19 case} aiPTI_Integer: \{\par
00168             {\cf20 // Cast to bool}\par
00169             {\cf17 const} {\cf18 int} value = {\cf17 static_cast<}{\cf18 int}{\cf17 >}(*prop->mData);\par
00170             pOut = {\cf17 static_cast<}{\cf18 bool}{\cf17 >}(value);\par
00171             {\cf19 return} AI_SUCCESS;\par
00172         \}\par
00173         \}\par
00174     \}\par
00175     {\cf19 return} ret;\par
00176 \}\par
