975 {\cf20 // Helper function to decide the highest shader model supported by the system}\par
976 {\cf20 // Stores the result in m_dShaderModel}\par
977 {\cf20 // Must be updated whenever a new shader model is added to the d3d12.h header}\par
978 {\cf17 inline} HRESULT CD3DX12FeatureSupport::QueryHighestShaderModel()\par
979 \{\par
980     {\cf20 // Check support in descending order}\par
981     HRESULT result;\par
982 \par
983     {\cf17 const} D3D_SHADER_MODEL allModelVersions[] =\par
984     \{\par
985 {\cf21 #if defined(D3D12_SDK_VERSION) && (D3D12_SDK_VERSION >= 612)}\par
986         D3D_SHADER_MODEL_6_9,\par
987 {\cf21 #endif}\par
988 {\cf21 #if defined(D3D12_SDK_VERSION) && (D3D12_SDK_VERSION >= 606)}\par
989         D3D_SHADER_MODEL_6_8,\par
990 {\cf21 #endif}\par
991 {\cf21 #if defined(D3D12_SDK_VERSION) && (D3D12_SDK_VERSION >= 3)}\par
992         D3D_SHADER_MODEL_6_7,\par
993 {\cf21 #endif}\par
994         D3D_SHADER_MODEL_6_6,\par
995         D3D_SHADER_MODEL_6_5,\par
996         D3D_SHADER_MODEL_6_4,\par
997         D3D_SHADER_MODEL_6_3,\par
998         D3D_SHADER_MODEL_6_2,\par
999         D3D_SHADER_MODEL_6_1,\par
1000         D3D_SHADER_MODEL_6_0,\par
1001         D3D_SHADER_MODEL_5_1\par
1002     \};\par
1003     {\cf17 constexpr} {\cf18 size_t} numModelVersions = {\cf17 sizeof}(allModelVersions) / {\cf17 sizeof}(D3D_SHADER_MODEL);\par
1004 \par
1005     {\cf19 for} ({\cf18 size_t} i = 0; i < numModelVersions; i++)\par
1006     \{\par
1007         m_dShaderModel.HighestShaderModel = allModelVersions[i];\par
1008         result = m_pDevice->CheckFeatureSupport(D3D12_FEATURE_SHADER_MODEL, &m_dShaderModel, {\cf17 sizeof}(D3D12_FEATURE_DATA_SHADER_MODEL));\par
1009         {\cf19 if} (result != E_INVALIDARG)\par
1010         \{\par
1011             {\cf20 // Indicates that the version is recognizable by the runtime and stored in the struct}\par
1012             {\cf20 // Also terminate on unexpected error code}\par
1013             {\cf19 if} (FAILED(result))\par
1014             \{\par
1015                 m_dShaderModel.HighestShaderModel = {\cf17 static_cast<}D3D_SHADER_MODEL{\cf17 >}(0);\par
1016             \}\par
1017             {\cf19 return} result;\par
1018         \}\par
1019     \}\par
1020 \par
1021     {\cf20 // Shader model may not be supported. Continue the rest initializations}\par
1022     m_dShaderModel.HighestShaderModel = {\cf17 static_cast<}D3D_SHADER_MODEL{\cf17 >}(0);\par
1023     {\cf19 return} S_OK;\par
1024 \}\par
1025 \par
1026 {\cf20 // Helper function to decide the highest root signature supported}\par
1027 {\cf20 // Must be updated whenever a new root signature version is added to the d3d12.h header}\par
1028 {\cf17 inline} HRESULT CD3DX12FeatureSupport::QueryHighestRootSignatureVersion()\par
1029 \{\par
1030     HRESULT result;\par
1031 \par
1032     {\cf17 const} D3D_ROOT_SIGNATURE_VERSION allRootSignatureVersions[] =\par
1033     \{\par
1034 {\cf21 #if defined(D3D12_SDK_VERSION) && (D3D12_SDK_VERSION >= 609)}\par
1035         D3D_ROOT_SIGNATURE_VERSION_1_2,\par
1036 {\cf21 #endif}\par
1037         D3D_ROOT_SIGNATURE_VERSION_1_1,\par
1038         D3D_ROOT_SIGNATURE_VERSION_1_0,\par
1039         D3D_ROOT_SIGNATURE_VERSION_1,\par
1040     \};\par
1041     {\cf17 constexpr} {\cf18 size_t} numRootSignatureVersions = {\cf17 sizeof}(allRootSignatureVersions) / {\cf17 sizeof}(D3D_ROOT_SIGNATURE_VERSION);\par
1042 \par
1043     {\cf19 for} ({\cf18 size_t} i = 0; i < numRootSignatureVersions; i++)\par
1044     \{\par
1045         m_dRootSignature.HighestVersion = allRootSignatureVersions[i];\par
1046         result = m_pDevice->CheckFeatureSupport(D3D12_FEATURE_ROOT_SIGNATURE, &m_dRootSignature, {\cf17 sizeof}(D3D12_FEATURE_DATA_ROOT_SIGNATURE));\par
1047         {\cf19 if} (result != E_INVALIDARG)\par
1048         \{\par
1049             {\cf19 if} (FAILED(result))\par
1050             \{\par
1051                 m_dRootSignature.HighestVersion = {\cf17 static_cast<}D3D_ROOT_SIGNATURE_VERSION{\cf17 >}(0);\par
1052             \}\par
1053             {\cf20 // If succeeded, the highest version is already written into the member struct}\par
1054             {\cf19 return} result;\par
1055         \}\par
1056     \}\par
1057 \par
1058     {\cf20 // No version left. Set to invalid value and continue.}\par
1059     m_dRootSignature.HighestVersion = {\cf17 static_cast<}D3D_ROOT_SIGNATURE_VERSION{\cf17 >}(0);\par
1060     {\cf19 return} S_OK;\par
1061 \}\par
1062 \par
1063 {\cf20 // Helper funcion to decide the highest feature level}\par
1064 {\cf17 inline} HRESULT CD3DX12FeatureSupport::QueryHighestFeatureLevel()\par
1065 \{\par
1066     HRESULT result;\par
1067 \par
1068     {\cf20 // Check against a list of all feature levels present in d3dcommon.h}\par
1069     {\cf20 // Needs to be updated for future feature levels}\par
1070     {\cf17 const} D3D_FEATURE_LEVEL allLevels[] =\par
1071     \{\par
1072 {\cf21 #if defined(D3D12_SDK_VERSION) && (D3D12_SDK_VERSION >= 3)}\par
1073         D3D_FEATURE_LEVEL_12_2,\par
1074 {\cf21 #endif}\par
1075         D3D_FEATURE_LEVEL_12_1,\par
1076         D3D_FEATURE_LEVEL_12_0,\par
1077         D3D_FEATURE_LEVEL_11_1,\par
1078         D3D_FEATURE_LEVEL_11_0,\par
1079         D3D_FEATURE_LEVEL_10_1,\par
1080         D3D_FEATURE_LEVEL_10_0,\par
1081         D3D_FEATURE_LEVEL_9_3,\par
1082         D3D_FEATURE_LEVEL_9_2,\par
1083         D3D_FEATURE_LEVEL_9_1,\par
1084 {\cf21 #if defined(D3D12_SDK_VERSION) && (D3D12_SDK_VERSION >= 5)}\par
1085         D3D_FEATURE_LEVEL_1_0_CORE,\par
1086 {\cf21 #endif}\par
1087 {\cf21 #if defined(D3D12_SDK_VERSION) && (D3D12_SDK_VERSION >= 611)}\par
1088         D3D_FEATURE_LEVEL_1_0_GENERIC\par
1089 {\cf21 #endif}\par
1090     \};\par
1091 \par
1092     D3D12_FEATURE_DATA_FEATURE_LEVELS dFeatureLevel;\par
1093     dFeatureLevel.NumFeatureLevels = {\cf17 static_cast<}UINT{\cf17 >}({\cf17 sizeof}(allLevels) / {\cf17 sizeof}(D3D_FEATURE_LEVEL));\par
1094     dFeatureLevel.pFeatureLevelsRequested = allLevels;\par
1095 \par
1096     result = m_pDevice->CheckFeatureSupport(D3D12_FEATURE_FEATURE_LEVELS, &dFeatureLevel, {\cf17 sizeof}(D3D12_FEATURE_DATA_FEATURE_LEVELS));\par
1097     {\cf19 if} (SUCCEEDED(result))\par
1098     \{\par
1099         m_eMaxFeatureLevel = dFeatureLevel.MaxSupportedFeatureLevel;\par
1100     \}\par
1101     {\cf19 else}\par
1102     \{\par
1103         m_eMaxFeatureLevel = {\cf17 static_cast<}D3D_FEATURE_LEVEL{\cf17 >}(0);\par
1104 \par
1105         {\cf19 if} (result == DXGI_ERROR_UNSUPPORTED)\par
1106         \{\par
1107             {\cf20 // Indicates that none supported. Continue initialization}\par
1108             result = S_OK;\par
1109         \}\par
1110     \}\par
1111     {\cf19 return} result;\par
1112 \}\par
