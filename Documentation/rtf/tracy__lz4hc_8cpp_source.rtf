00744             {\cf19 if} (limit == limitedOutput) {\cf19 return} 0;\par
00745             {\cf20 /* adapt lastRunSize to fill 'dest' */}\par
00746             lastRunSize  = (size_t)(oend - op) - 1 {\cf20 /*token*/};\par
00747             llAdd = (lastRunSize + 256 - RUN_MASK) / 256;\par
00748             lastRunSize -= llAdd;\par
00749         \}\par
00750         DEBUGLOG(6, {\cf22 "Final literal run : %i literals"}, ({\cf18 int})lastRunSize);\par
00751         ip = anchor + lastRunSize;  {\cf20 /* can be != iend if limit==fillOutput */}\par
00752 \par
00753         {\cf19 if} (lastRunSize >= RUN_MASK) \{\par
00754             {\cf18 size_t} accumulator = lastRunSize - RUN_MASK;\par
00755             *op++ = (RUN_MASK << ML_BITS);\par
00756             {\cf19 for}(; accumulator >= 255 ; accumulator -= 255) *op++ = 255;\par
00757             *op++ = (BYTE) accumulator;\par
00758         \} {\cf19 else} \{\par
00759             *op++ = (BYTE)(lastRunSize << ML_BITS);\par
00760         \}\par
00761         LZ4_memcpy(op, anchor, lastRunSize);\par
00762         op += lastRunSize;\par
00763     \}\par
00764 \par
00765     {\cf20 /* End */}\par
00766     *srcSizePtr = (int) ((({\cf17 const} {\cf18 char}*)ip) - source);\par
00767     {\cf19 return} ({\cf18 int}) ((({\cf18 char}*)op)-dest);\par
00768 \par
00769 _dest_overflow:\par
00770     {\cf19 if} (limit == fillOutput) \{\par
00771         {\cf20 /* Assumption : ip, anchor, ml and ref must be set correctly */}\par
00772         {\cf18 size_t} {\cf17 const} ll = (size_t)(ip - anchor);\par
00773         {\cf18 size_t} {\cf17 const} ll_addbytes = (ll + 240) / 255;\par
00774         {\cf18 size_t} {\cf17 const} ll_totalCost = 1 + ll_addbytes + ll;\par
