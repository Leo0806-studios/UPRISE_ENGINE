00675                     {\cf18 int} correction = (int)(ip+ml - start2);\par
00676                     start2 += correction;\par
00677                     ref2 += correction;\par
00678                     ml2 -= correction;\par
00679                     {\cf19 if} (ml2 < MINMATCH) \{\par
00680                         start2 = start3;\par
00681                         ref2 = ref3;\par
00682                         ml2 = ml3;\par
00683                     \}\par
00684                 \}\par
00685 \par
00686                 optr = op;\par
00687                 {\cf19 if} (LZ4HC_encodeSequence(UPDATABLE(ip, op, anchor), ml, ref, limit, oend)) {\cf19 goto} _dest_overflow;\par
00688                 ip  = start3;\par
00689                 ref = ref3;\par
00690                 ml  = ml3;\par
00691 \par
00692                 start0 = start2;\par
00693                 ref0 = ref2;\par
00694                 ml0 = ml2;\par
00695                 {\cf19 goto} _Search2;\par
00696             \}\par
00697 \par
00698             start2 = start3;\par
00699             ref2 = ref3;\par
00700             ml2 = ml3;\par
00701             {\cf19 goto} _Search3;\par
00702         \}\par
00703 \par
00704         {\cf20 /*}\par
00705 {\cf20         * OK, now we have 3 ascending matches;}\par
00706 {\cf20         * let's write the first one ML1.}\par
00707 {\cf20         * ip & ref are known; Now decide ml.}\par
00708 {\cf20         */}\par
00709         {\cf19 if} (start2 < ip+ml) \{\par
00710             {\cf19 if} ((start2 - ip) < OPTIMAL_ML) \{\par
00711                 {\cf18 int} correction;\par
00712                 {\cf19 if} (ml > OPTIMAL_ML) ml = OPTIMAL_ML;\par
00713                 {\cf19 if} (ip + ml > start2 + ml2 - MINMATCH) ml = (int)(start2 - ip) + ml2 - MINMATCH;\par
00714                 correction = ml - (int)(start2 - ip);\par
