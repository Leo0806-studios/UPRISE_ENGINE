00470 LZ4_FORCE_INLINE {\cf18 int} LZ4HC_encodeSequence (\par
00471     {\cf17 const} BYTE** _ip,\par
00472     BYTE** _op,\par
00473     {\cf17 const} BYTE** _anchor,\par
00474     {\cf18 int} matchLength,\par
00475     {\cf17 const} BYTE* {\cf17 const} match,\par
00476     limitedOutput_directive limit,\par
00477     BYTE* oend)\par
00478 \{\par
00479 {\cf21 #define ip      (*_ip)}\par
00480 {\cf21 #define op      (*_op)}\par
00481 {\cf21 #define anchor  (*_anchor)}\par
00482 \par
00483     {\cf18 size_t} length;\par
00484     BYTE* {\cf17 const} token = op++;\par
00485 \par
00486 {\cf21 #if defined(LZ4_DEBUG) && (LZ4_DEBUG >= 6)}\par
00487     {\cf17 static} {\cf17 const} BYTE* start = NULL;\par
00488     {\cf17 static} U32 totalCost = 0;\par
00489     U32 {\cf17 const} pos = (start==NULL) ? 0 : (U32)(anchor - start);\par
00490     U32 {\cf17 const} ll = (U32)(ip - anchor);\par
00491     U32 {\cf17 const} llAdd = (ll>=15) ? ((ll-15) / 255) + 1 : 0;\par
00492     U32 {\cf17 const} mlAdd = (matchLength>=19) ? ((matchLength-19) / 255) + 1 : 0;\par
00493     U32 {\cf17 const} cost = 1 + llAdd + ll + 2 + mlAdd;\par
00494     {\cf19 if} (start==NULL) start = anchor;  {\cf20 /* only works for single segment */}\par
00495     {\cf20 /* g_debuglog_enable = (pos >= 2228) & (pos <= 2262); */}\par
00496     DEBUGLOG(6, {\cf22 "pos:%7u -- literals:%4u, match:%4i, offset:%5u, cost:%4u + %5u"},\par
00497                 pos,\par
00498                 (U32)(ip - anchor), matchLength, (U32)(ip-match),\par
00499                 cost, totalCost);\par
00500     totalCost += cost;\par
00501 {\cf21 #endif}\par
00502 \par
00503     {\cf20 /* Encode Literal length */}\par
00504     length = (size_t)(ip - anchor);\par
00505     LZ4_STATIC_ASSERT(notLimited == 0);\par
00506     {\cf20 /* Check output limit */}\par
00507     {\cf19 if} (limit && ((op + (length / 255) + length + (2 + 1 + LASTLITERALS)) > oend)) \{\par
00508         DEBUGLOG(6, {\cf22 "Not enough room to write %i literals (%i bytes remaining)"},\par
00509                 ({\cf18 int})length, ({\cf18 int})(oend - op));\par
00510         {\cf19 return} 1;\par
00511     \}\par
00512     {\cf19 if} (length >= RUN_MASK) \{\par
00513         {\cf18 size_t} len = length - RUN_MASK;\par
00514         *token = (RUN_MASK << ML_BITS);\par
00515         {\cf19 for}(; len >= 255 ; len -= 255) *op++ = 255;\par
00516         *op++ = (BYTE)len;\par
00517     \} {\cf19 else} \{\par
00518         *token = (BYTE)(length << ML_BITS);\par
00519     \}\par
00520 \par
00521     {\cf20 /* Copy Literals */}\par
00522     LZ4_wildCopy8(op, anchor, op + length);\par
