01078     \}\par
01079     {\cf20 /* need a full initialization, there are bad side-effects when using resetFast() */}\par
01080     \{   {\cf18 int} {\cf17 const} cLevel = ctxPtr->compressionLevel;\par
01081         LZ4_initStreamHC(LZ4_streamHCPtr, {\cf17 sizeof}(*LZ4_streamHCPtr));\par
01082         LZ4_setCompressionLevel(LZ4_streamHCPtr, cLevel);\par
