00177 {\cf20 /* LZ4HC_countPattern() :}\par
00178 {\cf20  * pattern32 must be a sample of repetitive pattern of length 1, 2 or 4 (but not 3!) */}\par
00179 {\cf17 static} {\cf18 unsigned}\par
00180 LZ4HC_countPattern({\cf17 const} BYTE* ip, {\cf17 const} BYTE* {\cf17 const} iEnd, U32 {\cf17 const} pattern32)\par
00181 \{\par
00182     {\cf17 const} BYTE* {\cf17 const} iStart = ip;\par
00183     reg_t {\cf17 const} pattern = ({\cf17 sizeof}(pattern)==8) ?\par
00184         (reg_t)pattern32 + (((reg_t)pattern32) << ({\cf17 sizeof}(pattern)*4)) : pattern32;\par
00185 \par
00186     {\cf19 while} (likely(ip < iEnd-({\cf17 sizeof}(pattern)-1))) \{\par
00187         reg_t {\cf17 const} diff = LZ4_read_ARCH(ip) ^ pattern;\par
00188         {\cf19 if} (!diff) \{ ip+={\cf17 sizeof}(pattern); {\cf19 continue}; \}\par
00189         ip += LZ4_NbCommonBytes(diff);\par
00190         {\cf19 return} ({\cf18 unsigned})(ip - iStart);\par
00191     \}\par
00192 \par
00193     {\cf19 if} (LZ4_isLittleEndian()) \{\par
00194         reg_t patternByte = pattern;\par
00195         {\cf19 while} ((ip<iEnd) && (*ip == (BYTE)patternByte)) \{\par
00196             ip++; patternByte >>= 8;\par
00197         \}\par
00198     \} {\cf19 else} \{  {\cf20 /* big endian */}\par
00199         U32 bitOffset = ({\cf17 sizeof}(pattern)*8) - 8;\par
00200         {\cf19 while} (ip < iEnd) \{\par
00201             BYTE {\cf17 const} {\cf18 byte} = (BYTE)(pattern >> bitOffset);\par
00202             {\cf19 if} (*ip != {\cf18 byte}) {\cf19 break};\par
00203             ip ++; bitOffset -= 8;\par
00204     \}   \}\par
00205 \par
00206     {\cf19 return} ({\cf18 unsigned})(ip - iStart);\par
00207 \}\par
