01608      {\cf20 /* Assumption : ip, anchor, ovml and ovref must be set correctly */}\par
01609      {\cf18 size_t} {\cf17 const} ll = (size_t)(ip - anchor);\par
01610      {\cf18 size_t} {\cf17 const} ll_addbytes = (ll + 240) / 255;\par
01611      {\cf18 size_t} {\cf17 const} ll_totalCost = 1 + ll_addbytes + ll;\par
01612      BYTE* {\cf17 const} maxLitPos = oend - 3; {\cf20 /* 2 for offset, 1 for token */}\par
01613      DEBUGLOG(6, {\cf22 "Last sequence overflowing (only %i bytes remaining)"}, ({\cf18 int})(oend-1-opSaved));\par
01614      op = opSaved;  {\cf20 /* restore correct out pointer */}\par
01615      {\cf19 if} (op + ll_totalCost <= maxLitPos) \{\par
01616          {\cf20 /* ll validated; now adjust match length */}\par
01617          {\cf18 size_t} {\cf17 const} bytesLeftForMl = (size_t)(maxLitPos - (op+ll_totalCost));\par
01618          {\cf18 size_t} {\cf17 const} maxMlSize = MINMATCH + (ML_MASK-1) + (bytesLeftForMl * 255);\par
01619          assert(maxMlSize < INT_MAX); assert(ovml >= 0);\par
01620          {\cf19 if} (({\cf18 size_t})ovml > maxMlSize) ovml = (int)maxMlSize;\par
01621          {\cf19 if} ((oend + LASTLITERALS) - (op + ll_totalCost + 2) - 1 + ovml >= MFLIMIT) \{\par
01622              DEBUGLOG(6, {\cf22 "Space to end : %i + ml (%i)"}, ({\cf18 int})((oend + LASTLITERALS) - (op + ll_totalCost + 2) - 1), ovml);\par
01623              DEBUGLOG(6, {\cf22 "Before : ip = %p, anchor = %p"}, ip, anchor);\par
01624              LZ4HC_encodeSequence(UPDATABLE(ip, op, anchor), ovml, ovref, notLimited, oend);\par
01625              DEBUGLOG(6, {\cf22 "After : ip = %p, anchor = %p"}, ip, anchor);\par
01626      \}   \}\par
01627      {\cf19 goto} _last_literals;\par
01628 \}\par
