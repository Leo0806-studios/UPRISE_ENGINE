01067 {\cf20 /* LZ4_loadDictHC() :}\par
01068 {\cf20  * LZ4_streamHCPtr is presumed properly initialized */}\par
01069 {\cf18 int} LZ4_loadDictHC (LZ4_streamHC_t* LZ4_streamHCPtr,\par
01070               {\cf17 const} {\cf18 char}* dictionary, {\cf18 int} dictSize)\par
01071 \{\par
01072     LZ4HC_CCtx_internal* {\cf17 const} ctxPtr = &LZ4_streamHCPtr->internal_donotuse;\par
01073     DEBUGLOG(4, {\cf22 "LZ4_loadDictHC(ctx:%p, dict:%p, dictSize:%d)"}, LZ4_streamHCPtr, dictionary, dictSize);\par
01074     assert(LZ4_streamHCPtr != NULL);\par
