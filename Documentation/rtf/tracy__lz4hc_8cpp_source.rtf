00209 {\cf20 /* LZ4HC_reverseCountPattern() :}\par
00210 {\cf20  * pattern must be a sample of repetitive pattern of length 1, 2 or 4 (but not 3!)}\par
00211 {\cf20  * read using natural platform endianness */}\par
00212 {\cf17 static} {\cf18 unsigned}\par
00213 LZ4HC_reverseCountPattern({\cf17 const} BYTE* ip, {\cf17 const} BYTE* {\cf17 const} iLow, U32 pattern)\par
00214 \{\par
00215     {\cf17 const} BYTE* {\cf17 const} iStart = ip;\par
00216 \par
00217     {\cf19 while} (likely(ip >= iLow+4)) \{\par
00218         {\cf19 if} (LZ4_read32(ip-4) != pattern) {\cf19 break};\par
00219         ip -= 4;\par
00220     \}\par
00221     \{   {\cf17 const} BYTE* bytePtr = ({\cf17 const} BYTE*)(&pattern) + 3; {\cf20 /* works for any endianness */}\par
00222         {\cf19 while} (likely(ip>iLow)) \{\par
00223             {\cf19 if} (ip[-1] != *bytePtr) {\cf19 break};\par
00224             ip--; bytePtr--;\par
00225     \}   \}\par
00226     {\cf19 return} ({\cf18 unsigned})(iStart - ip);\par
00227 \}\par
