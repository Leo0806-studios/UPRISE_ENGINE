00661             {\cf19 if} (LZ4HC_encodeSequence(UPDATABLE(ip, op, anchor), ml, ref, limit, oend)) {\cf19 goto} _dest_overflow;\par
00662             ip = start2;\par
00663             optr = op;\par
00664             {\cf19 if} (LZ4HC_encodeSequence(UPDATABLE(ip, op, anchor), ml2, ref2, limit, oend)) \{\par
00665                 ml  = ml2;\par
00666                 ref = ref2;\par
00667                 {\cf19 goto} _dest_overflow;\par
00668             \}\par
00669             {\cf19 continue};\par
00670         \}\par
00671 \par
00672         {\cf19 if} (start3 < ip+ml+3) \{  {\cf20 /* Not enough space for match 2 : remove it */}\par
00673             {\cf19 if} (start3 >= (ip+ml)) \{  {\cf20 /* can write Seq1 immediately ==> Seq2 is removed, so Seq3 becomes Seq1 */}\par
