00716                     start2 += correction;\par
00717                     ref2 += correction;\par
00718                     ml2 -= correction;\par
00719                 \}\par
00720             \} {\cf19 else} \{\par
00721                 ml = (int)(start2 - ip);\par
00722             \}\par
00723         \}\par
00724         optr = op;\par
00725         {\cf19 if} (LZ4HC_encodeSequence(UPDATABLE(ip, op, anchor), ml, ref, limit, oend)) {\cf19 goto} _dest_overflow;\par
00726 \par
00727         {\cf20 /* ML2 becomes ML1 */}\par
00728         ip = start2; ref = ref2; ml = ml2;\par
00729 \par
00730         {\cf20 /* ML3 becomes ML2 */}\par
00731         start2 = start3; ref2 = ref3; ml2 = ml3;\par
00732 \par
00733         {\cf20 /* let's find a new ML3 */}\par
00734         {\cf19 goto} _Search3;\par
00735     \}\par
00736 \par
00737 _last_literals:\par
00738     {\cf20 /* Encode Last Literals */}\par
00739     \{   {\cf18 size_t} lastRunSize = (size_t)(iend - anchor);  {\cf20 /* literals */}\par
00740         {\cf18 size_t} llAdd = (lastRunSize + 255 - RUN_MASK) / 255;\par
00741         {\cf18 size_t} {\cf17 const} totalSize = 1 + llAdd + lastRunSize;\par
00742         {\cf19 if} (limit == fillOutput) oend += LASTLITERALS;  {\cf20 /* restore correct value */}\par
