00779             {\cf20 /* ll validated; now adjust match length */}\par
00780             {\cf18 size_t} {\cf17 const} bytesLeftForMl = (size_t)(maxLitPos - (op+ll_totalCost));\par
00781             {\cf18 size_t} {\cf17 const} maxMlSize = MINMATCH + (ML_MASK-1) + (bytesLeftForMl * 255);\par
00782             assert(maxMlSize < INT_MAX); assert(ml >= 0);\par
00783             {\cf19 if} (({\cf18 size_t})ml > maxMlSize) ml = (int)maxMlSize;\par
