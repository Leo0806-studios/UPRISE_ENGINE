00635             {\cf18 int} correction;\par
00636             {\cf18 int} new_ml = ml;\par
00637             {\cf19 if} (new_ml > OPTIMAL_ML) new_ml = OPTIMAL_ML;\par
00638             {\cf19 if} (ip+new_ml > start2 + ml2 - MINMATCH) new_ml = (int)(start2 - ip) + ml2 - MINMATCH;\par
00639             correction = new_ml - (int)(start2 - ip);\par
00640             {\cf19 if} (correction > 0) \{\par
00641                 start2 += correction;\par
00642                 ref2 += correction;\par
00643                 ml2 -= correction;\par
00644             \}\par
00645         \}\par
00646         {\cf20 /* Now, we have start2 = ip+new_ml, with new_ml = min(ml, OPTIMAL_ML=18) */}\par
00647 \par
00648         {\cf19 if} (start2 + ml2 <= mflimit) \{\par
00649             ml3 = LZ4HC_InsertAndGetWiderMatch(ctx,\par
00650                             start2 + ml2 - 3, start2, matchlimit, ml2, &ref3, &start3,\par
00651                             maxNbAttempts, patternAnalysis, 0, dict, favorCompressionRatio);\par
00652         \} {\cf19 else} \{\par
00653             ml3 = ml2;\par
00654         \}\par
00655 \par
00656         {\cf19 if} (ml3 == ml2) \{  {\cf20 /* No better match => encode ML1 and ML2 */}\par
