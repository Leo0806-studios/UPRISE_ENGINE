01169 {\cf20 /* LZ4_saveDictHC :}\par
01170 {\cf20  * save history content}\par
01171 {\cf20  * into a user-provided buffer}\par
01172 {\cf20  * which is then used to continue compression}\par
01173 {\cf20  */}\par
01174 {\cf18 int} LZ4_saveDictHC (LZ4_streamHC_t* LZ4_streamHCPtr, {\cf18 char}* safeBuffer, {\cf18 int} dictSize)\par
01175 \{\par
01176     LZ4HC_CCtx_internal* {\cf17 const} streamPtr = &LZ4_streamHCPtr->internal_donotuse;\par
01177     {\cf18 int} {\cf17 const} prefixSize = (int)(streamPtr->end - streamPtr->prefixStart);\par
01178     DEBUGLOG(5, {\cf22 "LZ4_saveDictHC(%p, %p, %d)"}, LZ4_streamHCPtr, safeBuffer, dictSize);\par
01179     assert(prefixSize >= 0);\par
01180     {\cf19 if} (dictSize > 64 KB) dictSize = 64 KB;\par
01181     {\cf19 if} (dictSize < 4) dictSize = 0;\par
01182     {\cf19 if} (dictSize > prefixSize) dictSize = prefixSize;\par
01183     {\cf19 if} (safeBuffer == NULL) assert(dictSize == 0);\par
01184     {\cf19 if} (dictSize > 0)\par
01185         LZ4_memmove(safeBuffer, streamPtr->end - dictSize, dictSize);\par
01186     \{   U32 {\cf17 const} endIndex = (U32)(streamPtr->end - streamPtr->prefixStart) + streamPtr->dictLimit;\par
01187         streamPtr->end = ({\cf17 const} BYTE*)safeBuffer + dictSize;\par
01188         streamPtr->prefixStart = streamPtr->end - dictSize;\par
01189         streamPtr->dictLimit = endIndex - (U32)dictSize;\par
01190         streamPtr->lowLimit = endIndex - (U32)dictSize;\par
01191         streamPtr->dictStart = streamPtr->prefixStart;\par
01192         {\cf19 if} (streamPtr->nextToUpdate < streamPtr->dictLimit)\par
01193             streamPtr->nextToUpdate = streamPtr->dictLimit;\par
01194     \}\par
01195     {\cf19 return} dictSize;\par
01196 \}\par
