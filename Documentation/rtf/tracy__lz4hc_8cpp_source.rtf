01084     LZ4HC_init_internal (ctxPtr, ({\cf17 const} BYTE*)dictionary);\par
01085     ctxPtr->end = ({\cf17 const} BYTE*)dictionary + dictSize;\par
01086     {\cf19 if} (dictSize >= 4) LZ4HC_Insert (ctxPtr, ctxPtr->end-3);\par
