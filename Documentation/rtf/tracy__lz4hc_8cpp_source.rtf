01096 {\cf17 static} {\cf18 void} LZ4HC_setExternalDict(LZ4HC_CCtx_internal* ctxPtr, {\cf17 const} BYTE* newBlock)\par
01097 \{\par
01098     DEBUGLOG(4, {\cf22 "LZ4HC_setExternalDict(%p, %p)"}, ctxPtr, newBlock);\par
01099     {\cf19 if} (ctxPtr->end >= ctxPtr->prefixStart + 4)\par
01100         LZ4HC_Insert (ctxPtr, ctxPtr->end-3);   {\cf20 /* Referencing remaining dictionary content */}\par
01101 \par
01102     {\cf20 /* Only one memory segment for extDict, so any previous extDict is lost at this stage */}\par
01103     ctxPtr->lowLimit  = ctxPtr->dictLimit;\par
01104     ctxPtr->dictStart  = ctxPtr->prefixStart;\par
01105     ctxPtr->dictLimit += (U32)(ctxPtr->end - ctxPtr->prefixStart);\par
01106     ctxPtr->prefixStart = newBlock;\par
01107     ctxPtr->end  = newBlock;\par
01108     ctxPtr->nextToUpdate = ctxPtr->dictLimit;   {\cf20 /* match referencing will resume from there */}\par
01109 \par
01110     {\cf20 /* cannot reference an extDict and a dictCtx at the same time */}\par
01111     ctxPtr->dictCtx = NULL;\par
01112 \}\par
