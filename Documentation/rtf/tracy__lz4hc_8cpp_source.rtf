00556 LZ4_FORCE_INLINE {\cf18 int} LZ4HC_compress_hashChain (\par
00557     LZ4HC_CCtx_internal* {\cf17 const} ctx,\par
00558     {\cf17 const} {\cf18 char}* {\cf17 const} source,\par
00559     {\cf18 char}* {\cf17 const} dest,\par
00560     {\cf18 int}* srcSizePtr,\par
00561     {\cf18 int} {\cf17 const} maxOutputSize,\par
00562     {\cf18 int} maxNbAttempts,\par
00563     {\cf17 const} limitedOutput_directive limit,\par
00564     {\cf17 const} dictCtx_directive dict\par
00565     )\par
00566 \{\par
00567     {\cf17 const} {\cf18 int} inputSize = *srcSizePtr;\par
00568     {\cf17 const} {\cf18 int} patternAnalysis = (maxNbAttempts > 128);   {\cf20 /* levels 9+ */}\par
00569 \par
00570     {\cf17 const} BYTE* ip = ({\cf17 const} BYTE*) source;\par
00571     {\cf17 const} BYTE* anchor = ip;\par
00572     {\cf17 const} BYTE* {\cf17 const} iend = ip + inputSize;\par
00573     {\cf17 const} BYTE* {\cf17 const} mflimit = iend - MFLIMIT;\par
00574     {\cf17 const} BYTE* {\cf17 const} matchlimit = (iend - LASTLITERALS);\par
00575 \par
00576     BYTE* optr = (BYTE*) dest;\par
00577     BYTE* op = (BYTE*) dest;\par
00578     BYTE* oend = op + maxOutputSize;\par
00579 \par
00580     {\cf18 int}   ml0, ml, ml2, ml3;\par
00581     {\cf17 const} BYTE* start0;\par
00582     {\cf17 const} BYTE* ref0;\par
00583     {\cf17 const} BYTE* ref = NULL;\par
00584     {\cf17 const} BYTE* start2 = NULL;\par
00585     {\cf17 const} BYTE* ref2 = NULL;\par
00586     {\cf17 const} BYTE* start3 = NULL;\par
00587     {\cf17 const} BYTE* ref3 = NULL;\par
00588 \par
00589     {\cf20 /* init */}\par
00590     *srcSizePtr = 0;\par
00591     {\cf19 if} (limit == fillOutput) oend -= LASTLITERALS;                  {\cf20 /* Hack for support LZ4 format restriction */}\par
00592     {\cf19 if} (inputSize < LZ4_minLength) {\cf19 goto} _last_literals;             {\cf20 /* Input too small, no compression (all literals) */}\par
00593 \par
00594     {\cf20 /* Main Loop */}\par
00595     {\cf19 while} (ip <= mflimit) \{\par
00596         ml = LZ4HC_InsertAndFindBestMatch(ctx, ip, matchlimit, &ref, maxNbAttempts, patternAnalysis, dict);\par
00597         {\cf19 if} (ml<MINMATCH) \{ ip++; {\cf19 continue}; \}\par
00598 \par
00599         {\cf20 /* saved, in case we would skip too much */}\par
00600         start0 = ip; ref0 = ref; ml0 = ml;\par
00601 \par
00602 _Search2:\par
00603         {\cf19 if} (ip+ml <= mflimit) \{\par
00604             ml2 = LZ4HC_InsertAndGetWiderMatch(ctx,\par
00605                             ip + ml - 2, ip + 0, matchlimit, ml, &ref2, &start2,\par
00606                             maxNbAttempts, patternAnalysis, 0, dict, favorCompressionRatio);\par
00607         \} {\cf19 else} \{\par
00608             ml2 = ml;\par
00609         \}\par
00610 \par
00611         {\cf19 if} (ml2 == ml) \{ {\cf20 /* No better match => encode ML1 */}\par
00612             optr = op;\par
00613             {\cf19 if} (LZ4HC_encodeSequence(UPDATABLE(ip, op, anchor), ml, ref, limit, oend)) {\cf19 goto} _dest_overflow;\par
00614             {\cf19 continue};\par
00615         \}\par
00616 \par
00617         {\cf19 if} (start0 < ip) \{   {\cf20 /* first match was skipped at least once */}\par
00618             {\cf19 if} (start2 < ip + ml0) \{  {\cf20 /* squeezing ML1 between ML0(original ML1) and ML2 */}\par
00619                 ip = start0; ref = ref0; ml = ml0;  {\cf20 /* restore initial ML1 */}\par
00620         \}   \}\par
00621 \par
00622         {\cf20 /* Here, start0==ip */}\par
00623         {\cf19 if} ((start2 - ip) < 3) \{  {\cf20 /* First Match too small : removed */}\par
00624             ml = ml2;\par
00625             ip = start2;\par
00626             ref =ref2;\par
00627             {\cf19 goto} _Search2;\par
00628         \}\par
00629 \par
00630 _Search3:\par
00631         {\cf20 /* At this stage, we have :}\par
00632 {\cf20         *  ml2 > ml1, and}\par
00633 {\cf20         *  ip1+3 <= ip2 (usually < ip1+ml1) */}\par
