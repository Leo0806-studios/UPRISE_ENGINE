00524 \par
00525     {\cf20 /* Encode Offset */}\par
00526     assert( (ip - match) <= LZ4_DISTANCE_MAX );   {\cf20 /* note : consider providing offset as a value, rather than as a pointer difference */}\par
00527     LZ4_writeLE16(op, (U16)(ip - match)); op += 2;\par
00528 \par
00529     {\cf20 /* Encode MatchLength */}\par
00530     assert(matchLength >= MINMATCH);\par
00531     length = (size_t)matchLength - MINMATCH;\par
00532     {\cf19 if} (limit && (op + (length / 255) + (1 + LASTLITERALS) > oend)) \{\par
00533         DEBUGLOG(6, {\cf22 "Not enough room to write match length"});\par
00534         {\cf19 return} 1;   {\cf20 /* Check output limit */}\par
00535     \}\par
00536     {\cf19 if} (length >= ML_MASK) \{\par
00537         *token += ML_MASK;\par
00538         length -= ML_MASK;\par
00539         {\cf19 for}(; length >= 510 ; length -= 510) \{ *op++ = 255; *op++ = 255; \}\par
00540         {\cf19 if} (length >= 255) \{ length -= 255; *op++ = 255; \}\par
00541         *op++ = (BYTE)length;\par
00542     \} {\cf19 else} \{\par
00543         *token += (BYTE)(length);\par
00544     \}\par
00545 \par
00546     {\cf20 /* Prepare next loop */}\par
00547     ip += matchLength;\par
00548     anchor = ip;\par
00549 \par
00550     {\cf19 return} 0;\par
00551 \}\par
00552 {\cf21 #undef ip}\par
00553 {\cf21 #undef op}\par
00554 {\cf21 #undef anchor}\par
