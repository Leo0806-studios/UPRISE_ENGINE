01114 {\cf17 static} {\cf18 int}\par
01115 LZ4_compressHC_continue_generic (LZ4_streamHC_t* LZ4_streamHCPtr,\par
01116                                  {\cf17 const} {\cf18 char}* src, {\cf18 char}* dst,\par
01117                                  {\cf18 int}* srcSizePtr, {\cf18 int} dstCapacity,\par
01118                                  limitedOutput_directive limit)\par
01119 \{\par
01120     LZ4HC_CCtx_internal* {\cf17 const} ctxPtr = &LZ4_streamHCPtr->internal_donotuse;\par
01121     DEBUGLOG(5, {\cf22 "LZ4_compressHC_continue_generic(ctx=%p, src=%p, srcSize=%d, limit=%d)"},\par
01122                 LZ4_streamHCPtr, src, *srcSizePtr, limit);\par
01123     assert(ctxPtr != NULL);\par
01124     {\cf20 /* auto-init if forgotten */}\par
01125     {\cf19 if} (ctxPtr->prefixStart == NULL) LZ4HC_init_internal (ctxPtr, ({\cf17 const} BYTE*) src);\par
01126 \par
01127     {\cf20 /* Check overflow */}\par
01128     {\cf19 if} (({\cf18 size_t})(ctxPtr->end - ctxPtr->prefixStart) + ctxPtr->dictLimit > 2 GB) \{\par
01129         {\cf18 size_t} dictSize = (size_t)(ctxPtr->end - ctxPtr->prefixStart);\par
01130         {\cf19 if} (dictSize > 64 KB) dictSize = 64 KB;\par
01131         LZ4_loadDictHC(LZ4_streamHCPtr, ({\cf17 const} {\cf18 char}*)(ctxPtr->end) - dictSize, ({\cf18 int})dictSize);\par
01132     \}\par
01133 \par
01134     {\cf20 /* Check if blocks follow each other */}\par
01135     {\cf19 if} (({\cf17 const} BYTE*)src != ctxPtr->end)\par
01136         LZ4HC_setExternalDict(ctxPtr, ({\cf17 const} BYTE*)src);\par
01137 \par
01138     {\cf20 /* Check overlapping input/dictionary space */}\par
01139     \{   {\cf17 const} BYTE* sourceEnd = ({\cf17 const} BYTE*) src + *srcSizePtr;\par
01140         {\cf17 const} BYTE* {\cf17 const} dictBegin = ctxPtr->dictStart;\par
01141         {\cf17 const} BYTE* {\cf17 const} dictEnd   = ctxPtr->dictStart + (ctxPtr->dictLimit - ctxPtr->lowLimit);\par
01142         {\cf19 if} ((sourceEnd > dictBegin) && (({\cf17 const} BYTE*)src < dictEnd)) \{\par
01143             {\cf19 if} (sourceEnd > dictEnd) sourceEnd = dictEnd;\par
01144             ctxPtr->lowLimit += (U32)(sourceEnd - ctxPtr->dictStart);\par
01145             ctxPtr->dictStart += (U32)(sourceEnd - ctxPtr->dictStart);\par
01146             {\cf19 if} (ctxPtr->dictLimit - ctxPtr->lowLimit < 4) \{\par
01147                 ctxPtr->lowLimit = ctxPtr->dictLimit;\par
01148                 ctxPtr->dictStart = ctxPtr->prefixStart;\par
01149     \}   \}   \}\par
01150 \par
01151     {\cf19 return} LZ4HC_compress_generic (ctxPtr, src, dst, srcSizePtr, dstCapacity, ctxPtr->compressionLevel, limit);\par
01152 \}\par
01153 \par
