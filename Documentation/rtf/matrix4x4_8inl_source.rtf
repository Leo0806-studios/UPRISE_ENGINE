00422 {\cf20     the rotation matrix for an euler XYZ rotation is M = Rz * Ry * Rx.}\par
00423 {\cf20     combining gives:}\par
00424 {\cf20 }\par
00425 {\cf20         |  CE  BDE-AF  ADE+BF  0  |}\par
00426 {\cf20     M = |  CF  BDF+AE  ADF-BE  0  |}\par
00427 {\cf20         |  -D    CB      AC    0  |}\par
00428 {\cf20         |   0     0       0    1  |}\par
00429 {\cf20 }\par
00430 {\cf20     where}\par
00431 {\cf20     A = cos(angle_x), B = sin(angle_x);}\par
00432 {\cf20     C = cos(angle_y), D = sin(angle_y);}\par
00433 {\cf20     E = cos(angle_z), F = sin(angle_z);}\par
00434 {\cf20     */}\par
00435 \par
00436     {\cf20 // Use a small epsilon to solve floating-point inaccuracies}\par
00437     {\cf17 const} TReal epsilon = Assimp::Math::getEpsilon<TReal>();\par
00438 \par
00439     pRotation.y  = std::asin(-vCols[0].z);{\cf20 // D. Angle around oY.}\par
00440 \par
00441     TReal C = std::cos(pRotation.y);\par
00442 \par
00443     {\cf19 if}(std::fabs(C) > epsilon)\par
00444     \{\par
00445         {\cf20 // Finding angle around oX.}\par
00446         TReal tan_x = vCols[2].z / C;{\cf20 // A}\par
00447         TReal tan_y = vCols[1].z / C;{\cf20 // B}\par
00448 \par
00449         pRotation.x = std::atan2(tan_y, tan_x);\par
00450         {\cf20 // Finding angle around oZ.}\par
00451         tan_x = vCols[0].x / C;{\cf20 // E}\par
00452         tan_y = vCols[0].y / C;{\cf20 // F}\par
00453         pRotation.z = std::atan2(tan_y, tan_x);\par
00454     \}\par
00455     {\cf19 else}\par
00456     \{{\cf20 // oY is fixed.}\par
00457         pRotation.x = 0;{\cf20 // Set angle around oX to 0. => A == 1, B == 0, C == 0, D == 1.}\par
00458 \par
00459         {\cf20 // And finding angle around oZ.}\par
00460         TReal tan_x =  vCols[1].y;{\cf20 // BDF+AE => E}\par
00461         TReal tan_y = -vCols[1].x;{\cf20 // BDE-AF => F}\par
00462 \par
00463         pRotation.z = std::atan2(tan_y, tan_x);\par
00464     \}\par
00465 \}\par
00466 \par
00467 {\cf21 #undef ASSIMP_MATRIX4_4_DECOMPOSE_PART}\par
00468 \par
00469 {\cf17 template} <{\cf17 typename} TReal>\par
00470 AI_FORCE_INLINE\par
00471 {\cf18 void} aiMatrix4x4t<TReal>::Decompose(aiVector3t<TReal>& pScaling, aiVector3t<TReal>& pRotationAxis, TReal& pRotationAngle,\par
00472                                             aiVector3t<TReal>& pPosition){\cf17  const }\{\par
00473     aiQuaterniont<TReal> pRotation;\par
00474 \par
00475     Decompose(pScaling, pRotation, pPosition);\par
00476     pRotation.Normalize();\par
00477 \par
00478     TReal angle_cos = pRotation.w;\par
00479     TReal angle_sin = std::sqrt(1.0f - angle_cos * angle_cos);\par
00480 \par
00481     pRotationAngle = std::acos(angle_cos) * 2;\par
00482 \par
00483     {\cf20 // Use a small epsilon to solve floating-point inaccuracies}\par
00484     {\cf17 const} TReal epsilon = 10e-3f;\par
00485 \par
00486     {\cf19 if}(std::fabs(angle_sin) < epsilon) angle_sin = 1;\par
00487 \par
00488     pRotationAxis.x = pRotation.x / angle_sin;\par
00489     pRotationAxis.y = pRotation.y / angle_sin;\par
00490     pRotationAxis.z = pRotation.z / angle_sin;\par
00491 \}\par
00492 \par
