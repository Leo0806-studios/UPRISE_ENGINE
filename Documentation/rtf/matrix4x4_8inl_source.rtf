00602 {\cf17 template} <{\cf17 typename} TReal>\par
00603 AI_FORCE_INLINE\par
00604 aiMatrix4x4t<TReal>& aiMatrix4x4t<TReal>::RotationZ(TReal a, aiMatrix4x4t<TReal>& out) \{\par
00605     {\cf20 /*}\par
00606 {\cf20          |  cos(A)  -sin(A)   0   0 |}\par
00607 {\cf20      M = |  sin(A)   cos(A)   0   0 |}\par
00608 {\cf20          |  0        0        1   0 |}\par
00609 {\cf20          |  0        0        0   1 |   */}\par
00610     out = aiMatrix4x4t<TReal>();\par
00611     out.a1 = out.b2 = std::cos(a);\par
00612     out.a2 = -(out.b1 = std::sin(a));\par
00613     {\cf19 return} out;\par
00614 \}\par
