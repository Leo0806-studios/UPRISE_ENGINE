00571 {\cf17 template} <{\cf17 typename} TReal>\par
00572 AI_FORCE_INLINE\par
00573 aiMatrix4x4t<TReal>& aiMatrix4x4t<TReal>::RotationX(TReal a, aiMatrix4x4t<TReal>& out) \{\par
00574     {\cf20 /*}\par
00575 {\cf20          |  1  0       0       0 |}\par
00576 {\cf20      M = |  0  cos(A) -sin(A)  0 |}\par
00577 {\cf20          |  0  sin(A)  cos(A)  0 |}\par
00578 {\cf20          |  0  0       0       1 |  */}\par
00579     out = aiMatrix4x4t<TReal>();\par
00580     out.b2 = out.c3 = std::cos(a);\par
00581     out.b3 = -(out.c2 = std::sin(a));\par
00582     {\cf19 return} out;\par
00583 \}\par
