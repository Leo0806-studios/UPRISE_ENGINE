00494 {\cf17 template} <{\cf17 typename} TReal>\par
00495 AI_FORCE_INLINE\par
00496 {\cf18 void} aiMatrix4x4t<TReal>::DecomposeNoScaling (aiQuaterniont<TReal>& rotation,\par
00497         aiVector3t<TReal>& position){\cf17  const }\{\par
00498     {\cf17 const} aiMatrix4x4t<TReal>& _this = *{\cf17 this};\par
00499 \par
00500     {\cf20 // extract translation}\par
00501     position.x = _this[0][3];\par
00502     position.y = _this[1][3];\par
00503     position.z = _this[2][3];\par
00504 \par
00505     {\cf20 // extract rotation}\par
00506     rotation = aiQuaterniont<TReal>((aiMatrix3x3t<TReal>)_this);\par
00507 \}\par
