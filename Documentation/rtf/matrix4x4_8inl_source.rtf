00586 {\cf17 template} <{\cf17 typename} TReal>\par
00587 AI_FORCE_INLINE\par
00588 aiMatrix4x4t<TReal>& aiMatrix4x4t<TReal>::RotationY(TReal a, aiMatrix4x4t<TReal>& out) \{\par
00589     {\cf20 /*}\par
00590 {\cf20          |  cos(A)  0   sin(A)  0 |}\par
00591 {\cf20      M = |  0       1   0       0 |}\par
00592 {\cf20          | -sin(A)  0   cos(A)  0 |}\par
00593 {\cf20          |  0       0   0       1 |}\par
00594 {\cf20         */}\par
00595     out = aiMatrix4x4t<TReal>();\par
00596     out.a1 = out.c3 = std::cos(a);\par
00597     out.c1 = -(out.a3 = std::sin(a));\par
00598     {\cf19 return} out;\par
00599 \}\par
