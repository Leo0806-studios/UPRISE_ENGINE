00617 {\cf20 // Returns a rotation matrix for a rotation around an arbitrary axis.}\par
00618 {\cf17 template} <{\cf17 typename} TReal>\par
00619 AI_FORCE_INLINE\par
00620 aiMatrix4x4t<TReal>& aiMatrix4x4t<TReal>::Rotation( TReal a, {\cf17 const} aiVector3t<TReal>& axis, aiMatrix4x4t<TReal>& out) \{\par
00621     TReal c = std::cos( a), s = std::sin( a), t = 1 - c;\par
00622     TReal x = axis.x, y = axis.y, z = axis.z;\par
00623 \par
00624     {\cf20 // Many thanks to MathWorld and Wikipedia}\par
00625     out.a1 = t*x*x + c;   out.a2 = t*x*y - s*z; out.a3 = t*x*z + s*y;\par
00626     out.b1 = t*x*y + s*z; out.b2 = t*y*y + c;   out.b3 = t*y*z - s*x;\par
00627     out.c1 = t*x*z - s*y; out.c2 = t*y*z + s*x; out.c3 = t*z*z + c;\par
00628     out.a4 = out.b4 = out.c4 = {\cf17 static_cast<}TReal{\cf17 >}(0.0);\par
00629     out.d1 = out.d2 = out.d3 = {\cf17 static_cast<}TReal{\cf17 >}(0.0);\par
00630     out.d4 = {\cf17 static_cast<}TReal{\cf17 >}(1.0);\par
00631 \par
00632     {\cf19 return} out;\par
00633 \}\par
