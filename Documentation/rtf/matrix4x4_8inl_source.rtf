00517 {\cf17 template} <{\cf17 typename} TReal>\par
00518 AI_FORCE_INLINE\par
00519 aiMatrix4x4t<TReal>& aiMatrix4x4t<TReal>::FromEulerAnglesXYZ(TReal x, TReal y, TReal z) \{\par
00520     aiMatrix4x4t<TReal>& _this = *{\cf17 this};\par
00521 \par
00522     TReal cx = std::cos(x);\par
00523     TReal sx = std::sin(x);\par
00524     TReal cy = std::cos(y);\par
00525     TReal sy = std::sin(y);\par
00526     TReal cz = std::cos(z);\par
00527     TReal sz = std::sin(z);\par
00528 \par
00529     {\cf20 // mz*my*mx}\par
00530     _this.a1 = cz * cy;\par
00531     _this.a2 = cz * sy * sx - sz * cx;\par
00532     _this.a3 = sz * sx + cz * sy * cx;\par
00533 \par
00534     _this.b1 = sz * cy;\par
00535     _this.b2 = cz * cx + sz * sy * sx;\par
00536     _this.b3 = sz * sy * cx - cz * sx;\par
00537 \par
00538     _this.c1 = -sy;\par
00539     _this.c2 = cy * sx;\par
00540     _this.c3 = cy * cx;\par
00541 \par
00542     {\cf19 return} *{\cf17 this};\par
00543 \}\par
00544 \par
