00546 {\cf17 template} <{\cf17 typename} TReal>\par
00547 AI_FORCE_INLINE\par
00548 {\cf18 bool} aiMatrix4x4t<TReal>::IsIdentity(){\cf17  const }\{\par
00549     {\cf20 // Use a small epsilon to solve floating-point inaccuracies}\par
00550     {\cf17 const} {\cf17 static} TReal epsilon = 10e-3f;\par
00551 \par
00552     {\cf19 return} (a2 <= epsilon && a2 >= -epsilon &&\par
00553             a3 <= epsilon && a3 >= -epsilon &&\par
00554             a4 <= epsilon && a4 >= -epsilon &&\par
00555             b1 <= epsilon && b1 >= -epsilon &&\par
00556             b3 <= epsilon && b3 >= -epsilon &&\par
00557             b4 <= epsilon && b4 >= -epsilon &&\par
00558             c1 <= epsilon && c1 >= -epsilon &&\par
00559             c2 <= epsilon && c2 >= -epsilon &&\par
00560             c4 <= epsilon && c4 >= -epsilon &&\par
00561             d1 <= epsilon && d1 >= -epsilon &&\par
00562             d2 <= epsilon && d2 >= -epsilon &&\par
00563             d3 <= epsilon && d3 >= -epsilon &&\par
00564             a1 <= 1.f+epsilon && a1 >= 1.f-epsilon &&\par
00565             b2 <= 1.f+epsilon && b2 >= 1.f-epsilon &&\par
00566             c3 <= 1.f+epsilon && c3 >= 1.f-epsilon &&\par
00567             d4 <= 1.f+epsilon && d4 >= 1.f-epsilon);\par
00568 \}\par
