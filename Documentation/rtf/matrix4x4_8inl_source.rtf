00510 {\cf17 template} <{\cf17 typename} TReal>\par
00511 AI_FORCE_INLINE\par
00512 aiMatrix4x4t<TReal>& aiMatrix4x4t<TReal>::FromEulerAnglesXYZ({\cf17 const} aiVector3t<TReal>& blubb) \{\par
00513     {\cf19 return} FromEulerAnglesXYZ(blubb.x,blubb.y,blubb.z);\par
00514 \}\par
