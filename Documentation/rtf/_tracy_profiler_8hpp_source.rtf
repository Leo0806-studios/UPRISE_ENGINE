759     {\cf17 static} tracy_force_inline uint64_t AllocSourceLocation( uint32_t line, {\cf17 const} {\cf18 char}* source, {\cf18 size_t} sourceSz, {\cf17 const} {\cf18 char}* function, {\cf18 size_t} functionSz, {\cf17 const} {\cf18 char}* name, {\cf18 size_t} nameSz )\par
760     \{\par
761         {\cf17 const} {\cf17 auto} sz32 = uint32_t( 2 + 4 + 4 + functionSz + 1 + sourceSz + 1 + nameSz );\par
762         assert( sz32 <= (std::numeric_limits<uint16_t>::max)() );\par
763         {\cf17 const} {\cf17 auto} sz = uint16_t( sz32 );\par
764         {\cf17 auto} ptr = ({\cf18 char}*)tracy_malloc( sz );\par
765         memcpy( ptr, &sz, 2 );\par
766         memset( ptr + 2, 0, 4 );\par
767         memcpy( ptr + 6, &line, 4 );\par
768         memcpy( ptr + 10, function, functionSz );\par
769         ptr[10 + functionSz] = {\cf23 '\\0'};\par
770         memcpy( ptr + 10 + functionSz + 1, source, sourceSz );\par
771         ptr[10 + functionSz + 1 + sourceSz] = {\cf23 '\\0'};\par
772         {\cf19 if}( nameSz != 0 )\par
773         \{\par
774             memcpy( ptr + 10 + functionSz + 1 + sourceSz + 1, name, nameSz );\par
775         \}\par
776         {\cf19 return} uint64_t( ptr );\par
777     \}\par
