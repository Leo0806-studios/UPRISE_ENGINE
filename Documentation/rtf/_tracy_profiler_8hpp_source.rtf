190     {\cf17 static} tracy_force_inline int64_t GetTime()\par
191     \{\par
192 {\cf21 #ifdef TRACY_HW_TIMER}\par
193 {\cf21 #  if defined TARGET_OS_IOS && TARGET_OS_IOS == 1}\par
194         {\cf19 if}( HardwareSupportsInvariantTSC() ) {\cf19 return} mach_absolute_time();\par
195 {\cf21 #  elif defined _WIN32}\par
196 {\cf21 #    ifdef TRACY_TIMER_QPC}\par
197         {\cf19 return} GetTimeQpc();\par
198 {\cf21 #    else}\par
199         {\cf19 if}( HardwareSupportsInvariantTSC() ) {\cf19 return} int64_t( __rdtsc() );\par
200 {\cf21 #    endif}\par
201 {\cf21 #  elif defined __i386 || defined _M_IX86}\par
202         {\cf19 if}( HardwareSupportsInvariantTSC() )\par
203         \{\par
204             uint32_t eax, edx;\par
205             {\cf17 asm} {\cf17 volatile} ( {\cf22 "rdtsc"} : {\cf22 "=a"} (eax), {\cf22 "=d"} (edx) );\par
206             {\cf19 return} ( uint64_t( edx ) << 32 ) + uint64_t( eax );\par
207         \}\par
208 {\cf21 #  elif defined __x86_64__ || defined _M_X64}\par
209         {\cf19 if}( HardwareSupportsInvariantTSC() )\par
210         \{\par
211             uint64_t rax, rdx;\par
212 {\cf21 #ifdef TRACY_PATCHABLE_NOPSLEDS}\par
213             {\cf20 // Some external tooling (such as rr) wants to patch our rdtsc and replace it by a}\par
214             {\cf20 // branch to control the external input seen by a program. This kind of patching is}\par
215             {\cf20 // not generally possible depending on the surrounding code and can lead to significant}\par
216             {\cf20 // slowdowns if the compiler generated unlucky code and rr and tracy are used together.}\par
217             {\cf20 // To avoid this, use the rr-safe `nopl 0(%rax, %rax, 1); rdtsc` instruction sequence,}\par
218             {\cf20 // which rr promises will be patchable independent of the surrounding code.}\par
219             {\cf17 asm} {\cf17 volatile} (\par
220                     {\cf20 // This is nopl 0(%rax, %rax, 1), but assemblers are inconsistent about whether}\par
221                     {\cf20 // they emit that as a 4 or 5 byte sequence and we need to be guaranteed to use}\par
222                     {\cf20 // the 5 byte one.}\par
223                     {\cf22 ".byte 0x0f, 0x1f, 0x44, 0x00, 0x00\\n\\t"}\par
224                     {\cf22 "rdtsc"} : {\cf22 "=a"} (rax), {\cf22 "=d"} (rdx) );\par
225 {\cf21 #else}\par
226             {\cf17 asm} {\cf17 volatile} ( {\cf22 "rdtsc"} : {\cf22 "=a"} (rax), {\cf22 "=d"} (rdx) );\par
227 {\cf21 #endif}\par
228             {\cf19 return} (int64_t)(( rdx << 32 ) + rax);\par
229         \}\par
230 {\cf21 #  else}\par
231 {\cf21 #    error "TRACY_HW_TIMER detection logic needs fixing"}\par
232 {\cf21 #  endif}\par
233 {\cf21 #endif}\par
234 \par
235 {\cf21 #if !defined TRACY_HW_TIMER || defined TRACY_TIMER_FALLBACK}\par
236 {\cf21 #  if defined __linux__ && defined CLOCK_MONOTONIC_RAW}\par
237         {\cf17 struct }timespec ts;\par
238         clock_gettime( CLOCK_MONOTONIC_RAW, &ts );\par
239         {\cf19 return} int64_t( ts.tv_sec ) * 1000000000ll + int64_t( ts.tv_nsec );\par
240 {\cf21 #  else}\par
241         {\cf19 return} std::chrono::duration_cast<std::chrono::nanoseconds>( std::chrono::high_resolution_clock::now().time_since_epoch() ).count();\par
242 {\cf21 #  endif}\par
243 {\cf21 #endif}\par
244 \par
245 {\cf21 #if !defined TRACY_TIMER_FALLBACK}\par
246         {\cf19 return} 0;  {\cf20 // unreachable branch}\par
247 {\cf21 #endif}\par
248     \}\par
