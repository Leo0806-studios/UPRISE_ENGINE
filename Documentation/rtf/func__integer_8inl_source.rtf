196     GLM_FUNC_QUALIFIER uint usubBorrow(uint {\cf17 const}& x, uint {\cf17 const}& y, uint & Borrow)\par
197     \{\par
198         Borrow = x >= y ? {\cf17 static_cast<}uint{\cf17 >}(0) : {\cf17 static_cast<}uint{\cf17 >}(1);\par
199         {\cf19 if}(y >= x)\par
200             {\cf19 return} y - x;\par
201         {\cf19 else}\par
