186     {\cf17 template}<length_t L, qualifier Q>\par
187     GLM_FUNC_QUALIFIER vec<L, uint, Q> uaddCarry(vec<L, uint, Q> {\cf17 const}& x, vec<L, uint, Q> {\cf17 const}& y, vec<L, uint, Q>& Carry)\par
188     \{\par
189         vec<L, detail::uint64, Q> Value64(vec<L, detail::uint64, Q>(x) + vec<L, detail::uint64, Q>(y));\par
190         vec<L, detail::uint64, Q> Max32(({\cf17 static_cast<}detail::uint64{\cf17 >}(1) << {\cf17 static_cast<}detail::uint64{\cf17 >}(32)) - {\cf17 static_cast<}detail::uint64{\cf17 >}(1));\par
191         Carry = mix(vec<L, uint, Q>(0), vec<L, uint, Q>(1), greaterThan(Value64, Max32));\par
192         {\cf19 return} vec<L, uint, Q>(Value64 % (Max32 + {\cf17 static_cast<}detail::uint64{\cf17 >}(1)));\par
193     \}\par
