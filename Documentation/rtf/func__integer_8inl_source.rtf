177     {\cf20 // uaddCarry}\par
178     GLM_FUNC_QUALIFIER uint uaddCarry(uint {\cf17 const}& x, uint {\cf17 const}& y, uint & Carry)\par
179     \{\par
180         detail::uint64 {\cf17 const} Value64({\cf17 static_cast<}detail::uint64{\cf17 >}(x) + {\cf17 static_cast<}detail::uint64{\cf17 >}(y));\par
181         detail::uint64 {\cf17 const} Max32(({\cf17 static_cast<}detail::uint64{\cf17 >}(1) << {\cf17 static_cast<}detail::uint64{\cf17 >}(32)) - {\cf17 static_cast<}detail::uint64{\cf17 >}(1));\par
182         Carry = Value64 > Max32 ? 1u : 0u;\par
183         {\cf19 return} {\cf17 static_cast<}uint{\cf17 >}(Value64 % (Max32 + {\cf17 static_cast<}detail::uint64{\cf17 >}(1)));\par
184     \}\par
