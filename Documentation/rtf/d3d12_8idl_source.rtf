6157 cpp_quote("{\cf20 // D3D12EnableExperimentalFeatures")}\par
6158 cpp_quote("{\cf20 //")}\par
6159 cpp_quote("{\cf20 // Pass in a list of feature GUIDs to be enabled together.")}\par
6160 cpp_quote("{\cf20 // ")}\par
6161 cpp_quote("{\cf20 // If a particular feature requires some configuration information on enablement, it will have")}\par
6162 cpp_quote("{\cf20 // a configuration struct that can be passed alongside the GUID.")}\par
6163 cpp_quote("{\cf20 // ")}\par
6164 cpp_quote("{\cf20 // Some features might use an interface IID as the GUID.  For these, once the feature is enabled via")}\par
6165 cpp_quote("{\cf20 // D3D12EnableExperimentalFeatures, D3D12GetDebugInterface can then be called with the IID to retrieve the interface")}\par
6166 cpp_quote("{\cf20 // for manipulating the feature.  This allows for control that might not cleanly be expressed by just ")}\par
6167 cpp_quote("{\cf20 // the configuration struct that D3D12EnableExperimentalFeatures provides.")}\par
6168 cpp_quote("{\cf20 //")}\par
6169 cpp_quote("{\cf20 // If this method is called and a change to existing feature enablement is made, ")}\par
6170 cpp_quote("{\cf20 // all current D3D12 devices are set to DEVICE_REMOVED state, since under the covers there is really only one")}\par
6171 cpp_quote("{\cf20 // singleton device for a process.  Removing the devices when configuration changes prevents")}\par
6172 cpp_quote("{\cf20 // mismatched expectations of how a device is supposed to work after it has been created from the app's point of view.")}\par
6173 cpp_quote("{\cf20 //")}\par
6174 cpp_quote("{\cf20 // The call returns E_NOINTERFACE if an unrecognized feature is passed in or Windows Developer mode is not on.")}\par
6175 cpp_quote("{\cf20 // The call returns E_INVALIDARG if the configuration of a feature is incorrect, the set of features passed")}\par
6176 cpp_quote("{\cf20 // in are known to be incompatible with each other, or other errors.")}\par
6177 cpp_quote("{\cf20 // Returns S_OK otherwise.")}\par
6178 cpp_quote("{\cf20 //")}\par
