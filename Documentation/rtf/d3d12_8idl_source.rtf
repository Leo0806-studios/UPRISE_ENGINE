2296 const UINT D3D12_ANISOTROPIC_FILTERING_BIT = 0x00000040;\par
2297 \par
2298 // encode enum entry for most filters except anisotropic filtering\par
2299 cpp_quote( "#define D3D12_ENCODE_BASIC_FILTER( min, mag, mip, reduction )                                                     \\\\" )\par
2300 cpp_quote( "                                   ( ( D3D12_FILTER ) (                                                           \\\\" )\par
2301 cpp_quote( "                                   ( ( ( min ) & D3D12_FILTER_TYPE_MASK ) << D3D12_MIN_FILTER_SHIFT ) |           \\\\" )\par
2302 cpp_quote( "                                   ( ( ( mag ) & D3D12_FILTER_TYPE_MASK ) << D3D12_MAG_FILTER_SHIFT ) |           \\\\" )\par
2303 cpp_quote( "                                   ( ( ( mip ) & D3D12_FILTER_TYPE_MASK ) << D3D12_MIP_FILTER_SHIFT ) |           \\\\" )\par
2304 cpp_quote( "                                   ( ( ( reduction ) & D3D12_FILTER_REDUCTION_TYPE_MASK ) << D3D12_FILTER_REDUCTION_TYPE_SHIFT ) ) ) " )\par
2305 \par
2306 // encode enum entry for anisotropic filtering (with or without comparison filtering)\par
2307 cpp_quote( "#define D3D12_ENCODE_ANISOTROPIC_FILTER( reduction )                                                  \\\\" )\par
2308 cpp_quote( "                                         ( ( D3D12_FILTER ) (                                         \\\\" )\par
2309 cpp_quote( "                                         D3D12_ANISOTROPIC_FILTERING_BIT |                            \\\\" )\par
2310 cpp_quote( "                                         D3D12_ENCODE_BASIC_FILTER( D3D12_FILTER_TYPE_LINEAR,         \\\\" )\par
2311 cpp_quote( "                                                                    D3D12_FILTER_TYPE_LINEAR,         \\\\" )\par
2312 cpp_quote( "                                                                    D3D12_FILTER_TYPE_LINEAR,         \\\\" )\par
2313 cpp_quote( "                                                                    reduction ) ) )                     " )\par
2314 cpp_quote( "#define D3D12_ENCODE_MIN_MAG_ANISOTROPIC_MIP_POINT_FILTER( reduction )                                \\\\" )\par
2315 cpp_quote( "                                         ( ( D3D12_FILTER ) (                                         \\\\" )\par
2316 cpp_quote( "                                         D3D12_ANISOTROPIC_FILTERING_BIT |                            \\\\" )\par
2317 cpp_quote( "                                         D3D12_ENCODE_BASIC_FILTER( D3D12_FILTER_TYPE_LINEAR,         \\\\" )\par
2318 cpp_quote( "                                                                    D3D12_FILTER_TYPE_LINEAR,         \\\\" )\par
2319 cpp_quote( "                                                                    D3D12_FILTER_TYPE_POINT,          \\\\" )\par
2320 cpp_quote( "                                                                    reduction ) ) )                     " )\par
2321 \par
2322 cpp_quote( "#define D3D12_DECODE_MIN_FILTER( D3D12Filter )                                                              \\\\" )\par
2323 cpp_quote( "                                 ( ( D3D12_FILTER_TYPE )                                                    \\\\" )\par
2324 cpp_quote( "                                 ( ( ( D3D12Filter ) >> D3D12_MIN_FILTER_SHIFT ) & D3D12_FILTER_TYPE_MASK ) ) " )\par
2325 \par
2326 cpp_quote( "#define D3D12_DECODE_MAG_FILTER( D3D12Filter )                                                              \\\\" )\par
2327 cpp_quote( "                                 ( ( D3D12_FILTER_TYPE )                                                    \\\\" )\par
2328 cpp_quote( "                                 ( ( ( D3D12Filter ) >> D3D12_MAG_FILTER_SHIFT ) & D3D12_FILTER_TYPE_MASK ) ) " )\par
2329 \par
2330 cpp_quote( "#define D3D12_DECODE_MIP_FILTER( D3D12Filter )                                                              \\\\" )\par
2331 cpp_quote( "                                 ( ( D3D12_FILTER_TYPE )                                                    \\\\" )\par
2332 cpp_quote( "                                 ( ( ( D3D12Filter ) >> D3D12_MIP_FILTER_SHIFT ) & D3D12_FILTER_TYPE_MASK ) ) " )\par
2333 \par
2334 cpp_quote( "#define D3D12_DECODE_FILTER_REDUCTION( D3D12Filter )                                                        \\\\" )\par
2335 cpp_quote( "                                 ( ( D3D12_FILTER_REDUCTION_TYPE )                                                      \\\\" )\par
2336 cpp_quote( "                                 ( ( ( D3D12Filter ) >> D3D12_FILTER_REDUCTION_TYPE_SHIFT ) & D3D12_FILTER_REDUCTION_TYPE_MASK ) ) " )\par
2337 \par
2338 cpp_quote( "#define D3D12_DECODE_IS_COMPARISON_FILTER( D3D12Filter )                                                    \\\\" )\par
2339 cpp_quote( "                                 ( D3D12_DECODE_FILTER_REDUCTION( D3D12Filter ) == D3D12_FILTER_REDUCTION_TYPE_COMPARISON ) " )\par
2340 \par
2341 cpp_quote( "#define D3D12_DECODE_IS_ANISOTROPIC_FILTER( D3D12Filter )                                               \\\\" )\par
2342 cpp_quote( "                            ( ( ( D3D12Filter ) & D3D12_ANISOTROPIC_FILTERING_BIT ) &&                  \\\\" )\par
2343 cpp_quote( "                            ( D3D12_FILTER_TYPE_LINEAR == D3D12_DECODE_MIN_FILTER( D3D12Filter ) ) &&   \\\\" )\par
2344 cpp_quote( "                            ( D3D12_FILTER_TYPE_LINEAR == D3D12_DECODE_MAG_FILTER( D3D12Filter ) ) )      " )\par
