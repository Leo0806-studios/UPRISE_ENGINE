2288 const UINT D3D12_FILTER_REDUCTION_TYPE_MASK = 0x00000003;\par
2289 const UINT D3D12_FILTER_REDUCTION_TYPE_SHIFT = 7;\par
2290 \par
2291 const UINT D3D12_FILTER_TYPE_MASK = 0x00000003;\par
2292 const UINT D3D12_MIN_FILTER_SHIFT = 4;\par
2293 const UINT D3D12_MAG_FILTER_SHIFT = 2;\par
2294 const UINT D3D12_MIP_FILTER_SHIFT = 0;\par
