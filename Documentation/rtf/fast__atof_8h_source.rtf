77     {\cf19 if} ( out ) \{\par
78         *out = in;\par
79     \}\par
80     {\cf19 return} value;\par
81 \}\par
82 \par
83 {\cf20 // ------------------------------------------------------------------------------------}\par
84 {\cf20 // Convert a string in octal format to a number}\par
85 {\cf20 // ------------------------------------------------------------------------------------}\par
86 {\cf17 inline}\par
87 {\cf18 unsigned} {\cf18 int} strtoul8( {\cf17 const} {\cf18 char}* in, {\cf17 const} {\cf18 char}** out=0) \{\par
88     {\cf18 unsigned} {\cf18 int} value( 0 );\par
89     {\cf19 for} ( ;; ) \{\par
90         {\cf19 if} ( *in < {\cf23 '0'} || *in > {\cf23 '7'} ) \{\par
91             {\cf19 break};\par
92         \}\par
93 \par
94         value = ( value << 3 ) + ( *in - {\cf23 '0'} );\par
95         ++in;\par
96     \}\par
97     {\cf19 if} ( out ) \{\par
98         *out = in;\par
99     \}\par
100     {\cf19 return} value;\par
101 \}\par
102 \par
103 {\cf20 // ------------------------------------------------------------------------------------}\par
104 {\cf20 // Convert a string in hex format to a number}\par
105 {\cf20 // ------------------------------------------------------------------------------------}\par
106 {\cf17 inline}\par
107 {\cf18 unsigned} {\cf18 int} strtoul16( {\cf17 const} {\cf18 char}* in, {\cf17 const} {\cf18 char}** out=0) \{\par
108     {\cf18 unsigned} {\cf18 int} value( 0 );\par
109     {\cf19 for} ( ;; ) \{\par
110         {\cf19 if} ( *in >= {\cf23 '0'} && *in <= {\cf23 '9'} ) \{\par
111             value = ( value << 4u ) + ( *in - {\cf23 '0'} );\par
112         \} {\cf19 else} {\cf19 if} (*in >= {\cf23 'A'} && *in <= {\cf23 'F'}) \{\par
113             value = ( value << 4u ) + ( *in - {\cf23 'A'} ) + 10;\par
114         \} {\cf19 else} {\cf19 if} (*in >= {\cf23 'a'} && *in <= {\cf23 'f'}) \{\par
115             value = ( value << 4u ) + ( *in - {\cf23 'a'} ) + 10;\par
116         \} {\cf19 else} \{\par
117             {\cf19 break};\par
118         \}\par
119         ++in;\par
120     \}\par
121     {\cf19 if} ( out ) \{\par
122         *out = in;\par
123     \}\par
124     {\cf19 return} value;\par
125 \}\par
126 \par
127 {\cf20 // ------------------------------------------------------------------------------------}\par
128 {\cf20 // Convert just one hex digit}\par
129 {\cf20 // Return value is UINT_MAX if the input character is not a hex digit.}\par
130 {\cf20 // ------------------------------------------------------------------------------------}\par
131 {\cf17 inline}\par
132 {\cf18 unsigned} {\cf18 int} HexDigitToDecimal({\cf18 char} in) \{\par
133     {\cf18 unsigned} {\cf18 int} out( UINT_MAX );\par
134     {\cf19 if} ( in >= {\cf23 '0'} && in <= {\cf23 '9'} ) \{\par
135         out = in - {\cf23 '0'};\par
136     \} {\cf19 else} {\cf19 if} ( in >= {\cf23 'a'} && in <= {\cf23 'f'} ) \{\par
137         out = 10u + in - {\cf23 'a'};\par
138     \} {\cf19 else} {\cf19 if} ( in >= {\cf23 'A'} && in <= {\cf23 'F'} ) \{\par
139         out = 10u + in - {\cf23 'A'};\par
140     \}\par
141 \par
142     {\cf20 // return value is UINT_MAX if the input is not a hex digit}\par
143     {\cf19 return} out;\par
144 \}\par
145 \par
146 {\cf20 // ------------------------------------------------------------------------------------}\par
147 {\cf20 // Convert a hex-encoded octet (2 characters, i.e. df or 1a).}\par
148 {\cf20 // ------------------------------------------------------------------------------------}\par
149 {\cf17 inline}\par
150 uint8_t HexOctetToDecimal({\cf17 const} {\cf18 char}* in) \{\par
151     {\cf19 return} ((uint8_t)HexDigitToDecimal(in[0])<<4)+(uint8_t)HexDigitToDecimal(in[1]);\par
152 \}\par
153 \par
154 {\cf20 // ------------------------------------------------------------------------------------}\par
155 {\cf20 // signed variant of strtoul10}\par
156 {\cf20 // ------------------------------------------------------------------------------------}\par
157 {\cf17 inline}\par
158 {\cf18 int} strtol10( {\cf17 const} {\cf18 char}* in, {\cf17 const} {\cf18 char}** out=0) \{\par
159     {\cf18 bool} inv = (*in=={\cf23 '-'});\par
160     {\cf19 if} ( inv || *in == {\cf23 '+'} ) \{\par
161         ++in;\par
162     \}\par
163 \par
164     {\cf18 int} value = strtoul10(in,out);\par
165     {\cf19 if} (inv) \{\par
166         value = -value;\par
167     \}\par
168     {\cf19 return} value;\par
169 \}\par
170 \par
171 {\cf20 // ------------------------------------------------------------------------------------}\par
172 {\cf20 // Parse a C++-like integer literal - hex and oct prefixes.}\par
173 {\cf20 // 0xNNNN - hex}\par
174 {\cf20 // 0NNN   - oct}\par
175 {\cf20 // NNN    - dec}\par
176 {\cf20 // ------------------------------------------------------------------------------------}\par
177 {\cf17 inline}\par
178 {\cf18 unsigned} {\cf18 int} strtoul_cppstyle( {\cf17 const} {\cf18 char}* in, {\cf17 const} {\cf18 char}** out=0) \{\par
179     {\cf19 if} ({\cf23 '0'} == in[0]) \{\par
180         {\cf19 return} {\cf23 'x'} == in[1] ? strtoul16(in+2,out) : strtoul8(in+1,out);\par
181     \}\par
182     {\cf19 return} strtoul10(in, out);\par
183 \}\par
184 \par
185 {\cf20 // ------------------------------------------------------------------------------------}\par
186 {\cf20 // Special version of the function, providing higher accuracy and safety}\par
187 {\cf20 // It is mainly used by fast_atof to prevent ugly and unwanted integer overflows.}\par
188 {\cf20 // ------------------------------------------------------------------------------------}\par
189 {\cf17 template}<{\cf17 typename} ExceptionType = DeadlyImportError>\par
190 {\cf17 inline}\par
191 uint64_t strtoul10_64( {\cf17 const} {\cf18 char}* in, {\cf17 const} {\cf18 char}** out=0, {\cf18 unsigned} {\cf18 int}* max_inout=0) \{\par
192     {\cf18 unsigned} {\cf18 int} cur = 0;\par
193     uint64_t value = 0;\par
194 \par
195     {\cf19 if} ( *in < {\cf23 '0'} || *in > {\cf23 '9'} ) \{\par
196         {\cf20 // The string is known to be bad, so don't risk printing the whole thing.}\par
197         {\cf19 throw} ExceptionType({\cf22 "The string \\""}, ai_str_toprintable(in, ({\cf18 int})strlen(in)), {\cf22 "\\" cannot be converted into a value."} );\par
198     \}\par
199 \par
200     {\cf19 for} ( ;; ) \{\par
201         {\cf19 if} ( *in < {\cf23 '0'} || *in > {\cf23 '9'} ) \{\par
202             {\cf19 break};\par
203         \}\par
204 \par
205         {\cf17 const} uint64_t new_value = ( value * (uint64_t) 10 ) + ( (uint64_t) ( *in - {\cf23 '0'} ) );\par
206 \par
207         {\cf20 // numeric overflow, we rely on you}\par
208         {\cf19 if} ( new_value < value ) \{\par
209             ASSIMP_LOG_WARN( {\cf22 "Converting the string \\""}, in, {\cf22 "\\" into a value resulted in overflow."} );\par
210             {\cf19 return} 0;\par
211         \}\par
212 \par
213         value = new_value;\par
214 \par
215         ++in;\par
216         ++cur;\par
217 \par
218         {\cf19 if} (max_inout && *max_inout == cur) \{\par
219             {\cf19 if} (out) \{ {\cf20 /* skip to end */}\par
220                 {\cf19 while} ( *in >= {\cf23 '0'} && *in <= {\cf23 '9'} ) \{\par
221                     ++in;\par
222                 \}\par
223                 *out = in;\par
224             \}\par
225 \par
226             {\cf19 return} value;\par
227         \}\par
228     \}\par
229     {\cf19 if} ( out ) \{\par
230         *out = in;\par
231     \}\par
232 \par
233     {\cf19 if} ( max_inout ) \{\par
234         *max_inout = cur;\par
235     \}\par
236 \par
237     {\cf19 return} value;\par
238 \}\par
239 \par
240 {\cf20 // ------------------------------------------------------------------------------------}\par
241 {\cf20 // signed variant of strtoul10_64}\par
242 {\cf20 // ------------------------------------------------------------------------------------}\par
243 {\cf17 template}<{\cf17 typename} ExceptionType = DeadlyImportError>\par
244 {\cf17 inline}\par
245 int64_t strtol10_64({\cf17 const} {\cf18 char}* in, {\cf17 const} {\cf18 char}** out = 0, {\cf18 unsigned} {\cf18 int}* max_inout = 0) \{\par
246     {\cf18 bool} inv = (*in == {\cf23 '-'});\par
247     {\cf19 if} ( inv || *in == {\cf23 '+'} ) \{\par
248         ++in;\par
249     \}\par
250 \par
251     int64_t value = strtoul10_64<ExceptionType>(in, out, max_inout);\par
252     {\cf19 if} (inv) \{\par
253         value = -value;\par
254     \}\par
255     {\cf19 return} value;\par
256 \}\par
257 \par
258 {\cf20 // Number of relevant decimals for floating-point parsing.}\par
259 {\cf21 #define AI_FAST_ATOF_RELAVANT_DECIMALS 15}\par
260 \par
261 {\cf20 // ------------------------------------------------------------------------------------}\par
264 {\cf20 // If you find any bugs, please send them to me, niko (at) irrlicht3d.org.}\par
265 {\cf20 // ------------------------------------------------------------------------------------}\par
266 {\cf17 template}<{\cf17 typename} Real, {\cf17 typename} ExceptionType = DeadlyImportError>\par
267 {\cf17 inline}\par
268 {\cf17 const} {\cf18 char}* fast_atoreal_move({\cf17 const} {\cf18 char}* c, Real& out, {\cf18 bool} check_comma = {\cf17 true}) \{\par
269     Real f = 0;\par
270 \par
271     {\cf18 bool} inv = (*c == {\cf23 '-'});\par
272     {\cf19 if} (inv || *c == {\cf23 '+'}) \{\par
273         ++c;\par
274     \}\par
275 \par
276     {\cf19 if} ((c[0] == {\cf23 'N'} || c[0] == {\cf23 'n'}) && ASSIMP_strincmp(c, {\cf22 "nan"}, 3) == 0) \{\par
277         out = std::numeric_limits<Real>::quiet_NaN();\par
278         c += 3;\par
279         {\cf19 return} c;\par
280     \}\par
281 \par
282     {\cf19 if} ((c[0] == {\cf23 'I'} || c[0] == {\cf23 'i'}) && ASSIMP_strincmp(c, {\cf22 "inf"}, 3) == 0) \{\par
283         out = std::numeric_limits<Real>::infinity();\par
284         {\cf19 if} (inv) \{\par
285             out = -out;\par
286         \}\par
287         c += 3;\par
288         {\cf19 if} ((c[0] == {\cf23 'I'} || c[0] == {\cf23 'i'}) && ASSIMP_strincmp(c, {\cf22 "inity"}, 5) == 0) \{\par
289             c += 5;\par
290         \}\par
291         {\cf19 return} c;\par
292      \}\par
293 \par
294     {\cf19 if} (!(c[0] >= {\cf23 '0'} && c[0] <= {\cf23 '9'}) &&\par
295             !((c[0] == {\cf23 '.'} || (check_comma && c[0] == {\cf23 ','})) && c[1] >= {\cf23 '0'} && c[1] <= {\cf23 '9'})) \{\par
296         {\cf20 // The string is known to be bad, so don't risk printing the whole thing.}\par
297         {\cf19 throw} ExceptionType({\cf22 "Cannot parse string \\""}, ai_str_toprintable(c, ({\cf18 int})strlen(c)),\par
298                                     {\cf22 "\\" as a real number: does not start with digit "}\par
299                                     {\cf22 "or decimal point followed by digit."});\par
300     \}\par
301 \par
302     {\cf19 if} (*c != {\cf23 '.'} && (! check_comma || c[0] != {\cf23 ','})) \{\par
303         f = {\cf17 static_cast<}Real{\cf17 >}( strtoul10_64<ExceptionType> ( c, &c) );\par
304     \}\par
305 \par
306     {\cf19 if} ((*c == {\cf23 '.'} || (check_comma && c[0] == {\cf23 ','})) && c[1] >= {\cf23 '0'} && c[1] <= {\cf23 '9'}) \{\par
307         ++c;\par
308 \par
309         {\cf20 // NOTE: The original implementation is highly inaccurate here. The precision of a single}\par
310         {\cf20 // IEEE 754 float is not high enough, everything behind the 6th digit tends to be more}\par
311         {\cf20 // inaccurate than it would need to be. Casting to double seems to solve the problem.}\par
312         {\cf20 // strtol_64 is used to prevent integer overflow.}\par
313 \par
314         {\cf20 // Another fix: this tends to become 0 for long numbers if we don't limit the maximum}\par
315         {\cf20 // number of digits to be read. AI_FAST_ATOF_RELAVANT_DECIMALS can be a value between}\par
316         {\cf20 // 1 and 15.}\par
317         {\cf18 unsigned} {\cf18 int} diff = AI_FAST_ATOF_RELAVANT_DECIMALS;\par
318         {\cf18 double} pl = {\cf17 static_cast<}{\cf18 double}{\cf17 >}( strtoul10_64<ExceptionType> ( c, &c, &diff ));\par
319 \par
320         pl *= fast_atof_table[diff];\par
321         f += {\cf17 static_cast<}Real{\cf17 >}( pl );\par
322     \}\par
323     {\cf20 // For backwards compatibility: eat trailing dots, but not trailing commas.}\par
324     {\cf19 else} {\cf19 if} (*c == {\cf23 '.'}) \{\par
325         ++c;\par
326     \}\par
327 \par
328     {\cf20 // A major 'E' must be allowed. Necessary for proper reading of some DXF files.}\par
329     {\cf20 // Thanks to Zhao Lei to point out that this if() must be outside the if (*c == '.' ..)}\par
330     {\cf19 if} (*c == {\cf23 'e'} || *c == {\cf23 'E'}) \{\par
331         ++c;\par
332         {\cf17 const} {\cf18 bool} einv = (*c=={\cf23 '-'});\par
333         {\cf19 if} (einv || *c=={\cf23 '+'}) \{\par
334             ++c;\par
335         \}\par
336 \par
337         {\cf20 // The reason float constants are used here is that we've seen cases where compilers}\par
338         {\cf20 // would perform such casts on compile-time constants at runtime, which would be}\par
339         {\cf20 // bad considering how frequently fast_atoreal_move<float> is called in Assimp.}\par
340         Real exp = {\cf17 static_cast<}Real{\cf17 >}( strtoul10_64<ExceptionType>(c, &c) );\par
341         {\cf19 if} (einv) \{\par
342             exp = -exp;\par
343         \}\par
344         f *= std::pow({\cf17 static_cast<}Real{\cf17 >}(10.0), exp);\par
345     \}\par
346 \par
347     {\cf19 if} (inv) \{\par
348         f = -f;\par
349     \}\par
350     out = f;\par
351     {\cf19 return} c;\par
352 \}\par
353 \par
354 {\cf20 // ------------------------------------------------------------------------------------}\par
355 {\cf20 // The same but more human.}\par
356 {\cf17 template}<{\cf17 typename} ExceptionType = DeadlyImportError>\par
357 {\cf17 inline}\par
358 ai_real fast_atof({\cf17 const} {\cf18 char}* c) \{\par
359     ai_real ret(0.0);\par
360     fast_atoreal_move<ai_real, ExceptionType>(c, ret);\par
361 \par
362     {\cf19 return} ret;\par
363 \}\par
364 \par
365 {\cf17 template}<{\cf17 typename} ExceptionType = DeadlyImportError>\par
366 {\cf17 inline}\par
367 ai_real fast_atof( {\cf17 const} {\cf18 char}* c, {\cf17 const} {\cf18 char}** cout) \{\par
368     ai_real ret(0.0);\par
369     *cout = fast_atoreal_move<ai_real, ExceptionType>(c, ret);\par
370 \par
371     {\cf19 return} ret;\par
372 \}\par
373 \par
374 {\cf17 template}<{\cf17 typename} ExceptionType = DeadlyImportError>\par
375 {\cf17 inline}\par
376 ai_real fast_atof( {\cf17 const} {\cf18 char}** inout) \{\par
377     ai_real ret(0.0);\par
378     *inout = fast_atoreal_move<ai_real, ExceptionType>(*inout, ret);\par
379 \par
380     {\cf19 return} ret;\par
381 \}\par
382 \par
383 \} \par
384 \par
385 {\cf21 #endif }{\cf20 // FAST_A_TO_F_H_INCLUDED}\par
