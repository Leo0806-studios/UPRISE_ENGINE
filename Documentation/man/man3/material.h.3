.SS "\fBASSIMP_API\fP \fBC_ENUM\fP \fBaiReturn\fP aiGetMaterialString (const \fBC_STRUCT\fP \fBaiMaterial\fP * pMat, const char * pKey, unsigned int type, unsigned int index, \fBC_STRUCT\fP \fBaiString\fP * pOut)"

.PP
