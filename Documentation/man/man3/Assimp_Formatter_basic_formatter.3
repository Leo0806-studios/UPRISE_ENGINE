.SS "template<typename \fBT\fP, typename CharTraits = std::char_traits<T>, typename Allocator = std::allocator<T>>
.br
class Assimp::Formatter::basic_formatter< T, CharTraits, Allocator >"stringstream utility\&. Usage: 
.PP
.nf
void writelog(const std::string&s);
void writelog(const std::wstring&s);
\&.\&.\&.
writelog(format()<< "hi! this is a number: " << 4);
