                        <tgroup cols="3" align="left" colsep="1" rowsep="1">
                        <colspec colwidth="1*"/>
                        <colspec colwidth="1*"/>
                        <colspec colwidth="4*"/>
                        <tbody>
                            <row>
<entry>in</entry><entry>covarMat</entry><entry>
<para>A symmetric, real-valued covariance matrix, e.g. computed from computeCovarianceMatrix /</para>
</entry>
                            </row>
                            <row>
<entry>out</entry><entry>outEigenvalues</entry><entry>
<para>Vector to receive the found eigenvalues /</para>
</entry>
                            </row>
                            <row>
