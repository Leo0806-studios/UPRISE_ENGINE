<section>
<title>Detailed Description</title>

<para>Usage: <literallayout><computeroutput><emphasis role="keywordflow">for</emphasis>(<link linkend="_class_assimp_1_1_line_splitter_1a04e78a827cbd501d920a9bb8245b817f">LineSplitter</link>&#32;splitter(<link linkend="_glad_8h_1ad02d2488127e1cf9a27262c4ee30ba85">stream</link>);splitter;++splitter)&#32;{

&#32;&#32;&#32;&#32;<emphasis role="keywordflow">if</emphasis>&#32;(*splitter&#32;==&#32;<emphasis role="stringliteral">&quot;hi!&quot;</emphasis>)&#32;{
&#32;&#32;&#32;&#32;&#32;&#32;&#32;...
&#32;&#32;&#32;&#32;}
&#32;&#32;&#32;&#32;<emphasis role="keywordflow">else</emphasis>&#32;<emphasis role="keywordflow">if</emphasis>&#32;(splitter-&gt;substr(0,5)&#32;==&#32;<emphasis role="stringliteral">&quot;hello&quot;</emphasis>)&#32;{
&#32;&#32;&#32;&#32;&#32;&#32;&#32;...
&#32;&#32;&#32;&#32;&#32;&#32;&#32;<emphasis role="comment">//&#32;access&#32;the&#32;third&#32;token&#32;in&#32;the&#32;line&#32;(tokens&#32;are&#32;space-separated)</emphasis>
&#32;&#32;&#32;&#32;&#32;&#32;&#32;<emphasis role="keywordflow">if</emphasis>&#32;(strtol(splitter[2])&#32;&gt;&#32;5)&#32;{&#32;..&#32;}
&#32;&#32;&#32;&#32;}

&#32;&#32;&#32;&#32;<link linkend="__logger_8hpp_1a2e93a38394c31960fa5a2f51a7c32da9">ASSIMP_LOG_VERBOSE_DEBUG</link>(<emphasis role="stringliteral">&quot;Current&#32;line&#32;is:&#32;&quot;</emphasis>,&#32;splitter.get_index());
}
</computeroutput></literallayout> </para>
</section>
