c___i_n_p_u_t_8h_1a0acb682b8260ab1c60b918599864e2e5">T</link>, <link linkend="__u_p_r_i_s_e___e_n_g_i_n_e_2_header_e_2_c_o_r_e_2_c___i_n_p_u_t_8h_1acbcee443d6d55cb8600b3f240f5cf907">Q</link> &gt; &amp; r, <link linkend="_structglm_1_1mat">mat</link>&lt; <link linkend="__u_p_r_i_s_e___e_n_g_i_n_e_2_header_e_2_c_o_r_e_2_c___i_n_p_u_t_8h_1ac4cf4b2ab929bd23951a8676eeac086b">C</link>,(<link linkend="__u_p_r_i_s_e___e_n_g_i_n_e_2_header_e_2_c_o_r_e_2_c___i_n_p_u_t_8h_1ac4cf4b2ab929bd23951a8676eeac086b">C</link>&lt; <link linkend="__u_p_r_i_s_e___e_n_g_i_n_e_2_header_e_2_c_o_r_e_2_c___i_n_p_u_t_8h_1a5c71a5e59a53413cd6c270266d63b031">R</link> ? <link linkend="__u_p_r_i_s_e___e_n_g_i_n_e_2_header_e_2_c_o_r_e_2_c___i_n_p_u_t_8h_1ac4cf4b2ab929bd23951a8676eeac086b">C</link> :<link linkend="__u_p_r_i_s_e___e_n_g_i_n_e_2_header_e_2_c_o_r_e_2_c___i_n_p_u_t_8h_1a5c71a5e59a53413cd6c270266d63b031">R</link>), <link linkend="__u_p_r_i_s_e___e_n_g_i_n_e_2_header_e_2_c_o_r_e_2_c___i_n_p_u_t_8h_1a0acb682b8260ab1c60b918599864e2e5">T</link>, <link linkend="__u_p_r_i_s_e___e_n_g_i_n_e_2_header_e_2_c_o_r_e_2_c___i_n_p_u_t_8h_1acbcee443d6d55cb8600b3f240f5cf907">Q</link> &gt; &amp; q)</computeroutput></para>
<para>Performs RQ factorisation of a matrix. Returns 2 matrices, r and q, such that r is an upper triangular matrix, the rows of q are orthonormal and span the same subspace than those of the input matrix, and r*q=in. Note that in the context of RQ factorisation, the diagonal is seen as starting in the lower-right corner of the matrix, instead of the usual upper-left. Given an n-by-m input matrix, r has dimensions min(n,m)-by-m, and q has dimensions n-by-min(n,m).</para>

<para>From GLM_GTX_matrix_factorisation extension. </para>
